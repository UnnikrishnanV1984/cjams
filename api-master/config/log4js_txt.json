{
    "appenders": {
        "access": {
            "type": "dateFile",
            "filename": "/opt/node/outputs/log/cjams_api_access.log",
            "layout": {
                "type": "pattern",
                "pattern": "%d - %c:[%p]: %m"
            },
            "pattern": "-yyyy-MM-dd",
            "daysToKeep": 7,
            "category": "http"
        },
        "app": {
            "type": "file",
            "filename": "/opt/node/outputs/log/cjams_api_app.log",
            "maxLogSize": 10485760,
            "layout": {
                "type": "pattern",
                "pattern": "%d - %c:[%p]: %m"
            },
            "numBackups": 3
        },
        "errorFile": {
            "type": "file",
            "filename": "/opt/node/outputs/log/cjams_api_errors.log",
            "maxLogSize": 10485760,
            "layout": {
                "type": "pattern",
                "pattern": "%d - %c:[%p]: %m"
            },
            "numBackups": 3
        },
        "errors": {
            "type": "logLevelFilter",
            "level": "ERROR",
            "appender": "errorFile"
        },
        "console": {
            "type": "console",
            "layout": {
                "type": "pattern",
                "pattern": "%d - %c:[%p]: %m"
            }
        }
    },
    "categories": {
        "default": { "appenders": [ "app", "errors" ], "level": "DEBUG", "enableCallStack": true },
        "http": { "appenders": [ "access"], "level": "DEBUG", "enableCallStack": true }
    }
}
