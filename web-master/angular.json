{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "test-ng4": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "aot": true,
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "allowedCommonJsDependencies": [
              "formio-export",
              "angular2-signaturepad",
              "angular2-highcharts",
              "ng2-pdf-viewer",
              "file-saver",
              "lodash",
              "jspdf",
              "html2canvas",
              "recordrtc/RecordRTC.min",
              "highcharts",
              "canvg",
              "core-js",
              "raf",
              "rgbcolor",
              "mobx",
              "gojs",
              "text-mask-addons",
              "quill",
              "moment",
              "jszip",
              "recordrtc",
              "trumbowyg"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "./node_modules/dwt/dist",
                "output": "./src/assets/images/dwt/scanner/"
              }
            ],
            "styles": [
              "src/styles/app.scss",
              "node_modules/material-icons/iconfont/material-icons.css",
              "node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "src/assets/css/formio.full.min.css",
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/moment/min/moment.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js",
              "src/assets/images/dwt/scanner/dynamsoft.webtwain.addon.camera.js",
              "src/assets/images/dwt/scanner/dynamsoft.webtwain.config.js",
              "src/assets/images/dwt/scanner/dynamsoft.webtwain.initiate.js",
              "src/assets/images/dwt/scanner/dynamsoft.webtwain.install.js",
              "src/assets/images/dwt/scanner/src/dynamsoft.webtwain.viewer.js",
              "src/assets/images/dwt/scanner/src/dynamsoft.webtwain.activex.js",
              "src/assets/images/dwt/scanner/src/dynamsoft.lts.js",
              "src/assets/images/dwt/scanner/src/dynamsoft.imageio_wasm-1.6.2.js",
              "node_modules/dwt/dist/dynamsoft.webtwain.min.js",
              "node_modules/file-saver/src/FileSaver.js"
            ],
            "browser": "src/main.ts"
          },
          "configurations": {
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
			"dev1": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev1.ts"
                }
              ]
            },
            "dev2": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev2.ts"
                }
              ]
            },
            "dev3": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev3.ts"
                }
              ]
            },
            "dev4": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev4.ts"
                }
              ]
            },
            "trn1": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.trn1.ts"
                }
              ]
            },

            "stg1": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stg1.ts"
                }
              ]
            },

            "stg2": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stg2.ts"
                }
              ]
            },
            "stg3": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stg3.ts"
                }
              ]
            },
            "stg4": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stg4.ts"
                }
              ]
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prd1.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "dev"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "test-ng4:build"
          },
          "configurations": {
            "dev": {
              "buildTarget": "test-ng4:build:dev"
            },
            "dev1": {
              "buildTarget": "test-ng4:build:dev1"
            },
            "dev2": {
              "buildTarget": "test-ng4:build:dev2"
            },
            "dev3": {
              "buildTarget": "test-ng4:build:dev3"
            },
            "dev4": {
              "buildTarget": "test-ng4:build:dev4"
            },
            "trn1": {
              "buildTarget": "test-ng4:build:trn1"
            },
            "stg1": {
              "buildTarget": "test-ng4:build:stg1"
            },
            "stg2": {
              "buildTarget": "test-ng4:build:stg2"
            },
            "stg3": {
              "buildTarget": "test-ng4:build:stg3"
            },
            "stg4": {
              "buildTarget": "test-ng4:build:stg4"
            },
            "production": {
              "buildTarget": "test-ng4:build:production"
            }
          },
          "defaultConfiguration": "dev"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "test-ng4:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "src/assets/js/jquery-ui.js",
              "src/assets/js/jquery.scrolling-tabs.js",
              "src/assets/js/bootstrap.min.js",
              "node_modules/moment/min/moment.min.js",
              "src/assets/js/bootstrap-datetimepicker.min.js",
              "src/assets/js/custom.js",
              "node_modules/html2canvas/dist/html2canvas.min.js",
              "src/assets/js/feedback.js"
            ],
            "styles": [
              "src/styles/app.scss",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/ngx-toastr/toastr.css"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico"
            ]
          }
        },
        "lint": {
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "test-ng4-e2e": {
      "root": "e2e",
      "sourceRoot": "e2e",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "./protractor.conf.js",
            "devServerTarget": "test-ng4:serve"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "e2e/tsconfig.e2e.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "",
      "style": "scss"
    },
    "@schematics/angular:directive": {
      "prefix": ""
    }
  },
  "cli": {
    "analytics": false
  }
}
