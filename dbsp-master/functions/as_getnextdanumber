CREATE OR REPLACE FUNCTION as_getnextdanumber(application_name character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------------------------------
-- Revision(s):
-- Vineet Tirodkar - 05/10/2021 - Modifications to use the sequence objects for generating the next numbers  
--   APPs: 1-CW, 2-APS & 3-DJS    

--   New Logic for generating 12 digits the Seq Numbers 
--   Year(##) +  App(#) + Type (##) + sequence no (#######) 
--  21     +  1   + 01     + Next (7)
------------------------------------------------------------------------------------------------ 
DECLARE
 nextno  bigint;
 dano    varchar;
 vs_app character varying; 
 vs_seq_nm character varying;
 vs_type_cd character varying;
 
BEGIN
  IF lower(application_name) = lower('IntakeNumber')       -- 01
   or lower(application_name) = lower('ServiceRequestAuthorizationNumber') -- 02  
  THEN 
  
  vs_app := 2 ; -- Adult Services
  
  IF lower(application_name) = lower('IntakeNumber') THEN
   vs_seq_nm := 'sequence_for_as_intakenumber';
   vs_type_cd := '01';
  ELSE
   vs_seq_nm := 'sequence_for_as_servicerequestnumber';
   vs_type_cd := '02';  
  END IF;
  
  select nextval(vs_seq_nm::regclass) into nextno ;
 
  dano := concat(to_char(now(), 'YY'), vs_app, vs_type_cd, lpad(cast(nextno as varchar), 7, '0'));
  
  RETURN dano;
  
 ELSE

  SELECT next_number 
   into nextno 
  FROM nextnumber 
  WHERE lower(nextnumber.application)=lower(application_name) 
   AND nextnumber.fiscalyear = COALESCE(nextnumber.fiscalyear, 0);

  UPDATE nextnumber
   SET next_number=(next_number+1)
  WHERE lower(nextnumber.application) = lower(application_name) 
   AND nextnumber.fiscalyear = COALESCE(nextnumber.fiscalyear, 0);
   
   
  dano:= concat(cast(date_part ('year',now()) as varchar),'0', 
      case(length(cast(date_part ('doy',now()) as varchar))) when 1 then 
       concat('0',cast(date_part ('doy',now()) as varchar)) 
      else 
       cast(date_part ('doy',now()) as varchar) 
      end, '0');

  RETURN CONCAT( cast( dano  as varchar),CAST(nextno AS VARCHAR));
  
 END IF; 
END;
 
$function$

