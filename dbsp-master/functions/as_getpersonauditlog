CREATE OR REPLACE FUNCTION as_getpersonauditlog(v_personid uuid, v_userid character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(totalcount bigint, personauditlogid uuid, personid uuid, personjson json, updatedby character varying, updatedon timestamp without time zone)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                                            

DECLARE
 v_pageoffset int;
    v_pagenumber int;
 
BEGIN

 v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
   
 RETURN QUERY
 
 select count(1) over(), pal.personauditlogid,pal.personid,pal.personjson,up.fullname,pal.insertedon
from personauditlog pal
left join userprofile up on up.securityusersid = pal.insertedby:: character varying
where pal.personid = v_personid order by insertedon desc
LIMIT pagesize OFFSET v_pageoffset;

END;

$function$

