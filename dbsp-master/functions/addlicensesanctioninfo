CREATE OR REPLACE FUNCTION addlicensesanctioninfo(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                    
 DECLARE                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                  
 v_licenseno character varying;                                                                                                                                                                                                                   
 v_sanctiontype character varying;                                                                                                                                                                                                                
 v_securityuserid character varying;                                                                                                                                                                                                              
 v_sanctiontypecd character varying;                                                                                                                                                                                                              
 sanctioncd character varying;                                                                                                                                                                                                                    
 status character varying;                                                                                                                                                                                                                        
 v_msg character varying;                                                                                                                                                                                                                         
 v_status character varying;                                                                                                                                                                                                                      
 v_tosecurityuserid character varying;                                                                                                                                                                                                            
 v_providerid character varying;                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                  
 BEGIN                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                  
 v_sanctiontype := insertobj ->> 'license_sanction_type';                                                                                                                                                                                         
 v_licenseno := insertobj ->> 'license_no';                                                                                                                                                                                                       
 v_securityuserid := insertobj ->> 'securityuserid';                                                                                                                                                                                              
 --v_tosecurityuserid := '3a4be705-135d-482c-81e2-913be1cb02e8';                                                                                                                                                                                    
 v_providerid := insertobj ->> 'provider_id';                                                                                                                                                                                                     
 if length(v_sanctiontype) >0                                                                                                                                                                                                                     
 then                                                                                                                                                                                                                                             
 case  v_sanctiontype                                                                                                                                                                                                                             
         WHEN 'Suspension'  THEN v_sanctiontypecd:='3261';                                                                                                                                                                                        
     WHEN 'Revocation' THEN v_sanctiontypecd:='3262';                                                                                                                                                                                             
     WHEN 'Limitation' THEN v_sanctiontypecd:='3267';                                                                                                                                                                                             
         WHEN 'Voluntary Closure' THEN v_sanctiontypecd:='3268';                                                                                                                                                                                  
         ELSE status:= 'incorrect sanction type';                                                                                                                                                                                                 
 end case;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                  
 if(status = 'incorrect sanction type')                                                                                                                                                                                                           
 then                                                                                                                                                                                                                                             
 return status;                                                                                                                                                                                                                                   
 else                                                                                                                                                                                                                                             
 INSERT INTO providerlicensesanctions                                                                                                                                                                                                             
 (provider_id, site_id, license_no, license_sanction_type, limitation_type, sanction_effective_dt, sanction_end_dt, limitation_reduced_youth_capacity, limitation_gender, limitation_min_age,limitation_max_age,                                  
 create_ts, create_user_id, update_ts, update_user_id, delete_sw)                                                                                                                                                                                 
 VALUES((v_providerid)::int, (insertobj ->> 'site_id')::int, v_licenseno, v_sanctiontype, insertobj ->> 'limitation_type', (insertobj ->> 'sanction_effective_dt')::date, (insertobj ->> 'sanction_end_dt')::date,                                
 (insertobj ->> 'limitation_reduced_youth_capacity')::int, insertobj ->> 'limitation_gender', (insertobj ->> 'limitation_min_age')::int,(insertobj ->> 'limitation_max_age')::int, now(), v_securityuserid, now(), v_securityuserid, 'N'::bpchar);
                                                                                                                                                                                                                                                  
 UPDATE tb_provider_licensing                                                                                                                                                                                                                     
 SET  license_status_cd= v_sanctiontypecd                                                                                                                                                                                                         
 WHERE license_no = v_licenseno;                                                                                                                                                                                                                  
 status := 'success';                                                                                                                                                                                                                             
 
select securityusers_id into v_tosecurityuserid from tb_provider_userconfig tpu where provider_id=v_providerid limit 1;
if (v_tosecurityuserid is null) then
 select securityusers_id from tb_provider_userconfig tpu
   where provider_id=(select affiliate_provider_id from tb_provider 
        where provider_id=v_providerid limit 1) limit 1;
end if;
 -- License Sanction is added for provider id.                                                                                                                                                                                                    
 v_msg:=   'License Sanction of type '|| v_sanctiontype:: character varying ||' is added for provider id '|| v_providerid:: character varying ||'.';                                                                                              
                                                                                                                                                                                                                                                  
 SELECT send_notification INTO v_status FROM send_notification(v_tosecurityuserid, v_securityuserid, v_tosecurityuserid,                                                                                                                          
 'System', 'High', v_msg, v_msg , v_providerid::character varying);                                                                                                                                                                               
                                                                                                                                                                                                                                                  
 end if;                                                                                                                                                                                                                                          
 else                                                                                                                                                                                                                                             
 status:= 'sanction type missing';                                                                                                                                                                                                                
 end if;                                                                                                                                                                                                                                          
 return status;                                                                                                                                                                                                                                   
 end;                                                                                                                                                                                                                                             
 $function$

