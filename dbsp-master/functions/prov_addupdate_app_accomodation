CREATE OR REPLACE FUNCTION prov_addupdate_app_accomodation(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare
 v_securityuserid character varying;
 i json;
 v_addressarr json;
 v_randomuuid uuid;
 v_applicantid character varying;       
 v_accomid character varying;
 v_program_type_id character varying;

begin
v_securityuserid:=insertobj->>'securityuserid';
v_addressarr:=insertobj->>'address';
v_applicantid:=insertobj->>'applicant_id';
v_program_type_id:=insertobj->>'program_type_id';

IF length(v_applicantid)>0  
THEN

    select prov_applicant_accomodation_id
    into v_accomid
    from tb_prov_applicant_accomodation
    where provider_applicant_id = v_applicantid and program_type_id = v_program_type_id::uuid;

    IF v_accomid is null
    THEN

    INSERT INTO tb_prov_applicant_accomodation
        (prov_applicant_accomodation_id,
        program_type_id,
        provider_applicant_id,
        minimum_age_no,
        maximum_age_no,
        gender_cd,
        children_no,
        requested_license_effective_date,
        requested_license_end_date,
        create_ts,
        create_user_id,
        update_ts,
        update_user_id,
        delete_sw,
        min_age_months_no,
        max_age_months_no,
        iq_range_from,
        iq_range_to,
        license_no,
        male_capacity,
        is_max_capacity,
  female_capacity,
  max_male_capacity,
  max_female_capacity
        )
    VALUES(gen_random_uuid(),
        v_program_type_id::uuid,
        v_applicantid,
        (insertobj->>'minimum_age_no')::int,
        (insertobj->>'maximum_age_no')::int,
        insertobj->>'gender_cd',
        (insertobj->>'children_no')::int,
        (insertobj->>'requested_license_effective_date')::date,
        (insertobj->>'requested_license_end_date')::date,
        now(),
        v_securityuserid,
        now(),
        v_securityuserid,
        'N'::bpchar,
        (insertobj->>'min_age_months_no')::int,
        (insertobj->>'max_age_months_no')::int,
        insertobj->>'iq_range_from',
        insertobj->>'iq_range_to',
        insertobj->>'license_no',
        (insertobj->>'male_capacity')::int,
  (insertobj->>'is_max_capacity')::boolean,
  (insertobj->>'female_capacity')::int,
  (insertobj->>'max_male_capacity')::int,
  (insertobj->>'max_female_capacity')::int
        );   

    ELSE

    UPDATE tb_prov_applicant_accomodation  
    SET minimum_age_no=(insertobj->>'minimum_age_no')::int,
        program_type_id=v_program_type_id::uuid,
        maximum_age_no=(insertobj->>'maximum_age_no')::int,
        gender_cd=insertobj->>'gender_cd',
        children_no=(insertobj->>'children_no')::int,
        update_ts=now(),
        update_user_id=v_securityuserid,
        min_age_months_no=(insertobj->>'min_age_months_no')::int,
        max_age_months_no=(insertobj->>'max_age_months_no')::int,
        iq_range_from=insertobj->>'iq_range_from',
        iq_range_to=insertobj->>'iq_range_to',
  requested_license_effective_date=(insertobj->>'requested_license_effective_date')::date,
  requested_license_end_date=(insertobj->>'requested_license_end_date')::date,
        license_no=(insertobj->>'license_no')::character VARYING,
        male_capacity=(insertobj->>'male_capacity')::int,
  is_max_capacity=(insertobj->>'is_max_capacity')::boolean,
  female_capacity=(insertobj->>'female_capacity')::int,
  max_male_capacity=(insertobj->>'max_male_capacity')::int,
  max_female_capacity=(insertobj->>'max_female_capacity')::int
    WHERE prov_applicant_accomodation_id=(v_accomid)::uuid;

    END IF;
    return 'success';
ELSE
return 'failure';
END IF;
       
 end;  
 $function$

