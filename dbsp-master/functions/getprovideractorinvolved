CREATE OR REPLACE FUNCTION getprovideractorinvolved(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT PUAI.provider_uir_actor_involved_id, PUAI.provider_uir_id, PUAI.provider_staff_id, PUAI.provider_uir_actor_detail_id,
PUAI.role_incident, PUAI.restraint_typekey, PUAI.duration_phiscial_restraint, PUAI.duration_phiscial_restraint_other, 
is_intervention, is_leaving_supervision, is_prevention, is_flexcuff, is_handcuff, is_legiron,
PUAI.is_helmets, PUAI.is_handcuff_legiron, PUAI.is_protective_device, PUAI.duration_mechanical_restraint,
duration_mechanical_restraint_other, is_de_escalation, is_seen_medical, is_injury_sustained,
PUAI.injury_severity_rating, PUAI.is_injury_result, PUAI.is_seclusion, PUAI.duration_seclusion, 
PUAI.is_staff_assaulted,AD.first_name as youthfname,AD.last_name as youthlname,
TPS.employee_first_nm,TPS.employee_last_nm
FROM provider_uir_actor_involved PUAI
left join provider_uir_actor_detail AD on AD.provider_uir_actor_detail_id=PUAI.provider_uir_actor_detail_id
left join tb_provider_staff TPS on TPS.provider_staff_id=PUAI.provider_staff_id::int



where PUAI.provider_uir_id=v_provider_uir_id 


   )  a;

RETURN  jsondata;
END;

$function$

