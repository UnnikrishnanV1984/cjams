CREATE OR REPLACE FUNCTION as_getserviceplangoal(v_objectid character varying)
 RETURNS TABLE(serviceplangoalid uuid, goaldate timestamp without time zone, goal character varying, strategy character varying, objectid character varying, objecttypekey character varying, goaltypekey character varying, goaldescription character varying, isprojecthome boolean, initialcondition character varying, goalscategorytype character varying, plannedstartdate timestamp without time zone, plannedenddate timestamp without time zone, challenges character varying, strengths character varying, other text)
 LANGUAGE plpgsql
AS $function$


begin
 
RETURN  QUERY

select DISTINCT spg.serviceplangoalid,spg.goaldate,spg.goal,spg.strategy,spg.objectid,spg.objecttypekey,spg.goaltypekey,rv.description as goaldescription,spg.isprojecthome,
spg.initialcondition ,spg.goalscategorytype,spg.plannedstartdate,spg.plannedenddate,spg.challenges,spg.strengths,spg.other 
from serviceplangoal spg
left join referencevalues rv on rv.ref_key=spg.goaltypekey and rv.activeflag=1
--left join referencevalues rv1 on rv1.ref_key=spg.goalscategorytype and rv1.activeflag=1
where spg.activeflag=1 and spg.objectid=v_objectid; 

End;


$function$

