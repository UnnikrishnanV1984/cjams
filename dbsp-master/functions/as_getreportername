CREATE OR REPLACE FUNCTION as_getreportername(v_objecttypekey character varying, v_objectid character varying, roletype character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE   l_personname character  varying;
BEGIN      
 
 SELECT   cast(INITCAP(TRIM(coalesce(PN.lastname,''))|| CASE WHEN PN.suffix is not null THEN ' ' 
    ELSE '' END  || TRIM(coalesce(PN.suffix,'')) || ', ' ||TRIM(coalesce(PN.firstname,''))) as  character varying) INTO l_personname
  FROM  intakeservicerequestactor   ISRA
  INNER JOIN actor AS A ON a.actorid = isra.actorid 
 INNER  JOIN  person  as  PN  ON  PN.personid=a.personid  AND  PN.activeflag  =  1   
 WHERE  intakeservicerequestpersontypekey  IN  ('RA','AV')  AND  ISRA.activeflag  =1
  AND ISRA.intakeserviceid:: character varying = v_objectid ORDER BY ISRA.intakeservicerequestpersontypekey DESC NULLS LAST LIMIT 1;
        
 RETURN l_personname;
END;
$function$

