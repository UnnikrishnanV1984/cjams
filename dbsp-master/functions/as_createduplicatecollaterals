CREATE OR REPLACE FUNCTION as_createduplicatecollaterals(v_intakeserviceid uuid, v_newintakeserviceid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_collateral RECORD;
 v_collateralid uuid;

BEGIN
 
 FOR v_collateral IN (SELECT * FROM collateral col1 WHERE col1.activeflag =1 AND col1.caseid =v_intakeserviceid)
 LOOP 
  v_collateralid := gen_random_uuid();
  INSERT INTO collateral (collateralid, referralid, caseid, prefixtypekey, firstname, middlename, lastname, suffixtypekey, 
   dob, ssn, primaryracetypekey, relationshiptypekey, testifyflag, attestableinfo, familyknowledge, "comments", workphone, 
   workextn, homephone, pager, email, fax, mobile, url, othercontacts, insertedon, insertedby, updatedon, updatedby, 
   activeflag, datenotified, clientnotes, legalclientid, expungementflag, datavalidflag, clientmergeid, agencyname, old_id, 
   intakenumber, title, objecttype)
  SELECT  v_collateralid, v_collateral.referralid, v_newintakeserviceid, v_collateral.prefixtypekey, v_collateral.firstname,
   v_collateral.middlename, v_collateral.lastname, v_collateral.suffixtypekey, v_collateral.dob, v_collateral.ssn,
   v_collateral.primaryracetypekey, v_collateral.relationshiptypekey, v_collateral.testifyflag, v_collateral.attestableinfo,
   v_collateral.familyknowledge, v_collateral."comments", v_collateral.workphone, v_collateral.workextn, 
   v_collateral.homephone, v_collateral.pager, v_collateral.email, v_collateral.fax, v_collateral.mobile, v_collateral.url, 
   v_collateral.othercontacts, now(), v_securityusersid, now(), v_securityusersid, v_collateral.activeflag, 
   v_collateral.datenotified, v_collateral.clientnotes, v_collateral.legalclientid, v_collateral.expungementflag, 
   v_collateral.datavalidflag, v_collateral.clientmergeid, v_collateral.agencyname, v_collateral.old_id, 
   v_collateral.intakenumber, v_collateral.title, v_collateral.objecttype;
  
  INSERT INTO collateraladdress (collateralid, addresstypekey, formattypekey, streetnumber, boxnumber, predirtypekey, 
  streetname, streetsuffixtypekey, postdirtypekey, unittypekey, unitnumbertx, cityname, countytypekey, statetypekey, zip5no, 
  zip4no, direction, foreignaddress, foreignstate, country, postalcode, defaultflag, startdate, enddate, insertedon, 
  insertedby, updatedon, updatedby, activeflag, streetnotes, old_id, address1, address2) 
  SELECT v_collateralid, addresstypekey, formattypekey, streetnumber, boxnumber,
  predirtypekey, streetname, streetsuffixtypekey, postdirtypekey, unittypekey, unitnumbertx, cityname, countytypekey, 
  statetypekey, zip5no, zip4no, direction, foreignaddress, foreignstate, country, postalcode, defaultflag, startdate, enddate,
  now(), v_securityusersid, now(), v_securityusersid, activeflag, streetnotes, old_id, address1, address2 
  FROM collateraladdress WHERE collateralid = v_collateral.collateralid AND activeflag = 1; 

  INSERT INTO collateralroleconfig (collateralid, actortypekey, activeflag, effectivedate, insertedby, insertedon, updatedby,
  updatedon, old_id) 
  SELECT v_collateralid, actortypekey, activeflag, effectivedate, v_securityusersid, now(), v_securityusersid, now(), old_id 
  FROM collateralroleconfig WHERE collateralid = v_collateral.collateralid AND activeflag = 1; 

 END LOOP;
  
 RETURN 'Success';
 
END;

$function$

