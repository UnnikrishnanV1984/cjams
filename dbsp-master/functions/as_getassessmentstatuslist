CREATE OR REPLACE FUNCTION as_getassessmentstatuslist(v_intakenumber character varying, v_intakeserviceid uuid DEFAULT NULL::uuid, v_statustype character varying DEFAULT NULL::character varying)
 RETURNS TABLE(statuskey character varying, status character varying)
 LANGUAGE plpgsql
AS $function$
begin
 return query
select rv.ref_key as statuskey, rv.description as status from referencevalues rv
 join focuspersoncasestatus fps on fps.focuspersonstatustypekey = rv.ref_key
 join referencetype  rt on rv.referencetypeid=rt.referencetypeid and rt.tablename='focuspersonstatus'
where (fps.intakeserviceid= v_intakeserviceid or fps.intakenumber= v_intakenumber) and fps.activeflag = 1 and (case when v_statustype is not null then fps.status = v_statustype else true end);
end;
$function$

