CREATE OR REPLACE FUNCTION as_informationfactsheet(i_intakenumber character varying, i_secid character varying)
 RETURNS TABLE(intakeid character varying, youthid character varying, interviewdate character varying, youthname character varying, parentorguardianname character varying, parentorguardianphone character varying, parentorguardianaddress character varying, dateofbirth character varying, gender character varying, race character varying, offensename character varying[], school character varying, grade character varying, iw_name character varying, cw_name character varying, releaseddate character varying, provider_name character varying, court_date character varying)
 LANGUAGE plpgsql
AS $function$
   BEGIN                  
    RETURN QUERY    
  ( select distinct
          CAST(INTSR.intakenumber as character varying) as intakeid ,
          CAST(p.cjamspid as character varying) as youthid,
    cast(pl.placementdate as character varying) as interviewdate,
                          cast(INITCAP(TRIM(coalesce(p.lastname,''))|| CASE WHEN (p.suffix is not null and p.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(p.suffix,'')) || ', ' ||TRIM(coalesce(p.firstname,''))) as  character varying)   as youthname,
      CAST(COALESCE(
                  (select distinct INITCAP(TRIM(coalesce(person.lastname,''))|| CASE WHEN (person.suffix is not null and person.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(person.suffix,'')) || ', ' ||TRIM(coalesce(person.firstname,''))) 
         from  intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey='mother'
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
                        join person  on ACC.personid=person.personid and person.activeflag=1 and INT.intakenumber=INTSR.intakenumber ),
              (select distinct INITCAP(TRIM(coalesce(person.lastname,''))|| CASE WHEN (person.suffix is not null and person.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(person.suffix,'')) || ', ' ||TRIM(coalesce(person.firstname,''))) 
         from  intakeservicerequest INT 
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey='father'
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
                        join person  on ACC.personid=person.personid and person.activeflag=1 and INT.intakenumber=INTSR.intakenumber),
      (select distinct INITCAP(TRIM(coalesce(person.lastname,''))|| CASE WHEN (person.suffix is not null and person.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(person.suffix,'')) || ', ' ||TRIM(coalesce(person.firstname,''))) 
         from  intakeservicerequest INT 
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey not in ('father','mother')
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1  and ACC.actortype='parent-or-guard'
                        join person  on ACC.personid=person.personid and person.activeflag=1 and INT.intakenumber=INTSR.intakenumber)) as character varying ) 
             as parentorguardianname,
            CAST(COALESCE(
               (select  personphonenumber.phonenumber 
        from  intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey='mother'
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
                        join person  on ACC.personid=person.personid and person.activeflag=1 
      join personphonenumber on personphonenumber.personid=person.personid and personphonenumber.activeflag=1 where INT.intakenumber=INTSR.intakenumber group by 1 order by max(personphonenumber.insertedon) desc limit 1),
              (select  personphonenumber.phonenumber 
        from  intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey='father'
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
                        join person  on ACC.personid=person.personid and person.activeflag=1 
      join personphonenumber on personphonenumber.personid=person.personid and personphonenumber.activeflag=1 where INT.intakenumber=INTSR.intakenumber group by 1 order by max(personphonenumber.insertedon) desc limit 1),
      (select  personphonenumber.phonenumber 
        from  intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey not in ('father','mother')
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1   and ACC.actortype='parent-or-guard'
                        join person  on ACC.personid=person.personid and person.activeflag=1 
      join personphonenumber on personphonenumber.personid=person.personid and personphonenumber.activeflag=1 where INT.intakenumber=INTSR.intakenumber group by 1 order by max(personphonenumber.insertedon) desc limit 1)
      ) as character varying) 
             as parentorguardianphone,
    CAST(COALESCE(
               (select  pa.address 
     from intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey='mother'
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
                        join person  on ACC.personid=person.personid and person.activeflag=1 
      join personaddress pa on pa.personid=person.personid and pa.activeflag=1 where INT.intakenumber=INTSR.intakenumber group by 1 order by max(pa.insertedon) desc limit 1),
              (select  pa.address
     from intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey='father'
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
                       join person  on ACC.personid=person.personid and person.activeflag=1 
       join personaddress pa on pa.personid=person.personid and pa.activeflag=1 where INT.intakenumber=INTSR.intakenumber group by 1 order by max(pa.insertedon) desc limit 1),
       (select  pa.address
     from intakeservicerequest INT
                        join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INT.intakeserviceid and INSRA.activeflag=1 
                        join actorrelationship ar on ar.intakeservicerequestactorid=INSRA.intakeservicerequestactorid and ar.activeflag=1 and ar.relationshiptypekey not in ('father','mother')
                        join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1  and ACC.actortype='parent-or-guard'
                       join person  on ACC.personid=person.personid and person.activeflag=1 
       join personaddress pa on pa.personid=person.personid and pa.activeflag=1 where INT.intakenumber=INTSR.intakenumber group by 1 order by max(pa.insertedon) desc limit 1)) as character varying) 
             as parentorguardianaddress,
    cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,
    (select distinct typedescription from gendertype where gendertypekey=p.gendertypekey) as gender,
    (select distinct typedescription from racetype where racetypekey=p.racetypekey) as race,
               cast((select array_agg(AG.name)  from  allegation AG
         join intakeservicerequestevaluationconfig ITSEC  on ITSEC.allegationid=AG.allegationid and AG.activeflag=1
         where  ITSEC.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid and ITSEC.activeflag=1 limit 1) as character varying[])  as offensename,
    CAST(s.schoolname as character varying) as school,
               cast(pe.lastgradetypekey  as character varying) as grade,
      CAST(iw.iwname as character varying) as iw_name,
      cast((select distinct up.lastname || ', ' || up.firstname from userprofile up where securityusersid = i_secid) as character varying) as  cw_name,
      cast(pl.projectedreleasedate as character varying) as releaseddate,
               cast(pr.providername as character varying) as provider_name,
               cast(ca.hearingdatetime as character varying) as court_date      
             from 
    intakeservicerequestevaluation inve
             left join intakeservicerequest INTSR on INTSR.intakenumber=inve.intakenumber 
             left join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1 and INSRA.intakeservicerequestpersontypekey='Youth'
             left join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 
             left join person p on ACC.personid=p.personid and p.activeflag=1
    left join intakeservicerequestevaluationconfig ITSEC on ITSEC.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid and ITSEC.activeflag=1
             left join allegation AG on ITSEC.allegationid=AG.allegationid and AG.activeflag=1
             left join placement pl on INTSR.intakeserviceid =pl.intakeserviceid and pl.activeflag=1
             left JOIN provider pr ON pl.providerid = pr.providerid AND pr.activeflag=1
             left join intakeservicerequestcourtaction ca on INTSR.intakeserviceid=ca.intakeservicerequestid and ca.activeflag=1     
             left join ( select distinct objectid,up.lastname || ', ' || up.firstname as iwname from routing join userprofile up
             on routing.fromsecurityusersid=up.securityusersid and up.activeflag=1 and routing.fromroleid='JSIW' and routing.toroleid='JSADU'  ) iw
             on INTSR.intakenumber=iw.objectid
             left join personeducation pe on pe.personid = p.personid and pe.activeflag=1
             left join school s on s.schoolid=pe.schoolid and s.activeflag=1
              where  INTSR.intakenumber = i_intakenumber   
  union
          select 
    CAST(ida.intakenumber  as character varying) as intakeid ,
    cast(coalesce(obj->>'cjamspid','') as character varying) as youthid,
    cast(pl.placementdate as character varying) as interviewdate,
           cast(INITCAP(TRIM(coalesce(obj->>'Lastname',''))|| CASE WHEN (obj->>'suffix' is not null and obj->>'suffix'!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(obj->>'suffix','')) || ', ' ||TRIM(coalesce(obj->>'Firstname',''))) as  character varying)   as youthname,
           cast((select cast(INITCAP(TRIM(coalesce(obj->>'Lastname',''))|| CASE WHEN (obj->>'suffix' is not null and obj->>'suffix'!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(obj->>'suffix','')) || ', ' ||TRIM(coalesce(obj->>'Firstname',''))) as  character varying)   
                       from intakedastaging ida , jsonb_array_elements(ida.jsondata->'persons') obj
                       where ida.activeflag=1  and (obj->>'RelationshiptoRA' ='father' or obj->>'RelationshiptoRA' ='mother') and ida.intakenumber=i_intakenumber)  as character varying) as parentorguardianname,
           cast((select coalesce(obj->>'phoneNumber','')
        from intakedastaging ida , jsonb_array_elements(ida.jsondata->'persons') obj
           where ida.activeflag=1  and (obj->>'RelationshiptoRA' ='father' or obj->>'RelationshiptoRA' ='mother') and ida.intakenumber=i_intakenumber) as character varying) as parentorguardianphone,
     cast((select coalesce(obj->>'Address','')
        from intakedastaging ida , jsonb_array_elements(ida.jsondata->'persons') obj
           where ida.activeflag=1  and (obj->>'RelationshiptoRA' ='father' or obj->>'RelationshiptoRA' ='mother') and ida.intakenumber=i_intakenumber) as character varying) as parentorguardianaddress,
    cast(coalesce(obj->>'Dob','') as character varying) as dateofbirth,
     cast((select distinct typedescription from gendertype where gendertypekey=cast(coalesce(obj->>'Gender','') as character varying))  as character varying) as gender,
     cast((select distinct typedescription from racetype where racetypekey=cast(coalesce(obj->>'race','') as character varying)) as character varying) as race,
     cast(null as character varying[])  as offensename,
         cast(coalesce(obj->>'school','') as character varying) as school,
     cast(null as character varying)  as grade,
           CAST(iw.iwname as character varying) as iw_name,
     cast((select distinct up.lastname || ', ' || up.firstname from userprofile up where securityusersid = i_secid) as character varying) as  cw_name,
     cast(pl.projectedreleasedate as character varying) as releaseddate,
           cast(pr.providername as character varying) as provider_name,
           cast(ca.hearingdatetime as character varying) as court_date
         FROM
         intakedastaging ida 
          left join placement pl on ida.intakenumber =pl.intakenumber and pl.activeflag=1
             left JOIN provider pr ON pl.providerid = pr.providerid AND pr.activeflag=1 
    left join intakeservicerequestcourtaction ca on ida.intakenumber=ca.intakenumber and ca.activeflag=1     
             left join ( select distinct objectid,up.lastname || ', ' || up.firstname as iwname from routing join userprofile up
             on routing.fromsecurityusersid=up.securityusersid and up.activeflag=1 and routing.fromroleid='JSIW' and routing.toroleid='JSADU'  ) iw
     on ida.intakenumber=iw.objectid
    , jsonb_array_elements(ida.jsondata->'persons') obj 
          where  ida.activeflag=1  and obj->>'Role' ='Youth'  and
          (ida.intakenumber=i_intakenumber)   and  obj->>'cjamspid' is not null      
     limit 1) ;   
   end;
  $function$

