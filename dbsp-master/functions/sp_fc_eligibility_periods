CREATE OR REPLACE FUNCTION sp_fc_eligibility_periods(al_client_id bigint, al_removal_id bigint, v_result json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
v_eligibility_id int4;
eachperiod json;
v_count integer;
v_type_cd character varying;
v_status_cd character varying;

begin
 select eligibility_id, eligibility_type_cd, eligibility_status_cd into v_eligibility_id , v_type_cd, v_status_cd from tb_client_eligibility where client_id = al_client_id and removal_id = al_removal_id;
 RAISE  NOTICE  '  v_result  %',v_result;
 for eachperiod in 
 SELECT * from json_array_elements(v_result::json)
 loop
 RAISE  NOTICE  '  eachperiod start_dt v_end_dt % %', eachperiod->>'start_dt', eachperiod->>'end_dt' ;

 select count(*) into v_count from tb_eligibility_period where eligibility_id = v_eligibility_id and start_dt = (eachperiod->>'start_dt')::timestamp and end_dt = (eachperiod->>'end_dt')::timestamp;
 
 if v_count = 0 then
 INSERT INTO tb_eligibility_period
 (eligibility_period_id, type_cd, start_dt, end_dt, status_cd, eligibility_id, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
 VALUES(nextval('seq_tb_eligibility_period')::integer, v_type_cd, (eachperiod->>'start_dt')::timestamp, (eachperiod->>'end_dt')::timestamp, v_status_cd, v_eligibility_id, now(), 'admin', now(), 'admin', 'N'::bpchar);
 end if;

 end loop;
 
 return 'success';

end

 $function$

