CREATE OR REPLACE FUNCTION getprovidercomplaintcotactdetails(provider_complaintid uuid, pagenumber integer, pagelimit integer)
 RETURNS TABLE(totalcount bigint, provider_complaint_contactsid uuid, complaint_contacts_name character varying, complaint_contacts_source character varying, complainant_contacts_phone character varying, insertedby character varying, updateby character varying, inserted_on timestamp without time zone, updated_on timestamp without time zone)
 LANGUAGE plpgsql
AS $function$

DECLARE 
v_pageoffset int;
v_pagenumber int;
v_pagelimit int;
v_limit int;
 totalcount integer;
 v_provider_complaintid uuid;


 BEGIN
 v_limit=10;
    v_pagenumber := pageNumber-1;
    v_pageoffset = v_pagenumber * v_limit; 
v_provider_complaintid:=provider_complaintid; 

 RETURN QUERY 
 
 select count(1) OVER() totalcount, pcc.provider_complaint_contactsid,pcc.complaint_contacts_name,
 pcc.complaint_contacts_source,pcc.complainant_contacts_phone,cast(up.firstname || ' ' || up.lastname as character varying) as insertedby,
cast(up1.firstname || ' ' || up1.lastname as character varying) as updatedby,
pcc.inserted_on,pcc.updated_on
 from tb_provider_complaint_contacts pcc 
 join userprofile up on up.securityusersid=pcc.inserted_by and up.activeflag=1
   join userprofile up1 on up1.securityusersid=pcc.updated_by and up1.activeflag=1
 where pcc.provider_complaintid=v_provider_complaintid and pcc.activeflag=1

 LIMIT v_limit OFFSET v_pageoffset ;  
                     
end

$function$

