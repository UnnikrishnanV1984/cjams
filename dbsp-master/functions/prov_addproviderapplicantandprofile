CREATE OR REPLACE FUNCTION prov_addproviderapplicantandprofile(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
 


declare

v_ReqReferralId text;
v_applicantId text;
returnStatus text;
v_securityuserid text;
v_providerid text;
v_program_type text;
v_provid int;
v_profileid uuid;
v_toroleid text;
v_comment text;
l_applicantId character varying;
v_subject character VARYING;
v_fromsecurityuserid character varying;
v_success character VARYING;
v_provider_name character varying;
v_status character varying;
v_roleidname character varying;
v_fromroleid character varying;
v_toroleidname character varying;
BEGIN

v_ReqReferralId := insertedtlsobj->>'provider_referral_id';
v_applicantId := insertedtlsobj->>'provider_applicant_id';
v_securityuserid := insertedtlsobj->>'securityuserid';
v_program_type := insertedtlsobj->>'program_type';
v_provid := insertedtlsobj->>'provid';
v_profileid := insertedtlsobj->>'profileid';
v_toroleid := insertedtlsobj->>'toroleid';
v_comment := insertedtlsobj->>'comment';
v_fromsecurityuserid := insertedtlsobj->>'fromsecurityuserid';
v_status := insertedtlsobj->>'v_status';
v_roleidname := insertedtlsobj->>'roleidname';
v_fromroleid := insertedtlsobj->>'fromroleid';
v_toroleidname := insertedtlsobj->>'toroleidname';
RAISE NOTICE '%','11111111111111111111111111111111111111111111111111111';

IF LENGTH(v_applicantId) > 1
THEN
select applicant_id from tb_provider_applicant where applicant_id = v_applicantId into l_applicantid; 
Select provider_id into v_providerid from tb_provider_referral where provider_referral_id = v_ReqReferralId;

IF LENGTH(v_providerid) > 1
THEN

select applicant_id from tb_provider_applicant where applicant_id = v_applicantId into l_applicantid; 
IF (l_applicantid IS NULL OR l_applicantid = '') THEN 
INSERT into  tb_provider_applicant(applicant_id, create_user_id,update_user_id,program_name,contact_email,contact_phonenumber, contact_fax, 
mailing_address,program_type,provider_id,prgram,application_status,program_tax_id_no,corporation_name,create_ts,agency,accreditation,profit, application_decision, license_agency) 
(select v_applicantId, v_securityuserid, v_securityuserid, pr.provider_program_name,pr.adr_email_tx,pr.adr_cell_phone_tx, adr_fax_tx
,'',v_program_type,  v_providerid , pr.provider_referral_program,
'Pending',pr.corporation_entity_taxid::int,pr.corporation_entity,now()::timestamp,pr.agency ,pr.accreditation,pr.profit, 'Pending', pr.license_agency
from tb_provider_referral pr  where pr.provider_referral_id = v_ReqReferralId) 
ON CONFLICT ON CONSTRAINT pk_prv_app_add_1
DO 
 UPDATE SET program_type = EXCLUDED.program_type||','||tb_provider_applicant.program_type;
END IF;
update tb_prov_ref_program_type set applicant_id = v_applicantId ,updatedby = v_securityuserid, updatedon=now() where referral_id = v_ReqReferralId and program_type = v_program_type;  

INSERT INTO tb_provider_decision
(decisionid, eventcode, fromsecurityusersid, fromroleid, objectid, activeflag, insertedby, insertedon, updatedby, updatedon, isreviewrequest, remarks, status, decisiondate,
toroleid,tosecurityusersid)
VALUES(gen_random_uuid(),'PTA', v_securityuserid, v_fromroleid, v_applicantId, 1, v_securityuserid, now(), v_securityuserid,
now(), false, v_comment, v_status,  now(),v_toroleidname,v_toroleid);

raise notice 'before providerassignment%',v_securityuserid;
raise notice 'before providerassignment%',v_toroleid;
raise notice 'before providerassignment%',(select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_securityuserid);
raise notice 'before providerassignment%',(select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_toroleid);


INSERT INTO providerassignment(fromworkeridno, toworkeridno, 
           objecttypekey, objectid, activeflag, startdate, 
            enddate, fromteamid, toteamid, remarks, assigndate, 
            insertedby, updatedby, insertedon, updatedon)
    VALUES (v_securityuserid, v_toroleid, 'Application',v_applicantId,1,now(),null,(select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_securityuserid),
            (select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_toroleid), v_comment,now(),v_securityuserid,v_securityuserid, now(),now()) ;

--if(v_provider_name = '') then 
 select provider_referral_nm into v_provider_name from tb_provider_referral tpr where tpr.provider_referral_id = v_ReqReferralId;
-- end if;

v_subject := v_applicantId ||' Application created from Referral for Provider - '|| v_provider_name;

           RAISE NOTICE 'v_subject %', v_subject;
SELECT prov_send_notification into v_success
    FROM  prov_send_notification(v_toroleid, v_securityuserid, v_toroleid, 'System', 'High', v_subject, v_subject, v_applicantId,  false);

raise notice 'v_success %', v_success;

else
IF (l_applicantid IS NULL OR l_applicantid = '') THEN 
INSERT into  tb_provider_applicant(applicant_id, create_user_id,update_user_id,program_name,contact_email,contact_phonenumber,
mailing_address,program_type,applicant_profile_id,prgram,provider_id,application_status,program_tax_id_no,corporation_name,create_ts,agency,accreditation,profit, license_agency) 
select v_applicantId, v_securityuserid, v_securityuserid, pr.provider_program_name,pr.adr_email_tx,pr.adr_cell_phone_tx,
cast( pra.adr_street_no || ',' ||pra.adr_street_nm || ',' ||pra.adr_city_nm ||',' || pra.adr_state_cd ||',' || pra.adr_zip5_no as character varying),
v_program_type, v_profileid,pr.provider_referral_program, v_provid , 
'Pending',pr.corporation_entity_taxid::int,pr.corporation_entity,now()::timestamp,pr.agency ,pr.accreditation,pr.profit, pr.license_agency
from tb_provider_referral pr ,tb_provider_referral_addresses pra where pr.provider_referral_id = v_ReqReferralId and pra.parent_key_id= v_ReqReferralId 
ON CONFLICT ON CONSTRAINT pk_prv_app_add_1
DO 
 UPDATE SET program_type = EXCLUDED.program_type||','||tb_provider_applicant.program_type;
END IF;
update tb_prov_ref_program_type set applicant_id = v_applicantId ,updatedby = v_securityuserid, updatedon=now() where referral_id = v_ReqReferralId and program_type = v_program_type; 

raise notice '***************';
raise notice 'before providerassignment%',v_securityuserid;
raise notice 'before providerassignment%',v_toroleid;
raise notice 'before providerassignment%',(select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_securityuserid);
raise notice 'before providerassignment%',(select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_toroleid);

INSERT INTO providerassignment(fromworkeridno, toworkeridno, 
           objecttypekey, objectid, activeflag, startdate, 
            enddate, fromteamid, toteamid, remarks, assigndate, 
            insertedby, updatedby, insertedon, updatedon)
    VALUES (v_securityuserid, v_toroleid, 'Application',v_applicantId,1,now(),null,(select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_securityuserid),
            (select tm.teamid from teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid where tma.securityusersid = v_toroleid), v_comment,now(),v_securityuserid,v_securityuserid, now(),now()) ;
             

end if;

else
returnStatus:= 'failure';
END IF;
returnStatus:= 'Success';
RETURN returnStatus;              
                                                      
END;
$function$

