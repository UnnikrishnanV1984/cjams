CREATE OR REPLACE FUNCTION prov_sendassignedworkernotification(v_fromsecurityuserid character varying, v_objectid character varying, v_notifymsg character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
v_success character varying;
currentRow record;
v_msg character varying;
v_username character varying;
begin

SELECT COALESCE(up.firstname,'') || ' ' || COALESCE(up.lastname,'')  
    INTO v_username
    FROM userprofile up 
    WHERE up.securityusersid = v_fromsecurityuserid;

v_msg:=  v_notifymsg || ' by '  ||   v_username;
    ---Send notification assigned workers
for currentRow IN SELECT distinct toworkeridno 
                        FROM providerassignment pa 
                        where trim(pa.objectid) = v_objectid and (pa.enddate is null or pa.enddate <= now()) and pa.activeflag = 1                        
loop
    BEGIN
        SELECT prov_send_notification into v_success
        FROM  prov_send_notification(currentRow.toworkeridno,v_fromsecurityuserid, currentRow.toworkeridno,'System', 'High', v_msg,v_msg,v_objectid);
    END;
end loop;
return 'success';
end;
$function$

