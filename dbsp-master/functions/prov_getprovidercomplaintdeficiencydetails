CREATE OR REPLACE FUNCTION prov_getprovidercomplaintdeficiencydetails(v_securityusersid character varying, v_provider_complaintid uuid, p_status character varying, v_providerid integer, v_cap_no character varying, pagenumber integer, pagelimit integer, sortorder character varying, sortcolumn character varying)
 RETURNS TABLE(totalcount bigint, tb_provider_complaint_deficiencyid uuid, provider_complaintid uuid, deficiency_violationname character varying, citation text, frequencyofdeficiency character varying, impactofdeficiency character varying, scopeofdeficiency character varying, findings text, need_cap character varying, complaint_number character varying, provider_id integer, notificationsecurityuserid character varying, prv_signimage text, prv_signdate timestamp without time zone, qa_signimage text, qa_signdate timestamp without time zone, pm_signimage text, pm_signdate timestamp without time zone, ed_signimage text, ed_signdate timestamp without time zone, uploadedfile json, deficiency_number character varying, cap_number character varying, provider_nm character varying, site_id character varying, reference_value_id character varying, reference_id uuid, violation_id uuid, comments text, isdraft boolean, cap_status character varying, cap_status_description character varying, planofcorrection character varying, disputecomarcitation character varying, targetdate timestamp without time zone, isdispute boolean, isacknowledged boolean, isnotificationsent boolean, duedate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                   
 DECLARE                                                                                                                                                                                                                                                                                                           
 v_pageoffset int;                                                                                                                                                                                                                                                                                                 
 v_pagenumber int;                                                                                                                                                                                                                                                                                                 
 v_pagelimit int;                                                                                                                                                                                                                                                                                                  
 v_limit int;                                                                                                                                                                                                                                                                                                      
  totalcount integer;                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                   
  BEGIN                                                                                                                                                                                                                                                                                                            
  v_limit=pagelimit;                                                                                                                                                                                                                                                                                               
   v_pagenumber := pageNumber-1;                                                                                                                                                                                                                                                                                 
     v_pageoffset = v_pagenumber * v_limit;                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
  RETURN QUERY                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
 select  count(1) OVER() totalcount, tcd.tb_provider_complaint_deficiencyid,tcd.provider_complaintid,tcd.deficiency_violationname,                                                                                                                                                                 
         tcd.citation,tcd.frequencyofdeficiency as frequencyofdeficiency,tcd.impactofdeficiency as impactofdeficiency,tcd.scopeofdeficiency as scopeofdeficiency,tcd.findings,
         tcd.need_cap, tpc.complaint_number,tpc.provider_id,
         tcd.notificationsecurityuserid,
         tcd.prv_signimage, tcd.prv_signdate, tcd.qa_signimage, tcd.qa_signdate, tcd.pm_signimage, tcd.pm_signdate, tcd.ed_signimage, tcd.ed_signdate,
         tcd.uploadedfile,pv.deficiency_number,pv.cap_number
         ,tp.provider_nm  as provider_nm, 
         tp.provider_id::character varying  as site_id,
                    pv.reference_value_id,
                    pv.reference_id,
                    pv.violation_id,
                    pv.comments,
                    pv.isdraft,
                    pv.cap_status,
                    pv.cap_status_description,
                    pv.planofcorrection,
                    pv.disputecomarcitation,
                    pv.targetdate,
                    pv.isdispute,
                    pv.isacknowledged,
                    pv.isnotificationsent,
                    pv.duedate
 from tb_provider_complaint_deficiency tcd
 left join tb_provider_complaint tpc on tcd.provider_complaintid =tpc.provider_complaintid
  left join prov_violation pv on pv.reference_id=tcd.tb_provider_complaint_deficiencyid
  left join tb_provider tp on  tp.provider_id = pv.site_id and tp.delete_sw = 'N' 
-- left join providerstaff ps on tpc.provider_id:: character varying  = ps.object_id and ps.employee_type = 'Program Administrator'
-- left join routing r on tcd.cap_number = r.objectid and r.eventcode = 'PRCAP'
-- left join tb_provider_applicant tpa on tpa.provider_id::INT =  tpc.provider_id
-- left join tb_provider_decision tpd on tpa.applicant_id = tpd.objectid and tpd.fromroleid = 'Licensing Administrator' and tpd.status = 'Approved'
-- left join userprofile up on up.securityusersid = tpd.fromsecurityusersid
-- left join userprofilephonenumber upn on up.securityusersid = upn.securityusersid and  upn.userprofiletypekey = 'cell'
-- left join  tb_provider_licensing tpl on tpa.provider_id::int = tpl.provider_id
 where (v_provider_complaintid is null or tcd.provider_complaintid=v_provider_complaintid)
           and (v_providerid is null or (tpc.provider_id=v_providerid and tcd.isnotificationsent = true ))
           and (v_cap_no is null or(pv.cap_number = v_cap_no))  
--           and (case when p_status = 'pending' then ( tcd.isnotificationsent = false or tcd.isnotificationsent is null)
--             when p_status = 'review' then ( tcd.isnotificationsent = true or tcd.cap_status = '100' and r.tosecurityusersid = v_securityusersid and r.activeflag =1)
--       when p_status = 'active' then (tcd.cap_status in ('101','102','103','104','105','106','107','108') )
--       when p_status = 'closed' then (tcd.cap_status = '109') 
--     else true end)

         and tcd.activeflag=1            
group by 
tcd.tb_provider_complaint_deficiencyid,tcd.provider_complaintid,tcd.deficiency_violationname,pv.cap_number,                                                                                                                                                                 
tcd.citation,tcd.frequencyofdeficiency,tcd.impactofdeficiency,tcd.scopeofdeficiency,tcd.findings,
         tcd.need_cap, tpc.complaint_number,tpc.provider_id,
          tcd.notificationsecurityuserid,
         tcd.prv_signimage, tcd.prv_signdate, tcd.qa_signimage, tcd.qa_signdate, tcd.pm_signimage, tcd.pm_signdate, tcd.ed_signimage
         , tcd.ed_signdate,pv.violation_id,tp.provider_id
        -- , tpl.license_no,tpl.license_level,tpl.license_type,tpa.program_name,tpa.mailing_address
         --,up.fullname,up.email,upn.phonenumber,         ps.first_nm ,ps.last_nm,ps.staff_phone_no ,ps.staff_email

order by  
 ( CASE sortorder when 'asc' then 
  CASE sortcolumn 
  when 'cap_number' then  cast( pv.cap_number as character varying) 
        when 'deficiency_violationname' then  cast (tcd.deficiency_violationname as character varying )
        when 'citation' then cast (tcd.citation as character varying )
        when 'frequencyofdeficiency' then  cast (tcd.frequencyofdeficiency as character varying )          
        when 'impactofdeficiency' then  cast (tcd.impactofdeficiency as character varying )
  when 'scopeofdeficiency' then cast (tcd.scopeofdeficiency as character varying )
  --when 'license_no' then  cast (tpl.license_no as character varying )
        when 'need_cap' then  cast (tcd.need_cap as character varying )  
        when 'cap_status_description' then cast (tcd.cap_status_description as character varying )            
 else cast( pv.cap_number as character varying) end end) asc,
 ( CASE sortorder when 'desc' then 
  CASE sortcolumn 
  when 'cap_number' then  cast( pv.cap_number as character varying) 
        when 'deficiency_violationname' then cast (tcd.deficiency_violationname as character varying )
        when 'citation' then cast (tcd.citation as character varying )
        when 'frequencyofdeficiency' then cast (tcd.frequencyofdeficiency as character varying )          
        when 'impactofdeficiency' then cast (tcd.impactofdeficiency as character varying )
  when 'scopeofdeficiency' then cast (tcd.scopeofdeficiency as character varying )
  --when 'license_no' then cast (tpl.license_no as character varying )
        when 'need_cap' then cast (tcd.need_cap as character varying )  
        when 'cap_status_description' then cast (tcd.cap_status_description as character varying )     
 else cast( pv.cap_number  as character varying) end end) desc
LIMIT v_limit OFFSET v_pageoffset ;    
        
                                                                                                                                                                                                                                                                                                                   
 end;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 $function$

