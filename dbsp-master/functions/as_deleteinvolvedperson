CREATE OR REPLACE FUNCTION as_deleteinvolvedperson(v_personid uuid, v_intakeserviceid uuid DEFAULT NULL::uuid, v_intakenumber character varying DEFAULT NULL::character varying, v_iscase boolean DEFAULT false, v_servicecaseid uuid DEFAULT NULL::uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
 declare _offset integer;
 
   v_actorid uuid;
begin

 if(v_iscase = true)
 then 
 update actor set activeflag = 0 where personid = v_personid and intakeserviceid = v_intakeserviceid;
 
 select actorid into v_actorid from actor where  personid = v_personid and intakeserviceid = v_intakeserviceid limit 1;
  update intakeservicerequestactor set activeflag=0, updatedby = 'system', updatedon = now() where actorid=v_actorid;
 
   else
 
 update actor set activeflag = 0 where personid = v_personid and intakenumber = v_intakenumber;
 
 select actorid into v_actorid from actor where  personid = v_personid and 
  intakenumber = v_intakenumber limit 1;
  update intakeservicerequestactor set activeflag=0, updatedby = 'system', updatedon = now() where actorid=v_actorid;
 
   end if;
  
  if(v_servicecaseid is not null) then
  
  update actor set activeflag = 0 where personid = v_personid and servicecaseid = v_servicecaseid;
 
 select actorid into v_actorid from actor where  personid = v_personid and 
  servicecaseid = v_servicecaseid limit 1;
  update intakeservicerequestactor set activeflag=0, updatedby = 'system', updatedon = now() where actorid=v_actorid;
  
  end if;
  
  return 'SUCCESS';
end;


$function$

