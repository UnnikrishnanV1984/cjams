CREATE OR REPLACE FUNCTION as_f_fm830r_s(start_date date, end_date date)
 RETURNS TABLE(adj_payment_id integer, orig_payment_id integer, provider_id integer, provider_name character varying, address character varying, tax_id_no numeric, final_fiscal_category_cd character, type character varying, indicator character, payment_amount numeric, client_id bigint, child_name character varying, status character varying, payment_status_cd character varying, count_name character varying, county_cd character varying, worker_nm character varying, supervisor_nm character varying, fname character varying, mname character varying, lname character varying, suffix character varying, payment_dt date)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY 
( SELECT DISTINCT ph.payment_id AS adj_payment_id,
    pd.linked_pymnt_hdr_id AS orig_payment_id,
    p.provider_id,
   as_f_ename('2953'::character varying, p.provider_id::integer, ''::character varying) 
    AS provider_name,
    as_f_provider_add('TB_PROVIDER_ADDRESSES'::character varying, p.provider_id::bigint, '3356'::character varying) AS address,
    p.tax_id_no,
    pd.final_fiscal_category_cd,
    pd.type_1099_cd AS "type",
    pd.report_1099_sw AS indicator,
    pd.final_amount_no AS payment_amount,
    pd.client_id,
             CASE
            WHEN pd.client_id > 0 THEN ( SELECT distinct      coalesce(firstname || ' ','') ||
    coalesce(middlename || ' ','') ||
    coalesce(lastname || ' ','') 
               FROM person l
              WHERE l.cjamspid = pd.client_id)
            ELSE ''::character varying
        END AS child_name,
        as_f_plvalue(ps.payment_status_cd, 133) AS status,
    ps.payment_status_cd,
    pd.county_cd AS count_name,
    as_f_plvalue(pd.county_cd, 104) AS county_cd,
     as_f_sname(as_f_prim_assignment(P.provider_id, '2953'::character varying)) AS worker_nm,
  as_f_sname(as_f_supervisor(as_f_prim_assignment(P.provider_id, '2953'::character varying)::character varying)) AS supervisor_nm,
clt.firstname AS fname,
    clt.middlename AS mname,
    clt.lastname AS lname,
    clt.suffix,
    ph.payment_dt
   FROM tb_payment_header ph,
    tb_payment_detail pd,
    tb_payment_status ps,
    tb_provider p,
    person clt
  WHERE ph.payment_id = pd.payment_id AND ps.payment_id = ph.payment_id AND p.provider_id = ph.provider_id 
AND clt.cjamspid::text = pd.client_id::character varying::text AND ph.payment_type_cd::text = '3294'::text 
AND (ph.manual_sw = 'N'::bpchar OR ph.manual_sw IS NULL) AND ph.delete_sw = 'N'::bpchar 
AND pd.delete_sw = 'N'::bpchar AND ps.delete_sw = 'N'::bpchar AND p.delete_sw = 'N'::bpchar
and ph.PAYMENT_DT>=CAST( START_DATE AS DATE)
  AND ph.PAYMENT_DT<=CAST( END_DATE  AS DATE)
 );
 END;
 $function$

