CREATE OR REPLACE FUNCTION prov_searchprovider_v2(searchobj json)
 RETURNS TABLE(totalcount bigint, provider_id integer, mail_code_tx character varying, prov_tax_type_cd character varying, tax_id_no numeric, indicator_1099_sw character, medicaid_sw character, withhold_payment_sw character, admission_comments_tx character varying, provider_category_cd character varying, conversion_no_tx integer, source_tx character varying, provider_status_cd character varying, paid_sw character, profit_sw character, provider_nm character varying, provider_prefix_cd character varying, provider_first_nm character varying, provider_middle_nm character varying, provider_last_nm character varying, provider_suffix_cd character varying, business_start_tm character varying, business_end_tm character varying, medical_license_no_tx character varying, medical_speciality_tx character varying, school_district_tx character varying, county_cd character varying, collecting_entity_cd character varying, vacancy_no integer, pay_to_affiliate_cd character varying, dob_dt date, ref_contact_prefix_cd character varying, ref_contact_first_nm character varying, ref_contact_middle_nm character varying, ref_contact_last_nm character varying, ref_contact_suffix_cd character varying, adm_contact_prefix_cd character varying, adm_contact_first_nm character varying, adm_contact_middle_nm character varying, adm_contact_last_nm character varying, adm_contact_suffix_cd character varying, adr_work_phone_tx character varying, adr_work_xtn_tx character varying, adr_home_phone_tx character varying, adr_pager_tx character varying, adr_email_tx character varying, adr_fax_tx character varying, adr_cell_phone_tx character varying, adr_url_tx character varying, adr_other_contact_tx character varying, create_ts character varying, create_user_id character varying, update_ts character varying, update_user_id character varying, delete_sw character, affiliate_provider_id integer, co_prefix_cd character varying, co_first_nm character varying, co_middle_nm character varying, co_last_nm character varying, co_suffix_cd character varying, co_ssn_no numeric, co_dob_dt date, provider_type_cd character varying, ive_reimbursable_sw character, accept_plcmnt_ref_sw character, ref_work_phone_tx character varying, ref_work_xtn_tx character, ref_home_phone_tx character varying, ref_pager_tx character varying, ref_email_tx character varying, ref_fax_tx character varying, ref_cell_phone_tx character varying, ref_url_tx character varying, ref_other_contact_tx character varying, adm_work_phone_tx character varying, adm_work_xtn_tx character, adm_home_phone_tx character varying, adm_pager_tx character varying, adm_email_tx character varying, adm_fax_tx character varying, adm_cell_phone_tx character varying, adm_url_tx character varying, adm_other_contact_tx character varying, formatted_first_nm character varying, formatted_last_nm character varying, first_nm_soundex character, last_nm_soundex character, eft_sw character, formatted_middle_nm character varying, formatted_provider_nm character varying, provider_nm_soundex character, lnm_soundex character varying, fnm_soundex character varying, pnm_soundex character varying, info_date_changed date, reason_changed character varying, old_provider_id character varying, county_cd_tx character varying, agency character varying, county character varying, programtype character varying, is_cfe boolean, iscfebedholdretainer boolean, jurisdiction character varying, recon_data json, licensing_agencies json, providername character varying)
 LANGUAGE plpgsql
AS $function$
DECLARE
 
    v_provider_id INTEGER;    
    v_providercategory character varying;
    pagenumber integer;
    pagesize integer;
    v_pageoffset integer;
    v_pagenumber integer;
    v_program_type_cd character varying;
    v_provider_status_cd character varying;  
    v_program_nm character varying;
   v_provider_nm character varying;
  v_county_cd character varying;
v_county character varying;
v_toworkeridno character varying;
v_toteamid character varying;
    v_order_column character varying;
    v_order_dir character varying;
 ordr json;
 v_affilitate_id character varying;

BEGIN

 v_provider_id := searchobj ->> 'provider_id';
 v_providercategory := (searchobj ->> 'providercategorycd')::character varying;
 pagenumber := searchobj ->> 'pagenumber';
 pagesize := searchobj ->> 'pagesize';
 v_program_type_cd :=  searchobj ->>'program_type';
 v_provider_status_cd := searchobj ->>'providerstatuscd';
 v_county:=searchobj->>'county';
 v_program_nm := searchobj ->> 'program_name';
 v_provider_nm :=searchobj->>'provider_nm';
 v_provider_nm='%' || trim(v_provider_nm) || '%';
 v_toworkeridno = (searchobj->>'assignto')::character varying;
 v_toteamid = (searchobj->>'teamid')::character varying;
 ordr = (searchobj->>'order')::json;
 v_order_column = (ordr->>'order_column')::character varying;
 v_order_dir = (ordr->>'order_dir')::character varying;
 v_affilitate_id = (searchobj->>'affiliate_provider_id');

 RAISE NOTICE ' providercategorycd>>>>>  :%', searchobj->>'providercategorycd';
 RAISE NOTICE ' provider_nm>>>>>  :%', searchobj->>'provider_nm';
 RAISE NOTICE ' provider_id>>>>>  :%', searchobj->>'provider_id';
 RAISE NOTICE ' v_toworkeridno>>>>>  :%', v_toworkeridno;
 RAISE NOTICE ' searchobj>>>>>  :%', searchobj;

 v_pagenumber := pagenumber-1;
 v_pageoffset = v_pagenumber * pagesize;
v_county_cd :=  v_county;

 
return query

select count(1) over() as totalcount, a.*,recon.recon_data::json, 
(select json_agg(ag) from (select distinct tpv.value_tx as license_agency_txt, tpl04.license_level  from tb_provider_licensing tpl04 
 inner join tb_picklist_values tpv on tpv.picklist_value_cd =tpl04.licensing_agency_cd and tpv.picklist_type_id =111 
 and tpv.active_sw ='Y' where tpl04.provider_id = a.provider_id and tpl04.active_sw = 'Y') ag )::json as licensing_agencies,
(a.provider_last_nm||', '||a.provider_first_nm)::character varying as providername from (
   
  SELECT DISTINCT TBP.provider_id ,
  TBP.mail_code_tx ,
  TBP.prov_tax_type_cd ,
  TBP.tax_id_no ,
  TBP.indicator_1099_sw ,
  TBP.medicaid_sw ,
  TBP.withhold_payment_sw ,
  TBP.admission_comments_tx ,
  tpp.picklist_value_cd as provider_category_cd ,
  TBP.conversion_no_tx ,
  TBP.source_tx ,
  TBP.provider_status_cd ,
  TBP.paid_sw ,
  TBP.profit_sw ,
  TBP.provider_nm ,
  TBP.provider_prefix_cd ,
  TBP.provider_first_nm ,
  TBP.provider_middle_nm ,
  TBP.provider_last_nm ,
  TBP.provider_suffix_cd ,
  TBP.business_start_tm ,
  TBP.business_end_tm ,
  TBP.medical_license_no_tx ,
  TBP.medical_speciality_tx ,
  TBP.school_district_tx ,
  TBP.county_cd ,
  TBP.collecting_entity_cd ,
  TBP.vacancy_no ,
  TBP.pay_to_affiliate_cd ,
  TBP.dob_dt::date,
  TBP.ref_contact_prefix_cd ,
  TBP.ref_contact_first_nm ,
  TBP.ref_contact_middle_nm ,
  TBP.ref_contact_last_nm ,
  TBP.ref_contact_suffix_cd ,
  TBP.adm_contact_prefix_cd ,
  TBP.adm_contact_first_nm ,
  TBP.adm_contact_middle_nm ,
  TBP.adm_contact_last_nm ,
  TBP.adm_contact_suffix_cd ,
  TBP.adr_work_phone_tx ,
  TBP.adr_work_xtn_tx ,
  TBP.adr_home_phone_tx ,
  TBP.adr_pager_tx ,
  TBP.adr_email_tx ,
  TBP.adr_fax_tx ,
  TBP.adr_cell_phone_tx ,
  TBP.adr_url_tx ,
  TBP.adr_other_contact_tx ,
  TBP.create_ts::character varying ,
  TBP.create_user_id ,
  TBP.update_ts::character varying ,
  TBP.update_user_id ,
  TBP.delete_sw ,
  TBP.affiliate_provider_id ,
  TBP.co_prefix_cd ,
  TBP.co_first_nm ,
  TBP.co_middle_nm ,
  TBP.co_last_nm ,
  TBP.co_suffix_cd ,
  TBP.co_ssn_no ,
  TBP.co_dob_dt::date,
  TBP.provider_type_cd ,
  TBP.ive_reimbursable_sw ,
  TBP.accept_plcmnt_ref_sw ,
  TBP.ref_work_phone_tx ,
  TBP.ref_work_xtn_tx ,
  TBP.ref_home_phone_tx ,
  TBP.ref_pager_tx ,
  TBP.ref_email_tx ,
  TBP.ref_fax_tx ,
  TBP.ref_cell_phone_tx ,
  TBP.ref_url_tx ,
  TBP.ref_other_contact_tx ,
  TBP.adm_work_phone_tx ,
  TBP.adm_work_xtn_tx ,
  TBP.adm_home_phone_tx ,
  TBP.adm_pager_tx ,
  TBP.adm_email_tx ,
  TBP.adm_fax_tx ,
  TBP.adm_cell_phone_tx ,
  TBP.adm_url_tx ,
  TBP.adm_other_contact_tx ,
  TBP.formatted_first_nm ,
  TBP.formatted_last_nm ,
  TBP.first_nm_soundex ,
  TBP.last_nm_soundex ,
  TBP.eft_sw ,
  TBP.formatted_middle_nm ,
  TBP.formatted_provider_nm ,
  TBP.provider_nm_soundex ,
  TBP.lnm_soundex ,
  TBP.fnm_soundex ,
  TBP.pnm_soundex ,
  TBP.info_date_changed::date,
  TBP.reason_changed ,
  TBP.old_provider_id ::character varying,
  TBP.county_cd_tx ,
  TBP.agency ,
  (CASE WHEN PVA.toteamid is NULL THEN t1.county 
        ELSE (select distinct c.countyname from team t join county c on c.countyid::character varying = t.countyid::character varying where t.teamid = PVA.toteamid and c.statecountycode =v_county_cd)
        END )  as county, 
  PICG.programtype,tpai.is_cfe,tpai.iscfebedholdretainer,
  (select c.countyname::character varying from county c where c.statecountycode = tbp.county_cd limit 1) as jurisdiction
  FROM tb_provider as TBP
  LEFT JOIN LATERAL (
     (select c.countyname as county from tb_provider prov 
     left join county c on c.statecountycode=prov.county_cd
     where prov.provider_id=tbp.provider_id) 
   ) t1 ON ( 1=1 )
    left join providerinfoconfig PICG on PICG.providerid = TBP.provider_id and PICG.activeflag=1
    left join tb_provider_additional_info tpai on tpai.provider_id=tbp.provider_id and tpai.activeflag=1
  INNER JOIN TB_PROVIDER_PICKLIST tpp 
    ON tpp.provider_id = tbp.provider_id
  LEFT JOIN ProviderAssignment PVA ON PVA.objectid = TBP.provider_id::character varying and tpp.picklist_value_cd <> '3049'
  WHERE
     --pva.activeflag = 1
     --and
     CASE WHEN (v_providercategory='1783' or v_providercategory='1786' or v_providercategory='3049') THEN 
       TBP.affiliate_provider_id is  null
       ELSE
       TBP.affiliate_provider_id is not null
    END     
    AND CASE WHEN (v_affilitate_id IS NULL) OR  (v_affilitate_id = '') THEN 
       TRUE
       ELSE
       TBP.affiliate_provider_id::character varying  like '%' || v_affilitate_id ||'%'
    END 
     and TBP.delete_sw <> 'Y'
     and tpp.delete_sw <> 'Y'
    and (CASE WHEN v_providercategory IS NOT NULL THEN 
     (CASE WHEN v_providercategory='1783'THEN 
       ( tpp.PICKLIST_TYPE_ID=155 and (tpp.picklist_value_cd = '1783' or tpp.picklist_value_cd = '1785')) 
      else
       ( tpp.PICKLIST_TYPE_ID=155 and tpp.picklist_value_cd = v_providercategory) end)
     ELSE 
     (( tpp.PICKLIST_TYPE_ID=155 and tpp.picklist_value_cd = '3049')) END )
    and (case when v_provider_nm is not null then 
      (case when v_providercategory = '1783'  or v_providercategory = '1786' then 
       ( (tbp.provider_first_nm||' '||tbp.provider_last_nm) ilike v_provider_nm 
       or (tbp.provider_first_nm) ilike v_provider_nm
       or (tbp.provider_last_nm) ilike v_provider_nm
       or (tbp.provider_last_nm||', '||tbp.provider_first_nm) ilike v_provider_nm
       )
      else 
       tbp.provider_nm ilike v_provider_nm 
      end )
     else true end )
    AND (CASE WHEN v_provider_id IS NOT NULL THEN TBP.provider_id like '%' || v_provider_id ||'%' ELSE TRUE END)
    AND (CASE WHEN v_county_cd IS NOT NULL THEN 
       CASE WHEN PVA.toteamid is NULL THEN TBP.county_cd = v_county_cd  
        ELSE (PVA.toteamid in (select t.teamid from team t join county c on c.countyid::character varying = t.countyid::character varying where c.statecountycode =v_county_cd))
        END 
       ELSE TRUE END)
    AND (CASE WHEN v_program_type_cd IS NOT NULL then  (TBP.provider_id:: character varying) in
     (select tpa.provider_id from  tb_provider_applicant tpa
      where tpa.program_type = v_program_type_cd
     ) ELSE TRUE END)
    AND (CASE WHEN v_provider_status_cd IS NOT NULL THEN TBP.provider_status_cd  = v_provider_status_cd ELSE TRUE END)   
    AND (CASE WHEN v_program_nm IS NOT NULL THEN  (TBP.provider_id:: character varying) in
     (select tpa.provider_id from  tb_provider_applicant tpa
      where 
     tpa.program_name  ilike '%' ||  v_program_nm || '%'   
     )ELSE TRUE END)
   and (CASE WHEN (v_toworkeridno IS NOT NULL OR v_toworkeridno <> '') THEN (PVA.toworkeridno = v_toworkeridno AND (PVA.enddate > now() OR PVA.enddate is null)) ELSE TRUE END ) 
   AND (CASE WHEN ((v_toteamid IS NOT NULL OR v_toteamid <> '') and v_providercategory in ('1783', '1786')) THEN (PVA.toteamid::character varying = v_toteamid) ELSE TRUE END )
   
  ) a
  left join lateral (SELECT json_agg(x) as recon_data from(
   select distinct tbpa.next_recon_dt::date, tpv.value_tx as approvaltype, tpv1.value_tx as statuscd,DATE_PART('day', tbpa.next_recon_dt::timestamp -  now()::timestamp) ::integer as expire_days,
    case
    when (DATE_PART('day', tbpa.next_recon_dt::timestamp -  now()::timestamp ):: integer >=90) then 'green'
    when (DATE_PART('day', tbpa.next_recon_dt::timestamp -  now()::timestamp ):: integer <=0) then 'red'
    when (DATE_PART('day', tbpa.next_recon_dt::timestamp -  now()::timestamp ):: integer <90) then 'yellow'
    end as color_code,
    tbpa.next_recon_dt
    from tb_provider_approval tbpa 
    inner join tb_picklist_values tpv on trim(tpv.picklist_value_cd) = trim(tbpa.approval_type_cd) and tpv.picklist_type_id='367'
    inner join tb_picklist_values tpv1 on trim(tpv1.picklist_value_cd) = trim(tbpa.approval_status_cd) and tpv1.picklist_type_id='368'
    where tbpa.provider_id =a.provider_id and tbpa.active_sw='Y' and tbpa.approval_dt is not null
    order by tbpa.next_recon_dt::date desc) x 
   ) recon on (1=1)
  order by (
    CASE v_order_dir
     WHEN 'asc'
     THEN
                         CASE v_order_column
                            WHEN 'provider_id' THEN  cast(a.provider_id as character varying)
                          WHEN 'provider_nm' THEN       
        (case when  v_providercategory = '1783'  or v_providercategory = '1786'  then 
         a.provider_last_nm||', '||a.provider_first_nm
        else 
         a.provider_nm
        end )
                          WHEN 'county' THEN cast(a.county  as character varying)
                          --when 'recondate' then cast(a.next_recon_dt as date):: character varying
               ELSE
                      cast(a.provider_id as character varying)
               END
              END) ASC NULLS LAST,
                (CASE v_order_dir
                   WHEN 'desc'
     THEN
      CASE v_order_column
                            WHEN 'provider_id' THEN  cast(a.provider_id as character varying)
                          WHEN 'provider_nm' THEN 
        (case when  v_providercategory = '1783'  or v_providercategory = '1786'  then 
         lower(a.provider_last_nm||', '||a.provider_first_nm)
        else 
         lower(a.provider_nm)
        end )
                          WHEN 'county' THEN cast(a.county  as character varying)
                     --     when 'recondate' then cast(a.next_recon_dt as date):: character varying 
               ELSE
                      cast(a.provider_id as character varying)
               END
                   END) DESC NULLS LAST
 LIMIT pagesize OFFSET v_pageoffset;
  

 
END;
$function$

