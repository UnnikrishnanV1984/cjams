CREATE OR REPLACE FUNCTION getnextdanumber(application_name character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------------------------------
-- Revision(s):
-- Vineet Tirodkar - 05/10/2021 - Modifications to use the sequence objects for generating the next numbers  
--   APPs: 1-CW, 2-APS & 3-DJS    

--   New Logic for generating 12 digits the Seq Numbers 
--   Year(##) +  App(#) + Type (##) + sequence no (#######) 
--  21     +  0   + 00     + Next (7)
------------------------------------------------------------------------------------------------ 
DECLARE
 nextno  bigint;
 dano    varchar;
 vs_app character varying; 
 vs_seq_nm character varying;
 vs_type_cd character varying;
 
BEGIN
 IF lower(application_name) = lower('IntakeNumber')       -- 01
  or lower(application_name) = lower('ServiceRequestAuthorizationNumber') -- 02
  or lower(application_name) = lower('Servicecasenumber')     -- 03 
  or lower(application_name) = lower('Adoptioncasenumber')    -- 04
  or lower(application_name) = lower('GroupAuthorizationNumber')   -- 05
  or lower(application_name) = lower('Serviceplannumber') THEN   -- 06
  
  vs_app := 1 ; -- Child Welfare
  
  IF lower(application_name) = lower('IntakeNumber') THEN
   vs_seq_nm := 'intakenumber_seq';
   vs_type_cd := '01';
  ELSEIF lower(application_name) = lower('ServiceRequestAuthorizationNumber') THEN
   vs_seq_nm := 'servicerequestauthorizationnumber_seq';
   vs_type_cd := '02';
  ELSEIF lower(application_name) = lower('Servicecasenumber') THEN
   vs_seq_nm := 'servicecasenumber_seq';
   vs_type_cd := '03';
  ELSEIF lower(application_name) = lower('Adoptioncasenumber') THEN
   vs_seq_nm := 'servicecasenumber_seq';
   vs_type_cd := '04';
  ELSEIF lower(application_name) = lower('GroupAuthorizationNumber') THEN
   vs_seq_nm := 'groupauthorizationnumber_seq';
   vs_type_cd := '05';
  ELSE -- lower(application_name) = lower('Serviceplannumber') 
   vs_seq_nm := 'serviceplannumber_seq';
   vs_type_cd := '06';
  END IF;
  
  select nextval(vs_seq_nm::regclass) into nextno ;
 
  dano := concat(to_char(now(), 'YY'), vs_app, vs_type_cd, lpad(cast(nextno as varchar), 7, '0'));
  
  RETURN dano;
  
 ELSE

  SELECT next_number 
   into nextno 
  FROM nextnumber 
  WHERE lower(nextnumber.application)=lower(application_name) 
   AND nextnumber.fiscalyear = COALESCE(nextnumber.fiscalyear, 0);

  UPDATE nextnumber
   SET next_number=(next_number+1)
  WHERE lower(nextnumber.application) = lower(application_name) 
   AND nextnumber.fiscalyear = COALESCE(nextnumber.fiscalyear, 0);
   
   
  dano:= concat(cast(date_part ('year',now()) as varchar),'0', 
      case(length(cast(date_part ('doy',now()) as varchar))) when 1 then 
       concat('0',cast(date_part ('doy',now()) as varchar)) 
      else 
       cast(date_part ('doy',now()) as varchar) 
      end, '0');

  RETURN CONCAT( cast( dano  as varchar),CAST(nextno AS VARCHAR));
  
 END IF; 
END;
 
$function$

