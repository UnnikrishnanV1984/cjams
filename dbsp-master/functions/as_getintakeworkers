CREATE OR REPLACE FUNCTION as_getintakeworkers(v_countyid character varying, v_currentuserid character varying)
 RETURNS TABLE(userid character varying, teamname character varying, username character varying, email character varying, userrole text)
 LANGUAGE plpgsql
AS $function$

 DECLARE 
 l_countyid CHARACTER VARYING;
 
 BEGIN
 IF (v_countyid IS NULL) THEN 
  SELECT countyid INTO v_countyid FROM as_teammemberassignment tma 
  INNER JOIN teammember tm ON tm.teammemberid = tma.teammemberid AND tma.activeflag = 1 
  INNER JOIN team t ON t.teamid = tm.teamid AND tm.activeflag = 1 AND t.activeflag = 1 
  WHERE securityusersid = v_currentuserid ORDER BY tma.insertedon DESC LIMIT 1; 
 END IF;
 
 RETURN QUERY SELECT tma.securityusersid AS userid, t.teamname, up.fullname AS username, up.email, replace(r.description ,','||rm.teamtypekey,'') AS userrole 
   FROM muser mu  
   INNER JOIN userprofile up ON up.securityusersid = mu.securityusersid AND up.activeflag = 1 AND up.unavailableflag = FALSE 
   INNER JOIN as_teammemberassignment tma ON tma.securityusersid = up.securityusersid AND tma.activeflag = 1 
   INNER JOIN teammember tm ON tm.teammemberid = tma.teammemberid AND tm.activeflag = 1 
   INNER JOIN team t ON t.teamid = tm.teamid AND t.activeflag = 1 
   INNER JOIN rolemapping rm ON rm.principalid = mu.id AND rm.activeflag = 1 AND rm.teamtypekey = 'AS' 
   INNER JOIN role r ON rm.roleid = r.id AND r.activeflag = 1 AND r.roletypekey IN ('ASCW', 'ASIW') 
   WHERE t.countyid = v_countyid AND mu.activeflag = 1; 
 END;                                                                                                                                                                                                                                                                    

$function$

