CREATE OR REPLACE FUNCTION as_insertduplicateactivitytask(v_intakeserviceid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


  declare v_activitytasksclosed int;
   v_activitytasksopen int;
   v_activitytaskid uuid;
  v_taskdispositiontypekey character varying;
   begin
   
    /*Fetching Count Of Interim Rewiew Task  Closed */ 
    
   select  count(1) into v_activitytasksclosed  from activitytask at join activity a on a.activityid = at.activityid
   join investigation i on i.investigationid = a.objectid
   where at.name = 'Project Home Registered Nurse Consultant Assessment  Quarterly/Interim Review' and i.intakeserviceid = v_intakeserviceid
   and activitytaskstatustypekey = 'InvClosed';

  /*Fetching Count Of Interim Rewiew Task  Open */ 

   select  count(1) into v_activitytasksopen from activitytask at join activity a on a.activityid = at.activityid
   join investigation i on i.investigationid = a.objectid
   where at.name = 'Project Home Registered Nurse Consultant Assessment  Quarterly/Interim Review' and i.intakeserviceid = v_intakeserviceid
   and activitytaskstatustypekey = 'InvOpen';
   
  /*Fetching Last  Interim Rewiew Task Was Created in Activity Task ID */
  
   select  at.activitytaskid into v_activitytaskid from activitytask at join activity a on a.activityid = at.activityid
   join investigation i on i.investigationid = a.objectid
   where at.name = 'Project Home Registered Nurse Consultant Assessment  Quarterly/Interim Review' 
   and i.intakeserviceid = v_intakeserviceid order by at.updatedon desc  limit 1;
  
  /*Fetching Last  Interim Rewiew Task Was Created in Dispostion Key  */
  
  select  at.taskdispositiontypekey into v_taskdispositiontypekey  from activitytask at join activity a on a.activityid = at.activityid
   join investigation i on i.investigationid = a.objectid
   where at.name = 'Project Home Registered Nurse Consultant Assessment  Quarterly/Interim Review' 
   and i.intakeserviceid = v_intakeserviceid order by at.updatedon desc  limit 1;
   

    
        
  if(v_activitytasksclosed >0 and v_activitytasksopen=0 and v_taskdispositiontypekey='Continued') then               
    
  
   /* Created New Duplicate Interim Rewiew Task Was Created with Open Status */
  
     insert into activitytask (activityid,"name",description,amtaskid,assignedto,assignedon,activitytaskstatustypekey,
     activitytasktypekey,activityprioritytypekey,required,insertedby)
     
     select activityid,"name",description,amtaskid,assignedto,completeddate,'InvOpen',
     activitytasktypekey,activityprioritytypekey,required,insertedby
     from activitytask where activitytaskid=v_activitytaskid and activeflag=1 order by updatedon desc  limit 1;
     
  
  
   end if;

return 'success';
                          
end;


$function$

