CREATE OR REPLACE FUNCTION as_sp_address(vartabname character varying, varcolname character varying, varkey_id integer, varadr_type_cd character varying, tofrom character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE
DECLARE  t_ADDRESS_ID           INTEGER;   --
DECLARE  t_ADR_FORMAT_CD        character varying;--
DECLARE  t_EMP_SCHOOL_NM        character varying;--
DECLARE  t_ADR_STREET_NO        character varying;--
DECLARE  t_ADR_BOX_NO           character varying;--
DECLARE  t_ADR_PRE_DIR_CD       character varying;--
DECLARE  t_ADR_STREET_NM        character varying;--
DECLARE  t_ADR_STREET_SX_CD     character varying;--
DECLARE  t_ADR_POST_DIR_CD      character varying;--
DECLARE  t_ADR_UNIT_TYPE_CD     character varying;--
DECLARE  t_ADR_UNIT_NO_TX       character varying;--
DECLARE  t_ADR_CITY_NM          character varying;   --
DECLARE  t_ADR_COUNTY_CD        character varying;--
DECLARE  t_ADR_STATE_CD         character varying;   --
DECLARE  t_ADR_ZIP5_NO          character varying;   --
DECLARE  t_ADR_ZIP4_NO          character varying; --
DECLARE  t_ADR_DIRECTION_TX     character varying;    --
DECLARE  t_ADR_FOREIGN_TX       character varying;   --
DECLARE  t_ADR_FOREIGN_STTX     character varying;   --
DECLARE  t_ADR_COUNTRY_TX       character varying;   --
DECLARE  t_ADR_POSTAL_CD_TX     character varying;--
BEGIN

   RETURN (select as_sp_ad_format(cast(0 as int),
      a.t_ADR_FORMAT_CD,
      cast(' ' as varchar),
      a.t_ADR_STREET_NO,
      a.t_ADR_BOX_NO,
      a.t_ADR_PRE_DIR_CD,
      a.t_ADR_STREET_NM,
      a.t_ADR_STREET_SX_CD,
      a.t_ADR_POST_DIR_CD,
      a.t_ADR_UNIT_TYPE_CD,
      a.t_ADR_UNIT_NO_TX,
      a.t_ADR_CITY_NM,
      a.t_ADR_COUNTY_CD,
      a.t_ADR_STATE_CD,
      a.t_ADR_ZIP5_NO,
      a.t_ADR_ZIP4_NO,
      a.t_ADR_DIRECTION_TX,
      a.t_ADR_FOREIGN_TX,
      a.t_ADR_FOREIGN_STTX,
      a.t_ADR_COUNTRY_TX,
      a.t_ADR_POSTAL_CD_TX) from (
SELECT                 COALESCE(cast(ADr_FORMAT_CD as char) ,'') as t_ADR_FORMAT_CD,
              COALESCE(cast(ADR_STREET_TX as char) ,'') as t_ADR_STREET_NO,
              COALESCE(cast(ADR_BOX_NO as char)    ,'' ) as t_ADR_BOX_NO,
              COALESCE(F_PDESC(ADR_PRE_DIR_CD,69),'') as t_ADR_PRE_DIR_CD,
              COALESCE(ADR_STREET_NM,'') as t_ADR_STREET_NM,
              COALESCE(F_PDESC(ADR_STREET_SUFFIX_CD,212),'') as t_ADR_STREET_SX_CD,
              COALESCE(F_PDESC(ADR_POST_DIR_CD,69) ,'') as t_ADR_POST_DIR_CD,
              COALESCE(F_PDESC(ADR_UNIT_TYPE_CD,250),'') as t_ADR_UNIT_TYPE_CD,
              COALESCE(ADR_UNIT_NO_TX ,'') as t_ADR_UNIT_NO_TX,
              COALESCE(ADR_CITY_NM ,'') as t_ADR_CITY_NM,
              COALESCE(ADR_COUNTY_CD ,'') as t_ADR_COUNTY_CD,
              COALESCE(F_PDESC(ADR_STATE_CD,211) ,'') as t_ADR_STATE_CD,
              COALESCE(cast(cast(ADR_ZIP5_NO as integer)as char) ,'') as t_ADR_ZIP5_NO,
              COALESCE(cast(cast(ADR_ZIP4_NO as integer)as char) ,'') as t_ADR_ZIP4_NO,
           cast('' as char)  as t_ADR_DIRECTION_TX,
           COALESCE(ADR_FOREIGN_TX,'') AS t_ADR_FOREIGN_TX ,
           COALESCE(ADR_FOREIGN_STATE_TX,'') AS t_ADR_FOREIGN_STTX,
           COALESCE(ADR_COUNTRY_TX,'') AS t_ADR_COUNTRY_TX,
           COALESCE(ADR_POSTAL_CODE_TX,'') AS t_ADR_POSTAL_CD_TX
        from tb_payment_header   
       WHERE PAYMENT_ID = varkey_id
   AND DELETE_SW = 'N'      FETCH FIRST ROW ONLY) as a);

END;
$function$

