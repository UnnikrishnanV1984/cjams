CREATE OR REPLACE FUNCTION as_fn_petitiondate_upd()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN


 IF NEW.petitiondate::VARCHAR IS NOT NULL  THEN
 
 INSERT INTO  csesoutboundtrigger (   old_id,
                           transactionon,
                           transactiontypekey,
                           statusflag,
             activeflag)
             
     select  distinct  sc.servicecasenumber,
                        CURRENT_TIMESTAMP,
                         '44',
                         'N',
           1
         from   intakeservicerequestpetition isrp  , servicecase sc
     where   isrp.servicecaseid = sc.servicecaseid  and
                 isrp.servicecaseid = new.servicecaseid
        and isrp.activeflag=1 and sc.activeflag=1;
   
  end if;
 
 return new;

END;

$function$

