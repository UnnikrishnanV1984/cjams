CREATE OR REPLACE FUNCTION as_getequipmentlist(type_key character varying, manufactur character varying, model_name character varying, serial_number character varying, white_tagnumber character varying, yellow_tagnumber character varying, load_number character varying, organisationno character varying, found_b boolean, disposed_b boolean, upforrep_b boolean, size numeric, page numeric)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
DECLARE result json;
DECLARE totalcount integer;
BEGIN

      totalcount := 0;

      IF page = 1 THEN 
   
    

      
         SELECT  count (*)   into totalcount  FROM(

SELECT  tmeqp.teammemberequipmentid,tmeqp.EquipmentId,tm.teammemberid, eqp.equipmentTypeKey,eqp.manufacturer,eqp.model,eqp.serialnumber,eqp.whitetagNumber,
eqp.yellowtagNumber , tm.loadnumber,up.displayname
FROM Equipment AS  eqp join TeamMemberEquipment   AS tmeqp on eqp.EquipmentId = tmeqp.EquipmentId  AND tmeqp.activeflag = 1
 join   TeamMember AS tm on tm.teammemberid = tmeqp.teammemberid AND  tm.LoadNumber ILIKE  load_number||'%'   AND tm.activeflag = 1
left join     as_teammemberassignment AS tma on tma.teammemberid = tm.teammemberid AND tma.activeflag = 1
 left join securityusers AS  su on su.securityusersid = tma.securityusersid
 left join   UserProfile AS up on up.securityusersid = su.securityusersid  AND up.OrgNumber ILIKE  organisationno||'%' AND up.activeflag = 1
  left join team as t on t.teamid = tm.teamid AND t.activeflag = 1
 where eqp.equipmentTypeKey   ILIKE  type_key || '%' AND t.activeflag = 1
   
       AND  CASE WHEN manufactur is null THEN TRUE ELSE eqp.manufacturer ILIKE  manufactur || '%' END
       AND CASE WHEN model_name is  null THEN  TRUE ELSE eqp.model ILIKE  model_name ||'%'  END
       AND CASE WHEN serial_number is null THEN TRUE ELSE eqp.SerialNumber ILIKE  serial_number ||'%'  END
       AND CASE WHEN white_tagnumber is null THEN TRUE ELSE eqp.WhiteTagNumber ILIKE  white_tagnumber ||'%'   END
       AND CASE WHEN yellow_tagnumber is null THEN TRUE ELSE eqp.YellowTagNumber ILIKE yellow_tagnumber  ||'%'  END
       AND CASE WHEN found_b is null THEN TRUE ELSE eqp.Found = found_b  END
       AND CASE WHEN disposed_b is null THEN TRUE ELSE eqp.Disposed = disposed_b  END
             AND CASE WHEN upforrep_b is null THEN TRUE ELSE eqp.UpForReplacement = upforrep_b  END
              GROUP BY tmeqp.teammemberequipmentid,tmeqp.EquipmentId,tm.teammemberid, eqp.equipmentTypeKey,eqp.manufacturer,eqp.model,eqp.serialnumber,eqp.whitetagNumber,
eqp.yellowtagNumber , tm.loadnumber,up.displayname
               ORDER BY eqp.equipmentTypeKey 
 )e;

       END IF;
     
      SELECT array_to_json(array_agg(e)) FROM
      (SELECT array_to_json(array_agg(row_to_json(d))) as "data", totalcount as  "count" from ((
SELECT   tmeqp.teammemberequipmentid,tmeqp.EquipmentId,tm.teammemberid, eqp.equipmentTypeKey,eqp.manufacturer,eqp.model,eqp.serialnumber,eqp.whitetagNumber,
eqp.yellowtagNumber , tm.loadnumber,up.displayname
FROM Equipment AS  eqp join TeamMemberEquipment   AS tmeqp on eqp.EquipmentId = tmeqp.EquipmentId  AND tmeqp.activeflag = 1
 join   TeamMember AS tm on tm.teammemberid = tmeqp.teammemberid AND  tm.LoadNumber ILIKE  load_number||'%'   AND tm.activeflag = 1
left join     as_teammemberassignment AS tma on tma.teammemberid = tm.teammemberid AND tma.activeflag = 1
 left join securityusers AS  su on su.securityusersid = tma.securityusersid
 left join   UserProfile AS up on up.securityusersid = su.securityusersid  AND up.OrgNumber LIKE  organisationno||'%' AND up.activeflag = 1
  left join team as t on t.teamid = tm.teamid AND t.activeflag = 1
 where eqp.equipmentTypeKey  LIKE type_key || '%' AND eqp.activeflag = 1
      AND  CASE WHEN manufactur is null THEN TRUE ELSE eqp.manufacturer ILIKE  manufactur || '%' END
       AND CASE WHEN model_name is  null THEN  TRUE ELSE eqp.model ILIKE  model_name ||'%'  END
       AND CASE WHEN serial_number is null THEN TRUE ELSE eqp.SerialNumber ILIKE  serial_number ||'%'  END
       AND CASE WHEN white_tagnumber is null THEN TRUE ELSE eqp.WhiteTagNumber ILIKE  white_tagnumber ||'%'   END
       AND CASE WHEN yellow_tagnumber is null THEN TRUE ELSE eqp.YellowTagNumber ILIKE yellow_tagnumber  ||'%'  END
       AND CASE WHEN found_b is null THEN TRUE ELSE eqp.Found = found_b  END
       AND CASE WHEN disposed_b is null THEN TRUE ELSE eqp.Disposed = disposed_b  END
             AND CASE WHEN upforrep_b is null THEN TRUE ELSE eqp.UpForReplacement = upforrep_b  END
              GROUP BY tmeqp.teammemberequipmentid,tmeqp.EquipmentId,tm.teammemberid, eqp.equipmentTypeKey,eqp.manufacturer,eqp.model,eqp.serialnumber,eqp.whitetagNumber,
eqp.yellowtagNumber , tm.loadnumber,up.displayname
             ORDER BY  eqp.equipmentTypeKey 
 )LIMIT size OFFSET  (page - 1) * size )d)e INTO result;
         
RETURN COALESCE(result,'[]');

END; $function$

