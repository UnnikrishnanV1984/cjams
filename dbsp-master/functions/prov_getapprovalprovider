CREATE OR REPLACE FUNCTION prov_getapprovalprovider(v_providerid character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(totalcount bigint, approvaltype character varying, statustype character varying, providerapprovalid uuid, approvaldesc character varying, approvaldate character varying, approved_beds_no integer, approvalcomments text, nextrecondate character varying, active_sw character varying)
 LANGUAGE plpgsql
AS $function$
 
DECLARE
 v_pageoffset int;
    v_pagenumber int;
   v_applicantid character varying; 
 
BEGIN

 v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
   
--   select applicantid  into v_applicantid from providerapprovetypeconfig where providerid=v_providerid;
--raise notice 'v_providerid%',v_providerid;
--if (v_applicantid is null) then 
--select applicant_id into v_applicantid from providerapprovalphaserecord where provider_id=v_providerid  and active_flag=1;--program type change request table
--end if;
return query 
 select count(1) over() as totalcount,tpv.value_tx as approvaltype,tpv1.value_tx as statustype,tpa.providerapprovalid ,tpa.approval_comments_tx as approvaldesc,tpa.approval_dt::character varying as approvaldate,tpa.approved_beds_no,
 ''::text as approvalcomments,tpa.next_recon_dt::character varying,tpa.active_sw ::character varying
 from tb_provider_approval tpa
  left join tb_picklist_values tpv on trim(tpv.picklist_value_cd) = trim(tpa.approval_type_cd) and tpv.picklist_type_id='367'
  left join tb_picklist_values tpv1 on trim(tpv1.picklist_value_cd) = trim(tpa.approval_status_cd) and tpv1.picklist_type_id='368'
 -- left outer join tb_public_provider_applicant tppp on tppp.applicant_id=v_applicantid
  where tpa.provider_id=v_providerid::bigint and tpa.delete_sw='N' and tpa.approval_dt is not null
order by approvaldate desc, tpa.create_ts desc
  LIMIT pagesize OFFSET v_pageoffset;
END;
$function$

