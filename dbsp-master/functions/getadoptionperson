  -- @Simar Data migration from chessie a person can have multiple 'roles' in an adoption case\r
  -- adding this check for restricting the join to be on only thse 2 roles as CJAMS can only have one actor entry\r
  -- We have a sub-query that will retrieve all the other roles of these actors\r
  AND actortypekey IN ('CHILD', 'ADOPTIVEPARENT', 'PVTADPCHILD') \r
  ) as iar ON iar.adoptioncaseid =irs.adoptioncaseid AND irs.activeflag =1   \r
 LEFT JOIN person as p on\r
  p.personid = iar.personid\r
  and p.activeflag = 1\r
 left JOIN (\r
  select\r
   paa.personid,\r
   (max(paa.personaddressid::character varying))::uuid personaddressid\r
  from\r
   personaddress as paa\r
  where\r
   --paa.personaddresstypekey='C' AND \r
 paa.activeflag = 1\r
 and paa.currentlocationflag = 1\r
  group by\r
   paa.personid ) pa1 on\r
  pa1.personid = p.personid\r
 \r
 left JOIN personaddress as pa on\r
  pa.activeflag = 1\r
  and pa.personaddressid = pa1.personaddressid\r
  --pa.personaddresstypekey='C' AND \r
 left JOIN personphysicalattribute as ppa on\r
  ppa.personid = P.personid\r
  and ppa.physicalattributetypekey = 'Ht'\r
  and ppa.activeflag = 1\r
 left JOIN personphysicalattribute as ppat on\r
  ppat.personid = P.personid\r
  and ppat.physicalattributetypekey = 'Wt'\r
  and ppat.activeflag = 1\r
 left JOIN ethnicgrouptype egt on\r
  egt.ethnicgrouptypekey = p.ethnicgrouptypekey\r
  and egt.activeflag = 1\r
 LEFT JOIN gendertype grt on grt.gendertypekey = p.gendertypekey and grt.activeflag=1\r
 left JOIN religiontype RT on\r
  rt.religiontypekey = p.religiontypekey\r
  and rt.activeflag = 1\r
 left JOIN racetype RAT on\r
  RAT.racetypekey = P.racetypekey\r
  and RAT.activeflag = 1\r
  \r
 left JOIN maritalstatustype MT on\r
  MT.maritalstatustypekey = p.maritalstatustypekey\r
  and MT.activeflag = 1\r
 where\r
  ( iar.adoptioncaseid = v_adoptiocaseid \r
    and iar.activeflag = 1\r
  ) \r
 group by\r
  iar.actortypekey,\r
  irs.adoptioncaseid,\r
  p.personid,\r
  iar.adoptioncaseactorid,\r
  pa.address,\r
  pa.address2,\r
  pa.state,\r
  pa.city,\r
  pa.zipcode,\r
  pa.county,\r
  ppa.attributevalue,\r
  ppat.attributevalue,\r
  egt.typedescription ,\r
  rt.typedescription,\r
  rat.typedescription,\r
  grt.typedescription, \r
  MT.typedescription \r
 )as "Person"\r
limit _limit offset _offset;\r
end;\r
