CREATE OR REPLACE FUNCTION as_f_sname_news(ai_staff_id bigint)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
 VS_STAFF_NM     VARCHAR;

BEGIN
 
 VS_STAFF_NM = (SELECT 
      coalesce(firstname || ' ','') ||
      coalesce(middlename || ' ','') ||
      coalesce(lastname || ' ','')
          FROM userprofile  
          WHERE cjamspid = ai_staff_id 
           AND activeflag = 1);
          
 RETURN VS_STAFF_NM; 

END;

$function$

