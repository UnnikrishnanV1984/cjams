CREATE OR REPLACE FUNCTION f_fiscal_cat_desc(as_fiscal_cat_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN

SELECT FISCAL_CATEGORY_DESC || ' (' || FISCAL_CATEGORY_CD || ')' 
FROM TB_FISCAL_CATEGORY_MASTER 
WHERE FISCAL_CATEGORY_CD = as_fiscal_cat_cd AND DELETE_SW = 'N' 
;

END

$function$

