CREATE OR REPLACE FUNCTION prov_getdocumenthistory(pagenumber bigint, pagesize bigint, v_documenttemplatekey character varying, v_roletypekey character varying, v_intakeserviceid character varying, v_intakenumber character varying DEFAULT NULL::character varying, v_persontypekey character varying DEFAULT NULL::character varying)
 RETURNS TABLE(totalcount bigint, title character varying, headertemplatehtml character varying, isheaderrequired boolean, originalfilename character varying, documentpropertiesid uuid, repositoryid character varying, youthbasedocument boolean, documenttemplatekey character varying, "generatedBy" character varying, "generatedDateTime" timestamp without time zone, documentpath character varying, beforesubmit boolean)
 LANGUAGE plpgsql
AS $function$

DECLARE 
v_versionnumber bigint;
v_resintakenumber character varying;
v_pageoffset int;
v_pagenumber int;

BEGIN 

v_pagenumber := pagenumber-1;
v_pageoffset = v_pagenumber * pagesize;

--SELECT max(dp.versionno) INTO v_versionnumber
-- FROM  documentproperties dp  
--WHERE  dp.activeflag =1   
--AND dp.documenttemplatekey = v_documenttemplatekey
--AND (dp.intakenumber = v_intakenumber) OR( dp.intakeserviceid = v_intakeserviceid);

--SELECT isr.intakenumber INTO v_resintakenumber
--FROM intakeserreqrestitution isr 
--WHERE isr.activeflag=1 AND isr.restitutionno = v_restitutionno;

RETURN query
SELECT  
    count(1) over(),
  dt.documentname,
 dt.headertemplatehtml,
 dt.isheaderrequired,
 dp.originalfilename,
 dp.documentpropertiesid,
 dp.repositoryid, 
 false youthbasedocument,
 dp.documenttemplatekey,
 (SELECT UP.fullname
 FROM
 userprofile UP 
 WHERE UP.securityusersid = dp.insertedby
 and UP.activeflag = 1 limit 1),
 dp.insertedon as generatedate,
 dp.s3bucketpathname,false
 --dtrc.beforesubmit
from documentproperties dp  
left join documenttemplate   dt on dt.documenttemplatekey= dp.documenttemplatekey and dt.activeflag =1 
--inner join documenttemplateroletypeconfig  dtrc on dtrc.documenttemplatekey = dt.documenttemplatekey and dtrc.activeflag = 1 
--inner join intakedocclassification idc on idc.documenttemplatekey = dt.documenttemplatekey and idc.activeflag=1
where dp.activeflag =1 
--and  dtrc.roletypekey =v_roletypekey --and idc.roletype_key = v_roletypekey  
and case when  v_intakenumber is not null then 
     dp.intakenumber = v_intakenumber
  -- when v_intakeserviceid is not null then
   --  dp.intakeserviceid = v_intakeserviceid
       end
--and dt.versionno < v_versionnumber
and dp.documenttemplatekey = v_documenttemplatekey
--and (case when v_persontypekey is not null then dt.persontypekey = v_persontypekey else true end) 
; 
END;
$function$

