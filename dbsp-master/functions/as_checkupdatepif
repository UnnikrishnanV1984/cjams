CREATE OR REPLACE FUNCTION as_checkupdatepif(v_receivable_detail_id integer)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_fiscal_category_cd character;
    
 
BEGIN 
 

 update tb_receivable_detail set  receivable_status_cd= '20' where receivable_detail_id = v_receivable_detail_id
 and (select coalesce(receivable_balance_no,0) ::integer from tb_receivable_detail trd where trd.receivable_detail_id = v_receivable_detail_id) = 0 ;


return 'Success';

END;

$function$

