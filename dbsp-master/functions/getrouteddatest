    INNER JOIN intakeservicerequest as ISR ON ISR.intakeserviceid =  ISGD.intakeserviceid AND ISR.activeflag =1
    INNER JOIN (SELECT DISTINCT objectid,tosecurityusersid,cast(r.insertedon as timestamp) assignedon  FROM ROUTING R 
        WHERE R.tosecurityusersid = userid AND routingstatustypeid =9 AND R.activeflag =1
       ) R ON r.objectid =  cast(ISR.intakeserviceid  as character varying)   
