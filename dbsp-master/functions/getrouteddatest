    INNER JOIN intakedastatus as IDAS  ON IDAS.intakenumber=ISR.intakenumber and IDAS.activeflag=1 and  (IDAS.clwstatus is null or IDAS.clwstatus in(4,6))
    WHERE  ISG.GROUPNUMBER  LIKE servicereqno ||'%'    AND coalesce(ISR.isrouted,false) =false  
