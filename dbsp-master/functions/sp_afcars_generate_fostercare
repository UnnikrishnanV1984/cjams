     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'DAP') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'AAC') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'DAC') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'CD') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'CBP') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'DP') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'IP') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'CIIO') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'ADT') > 0 then '1'  else '0' end,
     case  when COUNT(*) FILTER (WHERE icr.removalreasontypekey = 'RLQ') > 0 then '1'  else '0' end,
