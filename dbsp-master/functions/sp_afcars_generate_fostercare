       and pl.placementtypekey = 'LA' 
       and la.activeflag = 1
       and la.livingarrangementtypekey IN ('MH','SJD','PSYH','IPC','IMCNA','REC',
              'Inpatient Medical Care - Non-Acute','Inpatient Psychiatric Care')
      ORDER BY pl.startdatetime LIMIT 1),NULL) INTO VS_END_DATE ; 
    
     RAISE NOTICE 'VS_END_DATE %', VS_END_DATE;
   
     IF (VS_END_DATE IS NOT NULL) THEN
      VS_LATEST_REMOVAL_DT2 := NULL;
      VS_REMOVAL_TRANSACTION_DT1 := NULL;
      
      SELECT pl.startdatetime, coalesce(pl.insertedon, pl.startdatetime)
       INTO VS_LATEST_REMOVAL_DT2, VS_REMOVAL_TRANSACTION_DT1
