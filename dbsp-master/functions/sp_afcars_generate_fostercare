   -- 51 year of birth  -- 54 .Race of 1st Foster Caretaker, -- 55 .Hispanic or Latino Ethnicity of 1st Foster Caretaker  ENDs here 


   -- 56 Date of Discharge FROM Foster Care , 57 - Foster Care Discharge Transaction Date , 58 - Reason for discharge , 59 - TITLE IV-E (ELIGIBILITY) -- starts here 
   BEGIN

    RAISE NOTICE 'Element #56 %', timeofday();
    OUT_IV_E_FOSTERCARE_SW = '0';
   
    -- a. If the child’s age is 18-21 years and is IV-E Eligible, then include the client in the AFCARS report with the actual foster care discharge date from the Removal Screen..
    -- b. If the child’s age is 18-21 years and NOT IV-E Eligible, then include the client in the AFCARS report with a Discharge Date equal to the start date of when the client became NOT IV-E eligible. 
    --  If the start date of the last NOT IV-E eligible period is prior to the start of the AFCARS reporting period, then the discharge date will be set to the start of the AFCARS reporting period. 

    SELECT 
     -- (DATE_PART('year', vdt_to::date) - DATE_PART('year', dob::date))::integer as age,
     f_age(dob::date, vdt_to::date)::integer as age,
     (dob + interval '18 year')::date
    INTO VS_AGE, VS_BDAY_18
     FROM PERSON 
    WHERE cjamspid = OUT_CLIENT_ID 
     AND activeflag = 1;
   
    RAISE NOTICE 'VS_AGE %', VS_AGE;
   
    SELECT
     tep.status_cd,
     tep.start_dt::date,
     COALESCE(tce.create_ts::date,tep.start_dt::date),
     tep.end_dt::date
    INTO 
     VS_IVE_STATUS,
     VS_TEP_STRT_DT,
     VS_TEP_TRANS_DT,
     VS_TEP_END_DATE
    FROM  tb_client_eligibility tce 
     JOIN tb_eligibility_period tep ON tep.eligibility_id = tce.eligibility_id 
      AND tep.delete_sw = 'N'
    WHERE eligibility_type_cd = '2931' 
     AND tce.client_id  = OUT_CLIENT_ID 
     AND tce.case_id = VS_CASE_ID
     AND tce.delete_sw = 'N'
    ORDER BY tep.sqnm_sw desc, tep.create_ts desc 
    LIMIT 1;
 
    OUT_DISCHARGE_DT = NULL;
    OUT_DISCHARGE_TRANSACTION_DT = NULL;
    OUT_DISCHARGE_REASON_CD = '';
 
    SELECT  icr.exitdate
     INTO  OUT_DISCHARGE_DT 
    FROM intakeservreqchildremoval icr 
     join routing rur on rur.objectid = icr.intakeservreqchildremovalid::character varying
      and rur.eventcode = 'CHRR'
      and rur.activeflag = 1
      and rur.routingstatustypeid = '16'
    WHERE icr.personid = ( select personid from person where  cjamspid = OUT_CLIENT_ID )
     -- and ((icr.exitdate <> icr.removaldate) or icr.exitdate is null )
     and icr.activeflag = 1
    order by icr.removaldate desc limit 1; 
    
    -- RAISE NOTICE 'OUT_DISCHARGE_DT 1 %', OUT_DISCHARGE_DT;
    
    If OUT_DISCHARGE_DT is not null then 
      
     SELECT   
      CASE WHEN (icr.returntransts IS NOT NULL AND icr.returntransts::date != '1900-01-01'::date) THEN  (icr.returntransts::date)::character varying ELSE (icr.insertedon::date)::character varying END as  returntransts, 
       case  
        when icr.removalexitreason in ( 'ADP', 'ADPDIS','ADPFIN', 'ADPL', 'AF') then '3' 
        when icr.removalexitreason in  ('CNR','OTHER-REL', 'OTR','CGR', 'CGUARDREL' ) then '2'  
        when icr.removalexitreason in ('EMANMAR','EMANIND', 'EMI', 'EMANMIL', 'MILY', 'MRG')  then '4'
        when icr.removalexitreason in ('CUSNONR','CGNR', 'CGUARDNR', 'GNR', 'GNONREL' ) then'5' 
        when icr.removalexitreason in ('TON','TTONDA') then '6' 
        when icr.removalexitreason in ('RNAWAY', 'RNWY' )then '7' 
        when icr.removalexitreason in ( 'DOC' , 'DEATHOC') then '8'
        when icr.removalexitreason in ( 'CORHA' , 'CORHADR', 'RUF', 'REUNIF', 'CHREUNIFWF') then '1'
        when icr.removalexitreason in ( 'OTR' , 'RFS') then '8'
        else '0'
      end  
     INTO OUT_DISCHARGE_TRANSACTION_DT,
      OUT_DISCHARGE_REASON_CD
     FROM intakeservreqchildremoval icr 
      join routing rur on rur.objectid = icr.intakeservreqchildremovalid::character varying
       and rur.eventcode = 'CHRR'
       and rur.activeflag = 1
       and rur.routingstatustypeid = '16'
     WHERE  icr.personid = ( select personid from person where  cjamspid = OUT_CLIENT_ID )
      and icr.activeflag = 1
      -- and ((icr.exitdate <> icr.removaldate) or icr.exitdate is null )
     order by icr.removaldate desc limit 1; 
    else 
    
     OUT_DISCHARGE_TRANSACTION_DT:='';--
     OUT_DISCHARGE_REASON_CD:='';--
    
    end if;--
  
    IF(VS_AGE >= 18 AND VS_AGE <= 21) THEN
     IF (VS_IVE_STATUS != '2913') THEN
      SELECT CASE WHEN (VS_TEP_STRT_DT IS NOT NULL AND VS_TEP_STRT_DT::DATE < vdt_from::DATE) THEN vdt_from::character varying ELSE (VS_TEP_STRT_DT::DATE)::character varying END,
          CASE WHEN (VS_TEP_STRT_DT IS NOT NULL AND VS_TEP_STRT_DT::DATE < vdt_from::DATE) THEN vdt_from::character varying ELSE (VS_TEP_TRANS_DT::DATE)::character varying END
      INTO OUT_DISCHARGE_DT, OUT_DISCHARGE_TRANSACTION_DT;
       OUT_DISCHARGE_REASON_CD = '4';
         
      -- RAISE NOTICE 'OUT_DISCHARGE_DT 2 %', OUT_DISCHARGE_DT;   
     ELSE
      VS_FLAG := 0;
      SELECT CASE WHEN (VS_TEP_END_DATE IS NOT NULL AND VS_TEP_END_DATE::DATE <= VS_BDAY_18::DATE) THEN 
       1 ELSE 0 END
      INTO VS_FLAG;
      
      IF VS_FLAG = 1 THEN 
       OUT_DISCHARGE_DT := vdt_from;
       OUT_DISCHARGE_REASON_CD = '4';
       OUT_DISCHARGE_TRANSACTION_DT := vdt_from;
      END IF; 
      
      -- RAISE NOTICE 'OUT_DISCHARGE_DT 3 %', OUT_DISCHARGE_DT;
     END IF;
    END IF;
      
    if OUT_DISCHARGE_REASON_CD is null then 
     OUT_DISCHARGE_REASON_CD:='0';--
    end if ;--
 
    IF (VS_IVE_STATUS = '2913') THEN
     OUT_IV_E_FOSTERCARE_SW = '1';
    ELSE
     OUT_IV_E_FOSTERCARE_SW = '0';
    END IF;
    
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ; 
    
   END;
 
   ----- *************  ELEMENT #5  ***********---------------
 
   BEGIN
 
    RAISE NOTICE 'Element #05 %', timeofday();
 
    OUT_PERIODIC_REVIEW_DT = NULL;
 
    -- RAISE NOTICE 'OUT_DISCHARGE_DT %', OUT_DISCHARGE_DT;
    
    SELECT CASE WHEN OUT_DISCHARGE_DT IS NULL THEN VDT_TO::CHARACTER VARYING
     WHEN OUT_DISCHARGE_DT::DATE < VDT_TO::DATE THEN OUT_DISCHARGE_DT::CHARACTER VARYING 
     ELSE VDT_TO::CHARACTER VARYING 
     END
     -- ((VDT_TO::DATE - interval '7 month')::DATE)::CHARACTER VARYING
    INTO VS_PERIOD_END_DT;  
  
    SELECT MAX(h.hearingdatetime) INTO OUT_PERIODIC_REVIEW_DT
