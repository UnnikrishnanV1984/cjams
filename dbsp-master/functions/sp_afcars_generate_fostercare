      AND pl.providerid is not null 
      AND pl.altproviderid is not null
      AND pl.placementtypekey = 'PRPL' 
      and pl.activeflag = 1
      AND pl.startdatetime::date >= VS_TPC_EXIT_DATE::date; 
      
     RAISE NOTICE 'VS_COUNT1 %', VS_COUNT1;
