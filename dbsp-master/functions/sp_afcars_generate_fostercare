        else ' ' 
       end as hisp 
     INTO OUT_FOSTERCARE2_BIRTH_YEAR,
      OUT_FOSTERCARE2_RACE_AI_CD,  
      OUT_FOSTERCARE2_RACE_ASIAN_CD,  
      OUT_FOSTERCARE2_RACE_BLACK_CD, 
      OUT_FOSTERCARE2_RACE_HAWAIIAN_CD, 
      OUT_FOSTERCARE2_RACE_WHITE_CD, 
      OUT_FOSTERCARE2_RACE_UN_CD,
      OUT_FOSTERCARE2_HISPANIC_CD
     FROM TB_PROV_CPA_ADOP_PERSON 
     WHERE PROVIDER_ID = VS_CPA_PRVDR_ID
      AND DELETE_SW = 'N' 
      AND TRUNC(PERSON_TYPE_CD) = '3611'
     ORDER BY provider_cpa_adop_person_id DESC LIMIT 1;
    
    ELSE
 
     VS_APPROVAL_PERSONID = NULL;
     VS_ALT_PROVIDERID = NULL;
 
     SELECT pl.altproviderid INTO VS_ALT_PROVIDERID
     from placement pl
      JOIN person p ON p.personid = pl.personid 
     WHERE cjamspid = OUT_CLIENT_ID
      AND pl.startdatetime <= vdt_to::DATE 
      AND pl.providerid is not null 
      AND pl.altproviderid is not null
      and pl.activeflag = 1
     order by startdatetime desc
     LIMIT 1;
 
     SELECT pap.approval_person_id, pap.family_structure_cd  
       into  VS_APPROVAL_PERSONID, VS_FAMILY_STRUCTURE 
     FROM tb_prov_approval_person  pap
      JOIN tb_provider_approval pa ON pap.provider_approval_id = pa.provider_approval_id
     WHERE pa.provider_id = VS_ALT_PROVIDERID
      AND approval_dt::date <= vdt_to::DATE  
      AND pap.person_type_cd in ('3611')
      and pap.delete_sw = 'N'
     ORDER BY  pa.entry_dt desc limit 1;
 
 
     RAISE NOTICE 'VS_APPROVAL_PERSONID 2 %', VS_APPROVAL_PERSONID ;
  
     IF (VS_APPROVAL_PERSONID IS NOT NULL) THEN    
      select  DATE_PART('year', dob_dt::date)::varchar as dob , 
       -- case when primary_race_cd = '1803' then '1' else '0' end as indian,
       case when primary_race_cd != '' AND primary_race_cd in ('1802','1803') then '1' else '0' end as indian, 
       case when primary_race_cd != '' AND primary_race_cd = '6310' then '1' else '0' end as asian, 
       case when primary_race_cd != '' AND primary_race_cd = '1801' then '1' else '0' end as black, 
       case when primary_race_cd != '' AND primary_race_cd = '6311' then '1' else '0' end as island, 
       case when primary_race_cd != '' AND primary_race_cd = '1806' then '1' else '0' end as white,
       case when primary_race_cd != '' AND primary_race_cd in ('6312','6314') then '1' else '0' end as undetermine,
       case when hispanic_cd = 'Y' then '1' 
        when hispanic_cd = 'N' then '2' 
        when hispanic_cd = 'U' then '3'
        else ' ' 
        end as hisp
      INTO   OUT_FOSTERCARE2_BIRTH_YEAR,
       OUT_FOSTERCARE2_RACE_AI_CD,  
       OUT_FOSTERCARE2_RACE_ASIAN_CD,  
       OUT_FOSTERCARE2_RACE_BLACK_CD, 
       OUT_FOSTERCARE2_RACE_HAWAIIAN_CD, 
       OUT_FOSTERCARE2_RACE_WHITE_CD, 
       OUT_FOSTERCARE2_RACE_UN_CD,
       OUT_FOSTERCARE2_HISPANIC_CD
      FROM tb_prov_approval_person
      WHERE approval_person_id = VS_APPROVAL_PERSONID
       and delete_sw = 'N';--
    
     END IF;
    END IF; 
  
   
    If  OUT_PLACEMENT_SETTING_CD NOT IN ('1','2','3') then 
 
     OUT_FOSTERCARE2_RACE_AI_CD := '0';--
     OUT_FOSTERCARE2_RACE_ASIAN_CD := '0';--
     OUT_FOSTERCARE2_RACE_BLACK_CD := '0';--
     OUT_FOSTERCARE2_RACE_WHITE_CD := '0' ;--
     OUT_FOSTERCARE2_RACE_HAWAIIAN_CD := '0';--     
