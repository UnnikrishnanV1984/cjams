      VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
      VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
      VS_ERR_EXCEP_FLAG := 1;
      VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;           
          
   END; 


   --*******ELEMENT #NO # 26 to 40  *******  --NO #26 to 40 ends here 

    
   --*******ELEMENT #NO # 41 ,42*******  --NO #41 ,42Number of Previous Placement Settings During This Removal Episode? starts here   


   BEGIN 
 
    RAISE NOTICE 'Element #41, #42 %', timeofday();
    -- get latest placement LA / PRPL 
    VS_PLACEMENT_KEY = NULL;
    VS_ALTPROVIDERID2 = NULL;
    VS_PLACEMENT_ID2 = NULL;
    VS_PRVDR_ID = NULL;
    VS_END_DATE_TIME = NULL;
 
    Select  pl.placementtypekey, pl.placementid, pl.altproviderid, pl.providerid::character varying, pl.enddatetime
    into  VS_PLACEMENT_KEY, VS_PLACEMENT_ID2, VS_ALTPROVIDERID2, VS_PRVDR_ID, VS_END_DATE_TIME
    from  placement pl
     -- left join livingarrangement lv on lv.placementid = pl.placementid and livingarrangementtypekey != 'Placement'
    where  pl.personid = ( Select personid from person where cjamspid = OUT_CLIENT_ID )
      and pl.startdatetime <= vdt_to::date 
      and pl.activeflag = 1 
      and (pl.isvoided IS NULL OR pl.isvoided != 1)
      and (case when pl.placementtypekey = 'LA' then 
        (select count(*) from livingarrangement l1 
         where l1.placementid = pl.placementid 
          and l1.livingarrangementtypekey NOT IN ('Adoption', 'ADPN', 'Placement'))::integer > 0 
       else 
        true 
       end)
    order by pl.enddatetime desc nulls first, pl.startdatetime desc limit 1;--
 
    IF (VS_PLACEMENT_ID2 IS NOT NULL AND VS_END_DATE_TIME IS NOT NULL AND VS_PLACEMENT_KEY = 'LA') THEN
     
     VS_ALTPROVIDERID1 = NULL;
     VS_PLACEMENT_ID = NULL;
      
     Select   pl.placementid, pl.altproviderid
     into  VS_PLACEMENT_ID, VS_ALTPROVIDERID1
      from  placement pl
       where  pl.personid = (Select personid from person where cjamspid = OUT_CLIENT_ID)
       and pl.startdatetime <= vdt_to::date  + interval '30 day' 
       AND pl.startdatetime::DATE = VS_END_DATE_TIME::DATE
       AND pl.placementtypekey = 'PRPL' 
       and pl.activeflag = 1 
       and (pl.isvoided IS NULL OR pl.isvoided != 1)
      order by pl.enddatetime desc nulls first, pl.startdatetime desc limit 1 ;
      
     IF (VS_PLACEMENT_ID IS NOT NULL) THEN
       VS_PLACEMENT_KEY = 'PRPL';
       VS_ALTPROVIDERID2 = VS_ALTPROVIDERID1;
       VS_PLACEMENT_ID2 = VS_PLACEMENT_ID;
     END IF;
   
    END IF;
 
    If  VS_PLACEMENT_KEY = 'PRPL' then 
     IF (VS_ALTPROVIDERID2 IS NOT NULL) THEN 
      SELECT  CASE WHEN TBPA1.adr_state_cd = 'MD' THEN '2' 
         WHEN TBPA1.adr_state_cd != 'MD' AND TBPA1.adr_state_cd IS NOT NULL THEN '1' 
         ELSE '2' 
        END 
       INTO OUT_PLACEMENT_STATE
       FROM tb_provider as p
        INNER JOIN tb_provider_addresses TBPA1  ON TBPA1.parent_key_id = p.provider_id::character varying 
         AND TBPA1.delete_sw = 'N' 
        WHERE p.provider_id = VS_ALTPROVIDERID2 
         AND p.delete_sw = 'N' 
         AND TBPA1.adr_end_dt IS NULL 
         AND TBPA1.adr_default_sw='Y' 
         AND TBPA1.adr_type_cd='3357'
       LIMIT 1;
     END IF;    

     SELECT ar.afcarsvaluetypekey
     INTO  OUT_PLACEMENT_SETTING_CD 
     FROM  placement P
       Inner join afcarsreference ar on ar.statepicklistvaluetypekey = p.service_id::varchar
     WHERE p.placementid::varchar = VS_PLACEMENT_ID2
      and p.activeflag = 1;

    
    elsif  VS_PLACEMENT_KEY = 'LA' then 
  
     SELECT ar.afcarsvaluetypekey,
       CASE  WHEN la.statetypekey = 'MD' THEN '2' 
         WHEN la.statetypekey != 'MD' AND la.statetypekey IS NOT NULL THEN '1' 
         ELSE '' 
       END 
     INTO  OUT_PLACEMENT_SETTING_CD,OUT_PLACEMENT_STATE
     FROM  placement P
       INNER JOIN livingarrangement LA ON la.placementid = P.placementid
        and la.activeflag = 1 
       Inner join afcarsreference ar on ar.statepicklistvaluetypekey =  
        (Select case  when lv.livingarrangementtypekey = 'TVH' then '10460'
         when lv.livingarrangementtypekey = 'SHA' then '74'
         when lv.livingarrangementtypekey = 'BP' then '1511'
         when lv.livingarrangementtypekey = 'COLG' then '1550'
         when lv.livingarrangementtypekey = 'ACI' then '1514'
         when lv.livingarrangementtypekey = 'FH' then '1520'
         when lv.livingarrangementtypekey = 'RFKH' then '1532'
         when lv.livingarrangementtypekey = 'SJD' then '1550'
         when lv.livingarrangementtypekey = 'RNW' then '6589'
         when lv.livingarrangementtypekey = 'IMCNA' then '8107'
         when lv.livingarrangementtypekey = 'Father''s Home' then '1520'
         when lv.livingarrangementtypekey = 'OHA' then '1520'
         when lv.livingarrangementtypekey = 'Inpatient Psychiatric Care' then '1550'
         when lv.livingarrangementtypekey = 'DJS' then '1550'
         when lv.livingarrangementtypekey = 'Homeless Shelter' then '1550'
         when lv.livingarrangementtypekey = 'REC' then '1550'
         when lv.livingarrangementtypekey = 'UNK' then '1550'
         when lv.livingarrangementtypekey = 'UNKNOWN' then '1550'
         when lv.livingarrangementtypekey = 'MH' then '1550'
        end 
       from  livingarrangement lv 
       where  lv.placementid::varchar = VS_PLACEMENT_ID2 
       order by lv.insertedon desc limit 1 )
     WHERE  p.placementid::varchar = VS_PLACEMENT_ID2
      and p.activeflag = 1 ;
      -- and p.startdatetime <= vdt_to::date  ;--
    
     IF (OUT_PLACEMENT_STATE IS NULL) THEN
      SELECT CASE  WHEN la.statetypekey = 'MD' THEN '2' 
          WHEN la.statetypekey != 'MD' AND la.statetypekey IS NOT NULL THEN '1' 
         ELSE '' 
        END 
       INTO  OUT_PLACEMENT_STATE
       FROM  placement P
        INNER JOIN livingarrangement LA ON la.placementid = P.placementid
         and la.activeflag = 1 
       WHERE  p.placementid::varchar = VS_PLACEMENT_ID2
        and p.activeflag = 1;
     END IF;
    
    End if;--
  

    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ; 
   END; 
 
   --*******ELEMENT #NO # 41 ,42 *******  --NO # 41,42 Number of Previous Placement Settings During This Removal Episode? ENDs here     
    

   --*******ELEMENT #NO # 43*******  --NO #43. Most Recent CASE Plan Goal starts here   
   BEGIN 
 
    RAISE NOTICE 'Element #43 %', timeofday();

    SELECT pp.primarypermanencytype
     INTO   VS_PERMANENCYPLANTYPE
    FROM   permanencyplan  pp
     INNER JOIN intakeservicerequestactor isr1 ON pp.intakeservicerequestactorid=isr1.intakeservicerequestactorid  
      AND isr1.activeflag=1
     INNER JOIN person p1 ON p1.personid=isr1.personid AND p1.activeflag  =  1
    WHERE  pp.serviceCASEid :: character varying = VS_SERVICECASEID 
      and pp.establisheddate <= vdt_to ::date -- + interval '30 day'  
      and pp.activeflag = 1
      and p1.cjamspid = OUT_CLIENT_ID
     --and  placementid::varchar = OUT_PLACEMENT_ID
    order by pp.establisheddate desc limit 1;
 

    -- Select Case when VS_PERMANENCYPLANTYPE in ( 'ADOPTR' , 'ADOPTNR'  ) then '3'
    Select  Case  when VS_PERMANENCYPLANTYPE in ( 'ADOPTNR'  ) then '3'
     when VS_PERMANENCYPLANTYPE in ( 'Guardianship') then '6'
     when VS_PERMANENCYPLANTYPE in ( 'Reunification' ) then '1'
     when VS_PERMANENCYPLANTYPE in ( 'CRLTC' ) then '4'
     -- when VS_PERMANENCYPLANTYPE in ( 'GUARDR' ) then '2'
     when VS_PERMANENCYPLANTYPE in ( 'GUARDR','ADOPTR' ) then '2'
     when VS_PERMANENCYPLANTYPE in ('APPLA'  ) then '5'
     else '7'
     end 
    into OUT_CASE_PLAN_GOAL_CD;--
 
    IF (OUT_CASE_PLAN_GOAL_CD = ' ') THEN
     SELECT CASE WHEN (vdt_to::date - OUT_LATEST_REMOVAL_DT::DATE)::INTEGER < 60 THEN '7' ELSE ' ' END 
      INTO OUT_CASE_PLAN_GOAL_CD;
    END IF;

    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ; 
   END; 
 
   --*******ELEMENT #NO # 44,45*******  --NO #44,45 Caretaker Family Structure  45. Year of Birth (1st Principal Caretaker) starts here   

   BEGIN 

    RAISE NOTICE 'Element #44 #45 %', timeofday();
    OUT_CARETAKER1_BIRTH_YEAR := NULL;
    SELECT 
     CASE WHEN ir.familystructuretypekey in  ('290', '291', '292') then '1'
      WHEN ir.familystructuretypekey in ('294', '296', '298', '299') then '2'
      WHEN ir.familystructuretypekey in ('288',  '293') then '3'
      WHEN ir.familystructuretypekey in ('289',  '295', '296') then '4'
      WHEN ir.familystructuretypekey = '297' then '5'
      ELSE '5'
     END, 
     DATE_PART('year', p.dob::date):: integer as yearofbirthfirstcaretaker   
    INTO OUT_CARETAKER_FAMILY_STRUCTURE_CD,OUT_CARETAKER1_BIRTH_YEAR
    FROM person p
     JOIN intakeservreqchildremoval ir ON ir.primarycaregiveractorid = p.personid 
      and ir.activeflag = 1
     join person p1 on p1.personid  = ir.personid 
      and p1.activeflag = 1
     join routing rur on rur.objectid = ir.intakeservreqchildremovalid::character varying
      and rur.eventcode = 'CHRR'
      and rur.activeflag = 1
      and rur.routingstatustypeid = '16'
    WHERE p1.cjamspid = OUT_CLIENT_ID 
     AND ir.removaldate::DATE <= vdt_to::DATE 
    ORDER BY ir.removaldate DESC LIMIT 1;
    
    if OUT_CARETAKER_FAMILY_STRUCTURE_CD is null then 
     OUT_CARETAKER_FAMILY_STRUCTURE_CD = 5;
    end if; 

    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
          
   END;

   --*******ELEMENT #NO # 44,45*******  --NO #44,45 Caretaker Family Structure  45. Year of Birth (1st Principal Caretaker) ENDs here   

   --*******ELEMENT #NO # 46*******  --NO #46 -  Year of Birth (2nd Principal Caretaker - if applicable) starts here   
   BEGIN 
 
    RAISE NOTICE 'Element #46 %', timeofday();
    OUT_CARETAKER2_BIRTH_YEAR := NULL;

    SELECT DATE_PART('year', p.dob::date):: integer as yearofbirthfirstcaretaker INTO OUT_CARETAKER2_BIRTH_YEAR
    from person p
     join intakeservreqchildremoval ir on ir.seccaregiveractorid = p.personid 
      and ir.activeflag = 1
     join person p1 on p1.personid  = ir.personid 
      and p1.activeflag = 1
     join routing rur on rur.objectid = ir.intakeservreqchildremovalid::character varying
      and rur.eventcode = 'CHRR'
      and rur.activeflag = 1
      and rur.routingstatustypeid = '16'
     WHERE p1.cjamspid = OUT_CLIENT_ID LIMIT 1;
     
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;        
   END;

   --*******ELEMENT #NO # 46*******  --NO #46 -  Year of Birth (2nd Principal Caretaker - if applicable) ENDs here   

   --*******ELEMENT #NO # 47*******  --NO #47 -  Date of Mother's Parental Rights Termination (if applicable)  starts here   
   BEGIN

    RAISE NOTICE 'Element #47 %', timeofday();
    select  ar.person2id, ar.intakeservicerequestactorid
    into  VS_MOTHER_PID, VS_INTAKE_ACTOR_ID
    FROM  intakeservicerequestactor ia
      LEFT JOIN actorrelationship ar on ar.intakeservicerequestactorid = ia.intakeservicerequestactorid
       and ar.activeflag = 1
      JOIN person p on p.personid = ia.personid and p.cjamspid = OUT_CLIENT_ID
      JOIN person p2 on p2.personid = ar.person2id and p2.gendertypekey = 'F' and p2.cjamspid != OUT_CLIENT_ID
      WHERE  ar.relationshiptypekey in  ('BGCHLD') 
     and ia.activeflag = 1
      LIMIT 1;

    
    SELECT
     CASE WHEN tpr.terminationtypekey IN ('PARDEATH', '3608') then p.dateofdeath
      ELSE tpr.tprdecisiondate
     end
    INTO
     OUT_MOTHER_TPR_DT
    FROM tprdetails tpr
    JOIN intakeservicerequestactor ia on ia.intakeservicerequestactorid = tpr.intakeservicerequestactorid
     and ia.activeflag = 1
    JOIN tprrecommendation tprc on tprc.tprrecommendationid = tpr.tprrecommendationid
     and tprc.activeflag = 1
    JOIN person p on p.personid = ia.personid
    where ia.personid::VARCHAR = VS_MOTHER_PID
     AND tprc.intakeservicerequestactorid::VARCHAR = VS_INTAKE_ACTOR_ID
     and tpr.activeflag = 1
    -- and ia.serviceCASEid  :: character varying= VS_SERVICECASEID       
      order by tpr.insertedon desc limit 1 ;
 
    RAISE NOTICE 'OUT_MOTHER_TPR_DT;>>>>>>>>>>>>>>>>>>>>>>>>>>>>>%', OUT_MOTHER_TPR_DT;


    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;         
   END;    

   --*******ELEMENT #NO # 47*******  --NO #47 -  Date of Mother's Parental Rights Termination (if applicable)  ENDs here   

   --*******ELEMENT #NO # 48*******  --NO #48. Date of Father's Parental Rights Termination (if applicable)   starts here   
   BEGIN 

    RAISE NOTICE 'Element #48 %', timeofday();
    select  ar.person2id, ar.intakeservicerequestactorid
    into  VS_FATHER_PID, VS_INTAKE_ACTOR_ID
    FROM  intakeservicerequestactor ia
      JOIN actorrelationship ar on ar.intakeservicerequestactorid = ia.intakeservicerequestactorid
       and ar.activeflag = 1
      JOIN person p on p.personid = ia.personid and p.cjamspid = OUT_CLIENT_ID
      JOIN person p2 on p2.personid = ar.person2id and p2.gendertypekey = 'M' and p2.cjamspid != OUT_CLIENT_ID
    WHERE ar.relationshiptypekey in  ('BGCHLD','BGFTHR','DAUALG') 
     and ia.activeflag = 1
    ORDER BY ar.relationshiptypekey asc, ar.insertedon 
    desc LIMIT 1;

    SELECT
     CASE WHEN tpr.terminationtypekey IN ('PARDEATH', '3608') then p.dateofdeath
      ELSE tpr.tprdecisiondate
     end
    INTO
     OUT_FATHER_TPR_DT
    FROM tprdetails tpr
     JOIN intakeservicerequestactor ia on ia.intakeservicerequestactorid = tpr.intakeservicerequestactorid
      and ia.activeflag = 1
     JOIN tprrecommendation tprc on tprc.tprrecommendationid = tpr.tprrecommendationid
      and tprc.activeflag = 1
     JOIN person p on p.personid = ia.personid
    where ia.personid::VARCHAR = VS_FATHER_PID
     AND tprc.intakeservicerequestactorid::VARCHAR = VS_INTAKE_ACTOR_ID
     and tpr.activeflag = 1
    -- and ia.serviceCASEid  :: character varying= VS_SERVICECASEID       
      order by tpr.insertedon desc limit 1 ;
    

    EXCEPTION WHEN OTHERS THEN
      VS_ERR_OUTPUT_STATE := SQLSTATE;
      VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
      VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
      VS_ERR_EXCEP_FLAG := 1;
      VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;        
   END; 
 
   --*******ELEMENT #NO # 48*******  --NO #48. Date of Father's Parental Rights Termination (if applicable) ENDs here   

   -- 49 Foster family structure -- 50 year of birth  -- 52 .Race of 1st Foster Caretaker, -- 53 .Hispanic or Latino Ethnicity of 1st Foster Caretaker  starts here 
   

   BEGIN 

    RAISE NOTICE 'Element #49 %', timeofday();
   
    OUT_FOSTERCARE1_BIRTH_YEAR = '';
    OUT_FOSTERCARE1_RACE_AI_CD = '0'; 
    OUT_FOSTERCARE1_RACE_ASIAN_CD = '0'; 
    OUT_FOSTERCARE1_RACE_BLACK_CD = '0';
    OUT_FOSTERCARE1_RACE_HAWAIIAN_CD = '0'; 
    OUT_FOSTERCARE1_RACE_WHITE_CD = '0'; 
    OUT_FOSTERCARE1_RACE_UN_CD = '0';
    OUT_FOSTERCARE1_HISPANIC_CD = '0';
    OUT_FOSTER_FAMILY_STRUCTURE_CD = '0';
    VS_COUNT1 = 0;
    VS_CPA_PRVDR_ID = NULL;
    VS_TPC_EXIT_DATE = NULL;
 
  
    SELECT tpc.provider_id,tpc.exit_dt 
     INTO VS_CPA_PRVDR_ID,VS_TPC_EXIT_DATE
    FROM TB_PLACEMENT_CPA_HOMES tpc 
     JOIN PLACEMENT pl ON pl.alternateid = tpc.placement_id 
     JOIN person p on p.personid = pl.personid
    WHERE p.cjamspid = OUT_CLIENT_ID
     AND pl.alternateid is not null 
     AND pl.contractprogramid is not null 
     and (pl.isvoided is null or pl.isvoided != 1)
     and tpc.delete_sw = 'N'
     AND tpc.entry_dt <= vdt_to::DATE
     and pl.activeflag = 1
    ORDER BY tpc.entry_dt DESC LIMIT 1;
    
    RAISE NOTICE 'CPA Home provider Id %', VS_CPA_PRVDR_ID ;
    RAISE NOTICE 'VS_TPC_EXIT_DATE %', VS_TPC_EXIT_DATE ;
  
    IF (VS_CPA_PRVDR_ID IS NOT NULL AND VS_TPC_EXIT_DATE IS NOT NULL) THEN
     SELECT COUNT(*) INTO VS_COUNT1
      FROM placement pl
      JOIN person p on p.personid = pl.personid
     WHERE p.cjamspid = OUT_CLIENT_ID
      AND pl.providerid is not null AND pl.altproviderid is not null
      AND pl.placementtypekey = 'PRPL' 
      and pl.activeflag = 1
      AND pl.startdatetime::date >= VS_TPC_EXIT_DATE::date; 
      
     RAISE NOTICE 'VS_COUNT1 %', VS_COUNT1;
    END IF;
 
    IF (VS_CPA_PRVDR_ID IS NOT NULL AND VS_COUNT1 = 0) THEN
     RAISE NOTICE 'CPA Family';   
    
     SELECT FAMILY_STRUCTURE_CD, 
      DATE_PART('year', dob_dt::date)::varchar as dob,
      case when primary_race_cd != '' AND trunc(primary_race_cd) in ('1802','1803') then '1' else '0' end as indian,  
      case when primary_race_cd != '' AND trunc(primary_race_cd) = '6310' then '1' else '0' end as asian, 
      case when primary_race_cd != '' AND trunc(primary_race_cd) = '1801' then '1' else '0' end as black, 
      case when primary_race_cd != '' AND trunc(primary_race_cd) = '6311' then '1' else '0' end as island, 
      case when primary_race_cd != '' AND trunc(primary_race_cd) = '1806' then '1' else '0' end as white,
      case when primary_race_cd != '' AND trunc(primary_race_cd) in ('6312','6314') then '1' else '0' end as undetermine,
      case when hispanic_cd = 'Y' then '1' 
       when hispanic_cd = 'N' then '2' 
       when hispanic_cd = 'U' then '3'
        else ' ' 
       end as hisp 
     INTO VS_FAMILY_STRUCTURE,
      OUT_FOSTERCARE1_BIRTH_YEAR,
      OUT_FOSTERCARE1_RACE_AI_CD,  
      OUT_FOSTERCARE1_RACE_ASIAN_CD,  
      OUT_FOSTERCARE1_RACE_BLACK_CD, 
      OUT_FOSTERCARE1_RACE_HAWAIIAN_CD, 
      OUT_FOSTERCARE1_RACE_WHITE_CD, 
      OUT_FOSTERCARE1_RACE_UN_CD,
      OUT_FOSTERCARE1_HISPANIC_CD
     FROM TB_PROV_CPA_ADOP_PERSON 
     WHERE PROVIDER_ID = VS_CPA_PRVDR_ID
      AND DELETE_SW = 'N' 
      AND TRUNC(PERSON_TYPE_CD) = '3610'
     ORDER BY provider_cpa_adop_person_id DESC LIMIT 1;  
    
     RAISE NOTICE 'CPA Family_2'; 
   
     select case when VS_FAMILY_STRUCTURE in  ('290', '291', '292') then '1'
      when VS_FAMILY_STRUCTURE in ('294', '296', '298', '299') then '2'
      when VS_FAMILY_STRUCTURE in ('288',  '293') then '3'
      when VS_FAMILY_STRUCTURE in ('289',  '295', '296') then '4'
      when VS_FAMILY_STRUCTURE = '297' then '5'
      else '0'
     end 
     into OUT_FOSTER_FAMILY_STRUCTURE_CD;
     RAISE NOTICE 'CPA Family_3'; 
    ELSE
     RAISE NOTICE 'Non CPA Family';
     VS_APPROVAL_PERSONID = NULL;
     VS_ALT_PROVIDERID = NULL;
    
     SELECT pl.altproviderid INTO VS_ALT_PROVIDERID
     from placement pl
      JOIN person p ON p.personid = pl.personid 
     WHERE cjamspid = OUT_CLIENT_ID
      AND pl.startdatetime <= vdt_to::DATE 
      and pl.activeflag = 1
      AND pl.providerid is not null 
      AND pl.altproviderid is not null
     order by startdatetime desc
     LIMIT 1;
    
     SELECT pap.approval_person_id, pap.family_structure_cd  
       into  VS_APPROVAL_PERSONID, VS_FAMILY_STRUCTURE 
      FROM tb_prov_approval_person  pap
      JOIN tb_provider_approval pa ON pap.provider_approval_id = pa.provider_approval_id
       and pa.delete_sw = 'N'
     WHERE pa.provider_id = VS_ALT_PROVIDERID
      AND approval_dt::date <= vdt_to::DATE  
      AND pap.person_type_cd in ('3610')
      and pap.delete_sw = 'N'
     ORDER BY  pa.entry_dt desc limit 1;
   
   
     RAISE NOTICE 'VS_APPROVAL_PERSONID 1 %', VS_APPROVAL_PERSONID ;
 
     IF (VS_APPROVAL_PERSONID IS NOT NULL) THEN 
   
      Select case  when VS_FAMILY_STRUCTURE in  ('290', '291', '292') then '1'
       when VS_FAMILY_STRUCTURE in ('294', '296', '298', '299') then '2'
       when VS_FAMILY_STRUCTURE in ('288',  '293') then '3'
       when VS_FAMILY_STRUCTURE in ('289',  '295', '296') then '4'
       when VS_FAMILY_STRUCTURE = '297' then '5'
       else '0'
      end 
      into  OUT_FOSTER_FAMILY_STRUCTURE_CD;--

      RAISE NOTICE 'OUT_FOSTER_FAMILY_STRUCTURE_CD %', OUT_FOSTER_FAMILY_STRUCTURE_CD ;
   
      select  DATE_PART('year', dob_dt::date)::varchar as dob , 
       case when primary_race_cd != '' AND primary_race_cd in ('1802','1803') then '1' else '0' end as indian,  
       case when primary_race_cd != '' AND primary_race_cd = '6310' then '1' else '0' end as asian, 
       case when primary_race_cd != '' AND primary_race_cd = '1801' then '1' else '0' end as black, 
       case when primary_race_cd != '' AND primary_race_cd = '6311' then '1' else '0' end as island, 
       case when primary_race_cd != '' AND primary_race_cd = '1806' then '1' else '0' end as white,
       case when primary_race_cd != '' AND primary_race_cd in ('6312','6314') then '1' else '0' end as undetermine,
       case when hispanic_cd = 'Y' then '1' 
        when hispanic_cd = 'N' then '2' 
        when hispanic_cd = 'U' then '3'
        else ' ' 
        end as hisp
      INTO   OUT_FOSTERCARE1_BIRTH_YEAR,
       OUT_FOSTERCARE1_RACE_AI_CD,  
       OUT_FOSTERCARE1_RACE_ASIAN_CD,  
       OUT_FOSTERCARE1_RACE_BLACK_CD, 
       OUT_FOSTERCARE1_RACE_HAWAIIAN_CD, 
       OUT_FOSTERCARE1_RACE_WHITE_CD, 
       OUT_FOSTERCARE1_RACE_UN_CD,
       OUT_FOSTERCARE1_HISPANIC_CD
      FROM   tb_prov_approval_person
      WHERE  approval_person_id = VS_APPROVAL_PERSONID
       and delete_sw = 'N';--
     END IF;
    END IF;
 
  
    RAISE NOTICE 'OUT_PLACEMENT_SETTING_CD % ', OUT_PLACEMENT_SETTING_CD;
  
    If OUT_FOSTER_FAMILY_STRUCTURE_CD = '0' AND OUT_PLACEMENT_SETTING_CD NOT IN ('1','2','3') then 
     RAISE NOTICE 'OUT_FOSTER_FAMILY_STRUCTURE_CD %', OUT_FOSTER_FAMILY_STRUCTURE_CD ;
     OUT_FOSTERCARE1_RACE_AI_CD := '0';--
     OUT_FOSTERCARE1_RACE_ASIAN_CD := '0';--
     OUT_FOSTERCARE1_RACE_BLACK_CD := '0';--
     OUT_FOSTERCARE1_RACE_WHITE_CD := '0' ;--
     OUT_FOSTERCARE1_RACE_HAWAIIAN_CD := '0';--     
     OUT_FOSTERCARE1_RACE_UN_CD  := '0';--
     OUT_FOSTERCARE1_HISPANIC_CD := '0';--
    
    end if;--
    
  
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;        
   END;

   -- 49 Foster family structure -- 50 year of birth  -- 52 .Race of 1st Foster Caretaker, -- 53 .Hispanic or Latino Ethnicity of 1st Foster Caretaker  ENDs here 


   -- 51 year of birth  -- 54 .Race of 1st Foster Caretaker, -- 55 .Hispanic or Latino Ethnicity of 1st Foster Caretaker  starts here 
   BEGIN 
 
    RAISE NOTICE 'Element #51, #54, #55 %', timeofday();
    OUT_FOSTERCARE2_BIRTH_YEAR = '';
    OUT_FOSTERCARE2_RACE_AI_CD = '0';  
    OUT_FOSTERCARE2_RACE_ASIAN_CD = '0';   
    OUT_FOSTERCARE2_RACE_BLACK_CD = '0';  
    OUT_FOSTERCARE2_RACE_HAWAIIAN_CD = '0'; 
    OUT_FOSTERCARE2_RACE_WHITE_CD = '0'; 
    OUT_FOSTERCARE2_RACE_UN_CD = '0'; 
    OUT_FOSTERCARE2_HISPANIC_CD = '0'; 
    VS_COUNT1 = 0;
    VS_CPA_PRVDR_ID = NULL;
    VS_TPC_EXIT_DATE = NULL;
 
    SELECT tpc.provider_id,tpc.exit_dt 
