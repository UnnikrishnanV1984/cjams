     AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
     -- AND (iscr.exitdate IS NULL OR iscr.exitdate::date >= vdt_from::date);
     AND ((CASE WHEN iscr.exitdate IS NOT NULL THEN iscr.exitdate::date >= vdt_from::date ELSE 
      (CASE WHEN iscr.returntransts IS NOT NULL AND iscr.returntransts != '1900-01-01' THEN iscr.returntransts::date >= vdt_from::date ELSE TRUE END)  END)
       OR
       (CASE WHEN iscr.returntransts IS NOT NULL AND iscr.returntransts != '1900-01-01' THEN iscr.returntransts::date >= vdt_from::date ELSE TRUE END));
        
    /* Select case when OUT_PHYSICAL_ABUSE::integer >= 1 then '1' else '0'  end into OUT_PHYSICAL_ABUSE;--
     Select case when OUT_SEXUAL_ABUSE::integer >= 1 then '1' else '0' end into OUT_SEXUAL_ABUSE;--
     Select case when OUT_NEGLECT::integer >= 1 then '1'  else '0' end into OUT_NEGLECT;--
     Select case when OUT_PAR_ALCOHOL_ABUSE::integer >= 1 then  '1' else '0' end into OUT_PAR_ALCOHOL_ABUSE;--
     Select case when OUT_PAR_DRUG_ABUSE::integer >= 1 then '1' else '0' end into OUT_PAR_DRUG_ABUSE;--
     Select case when OUT_CHILD_ALCOHOL_ABUSE::integer >= 1 then '1' else '0' end into OUT_CHILD_ALCOHOL_ABUSE;--
     Select case when OUT_CHILD_DRUG_ABUSE::integer >= 1 then '1' else '0' end into OUT_CHILD_DRUG_ABUSE;--
     Select case when OUT_CHILD_DISABILITY::integer >= 1 then '1' else '0' end into OUT_CHILD_DISABILITY;--
     Select case when OUT_CHILD_BEHAVIOR::integer >= 1 then '1' else '0' end into OUT_CHILD_BEHAVIOR;--
     Select case when OUT_PARENT_DEATH::integer >= 1 then '1' else '0' end into OUT_PARENT_DEATH;--
     Select case when OUT_PARENT_INCARCERATION::integer >= 1 then '1' else '0' end into OUT_PARENT_INCARCERATION;--
     Select case when OUT_CARETAKER_ILLNESS::integer >= 1 then '1' else '0' end into OUT_CARETAKER_ILLNESS;--
     Select case when OUT_ABANDONMENT::integer >= 1 then  '1' else '0' end into OUT_ABANDONMENT;--
     Select case when OUT_RELINQUISHMENT::integer >= 1 then  '1' else '0' end into OUT_RELINQUISHMENT;--
     Select case when OUT_INADEQUATE_HOUSING::integer >= 1 then '1' else '0' end into OUT_INADEQUATE_HOUSING ;--  */
  
          
          
    EXCEPTION WHEN OTHERS THEN
