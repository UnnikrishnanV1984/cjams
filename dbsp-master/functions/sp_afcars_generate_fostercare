      and lu.activeflag = 1
    WHERE h.servicecaseid::VARCHAR = VS_SERVICECASEID
     and h.activeflag = 1
     AND (p.cjamspid =  OUT_CLIENT_ID OR p.fk_id = OUT_CLIENT_ID) 
     AND h.hearingdatetime::DATE BETWEEN OUT_LATEST_REMOVAL_DT::DATE AND VS_PERIOD_END_DT::DATE;
     -- AND CASE WHEN OUT_LATEST_REMOVAL_DT::DATE + interval '9 month' < VDT_TO::date THEN h.hearingdatetime::DATE BETWEEN VDT_TO::date - interval '9 month' AND VDT_TO::date ELSE TRUE END;
    
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ; 
    
   END;
