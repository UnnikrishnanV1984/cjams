   --*******ELEMENT #NO # 19 *******  --NO #  Total Number of Removals FROM Home to Date  starts here   
   BEGIN 

    RAISE NOTICE 'Element #19 %', timeofday();
    SELECT COUNT(*) INTO VS_NUM_REMOVALS1
     FROM (WITH cte as (
     SELECT distinct iscr.removaldate, iscr.exitdate
      FROM intakeservreqchildremoval iscr  
       join person p on p.personid = iscr.personid 
        and p.activeflag = 1
       join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
        and rur.eventcode = 'CHRR'
        and rur.activeflag = 1
        and rur.routingstatustypeid = '16' 
     WHERE p.cjamspid = OUT_CLIENT_ID
      AND iscr.removaldate <= vdt_to::date 
      AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
      AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
      and iscr.activeflag = 1
      ORDER BY iscr.removaldate asc)
     SELECT
      removaldate, exitdate, 
      LAG(exitdate,1) OVER () as prevreturndate
     FROM cte)
    WHERE CASE WHEN removaldate = prevreturndate THEN false else true end;
  
    VS_BIO_CLIENTID := NULL;  
    select  pa.cjamspid 
     INTO VS_BIO_CLIENTID
    from  adoptioncase ac 
     join adoptionlink al on al.adoptioncaseid = ac.adoptioncaseid
     join adoptioncaseactor aca on aca.adoptioncaseid = ac.adoptioncaseid and aca.actortypekey = 'CHILD'
     join person pr on pr.personid = aca.personid and pr.activeflag = 1 
     join biologicaladoptionlink bol on al.preadoptionclientid = bol.preadoptiveclientid
     join adoptionbreakthelink abl ON abl.adoptionplanningid = bol.preadoptivecaseid
     join person pa on pa.personid = BOL.preadoptiveclientid and pa.activeflag = 1
    WHERE  pr.cjamspid = OUT_CLIENT_ID
     and ac.activeflag = 1;

    VS_NUM_REMOVALS2 := 0;
    IF (VS_BIO_CLIENTID IS NOT NULL) THEN
     RAISE NOTICE 'BIO CLIENT ID %', VS_BIO_CLIENTID;
    
     SELECT COUNT(*) INTO VS_NUM_REMOVALS2
     FROM (WITH cte as (
      SELECT distinct iscr.removaldate, iscr.exitdate
       FROM intakeservreqchildremoval iscr  
        join person p on p.personid = iscr.personid 
         and p.activeflag = 1
        join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
         and rur.eventcode = 'CHRR'
         and rur.activeflag = 1
         and rur.routingstatustypeid = '16' 
      WHERE p.cjamspid = VS_BIO_CLIENTID
       AND iscr.removaldate <= vdt_to::date 
       AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
       AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
       and iscr.activeflag = 1
       ORDER BY iscr.removaldate asc)
      SELECT
       removaldate, exitdate, 
       LAG(exitdate,1) OVER () as prevreturndate
      FROM cte)
     WHERE CASE WHEN removaldate = prevreturndate THEN false else true end;
    END IF;
   
    OUT_NUM_REMOVALS := VS_NUM_REMOVALS1 + VS_NUM_REMOVALS2 ;--

    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
   END; 

   --*******ELEMENT #NO # 19  *******  --NO #  Total Number of Removals FROM Home to Date  ENDs here    

    
   --*******ELEMENT #NO # 18,23 *******  --NO #   starts here   

   BEGIN 
 
    RAISE NOTICE 'Element #18, #23 %', timeofday();
    select  min(sdt) 
     into OUT_FIRST_REMOVAL_DT
    from ( 
      (SELECT removaldate as sdt
       FROM (WITH cte as (
        SELECT iscr.removaldate, iscr.exitdate
         FROM intakeservreqchildremoval iscr  
          join person p on p.personid = iscr.personid 
           and p.activeflag = 1
          join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
           and rur.eventcode = 'CHRR'
           and rur.activeflag = 1
           and rur.routingstatustypeid = '16' 
        WHERE p.cjamspid = OUT_CLIENT_ID
         AND iscr.removaldate <= vdt_to::date 
         AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
         AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
         and iscr.activeflag = 1
         order by iscr.removaldate asc
        )
        SELECT
         removaldate, exitdate, 
         LAG(exitdate,1) OVER () as prevreturndate
        FROM cte)
      WHERE CASE WHEN removaldate = prevreturndate THEN false else true end)
      UNION  
      (SELECT removaldate as sdt
       FROM (WITH cte as (
        SELECT iscr.removaldate, iscr.exitdate
         FROM intakeservreqchildremoval iscr  
          join person p on p.personid = iscr.personid 
           and p.activeflag = 1
          join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
           and rur.eventcode = 'CHRR'
           and rur.activeflag = 1
           and rur.routingstatustypeid = '16' 
        WHERE p.cjamspid = VS_BIO_CLIENTID
         AND iscr.removaldate <= vdt_to::date 
         AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
         AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
         and iscr.activeflag = 1
         order by iscr.removaldate asc
        )
        SELECT
         removaldate, exitdate, 
         LAG(exitdate,1) OVER () as prevreturndate
        FROM cte)
      WHERE CASE WHEN removaldate = prevreturndate THEN false else true end)
      UNION
      (SELECT MIN(startdatetime) as sdt
       FROM placement pl
       JOIN person p on p.personid = pl.personid
       JOIN livingarrangement la on la.placementid = pl.placementid
       WHERE p.cjamspid = OUT_CLIENT_ID
       and pl.activeflag = 1
       and (pl.isvoided is null or pl.isvoided != 1)
       and pl.placementtypekey = 'LA'
       and la.livingarrangementtypekey NOT IN ('BP', 'MH', 'IMCNA', 'REC','PSYH','IPC','OHA','ADPN','PLMT',
                'RFKH','SJD','RNW','Father''s Home','TVH'))) B;
           
    IF (OUT_FIRST_REMOVAL_DT IS NOT NULL) THEN
     RAISE NOTICE 'OUT_FIRST_REMOVAL_DT %', OUT_FIRST_REMOVAL_DT;
     VS_FIRST_REMOVAL_DT1 := OUT_FIRST_REMOVAL_DT;
     VS_END_DATE := NULL;
    
     SELECT COALESCE(
      (SELECT pl.enddatetime
       FROM livingarrangement la
       JOIN placement pl on pl.placementid = la.placementid
       JOIN person p on p.personid = pl.personid
       WHERE p.cjamspid = OUT_CLIENT_ID
        and pl.startdatetime::date = OUT_FIRST_REMOVAL_DT::date
        and pl.activeflag = 1
        and (pl.isvoided is null or pl.isvoided != 1)
        and pl.placementtypekey = 'LA'
        and la.activeflag = 1        
        and la.livingarrangementtypekey IN ('MH','SJD','PSYH','IPC','IMCNA','REC',
            'Inpatient Medical Care - Non-Acute','Inpatient Psychiatric Care')
       ORDER BY pl.startdatetime LIMIT 1),NULL) INTO VS_END_DATE ; 
     
     RAISE NOTICE 'VS_END_DATE %', VS_END_DATE;
    
     IF (VS_END_DATE IS NOT NULL) THEN
      VS_FIRST_REMOVAL_DT2 := NULL;
      SELECT pl.startdatetime      
      INTO VS_FIRST_REMOVAL_DT2
      FROM placement pl
      JOIN person p on p.personid = pl.personid
      WHERE p.cjamspid = OUT_CLIENT_ID
       and pl.startdatetime::date >= VS_END_DATE::DATE
       and pl.activeflag = 1
       and (pl.isvoided is null or pl.isvoided != 1)
       ORDER BY pl.startdatetime ASC
      LIMIT 1;
     
      IF (VS_FIRST_REMOVAL_DT2 IS NOT NULL) 
       AND VS_END_DATE < OUT_FIRST_REMOVAL_DT THEN -- 04/23
       -- OUT_LATEST_REMOVAL_DT := VS_LATEST_REMOVAL_DT2;
       OUT_FIRST_REMOVAL_DT := VS_END_DATE;
      END IF;
      
      RAISE NOTICE 'VS_FIRST_REMOVAL_DT2 %', VS_FIRST_REMOVAL_DT2;
     END IF;
    END IF;
  
         
    OUT_PLACEMENT_DT = NULL;
      
    SELECT MAX (sdt) 
     INTO OUT_PLACEMENT_DT 
    FROM ((SELECT startdatetime as sdt, enddatetime as edt
    FROM (WITH cte as (
      SELECT pl.providerid, pl.altproviderid, pl.startdatetime, pl.enddatetime
      FROM  placement pl 
      JOIN person p on p.personid = pl.personid
      WHERE p.cjamspid = OUT_CLIENT_ID
       AND pl.startdatetime <= vdt_to::date + interval '21 day' 
       and pl.activeflag = 1
       AND pl.isvoided != 1 and pl.placementtypekey = 'PRPL'
       order by pl.providerid, pl.startdatetime asc
      )
      SELECT
       providerid, altproviderid, startdatetime, enddatetime, 
       LAG(enddatetime,1) OVER (ORDER BY startdatetime) as previousenddatetime,
       LAG(providerid,1) OVER (ORDER BY startdatetime) as previousproviderid,
       LAG(altproviderid,1) OVER (ORDER BY startdatetime) as previousaltproviderid
      FROM cte)
     WHERE CASE WHEN (altproviderid = previousaltproviderid AND  startdatetime = previousenddatetime) THEN false else true end
     ORDER by enddatetime desc nulls first, startdatetime DESC )
    UNION
    (SELECT livingstartdate as sdt, livingenddate as edt 
    FROM (WITH cte as (
      SELECT  la.livingarrangementtypekey, la.livingstartdate, la.livingenddate
      FROM livingarrangement la
      JOIN person p on p.personid = la.personid
      WHERE p.cjamspid = OUT_CLIENT_ID    
       AND la.livingstartdate <= vdt_to::date 
       AND la.livingarrangementtypekey IN ('SJD','IMCNA','TVH','FH','ACI','SHA','RNW','RFKH',
                 'Father''s Home')
       and la.activeflag = 1
       ORDER BY la.livingarrangementtypekey, la.livingstartdate ASC
      )
      SELECT 
       livingarrangementtypekey, livingstartdate, livingenddate,
       LAG(livingenddate,1) OVER (ORDER BY livingarrangementtypekey) as previousenddate,
         LAG(livingarrangementtypekey,1) OVER (ORDER BY livingarrangementtypekey) as previouskey
     FROM cte)   
     WHERE CASE WHEN (livingarrangementtypekey = previouskey AND  livingstartdate = previousenddate) THEN false else true end
    ORDER by livingenddate desc nulls first, livingstartdate DESC ) 
    ) C; 

    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
  
  
   END;--

   --*******ELEMENT #NO # 18,23 *******  --NO #   ends here   
      
