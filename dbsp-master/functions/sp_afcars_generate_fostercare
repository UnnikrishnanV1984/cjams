   ----- *************  ELEMENT #5  ***********---------------
   

   -- 56 Date of Discharge FROM Foster Care , 57 - Foster Care Discharge Transaction Date , 58 - Reason for discharge  59 - TITLE IV-E (ELIGIBILITY)  -- ENDs here 

   --  ****** ELEMENT # 61, 62, 63 & 64  ******-------                           
   -- TITLE IV-A, IV-D, TITLE XIX, FEDERAL FUNDS (SSI/SSA)

   BEGIN
    RAISE NOTICE 'Element #61, 62, 63, 64 %', timeofday();

    VS_ELEM_65_CNT := 0;
    OUT_XIX_SW := '0';
    OUT_IV_A_SW := '0';
    OUT_IV_D_SW := '0';
    OUT_SSI_OR_SSA_SW := '0';
 
    SELECT
     tep.status_cd
    INTO 
     VS_IVE_STATUS
    FROM  tb_client_eligibility tce 
     JOIN tb_eligibility_period tep ON tep.eligibility_id = tce.eligibility_id 
      AND tep.delete_sw = 'N'
    WHERE eligibility_type_cd = '2934' 
     AND tce.client_id  = OUT_CLIENT_ID 
     AND tce.case_id = VS_CASE_ID
     and tce.delete_sw = 'N'
    ORDER BY tep.sqnm_sw desc, tep.create_ts desc LIMIT 1;
 
    IF (VS_IVE_STATUS = '2913') THEN
     OUT_IV_A_SW = '1';
    END IF;

    SELECT COUNT(*) 
     INTO VS_COUNT1
    FROM tb_client_income tci
    WHERE tci.client_id  = OUT_CLIENT_ID 
     AND tci.delete_sw = 'N' 
     AND tci.income_source_id IN ('8','26') 
     AND (tci.start_dt <= vdt_to::date) 
     AND ((tci.end_dt >= vdt_from::date) OR (tci.end_dt IS NULL));
  
    IF VS_COUNT1 > 0 then 
     OUT_SSI_OR_SSA_SW := '1';
    end if;
  
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ; 
    
    
   END;
   
   --  ****** ELEMENT # 65  ******-------                                    
   -- NONE OF THE ABOVE FROM (59-64)
   BEGIN
 
    RAISE NOTICE 'Element #65 %', timeofday();
    SELECT  COUNT(*) 
     INTO VS_ELEM_65_CNT 
    FROM tb_client_income tci
    WHERE tci.income_source_id IN (3, 19, 6, 15, 16, 9, 10, 17, 21) 
     AND tci.verification_cd IN ('10402','10406','1198','1200','1203')
     AND tci.client_id = OUT_CLIENT_ID 
     AND tci.delete_sw = 'N'
     AND (tci.start_dt <= vdt_to::date) 
     AND ((tci.end_dt >= vdt_from::date) OR (tci.end_dt IS NULL));--
  
    IF  (VS_ELEM_65_CNT > 0)
     OR 
     (COALESCE(OUT_IV_E_FOSTERCARE_SW,'0') = '0'  AND
     COALESCE(OUT_IV_E_ADOPTION_SW,'0') = '0'  AND
     (COALESCE(OUT_IV_A_SW,'0') = '0' OR RTRIM(LTRIM(OUT_IV_A_SW)) = '') AND 
     (COALESCE(OUT_IV_D_SW,'0') = '0' OR RTRIM(LTRIM(OUT_IV_D_SW)) = '') AND
     (COALESCE(OUT_XIX_SW,'0') = '0'  OR RTRIM(LTRIM(OUT_XIX_SW)) = '') AND
     (COALESCE(OUT_SSI_OR_SSA_SW,'0') = '0' OR RTRIM(LTRIM(OUT_SSI_OR_SSA_SW)) = '' ) ) THEN    
     VS_NO_FEDERAL_SUPPORT_SW := '1';--
    
    ELSE
     VS_NO_FEDERAL_SUPPORT_SW := '0';--
    END IF;--
 
   end;
   --  ****** ELEMENT # 66  ******-------                                    
   -- AMT OF MONTHLY FOSTERCARE PAYMENT

   BEGIN

    RAISE NOTICE 'Element #66 %', timeofday();

    OUT_FOSTERCARE_PAYMENT_AMT = '0';
    VS_PAYMENT_MONTH = 0;
    VS_PAYMENT_YEAR = 0;


    SELECT 
     EXTRACT(MONTH FROM final_service_start_dt)::INTEGER, EXTRACT(YEAR FROM final_service_start_dt)::INTEGER
     INTO VS_PAYMENT_MONTH, VS_PAYMENT_YEAR
    FROM tb_payment_header payhead 
     INNER JOIN tb_payment_detail paydet ON paydet.payment_id=payhead.payment_id 
      AND paydet.delete_sw='N'
     INNER JOIN person client ON client.cjamspid=paydet.client_id
      AND client.activeflag=1
     LEFT JOIN tb_provider AS prov ON payhead.provider_id = prov.provider_id 
      AND prov.delete_sw='N'
     inner JOIN tb_payment_status paystat ON payhead.payment_id=paystat.payment_id 
      and paystat.payment_status_cd in ('1636', '1634') 
      and paystat.delete_sw = 'N' 
     inner JOIN servicecase AS ISR ON ISR.servicecasenumber = paydet.case_id::character varying 
      AND ISR.activeflag=1 
    WHERE payhead.delete_sw='N' 
     AND paydet.client_id=OUT_CLIENT_ID 
     AND payhead.payment_type_cd = 6 AND paydet.final_service_start_dt >= vdt_from::date AND 
      paydet.final_service_end_dt <= vdt_to::date
     AND ((EXTRACT(MONTH FROM final_service_start_dt) IN (4,6,9,11) AND EXTRACT(DAY FROM final_service_end_dt) = 30)
       OR
       (EXTRACT(MONTH FROM final_service_start_dt) IN (1,3,5,7,8,10,12) AND EXTRACT(DAY FROM final_service_end_dt) = 31)
       OR
       (EXTRACT(MONTH FROM final_service_start_dt) = 2 AND
        ((MOD(EXTRACT(YEAR FROM final_service_end_dt)::INTEGER ,4) = 0  AND EXTRACT(DAY FROM final_service_end_dt) > 28) OR
         (MOD(EXTRACT(YEAR FROM final_service_end_dt)::INTEGER ,4) > 0  AND EXTRACT(DAY FROM final_service_end_dt) = 28)))) 
    GROUP BY Paydet.client_id,payhead.payment_id,paydet.final_amount_no,payhead.payment_dt,
     payhead.payment_type_cd,payhead.provider_id,paydet.payment_detail_id,paydet.final_service_start_dt, paydet.final_service_end_dt,
     paydet.final_fiscal_category_cd
    ORDER BY payhead.payment_dt DESC
    LIMIT 1;

    IF (VS_PAYMENT_MONTH > 0 AND VS_PAYMENT_YEAR > 0) THEN
  
     SELECT round(sum(finalamount))::varchar   
      INTO OUT_FOSTERCARE_PAYMENT_AMT 
     FROM (
      SELECT round(paydet.final_amount_no) as finalamount
       FROM tb_payment_header payhead 
        INNER JOIN tb_payment_detail paydet ON paydet.payment_id=payhead.payment_id 
         AND paydet.delete_sw='N'
        INNER JOIN person client ON client.cjamspid=paydet.client_id 
         AND client.activeflag=1
        LEFT JOIN tb_provider AS prov ON payhead.provider_id = prov.provider_id 
         AND prov.delete_sw='N'
        inner JOIN tb_payment_status paystat ON payhead.payment_id=paystat.payment_id 
         and paystat.payment_status_cd in ('1636', '1634') 
         and paystat.delete_sw = 'N'
        inner JOIN servicecase AS ISR ON ISR.servicecasenumber = paydet.case_id::character varying 
         AND ISR.activeflag=1 
       WHERE payhead.delete_sw='N' 
        AND paydet.client_id = OUT_CLIENT_ID 
        AND payhead.payment_type_cd = 6  
        AND EXTRACT(MONTH FROM final_service_start_dt) = VS_PAYMENT_MONTH AND EXTRACT(YEAR FROM final_service_start_dt) = VS_PAYMENT_YEAR
       GROUP BY Paydet.client_id,payhead.payment_id,paydet.final_amount_no,payhead.payment_dt,
        payhead.payment_type_cd,payhead.provider_id,paydet.payment_detail_id,paydet.final_service_start_dt, paydet.final_service_end_dt,
        paydet.final_fiscal_category_cd
       ORDER BY payhead.payment_dt DESC);
   
    END IF;
  
    IF (OUT_FOSTERCARE_PAYMENT_AMT = NULL) THEN
     OUT_FOSTERCARE_PAYMENT_AMT = '0';
    END IF;
   
   END;

