      FROM (WITH cte as (
       SELECT distinct iscr.removaldate, coalesce(iscr.exitdate, iscr.returntime) as exitdate
        FROM intakeservreqchildremoval iscr  
         join person p on p.personid = iscr.personid 
          and p.activeflag = 1
         join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
          and rur.eventcode = 'CHRR'
          and rur.activeflag = 1
          and rur.routingstatustypeid = '16' 
       WHERE p.cjamspid IN (OUT_CLIENT_ID, VS_BIO_CLIENTID)
        AND iscr.removaldate <= vdt_to::date 
        AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
        AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
        and iscr.activeflag = 1
        order by iscr.removaldate desc
       )
       SELECT
        removaldate, exitdate, 
        LAG(exitdate,1) OVER () as prevreturndate
       FROM cte)
      WHERE CASE WHEN removaldate = prevreturndate THEN false else true end
       AND exitdate < OUT_LATEST_REMOVAL_DT::date
      ORDER by exitdate desc nulls last limit 1;
 
     ELSE
      SELECT exitdate as sdt
       INTO OUT_LAST_DISCHARGE_DT
      FROM (WITH cte as (
       SELECT distinct iscr.removaldate, coalesce(iscr.exitdate, iscr.returntime) as exitdate
         FROM intakeservreqchildremoval iscr  
        JOIN  person p ON p.personid = iscr.personid 
         and p.activeflag = 1
        join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
         and rur.eventcode = 'CHRR'
         and rur.activeflag = 1
         and rur.routingstatustypeid = '16' 
       WHERE p.cjamspid = OUT_CLIENT_ID
        AND iscr.removaldate <= vdt_to::date 
        AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
        AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
        and iscr.activeflag = 1
        order by iscr.removaldate asc
       )
       SELECT
        removaldate, exitdate, 
        LAG(exitdate,1) OVER () as prevreturndate
       FROM cte)
      WHERE CASE WHEN removaldate = prevreturndate THEN false else true end
       AND exitdate < OUT_LATEST_REMOVAL_DT::date
      ORDER by exitdate desc nulls last limit 1;
     END IF;
     
     VS_LAST_DISCHARGE_CT := 0;
     VS_LAST_DISCHARGE_DT1 := NULL;   
     
     IF (OUT_LAST_DISCHARGE_DT IS NOT NULL) THEN
      SELECT count(*), max(exitdate) 
       INTO VS_LAST_DISCHARGE_CT, VS_LAST_DISCHARGE_DT1
      FROM intakeservreqchildremoval iscr  
       join  person p on p.personid = iscr.personid 
        and p.activeflag = 1
       join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
        and rur.eventcode = 'CHRR'
        and rur.activeflag = 1
        and rur.routingstatustypeid = '16' 
      WHERE p.cjamspid = OUT_CLIENT_ID
       and iscr.activeflag = 1
       AND removaldate = OUT_LAST_DISCHARGE_DT::DATE
       AND exitdate is not null
       AND exitdate < OUT_LATEST_REMOVAL_DT::date;
     
      IF (VS_LAST_DISCHARGE_CT > 0 AND VS_LAST_DISCHARGE_DT1 IS NOT NULL) THEN
       OUT_LAST_DISCHARGE_DT = VS_LAST_DISCHARGE_DT1;
      END IF;
     END IF;
    ELSE
     OUT_LAST_DISCHARGE_DT := '';--
    END IF ;--
 
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
 
   END;--

   ---************* ELEMENT NO #20  *******************************   ENDS HERE


   --*******ELEMENT #NO # 24 *******  --NO # 24 Number of Previous Placement Settings During This Removal Episode? starts here   

   BEGIN 

    RAISE NOTICE 'Element #24 %', timeofday();
    
    VS_PL_PLACEMENTS := 0;
    VS_CPA_HOME_PLACEMENTS := 0;
    
    SELECT min(iscr.removaldate) INTO VS_LATEST_REMOVAL_DT1
    FROM intakeservreqchildremoval iscr  
     join person p on iscr.personid = p.personid and p.activeflag = 1 
     join routing rur on rur.objectid = iscr.intakeservreqchildremovalid::character varying
      and rur.eventcode = 'CHRR'
      and rur.activeflag = 1
      and rur.routingstatustypeid = '16'
    WHERE p.cjamspid = OUT_CLIENT_ID
     and iscr.activeflag = 1
     AND iscr.removaldate <= vdt_to::date 
     AND (iscr.exitdate IS NULL OR iscr.removaldate <> iscr.exitdate)
     AND (iscr.exitdate IS NULL OR (iscr.removaldate + interval '1 day') <> iscr.exitdate)
     -- AND (iscr.exitdate IS NULL OR iscr.exitdate::date >= vdt_from::date);
     AND ((CASE WHEN iscr.exitdate IS NOT NULL THEN iscr.exitdate::date >= vdt_from::date ELSE 
      (CASE WHEN iscr.returntransts IS NOT NULL AND iscr.returntransts != '1900-01-01' THEN iscr.returntransts::date >= vdt_from::date ELSE TRUE END)  END)
       OR
      (CASE WHEN iscr.returntransts IS NOT NULL AND iscr.returntransts != '1900-01-01' THEN iscr.returntransts::date >= vdt_from::date ELSE TRUE END));

    SELECT COUNT(*) INTO VS_PL_PLACEMENTS FROM (
    SELECT DISTINCT(placementid) FROM(
     SELECT DISTINCT placementid 
     FROM (WITH cte as (
       SELECT pl.placementid, pl.altproviderid, pl.startdatetime, pl.enddatetime
       FROM placement pl 
       JOIN person p on p.personid = pl.personid
       JOIN afcarsreference ar on ar.statepicklistvaluetypekey = pl.service_id::varchar
       WHERE p.cjamspid = OUT_CLIENT_ID
        AND pl.startdatetime <= vdt_to::date 
        and pl.activeflag = 1
        AND pl.startdatetime >= VS_LATEST_REMOVAL_DT1::date
        AND (pl.isvoided is null or pl.isvoided != 1) and pl.placementtypekey = 'PRPL'
        AND (pl.enddatetime IS NULL OR pl.startdatetime <> pl.enddatetime)
        AND ar.afcarsvaluetypekey != 1
        order by pl.startdatetime asc
       )
       SELECT
        placementid, altproviderid, startdatetime, enddatetime, 
        LAG(enddatetime,1) OVER (ORDER BY startdatetime) as previousenddatetime,
        LAG(altproviderid,1) OVER (ORDER BY startdatetime) as previousproviderid
       FROM cte)
     WHERE CASE WHEN (altproviderid = previousproviderid AND  (startdatetime = previousenddatetime OR startdatetime::date  = previousenddatetime::date + interval '1 day')) THEN false else true end
     UNION
     SELECT DISTINCT(placementid) 
      FROM(WITH cte as (
     SELECT DISTINCT pl.placementid, lv.livingarrangementtypekey, lv.livingstartdate, lv.livingenddate  
      from livingarrangement lv
      JOIN placement pl  ON pl.placementid = lv.placementid
      JOIN person p on p.personid = pl.personid AND p.activeflag=1    
      WHERE  p.cjamspid = OUT_CLIENT_ID
       AND pl.startdatetime <= vdt_to::date 
       and pl.activeflag = 1
       and lv.activeflag = 1
       AND pl.startdatetime >= VS_LATEST_REMOVAL_DT1::date
       AND (pl.isvoided is null or pl.isvoided != 1)
       AND CASE WHEN lv.livingenddate IS NOT NULL THEN 
         (lv.livingstartdate::date <> lv.livingenddate::date AND lv.livingenddate <= vdt_to::date)
        ELSE 
         TRUE 
        END 
       AND lv.livingarrangementtypekey NOT IN ('TVH','FH','OTH','UNK','COLG',
             'ICPC Foster Home (incoming)','Father''s Home','Mother''s Home',
             'Placement','BP','Halfway House') 
       AND CASE WHEN lv.livingarrangementtypekey IN ('IMCNA','IPC','SJD','REC','MD','RNW',
          'SUMC','MH','Inpatient Psychiatric Care','Inpatient Medical Care - Non-Acute','RFKH') 
        THEN 
         DATE_PART('day', coalesce(lv.livingenddate, now())::timestamp - lv.livingstartdate::timestamp) > 30
        ELSE 
         TRUE 
        END)
     SELECT placementid, livingarrangementtypekey, livingstartdate, livingenddate, 
       LAG(livingstartdate,1) OVER (ORDER BY livingstartdate) as previousstartdatetime,
       LAG(livingenddate,1) OVER (ORDER BY livingstartdate) as previousenddatetime,
       LAG(livingarrangementtypekey,1) OVER (ORDER BY livingstartdate) as previouskey
     FROM cte)
     WHERE CASE WHEN ((livingarrangementtypekey = previouskey AND  livingstartdate = previousenddatetime)  OR (livingstartdate::date = livingenddate::date) OR (livingstartdate::date = previousstartdatetime::date)) THEN false else true end)) 
    WHERE placementid NOT IN (
     SELECT DISTINCT pl.placementid 
      FROM TB_PLACEMENT_CPA_HOMES tpc 
       JOIN PLACEMENT pl ON pl.alternateid = tpc.placement_id 
       JOIN person p on p.personid = pl.personid
      WHERE p.cjamspid = OUT_CLIENT_ID
       AND pl.startdatetime <= vdt_to::date 
       and pl.activeflag = 1
       AND pl.startdatetime >= VS_LATEST_REMOVAL_DT1::date   
       AND (pl.isvoided is null or pl.isvoided != 1)
       AND pl.alternateid is not null AND pl.contractprogramid is not null 
       AND tpc.delete_sw = 'N'
       AND tpc.entry_dt <= vdt_to::DATE
       AND tpc.entry_dt >= VS_LATEST_REMOVAL_DT1::date);
   
      
    SELECT COUNT(*) INTO VS_CPA_HOME_PLACEMENTS
     FROM (WITH cte as (
     SELECT tpc.placement_cpa_home_id, tpc.placement_id, tpc.provider_id, tpc.entry_dt,tpc.exit_dt
      FROM TB_PLACEMENT_CPA_HOMES tpc 
      JOIN PLACEMENT pl ON pl.alternateid = tpc.placement_id 
      JOIN person p on p.personid = pl.personid
     WHERE p.cjamspid = OUT_CLIENT_ID
      AND pl.startdatetime <= vdt_to::date 
      and pl.activeflag = 1
      AND pl.startdatetime >= VS_LATEST_REMOVAL_DT1::date
      AND (pl.isvoided is null or pl.isvoided != 1)
      AND pl.alternateid is not null 
      AND pl.contractprogramid is not null 
      and (pl.isvoided is null or pl.isvoided != 1)
      and tpc.delete_sw = 'N'
      AND tpc.entry_dt <= vdt_to::DATE
      AND tpc.entry_dt >= VS_LATEST_REMOVAL_DT1::date
      AND (tpc.exit_dt IS NULL OR tpc.entry_dt::date <> tpc.exit_dt::date)
      ORDER BY tpc.entry_dt
     )
     SELECT provider_id, entry_dt,exit_dt,
      LAG(exit_dt,1) OVER (ORDER BY entry_dt) as previousexit_dt,
      LAG(provider_id,1) OVER (ORDER BY entry_dt) as previousproviderid
     FROM cte)
    WHERE CASE WHEN (provider_id = previousproviderid AND  (entry_dt = previousexit_dt OR entry_dt::date  = previousexit_dt::date + interval '1 day')) THEN false else true end;
 
    RAISE NOTICE 'VS_PL_PLACEMENTS: %', VS_PL_PLACEMENTS; 
    RAISE NOTICE 'VS_CPA_HOME_PLACEMENTS: %', VS_CPA_HOME_PLACEMENTS; 
    
    IF (VS_PL_PLACEMENTS = 0 AND VS_CPA_HOME_PLACEMENTS = 0) THEN
     OUT_NUM_PLACEMENTS = '00';
    ELSE  
     OUT_NUM_PLACEMENTS = VS_PL_PLACEMENTS + VS_CPA_HOME_PLACEMENTS; 
    END IF;
    
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
 

   END; 

   --*******ELEMENT #NO # 24  *******  --NO #  Number of Previous Placement Settings During This Removal Episode? ENDs here    
    
