      AND (PD.enddate IS NULL OR PD.enddate >= VDT_FROM::DATE);
   
  
    IF OUT_CHILD_DIAGNOSED_CD = '1' THEN 
 
     select  case when  COUNT(*) FILTER (WHERE PD.disabilitytypekey IN ('INDIS', 'MRD')) > 0 then '1' else  '0' end,
       case when  COUNT(*) FILTER (WHERE PD.disabilitytypekey IN ('VIDY', 'HDY')) > 0 then '1' else  '0' end,
