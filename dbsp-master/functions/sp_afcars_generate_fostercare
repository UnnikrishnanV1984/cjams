      case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%PI%') > 0 then '1' else '0' end,
      case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%UN%'   ) > 0 then '1' 
       when COUNT(*) FILTER (WHERE pr.racetypekey  like '%DC%' ) > 0 then '1' 
       else '0' 
      end
    INTO  OUT_RACE_AI_CD,
      OUT_RACE_ASIAN_CD,
      OUT_RACE_BLACK_CD,
      OUT_RACE_WHITE_CD,
      OUT_RACE_HAWAIIAN_CD,
      OUT_RACE_UN_CD
    FROM  personracetypemap  pr
    WHERE  pr.personid = ( select p.personid from person p where p.cjamspid=OUT_CLIENT_ID)
    AND pr.activeflag = 1;
  
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
