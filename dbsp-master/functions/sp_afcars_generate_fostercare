CREATE OR REPLACE FUNCTION sp_afcars_generate_fostercare(vdt_from character varying, vdt_to character varying, OUT vs_err_output_sqlcode integer)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------------------------------------------
-- Revision(s)
-- 03/15/2021 Vineet Tirodkar 
-- Modifications: 1)Use the exitdate column of intakeservreqchildremoval for Child Removal Return Date 
--                2)Consider approved removals only using routing table 
--      3)Changes to include clients turing 18 between the reporting period  
-- 03/31/2021 Vineet Tirodkar - Modifications for calculate Age for discharge using f_age (CIDM-2505)
-- 04/12/2021 Vineet Tirodkar - Modifications to change VS_END_DATE, VS_TPC_EXIT_DATE & VS_PERIOD_END_DT data types as VARCHAR(50) from VARCHAR (20) 
-- 04/19/2021 Vineet Tirodkar - Modifications to add active flag and Delete_sw columns in all missing queries.
-- 04/26/2021 Vineet Tirodkar - Modifications to the logic of ELEMENT #3 -- Local Agency (FIPS Code) 
------------------------------------------------------------------------------------------------------------
DECLARE
 SQLSTATE            CHARACTER(5)            DEFAULT '00000';
 SQLCODE                                             INTEGER DEFAULT 0;

 -- OUTPUT FIELDS
 OUT_PLACEMENT_ID             VARCHAR;
 OUT_CLIENT_ID           INTEGER DEFAULT 0;
 OUT_STATE_CD           VARCHAR(2)      DEFAULT     '24';
 OUT_USER_ID           VARCHAR(10)  DEFAULT     'INTERFACE';
 OUT_REPORT_PD_END_DT               VARCHAR(6);
 OUT_LOCAL_AGENCY_CD            VARCHAR(30);
 OUT_RECORD_NO               VARCHAR(12)  DEFAULT     '';
 OUT_PERIODIC_REVIEW_DT                  VARCHAR(20)   DEFAULT     NULL;
 OUT_CHILD_DOB                                VARCHAR(20)     DEFAULT     NULL;
 OUT_GENDER_CD                                VARCHAR(40);
 OUT_CHILD_DIAGNOSED_CD                           VARCHAR(1)      DEFAULT     '';
 OUT_MENTAL_RETARDATION_CD                          VARCHAR(1);
 OUT_VISUAL_HEARING_CD                           VARCHAR(1);
 OUT_PHYSICAL_DISABLED_CD                          VARCHAR(1);
 OUT_EMOTIONAL_DISTURBED_CD                          VARCHAR(1);
 OUT_OTHER_DIAGNOSED_CONDITION_CD                    VARCHAR(1);
 OUT_CHILD_ADOPTED_CD                           VARCHAR(1)      DEFAULT     NULL;
 OUT_AGE_ADOPTION_LEGALIZED                          VARCHAR(1)      DEFAULT     NULL;
 OUT_RACE_AI_CD                                VARCHAR(1)      DEFAULT        '0';
 OUT_RACE_ASIAN_CD                               VARCHAR(1)      DEFAULT        '0';
 OUT_RACE_BLACK_CD                               VARCHAR(1)      DEFAULT        '0';
 OUT_RACE_HAWAIIAN_CD                              VARCHAR(1)      DEFAULT        '0';
 OUT_RACE_WHITE_CD                               VARCHAR(1)      DEFAULT        '0';
 OUT_RACE_UN_CD                                VARCHAR(1)      DEFAULT        '0';
 OUT_HISPANIC_CD                            VARCHAR(30)     DEFAULT        '';
 OUT_FIRST_REMOVAL_DT                           VARCHAR(20);
 OUT_NUM_REMOVALS                               VARCHAR(5)      DEFAULT         NULL;
 OUT_LAST_DISCHARGE_DT                              VARCHAR(20)     DEFAULT         NULL;
 OUT_LATEST_REMOVAL_DT                           VARCHAR(20)  DEFAULT         NULL;
 OUT_REMOVAL_TRANSACTION_DT                          VARCHAR(20)  DEFAULT         NULL;
 OUT_PLACEMENT_DT                               VARCHAR(20)  DEFAULT         NULL;
 OUT_NUM_PLACEMENTS                               VARCHAR(2)      DEFAULT         ' '; 
 OUT_REMOVAL_TYPE_CD                           VARCHAR(30)  DEFAULT         NULL;
 OUT_PHYSICAL_ABUSE                            VARCHAR(1)      DEFAULT         '0';
 OUT_SEXUAL_ABUSE                               VARCHAR(1)      DEFAULT         '0';
 OUT_NEGLECT                                VARCHAR(1)      DEFAULT         '0';
 OUT_PAR_ALCOHOL_ABUSE                           VARCHAR(1)      DEFAULT         '0';
 OUT_PAR_DRUG_ABUSE                            VARCHAR(1)      DEFAULT         '0';
 OUT_CHILD_ALCOHOL_ABUSE                          VARCHAR(1)      DEFAULT         '0';
 OUT_CHILD_DRUG_ABUSE                           VARCHAR(1)      DEFAULT         '0';
 OUT_CHILD_DISABILITY                           VARCHAR(1)      DEFAULT         '0';
 OUT_CHILD_BEHAVIOR                            VARCHAR(1)      DEFAULT         '0';
 OUT_PARENT_DEATH                               VARCHAR(1)      DEFAULT         '0';
 OUT_PARENT_INCARCERATION                          VARCHAR(1)      DEFAULT         '0';
 OUT_CARETAKER_ILLNESS                           VARCHAR(1)      DEFAULT         '0';
 OUT_ABANDONMENT                               VARCHAR(1)      DEFAULT         '0';
 OUT_RELINQUISHMENT                            VARCHAR(1)      DEFAULT         '0';
 OUT_INADEQUATE_HOUSING                           VARCHAR(1)      DEFAULT         '0';
 OUT_PLACEMENT_SETTING_CD                          VARCHAR(1)      DEFAULT         NULL;
 OUT_PLACEMENT_STATE                        VARCHAR(10)     DEFAULT         NULL;
 OUT_CASE_PLAN_GOAL_CD                           VARCHAR(50)     DEFAULT         '7';
 OUT_CARETAKER1_BIRTH_YEAR                          VARCHAR(10);
 OUT_CARETAKER2_BIRTH_YEAR                          VARCHAR(10);
 OUT_MOTHER_TPR_DT                               VARCHAR(20);
 OUT_FATHER_TPR_DT                               VARCHAR(20);
 OUT_FOSTER_FAMILY_STRUCTURE_CD                      VARCHAR(50); --      DEFAULT      '0';

 --FOSTERCARE1
 OUT_FOSTERCARE1_BIRTH_YEAR                          VARCHAR(10);
 OUT_FOSTERCARE2_BIRTH_YEAR                          VARCHAR(10);
 OUT_FOSTERCARE1_RACE_AI_CD                          VARCHAR(1);
 OUT_FOSTERCARE1_RACE_ASIAN_CD                      VARCHAR(1);
 OUT_FOSTERCARE1_RACE_BLACK_CD                      VARCHAR(1);
 OUT_FOSTERCARE1_RACE_HAWAIIAN_CD                    VARCHAR(1);
 OUT_FOSTERCARE1_RACE_WHITE_CD                      VARCHAR(1);
 OUT_FOSTERCARE1_RACE_UN_CD                          VARCHAR(1);
 OUT_FOSTERCARE1_HISPANIC_CD                      VARCHAR(1)      DEFAULT        '0';

 --FOSTERCARE2
 OUT_FOSTERCARE2_RACE_AI_CD                          VARCHAR(1);
 OUT_FOSTERCARE2_RACE_ASIAN_CD                      VARCHAR(1);
 OUT_FOSTERCARE2_RACE_BLACK_CD                      VARCHAR(1);
 OUT_FOSTERCARE2_RACE_HAWAIIAN_CD                    VARCHAR(1);
 OUT_FOSTERCARE2_RACE_WHITE_CD                      VARCHAR(1);
 OUT_FOSTERCARE2_RACE_UN_CD                          VARCHAR(1);
 OUT_FOSTERCARE2_HISPANIC_CD                         VARCHAR(1)      DEFAULT   '0';

 OUT_DISCHARGE_DT                               VARCHAR(50);
 OUT_DISCHARGE_TRANSACTION_DT                      VARCHAR(50);
 OUT_DISCHARGE_REASON_CD                            VARCHAR(1)      DEFAULT     '0';
 OUT_IV_E_FOSTERCARE_SW                           VARCHAR(1)      DEFAULT     '0';
 OUT_IV_E_ADOPTION_SW                           VARCHAR(1)      DEFAULT     '0';
 OUT_IV_A_SW                                VARCHAR(1);
 OUT_IV_D_SW                                VARCHAR(1);
 OUT_XIX_SW                                    VARCHAR(1);
 OUT_SSI_OR_SSA_SW                               VARCHAR(1)      DEFAULT     '0';
 OUT_FOSTERCARE_PAYMENT_AMT                          VARCHAR(30)     DEFAULT     '00000';
 OUT_LAST_REMOVAL_ID                            BIGINT;
 OUT_CARETAKER_FAMILY_STRUCTURE_CD                   VARCHAR(1)      DEFAULT   '5';

 -- ERROR HANDLING FIELDS
 VS_ERR_OUTPUT_STATE                                 VARCHAR(5)         DEFAULT '00000';
 VS_ERR_EXCEP_MESSAGE         VARCHAR;
 VS_ERR_MESSAGE                             VARCHAR(1000);
 VS_ERR_EXCEP_FLAG                                   INTEGER   DEFAULT 0; 

 VS_YEAR            VARCHAR(10)  DEFAULT     NULL;
 VS_MONTH            VARCHAR(2)      DEFAULT     NULL;
 VS_DAY             VARCHAR(2)      DEFAULT     NULL;

 VS_LAST_DISCHARGE_DT1                              VARCHAR(20); 
 VS_FIRST_REMOVAL_DT1                           VARCHAR(20);
 VS_FIRST_REMOVAL_DT2                           VARCHAR(20);
 VS_LATEST_REMOVAL_DT1                           VARCHAR(20);
 VS_LATEST_REMOVAL_DT2                           VARCHAR(20);
 VS_REMOVAL_TRANSACTION_DT1                          VARCHAR(20);
 VS_PL_PLACEMENTS         INTEGER;
 VS_CPA_HOME_PLACEMENTS        INTEGER; 
 VS_NO_FEDERAL_SUPPORT_SW                          VARCHAR(1)      DEFAULT     '1';

 VS_CASE_ID            VARCHAR;
 VS_COUNT            INTEGER   DEFAULT 0;

 VS_LAST_REMOVAL_DT                               DATE;
 VS_RETURN_DT                                DATE;
 VS_ELEM_65_CNT          INTEGER   DEFAULT 0;
 VS_STAFF_ID           VARCHAR;
 VS_SERVICECASEID          VARCHAR;
 VS_PERMANENCYPLANTYPE         VARCHAR;
 VS_ALTPROVIDERID          INTEGER;
 VS_ALTPROVIDERID1         INTEGER;
 VS_ALTPROVIDERID2         INTEGER;
 VS_ALT_PROVIDERID         INTEGER;
 VS_APPROVAL_PERSONID        INTEGER;
 VS_FAMILY_STRUCTURE         VARCHAR;
 VS_PLCMNT_TYPE_KEY         VARCHAR;
 VS_NUM_REMOVALS1         INTEGER;
 VS_NUM_REMOVALS2         INTEGER;
 VS_MOTHER_PID          VARCHAR;
 VS_FATHER_PID          VARCHAR;
 VS_INTAKE_ACTOR_ID         VARCHAR;
 VS_CPA_PRVDR_ID          INTEGER;
 VS_COUNT1           INTEGER;
 VS_AGE            INTEGER;
 VS_IVE_STATUS          VARCHAR;
 VS_TEP_STRT_DT          DATE;
 VS_TEP_END_DATE          VARCHAR;
 VS_TEP_TRANS_DT          DATE;
 VS_LAST_DISCHARGE_CT        INTEGER;
 VS_REMOVAL_ID          VARCHAR(50);
 VS_END_DATE           VARCHAR(50); -- (20)
 VS_TPC_EXIT_DATE         VARCHAR(50); -- (20)
 VS_PERIOD_END_DT         VARCHAR(50); -- (20) 
 VS_PLACEMENT_ID          VARCHAR; 
 VS_PLACEMENT_ID2         VARCHAR; 
 VS_PRVDR_ID           VARCHAR; 
 VS_END_DATE_TIME         VARCHAR; 
 VS_PLACEMENT_KEY         VARCHAR;
 VS_BDAY_18           VARCHAR;
 VS_FLAG            INTEGER;
 VS_BIO_CLIENTID          INTEGER;
 VS_PAYMENT_MONTH         INTEGER;
 VS_PAYMENT_YEAR          INTEGER;
 VS_RECORD_COUNT          INTEGER;

------------------------------------------------------------------------------------------------------------
REM_CUR CURSOR FOR
 SELECT distinct cjamspid, 
  removaldate::DATE,
  exitdate::DATE, 
  removalid::BIGINT,
  placementid,
  servicecasenumber, 
  altproviderid FROM 
 (WITH cte as (
  SELECT  distinct p.cjamspid, 
   icr.removaldate::DATE,
   icr.exitdate::DATE, 
   icr.removalid::BIGINT,
   pl.placementid,
   sc.servicecasenumber, 
   pl.altproviderid
  FROM  intakeservreqchildremoval icr  
   join routing rur on rur.objectid = icr.intakeservreqchildremovalid::character varying
    and rur.eventcode = 'CHRR'
    and rur.activeflag = 1
    and rur.routingstatustypeid = '16'
   join serviceCASE sc on icr.servicecaseid = sc.servicecaseid 
    and icr.activeflag = 1
   left join placement pl on icr.intakeservreqchildremovalid = pl.intakeservreqchildremovalid 
    and pl.activeflag = 1
   join person p ON p.personid = icr.personid 
    and p.activeflag = 1
   -- join routing ru on ru.objectid = sc.servicecaseid::character varying -- and ru.eventcode='INVT'
   -- join userprofile up on up.securityusersid=ru.tosecurityusersid -- and up.activeflag=1
   -- join userprofileaddress upa on upa.securityusersid = up.securityusersid
   -- join tb_picklist_values tpvp on lower(replace(tpvp.value_tx,' ','')) = lower(replace(upa.county,' ',''))
  WHERE  ((icr.removaldate::DATE >=  vdt_from::date  AND icr.removaldate::DATE <= vdt_to ::DATE) OR
   ((nullif(icr.returntransts,'1900-01-01')::date >= vdt_from::date 
    OR nullif(icr.returntransts,'1900-01-01') is null) 
   and icr.removaltransts::date <= vdt_to::DATE) 
   AND (((icr.removaltime is null  or icr.returntime is null) 
     and coalesce(nullif(icr.returntransts,'1900-01-01')::date, vdt_to::DATE + interval '1 day' ) <> icr.removaltransts::date )
    or ( (icr.removaltime is not null and icr.returntime is not null)
     and
     ((((icr.exitdate::date - icr.removaldate::date ) * 24 )  - COALESCE(EXTRACT(hour from icr.removaltime),0)  + COALESCE(EXTRACT(hour from icr.returntime),0))  -  COALESCE(EXTRACT(minute from icr.removaltime),0) * 0.01   + COALESCE(EXTRACT(minute from icr.returntime),0)  * 0.01  -  COALESCE(EXTRACT(second from icr.removaltime),0) * 0.0001 + COALESCE(EXTRACT(second from icr.returntime),0) * 0.0001) >= 24
    )))
   AND (pl.placementid is null OR pl.placementid in (       
    select pl.placementid 
     from placement pl
    where pl.intakeservreqchildremovalid = icr.intakeservreqchildremovalid
     and ( pl.startdatetime::DATE <= vdt_to ::DATE)
     and pl.activeflag = 1
    order by pl.startdatetime 
    desc limit 1)
    )
    -- and tpvp.category_tx = '043'
    -- and tpvp.category_tx IN ('001','003','005','009','011','013','015','017','019','021','023','025','027','031','033') 
   -- AND ((DATE_PART('year', vdt_to::date) - DATE_PART('year', p.dob::date))::integer < 18)
   and ( f_age(p.dob::date) <= 18
     or
     (
     (p.dob::date + interval '18 years')::date >= vdt_from::date 
      and 
     (p.dob::date + interval '18 years')::date <= vdt_to::date
     )
    )
   -- Unit Testing 
   -- and p.cjamspid= 2107590   
    )
  SELECT cjamspid, removaldate, exitdate, removalid, placementid, servicecasenumber, altproviderid,
   LAG(cjamspid,1) OVER () as prevcjamspid
  FROM cte)
 WHERE CASE WHEN cjamspid = prevcjamspid THEN false else true end 
 UNION
 SELECT distinct cjamspid, 
  removaldate::DATE,
  exitdate::DATE, 
  removalid::BIGINT,
  placementid,
  servicecasenumber, 
  altproviderid FROM 
 (WITH cte as (
  SELECT  distinct p.cjamspid, 
   icr.removaldate::DATE,
   icr.exitdate::DATE, 
   icr.removalid::BIGINT,
   pl.placementid,
   sc.servicecasenumber, 
   pl.altproviderid
  FROM  intakeservreqchildremoval icr  
   join routing rur on rur.objectid = icr.intakeservreqchildremovalid::character varying
    and rur.eventcode = 'CHRR'
    and rur.activeflag = 1
    and rur.routingstatustypeid = '16'
   join serviceCASE sc on icr.serviceCASEid = sc.serviceCASEid 
    and icr.activeflag = 1
   left join placement pl on icr.intakeservreqchildremovalid = pl.intakeservreqchildremovalid 
    and pl.activeflag = 1
   join person p on p.personid = icr.personid 
    and p.activeflag = 1
   -- join routing ru on ru.objectid = sc.servicecaseid::character varying-- and ru.eventcode='INVT'
   -- join userprofile up on up.securityusersid = ru.tosecurityusersid -- and up.activeflag=1
   --- join userprofileaddress upa on upa.securityusersid = up.securityusersid
   -- join tb_picklist_values tpvp on lower(replace(tpvp.value_tx,' ','')) = lower(replace(upa.county,' ',''))
   join tb_client_eligibility tce on tce.client_id  = p.cjamspid 
    and tce.eligibility_type_cd = '2931' 
    and tce.removal_id = icr.removalid
    and tce.delete_sw = 'N'
   join tb_eligibility_period tep on tep.eligibility_id = tce.eligibility_id 
    and tep.delete_sw = 'N' 
    and trim(tep.status_cd) in ('2912','2913') 
  WHERE  ((icr.removaldate::DATE >=  vdt_from::date  AND icr.removaldate::DATE <= vdt_to ::DATE) OR
     ((nullif(icr.returntransts,'1900-01-01')::date >= vdt_from::date OR nullif(icr.returntransts,'1900-01-01') is null) and icr.removaltransts::date <= vdt_to::DATE) 
    AND 
    (((icr.removaltime is null  or icr.returntime is null) 
     and coalesce(nullif(icr.returntransts,'1900-01-01')::date, vdt_to::DATE + interval '1 day' ) <> icr.removaltransts::date )
    or ( (icr.removaltime is not null and icr.returntime is not null)
     and
     ((((icr.exitdate::date - icr.removaldate::date ) * 24 )  - COALESCE(EXTRACT(hour from icr.removaltime),0)  + COALESCE(EXTRACT(hour from icr.returntime),0))  -  COALESCE(EXTRACT(minute from icr.removaltime),0) * 0.01   + COALESCE(EXTRACT(minute from icr.returntime),0)  * 0.01  -  COALESCE(EXTRACT(second from icr.removaltime),0) * 0.0001 + COALESCE(EXTRACT(second from icr.returntime),0) * 0.0001) >= 24
    )))
    AND (pl.placementid is null OR pl.placementid in (       
     select pl.placementid 
      from placement pl
     where pl.intakeservreqchildremovalid = icr.intakeservreqchildremovalid
      and ( pl.startdatetime::DATE <= vdt_to ::DATE)
      and pl.activeflag = 1
     order by pl.startdatetime desc 
     limit 1)
     )
     -- and tpvp.category_tx = '043'  
     -- and tpvp.category_tx IN ('001','003','005','009','011','013','015','017','019','021','023','025','027','031','033') 
    AND ((DATE_PART('year', vdt_to::date) - DATE_PART('year', p.dob::date))::integer BETWEEN 18 AND 21)
    -- Unit Testing 
    -- and p.cjamspid= 2107590  
    )
  SELECT cjamspid, removaldate, exitdate, removalid, placementid, servicecasenumber, altproviderid,
   LAG(cjamspid,1) OVER () as prevcjamspid
  FROM cte)
 WHERE CASE WHEN cjamspid = prevcjamspid THEN false else true end;
BEGIN 

 VS_ERR_OUTPUT_SQLCODE:= 0 ; --

 RAISE NOTICE '>>>>>>>>>>>>>>>>Procedure Started>>>>>>>>>>>>>>>>>>>';

 VS_RECORD_COUNT := 0;

 SELECT  COUNT(*) INTO VS_COUNT FROM    afcarsfostercare_new ;  
 IF VS_COUNT > 0 THEN
  DELETE FROM afcarsfostercare_new;
 END IF; --  

 OPEN REM_CUR ;
 LOOP

  FETCH  REM_CUR INTO OUT_CLIENT_ID, VS_LAST_REMOVAL_DT, VS_RETURN_DT, OUT_LAST_REMOVAL_ID,
   OUT_PLACEMENT_ID, VS_CASE_ID,VS_ALTPROVIDERID;

  EXIT WHEN NOT FOUND;

  BEGIN
   VS_RECORD_COUNT := VS_RECORD_COUNT + 1;
   
   SELECT servicecaseid INTO VS_SERVICECASEID FROM servicecase WHERE servicecasenumber = VS_CASE_ID::VARCHAR; 
     
   RAISE NOTICE 'RECORD NUMBER;>>>>>>>>>>>>>>>>>>>>>>>>>>>>>%', VS_RECORD_COUNT;
   RAISE NOTICE 'VS_CASE_ID;>>>>>>>>>>>>>>>>>>>>>>>>>>>>>%', VS_CASE_ID;
   RAISE NOTICE 'VS_SERVICECASEID;>>>>>>>>>>>>>>>>>>>>>>>>%', VS_SERVICECASEID;
   RAISE NOTICE 'OUT_CLIENT_ID;>>>>>>>>>>>>>>>>>>>>>>>>>>>%', OUT_CLIENT_ID;
   RAISE NOTICE 'VS_ALTPROVIDERID;>>>>>>>>>>>>>>>>>>>>>>>>>>>%', VS_ALTPROVIDERID;
   RAISE NOTICE 'OUT_LAST_REMOVAL_ID;>>>>>>>>>>>>>>>>>>>>>%', OUT_LAST_REMOVAL_ID;
   RAISE NOTICE 'VS_LAST_REMOVAL_DT;>>>>>>>>>>>>>>>>>>>>>%', VS_LAST_REMOVAL_DT;               
   RAISE NOTICE 'VS_RETURN_DT;>>>>>>>>>>>>>>>>>>>>>>>>>>>%', VS_RETURN_DT; 
   

   EXCEPTION WHEN OTHERS THEN
    VS_ERR_OUTPUT_STATE := SQLSTATE;
    VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
    VS_ERR_EXCEP_FLAG := 1;

  END;

  IF  COALESCE(OUT_LAST_REMOVAL_ID,0)  > 0 THEN
    
   SELECT routing.tosecurityusersid into VS_STAFF_ID
    FROM  routing 
   WHERE ((routing.objectid = VS_SERVICECASEID ) ) 
    and routing.activeflag = 1 
    and routing.eventcode IN ('SRVC','INVT')
    and coalesce(routing.tosecurityusersid,'') != ''
   LIMIT 1;
   
   
   RAISE NOTICE 'VS_STAFF_ID;>>>>>>>>>>>>>>>>>>>>>>>>>>>>%', VS_STAFF_ID; 
 
   ---******* ELEMENT #2******* -- Reporting period Ending Date
   VS_YEAR := SUBSTRING(vdt_to,1,4);
   VS_MONTH := SUBSTRING(vdt_to,6,2);
   OUT_REPORT_PD_END_DT := LTRIM(VS_YEAR) ||  LTRIM(VS_MONTH);


   --*******ELEMENT #3*******  -- Local Agency (FIPS Code) Starts here     

   BEGIN
    RAISE NOTICE 'Element #03 %', timeofday();
    
    OUT_LOCAL_AGENCY_CD := NULL;
    
    --- Get for Child Assignment  
    select af.afcars_ref_cd 
     INTO OUT_LOCAL_AGENCY_CD 
    from caseassignment ca  
     join caseassignmentactor cr on cr.caseassignmentid = ca.caseassignmentid 
      and cr.activeflag  = 1
     join intakeservicerequestactor isr on isr.intakeservicerequestactorid  = cr.intakeservicerequestactorid 
      and isr.activeflag = 1
     join county c on c.countyid:: character varying = ca.toldssid::character varying
     JOIN afcars_ref_code af on (lower(trim(c.countyname)) = lower(trim(af.cjams_cd)) OR 
      lower(replace(c.countyname,' ','')) = lower(replace(af.cjams_cd,' ','')))
      and af.afcars_ref_type = 'County Code'   
    where ca.objectid::character varying = VS_SERVICECASEID::character varying
     and lower(ca.responsibilitytypekey) = 'child'
     and ca.activeflag = 1
     and ca.startdate <= vdt_to::date 
     and (ca.enddate >= vdt_from::date OR ca.enddate IS NULL) 
     and isr.personid = (select p.personid from person p where p.cjamspid = OUT_CLIENT_ID)
    order by ca.insertedon desc
    limit 1;

    
    IF OUT_LOCAL_AGENCY_CD is null OR btrim(OUT_LOCAL_AGENCY_CD) = '' THEN
     -- Get the Family Assignment
     select af.afcars_ref_cd 
      INTO OUT_LOCAL_AGENCY_CD 
     from caseassignment ca  
      join county c on c.countyid:: character varying = ca.toldssid::character varying
      JOIN afcars_ref_code af on (lower(trim(c.countyname)) = lower(trim(af.cjams_cd)) OR 
       lower(replace(c.countyname,' ','')) = lower(replace(af.cjams_cd,' ','')))
       and af.afcars_ref_type = 'County Code'
     where ca.objectid::character varying = VS_SERVICECASEID::character varying
      and lower(ca.responsibilitytypekey) = 'family'
      and ca.activeflag = 1
      and ca.startdate <= vdt_to::date 
      and (ca.enddate >= vdt_from::date OR ca.enddate IS NULL) 
     order by ca.insertedon desc
     limit 1;
    END IF;
    
    
    IF OUT_LOCAL_AGENCY_CD is null OR btrim(OUT_LOCAL_AGENCY_CD) = '' THEN
     -- Get most recent Family Assignment
     select af.afcars_ref_cd 
      INTO OUT_LOCAL_AGENCY_CD 
     from caseassignment ca  
      join county c on c.countyid:: character varying = ca.toldssid::character varying
      JOIN afcars_ref_code af on (lower(trim(c.countyname)) = lower(trim(af.cjams_cd)) OR 
       lower(replace(c.countyname,' ','')) = lower(replace(af.cjams_cd,' ','')))
       and af.afcars_ref_type = 'County Code'
     where ca.objectid::character varying = VS_SERVICECASEID::character varying
      and lower(ca.responsibilitytypekey) = 'family'
      and ca.activeflag = 1
     order by ca.insertedon desc
     limit 1;
    END IF;
  
    -- Old Logic
    /*
    SELECT  af.afcars_ref_cd  
     INTO OUT_LOCAL_AGENCY_CD 
    FROM userprofileaddress up 
     JOIN afcars_ref_code af on (lower(trim(up.county)) = lower(trim(af.cjams_cd)) OR 
      lower(replace(up.county,' ','')) = lower(replace(af.cjams_cd,' ','')))
      and af.afcars_ref_type = 'County Code'
     JOIN routing ru on ru.tosecurityusersid = up.securityusersid       
    WHERE ru.objectid = VS_SERVICECASEID 
     AND ru.eventcode IN ('SRVC', 'INVT') 
     and ru.activeflag = 1 
     AND up.activeflag = 1 
    LIMIT 1;
    */
    
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR OUT_LOCAL_AGENCY_CD #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
         
   END; 

   --*******ELEMENT #3*******  -- Local Agency (FIPS Code) ENDs here     

   --*******ELEMENT #4*******  --Record Number starts here   

   BEGIN
 
    RAISE NOTICE 'Element #04 %', timeofday();                      
    SELECT F_AFCARS_ENCRYPT(CAST(OUT_CLIENT_ID AS VARCHAR)) INTO OUT_RECORD_NO;
 
    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
          
   END; 

   --*******ELEMENT #4*******  --Record Number ENDs here 

   --*******ELEMENT #6,7,9,16*******  -- Date of Birth , Sex AND Hispanic starts here      
   BEGIN
  
    RAISE NOTICE 'Element #06, #07, #09, #16 %', timeofday();   
    SELECT 
     CASE WHEN p.dob IS NULL THEN 
     CONCAT(EXTRACT(year FROM CURRENT_DATE - '5 year'::interval),EXTRACT(month FROM CURRENT_DATE - '1 month'::interval),'15') 
     ELSE DATE(p.dob):: character varying 
     END,
     CASE  WHEN (p.gendertypekey IS not null and ( p.gendertypekey = 'M')) then '1' 
       WHEN (p.gendertypekey IS not null and ( p.gendertypekey = 'F')) THEN  '2'
       ELSE ''
     END   ,
     CASE 
      WHEN p.ethnicgrouptypekey = 'H' THEN '1'
      WHEN p.ethnicgrouptypekey = 'X' THEN '2'
      WHEN p.ethnicgrouptypekey = 'U' THEN '3'
      else ''
     END     ,
     CASE WHEN p.everbeenadoptedflag = 1 then '1'
       WHEN p.everbeenadoptedflag = 0 then '2'
       WHEN p.everbeenadoptedflag = 2 then '3'
      ELSE ''  
     END      
    INTO     
     OUT_CHILD_DOB,
     OUT_GENDER_CD,
     OUT_HISPANIC_CD,
     OUT_CHILD_ADOPTED_CD
    FROM person p
    LEFT JOIN gendertype gt ON gt.gendertypekey=p.gendertypekey AND gt.activeflag=1
    WHERE p.cjamspid=OUT_CLIENT_ID;  


    EXCEPTION WHEN OTHERS THEN
     VS_ERR_OUTPUT_STATE := SQLSTATE;
     VS_ERR_OUTPUT_SQLCODE :=SQLERRM;
     VS_ERR_MESSAGE := 'SQLSTATE:' || VS_ERR_OUTPUT_STATE || '. SELECT  FAILED FOR AS_RECORD_NO #152 FOR -->'|| CAST(OUT_CLIENT_ID AS VARCHAR) ;
     VS_ERR_EXCEP_FLAG := 1;
     VS_ERR_EXCEP_MESSAGE := CAST(VS_ERR_OUTPUT_SQLCODE AS VARCHAR)|| VS_ERR_OUTPUT_STATE ;
         
   END;

