   --*******ELEMENT #NO # 10,11,12,13,14,15*******  --NO # 10,11,12,13,14,15 starts here   
   BEGIN 
  
    RAISE NOTICE 'Element #10, #11, #12, #13, #14, #15 %', timeofday();
    select 
     case  when  COUNT(*) FILTER (WHERE PD.disabilityconditiontypekey like 'Yes') > 0 then '1'
