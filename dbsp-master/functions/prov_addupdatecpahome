CREATE OR REPLACE FUNCTION prov_addupdatecpahome(insertobj json)
 RETURNS TABLE(status text, v_new_provider_id character varying)
 LANGUAGE plpgsql
AS $function$

declare

v_securityuserid character varying; 
v_new_provider_id CHARACTER VARYING;

v_response  CHARACTER VARYING;
v_cpa_home_id character VARYING;
genr_num character varying;
v_seq character varying;
v_existing_provider_id character varying;
v_cpa_type    character varying;
v_cpa_type_id    character varying;
 

begin

   

v_securityuserid := insertobj->>'securityuserid';
v_existing_provider_id := insertobj->>'existing_provider_id';
v_cpa_type :=  insertobj->>'cpa_type';
v_cpa_type_id :=  insertobj->>'cpa_type_id';


if v_existing_provider_id is null  then
            v_seq:='tb_provider_providerid_seq';
            select * from getnextsequencenumber(v_seq) into v_new_provider_id;

            INSERT INTO tb_provider
            (provider_id,provider_nm, provider_first_nm, provider_last_nm, affiliate_provider_id,agency, tax_id_no, provider_category_cd, provider_status_cd, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
            values(v_new_provider_id::int4,(insertobj->>'provider_nm'),(insertobj->>'provider_first_nm'),(insertobj->>'provider_last_nm'),(insertobj->>'parent_provider_id')::int4,null,null,1782,1795,now(),v_securityuserid,now(),v_securityuserid,'N');

            INSERT INTO tb_provider_picklist (provider_id, program_id,picklist_type_id,picklist_value_cd, value_desc, create_ts,create_user_id,update_ts,update_user_id)
            VALUES(v_new_provider_id::int4, null, 155, 1782, 'CPA Home',    
            now(), v_securityuserid,now(), v_securityuserid);  

            INSERT INTO cpastatusmanagement
            (cpa_status_management_id, object_id,  cpa_status, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
            VALUES(gen_random_uuid(), v_new_provider_id,  'Created', now(), v_securityuserid, now(), v_securityuserid, 'N');
            

else 
            update tb_provider 
            set provider_first_nm = (insertobj->>'provider_first_nm'),
            provider_last_nm = (insertobj->>'provider_last_nm'),
            provider_nm = (insertobj->>'provider_nm'),
            update_user_id = v_securityuserid,
            update_ts = now()
            where provider_id = v_existing_provider_id::int4;

            v_new_provider_id := v_existing_provider_id;
            
            

end if;

UPDATE tb_provider_picklist 
set delete_sw = 'Y',
update_ts = now(),
update_user_id = v_securityuserid
where provider_id = v_new_provider_id::int4
and picklist_type_id = 455;

INSERT INTO tb_provider_picklist (provider_id, program_id,picklist_type_id,picklist_value_cd, value_desc, create_ts,create_user_id,update_ts,update_user_id)
VALUES(v_new_provider_id::int4, null, 455, v_cpa_type_id, v_cpa_type,    
now(), v_securityuserid,now(), v_securityuserid);  
                                                                                                                                                                                                                                                                                                                                             

                                                                                             
if v_cpa_type_id = 101 then                

      select provider_cpa_adop_person_id into v_cpa_home_id from tb_prov_cpa_adop_person where provider_id = v_new_provider_id::int4 and person_type_cd = 3610;
      if v_cpa_home_id is null then 
            INSERT INTO tb_prov_cpa_adop_person(person_type_cd,first_nm,last_nm,create_ts,create_user_id,
            update_ts,update_user_id,delete_sw,provider_id)                                                                                                                                         
            values( 3610 , (insertobj->>'provider_first_nm'),(insertobj->>'provider_last_nm'),
            now(),v_securityuserid, now(), v_securityuserid,'N', v_new_provider_id::int4 ); 
      else 
            update tb_prov_cpa_adop_person
            set 
            first_nm = (insertobj->>'provider_first_nm'),
            last_nm = (insertobj->>'provider_last_nm'),
            update_user_id = v_securityuserid,
            update_ts = now()
            where provider_id = v_new_provider_id::int4 and 
            person_type_cd = 3610;
      end if;
      v_cpa_home_id = null;
      select provider_cpa_adop_person_id into v_cpa_home_id from tb_prov_cpa_adop_person where provider_id = v_new_provider_id::int4 and person_type_cd = 3611;
      if v_cpa_home_id is null then 
            if (insertobj->>'co_first_nm') is not null or (insertobj->>'co_first_nm') is not null then 
                  INSERT INTO tb_prov_cpa_adop_person(person_type_cd,first_nm,last_nm,create_ts,create_user_id,
                  update_ts,update_user_id,delete_sw,provider_id)                                                                                                                                         
                  values( 3611 , (insertobj->>'co_first_nm'),(insertobj->>'co_last_nm'),
                  now(),v_securityuserid, now(), v_securityuserid,'N', v_new_provider_id::int4 ); 
            end if;
      else 
      
            if (insertobj->>'co_first_nm') is not null or (insertobj->>'co_first_nm') is not null then 
                  update tb_prov_cpa_adop_person
                  set
                  first_nm = (insertobj->>'co_first_nm'),
                  last_nm = (insertobj->>'co_last_nm'),
                  update_user_id = v_securityuserid,
                  update_ts = now()
                  where provider_id = v_new_provider_id::int4 and 
                  person_type_cd = 3611;
            end if;

      end if;

end if;



v_response:= 'Success';

   return query
select v_response::text,v_new_provider_id::CHARACTER VARYING;



    
end;
    
$function$

