CREATE OR REPLACE FUNCTION listdsdsactioninpersonpopup_test(v_personid uuid, v_intakeserviceid uuid)
 RETURNS TABLE(danumber character varying, description character varying, firstname character varying, lastname character varying, role character varying, datereceived timestamp without time zone, datecompleted timestamp without time zone, status character varying, datype character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
RETURN QUERY 

select distinct
ISR.ServiceRequestNumber as DANumber,
SRST.description as dasubtype,
PRS.FirstName,
PRS.LastName,
ISRA.intakeservicerequestpersontypekey as Role,
ISR.Reporteddate as DateReceived,
case when ISRST.intakeserreqstatustypekey = 'Closed' then ATMSR.updatedon else null end AS DateCompleted,
ISRST.intakeserreqstatustypekey AS Status,
ISRT.description as datype
 from IntakeServiceRequest ISR join
IntakeSerReqStatusType ISRST ON ISR.IntakeSerReqStatusTypeId = ISRST.IntakeSerReqStatusTypeId
LEFT JOIN IntakeServiceRequestInputType ISRIT on ISRIT.IntakeServReqInputTypeId = ISR.IntakeSerReqStatusTypeId
LEFT JOIN  IntakeServiceRequestType ISRT ON ISRT.IntakeServReqTypeId = ISR.IntakeServReqTypeId
LEFT JOIN  Priority PR ON PR.PriorityId = ISR.PriorityId 
JOIN  ServiceRequestSubType SRST ON SRST.ServiceRequestSubTypeId = ISR.IntakeServiceRequestClassId
LEFT JOIN  IntakeServiceRequestActor ISRA ON ISRA.IntakeServiceId = ISR.IntakeServiceId 
LEFT JOIN  Actor AC ON ISRA.ActorId = AC.ActorId
LEFT JOIN  Person PRS ON AC.PersonId = PRS.PersonId
LEFT JOIN  PersonAddress PRA ON PRS.PersonId = PRA.PersonId
LEFT JOIN  IntakeServiceRequestClearingData ISRCD ON ISRCD.IntakeServiceId = ISR.IntakeServiceId
LEFT JOIN  AreaTeamMemberServiceRequest ATMSR ON ATMSR.IntakeServiceId = ISR.IntakeServiceId
where PRS.PersonId = v_personid
AND ISR.IntakeServiceId <> v_intakeserviceid;
END;
$function$

