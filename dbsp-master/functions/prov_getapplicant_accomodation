CREATE OR REPLACE FUNCTION prov_getapplicant_accomodation(siteid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 
declare
v_licenseinfo json;
v_applicationid character varying; 
begin

select applicant_id into v_applicationid from tb_provider_applicant pa where pa.site_id = siteid and pa.application_status='Pending' and pa.application_type='LICENSEUPDATE';

select row_to_json(t)
from (
    select tpaa.* from tb_prov_applicant_accomodation tpaa where tpaa.provider_applicant_id=v_applicationid
) t into v_licenseinfo;

return v_licenseinfo;
 
end;
$function$

