CREATE OR REPLACE FUNCTION deletesplanaction(v_actionid character varying, v_userid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_message character varying;
    
BEGIN

 UPDATE serviceplanaction 
 SET activeflag = 0, updatedon = now(), updatedby = v_userid
 WHERE 
 serviceplanactionid::CHARACTER VARYING = v_actionid AND activeflag = 1;

 UPDATE serviceplanpersoninvolved
 SET activeflag = 0, updatedon = now(), updatedby = v_userid
 WHERE
 serviceplanactionid::CHARACTER VARYING = v_actionid AND activeflag = 1;

 v_message:= 'Success';

    return v_message;
END  
$function$

