CREATE OR REPLACE FUNCTION createmappingrecord(v_objectid character varying, v_casenumber character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare
  l_cisrefid character varying;
  v_uuidornot character varying(50);
BEGIN 
   SELECT * into v_uuidornot from uuid_or_null(v_objectid);
 --  IF EXISTS (SELECT * FROM cjamscisref WHERE casenumber=v_casenumber or (CASE WHEN v_uuidornot IS NULL THEN NULL ELSE objectid = v_objectid::uuid END )) then
      select cisrefid into l_cisrefid from cjamscisref WHERE casenumber=v_casenumber or (CASE WHEN v_uuidornot IS NULL THEN NULL ELSE objectid = v_objectid::uuid END);
   IF l_cisrefid IS NOT NULL THEN  
      RAISE NOTICE 'Iam exi (%)', l_cisrefid;
   ELSE 
     INSERT INTO cjamscisref (casenumber,objectid)
     VALUES(v_casenumber,v_objectid::uuid)
     returning "cisrefid"::character varying  INTO l_cisrefid; 
     RAISE NOTICE 'Iam not (%)', l_cisrefid;
      END IF;
      return  l_cisrefid;
END;
$function$

