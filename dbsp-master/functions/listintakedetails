 left join routing r on r.objectid = IDAS.intakenumber and (r.activeflag = 1 or r.activeflag = v_activeflag) and r.eventcode in ('INTR', 'KINR')\r
 left join routingstatustype RTs on RTs.sequencenumber = r.routingstatustypeid and rts.activeflag = 1\r
 left join teammemberroletype rt on rt.roletypekey = r.toroleid and rt.activeflag = 1\r
 left join userprofile up on up.securityusersid = IDAS.CRUWorkerName\r
 left join intakeservicerequest ISR on ISR.intakenumber = IDAS.intakenumber and ISR.activeflag = 1\r
/*  left join (\r
  select ia.intakenumber, count(1) casecount\r
  from intakedastatus ia, json_array_elements((ia.jsondata::json)->'persons') personjson\r
  inner join ( select distinct personid from intakeservicerequestactor where activeflag = 1 ) isra on isra.personid::character varying = personjson ->>'Pid'\r
  where coalesce(personjson ->>'Pid', null) is not null\r
  group by ia.intakenumber \r
 ) priors on priors.intakenumber = ITDS.intakenumber */\r
 where\r
 IDAS.IntakeNumber like intakeno || '%'\r
 and\r
 (case\r
  v_status\r
  when 1 then lower(IDAS.Status) = 'pending'\r
  else r.routingstatustypeid = v_status\r
 end\r
 or\r
 case\r
  IDAS.intakeuser\r
  when v_UserSID then r.routingstatustypeid = 6\r
  else r.routingstatustypeid = v_status\r
 end )\r
 and IDAS.Activeflag = 1\r
    and coalesce(IDAS.ispreintake, false) = false -- removing this created a new issue, approved intakes started showing up as pending review, adding it back\r
 -- and coalesce(IDAS.ispreintake, false) = false ; Not required as per Debashish\r
 and (  case v_statustext when 'pending'  then ITDS.InsertedBy = v_UserSID \r
   else coalesce(r.tosecurityusersid, IDAS.intakeuser) = v_UserSID\r
   or (\r
   case right(fromroleid, 2)\r
    when 'IW' then IDAS.InsertedBy = v_UserSID\r
    when 'KW' then IDAS.InsertedBy = v_UserSID\r
    when 'CW' then IDAS.InsertedBy = v_UserSID\r
    else r.tosecurityusersid = v_UserSID\r
   end )\r
  end ) \r
 AND  CASE  WHEN  coalesce(lower(v_statustext),'') = 'pendingreview'  THEN  (coalesce(rts.typedescription,'') != '')  ELSE  TRUE  END\r
 order by\r
  (\r
  case\r
   sortorder\r
   when 'asc' then\r
   case\r
    sortcolumn\r
    when 'receiveddate' then cast( IDAS.TimeRecieved as character varying)\r
    when 'updateddate' then cast( IDAS.updatedon as character varying)\r
    when 'submittedworker' then cast(up.firstname || ' ' || up.lastname as character varying)\r
    when 'intakenumber' then IDAS.intakenumber\r
    else cast(IDAS.id as character varying)\r
   end\r
   else cast( IDAS.EntityName as character varying)\r
  end) asc,\r
  (\r
  case\r
   sortorder\r
   when 'desc' then\r
   case\r
    sortcolumn\r
    when 'receiveddate' then cast( IDAS.TimeRecieved as character varying)\r
    when 'updateddate' then cast( IDAS.updatedon as character varying)\r
    when 'submittedworker' then cast(up.firstname || ' ' || up.lastname as character varying)\r
    when 'intakenumber' then IDAS.intakenumber\r
    else cast(IDAS.id as character varying)\r
   end\r
   else cast( IDAS.EntityName as character varying)\r
  end ) desc )\r
 \r
union all (\r
select IDAS.old_id as intakechessieid,\r
 1,\r
 IDAS.IntakeNumber ,\r
 cast(case ITDS.iscps when true then 'CPS' when false then 'Non  CPS' else '' end as character varying),\r
 IDAS.reporteddate,\r
 (to_char( IDAS.reportedtime::timestamp without time zone, 'YYYYMMDD"T"HH24MISS"Z"' )::timestamptz)::timestamp without time zone,\r
 IDAS.Narrative,\r
 --cast(  TRIM(PN.lastname)||  ','  ||TRIM(PN.firstname)  as    character  varying)  raname :: character varying,\r
 coalesce(IDAS.title, '') :: character varying RAName,\r
 cast('' as character varying) EntityName,\r
 cast(up.firstname || ' ' || up.lastname as character varying) ,\r
 coalesce(r.isreviewrequest, false),\r
 coalesce(rt.isupervisor, false) ,\r
 r.insertedon,\r
 r.updatedon ,\r
 r.remarks,\r
 cast(case lower(coalesce(rts.typedescription, 'Pending')) when 'pending' then case ITDS.status when 10 then 'Assigned' else 'Draft' end else case when tosecurityusersid = intakeuser and r.routingstatustypeid = 1 then 'Reopen' else rts.typedescription end end as character varying) ,\r
 cast('' as character varying) dispositiondescription,\r
 cast('' as character varying) statusdescription,\r
 cast( case r.insertedon when null then '' else case when age( now() at time zone 'utc') - age(r.insertedon + time '02:00' ) > '0:00' then cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) else cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) end end as character varying),\r
 null::jsonb ,\r
 IDAS.updatedon ,\r
 ITDS.teamtypekey ,\r
 0,\r
 ITDS.ispreintake,\r
 (\r
 select\r
  ''::character varying) as clwstatus,\r
 (\r
 select\r
  json_agg(e) as fatality\r
 from\r
  (\r
  select\r
   isrs.ischildfatality,\r
   isrs.ismaltreatment\r
  from\r
   intakeservicerequestsdm isrs\r
  where\r
   isrs.intakenumber = IDAS.IntakeNumber\r
   and activeflag = 1 ) as e) ::json,\r
 0 isprior,\r
 (SELECT json_agg(x) as headofhousehlod FROM ( \r
        SELECT distinct concat_ws(' ',coalesce(p.firstname,null),coalesce(p.middlename,null),coalesce(p.lastname,null),coalesce(p.suffix,null) ):: character varying as personname\r
  FROM  intakeservicerequestactor ISRA  \r
  INNER JOIN person p on p.personid = ISRA.personid AND  p.activeflag =1 \r
  INNER JOIN actor A ON A.actorid = ISRA.actorid AND A.activeflag =1 \r
  WHERE    ISRA.activeflag =1  \r
  AND ISRA.intakeservicerequestpersontypekey <> 'CHILD' AND ISRA.isheadofhousehold = true\r
  AND ISRA.intakenumber = IDAS.IntakeNumber\r
  ORDER BY 1 ) as x):: json,\r
 (\r
 select\r
  getcasepersonname\r
 from\r
  getcasepersonname ('intake',\r
  IDAS.IntakeNumber:: character varying)),\r
  (\r
  SELECT cast(INITCAP(TRIM(coalesce(PN.lastname,''))|| CASE WHEN PN.suffix is not null THEN ' ' ELSE '' END  || TRIM(coalesce(PN.suffix,'')) || ', ' ||TRIM(coalesce(PN.firstname,''))) as  character varying)\r
  FROM intakeservicerequestactor isra, person PN WHERE PN.personid = isra.personid AND isra.intakeserviceid = IDAS.intakeserviceid LIMIT 1\r
 )  as youthname,\r
 ( SELECT\r
   cast(concat(initcap(persons ->> 'Lastname'), coalesce(' ' ||(persons ->> 'suffix'), ''), ', ', initcap(persons ->> 'Firstname'))as character varying)\r
  from\r
   jsonb_array_elements( ITDS.jsondata -> 'persons') persons ,\r
   jsonb_array_elements(persons -> 'personRole') persl\r
  where\r
   persl ->>'rolekey' = 'Victim' limit 1 \r
 ) as victimname,\r
 ''::CHARACTER VARYING as DJSyouthname,\r
 (\r
  SELECT PN.firstname\r
  FROM intakeservicerequestactor isra, person PN WHERE PN.personid = isra.personid AND isra.intakeserviceid = IDAS.intakeserviceid LIMIT 1\r
 )  as youthfirstname,\r
 (\r
  SELECT PN.lastname\r
  FROM intakeservicerequestactor isra, person PN WHERE PN.personid = isra.personid AND isra.intakeserviceid = IDAS.intakeserviceid LIMIT 1\r
 )  as youthlastname,\r
 (\r
  SELECT PN.suffix\r
  FROM intakeservicerequestactor isra, person PN WHERE PN.personid = isra.personid AND isra.intakeserviceid = IDAS.intakeserviceid LIMIT 1\r
 )  as youth_suffix,\r
 (\r
  SELECT PN.cjamspid\r
  FROM intakeservicerequestactor isra, person PN WHERE PN.personid = isra.personid AND isra.intakeserviceid = IDAS.intakeserviceid LIMIT 1\r
 )  as cjamspid\r
from intakeservicerequest IDAS\r
inner join intakeDAStatus ITDS on ITDS.intakenumber = IDAS.intakenumber AND ITDS.activeflag =1 and ITDS.teamtypekey = 'CW'\r
inner join routing r on r.objectid = IDAS.intakenumber and r.activeflag = 1 and r.eventcode in ('INTR', 'KINR')\r
inner join routingstatustype RTs on RTs.sequencenumber = r.routingstatustypeid and rts.activeflag = 1\r
inner join teammemberroletype rt on rt.roletypekey = r.toroleid and rt.activeflag = 1\r
inner join userprofile up on up.securityusersid = ITDS.intakeuser\r
where IDAS.IntakeNumber like intakeno || '%'\r
 and (case\r
  v_status\r
  when 1 then coalesce (ITDS.Status, 0)in (0, 1 )\r
  else r.routingstatustypeid = v_status end)\r
 and IDAS.Activeflag = 1\r
 and coalesce(ITDS.ispreintake, false) = false\r
 and (ITDS.InsertedBy = v_UserSID or r.tosecurityusersid = v_UserSID or ITDS.intakeuser = v_UserSID) \r
 and NOT EXISTS(\r
    select IDS.intakenumber from intakedastaging IDS where IDS.intakenumber = IDAS.IntakeNumber\r
   ) \r
  AND  CASE  WHEN  coalesce(lower(v_statustext),'') = 'pendingreview'  THEN  (coalesce(rts.typedescription,'') != '')  ELSE  TRUE  END\r
order by\r
 (\r
 case\r
  sortorder\r
  when 'asc' then\r
  case\r
   sortcolumn\r
   when 'receiveddate' then cast( IDAS.reportedtime as character varying)\r
   when 'updateddate' then cast( IDAS.updatedon as character varying)\r
   when 'submittedworker' then cast(up.firstname || ' ' || up.lastname as character varying)\r
   when 'intakenumber' then IDAS.intakenumber\r
   else cast(IDAS.servicerequestnumber as character varying)\r
  end\r
  else cast( IDAS.reportedarea as character varying)\r
 end) asc,\r
 (\r
 case\r
  sortorder\r
  when 'desc' then\r
  case\r
   sortcolumn\r
   when 'receiveddate' then cast( IDAS.reportedtime as character varying)\r
   when 'updateddate' then cast( IDAS.updatedon as character varying)\r
   when 'submittedworker' then cast(up.firstname || ' ' || up.lastname as character varying)\r
   when 'intakenumber' then IDAS.intakenumber\r
   else cast(IDAS.servicerequestnumber as character varying)\r
  end\r
  else cast( IDAS.reportedarea as character varying)\r
 end ) desc) ) t\r
limit pagesize offset v_pageoffset ;\r
end if;\r
end if;\r
end;\r
