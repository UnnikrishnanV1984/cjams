CREATE OR REPLACE FUNCTION as_updateisclwdastatus(v_intakeserviceid uuid, v_dispositioncodeid uuid, v_clwstatus character varying, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE v_intakenumber character varying;
v_dispostioncode text;
l_versionNumber bigint;
 BEGIN
 

  select ISR.intakenumber into v_intakenumber from IntakeserviceRequest AS ISR 
  where ISR.intakeserviceid = v_intakeserviceid and activeflag = 1;
 
  select SRTCDC.dispositioncode  into  v_dispostioncode FROM 
  ServiceRequestTypeConfigDispositionCode as SRTCDC 
  JOIN DispositionCode as DC
  ON DC.dispositioncode = SRTCDC.dispositioncode  and DC.activeflag = 1 
  WHERE SRTCDC.activeflag = 1 and DC.activeflag = 1 and
  SRTCDC.servicerequesttypeconfigiddispostionid  = v_dispositioncodeid;
      
 IF (v_dispostioncode ='FPTSAO' or v_dispostioncode ='sendcourt' ) THEN
     
  update intakedastaging set activeflag =0 WHERE  intakenumber =v_intakenumber and activeflag=1;
 
     SELECT MAX(versionnumber) into l_versionNumber FROM intakedastaging as i where i.intakenumber = v_intakenumber;

     INSERT INTO intakedastaging
        (intakenumber, daterecieved, narrative, raname,entityname,cruworkername,data,insertedon,insertedby,  updatedon,status,jsondata,activeflag,versionnumber,timerecieved,dispositiondescription,statusdescription,
     intakeuser,ispreintake,isclw,focuspersonid
     )
  
     select intakenumber, daterecieved, narrative, raname, entityname, cruworkername,data,now(),
     v_securityuserid,now(),status,jsondata,1,coalesce(l_versionNumber,0)+1,now(),dispositiondescription,statusdescription,intakeuser,ispreintake,isclw,focuspersonid
     from  intakedastaging where intakenumber = v_intakenumber order by insertedon desc limit 1;
 
     --update intakedastatus set clwstatus = v_clwstatus  WHERE  intakenumber =v_intakenumber and activeflag=1;
  update intakeservicerequestevaluation set complaintstatustypekey = v_clwstatus where intakenumber = v_intakenumber and activeflag=1 and lower(complaintstatustypekey) = 'cas';
 
  END IF;

return 'sucess';
                          
END

$function$

