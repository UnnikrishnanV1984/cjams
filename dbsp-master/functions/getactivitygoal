CREATE OR REPLACE FUNCTION getactivitygoal(investigationid uuid, activitiesid character varying, goalid character varying, pageno integer, pagesize integer)
 RETURNS TABLE(totalcount bigint, activityid uuid, activitygoalid uuid, goal character varying, activityname text, goaltype character varying, duedate timestamp without time zone, completiondate timestamp without time zone, required boolean, dispositionstatus character varying, goalstatus character varying, activitygoalstatustypekey character varying, activitygoaldispositiontypekey character varying, activitygoaltypekey character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN
 if activitiesid ='null' then
    activitiesid:=null;
    end if;
 
if goalid ='null' then
goalid:=null;
end if;
 

RETURN QUERY  

select 
 count(1) OVER() totalcount,a.activityid,
 ag.activitygoalid, ag.name as goal,a.description, agt.typedescription goaltype,  ag.duedate,
 ag.completiondate, ag.required, agdt.typedescription as dispositionstatus, AGS.typedescription as goalstatus ,
 AG.activitygoalstatustypekey,ag.activitygoaldispositiontypeKey, ag.ActivityGoalTypeKey
from ActivityGoal AG  
inner join activity a on a.activityid = ag.activityid  and a.activeflag =1
 inner join activitygoalstatustype AGS on AGS.activitygoalstatustypekey = AG.activitygoalstatustypekey
inner join activitygoaltype agt on agt.ActivityGoalTypeKey = ag.ActivityGoalTypeKey
left join activitygoaldispositiontype agdt on agdt.activitygoaldispositiontypeKey = ag.activitygoaldispositiontypeKey
  where ag.activeflag =1    
   and a.objectid =investigationid
and (activitiesid is null or cast(AG.activityid as character varying) =activitiesid)
and (goalid is null or cast(AG.activitygoalid as character varying) =goalid)
limit pagesize  offset pageno ;
END;

$function$

