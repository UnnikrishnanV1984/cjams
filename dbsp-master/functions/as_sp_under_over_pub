          vdc_csrfc_current_balance,
          vdc_csrfcd_current_balance,
          al_sqlcode,
          as_error;--
   
      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Placement ID';--
        vs_identity_val := TO_CHAR(vl_placement_id,'9999999');--
        as_error := as_error || ' (SP-5JC)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_CSRB_GET_CURRENT_BALANCE failed for County Specific. (SP-5JC)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--
   
      IF vl_linked_pymnt_hdr_id = 0 THEN
        vl_linked_pymnt_hdr_id := NULL;--
        vl_reference_payment_detail_id := NULL;--
      END IF;--
      --- CHECK CURRENT BALANCE - END   
   
      -- TAKE FIRST ADJUSTMENT ID - START
       vl_adjust_payment_id := 0; -- INITIAL VALUE

      SELECT MIN(PH.PAYMENT_ID)
       INTO vl_adjust_payment_id
      FROM TB_PAYMENT_HEADER PH,
        TB_PAYMENT_DETAIL PD
      WHERE  PH.PAYMENT_ID = PD.PAYMENT_ID
       AND PH.PROVIDER_ID = vl_provider_id
       AND PH.PAYMENT_DT = CURRENT_DATE
       AND PH.PAYMENT_TYPE_CD = '3294'
       AND PD.PLACEMENT_ID IS NOT NULL
       AND PH.MANUAL_SW = 'N'
       AND PH.DELETE_SW = 'N'
       AND PD.DELETE_SW = 'N'
       /*AND MONTH(PH.PAYMENT_START_DT) = MONTH(vd_placement_validation_start)
       AND YEAR(PH.PAYMENT_START_DT) = YEAR(vd_placement_validation_start)*/
       AND date_part('month', PH.PAYMENT_START_DT) = date_part('month', vd_placement_validation_start) 
             AND date_part('YEAR', PH.PAYMENT_START_DT)  = date_part('YEAR', vd_placement_validation_start)--
       AND PD.COUNTY_CD =  vs_county_cd
       AND PD.CLIENT_ID = vl_client_id ;--

      IF vl_adjust_payment_id IS NULL THEN
        vl_adjust_payment_id := 0; --
      END IF;--
      -- TAKE FIRST ADJUSTMENT ID - END

      -- SET REFERNCE PAYMENT ID FOR PAYABLE - START
       vl_payment_id := 0; -- INITIAL VALUE
      IF vl_adjust_payment_id > 0 THEN
        vl_payment_id := vl_adjust_payment_id;  --
      END IF;--
      -- SET REFERNCE PAYMENT ID FOR PAYABLE - END

      -- PAYABLE / RECEIVABLE - START
      IF ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) = ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance ) THEN
       -- DO NOTHING
      ELSEIF ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) > ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance ) THEN -- Payable
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - START 
       IF vl_adjust_payment_id = 0 or vl_adjust_payment_id is NULL THEN
        SELECT a.al_header_id,a.al_sqlcode,a.as_error from SP_PAYMENT_HEADER_INSERT(vl_provider_id,vs_payment_type,
              vd_placement_validation_start,vd_placement_validation_end) a INTO
              vl_payment_id, al_sqlcode, as_error;--

        IF al_sqlcode <> 0 THEN
            vs_identity_column := 'Provider ID';--
            vs_identity_val := TO_CHAR(vl_provider_id);--
            as_error := as_error || ' (SP-5JD)' ;--
           IF as_error is NULL OR as_error = '' THEN
            as_error := 'SP_PAYMENT_HEADER_INSERT failed - Adjustment NOT CREATED. (SP-5JD)'  ;--
           END IF;--
           --SIGNAL p_sp_error  ;--
        END IF ;--
         vl_adjust_payment_id := vl_payment_id; -- Set New ID as Adj Pay ID  
       END IF;--
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - END

       -- CREATE SYSTEM ADJUSTMENT FOR PLACEMENT
   
       -- Check final payment for the placement/month - START
       -- IF found create Sys Adj Payment as NET ELSE separate for R&B and R&B/D
        vl_final_payment_cnt := 0;--
   
       SELECT COUNT(*)
       INTO vl_final_payment_cnt
         FROM TB_PAYMENT_HEADER PH,
           TB_PAYMENT_DETAIL PD
       WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
        AND PD.PLACEMENT_ID = vl_placement_id
        AND PH.PAYMENT_TYPE_CD in ('6', '3294')
        AND PH.MANUAL_SW = 'N'
        AND PH.DELETE_SW = 'N'
        AND PD.DELETE_SW = 'N'
        AND PD.FINAL_SERVICE_ID IS NOT NULL
        /*AND MONTH(PH.PAYMENT_START_DT) = MONTH(vd_placement_validation_start)
        AND YEAR(PH.PAYMENT_START_DT) = YEAR(vd_placement_validation_start) ;--*/
        AND date_part('month', PH.PAYMENT_START_DT) = date_part('month', vd_placement_validation_start) 
        AND date_part('YEAR', PH.PAYMENT_START_DT)  = date_part('YEAR', vd_placement_validation_start);--

       IF vl_final_payment_cnt = 0 THEN

        -- Create payment detail for RFC
        IF vl_csrfc_unit_no is NOT NULL AND vl_csrfc_unit_no > 0 THEN
          vd_service_start_dt := vd_csrfc_service_st_dt;--
          vd_service_end_dt := vd_csrfc_service_end_dt;          --
          vl_unit_no := vl_csrfc_unit_no;--
          vs_unit_type := vs_csrfc_unit_type; --
          vdc_gross_amount := vdc_csrfc_gross_amount - vdc_csrfc_current_balance;--
          vdc_perdiem_rate := vdc_csrfc_perdiem_rate;--
          vs_room_board := '5670' ; -- Room & Board/Clothing

         SELECT a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
               vl_payment_id,
               vl_plc_structure_rfc_id,
               vd_service_start_dt,
               vd_service_end_dt,
               vdc_gross_amount,
               vl_unit_no,
               vs_unit_type,
               vdc_perdiem_rate,
               vs_draft_final_type,
               vs_room_board,
               vl_linked_pymnt_hdr_id,
               vl_reference_payment_detail_id,
               vs_change_type) a INTO
               al_sqlcode,
               as_error;--

         IF al_sqlcode <> 0 THEN
           vs_identity_column := 'Placement ID';--
           vs_identity_val := TO_CHAR(vl_placement_id);--
           as_error := as_error || ' (SP-5AAF)' ;--
          IF as_error is NULL OR as_error = '' THEN
            as_error := 'SP_PAYMENT_DETAIL_INSERT failed for CSRFC. (SP-5AAF)'  ;--
          END IF;--
          --SIGNAL p_sp_error  ;--
         END IF ;--
        END IF;--
   
        -- Create payment detail for RFCD
        IF vl_csrfcd_unit_no is NOT NULL AND vl_csrfcd_unit_no > 0 THEN
          vd_service_start_dt := vd_csrfcd_service_st_dt;--
          vd_service_end_dt := vd_csrfcd_service_end_dt;--
          vl_unit_no := vl_csrfcd_unit_no;--
          vs_unit_type := vs_csrfcd_unit_type;--
          vdc_gross_amount :=  vdc_csrfcd_gross_amount  -  vdc_csrfcd_current_balance;--
          vdc_perdiem_rate := vdc_csrfcd_perdiem_rate;--
          vs_room_board := '5671'; -- Room & Board/Clothing/Differential  
    
         SELECT a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
               vl_payment_id,
               vl_plc_structure_rfc_id,
               vd_service_start_dt,
               vd_service_end_dt,
               vdc_gross_amount,
               vl_unit_no,
               vs_unit_type,
               vdc_perdiem_rate,
               vs_draft_final_type,
               vs_room_board,
               vl_linked_pymnt_hdr_id,
               vl_reference_payment_detail_id,
               vs_change_type) a INTO
               al_sqlcode,
               as_error;--

         IF al_sqlcode <> 0 THEN
           vs_identity_column := 'Placement ID';--
           vs_identity_val := TO_CHAR(vl_placement_id);--
           as_error := as_error || ' (SP-5BAF)' ;--
          IF as_error is NULL OR as_error = '' THEN
            as_error := 'SP_PAYMENT_DETAIL_INSERT failed for CSRFCD. (SP-5BAF)'  ;--
          END IF;--
          --SIGNAL p_sp_error  ;--
         END IF ;   --
        END IF;--
       ELSE  
         vdc_gross_amount := ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) - ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance );--

        IF vl_csrfcd_unit_no is NOT NULL AND vl_csrfcd_unit_no > 0
          AND vdc_csrfcd_gross_amount > vdc_csrfcd_current_balance THEN
          vd_service_start_dt := vd_csrfcd_service_st_dt;--
          vd_service_end_dt := vd_csrfcd_service_end_dt;--
          vl_unit_no := vl_csrfcd_unit_no;--
          vs_unit_type := vs_csrfcd_unit_type;--
          vdc_perdiem_rate := vdc_csrfcd_perdiem_rate;--
          vs_room_board := '5671'; -- Room & Board/Clothing/Differential
        ELSE -- vdc_csrfc_gross_amount > vdc_csrfc_current_balance
          vd_service_start_dt := vd_csrfc_service_st_dt;--
          vd_service_end_dt := vd_csrfc_service_end_dt;          --
          vl_unit_no := vl_csrfc_unit_no;--
          vs_unit_type := vs_csrfc_unit_type;          --
          vdc_perdiem_rate := vdc_csrfc_perdiem_rate;--
          vs_room_board := '5670' ; -- Room & Board/Clothing
        END IF;--

        -- create payment detail id and insert record in payment detail
        SELECT a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
               vl_payment_id,
               vl_plc_structure_rfc_id,
               vd_service_start_dt,
               vd_service_end_dt,
               vdc_gross_amount,
               vl_unit_no,
               vs_unit_type,
               vdc_perdiem_rate,
               vs_draft_final_type,
               vs_room_board,
               vl_linked_pymnt_hdr_id,
               vl_reference_payment_detail_id,
               vs_change_type) a INTO
               al_sqlcode,
               as_error;--

        IF al_sqlcode <> 0 THEN
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
          as_error := as_error || ' (SP-5JE)' ;--
         IF as_error is NULL OR as_error = '' THEN
           as_error := 'SP_PAYMENT_DETAIL_INSERT failed. (SP-5JE)'  ;--
         END IF;--
         --SIGNAL p_sp_error  ;--
        END IF ;--
       END IF;--
       -- Check final payment for the placement/month - END
   
       -- UPDATE TB_PLACEMENT FOR Maintenance Payment if exist, Else Last Adjustment Payment - START
       IF vl_final_pay_count = 0 THEN
       /* UPDATE TB_PLACEMENT
        SET PAYMENT_HEADER_ID = vl_payment_id,
         UPDATE_TS = CURRENT_TIMESTAMP
        WHERE PLACEMENT_ID = vl_placement_id;--*/
       UPDATE placement
    SET paymentheaderid = vl_payment_id,     
     updatedon= current_timestamp
    WHERE alternateid = vl_placement_id;--

         al_sqlcode := SQLCODE;--
        IF al_sqlcode <> 0 THEN
          as_error := 'Error in Updating PLACEMENT - PAYMENT HEADER ID. (SQL-1AD)'  ;--
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
         --SIGNAL p_sp_error  ;--
        END IF;--
       END IF;--
       -- UPDATE TB_PLACEMENT FOR Maintenance Payment if exist, Else Last Adjustment Payment - END
      ELSE -- Receivable
      
        vl_receivable_provider_id :=  vl_provider_id;--
        vdc_receivable_amount := ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance ) - ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) ;--
        vl_payment_detail_id := 0;-- INITIAL VALUE 

       IF vl_reference_payment_detail_id is NOT NULL AND vl_reference_payment_detail_id > 0 THEN
         vl_payment_detail_id := vl_reference_payment_detail_id;--
       END IF;--

       IF vl_payment_detail_id = 0 OR vl_payment_detail_id is NULL THEN
         as_error := 'No PAYMENT_DETAIL_ID found for Receivable RFC. (County Specific Room & Board)'  ;--
        -- PRJ-03018 - Commented
        --IF vl_payment_id > 0 THEN
        -- SET vs_identity_column = 'Placement ID / Payment ID';--
        -- SET vs_identity_val = CHAR(vl_placement_id) || '/ ' || CHAR(vl_payment_id);--
        --ELSE
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
        --END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--

       IF vl_csrfcd_unit_no is NOT NULL AND vl_csrfcd_unit_no > 0
         AND vdc_csrfcd_current_balance > vdc_csrfcd_gross_amount THEN
         vd_service_start_dt := vd_csrfcd_service_st_dt;--
         vd_service_end_dt := vd_csrfcd_service_end_dt;--
       ELSE -- vdc_csrfc_current_balance > vdc_csrfc_gross_amount
         vd_service_start_dt := vd_csrfc_service_st_dt;--
         vd_service_end_dt := vd_csrfc_service_end_dt;          --
       END IF;--
  
       SELECT a.al_sqlcode,a.as_error from SP_OVER_PAYMENT (vl_payment_detail_id,
              vl_client_id,
              vl_receivable_provider_id,
              vd_service_start_dt,
              vd_service_end_dt,
              vdc_receivable_amount,
              vs_change_type) a INTO
              al_sqlcode,
              as_error;--

       IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Provider ID / Client ID';--
         vs_identity_val := TO_CHAR(vl_receivable_provider_id) || '/' || TO_CHAR(vl_client_id);--
         as_error := as_error || ' (SP-5JF)' ;--
        IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_OVER_PAYMENT failed. (SP-5JF)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;   --
      END IF;--
      -- PAYABLE / RECEIVABLE - END
     END IF;--
     -- CIS-18884 new condition II  - END
     --RFC - END
    END IF;--
    --ROOM BOARD - END

    --INITIAL CLOTHING / CLOTHING - START
    -- New condition to hard code date as AUG 31st 09 for Clothing recalculation - CIS-18971
    -- Placement Structure <> Emergency Foster Home Care (13) - START
    -- PRJ-04753 - Changes for new TFC & IFC placement structures 
    IF vl_placement_structure_id <> 13 
     AND vd_placement_validation_end <= DATE('2009-08-31') 
     AND vl_rate_structure_id NOT IN ( 11405, 11406, 11407, 11408, 11409 ) THEN 
  
      vs_clothing_type_cd := '';--
      vs_clothing_rate_cd := '';--

     IF vl_placement_count = 0 THEN -- FIRST PLACEMENT / INITIAL CLOTHING
       vs_clothing_type_cd := vs_init_clothing_cd;--
       vs_clothing_rate_cd := vs_rate_inital_clothing; --
     ELSE -- MONTHLY CLOTHING
       vs_clothing_type_cd := vs_clothing_cd;--
       vs_clothing_rate_cd := vs_rate_clothing_cd; --
     END IF;--

     --- HOW MUCH WE WERE SUPPOSE TO PAY FOR CLOTHING - START
      vdc_monthly_clothing := 0;--
      vdc_clothing_perdiem := 0;--

     -- PAY only if FIRST PLACEMENT or Placment is for Entire Month
     IF vl_placement_count = 0 OR ( vl_unit_no = 1 and vs_unit_type = '5611')  THEN
      SELECT  a.adc_gross_amount,a.adc_per_diem_rate,a.al_sqlcode,a.as_error from  SP_GET_PLACEMENT_RATE (vl_rate_structure_id,vl_age_of_child,
         vd_service_start_dt,vd_service_end_dt,vs_clothing_rate_cd) a INTO
         vdc_monthly_clothing,vdc_clothing_perdiem,al_sqlcode,as_error;--
         
      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Rate Structure ID';--
        vs_identity_val := TO_CHAR(vl_rate_structure_id);--
        as_error := as_error || ' (SP-6)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_GET_PLACEMENT_RATE failed - Monthly Clothing Allowances. (SP-6)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--
     END IF;--
     --- HOW MUCH WE WERE SUPPOSE TO PAY FOR CLOTHING - END

     --- CHECK CURRENT BALANCE FOR CLOTHING - START
      vdc_current_balance := 0;--
      vl_linked_pymnt_hdr_id := NULL; -- INITIAL VALUE
      vl_reference_payment_detail_id := NULL; -- INITIAL VALUE

      SELECT a.al_linked_pymnt_hdr_id,a.al_reference_payment_detail_id,a.adc_current_balance,a.al_sqlcode,a.as_error FROM  SP_GET_CURRENT_BALANCE(vl_placement_id,
         vd_service_start_dt,
         vd_service_end_dt,
         vs_clothing_type_cd,
         vd_placement_validation_start,
         vl_rate_structure_id) a INTO
         vl_linked_pymnt_hdr_id,
         vl_reference_payment_detail_id,
         vdc_current_balance,
         al_sqlcode,
         as_error;--

      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Placement ID';--
        vs_identity_val := TO_CHAR(vl_placement_id);--
        as_error := as_error || ' (SP-7)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_GET_CURRENT_BALANCE failed - FOR CLOTHING. (SP-7)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--

     IF vl_linked_pymnt_hdr_id = 0 THEN
       vl_linked_pymnt_hdr_id := NULL;--
       vl_reference_payment_detail_id := NULL;--
     END IF;--
     --- CHECK CURRENT BALANCE FOR CLOTHING - END  

     -- PAYABLE / RECEIVABLE - START

     -- IF To Pay and Current Balance are same, DO NOTHING  
     IF vdc_monthly_clothing = vdc_current_balance THEN
      -- DO NOTHING
     ELSEIF vdc_monthly_clothing > vdc_current_balance THEN -- Payable
      -- DO not create system Adjustment for Initial Clothing Allowance - CIS-18971
      IF vs_clothing_type_cd = vs_clothing_cd THEN -- Monthly Clothing Only - START
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - START -- 05/13/2008   
       IF vl_adjust_payment_id = 0 or vl_adjust_payment_id is NULL THEN
        SELECT a.al_header_id,a.al_sqlcode,a.as_error from SP_PAYMENT_HEADER_INSERT(vl_provider_id,vs_payment_type,
         vd_placement_validation_start,vd_placement_validation_end) a INTO
         vl_payment_id, al_sqlcode, as_error;--
      
        IF al_sqlcode <> 0 THEN
          vs_identity_column := 'Provider ID';--
          vs_identity_val := TO_CHAR(vl_provider_id);--
          as_error := as_error || ' (SP-8)' ;--
         IF as_error is NULL OR as_error = '' THEN
           as_error := 'SP_PAYMENT_HEADER_INSERT failed - Adjustment NOT CREATED. (SP-8)'  ;--
         END IF;--
         --SIGNAL p_sp_error  ;--
        END IF ;--
         vl_adjust_payment_id := vl_payment_id;--
       END IF;--
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - END -- 05/13/2008   

        vdc_monthly_clothing := vdc_monthly_clothing - vdc_current_balance;--
        vdc_clothing_perdiem := vdc_monthly_clothing;--

       SELECT a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
         vl_payment_id,
         vl_rate_structure_id,
         vd_service_start_dt,
         vd_service_end_dt,
         vdc_monthly_clothing,
         vl_unit_no,
         vs_unit_type,
         vdc_clothing_perdiem,
         vs_draft_final_type,
         vs_clothing_type_cd,
         vl_linked_pymnt_hdr_id,
         vl_reference_payment_detail_id,
         vs_change_type) a INTO
         al_sqlcode,
         as_error;--

       IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Placement ID';--
         vs_identity_val := TO_CHAR(vl_placement_id);--
         as_error := as_error || ' (SP-9)' ;--
        IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_PAYMENT_DETAIL_INSERT failed - Clothing Allowances. (SP-9)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--
      END IF; -- Monthly Clothing Only - END 
     ELSE -- Receivable
       
       vl_receivable_provider_id :=  vl_provider_id;--
       vdc_receivable_amount := vdc_current_balance - vdc_monthly_clothing ;--
       vl_payment_detail_id := 0;-- INITIAL VALUE 

      IF vl_reference_payment_detail_id is NOT NULL AND vl_reference_payment_detail_id > 0 THEN
        vl_payment_detail_id := vl_reference_payment_detail_id;--
      END IF;--

      IF vl_payment_detail_id = 0 OR vl_payment_detail_id is NULL THEN
       --SET as_error = 'Error in Selecting PAYMENT_DETAIL_ID for Receivable. (SQL-5)'  ;--
        as_error := 'No PAYMENT_DETAIL_ID found for Receivable. (Clothing)'  ;--
       -- PRJ-03018 - Commented
       --IF vl_payment_id > 0 THEN
       -- SET vs_identity_column = 'Placement ID / Payment ID';--
       -- SET vs_identity_val = CHAR(vl_placement_id) || '/ ' || CHAR(vl_payment_id);--
       --ELSE
         vs_identity_column := 'Placement ID';--
         vs_identity_val := TO_CHAR(vl_placement_id);--
       --END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--

      SELECT a.al_sqlcode,a.as_error from SP_OVER_PAYMENT (vl_payment_detail_id,
          vl_client_id,
          vl_receivable_provider_id,
          vd_service_start_dt,
          vd_service_end_dt,
          vdc_receivable_amount,
          vs_change_type) a INTO
          al_sqlcode,
          as_error;--

      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Provider ID / Client ID';--
        vs_identity_val := TO_CHAR(vl_receivable_provider_id) || '/' || TO_CHAR(vl_client_id);--
        as_error := as_error || ' (SP-10)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_OVER_PAYMENT failed - CLOTHING PAYMENT. (SP-10)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--
     END IF;--
    END IF; -- Placement Structure <> Emergency Foster Home Care (13) - END
    --INITIAL CLOTHING / CLOTHING - END

    -- STIPEND - START
    -- STEPEND LOGIC START ONLY FOR TFC OR IFC FOR chessie_mask PROVIDERS ONLY
    -- 11 -- Intermediate Foster Care
    -- 12 -- Treatment Foster Care
    IF vl_placement_structure_id = 11 OR vl_placement_structure_id = 12 THEN

     --- HOW MUCH WE WERE SUPPOSE TO PAY AS STIPEND - START 
      vdc_stipend_amount_no := 0.00;--
      vl_doc_level_id := 0;--
   
     -- New Logic for Stipend Calculation 12/07/2009 
     IF vd_service_end_dt <= DATE('2010-01-31') THEN
   
      SELECT STIPEND_SERVICE_ID,
          AMOUNT
       INTO vl_doc_level_id,
         vdc_stipend_amount_no
      FROM TB_PLACEMENT_DOC
      WHERE DELETE_SW = 'N'
       AND PLACEMENT_ID = vl_placement_id
       AND APPROVAL_STATUS_CD = '3047'
       AND PLACEMENT_DOC_ID = (SELECT MAX(PLACEMENT_DOC_ID)
             FROM TB_PLACEMENT_DOC
             WHERE DELETE_SW = 'N'
              AND PLACEMENT_ID = vl_placement_id
              AND APPROVAL_STATUS_CD = '3047'
              AND ((END_DT IS NULL) OR (END_DT >= vd_service_end_dt))
              AND START_DT < vd_service_end_dt);--
     ELSE
      -- INTIAL VALUES
       vdc_stipend_amount_no := NULL;--
       vd_stipend_service_start_dt := NULL;--
       vd_stipend_service_end_dt := NULL;--
       vl_stipend_unit_no := NULL;--
       vs_stipend_unit_type := NULL;--
   
      SELECT a.al_doc_level_id,
 a.adc_stipend_amount_no,
 a.ad_service_start_dt,
 a.ad_service_end_dt,
 a.al_unit_no,
 a.as_unit_type,
 a.al_sqlcode ,
 a.as_error FROM SP_STIPEND_CALCULATION(vl_placement_id,
         vl_placement_structure_id,
         vd_place_entry_dt,
         vd_place_exit_dt,
         vd_placement_validation_start,
         vd_placement_validation_end) a INTO
         vl_doc_level_id,
         vdc_stipend_amount_no,
         vd_stipend_service_start_dt,
         vd_stipend_service_end_dt,
         vl_stipend_unit_no,
         vs_stipend_unit_type,
         al_sqlcode,
         as_error;--
   
      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Placement ID';--
        vs_identity_val := vl_placement_id;--
        as_error := as_error || ' (SP-10A)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_STIPEND_CALCULATION failed. (SP-10A)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--
     END IF;--
   
     IF vdc_stipend_amount_no IS NULL OR vdc_stipend_amount_no = 0.00 THEN

      IF vl_doc_level_id IS NULL OR vl_doc_level_id = 0 THEN
       -- no need to create record
      ELSE -- check the rate in the rate table
        vdc_perdiem_stipend_rate := 0.00; -- initial value
        vdc_stipend_rate := 0.00; -- initial value
    
       -- New Logic for Stipend Calculation 12/07/2009  
       IF vd_service_end_dt <= DATE('2010-01-31') THEN 
        SELECT a.adc_gross_amount,a.adc_per_diem_rate,a.al_sqlcode,a.as_error from SP_GET_PLACEMENT_RATE (vl_doc_level_id,vl_age_of_child,
           vd_service_start_dt,vd_service_end_dt,vs_rate_stipend_cd) a INTO
           vdc_stipend_rate,vdc_perdiem_stipend_rate, al_sqlcode, as_error;--
       ELSE
        SELECT a.adc_gross_amount,a.adc_per_diem_rate,a.al_sqlcode,a.as_error from SP_GET_PLACEMENT_RATE (vl_doc_level_id,vl_age_of_child,
           vd_stipend_service_start_dt,vd_stipend_service_end_dt,vs_rate_stipend_cd) a INTO
           vdc_stipend_rate,vdc_perdiem_stipend_rate, al_sqlcode, as_error;--
       END IF;--
     
       IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Doc Level ID';--
         vs_identity_val := TO_CHAR(vl_doc_level_id);--
         as_error := as_error || ' (SP-11)' ;--
        IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_GET_PLACEMENT_RATE failed - STIPEND. (SP-11)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--
    
       IF vdc_stipend_rate is NULL THEN
         vdc_stipend_rate := 0; --
       END IF;--
       IF vdc_perdiem_stipend_rate is NULL THEN
         vdc_perdiem_stipend_rate := 0;--
       END IF;--
    
       -- New condition to pay Stipend  - CIS-19002 
       IF vd_service_end_dt <= DATE('2009-08-31') THEN
         vs_unit_type := '5611' ;  -- monthly for stipend
         vl_unit_no := 1; -- monthly for stipend
       ELSE
         vs_unit_type := '5610' ;  -- Nightly for stipend
        -- No need set vl_unit_no pay as per placement dates -- Nightly for stipend
        -- New Logic for Stipend Calculation 12/07/2009 
        IF vd_service_end_dt <= DATE('2010-01-31') THEN 
          vdc_stipend_rate := vdc_perdiem_stipend_rate * vl_unit_no;--
        ELSE
          vdc_stipend_rate := vdc_perdiem_stipend_rate * vl_stipend_unit_no;--
        END IF;--
         vdc_perdiem_stipend_rate := COALESCE(vdc_perdiem_stipend_rate,0);--
       END IF;--
      END IF;--
     ELSE
       vdc_stipend_rate := vdc_stipend_amount_no;--
       vdc_perdiem_stipend_rate := vdc_stipend_amount_no;--
     END IF;--
     --- HOW MUCH WE WERE SUPPOSE TO PAY AS STIPEND - END          

     -- Need to create record if vl_doc_level_id > 0 - START 
     IF  vl_doc_level_id IS NOT NULL AND vl_doc_level_id > 0 THEN 
      --- CHECK CURRENT BALANCE FOR STIPEND - START
       vdc_current_balance := 0;--
       vl_linked_pymnt_hdr_id := NULL; -- INITIAL VALUE
       vl_reference_payment_detail_id := NULL; -- INITIAL VALUE

      SELECT a.al_linked_pymnt_hdr_id,a.al_reference_payment_detail_id,a.adc_current_balance,a.al_sqlcode,a.as_error FROM  SP_GET_CURRENT_BALANCE(vl_placement_id,
        vd_service_start_dt,
        vd_service_end_dt,
        vs_stipend_cd,
        vd_placement_validation_start,
        vl_rate_structure_id) a INTO
        vl_linked_pymnt_hdr_id,
        vl_reference_payment_detail_id,
        vdc_current_balance,
        al_sqlcode,
        as_error;--

      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Placement ID';--
        vs_identity_val := TO_CHAR(vl_placement_id);--
        as_error := as_error || ' (SP-12)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_GET_CURRENT_BALANCE failed - FOR STIPEND. (SP-12)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--
   
      IF vl_linked_pymnt_hdr_id = 0 THEN
        vl_linked_pymnt_hdr_id := NULL;--
        vl_reference_payment_detail_id := NULL;--
      END IF;--
      --- CHECK CURRENT BALANCE FOR STIPEND - END  

      -- PAYABLE / RECEIVABLE - START

      -- IF To Pay and Current Balance are same, DO NOTHING  
      IF vdc_stipend_rate = vdc_current_balance THEN
       -- DO NOTHING
      ELSEIF vdc_stipend_rate > vdc_current_balance THEN -- Payable
   
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - START -- 05/13/2008   
       IF vl_adjust_payment_id = 0 or vl_adjust_payment_id is NULL THEN
        SELECT a.al_header_id,a.al_sqlcode,a.as_error from SP_PAYMENT_HEADER_INSERT(vl_provider_id,vs_payment_type,
          vd_placement_validation_start,vd_placement_validation_end) a INTO
          vl_payment_id, al_sqlcode, as_error;--
  
        IF al_sqlcode <> 0 THEN
          vs_identity_column := 'Provider ID';--
          vs_identity_val := TO_CHAR(vl_provider_id);--
          as_error := as_error || ' (SP-13)' ;--
         IF as_error is NULL OR as_error = '' THEN
           as_error := 'SP_PAYMENT_HEADER_INSERT failed - Adjustment NOT CREATED. (SP-13)'  ;--
         END IF;--
         --SIGNAL p_sp_error  ;--
        END IF ;--
         vl_adjust_payment_id := vl_payment_id;--
       END IF;--
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - END -- 05/13/2008  
  
        vdc_stipend_rate := vdc_stipend_rate - vdc_current_balance;--
       -- New condition for Stipend Per Diem Rate- CIS-19002  
       IF vd_service_end_dt <= DATE('2009-08-31') THEN
         vdc_perdiem_stipend_rate := vdc_stipend_rate;--
       END IF;--
       -- Commented with CIS-19002  
       -- SET vs_unit_type = '5611' ;  -- monthly for stipend
       -- SET vl_unit_no = 1; -- monthly for stipend
   
       -- New Logic for Stipend Calculation 12/07/2009 
       IF vd_service_end_dt <= DATE('2010-01-31') THEN 
        SELECT   a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
                vl_payment_id,
                vl_rate_structure_id,
                vd_service_start_dt,
                vd_service_end_dt,
                vdc_stipend_rate,
                vl_unit_no,
                vs_unit_type,
                vdc_perdiem_stipend_rate,
                vs_draft_final_type,
                vs_stipend_cd,
                vl_linked_pymnt_hdr_id,
                vl_reference_payment_detail_id,
                vs_change_type) a INTO
                al_sqlcode,
                as_error;--
       ELSE
          SELECT   a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
                vl_payment_id,
                vl_rate_structure_id,
                vd_stipend_service_start_dt,
                vd_stipend_service_end_dt,
                vdc_stipend_rate,
                vl_stipend_unit_no,
                vs_unit_type,
                vdc_perdiem_stipend_rate,
                vs_draft_final_type,
                vs_stipend_cd,
                vl_linked_pymnt_hdr_id,
                vl_reference_payment_detail_id,
                vs_change_type) a INTO
                al_sqlcode,
                as_error;--
       END IF;--
    
       IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Placement ID';--
         vs_identity_val := TO_CHAR(vl_placement_id);--
         as_error := as_error || ' (SP-14)' ;--
        IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_PAYMENT_DETAIL_INSERT failed - STIPEND. (SP-14)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--
      ELSE -- Receivable
      
        vl_receivable_provider_id :=  vl_provider_id;--
        vdc_receivable_amount := vdc_current_balance - vdc_stipend_rate ;--
        vl_payment_detail_id := 0;-- INITIAL VALUE 
  
       IF vl_reference_payment_detail_id is NOT NULL AND vl_reference_payment_detail_id > 0 THEN
         vl_payment_detail_id := vl_reference_payment_detail_id;--
       END IF;--

       IF vl_payment_detail_id = 0 OR vl_payment_detail_id is NULL THEN
         as_error := 'No PAYMENT_DETAIL_ID found for Receivable. (Stipend)'  ;--
        -- PRJ-03018 - Commented
        --IF vl_payment_id > 0 THEN
        -- SET vs_identity_column = 'Placement ID / Payment ID';--
        -- SET vs_identity_val = CHAR(vl_placement_id) || '/ ' || CHAR(vl_payment_id);--
        --ELSE
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
        --END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--

       -- New Logic for Stipend Calculation 12/07/2009 
       IF vd_service_end_dt <= DATE('2010-01-31') THEN 
        SELECT  a.al_sqlcode,a.as_error from SP_OVER_PAYMENT (vl_payment_detail_id,
               vl_client_id,
               vl_receivable_provider_id,
               vd_service_start_dt,
               vd_service_end_dt,
               vdc_receivable_amount,
               vs_change_type) a INTO
               al_sqlcode,
               as_error;--
       ELSE
        SELECT  a.al_sqlcode,a.as_error from SP_OVER_PAYMENT (vl_payment_detail_id,
               vl_client_id,
               vl_receivable_provider_id,
               vd_stipend_service_start_dt,
               vd_stipend_service_end_dt,
               vdc_receivable_amount,
               vs_change_type) a INTO
               al_sqlcode,
               as_error;--
       END IF;--
       
       IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Provider ID / Client ID';--
         vs_identity_val := TO_CHAR(vl_receivable_provider_id) || '/' || TO_CHAR(vl_client_id);--
         as_error := as_error || ' (SP-15)' ;--
        IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_OVER_PAYMENT failed - STIPEND PAYMENT. (SP-15)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--
    
      END IF;--
      -- PAYABLE / RECEIVABLE - END
     END IF;--
     -- Need to create record if vl_doc_level_id > 0 - END
    END IF;--
    --STIPEND - END

    -- UPDATING HEADER TABLE - START
    IF vl_payment_id is NOT NULL AND vl_payment_id > 0 THEN
      UPDATE TB_PAYMENT_HEADER
         SET GROSS_AMOUNT_NO = (SELECT SUM(FINAL_AMOUNT_NO) FROM TB_PAYMENT_DETAIL WHERE
          PAYMENT_ID = vl_payment_id and DELETE_SW = 'N' )
      WHERE PAYMENT_ID = vl_payment_id;--

      al_sqlcode := SQLCODE;--
     IF al_sqlcode <> 0 THEN
       as_error := 'Error in Updating PAYMENT HEADER - Gross Amount. (SQL-8)'  ;--
       vs_identity_column := 'Payment ID';--
       vs_identity_val := TO_CHAR(vl_payment_id);--
      --SIGNAL p_sp_error  ;--
     END IF ;--
    END IF; --
    -- UPDATING HEADER TABLE - END
  
    --COMMIT;--
   END IF; -- CHECK FOR FINAL RUN - END
  END IF; -- PRJ-04753 - To Exclude Placement Validation records out of range of Foster Care Rate Changes - END
  
  
 END IF; -- To Exclude Placement Validation records out of range of Placement Dates - END
--END FOR;--
END LOOP; 
 close CUR_VALIDATED_PLACEMENT_refcur;

PERFORM SP_VOIDPLACEMENT_RECEIVABLE();--
SELECT SP_PAYMENT_PLAN_INSERT (0) INTO vl_sql_code;--
PERFORM SP_AR_TICKLER('PUB', 42 );--
PERFORM SP_EFC_RFC_TICKLERS(420,'U',ad_run_dt,vd_null_dt );--
-- CIS-18884
SELECT a.al_sqlcode,a.as_error from SP_COUNTY_SPECIFIC_UNOV_FSS( ad_run_dt) a INTO vl_sql_code, as_error ;--

--COMMIT;--
RETURN 1;--

END;

