--DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
 CUR_VALIDATED_PLACEMENT record;
 CUR_VALIDATED_PLACEMENT_refcur REFCURSOR;
 COMAR_RATE_CUR record;
 COMAR_RATE_CUR_refcur REFCURSOR;
BEGIN
begin
 EXCEPTION WHEN OTHERS THEN
    --GET DIAGNOSTICS EXCEPTION 1 vs_message_text =  MESSAGE_TEXT;--
 GET STACKED DIAGNOSTICS vs_message_text :=  MESSAGE_TEXT;
--    SET al_sqlcode = -1 ;--
     as_error := COALESCE(as_error ,'') || (CURRENT_TIMESTAMP::text) ||'::' || vs_Procedure_nm || '.' ;--
     as_error := COALESCE(as_error ,'') || '::RO ' || COALESCE(vs_identity_column ,'N/A') || ' :: ' || COALESCE(vs_identity_val ,'');--
     as_error := as_error || COALESCE(vs_message_text ,'');--

    SELECT CHESSIE.SP_BATCH_ERROR_LOG ( 'SP_UNDER_OVER_PUB' ,
           NULL::bigint,
            NULL::bigint,
                  NULL::character varying,
            NULL::INTEGER,
      NULL::character varying,
            SQLSTATE::character varying,
                  as_error::character varying,
            'finance'::character varying) INTO
                  vl_ret_status;

     as_error := '';--
   RETURN 0;
END;
--Log error

-- CURRENT DATE to ad_run_dt
-- ALL PLACEMENT VALIDATION VALIDATED TODAY ALSO PLACMENT NOT VOIDED OR DELETED (VALID PLACEMENT)
--FOR CUR_VALIDATED_PLACEMENT AS
--cur1 CURSOR WITH HOLD FOR
OPEN CUR_VALIDATED_PLACEMENT_refcur FOR
SELECT PV.PLACEMENT_ID,
       PV.VALIDATION_START_DT,
       PV.VALIDATION_END_DT,
       P.PROVIDER_ID,
       P.PLACEMENT_STRUCTURE_ID,
       P.ENTRY_DT,
       (CASE WHEN as_f_age(C.dob::DATE,PV.VALIDATION_END_DT) = 21 AND ( (C.dob::DATE + INTERVAL '21 year') < P.EXIT_DT OR P.EXIT_DT is NULL)  THEN
            C.dob::DATE + INTERVAL '21 year' 
        ELSE
            P.EXIT_DT
        END ) AS EXIT_DT,
       C.dob::DATE,
       P.CLIENT_ID,
       P.RATE_STRUCTURE_ID,
       f_prim_county (P.CASE_ID,'NULL') AS COUNTY_CD,
       (CASE WHEN as_f_age(C.dob::DATE, PV.VALIDATION_END_DT) = 21 THEN
          20
        ELSE
            as_f_age(C.dob::DATE, PV.VALIDATION_END_DT )
   END ) AS CHILD_AGE,
 'PLACEMENT_CHANGES' AS TRAN_TYPE
FROM TB_PLACEMENT_VALIDATION PV,
     TB_PLACEMENT P,
     TB_PROVIDER PR,
     person C
  WHERE P.CLIENT_ID = C.cjamspid
 AND P.PROVIDER_ID = PR.PROVIDER_ID
 AND C.activeflag = 1
 AND PR.DELETE_SW = 'N'
 AND P.PLACEMENT_ID = PV.PLACEMENT_ID
 AND PV.VALIDATION_STATUS_CD = '1750'
 AND PV.DELETE_SW = 'N'
 AND P.DELETE_SW = 'N'
 AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = 'N'))
 AND DATE(PV.UPDATE_TS) = ad_run_dt
 AND P.CONVERSION_SW IS NULL
 AND P.PROVIDER_ORGANIZATION_ID IS NULL
 AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT)
 AND C.dob::DATE IS NOT NULL
 
 /*AND ( CHESSIE.as_f_age(C.DOB_DT, PV.VALIDATION_END_DT ) < 21
  OR ( month(C.DOB_DT + INTERVAL '21 year') = month(PV.VALIDATION_END_DT)
          AND YEAR(C.DOB_DT + INTERVAL '21 year') = YEAR(PV.VALIDATION_END_DT)
        AND DAY(C.DOB_DT + INTERVAL '21 year') <> 1
            )
            )*/
 AND ( as_f_age(C.dob::DATE, PV.VALIDATION_END_DT ) < 21
  OR ( date_part('month', C.dob::DATE + INTERVAL '21 year') = date_part('month', PV.VALIDATION_END_DT)--month(PV.VALIDATION_END_DT)   
          AND date_part('YEAR', C.dob::DATE + INTERVAL '21 year') = date_part('YEAR', PV.VALIDATION_END_DT)
        AND date_part('DAY', C.dob::DATE + INTERVAL '21 year') <> 1
            )
            )
UNION
SELECT PV.PLACEMENT_ID,
       PV.VALIDATION_START_DT,
       PV.VALIDATION_END_DT,
       P.PROVIDER_ID,
       P.PLACEMENT_STRUCTURE_ID,
       P.ENTRY_DT,
       (CASE WHEN as_f_age(C.dob::DATE,PV.VALIDATION_END_DT) = 21 AND ( (C.dob::DATE + INTERVAL '21 year') < P.EXIT_DT OR P.EXIT_DT is NULL)  THEN
            C.dob::DATE + INTERVAL '21 year' 
        ELSE
            P.EXIT_DT
        END ) AS EXIT_DT,
       C.dob::DATE,
       P.CLIENT_ID,
       P.RATE_STRUCTURE_ID,
       f_prim_county (P.CASE_ID,'NULL') AS COUNTY_CD,
       (CASE WHEN as_f_age(C.dob::DATE, PV.VALIDATION_END_DT) = 21 THEN
          20
        ELSE
            as_f_age(C.dob::DATE, PV.VALIDATION_END_DT )
      END ) AS CHILD_AGE,
    'COUNTY_SPECIFIC_CHANGES' AS TRAN_TYPE
FROM TB_PLACEMENT_VALIDATION PV,
     TB_PLACEMENT P,
     TB_PROVIDER PR,
     person C,
     TB_COUNTY_SPECIFIC_UNOV  CSP
  WHERE P.CLIENT_ID = C.cjamspid
 AND P.PROVIDER_ID = PR.PROVIDER_ID
 AND CSP.PROVIDER_ID = P.PROVIDER_ID
      AND CSP.DELETE_SW = 'N'
      AND ( PV.VALIDATION_START_DT BETWEEN CSP.MIN_ADR_START_DT AND CSP.MAX_ADR_START_DT
       OR PV.VALIDATION_END_DT BETWEEN CSP.MIN_ADR_START_DT AND CSP.MAX_ADR_START_DT
     )
        AND PV.VALIDATION_START_DT >= DATE('2010-04-01')
 AND C.activeflag = 1
 AND PR.DELETE_SW = 'N'
 AND P.PLACEMENT_ID = PV.PLACEMENT_ID
 AND PV.VALIDATION_STATUS_CD = '1750'
 AND PV.DELETE_SW = 'N'
 AND P.DELETE_SW = 'N'
 AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = 'N'))
 AND DATE(PV.UPDATE_TS) <> ad_run_dt
 AND P.CONVERSION_SW IS NULL
 AND P.PROVIDER_ORGANIZATION_ID IS NULL
 AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT)
 AND C.dob::DATE IS NOT NULL
 /*AND ( CHESSIE.as_f_age(C.DOB_DT, PV.VALIDATION_END_DT ) < 21
  OR ( month(C.DOB_DT + INTERVAL '21 year') = month(PV.VALIDATION_END_DT)
          AND YEAR(C.DOB_DT + INTERVAL '21 year') = YEAR(PV.VALIDATION_END_DT)
        AND DAY(C.DOB_DT + INTERVAL '21 year') <> 1
            )
            )*/
 AND ( as_f_age(C.dob::DATE, PV.VALIDATION_END_DT ) < 21
  OR ( date_part('month', C.dob::DATE + INTERVAL '21 year') = date_part('month', PV.VALIDATION_END_DT)--month(PV.VALIDATION_END_DT)   
          AND date_part('YEAR', C.dob::DATE + INTERVAL '21 year') = date_part('YEAR', PV.VALIDATION_END_DT)
        AND date_part('DAY', C.dob::DATE + INTERVAL '21 year') <> 1
            )
            )
 UNION 
 SELECT PV.PLACEMENT_ID,
       PV.VALIDATION_START_DT,
       PV.VALIDATION_END_DT,
       P.PROVIDER_ID,
       P.PLACEMENT_STRUCTURE_ID,
       P.ENTRY_DT,
       (CASE WHEN as_f_age(C.dob::DATE,PV.VALIDATION_END_DT) = 21 AND ( (C.dob::DATE + INTERVAL '21 year') < P.EXIT_DT OR P.EXIT_DT is NULL)  THEN
            C.dob::DATE + INTERVAL '21 year' 
        ELSE
            P.EXIT_DT
        END ) AS EXIT_DT,
       C.dob::DATE,
       P.CLIENT_ID,
       P.RATE_STRUCTURE_ID,
       f_prim_county (P.CASE_ID,'NULL') AS COUNTY_CD,
       (CASE WHEN as_f_age(C.dob::DATE, PV.VALIDATION_END_DT) = 21 THEN
          20
        ELSE
            as_f_age(C.dob::DATE, PV.VALIDATION_END_DT )
   END ) AS CHILD_AGE,
 'FC_RATE_CHANGES' AS TRAN_TYPE
FROM TB_PLACEMENT_VALIDATION PV,
     TB_PLACEMENT P,
     TB_PROVIDER PR,
     person C
  WHERE P.CLIENT_ID = C.cjamspid
 AND P.PROVIDER_ID = PR.PROVIDER_ID
 AND C.activeflag = 1
 AND PR.DELETE_SW = 'N'
 AND P.PLACEMENT_ID = PV.PLACEMENT_ID
 AND PV.VALIDATION_STATUS_CD = '1750'
 AND PV.DELETE_SW = 'N'
 AND P.DELETE_SW = 'N'
 AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = 'N'))
-- AND DATE(PV.UPDATE_TS) = ad_run_dt
 AND P.CONVERSION_SW IS NULL
 AND P.PROVIDER_ORGANIZATION_ID IS NULL
 AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT)
 AND C.dob::DATE IS NOT NULL
 /*AND ( CHESSIE.as_f_age(C.DOB_DT, PV.VALIDATION_END_DT ) < 21
  OR ( month(C.DOB_DT + INTERVAL '21 year') = month(PV.VALIDATION_END_DT)
          AND YEAR(C.DOB_DT + INTERVAL '21 year') = YEAR(PV.VALIDATION_END_DT)
        AND DAY(C.DOB_DT + INTERVAL '21 year') <> 1
            )
            )*/
 AND ( as_f_age(C.dob::DATE, PV.VALIDATION_END_DT ) < 21
  OR ( date_part('month', C.dob::DATE + INTERVAL '21 year') = date_part('month', PV.VALIDATION_END_DT)--month(PV.VALIDATION_END_DT)   
          AND date_part('YEAR', C.dob::DATE + INTERVAL '21 year') = date_part('YEAR', PV.VALIDATION_END_DT)
        AND date_part('DAY', C.dob::DATE + INTERVAL '21 year') <> 1
            )
            )
 AND P.RATE_STRUCTURE_ID 
  IN ( SELECT FC.SERVICE_ID
     FROM TB_FOSTER_CARE_RATE FC
    WHERE FC.DELETE_SW = 'N'
    AND FC.RATE_ID 
     IN ( SELECT FCR.RATE_ID
       FROM TB_FOSTER_CARE_RATE_REVISION FCR
       WHERE FCR.APPROVAL_DT = ad_run_dt
         AND FCR.DELETE_SW = 'N'
        )
   )  
ORDER BY PLACEMENT_ID,
         VALIDATION_START_DT;
--DO
loop
 fetch CUR_VALIDATED_PLACEMENT_refcur into CUR_VALIDATED_PLACEMENT;
           exit when not found;
  vl_placement_id := CUR_VALIDATED_PLACEMENT.PLACEMENT_ID;--
  vd_placement_validation_start := CUR_VALIDATED_PLACEMENT.VALIDATION_START_DT;--
  vd_placement_validation_end := CUR_VALIDATED_PLACEMENT.VALIDATION_END_DT;--
  vl_provider_id := CUR_VALIDATED_PLACEMENT.PROVIDER_ID;--
  vl_placement_structure_id := CUR_VALIDATED_PLACEMENT.PLACEMENT_STRUCTURE_ID;--
  vd_place_entry_dt := CUR_VALIDATED_PLACEMENT.ENTRY_DT;--
  vd_place_exit_dt := CUR_VALIDATED_PLACEMENT.EXIT_DT;--
  vl_age_of_child := CUR_VALIDATED_PLACEMENT.CHILD_AGE;--
  vd_dob := CUR_VALIDATED_PLACEMENT.DOB;--
  vd_service_start_dt := NULL;   -- INITIAL VALUE
  vd_service_end_dt := NULL;   -- INITIAL VALUE
  vl_unit_no := 0;   -- INITIAL VALUE
  vs_unit_type := NULL;   -- INITIAL VALUE
  vl_client_id := CUR_VALIDATED_PLACEMENT.CLIENT_ID;--
  vl_rate_structure_id := CUR_VALIDATED_PLACEMENT.RATE_STRUCTURE_ID;--
  vs_county_cd := CUR_VALIDATED_PLACEMENT.COUNTY_CD;--
  vs_TRAN_TYPE := CUR_VALIDATED_PLACEMENT.TRAN_TYPE;--
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vl_placement_id  %',vl_placement_id;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vd_placement_validation_start  %',vd_placement_validation_start;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vd_placement_validation_end  %',vd_placement_validation_end;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vl_provider_id  %',vl_provider_id;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vl_placement_structure_id  %',vl_placement_structure_id;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vd_place_entry_dt  %',vd_place_entry_dt;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vd_place_exit_dt  %',vd_place_exit_dt;
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vl_age_of_child  %',vl_age_of_child; 
 RAISE NOTICE 'CUR_VALIDATED_PLACEMENT_refcur>>>>>>>>>>>> vs_TRAN_TYPE  %',vs_TRAN_TYPE;

 -- PRJ-04753 - Set Change Type for Fiscal Audit Trail
 IF vs_TRAN_TYPE = 'FC_RATE_CHANGES' THEN
   vs_change_type := '1002'; -- Foster Care Rate Changes
 ELSEIF vs_TRAN_TYPE = 'COUNTY_SPECIFIC_CHANGES' THEN 
   vs_change_type := '1010'; -- County Specific Changes
 ELSE -- PLACEMENT_CHANGES
   vs_change_type := '1001'; -- Placement Changes
 END IF;--
 
 
 -- To Exclude Placement Validation records out of range of Placement Dates - START
 -- These cases are handled in CHESSIE.SP_VOIDPLACEMENT_RECEIVABLE
 IF (vd_place_exit_dt is NULL OR (vd_place_exit_dt IS NOT NULL AND vd_place_exit_dt >= vd_placement_validation_start))
      AND vd_place_entry_dt <= vd_placement_validation_end THEN
 RAISE NOTICE 'Entered into IF >>>>>>>>>>>> vl_age_of_child  ';

  -- PRJ-04753 - To Exclude Placement Validation records out of range of Foster Care (COMAR) Rate Changes - START
   vs_DO_RECALC := NULL;--
  IF vs_TRAN_TYPE = 'FC_RATE_CHANGES' THEN
   RAISE NOTICE 'Entered into IF >>>>>>>>>>>> IF vs_TRAN_TYPE = FC_RATE_CHANGES';

   -- Verify the placement validation month and client age is imapcated due to updated Foster Care (COMAR) rate slab 
   --FOR COMAR_RATE_CUR as
   OPEN COMAR_RATE_CUR_refcur FOR
    SELECT FC.START_DT,
        FC.END_DT,
        FC.MIN_AGE_NO,
        FC.MAX_AGE_NO
     FROM TB_FOSTER_CARE_RATE FC
    WHERE FC.DELETE_SW = 'N'
     AND FC.SERVICE_ID = vl_rate_structure_id
     AND FC.RATE_ID IN ( SELECT FCR.RATE_ID
           FROM TB_FOSTER_CARE_RATE_REVISION FCR
          WHERE FCR.APPROVAL_DT = ad_run_dt
          AND FCR.DELETE_SW = 'N'
            )
    ORDER BY FC.RATE_ID ;
   --DO
   loop
 fetch COMAR_RATE_CUR_refcur into COMAR_RATE_CUR;
           exit when not found;
