       vl_linked_pymnt_hdr_id := NULL; -- INITIAL VALUE
       vl_reference_payment_detail_id := NULL; -- INITIAL VALUE
   
      SELECT a.al_linked_pymnt_hdr_id,a.al_reference_payment_detail_id,a.adc_csrfc_current_balance,a.adc_csrfcd_current_balance,a.al_sqlcode,a.as_error from SP_CSRB_GET_CURRENT_BALANCE ( vl_placement_id,
           vd_placement_validation_start,
           vs_csrfc_rate_type_cd,
           vs_csrfcd_rate_type_cd,
           vl_rate_structure_id) a INTO 
           vl_linked_pymnt_hdr_id,
           vl_reference_payment_detail_id,
           vdc_csrfc_current_balance,
           vdc_csrfcd_current_balance,
           al_sqlcode,
           as_error;--

      IF al_sqlcode <> 0 THEN
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id,'99999999');--
          as_error := as_error || ' (SP-5AC)' ;--
         IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_CSRB_GET_CURRENT_BALANCE failed for County Specific. (SP-5AC)'  ;--
         END IF;--
       --  SIGNAL p_sp_error  ;--
      END IF ;--

      IF vl_linked_pymnt_hdr_id = 0 THEN
          vl_linked_pymnt_hdr_id := NULL;--
          vl_reference_payment_detail_id := NULL;--
      END IF;--
      
      --- CHECK CURRENT BALANCE - END   
   
      -- TAKE FIRST ADJUSTMENT ID - START
       vl_adjust_payment_id := 0; -- INITIAL VALUE

      SELECT MIN(PH.PAYMENT_ID)
       INTO vl_adjust_payment_id
         FROM TB_PAYMENT_HEADER PH,
          TB_PAYMENT_DETAIL PD
        WHERE  PH.PAYMENT_ID = PD.PAYMENT_ID
        AND PH.PROVIDER_ID = vl_provider_id
        AND PH.PAYMENT_DT = CURRENT_DATE
        AND PH.PAYMENT_TYPE_CD = '3294'
        AND PD.PLACEMENT_ID IS NOT NULL
        AND PH.MANUAL_SW = 'N'
        AND PH.DELETE_SW = 'N'
        AND PD.DELETE_SW = 'N'
       /* AND MONTH(PH.PAYMENT_START_DT) = MONTH(vd_placement_validation_start)
        AND YEAR(PH.PAYMENT_START_DT) = YEAR(vd_placement_validation_start)*/
         AND date_part('month', PH.PAYMENT_START_DT) = date_part('month', vd_placement_validation_start) 
     AND date_part('YEAR', PH.PAYMENT_START_DT)  = date_part('YEAR', vd_placement_validation_start)--
        AND PD.COUNTY_CD =  vs_county_cd
        AND PD.CLIENT_ID = vl_client_id ;--

      IF vl_adjust_payment_id IS NULL THEN
          vl_adjust_payment_id := 0; --
      END IF;--
      -- TAKE FIRST ADJUSTMENT ID - END

      -- SET REFERNCE PAYMENT ID FOR PAYABLE - START
       vl_payment_id := 0; -- INITIAL VALUE
      IF vl_adjust_payment_id > 0 THEN
          vl_payment_id := vl_adjust_payment_id;  --
      END IF;--
      -- SET REFERNCE PAYMENT ID FOR PAYABLE - END
   
      -- PAYABLE / RECEIVABLE - START
      -- IF To Pay (RFC + RFCD) and Current Balance (RFC + RFCD) are same, DO NOTHING  
      IF ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) = ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance ) THEN
         -- DO NOTHING
      ELSEIF ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) > ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance ) THEN -- Payable
   
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - START 
       IF vl_adjust_payment_id = 0 or vl_adjust_payment_id is NULL THEN
        SELECT a.al_header_id,a.al_sqlcode,a.as_error from  SP_PAYMENT_HEADER_INSERT(vl_provider_id,vs_payment_type,
              vd_placement_validation_start,vd_placement_validation_end) a INTO 
              vl_payment_id, al_sqlcode, as_error;--
          
        IF al_sqlcode <> 0 THEN
          vs_identity_column := 'Provider ID';--
          vs_identity_val := TO_CHAR(vl_provider_id);--
          as_error := as_error || ' (SP-5AD)' ;--
         IF as_error is NULL OR as_error = '' THEN
           as_error := 'SP_PAYMENT_HEADER_INSERT failed - Adjustment NOT CREATED. (SP-5AD)'  ;--
         END IF;--
         --SIGNAL p_sp_error  ;--
        END IF ;--
         vl_adjust_payment_id := vl_payment_id; -- Set New ID as Adj Pay ID  
       END IF;--
       -- CHECK ADJUSTMENT CREATED ON THAT DAY - END

       -- CREATE SYSTEM ADJUSTMENT FOR PLACEMENT
       -- Check final payment for the placement/month - START
       -- IF found create Sys Adj Payment as NET ELSE separate for R&B and R&B/D
        vl_final_payment_cnt := 0;--
   
       SELECT COUNT(*)
        INTO vl_final_payment_cnt
       FROM TB_PAYMENT_HEADER PH,
         TB_PAYMENT_DETAIL PD
       WHERE  PH.PAYMENT_ID = PD.PAYMENT_ID
        AND PD.PLACEMENT_ID = vl_placement_id
        AND PH.PAYMENT_TYPE_CD in ('6', '3294')
        AND PH.MANUAL_SW = 'N'
        AND PH.DELETE_SW = 'N'
        AND PD.DELETE_SW = 'N'
        AND PD.FINAL_SERVICE_ID IS NOT NULL
        /*AND MONTH(PH.PAYMENT_START_DT) = MONTH(vd_placement_validation_start)
        AND YEAR(PH.PAYMENT_START_DT) = YEAR(vd_placement_validation_start) ;--*/
         AND date_part('month', PH.PAYMENT_START_DT) = date_part('month', vd_placement_validation_start) 
     AND date_part('YEAR', PH.PAYMENT_START_DT)  = date_part('YEAR', vd_placement_validation_start);--

       IF vl_final_payment_cnt = 0 THEN
   
        -- Create payment detail for RFC
        IF vl_csrfc_unit_no is NOT NULL AND vl_csrfc_unit_no > 0 THEN
          vd_service_start_dt := vd_csrfc_service_st_dt;--
          vd_service_end_dt := vd_csrfc_service_end_dt;          --
          vl_unit_no := vl_csrfc_unit_no;--
          vs_unit_type := vs_csrfc_unit_type; --
          vdc_gross_amount := vdc_csrfc_gross_amount - vdc_csrfc_current_balance;--
          vdc_perdiem_rate := vdc_csrfc_perdiem_rate;--
          vs_room_board := '5670' ; -- Room & Board/Clothing
    
         SELECT a.al_sqlcode, a.as_error from  SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
            vl_payment_id,
            vl_rate_structure_id,
            vd_service_start_dt,
            vd_service_end_dt,
            vdc_gross_amount,
            vl_unit_no,
            vs_unit_type,
            vdc_perdiem_rate,
            vs_draft_final_type,
            vs_room_board,
            vl_linked_pymnt_hdr_id,
            vl_reference_payment_detail_id,
            vs_change_type) a INTO
            al_sqlcode,
            as_error;--

         IF al_sqlcode <> 0 THEN
           vs_identity_column := 'Placement ID';--
           vs_identity_val := TO_CHAR(vl_placement_id);--
           as_error := as_error || ' (SP-5AAF)' ;--
          IF as_error is NULL OR as_error = '' THEN
            as_error := 'SP_PAYMENT_DETAIL_INSERT failed for CSRFC. (SP-5AAF)'  ;--
          END IF;--
          --SIGNAL p_sp_error  ;--
         END IF ;--
        END IF;--
    
        -- Create payment detail for RFCD
        IF vl_csrfcd_unit_no is NOT NULL AND vl_csrfcd_unit_no > 0 THEN
          vd_service_start_dt := vd_csrfcd_service_st_dt;--
          vd_service_end_dt := vd_csrfcd_service_end_dt;--
          vl_unit_no := vl_csrfcd_unit_no;--
          vs_unit_type := vs_csrfcd_unit_type;--
          vdc_gross_amount :=  vdc_csrfcd_gross_amount  -  vdc_csrfcd_current_balance;--
          vdc_perdiem_rate := vdc_csrfcd_perdiem_rate;--
          vs_room_board := '5671'; -- Room & Board/Clothing/Differential  
     
         SELECT a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
            vl_payment_id,
            vl_rate_structure_id,
            vd_service_start_dt,
            vd_service_end_dt,
            vdc_gross_amount,
            vl_unit_no,
            vs_unit_type,
            vdc_perdiem_rate,
            vs_draft_final_type,
            vs_room_board,
            vl_linked_pymnt_hdr_id,
            vl_reference_payment_detail_id,
            vs_change_type) a INTO
            al_sqlcode,
            as_error;--

         IF al_sqlcode <> 0 THEN
           vs_identity_column := 'Placement ID';--
           vs_identity_val := TO_CHAR(vl_placement_id);--
           as_error := as_error || ' (SP-5BAF)' ;--
          IF as_error is NULL OR as_error = '' THEN
            as_error := 'SP_PAYMENT_DETAIL_INSERT failed for CSRFCD. (SP-5BAF)'  ;--
          END IF;--
          --SIGNAL p_sp_error  ;--
         END IF ;   --
        END IF;--
       ELSE
         vdc_gross_amount := ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) - ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance );--
   
        IF vl_csrfcd_unit_no is NOT NULL AND vl_csrfcd_unit_no > 0
          AND vdc_csrfcd_gross_amount > vdc_csrfcd_current_balance THEN
          vd_service_start_dt := vd_csrfcd_service_st_dt;--
          vd_service_end_dt := vd_csrfcd_service_end_dt;--
          vl_unit_no := vl_csrfcd_unit_no;--
          vs_unit_type := vs_csrfcd_unit_type;--
          vdc_perdiem_rate := vdc_csrfcd_perdiem_rate;--
          vs_room_board := '5671'; -- Room & Board/Clothing/Differential
        ELSE -- vdc_csrfc_gross_amount > vdc_csrfc_current_balance
          vd_service_start_dt := vd_csrfc_service_st_dt;--
          vd_service_end_dt := vd_csrfc_service_end_dt;          --
          vl_unit_no := vl_csrfc_unit_no;--
          vs_unit_type := vs_csrfc_unit_type;          --
          vdc_perdiem_rate := vdc_csrfc_perdiem_rate;--
          vs_room_board := '5670' ; -- Room & Board/Clothing
         END IF;--
         
         vs_draft_final_type := 'F';--
   
        -- create payment detail id and insert record in payment detail
        SELECT a.al_sqlcode, a.as_error from SP_PAYMENT_DETAIL_INSERT(vl_placement_id,
           vl_payment_id,
           vl_rate_structure_id,
           vd_service_start_dt,
           vd_service_end_dt,
           vdc_gross_amount,
           vl_unit_no,
           vs_unit_type,
           vdc_perdiem_rate,
           vs_draft_final_type,
           vs_room_board,
           vl_linked_pymnt_hdr_id,
           vl_reference_payment_detail_id,
           vs_change_type) a INTO
           al_sqlcode,
           as_error;--

        IF al_sqlcode <> 0 THEN
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
          as_error := as_error || ' (SP-5AF)' ;--
         IF as_error is NULL OR as_error = '' THEN
           as_error := 'SP_PAYMENT_DETAIL_INSERT failed. (SP-5AF)'  ;--
         END IF;--
         --SIGNAL p_sp_error  ;--
        END IF ;--
       END IF;--
       -- Check final payment for the placement/month - END
   
       -- UPDATE TB_PLACEMENT FOR Maintenance Payment if exist, Else Last Adjustment Payment - START
       IF vl_final_pay_count = 0 THEN
        /*UPDATE TB_PLACEMENT
         SET PAYMENT_HEADER_ID = vl_payment_id,
          UPDATE_TS = CURRENT_TIMESTAMP
        WHERE PLACEMENT_ID = vl_placement_id;--*/
       UPDATE PLACEMENT
        SET paymentheaderid = vl_payment_id,
         updatedon = CURRENT_TIMESTAMP
        WHERE alternateid = vl_placement_id;--

         al_sqlcode := SQLCODE;--
        IF al_sqlcode <> 0 THEN
          as_error := 'Error in Updating PLACEMENT - PAYMENT HEADER ID. (SQL-1AA)'  ;--
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
         --SIGNAL p_sp_error  ;--
        END IF;--
       END IF;--
       -- UPDATE TB_PLACEMENT FOR Maintenance Payment if exist, Else Last Adjustment Payment - END
      ELSE -- Receivable
      
        vl_receivable_provider_id :=  vl_provider_id;--
        vdc_receivable_amount := ( vdc_csrfc_current_balance + vdc_csrfcd_current_balance ) - ( vdc_csrfc_gross_amount + vdc_csrfcd_gross_amount ) ;--
        vl_payment_detail_id := 0;-- INITIAL VALUE 

       IF vl_reference_payment_detail_id is NOT NULL AND vl_reference_payment_detail_id > 0 THEN
         vl_payment_detail_id := vl_reference_payment_detail_id;--
       END IF;--

       IF vl_payment_detail_id = 0 OR vl_payment_detail_id is NULL THEN
         as_error := 'No PAYMENT_DETAIL_ID found for Receivable. (County Specific Room & Board)'  ;--
        -- PRJ-03018 - Commented
        --IF vl_payment_id > 0 THEN
        -- SET vs_identity_column = 'Placement ID / Payment ID';--
        -- SET vs_identity_val = CHAR(vl_placement_id) || '/ ' || CHAR(vl_payment_id);--
        --ELSE
          vs_identity_column := 'Placement ID';--
          vs_identity_val := TO_CHAR(vl_placement_id);--
        --END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;--

       IF vl_csrfcd_unit_no is NOT NULL AND vl_csrfcd_unit_no > 0
         AND vdc_csrfcd_current_balance > vdc_csrfcd_gross_amount THEN
         vd_service_start_dt := vd_csrfcd_service_st_dt;--
         vd_service_end_dt := vd_csrfcd_service_end_dt;--
       ELSE -- vdc_csrfc_current_balance > vdc_csrfc_gross_amount
         vd_service_start_dt := vd_csrfc_service_st_dt;--
         vd_service_end_dt := vd_csrfc_service_end_dt;          --
       END IF;--

       SELECT a.al_sqlcode,a.as_error from  SP_OVER_PAYMENT (vl_payment_detail_id,
             vl_client_id,
             vl_receivable_provider_id,
             vd_service_start_dt,
             vd_service_end_dt,
             vdc_receivable_amount,
             vs_change_type) a INTO
             al_sqlcode,
             as_error;--

       IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Provider ID / Client ID';--
         vs_identity_val := TO_CHAR(vl_receivable_provider_id) || '/' || TO_CHAR(vl_client_id);--
         as_error := as_error || ' (SP-5AG)' ;--
        IF as_error is NULL OR as_error = '' THEN
          as_error := 'SP_OVER_PAYMENT failed. (SP-5AG)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
       END IF ;  --
      END IF;--
      -- PAYABLE / RECEIVABLE - END
     
     END IF; -- New condition CIS-18884 - END
    ELSE -- Case vl_rate_structure_id = 13 (Emergency Foster Home Care)
     --- NO OF DAYS calculation for EFC or/and RFC- START
     --New SP for 60 days calculation, to return days in EFC and/or RFC for payments  
     -- INTIAL VALUES
      vd_efc_service_st_dt := NULL;--
      vd_efc_service_end_dt := NULL;--
      vl_efc_unit_no := NULL;--
      vs_efc_unit_type := NULL;--
      vd_rfc_service_st_dt := NULL;--
      vd_rfc_service_end_dt := NULL;--
      vl_rfc_unit_no := NULL;--
      vs_rfc_unit_type := NULL;--

      vl_efc_calc_days := 60;--

     SELECT a.ad_efc_service_st_dt,
      a.ad_efc_service_end_dt,
      a.al_efc_unit_no,
      a.as_efc_unit_type,
      a.ad_rfc_service_st_dt,
      a.ad_rfc_service_end_dt,
      a.al_rfc_unit_no,
      a.as_rfc_unit_type FROM  F_SP_EFC_DAYS_CALCULATION( 'R',
        vl_rate_structure_id,
        vd_place_entry_dt,
        vd_place_exit_dt,
        vd_placement_validation_start,
        vd_placement_validation_end,
        vl_efc_calc_days) a INTO
        vd_efc_service_st_dt,
        vd_efc_service_end_dt,
        vl_efc_unit_no,
        vs_efc_unit_type,
        vd_rfc_service_st_dt,
        vd_rfc_service_end_dt,
        vl_rfc_unit_no,
        vs_rfc_unit_type;--

     IF vd_efc_service_st_dt is NOT NULL THEN
         vd_service_start_dt := vd_efc_service_st_dt ;--
     ELSE
         vd_service_start_dt := vd_rfc_service_st_dt ;--
     END IF;--

     IF vd_rfc_service_end_dt is NOT NULL THEN
         vd_service_end_dt := vd_rfc_service_end_dt;--
     ELSE
         vd_service_end_dt := vd_efc_service_end_dt;--
     END IF;--
     --- NO OF DAYS calculation for EFC or/and RFC- END
   
     --EFC - START
   
     --- EFC -  HOW MUCH WE WERE SUPPOSE TO PAY - START
      vdc_monthly_rate := 0.00; -- INTIAL VALUE
      vdc_perdiem_rate := 0.00; -- INTIAL VALUE
      vdc_gross_amount := 0.00; -- Initial Value
      vs_draft_final_type := 'F'; -- only final amount will be entered

     IF vl_efc_unit_no is NOT NULL AND vl_efc_unit_no > 0 THEN
      SELECT a.adc_gross_amount,a.adc_per_diem_rate,a.al_sqlcode,a.as_error from SP_GET_PLACEMENT_RATE (vl_rate_structure_id,
       vl_age_of_child,vd_efc_service_st_dt,vd_efc_service_end_dt,vs_rate_type_cd) a INTO
       vdc_monthly_rate,vdc_perdiem_rate, al_sqlcode, as_error;--

      IF al_sqlcode <> 0 THEN
        vs_identity_column := 'Rate Structure ID';--
        vs_identity_val := TO_CHAR(vl_rate_structure_id);--
        as_error := as_error || ' (SP-5A)' ;--
       IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_GET_PLACEMENT_RATE failed. (SP-5A)'  ;--
       END IF;--
       --SIGNAL p_sp_error  ;--
      END IF ;--

      IF vl_efc_unit_no = 1 and vs_efc_unit_type = '5611' THEN  -- monthly rate
         IF vd_efc_service_end_dt = vd_placement_validation_end and (vd_efc_service_end_dt <> vd_place_exit_dt or vd_place_exit_dt is null) THEN
        --SELECT  DAY(F_daymonth(vd_placement_validation_start ,'L', 'P' )) - 1
        SELECT date_part('day', F_daymonth(vd_placement_validation_start ,'L', 'P' ))-1
          INTO vl_no_of_days;
        --FROM sysibm.sysdummy1;--

         vdc_gross_amount := vdc_perdiem_rate * (vl_no_of_days + 1);--
         vdc_perdiem_rate := COALESCE(vdc_gross_amount,0);--
         vdc_monthly_rate := COALESCE(vdc_gross_amount,0);--
         ELSE
         vdc_gross_amount := vdc_monthly_rate;--
         vdc_perdiem_rate := vdc_monthly_rate;--
         vdc_monthly_rate := COALESCE(vdc_monthly_rate,0);--
       END IF;--
      ELSE
        vdc_gross_amount := vdc_perdiem_rate * vl_efc_unit_no;--
      END IF;--
     END IF;--
     --- EFC -  HOW MUCH WE WERE SUPPOSE TO PAY - END

     --- EFC - CHECK CURRENT BALANCE - START
      vdc_current_balance := 0;--
      vl_linked_pymnt_hdr_id := NULL; -- INITIAL VALUE
      vl_reference_payment_detail_id := NULL; -- INITIAL VALUE
   
     -- RESET Room & Board Rate Type cd - CIS-19002  
      vs_room_board := '1232'; -- Room & Board 
   
     SELECT a.al_linked_pymnt_hdr_id,a.al_reference_payment_detail_id,a.adc_current_balance,a.al_sqlcode,a.as_error FROM SP_GET_CURRENT_BALANCE(vl_placement_id,
          vd_service_start_dt,
          vd_service_end_dt,
          vs_room_board,
          vd_placement_validation_start,
          vl_rate_structure_id) a INTO
          vl_linked_pymnt_hdr_id,
          vl_reference_payment_detail_id,
          vdc_current_balance,
          al_sqlcode,
          as_error;--

     IF al_sqlcode <> 0 THEN
         vs_identity_column := 'Placement ID';--
         vs_identity_val := TO_CHAR(vl_placement_id);--
         as_error := as_error || ' (SP-5B)' ;--
        IF as_error is NULL OR as_error = '' THEN
         as_error := 'SP_GET_CURRENT_BALANCE failed. (SP-5B)'  ;--
        END IF;--
        --SIGNAL p_sp_error  ;--
     END IF ;--

     IF vl_linked_pymnt_hdr_id = 0 THEN
         vl_linked_pymnt_hdr_id := NULL;--
         vl_reference_payment_detail_id := NULL;--
     END IF;--
     --- EFC - CHECK CURRENT BALANCE - END  
   
     -- EFC - CHECK IF THE DRAFT PAYMENT IS ALREADY GENERATED FOR THIS PLACEMENT - START
      vl_orig_payment_id := 0; -- INITIAL VALUE

     IF vl_linked_pymnt_hdr_id is NOT NULL AND vl_linked_pymnt_hdr_id > 0 THEN
         vl_orig_payment_id := vl_linked_pymnt_hdr_id;--
     END IF;--

     IF vl_orig_payment_id IS NULL THEN
         vl_orig_payment_id := 0;--
     END IF;--
     -- EFC - CHECK IF THE DRAFT PAYMENT IS ALREADY GENERATED FOR THIS PLACEMENT - END

     -- EFC -  CHECK IS FINAL PAYMENT IS GENERATED FOR THESE DRAFT - START
      vl_final_pay_count = 0; -- INITIAL VALUE
     IF vl_orig_payment_id > 0 THEN
        SELECT COUNT(*)
         INTO vl_final_pay_count
       FROM TB_PAYMENT_DETAIL
        WHERE PAYMENT_ID = vl_orig_payment_id
       AND PLACEMENT_ID = vl_placement_id
       AND FINAL_RATE_TYPE_CD = vs_room_board
       AND FINAL_SERVICE_ID IS NOT NULL;--
     END IF; --
     -- EFC -  CHECK IS FINAL PAYMENT IS GENERATED FOR THESE DRAFT - END

     -- EFC -  TAKE FIRST ADJUSTMENT ID - START
     -- This or Original Payment ID will be always there in case of current status is Receivable
      vl_adjust_payment_id := 0; -- INITIAL VALUE

     SELECT MIN(PH.PAYMENT_ID)
      INTO vl_adjust_payment_id
        FROM TB_PAYMENT_HEADER PH,
         TB_PAYMENT_DETAIL PD
       WHERE  PH.PAYMENT_ID = PD.PAYMENT_ID
       AND PH.PROVIDER_ID = vl_provider_id
       AND PH.PAYMENT_DT = CURRENT_DATE
       AND PH.PAYMENT_TYPE_CD = '3294'
       AND PD.PLACEMENT_ID IS NOT NULL
       AND PH.MANUAL_SW = 'N'
       AND PH.DELETE_SW = 'N'
       AND PD.DELETE_SW = 'N'
      /* AND MONTH(PH.PAYMENT_START_DT) = MONTH(vd_placement_validation_start)
       AND YEAR(PH.PAYMENT_START_DT) = YEAR(vd_placement_validation_start)*/
       AND date_part('month', PH.PAYMENT_START_DT) = date_part('month', vd_placement_validation_start) 
          AND date_part('YEAR', PH.PAYMENT_START_DT)  = date_part('YEAR', vd_placement_validation_start)--
       AND PD.COUNTY_CD =  vs_county_cd
       AND PD.CLIENT_ID = vl_client_id ;--

     IF vl_adjust_payment_id IS NULL THEN
         vl_adjust_payment_id := 0; --
     END IF;--
     -- EFC -  TAKE FIRST ADJUSTMENT ID - END

     -- PRJ-03018 - Commented
     -- EFC -  SET REFERNCE PAYMENT ID FOR RECEIVABLE - START
 --    SET vl_payment_id = 0; -- INITIAL VALUE
 --    IF vl_final_pay_count > 0 THEN
 --       SET vl_payment_id = vl_orig_payment_id;  --
 --    ELSE
 --       SET vl_payment_id = vl_adjust_payment_id;  --
 --    END IF;--
     -- EFC -  SET REFERNCE PAYMENT ID FOR RECEIVABLE - END

     -- PRJ-03018 - New code
     -- SET REFERNCE PAYMENT ID FOR PAYABLE - START
      vl_payment_id := 0; -- INITIAL VALUE
     IF vl_adjust_payment_id > 0 THEN
         vl_payment_id := vl_adjust_payment_id; --
     END IF;--
     -- SET REFERNCE PAYMENT ID FOR PAYABLE - END
     
     -- EFC - PAYABLE / RECEIVABLE - START
