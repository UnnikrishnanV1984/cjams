CREATE OR REPLACE FUNCTION sp_list_eligibility_events(v_client_id integer, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, entered_by character varying, eligibility_id integer, start_dt timestamp without time zone, end_dt timestamp without time zone, eligibility_type_cd character varying, eligibility_status_cd character varying, eligibility_type text, eligibility_status text, client_id bigint, client_name character varying, client_dob timestamp without time zone, ssn character varying, client_gender character varying, case_id character varying, case_nm character varying, case_worker_id bigint, case_worker_name character varying, case_worker_phone_no character varying, local_dept character varying, county_cd text, events json)
 LANGUAGE plpgsql
AS $function$

declare
 v_pagenumber int;
 v_pageoffset int;
 
BEGIN 
 v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

return query select count(1) over(),up1.fullname,tce.eligibility_id,tce.start_dt,tce.end_dt,trim(tce.eligibility_type_cd) :: character varying,tce.eligibility_status_cd
,(select trim(value_tx) from tb_picklist_values where TRIM(lower(picklist_value_cd)) = TRIM(lower(tce.eligibility_type_cd)) AND PICKLIST_type_id=207 AND delete_sw='N' AND active_sw='Y') as  eligibility_type  ,
(select trim(value_tx) from tb_picklist_values where  TRIM(lower(picklist_value_cd)) = TRIM(lower(tce.eligibility_status_cd)) AND PICKLIST_type_id=208 AND delete_sw='N' AND active_sw='Y') as  eligibility_status ,
P.cjamspid as client_ids, 
 CAST(INITCAP(TRIM(P.firstname)||' '||TRIM(P.lastname) ||
 CASE WHEN P.middlename IS NOT NULL AND TRIM(P.middlename) != '' THEN ', ' || TRIM(P.middlename) ELSE '' END)as character varying) as client_names, 
        P.dob as client_dob
 ,PIDE.personidentifiervalue as ssn
 ,GT.typedescription as client_gender  
 ,ISR.servicerequestnumber as case_id 
 ,ISRT.description as case_nm
 ,up.cjamspid as case_worker_id
 ,up.displayname as case_worker_name
 ,uppn.phonenumber as case_worker_phone_no
 ,upa.county as local_dept
 ,(select trim(PICKLIST_VALUE_CD) from tb_picklist_values where TRIM(lower(value_tx)) like TRIM(lower('%' || upa.county || '%')) AND PICKLIST_type_id=104 AND delete_sw='N' AND active_sw='Y') as  county_cd  ,
(select json_agg(x) from (select event_id,create_ts as entry_dt,up2.fullname as entered_by, tsse.start_dt, tsse.end_dt,
event_type_cd, status_cd, notes_tx, 
(select trim(value_tx) from tb_picklist_values where TRIM(lower(picklist_value_cd)) = TRIM(lower(event_type_cd)) AND PICKLIST_type_id=206 AND delete_sw='N' AND active_sw='Y') as  event_type  ,
(select trim(value_tx) from tb_picklist_values where  TRIM(lower(picklist_value_cd)) = TRIM(lower(status_cd)) AND PICKLIST_type_id=208 AND delete_sw='N' AND active_sw='Y') as  status ,
status_change_sw, tsse.eligibility_id,tsse.delete_sw
from tb_ssi_eligibility_events tsse 
left JOIN userprofile up2 on up2.securityusersid=tsse.create_user_id  and up.activeflag =1 
where tsse.eligibility_id=tce.eligibility_id)as x) as events
from tb_client_eligibility tce 
 join person P on p.cjamspid=tce.client_id
   JOIN tb_placement pl ON P.cjamspid=pl.client_id and pl.delete_sw='N'
   JOIN gendertype as GT ON GT.gendertypekey = p.gendertypekey and GT.activeflag =1
   JOIN actor as actor ON actor.personid=P.personid and actor.activeflag =1
   JOIN intakeservicerequestactor as inseract ON inseract.actorid=actor.actorid and inseract.activeflag =1 and lower(inseract.intakeservicerequestpersontypekey)='rc'
   JOIN intakeservicerequest as ISR ON ISR.intakeserviceid=inseract.intakeserviceid and ISR.activeflag =1
   JOIN IntakeServiceRequestType ISRT ON ISRT.intakeservreqtypeid=ISR.intakeservreqtypeid and ISRT.activeflag =1
         JOIN routing rr on rr.objectid=isr.intakeserviceid :: character varying and rr.toroleid='CWCW' and rr.activeflag =1
         JOIN userprofile up on up.securityusersid=rr.tosecurityusersid  and up.activeflag =1
        LEFT join userprofilephonenumber uppn on up.securityusersid=uppn.securityusersid and uppn.userprofiletypekey='office' and uppn.activeflag =1
        LEFT join userprofileaddress upa on up.securityusersid=upa.securityusersid  and upa.activeflag =1 
        LEFT JOIN personidentifier as PIDE ON PIDE.personid=P.personid and PIDE.activeflag =1
        left JOIN userprofile up1 on up1.securityusersid=tce.create_user_id  and up.activeflag =1
  where tce.client_id=v_client_id and tce.delete_sw='N' AND pl.placement_id=(SELECT MAX(PLA.placement_id) from tb_placement PLA where PLA.client_id=P.cjamspid and PLA.delete_sw='N')
-- AND ISR.servicerequestnumber=pl.case_id::character varying
 AND p.activeflag =1 
 group by 
 up1.fullname,tce.eligibility_id,tce.start_dt,tce.end_dt,tce.eligibility_type_cd,tce.eligibility_status_cd
, eligibility_type  ,
 eligibility_status ,
P.cjamspid, 
  client_names, 
        P.dob 
 ,PIDE.personidentifiervalue  
 ,GT.typedescription   
 ,ISR.servicerequestnumber   
 ,ISRT.description  
 ,up.cjamspid  
 ,up.displayname  
 ,uppn.phonenumber 
 ,upa.county 
 , county_cd ,up.activeflag 
 ;


END;

$function$

