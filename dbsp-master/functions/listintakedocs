CREATE OR REPLACE FUNCTION listintakedocs(intakenumber character varying, skipno integer, pagesize integer)
 RETURNS TABLE(totalcount bigint, intakedocumentid uuid, documenttemplatekey character varying, versionno integer, documentpath character varying, insertedon timestamp without time zone, insertedby character varying)
 LANGUAGE plpgsql
AS $function$

declare v_intakenumber character varying = null;
BEGIN
 v_intakenumber:= intakenumber;
 
    Return Query
 select count(1) over() totalcount, ido.Intakedocumentid, ido.documenttemplatekey, ido.versionno, ido.documentpath, ido.insertedon, up.fullname as insertedby from (
 select max(id1.versionno) versionno, id1.documenttemplatekey
 from Intakedocument id1 where id1.intakenumber = v_intakenumber
 group by id1.documenttemplatekey
 ) a Join Intakedocument ido on a.versionno = ido.versionno and a.documenttemplatekey = ido.documenttemplatekey
 and ido.intakenumber = v_intakenumber
 Left Join Userprofile up on up.securityusersid = ido.insertedby
 order by ido.documenttemplatekey
 limit pagesize offset skipno;
    
  end;

$function$

