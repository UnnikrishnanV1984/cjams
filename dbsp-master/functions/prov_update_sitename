CREATE OR REPLACE FUNCTION prov_update_sitename(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare
 v_securityuserid character varying;
 i json;
 v_randomuuid uuid;
 v_sitename character varying;
 v_siteid character varying;
 v_old_sitename  character varying;

begin
v_securityuserid:=insertobj->>'securityuserid';
v_sitename:=insertobj->>'site_name';
v_siteid:=insertobj->>'site_id';
IF v_siteid is not NULL THEN
  select provider_nm into v_old_sitename from tb_provider where  provider_id = v_siteid;

  UPDATE tb_provider SET
  provider_nm = v_sitename, update_ts = now(), update_user_id = v_securityuserid
  WHERE provider_id = v_siteid;

  INSERT INTO sitename_history
  (site_id, old_site_name, new_site_name, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
  VALUES(v_siteid::int, v_old_sitename, v_sitename, now(), v_securityuserid, now(), v_securityuserid, 'N');

  return 'success';
Else
  return 'failure';

end if;
       
 end;  
 $function$

