CREATE OR REPLACE FUNCTION getintakeadministrativeoverride(intakenumber character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                          
 DECLARE
 overrides  json;
                                                                                                                                                                                                                                                                         
 begin
 select json_agg(x) into overrides from (
  select (select fullname from userprofile where securityusersid = ao.overridestaffid)fullname, ao.overridedate, ao.overridereasontypekey, ao."comments", ao.intakeapproveddate, ao.referralsnapshotid
   from administrativeoverrides ao
   where ao.entityid = intakenumber
   order by ao.insertedon)x;
  return overrides;
 END;                                                                                                                                                                                                                                                                    

$function$

