 v1_intakeserviceid   varchar(50);
 v1_prev_intakeserviceid  varchar(50);
 v1_prev_rptid    varchar(50);
 v1_cjamspid     INTEGER;
 v1_prev_chid    varchar(12);
 v1_reporteddate    date;
 v1_reportdate    timestamp without time zone;
 v1_p_personid    varchar(50);
 vl_output_sqlcode   INTEGER;
 v1_count     INTEGER;
