CREATE OR REPLACE FUNCTION sp_ncands_child_data_insert(vdt_from character varying, vdt_to character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- Date Created: 11/24/2020
-- Description: To generate NCANDS Data

-- Revision(s):
-- 12/21/2020 - Vineet Tirodkar - Modifications for 1st CJAMS NCANDS run
-- 01/08/2021 - Vineet Tirodkar - Modifications for MD.MALDEATH reporting 
-- 01/12/2021 - Vineet Tirodkar - Modifications to remove investigationfinding table for non Victim under CPS-ARs  
-- 03/29/2021 - Vineet Tirodkar - Modifications to send the complete Case ID values (servicerequestnumbers) for f_afcars_encrypt function 
-- 12/28/2021 - Vineet Tirodkar - Modifications to fix Order by & Distinct Issue (Due to DB 10.8 upgrade - CIDM-4132)
