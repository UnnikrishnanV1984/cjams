         inve.intakeserviceid = v1_intakeserviceid::UUID 
          else
         ( case when length(inve.old_id)>10 then 
          -- substring(inve.old_id,6) = v1_caseid
          inve.old_id = v1_caseid
         else 
          substring(inve.old_id,3) = v1_caseid 
         end)
          end )
       AND invm.timeofincidence IS NOT NULL limit 1;
   
     END IF;
        
     -- RAISE NOTICE 'Additional Info Element #150 %', timeofday();   
     vl_FCDCHDT := NULL;
     IF (V1_REMOVALDATE IS NOT NULL) THEN
      SELECT  distinct  lpad(extract(month from icr.exitdate )::varchar,2,'0')||lpad(extract(day from icr.exitdate )::varchar,2,'0')||extract(year from icr.exitdate )::varchar
       INTO vl_FCDCHDT
      FROM intakeservreqchildremoval icr 
      where icr.personid = v1_p_personid::UUID  
       AND icr.exitdate IS NOT NULL
       AND icr.exitdate >= V1_REMOVALDATE 
       AND icr.exitdate > V1_STATUS_DATE 
       AND icr.exitdate <= v1_to_date 
       AND ((icr.intakeserviceid IS NOT NULL AND icr.intakeserviceid = v1_intakeserviceid::UUID)
        OR 
        (icr.servicecaseid IS NOT NULL AND icr.servicecaseid = V1_SERVICE_CASE_ID)) 
        and icr.removaldate::date = V1_REMOVALDATE
      limit 1; 
     END IF;
    
     -- RAISE NOTICE 'BEFORE INSERT INTO ncands_work_perp %', timeofday(); 
     insert into ncands_work_perp
      ( CHID,    RPTID,    WRKRID,   SUPRVID,   PER1ID,   PER1REL,   PER1PRNT,   PER1CR,
       PER1AGE,   PER1SEX,   P1RACAI,   P1RACAS,   P1RACBL,   P1RACNH,   P1RACWH,   P1RACUD,
       PER1ETHN,   PER1MIL,   PER1PIOR,   PER1MAL1,  PER1MAL2,   PER1MAL3,   PER1MAL4,   PER2ID,
       PER2REL,    PER2PRNT,   PER2CR,   PER2AGE,   PER2SEX,   P2RACAI,   P2RACAS,   P2RACBL,
       P2RACNH,   P2RACWH,   P2RACUD,   PER2ETHN,   PER2MIL,   PER2PIOR,   PER2MAL1,   PER2MAL2,
       PER2MAL3,   PER2MAL4,   PER3ID,   PER3REL,   PER3PRNT,   PER3CR,   PER3AGE,   PER3SEX,
       P3RACAI,   P3RACAS,   P3RACBL,   P3RACNH,   P3RACWH,    P3RACUD,   PER3ETHN,   PER3MIL,
       PER3PIOR,   PER3MAL1,   PER3MAL2,   PER3MAL3,   PER3MAL4,   AFCARSID,   INCIDDT,   RPTTM ,
       INVSTRTM,   DEATHDT,   FCDCHDT
      )
     values
      ( vl_chid,   vl_rptid,   vl_WRKRID,   vl_SUPRVID,  vl_PER1ID,   vl_PER1REL,  vl_PER1PRNT,  vl_PER1CR,
       vl_PER1AGE,  vl_PER1SEX,  vl_P1RACAI,  vl_P1RACAS,  vl_P1RACBL,  vl_P1RACNH,  vl_P1RACWH,  vl_P1RACUD,
       vl_PER1ETHN,  vl_PER1MIL,  vl_PER1PIOR,  vl_PER1MAL1,  vl_PER1MAL2,  vl_PER1MAL3,  vl_PER1MAL4,  vl_PER2ID,
       vl_PER2REL,  vl_PER2PRNT,  vl_PER2CR,   vl_PER2AGE,  vl_PER2SEX,  vl_P2RACAI,  vl_P2RACAS,  vl_P2RACBL,
       vl_P2RACNH,  vl_P2RACWH,  vl_P2RACUD,  vl_PER2ETHN,  vl_PER2MIL,  vl_PER2PIOR,  vl_PER2MAL1,  vl_PER2MAL2,
       vl_PER2MAL3,  vl_PER2MAL4,  vl_PER3ID,   vl_PER3REL,  vl_PER3PRNT,  vl_PER3CR,  vl_PER3AGE,  vl_PER3SEX,
       vl_P3RACAI,  vl_P3RACAS,  vl_P3RACBL,  vl_P3RACNH,  vl_P3RACWH,   vl_P3RACUD,  vl_PER3ETHN,  vl_PER3MIL,
       vl_PER3PIOR,  vl_PER3MAL1,  vl_PER3MAL2,  vl_PER3MAL3,  vl_PER3MAL4,  vl_chid,   vl_INCIDDT,  vl_RPTTM ,
       vl_INVSTRTM,  vl_DEATHDT,  vl_FCDCHDT
      );

      v1_prev_intakeserviceid := v1_intakeserviceid;
    
     EXCEPTION WHEN OTHERS THEN 
      vl_output_sqlcode := SQLSTATE;
      RAISE NOTICE 'NCANDS PERPETRATOR DATA - INSERT FAILED, %', vl_output_sqlcode;
    END;

   END IF; -- Do not Process - END
  
  end loop;
              
  close vl_child_dt;
 END;

 RAISE NOTICE 'NCANDS CHILD DATA - PROCESS ENDS %', timeofday();
 return 'success';
       
END;

