    ---- ***********************************************************  CAREGIVER INFO STARTS HERE  ******************************************************************************************** 
    ---- ****************************************************************************************************************************************************************************************** 
    --  RAISE NOTICE 'Care Giver Data % % at %', v1_cjamspid, vl_chid, timeofday();
    BEGIN
     IF (v1_intakeserviceid != v1_prev_intakeserviceid) THEN
      
      -- RAISE NOTICE 'Caregiver Element #44 #45 #52 #53 #54 %', timeofday();         
      IF vs_expung_sw = 'N' THEN
       SELECT case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey in ('AACR','AUCT') ) > 0 then '1' else '2'  end,
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey in ('DACT','DUCT') ) > 0 then '1' else '2'  end,
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey='DVE' ) > 0 then '1' else '2'   end, 
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey='IHG' ) > 0 then '1' else '2'   end, 
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey='Financial' ) > 0 then '1' else '2'   end
       INTO  vl_FCALC,
         vl_FCDRUG,
         vl_FCVIOL,
         vl_FCHOUSE,
         vl_FCMONEY
       from investigation INV 
        join investigationallegation INVA ON INV.investigationid=INVA.investigationid 
         and INVA.activeflag=1 
        join investigationallegationcharacterstics INVAC ON INVAC.investigationallegationid=INVA.investigationallegationid 
         and INVAC.activeflag=1
       where INV.intakeserviceid=v1_intakeserviceid::UUID 
        and INV.activeflag=1 ;        
      ELSE
       SELECT case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey in ('AACR','AUCT') ) > 0 then '1' else '2'  end,
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey in ('DACT','DUCT') ) > 0 then '1' else '2'  end,
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey='DVE' ) > 0 then '1' else '2'   end, 
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey='IHG' ) > 0 then '1' else '2'   end, 
         case when COUNT(*) FILTER (WHERE INVAC.maltreatmentcharactersticstypekey='Financial' ) > 0 then '1' else '2'   end
       INTO  vl_FCALC,
         vl_FCDRUG,
         vl_FCVIOL,
         vl_FCHOUSE,
         vl_FCMONEY
       from investigation INV 
        join investigationallegation INVA ON INV.investigationid=INVA.investigationid 
         and INVA.activeflag=1 
        join investigationallegationcharacterstics INVAC ON INVAC.investigationallegationid=INVA.investigationallegationid 
         and INVAC.activeflag=1
       where ( case when length(INV.old_id)>10 then 
          -- substring(INV.old_id,6) = v1_caseid
          INV.old_id = v1_caseid
         else 
          substring(INV.old_id,3) = v1_caseid
         end
          )
        -- and INV.activeflag=1 
        ;   
      END IF;
     
      -- RAISE NOTICE 'Caregiver Element #55 %', timeofday();
      SELECT case when COUNT(*) FILTER (WHERE pi.incomesourcetypekey IN ('SSR','TANF','UC','IVEP','TXM')) > 0 then '1' 
         when COUNT(*) FILTER (WHERE pi.incomesourcetypekey IN ('CS','IFSP','NRI','PEN','RRB','RCC','SEE','SLB','TIPS','VB','WS','DIN','FGL','GLFE','NE','NO','OTHE','OTHU','SIN','WIP')) > 0 then '2'
        else '9' 
        end
      INTO  vl_FCPUBLIC
      FROM  personincome  pi
       JOIN intakeservreqchildremoval ISCR ON pi.personid = ISCR.primarycaregiveractorid 
       WHERE (ISCR.intakeserviceid IS NOT NULL AND ISCR.intakeserviceid = v1_intakeserviceid::UUID)
         OR 
        (ISCR.servicecaseid IS NOT NULL AND ISCR.servicecaseid = V1_SERVICE_CASE_ID); 
           
     END IF;
     
     -- RAISE NOTICE 'Caregiver Element #46 #47 #48 #49 #50 #51 %', timeofday();         
      
     SELECT case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'INDIS' and  disabilityconditiontypekey='Yes') > 0 then '1' 
        when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'INDIS' and  disabilityconditiontypekey='No')  > 0 then '2'
        else '9' 
      end, 
      case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'EMDY' and  disabilityconditiontypekey='Yes') > 0 then '1' 
        when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'EMDY' and  disabilityconditiontypekey='No')  > 0 then '2'
       else '9' 
      end, 
      case  when COUNT(*) FILTER (WHERE (pd.diagnoiseddisabilitynotes like '%Learning%' or pd.comments like '%Learning%') and  disabilityconditiontypekey='Yes') > 0 then '1' 
       else '2' 
      end,
      case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey in ('VIDY','HDY') and  disabilityconditiontypekey='Yes') > 0 then '1' 
        when COUNT(*) FILTER (WHERE pd.disabilitytypekey in ('VIDY','HDY') and  disabilityconditiontypekey='No')  > 0 then '2'
       else '9' 
      end,
      case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'PYDY' and  disabilityconditiontypekey='Yes') > 0 then '1' 
        when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'PYDY' and  disabilityconditiontypekey='No')  > 0 then '2'
       else '9' 
      end, 
      case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey not in ('INDIS','EMDY','VIDY','HDY','PYDY') and  disabilityconditiontypekey='Yes') > 0 then '1' 
       else '2' 
      end

      INTO  vl_FCRTRD,
        vl_FCEMOTNL,
        vl_FCDLEARN,
        vl_FCVISUAL,
        vl_FCPHYS,
        vl_FCMEDICL
     FROM  person p
      JOIN intakeservreqchildremoval ISCR ON ISCR.personid = p.personid 
      JOIN persondisability  pd ON ISCR.primarycaregiveractorid =  pd.personid
     WHERE p.personid = v1_p_personid::UUID 
        and (p.activeflag = 1 OR (p.activeflag = 0 AND p.expungementflag = 1))
      AND ((ISCR.intakeserviceid IS NOT NULL AND ISCR.intakeserviceid = v1_intakeserviceid::UUID)
        OR 
        (ISCR.servicecaseid IS NOT NULL AND ISCR.servicecaseid = V1_SERVICE_CASE_ID)); 
    
     insert into ncands_caregiver   
      ( CHID, rptid, FCALC, FCDRUG, FCRTRD, FCEMOTNL, FCVISUAL,
        FCDLEARN, FCPHYS, FCMEDICL, FCVIOL, FCHOUSE, FCMONEY, FCPUBLIC   
      )
     values  
      ( vl_chid, vl_rptid, vl_FCALC, vl_FCDRUG, vl_FCRTRD, vl_FCEMOTNL, vl_FCVISUAL, 
        vl_FCDLEARN, vl_FCPHYS, vl_FCMEDICL, vl_FCVIOL, vl_FCHOUSE, vl_FCMONEY, vl_FCPUBLIC 
       );
       
     EXCEPTION WHEN OTHERS THEN 
      vl_output_sqlcode := SQLSTATE;
      RAISE NOTICE 'NCANDS CARE GIVER DATA - INSERT FAILED, %', vl_output_sqlcode;
    END;
     
    ---- ******************************************************************************************************************************************************************************************             
    ---- ***********************************************************  SERVICES INFO STARTS HERE  ******************************************************************************************** 
    ---- ******************************************************************************************************************************************************************************************     
     
    -- RAISE NOTICE 'Services Data % % at %', v1_cjamspid, vl_chid, timeofday();
    BEGIN
     
     -- RAISE NOTICE 'Services Element #60;

     SELECT case when COUNT(*) FILTER (WHERE programkey='OOH') > 0 then '1' else '2' end        
       INTO VL_FOSTERCR
     FROM PERSONPROGRAMAREA PPA
      JOIN PERSON P1 ON P1.PERSONID = PPA.PERSONID 
       and (P1.activeflag = 1 OR (P1.activeflag = 0 AND P1.expungementflag = 1))
      JOIN ACTOR A ON A.PERSONID = P1.PERSONID 
       AND PPA.OBJECTID::VARCHAR = a.intakeserviceid::VARCHAR 
       AND A.ACTIVEFLAG = 1
     WHERE PPA.OBJECTID = v1_intakeserviceid 
      and PPA.startdate <= V1_STATUS_DATE + interval '90' day
      and (PPA.enddate IS NULL OR PPA.enddate > V1_STATUS_DATE);               
     
     -- RAISE NOTICE 'Services Element #61 %', timeofday();
     V1_REMOVALDATE := NULL;
     VL_RMVDATE := NULL; 
     -- IF (VL_FOSTERCR = '1') THEN
     SELECT  distinct ISCR.REMOVALDATE::DATE,
      lpad(extract(month from ISCR.REMOVALDATE)::varchar,2,'0')||lpad(extract(day from ISCR.REMOVALDATE)::varchar,2,'0')||extract(year from ISCR.REMOVALDATE)::varchar 
      INTO V1_REMOVALDATE, VL_RMVDATE
     FROM   INTAKESERVREQCHILDREMOVAL ISCR
     WHERE ISCR.personid = v1_p_personid::UUID 
      AND ((ISCR.intakeserviceid IS NOT NULL AND ISCR.intakeserviceid = v1_intakeserviceid::UUID)
        OR 
       (ISCR.servicecaseid IS NOT NULL AND ISCR.servicecaseid = V1_SERVICE_CASE_ID)) 
      AND ISCR.REMOVALDATE is not null
      AND ISCR.REMOVALDATE between v1_reporteddate and V1_STATUS_DATE + interval '90' day 
     ORDER BY ISCR.REMOVALDATE::DATE desc
     limit 1;       
     -- END IF;

     -- RAISE NOTICE 'Services Element #62 #63 %', timeofday();
     VL_TEMP_DATE := null;
     VL_PETDATE := null;
     IF (V1_REMOVALDATE IS NOT NULL) THEN
      VL_JUVPET := '1';
      VL_PETDATE := VL_RMVDATE;
      VL_FOSTERCR := '1';
      SELECT min(isrp.petitiondate) 
       INTO  VL_TEMP_DATE
       FROM intakeservicerequestpetition isrp
       where ((isrp.intakeservicerequestid is not null and isrp.intakeservicerequestid = v1_intakeserviceid::UUID)
        or (isrp.servicecaseid is not null and isrp.servicecaseid = V1_SERVICE_CASE_ID))
       AND (ISRP.petitiondate between V1_REMOVALDATE AND V1_STATUS_DATE + interval '90' day);
       
      IF (VL_TEMP_DATE IS NOT NULL) THEN
       select min(lpad(extract(month from VL_TEMP_DATE)::varchar,2,'0')||
          lpad(extract(day from VL_TEMP_DATE)::varchar,2,'0')||
          extract(year from VL_TEMP_DATE)::varchar)::varchar 
        INTO VL_PETDATE;
      END IF;
     ELSE
      VL_JUVPET := 2;  
     END IF;
    
     IF (v1_intakeserviceid != v1_prev_intakeserviceid) THEN
     -- RAISE NOTICE 'Services Element #58, #59, #75';

      SELECT case when COUNT(*) FILTER (WHERE subprogramkey in ('ISP','CTPS','SFCC','CS','VPS')) > 0 then '1' else '2' end,
        case when COUNT(*) FILTER (WHERE subprogramkey in ('FPS','IFC','FNL1','FNL2','FNL3')) > 0 then '1' else '2' end,
        case when COUNT(*) FILTER (WHERE programkey ='IL') > 0 then '1' else '2' end
       INTO  VL_FAMSUP,
         VL_FAMPRES,
         VL_TRANSLIV_1
      FROM PERSONPROGRAMAREA PPA
       JOIN PERSON P1 ON P1.PERSONID = PPA.PERSONID 
        and (P1.activeflag = 1 OR (P1.activeflag = 0 AND P1.expungementflag = 1))
       JOIN ACTOR A ON A.PERSONID = P1.PERSONID 
        AND PPA.OBJECTID::VARCHAR = a.intakeserviceid::VARCHAR 
        AND A.ACTIVEFLAG = 1
      WHERE PPA.OBJECTID = v1_intakeserviceid 
       and PPA.startdate <= V1_STATUS_DATE + interval '90' day
       and (PPA.enddate IS NULL OR PPA.enddate > V1_STATUS_DATE);
               
      -- RAISE NOTICE 'Child Data - Element #64 % ', timeofday();      
      SELECT case when COUNT(*) > 0 then 1  else 2 end
       INTO VL_COCHREP
      from collateral isra2  
      where  isra2.caseid = v1_intakeserviceid::UUID
       AND isra2.relationshiptypekey IN ('GUADLI','AT','CHADCA','CLAT','FACS','LARE');
       

      -- RAISE NOTICE 'Services Element #66 #67 #68 #69 #70 #71 #72 #73 #74 #75 #76 #77 #78 #79 #80 #81 #82 #83 #84 #85 %', timeofday();          
      select case  when COUNT(*) FILTER (WHERE tps.service_id IS NOT NULL or  sl.agency_service_ldss_id IS NOT NULL) > 0 then '1' else '2' end,  --CASEMANG
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1015, 1115, 1210, 1014, 1114, 1211, 1016, 1212, 1013, 1113, 1213, 1017,     --COUNSEL
                  1214, 1291, 1292, 1293, 1297, 1298, 1299) or  
              sl.agency_service_ldss_id IN (1015, 1115, 1210, 1014, 1114, 1211, 1016, 1212, 1013, 1113, 
                  1213, 1017, 1214, 1291, 1292, 1293, 1297, 1298, 1299)) > 0 then '1' else '2' end,  
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1011,1208) or                    -- DAYCARE
              sl.agency_service_ldss_id IN (1011,1208)) > 0 then '1' else '2' end,          
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1000,1100,1198,1003,1103,1201,1203,1007,1107,1204,1022,1122,1217,1023,1223,   -- EDUCATN
                  1024,1218,1018,1118,1215,1019,1119,1222,1020,1120,1216,1025,1125,1026,1126,
                  1224,1021,1121,1219,1027,1127,1220,1190,1225,1028,1128,1221,1278,1279,1280) or  
              sl.agency_service_ldss_id IN (1000,1100,1198,1199,1101,1001,1124,1003,1103,1201,1203,1007,1107,
                  1204,1022,1122,1217,1023,1223,1024,1218,1018,1118,1215,1019,1119,
                  1222,1020,1120,1216,1025,1125,1026,1126,1224,1021,1121,1219,1027,1127,
                  1220,1190,1225,1028,1128,1221,1278,1279,1280)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1030, 1130, 1226, 1029, 1129, 1228, 1031, 1131, 1227) or         -- EMPLOY
              sl.agency_service_ldss_id IN (1030, 1130, 1226, 1029, 1129, 1228, 1031, 1131, 1227)) > 0 then '1' else '2' end,  
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1044,1144,1241) or  sl.agency_service_ldss_id IN (1044,1144,1241)) > 0 then '1' else '2' end,  --FAMPLAN
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1042, 1142, 1239, 1043, 1240, 1045, 1242, 1046, 1243,1047,1244) or     --HEALTH
              sl.agency_service_ldss_id IN (1042, 1142, 1239, 1043, 1240, 1045, 1242, 1046, 1243, 1047, 1244)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1002,1200,1004,1104,1202, 1008,1205) or             -- HOMEBASE 
              sl.agency_service_ldss_id IN (1002,1200,1004,1104,1202, 1008,1205)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1033,1133,1232, 1032, 1132, 1229, 1034, 1233, 1009, 1109, 1206,       -- HOUSING
                  1035, 1135, 1230, 1036, 1231, 1037,1234,1039,1235,1038,1236) or  
              sl.agency_service_ldss_id IN (1033,1133,1232, 1032, 1132, 1229, 1034, 1233, 1009, 1109, 1206, 
                  1035, 1135, 1230, 1036, 1231, 1037,1234,1039,1235,1038,1236)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1270,1271,1272,1273,1274,1275,1276,1290) or            -- TRANSLIV
              sl.agency_service_ldss_id IN (1270,1271,1272,1273,1274,1275,1276,1290)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id IS NOT NULL or  sl.agency_service_ldss_id IS NOT NULL) > 0 then '1' else '2' end,  -- INFOREF
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1040,1140,1237,1041,1141, 1238, 1281, 1282, 1283, 1289) or         -- LEGAL
              sl.agency_service_ldss_id IN (1040,1140,1237,1041,1141, 1238, 1281, 1282, 1283, 1289)) > 0 then '1' else '2' end, 
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1057, 1157, 1245, 1058, 1246,1059,1247, 1064, 1252, 1065, 1165, 1060,    -- MENTHLTH
                  1160,1248,1061,1250,1062,1251,1063,1249,1253) or  
              sl.agency_service_ldss_id IN (1057, 1157, 1245, 1058, 1246,1059,1247, 1064, 1252, 1065, 1165,
                  1060, 1160, 1248, 1061, 1250,1062, 1251,1063, 1249,1253)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1001,1199,1101) or  sl.agency_service_ldss_id IN (1001,1199,1101)) > 0 then '1' else '2' end, -- PREGPAR
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1010,1207) or  sl.agency_service_ldss_id IN (1010,1207)) > 0 then '1' else '2' end,  -- RESPITE
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1167,1068,1168,1067) or  sl.agency_service_ldss_id IN (1167,1068,1168,1067)) > 0 then '1' else '2' end, -- SSDISABL
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1069,1169) or  sl.agency_service_ldss_id IN (1069,1169)) > 0 then '1' else '2' end,      -- SSDELINQ
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1194, 1195, 1263, 1262, 1191, 1192, 1193, 1196, 1197, 1265, 1264) or        -- SUBABUSE
              sl.agency_service_ldss_id IN (1194, 1195, 1263, 1262, 1191, 1192, 1193, 1196, 1197, 1265, 1264)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1266,1166,1066) or sl.agency_service_ldss_id IN (1266,1066,1166)) > 0 then '1' else '2' end,  -- TRNSPRT
        case  when COUNT(*) FILTER (WHERE tps.service_id in (1012,1048,1049,1050,1051,1052,1053,1054,1055,1056,1112,             -- OTHERSV
                  1148,1149,1150,1153,1209,1254,1255,1256,1257,1258,1259,
                  1260,1261) or
              sl.agency_service_ldss_id IN (1012,1048,1049,1050,1051,1052,1053,1054,1055,1056,1112,1148,1149,1150,1153,1209,
                  1254,1255,1256,1257,1258,1259,1260,1261)) > 0 then '1' else '2' end,
        case  when COUNT(*) FILTER (WHERE tps.service_id in (501,11331) or sl.agency_service_ldss_id IN (1285,1286,1287,1288)) > 0 then '1' else '2' end   
      INTO 
        VL_CASEMANG,
        VL_COUNSEL,
        VL_DAYCARE,
        VL_EDUCATN,
        VL_EMPLOY,
        VL_FAMPLAN,
        VL_HEALTH,
        VL_HOMEBASE,
        VL_HOUSING,
        VL_TRANSLIV_2,
        VL_INFOREF,
        VL_LEGAL,
        VL_MENTHLTH,
        VL_PREGPAR,
        VL_RESPITE,
        VL_SSDISABL,
        VL_SSDELINQ,
        VL_SUBABUSE,
        VL_TRANSPRT,
        VL_OTHERSV,
        VL_ADOPT_1
      FROM tb_service_log sl
       LEFT JOIN tb_provider_services tps ON sl.provider_service_id=tps.provider_service_id 
        AND tps.start_dt <= V1_STATUS_DATE + interval '90' day  
       JOIN PERSON P1 ON P1.CJAMSPID = sl.client_id 
        and (P1.activeflag = 1 OR (P1.activeflag = 0 AND P1.expungementflag = 1))
       JOIN ACTOR A ON A.PERSONID = P1.PERSONID 
        AND A.ACTIVEFLAG = 1
      WHERE (sl.case_id = v1_caseid or sl.case_id = V1_SERVICE_CASE_NUMBER) AND
         sl.start_dt <= V1_STATUS_DATE + interval '90' day 
       and sl.delete_sw='N' and tps.delete_sw='N'
       and a.intakeserviceid = v1_intakeserviceid::UUID;
      
      IF (VL_TRANSLIV_1 = '1' OR VL_TRANSLIV_2 = '1') THEN
       VL_TRANSLIV := '1';
      ELSE
       VL_TRANSLIV := '2';
      END IF;    
     END IF; 
      
     VL_TEMP_DATE := NULL;
     VL_SERVDATE := NULL;
     IF (VL_CASEMANG = '1'   OR VL_COUNSEL = '1'  OR VL_DAYCARE = '1'  OR VL_EDUCATN = '1'  OR
      VL_EMPLOY = '1'  OR VL_FAMPLAN = '1'  OR VL_HEALTH = '1'   OR VL_HOMEBASE = '1'  OR
      VL_HOUSING = '1'  OR VL_TRANSLIV_2 = '1'  OR VL_INFOREF = '1'  OR VL_LEGAL = '1'   OR
      VL_MENTHLTH = '1'  OR VL_PREGPAR = '1'  OR VL_RESPITE = '1'  OR VL_SSDISABL = '1'  OR
      VL_SSDELINQ = '1'  OR VL_SUBABUSE = '1'  OR VL_TRANSPRT = '1'  OR VL_OTHERSV = '1'     OR
      VL_FOSTERCR = '1') THEN
      VL_POSTSERV := '1';
      -- RAISE NOTICE 'Services Element #57 %', timeofday();      
      select  min(PPA.STARTDATE)
       INTO VL_TEMP_DATE
      FROM PERSONPROGRAMAREA PPA
       JOIN PERSON P1 ON P1.PERSONID = PPA.PERSONID and (P1.activeflag = 1 OR (P1.activeflag = 0 AND P1.expungementflag = 1))
       JOIN ACTOR A ON A.PERSONID = P1.PERSONID AND PPA.OBJECTID::VARCHAR = a.intakeserviceid::VARCHAR AND A.ACTIVEFLAG = 1
      WHERE PPA.OBJECTID = v1_intakeserviceid 
       and PPA.startdate IS NOT NULL
       and PPA.startdate <= V1_STATUS_DATE + interval '90' day
       and (PPA.programkey in ('IHSFP','OOH','CPS') or ( PPA.programkey = 'AXYS'  and PPA.subprogramkey in ('VPS','ISP')));

      IF (VL_TEMP_DATE IS NOT NULL) THEN
       select min(lpad(extract(month from VL_TEMP_DATE)::varchar,2,'0')||
         lpad(extract(day from VL_TEMP_DATE)::varchar,2,'0')||
         extract(year from VL_TEMP_DATE)::varchar)::varchar 
        INTO VL_SERVDATE;
      END IF;        
     ELSE
      VL_POSTSERV := '2';
     END IF;
         
     -- RAISE NOTICE 'Services Element #65 %', timeofday();    
     select count(*) INTO VL_ADOPT_2 
     from permanencyplan pp
      join placement pl on pp.placementid=pl.placementid
     where pp.establisheddate between V1_STATUS_DATE and V1_STATUS_DATE + interval '90' day
      and pl.personid = v1_p_personid::UUID;
      
     -- RAISE NOTICE 'Services Element #65 2nd %', timeofday();      
     SELECT  count(*) INTO VL_ADOPT_3
     from PERSONPROGRAMAREA ppa
      join person p on ppa.personid = p.personid 
       and (p.activeflag = 1 OR (p.activeflag = 0 AND p.expungementflag = 1))
      join actor a on a.personid = p.personid 
       and ppa.objectid = a.intakeserviceid::varchar 
       and a.activeflag =1
     where programkey='ADP'  
      and ppa.objectid = v1_intakeserviceid 
      and ppa.startdate <= V1_STATUS_DATE + interval '90' day
      and (ppa.enddate is null or ppa.enddate > V1_STATUS_DATE);    

     IF (VL_ADOPT_1 = '1' AND VL_ADOPT_2 > 0 AND VL_ADOPT_3 > 0) THEN
      VL_ADOPT := '1';
     ELSE
      VL_ADOPT := '2';
     END IF;  

     insert into ncands_services 
      (   CHID,   RPTID,   POSTSERV,   SERVDATE,  FAMSUP,   FAMPRES,   FOSTERCR,   RMVDATE, 
       JUVPET,   PETDATE,  COCHREP,   ADOPT,    CASEMANG,   COUNSEL,   DAYCARE,   EDUCATN,  
       EMPLOY,   FAMPLAN,  HEALTH,   HOMEBASE,   HOUSING,   TRANSLIV,   INFOREF,   LEGAL, 
       MENTHLTH,   PREGPAR,  RESPITE,   SSDISABL,   SSDELINQ,   SUBABUSE,   TRANSPRT,   OTHERSV
      )     
     values  
      (   vl_chid,  VL_RPTID, VL_POSTSERV, VL_SERVDATE, VL_FAMSUP,  VL_FAMPRES,  VL_FOSTERCR, VL_RMVDATE,
       VL_JUVPET,   VL_PETDATE, VL_COCHREP,  VL_ADOPT,   VL_CASEMANG,  VL_COUNSEL,  VL_DAYCARE,  VL_EDUCATN,
       VL_EMPLOY,   VL_FAMPLAN, VL_HEALTH,   VL_HOMEBASE,  VL_HOUSING,  VL_TRANSLIV,  VL_INFOREF,  VL_LEGAL,
       VL_MENTHLTH,  VL_PREGPAR, VL_RESPITE,  VL_SSDISABL,  VL_SSDELINQ,  VL_SUBABUSE,  VL_TRANSPRT,  VL_OTHERSV
      ) ;      

     EXCEPTION WHEN OTHERS THEN 
      vl_output_sqlcode := SQLSTATE;
      RAISE NOTICE 'NCANDS SERVICES DATA - INSERT FAILED, %', vl_output_sqlcode;
    END;

    ---- ******************************************************************************************************************************************************************************************             
    ---- ***********************************************************  STAFF INFO STARTS HERE  ************************************************************************************************** 
    ---- ******************************************************************************************************************************************************************************************     
    -- RAISE NOTICE 'Staff Data % % at %', v1_cjamspid, vl_chid, timeofday();
    BEGIN
     IF (v1_intakeserviceid != v1_prev_intakeserviceid) THEN
      -- RAISE NOTICE 'Staff Element #86 %', timeofday();     
      SELECT distinct f_afcars_encrypt(up.cjamspid::varchar), up.securityusersid   
       INTO vl_WRKRID, V1_SECURITYUSERSID
      from  routing ru
       JOIN userprofile up on up.securityusersid=ru.tosecurityusersid 
      where ru.objectid = v1_intakeserviceid and ru.eventcode='INVT' limit 1;              

      -- RAISE NOTICE 'Staff Element #87 %', timeofday();  
      select f_afcars_encrypt(up.cjamspid::varchar) 
       INTO vl_SUPRVID
      from caseassignment CA
      join userprofile up on up.securityusersid = CA.fromworkeridno
      where  CA.objectid =  v1_intakeserviceid::UUID 
       and CA.toworkeridno = V1_SECURITYUSERSID
       and CA.fromworkeridno IS NOT NULL
      order by CA.enddate NULLS FIRST LIMIT 1;
         
      IF (vl_SUPRVID IS NULL) THEN
       vl_SUPRVID := vl_WRKRID;
      END IF;
     END IF;
       
     ---- ******************************************************************************************************************************************************************************************             
     ---- ***********************************************************  PERPETRATOR INFO STARTS HERE  ******************************************************************************************** 
     ---- ******************************************************************************************************************************************************************************************        
      
     -- RAISE NOTICE 'Work Perp Data % % at %', v1_cjamspid, vl_chid, timeofday();
      
     v1_per1id_personid:= null;
     v1_per2id_personid:= null;
     v1_per3id_personid:= null;
     
     vl_PER1ID := null;
     vl_PER1REL :=  null;
     vl_PER1PRNT := null;
     vl_PER1CR   := null;        
     vl_PER1AGE  :=  null;
     vl_PER1SEX  :=  null;
     vl_P1RACAI  :=  null;
     vl_P1RACAS  :=  null;
     vl_P1RACBL  :=  null;
     vl_P1RACNH  :=  null;
     vl_P1RACWH  :=  null;
     vl_P1RACUD  :=  null;
     vl_PER1ETHN :=  null;
     vl_PER1MIL  :=  null;
     vl_PER1PIOR :=  null;
     vl_PER2ID := null;
     vl_PER2REL :=  null;
     vl_PER2PRNT := null;
     vl_PER2CR   := null;
     vl_PER2AGE  :=  null;
     vl_PER2SEX  :=  null;
     vl_P2RACAI  :=  null;
     vl_P2RACAS  :=  null;
     vl_P2RACBL  :=  null;
     vl_P2RACNH  :=  null;
     vl_P2RACWH  :=  null;
     vl_P2RACUD  :=  null;
