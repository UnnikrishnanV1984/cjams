 v1_racecount    INTEGER;
 v1_caseid     BIGINT; --INTEGER;
 V1_ACTION_TYPE    varchar(10);
 VL_TRANSLIV_1    VARCHAR(1);
 VL_TRANSLIV_2    VARCHAR(1);
