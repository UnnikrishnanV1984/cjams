BEGIN  
 
 RAISE NOTICE 'NCANDS CHILD DATA - PROCESS STARTS %', timeofday();
 v1_from_date := vdt_from::date;
 v1_to_date := vdt_to::date;

 v1_count := 0;
 v1_prev_intakeserviceid := '';
 v1_prev_rptid := '';
 v1_prev_chid := '';
 -- INSERT INTO LOG TABLE 
 
 insert into tb_ncands_log 
  ( runtimelog_id, programname, start_time )
 values
  ( default, 'NCANDS_INSERT_CHILD_DATA', current_timestamp);
                                                              
 -- DELETE RECORD FROM TB_NCANDS_ELEMENTS_TEMP IF EXISTS

 if (select count(*) from ncands_child_data) > 0 then
  delete from ncands_child_data;
 end if;
 
 if (select count(*) from ncands_maltreator_info) > 0 then
  delete from ncands_maltreator_info;
 end if;
  
 if (select count(*) from ncands_childrisk) > 0 then
  delete from ncands_childrisk;
 end if;
  
 if (select count(*) from ncands_caregiver) > 0 then
  delete from ncands_caregiver;
 end if;
  
 if (select count(*) from ncands_services) > 0 then
  delete from ncands_services;
 end if;
  
 if (select count(*) from ncands_work_perp) > 0 then
  delete from ncands_work_perp;
 end if;
  
 -- RAISE NOTICE 'AFTER SELECT COUNT %', timeofday();
   
 -- RAISE NOTICE 'Child Data - Element #01';
 select max(extract(year from sd.statusdate))::varchar  
  INTO vl_subyr
 from IntakeServiceRequestDispositionCode sd  
  join IntakeSerReqStatusType st on st.IntakeSerReqStatusTypeid = sd.IntakeSerReqStatusTypeid  and st.activeflag=1 
 where sd.activeflag=1  and st.Description in ('Completed','Closed') 
  and sd.statusdate >=v1_from_date 
  and sd.statusdate <=v1_to_date;

 -- RAISE NOTICE 'Child Data - Element #02';    
 vl_staterr := 'MD';
  
 -- RAISE NOTICE 'BEFORE OPEN vl_child_dt';
 -- RAISE NOTICE 'AFTER SELECT INTO vl_subyr %', timeofday();
 
 BEGIN
  open vl_child_dt for 
  SELECT  distinct RPTID, 
    CASEID,
    intakeserviceid,
    cjamspid,
    chid,
    category_tx,
    reportdate,
    -- RPTDT,
    -- RPTTM,
    RPTSRC,
    chage,
    CHBDATE,
    CHSEX,
    CHETHN,
    DEATHDT,
    -- STDATE,
    personid,
    actiontype,
    statusdate,
    expung_sw,
    person_activeflag
  FROM 
   (WITH cte as (
   -- Active Cases
   select       
    distinct
    -- f_afcars_encrypt
    (case when length(isr.servicerequestnumber)>10 then 
     -- substring(isr.servicerequestnumber,6) 
     isr.servicerequestnumber
    else 
     substring(isr.servicerequestnumber,3) 
    end) as RPTID,
    (case when length(isr.servicerequestnumber)>10 then 
     -- substring(isr.servicerequestnumber,6) 
     isr.servicerequestnumber
    else 
     substring(isr.servicerequestnumber,3) 
    end)::BIGINT as caseid,
    isr.intakeserviceid,
    p.cjamspid,
    -- f_afcars_encrypt
    (p.cjamspid :: varchar) CHID,
    tpvp.category_tx, 
    -- isr.reportedtime::date,
    (CASE WHEN isr.reportedtime IS NOT NULL AND isr.reportedtime <= isr.reporteddate THEN 
     isr.reportedtime 
    ELSE 
     isr.reporteddate 
    END) as reportdate,
    -- lpad(extract(month from isr.reportedtime)::varchar,2,'0')||lpad(extract(day from isr.reportedtime)::varchar,2,'0')||extract(year from isr.reportedtime)::varchar RPTDT,
    -- to_char(reportedtime,'HH24MI') RPTTM,
    (case   when isr.reporterroletypekey = 'SSP'  then '01'
      when isr.reporterroletypekey = 'MP'  then '02'
      when isr.reporterroletypekey = 'MHP'  then '03'
      when isr.reporterroletypekey = 'LLECJP' then '04'
      when isr.reporterroletypekey = 'EP'  then '05'
      when isr.reporterroletypekey = 'CDCP'  then '06'
      when isr.reporterroletypekey = 'SCP'  then '07'
      when isr.reporterroletypekey = 'AV'  then '08'
      when isr.reporterroletypekey = 'PAT'  then '09'
      when isr.reporterroletypekey = 'OR'  then '10'
      when isr.reporterroletypekey = 'FN'  then '11'
      when isr.reporterroletypekey = 'AP'  then '12'
      when isr.reporterroletypekey = 'AR'  then '13'
      when isr.reporterroletypekey = 'OTH'  then '88'
      when isr.reporterroletypekey = 'UM'  then '99'
      else '99' 
    end)::character varying RPTSRC,
    (case  when isr.reportedtime < p.dob then '77'
      when date_part('year',age(isr.reportedtime,p.dob))<1 then '00' 
      when (date_part('year',age(isr.reportedtime,p.dob))>0 
       and date_part('year',age(isr.reportedtime,p.dob))<22) then 
        lpad((date_part('year',age(isr.reportedtime,p.dob)):: character varying ),2,'0')
      else '77' 
    end) chage,
    to_char(p.dob, 'MMDDYYYY') CHBDATE,
    (case p.gendertypekey when 'M' then 1
          when 'F' then 2
          else 9      
    end) :: character varying CHSEX,
    (case when p.ethnicgrouptypekey = 'H' then 1
      when p.ethnicgrouptypekey = 'X' then 2
      when p.ethnicgrouptypekey = 'U' then 3
      else 9 
    end ) :: character varying CHETHN,
    -- Commented code 12/2020
    -- (TO_CHAR(p.deceaseddate,'MMDDYYYY')) DEATHDT,
    (TO_CHAR(p.dateofdeath,'MMDDYYYY')) DEATHDT,
    p.personid::varchar,
    isr.actiontype,
    -- COALESCE(sd.statusdate::date, CCS.CLOSUREDATE::DATE) AS statusdate,
    (case when ru.updatedon BETWEEN v1_from_date AND v1_to_date then 
     ru.updatedon
     else 
     ccs.closuredate
     end)::date AS statusdate,
    'N' as expung_sw,
    p.activeflag as person_activeflag
   from intakeservicerequest isr 
    join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid  
     and isra.activeflag = 1 
     and ( isra.rchouseholdflag = 1 or isra.intakeservicerequestpersontypekey = 'AV')
    left join intakeservicerequestsdm isrdm on isrdm.intakeserviceid = isr.intakeserviceid
    join routing ru on ru.objectid = isr.intakeserviceid::character varying 
     and ru.eventcode='INVT'
     and ru.tosecurityusersid != '00000000-0000-0000-0000-000000000000'
     and ru.tosecurityusersid IS NOT NULL
    join userprofile up on up.securityusersid = ru.tosecurityusersid 
    join tb_picklist_values tpvp on btrim(tpvp.picklist_value_cd) = btrim(up.primarycountycd) 
     and tpvp.picklist_type_id = 104 
    join person p on p.personid = isra.personid 
     and p.activeflag = 1 
    join investigation inve on inve.intakeserviceid = isr.intakeserviceid
    join IntakeServiceRequestDispositionCode sd on sd.IntakeServiceId = isr.IntakeServiceId 
    join IntakeSerReqStatusType st on st.IntakeSerReqStatusTypeid = sd.IntakeSerReqStatusTypeid  
     and st.activeflag = 1 
     and st.Description is not null 
     and st.Description in ('Completed','Closed') 
    join investigationmaltreatment invm on invm.investigationid = inve.investigationid
     and invm.activeflag=1
    left join intakeservicerequestactor isra1 on isra1.intakeserviceid = isr.intakeserviceid  
     and isra1.activeflag = 1 
    left join investigationallegationmaltreators iamal on iamal.intakeservicerequestactorid  = isra1.intakeservicerequestactorid
     and iamal.finalizeddate is not null
    left join caseclosuresummary ccs ON ccs.IntakeServiceId = isr.IntakeServiceId  
     and ccs.activeflag = 1
   where isr.actiontype IN ('IR','AR') -- = 'IR'
    and isr.activeflag = 1 
    and (case when isr.actiontype = 'AR' then
      date_part('year',age(isr.reportedtime::date, p.dob)) <= 18
      else
      true
     end) 
    and isra.intakeservicerequestpersontypekey in ('BIOCHILD','OTHERCHILD','AV', 'CHILD')  
    and ( ru.updatedon BETWEEN v1_from_date AND v1_to_date
       or ccs.closuredate BETWEEN v1_from_date AND v1_to_date
      )
    /*
     (
      (case when sd.statusdate is not null then
       sd.statusdate::date > isr.reportedtime::date
       and 
       sd.statusdate BETWEEN v1_from_date AND v1_to_date
       else
       CCS.CLOSUREDATE BETWEEN v1_from_date AND v1_to_date
       end) 
       or
       ru.updatedon::date BETWEEN v1_from_date AND v1_to_date
     )  
    */ 
    and (case when isrdm.ischildfatality = true 
       or isrdm.isdeathorserious = true -- Child Fatality 
        or isrdm.ismalpa_suspeciousdeath = true -- Suspicious death of a child due to abuse (PHYSICAL ABUSE)
        or isrdm.isneggn_suspiciousdeath = true -- Suspicious death of a child due to neglect (NEGLECT)
        or isrdm.isnegrh_priordeath = true -- Prior child fatality and a new child in the home 
        or isrdm.isnegrh_fatality_can = true -- Previous Fatality or Serious Injury of a Child due to Child Abuse or Neglect
     THEN 
      true 
     ELSE 
      isr.reportedtime >= v1_from_date - interval '1 years' 
     END)
    -- for Unit Test
    -- and p.cjamspid in (3415645, 3415646, 4368711)
    -- and p.cjamspid in (2621701, 2407364) -- (4117002, 4117003) 
   union all
  
   -- Expunged Cases
   select       
    distinct
    -- f_afcars_encrypt
    (case when length(isr.servicerequestnumber)>10 then 
     -- substring(isr.servicerequestnumber,6) 
     isr.servicerequestnumber
    else 
     substring(isr.servicerequestnumber,3) 
    end) as RPTID,
    (case when length(isr.servicerequestnumber)>10 then 
     -- substring(isr.servicerequestnumber,6) 
     isr.servicerequestnumber
    else 
     substring(isr.servicerequestnumber,3) 
    end)::BIGINT as caseid,
    isr.intakeserviceid,
    p.cjamspid,
    -- f_afcars_encrypt
    (p.cjamspid :: varchar) CHID,
    tpvp.category_tx, 
    -- isr.reportedtime::date,
    (CASE WHEN isr.reportedtime IS NOT NULL AND isr.reportedtime <= isr.reporteddate THEN 
     isr.reportedtime 
    ELSE 
     isr.reporteddate 
    END) as reportdate,
    -- lpad(extract(month from isr.reportedtime)::varchar,2,'0')||lpad(extract(day from isr.reportedtime)::varchar,2,'0')||extract(year from isr.reportedtime)::varchar RPTDT,
    -- to_char(reportedtime,'HH24MI') RPTTM,
    (case   when isr.reporterroletypekey = 'SSP'  then '01'
      when isr.reporterroletypekey = 'MP'  then '02'
      when isr.reporterroletypekey = 'MHP'  then '03'
      when isr.reporterroletypekey = 'LLECJP' then '04'
      when isr.reporterroletypekey = 'EP'  then '05'
      when isr.reporterroletypekey = 'CDCP'  then '06'
      when isr.reporterroletypekey = 'SCP'  then '07'
      when isr.reporterroletypekey = 'AV'  then '08'
      when isr.reporterroletypekey = 'PAT'  then '09'
      when isr.reporterroletypekey = 'OR'  then '10'
      when isr.reporterroletypekey = 'FN'  then '11'
      when isr.reporterroletypekey = 'AP'  then '12'
      when isr.reporterroletypekey = 'AR'  then '13'
      when isr.reporterroletypekey = 'OTH'  then '88'
      when isr.reporterroletypekey = 'UM'  then '99'
      else '99' 
    end)::character varying RPTSRC,
    (case  when isr.reportedtime < p.dob then '77'
      when date_part('year',age(isr.reportedtime,p.dob))<1 then '00' 
      when (date_part('year',age(isr.reportedtime,p.dob))>0 
       and date_part('year',age(isr.reportedtime,p.dob))<22) then 
        lpad((date_part('year',age(isr.reportedtime,p.dob)):: character varying ),2,'0')
      else '77' 
    end) chage,
    to_char(p.dob, 'MMDDYYYY') CHBDATE,
    (case p.gendertypekey when 'M' then 1
          when 'F' then 2
          else 9      
    end) :: character varying CHSEX,
    (case when p.ethnicgrouptypekey = 'H' then 1
      when p.ethnicgrouptypekey = 'X' then 2
      when p.ethnicgrouptypekey = 'U' then 3
      else 9 
    end ) :: character varying CHETHN,
    -- Commented code 12/2020
    -- (TO_CHAR(p.deceaseddate,'MMDDYYYY')) DEATHDT,
    (TO_CHAR(p.dateofdeath,'MMDDYYYY')) DEATHDT,
    p.personid::varchar,
    isr.actiontype,
    -- COALESCE(sd.statusdate::date, CCS.CLOSUREDATE::DATE) AS statusdate,
    (case when ru.updatedon BETWEEN v1_from_date AND v1_to_date then 
     ru.updatedon
     else 
     ccs.closuredate
     end)::date AS statusdate,
    'Y' as expung_sw,
    p.activeflag as person_activeflag
   from intakeservicerequest isr 
    join intakeservicerequestactor isra on isra.old_id = isr.servicerequestnumber 
     and isra.activeflag = 0 
     and ( isra.rchouseholdflag = 1 or isra.intakeservicerequestpersontypekey = 'AV')
    left join intakeservicerequestsdm isrdm on isrdm.intakeserviceid = isr.intakeserviceid
    join routing ru on ru.objectid = isr.intakeserviceid::character varying 
     and ru.eventcode='INVT'
     and ru.tosecurityusersid != '00000000-0000-0000-0000-000000000000'
     and ru.tosecurityusersid IS NOT NULL
    join userprofile up on up.securityusersid=ru.tosecurityusersid 
    join tb_picklist_values tpvp on btrim(tpvp.picklist_value_cd) = btrim(up.primarycountycd) 
     and tpvp.picklist_type_id = 104 
    join person p on p.personid = isra.personid 
     and (   p.activeflag = 1
       or
       ( p.activeflag = 0 and ( p.expungementflag = 1 or p.updatedby = 'EXPUNG') )
      ) 
    join investigation inve on inve.old_id = isr.servicerequestnumber
    join IntakeServiceRequestDispositionCode sd on sd.IntakeServiceId=isr.IntakeServiceId 
    join IntakeSerReqStatusType st on st.IntakeSerReqStatusTypeid = sd.IntakeSerReqStatusTypeid  
     and st.activeflag = 1 
     and st.Description is not null 
     and st.Description in ('Completed','Closed') 
    join investigationmaltreatment invm on invm.investigationid = inve.investigationid
     -- and invm.activeflag = 1
    left join intakeservicerequestactor isra1 on isra1.old_id = isr.servicerequestnumber 
     and isra1.activeflag = 0 
    left join investigationallegationmaltreators iamal
     on iamal.intakeservicerequestactorid = isra1.intakeservicerequestactorid
     and iamal.finalizeddate is not null
    left join caseclosuresummary CCS ON CCS.IntakeServiceId=isr.IntakeServiceId  
     --and ccs.activeflag = 1
   where isr.actiontype IN ('IR','AR') -- = 'IR'
    and isr.activeflag = 0 
    and ( isr.expungementflag = 1 or isr.updatedby = 'EXPUNG')
    -- DOB is null need to fill in this 
    -- and date_part('year',age(isr.reportedtime::date, p.dob)) <= 18 
    and isra.intakeservicerequestpersontypekey in ('BIOCHILD','OTHERCHILD','AV', 'CHILD')  
    and ( ru.updatedon BETWEEN v1_from_date AND v1_to_date
       or ccs.closuredate BETWEEN v1_from_date AND v1_to_date
      )
    /*
     (
      (case when sd.statusdate is not null then
       sd.statusdate BETWEEN v1_from_date AND v1_to_date
       else
       CCS.CLOSUREDATE BETWEEN v1_from_date AND v1_to_date
       end) 
       or
       ru.updatedon::date BETWEEN v1_from_date AND v1_to_date
     ) 
    */ 
    and (case when isrdm.ischildfatality = true 
       or isrdm.isdeathorserious = true -- Child Fatality 
        or isrdm.ismalpa_suspeciousdeath = true -- Suspicious death of a child due to abuse (PHYSICAL ABUSE)
        or isrdm.isneggn_suspiciousdeath = true -- Suspicious death of a child due to neglect (NEGLECT)
        or isrdm.isnegrh_priordeath = true -- Prior child fatality and a new child in the home 
        or isrdm.isnegrh_fatality_can = true -- Previous Fatality or Serious Injury of a Child due to Child Abuse or Neglect
     THEN 
      true 
     ELSE 
      isr.reportedtime >= v1_from_date - interval '1 years' 
     END)
    -- for Unit Test
    -- and p.cjamspid in (3415645, 3415646, 4368711)
    -- and p.cjamspid in (2621701, 2407364) -- (4117002, 4117003) 
   )
   SELECT  RPTID, 
    chid, 
    CASEID,
    intakeserviceid,
    cjamspid,
    category_tx,
    reportdate,
    -- RPTDT,
    -- RPTTM,
    RPTSRC,
    chage,
    CHBDATE,
    CHSEX,
    CHETHN,
    DEATHDT,
    -- STDATE,
    personid,
    actiontype,
    statusdate,
    expung_sw,
    person_activeflag,
    LAG(RPTID,1) OVER () as prevrptid,
    LAG(chid,1) OVER () as prevchid
   FROM cte
  )
  WHERE CASE WHEN RPTID = prevrptid 
   AND chid = prevchid THEN false else true end;
  
  -- RAISE NOTICE 'AFTER OPEN vl_child_dt %', timeofday();

  loop 
  -- RAISE NOTICE 'INSIDE LOOP';
     
  fetch  vl_child_dt 
  into   
   vl_rptid,     -- #03
   v1_caseid,
   v1_intakeserviceid, 
   v1_cjamspid,
   vl_chid ,     -- #04
   vl_rptcnty,    -- #05
   v1_reportdate,
   -- vl_rptdt,   -- #06 
   -- vl_RPTTM,   -- #147
   vl_rptsrc,    -- #08
   vl_chage ,    -- #12
   vl_chbdate,    -- #13
   vl_chsex ,    -- #14
   vl_chethn,    -- #21
   vl_DEATHDT,    -- #149
   -- vl_rptdisdt,  -- #10
   v1_p_personid,
   V1_ACTION_TYPE,
   V1_STATUS_DATE,
   vs_expung_sw,
   vl_person_activeflag;
 
   exit when not found;

   v1_count := v1_count + 1;
   
   -- RAISE NOTICE 'Processing Record Number % ', v1_count;
   
   -- RAISE NOTICE 'Before vl_rptid %', vl_rptid;
   -- RAISE NOTICE 'Before vl_chid %', vl_chid;
   
   select f_afcars_encrypt(vl_rptid::character varying) into vl_rptid ;
   select f_afcars_encrypt(vl_chid::character varying) into vl_chid ;
   
   -- RAISE NOTICE 'After vl_rptid %', vl_rptid;
   -- RAISE NOTICE 'After vl_chid %', vl_chid;
      
   -- RAISE NOTICE 'v1_intakeserviceid % ', v1_intakeserviceid;
   -- RAISE NOTICE 'v1_caseid %', v1_caseid;
   -- RAISE NOTICE 'Processing Record Number % % % %', v1_count, vl_rptid, vl_chid, v1_cjamspid ;

   -- Get DOB of expunged person
   IF vl_person_activeflag = 0 THEN
    select pgp_sym_decrypt(exst.ncrypt_dob::bytea, 'AES_KEY'::text)::date, 
      to_char(pgp_sym_decrypt(exst.ncrypt_dob::bytea, 'AES_KEY'::text)::date, 'MMDDYYYY') 
     into  vd_chbdate,
      vl_chbdate
    from expungementstaging exst
    where exst.cjamspid = v1_cjamspid 
     and substring(pgp_sym_decrypt(exst.ncrypt_dob::bytea, 'AES_KEY'::text),2) <>  'xxxxxx';
    
    select (case when v1_reportdate < vd_chbdate then 
       '77'
      when date_part('year',age(v1_reportdate, vd_chbdate)) < 1 then 
       '00' 
      when (date_part('year',age(v1_reportdate, vd_chbdate)) > 0 
        and date_part('year',age(v1_reportdate, vd_chbdate)) < 22) then 
       lpad((date_part('year',age(v1_reportdate, vd_chbdate)):: character varying ),2,'0')
      else 
       '77' 
      end) 
     into vl_chage ;
    
    IF V1_ACTION_TYPE = 'AR' THEN
     select (case when date_part('year',age(v1_reportdate::date, vd_chbdate)) <= 18 then
        'Y'
       else
        'N'
       end) as process_sw
      into vs_process_sw ; 
    ELSE
     vs_process_sw := 'Y';
    END IF; 
   ELSE
    vs_process_sw := 'Y';   
   END IF;
   
   IF vs_process_sw is NULL or btrim(vs_process_sw) = '' THEN
    vs_process_sw := 'Y';
   END IF; 
   
   IF vs_process_sw = 'Y' THEN -- Do not Process - START

    -- RAISE NOTICE 'AFTER loop OPEN %', timeofday();    
    BEGIN
     RAISE NOTICE 'Processing Record Number % % % %', v1_count, vl_rptid, vl_chid, v1_cjamspid ;

     IF (v1_intakeserviceid != v1_prev_intakeserviceid) THEN 
      -- RAISE NOTICE 'INSIDE LOOP  %', timeofday();
      V1_SERVICE_CASE_NUMBER := NULL;
      V1_SERVICE_CASE_ID := NULL;

      -- RAISE NOTICE 'Child Data - Element #06 #147 %', timeofday();       
      select v1_reportdate::date,
          lpad(extract(month from v1_reportdate)::varchar,2,'0')||lpad(extract(day from v1_reportdate)::varchar,2,'0')||extract(year from v1_reportdate)::varchar,
          to_char(v1_reportdate,'HH24MI')
      INTO v1_reporteddate,
       vl_rptdt,
       vl_RPTTM;
     
      IF vs_expung_sw = 'N' THEN
       SELECT sc.servicecasenumber, sc.servicecaseid 
          INTO V1_SERVICE_CASE_NUMBER, V1_SERVICE_CASE_ID
       FROM servicecase sc
        LEFT JOIN intakeservicerequest isr ON isr.servicecaseid=sc.servicecaseid AND isr.activeflag=1
       WHERE sc.activeflag = 1 
        AND isr.intakeserviceid = v1_intakeserviceid::UUID 
       limit 1;
      ELSE
       SELECT sc.servicecasenumber, sc.servicecaseid 
          INTO V1_SERVICE_CASE_NUMBER, V1_SERVICE_CASE_ID
       FROM servicecase sc
        LEFT JOIN intakeservicerequest isr ON isr.servicecaseid = sc.servicecaseid 
         -- AND isr.activeflag=1
       WHERE sc.activeflag = 1
        AND isr.intakeserviceid = v1_intakeserviceid::UUID 
       limit 1;
      END IF;
     
      -- RAISE NOTICE 'V1_SERVICE_CASE_NUMBER %', V1_SERVICE_CASE_NUMBER;
      -- RAISE NOTICE 'V1_SERVICE_CASE_ID %', V1_SERVICE_CASE_ID;  
  
      -- RAISE NOTICE 'Child Data - Element #09 %', timeofday();
      vl_rptdisp := null;
      IF (V1_ACTION_TYPE = 'IR') THEN
       IF vs_expung_sw = 'N' THEN
        select  (case when inf.investigationfindingtypekey = 'ID' then '01'
           when inf.investigationfindingtypekey = 'UD' then '02'
           when inf.investigationfindingtypekey = 'RO' then '05'
           else '04'
         end )
           INTO vl_rptdisp
        FROM intakeservicerequestactor insa
         JOIN investigation inv ON insa.intakeserviceid=inv.intakeserviceid
         JOIN investigationallegation inva ON inv.investigationid=inva.investigationid
         JOIN allegation alleg ON inva.allegationid=alleg.allegationid
         JOIN investigationfinding inf ON inva.investigationallegationid=inf.investigationallegationid
        WHERE insa.intakeserviceid = v1_intakeserviceid::UUID
        ORDER BY  
         case when inf.investigationfindingtypekey ='ID' then '01'
          when inf.investigationfindingtypekey ='UD' then '02'
          when inf.investigationfindingtypekey ='RO' then '05'
         end 
        LIMIT 1;
       ELSE
        select  (case when inf.investigationfindingtypekey = 'ID' then '01'
           when inf.investigationfindingtypekey = 'UD' then '02'
           when inf.investigationfindingtypekey = 'RO' then '05'
           else '04'
          end )
           INTO vl_rptdisp
        FROM intakeservicerequestactor insa
         JOIN investigation inv ON insa.old_id = inv.old_id
         JOIN investigationallegation inva ON inv.investigationid=inva.investigationid
         JOIN allegation alleg ON inva.allegationid=alleg.allegationid
         JOIN investigationfinding inf ON inva.investigationallegationid=inf.investigationallegationid
        WHERE ( case when length(insa.old_id)>10 then 
           -- substring(insa.old_id,6) = v1_caseid
           insa.old_id = v1_caseid
          else 
           substring(insa.old_id,3) = v1_caseid
          end)
        ORDER BY  
         case when inf.investigationfindingtypekey ='ID' then '01'
          when inf.investigationfindingtypekey ='UD' then '02'
          when inf.investigationfindingtypekey ='RO' then '05'
         end 
        LIMIT 1;
       END IF; 
      ELSE
       -- for AR always report 
       vl_rptdisp := '04' ;
       /*
       IF vs_expung_sw = 'N' THEN
        SELECT case when COUNT(*) FILTER (WHERE isra.intakeservicerequestpersontypekey = 'AV') > 0 then 
          '03' 
            when COUNT(*) FILTER (WHERE isra.intakeservicerequestpersontypekey IN ('CHILD','OTHERCHILD')) > 0 then 
            '04' 
            END 
         INTO vl_rptdisp
        FROM intakeservicerequestactor isra
        WHERE isra.intakeserviceid = v1_intakeserviceid::UUID
         AND isra.personid = v1_p_personid::UUID;
       ELSE
        SELECT case when COUNT(*) FILTER (WHERE isra.intakeservicerequestpersontypekey = 'AV') > 0 then 
          '03' 
          when COUNT(*) FILTER (WHERE isra.intakeservicerequestpersontypekey IN ('CHILD','OTHERCHILD')) > 0 then 
          '04' 
          END 
         INTO vl_rptdisp
        FROM intakeservicerequestactor isra
        WHERE ( case when length(isra.old_id)>10 then 
           -- substring(isra.old_id,6) = v1_caseid
           isra.old_id = v1_caseid
          else 
           substring(isra.old_id,3) = v1_caseid
          end )
         AND isra.personid = v1_p_personid::UUID;
       END IF;
       */
      END IF;
       
      -- RAISE NOTICE 'Child Data - Element #10 %', timeofday();
      select (lpad(extract(month from V1_STATUS_DATE)::varchar,2,'0')||
         lpad(extract(day from V1_STATUS_DATE)::varchar,2,'0')||
         extract(year from V1_STATUS_DATE)::varchar)::varchar
      into vl_rptdisdt;
   
      -- RAISE NOTICE 'Child Data - Element #11 % ', timeofday();      
      SELECT case when COUNT(*) FILTER (WHERE isra2.relationshiptypekey = 'NORE') > 0 then 1  else 0 end,
        case when COUNT(*) FILTER (WHERE isra2.relationshiptypekey IN ('AT', 'AG', 'CHADCA','CLAT', 'LAEN', 'PAOF', 'PRAT','TROF')) > 0 then 1  else 0 end,
        case when COUNT(*) FILTER (WHERE isra2.relationshiptypekey = 'LIWO') > 0 then 1  else 0 end,
        case when COUNT(*) FILTER (WHERE isra2.relationshiptypekey IS NOT NULL) > 0 then 1  else 0 end
      INTO  vl_notifs_1,
        vl_notifs_2,
        vl_notifs_3,
        vl_notifs_4
      from collateral isra2  
      where  isra2.caseid = v1_intakeserviceid::UUID; 

      IF  vl_notifs_2 = 1 AND  vl_notifs_3 = 1 THEN
       vl_notifs := '4'; 
      ELSE
       IF  vl_notifs_2 = 1 THEN
        vl_notifs := '2'; 
       ELSE
        IF  vl_notifs_3 = 1 THEN 
         vl_notifs := '3'; 
        ELSE
         IF vl_notifs_4 = 1 THEN
          vl_notifs := '8';
         ELSE
          vl_notifs := '9';
         END IF;
        END IF;
       END IF;
      END IF;
              
      -- RAISE NOTICE 'Child Data - Element #23 %', timeofday();
      IF vs_expung_sw = 'N' THEN
       select        
       (case  when invm.householdkey='MP'  then '01'
         when invm.householdkey='MPSP'  then '02'
         when invm.householdkey='UP'  then '03'
         when invm.householdkey='PCP'  then '04'
         when invm.householdkey='BPMSU'  then '05'
         when invm.householdkey='SPMO'  then '06'
         when invm.householdkey='SPFO'  then '07'
         when invm.householdkey='SPMOA'  then '08'
         when invm.householdkey='SPFOA'  then '09'
         when invm.householdkey='NPRC'  then '10'
         when invm.householdkey='NRC'  then '11'
         when invm.householdkey='GHRF'  then '12'
         when invm.householdkey='OS'  then '88'
         else '99' end)::character varying  
        INTO vl_chlvng
       from investigation inve
        join investigationmaltreatment invm on inve.investigationid=invm.investigationid 
         and invm.activeflag=1
       where inve.intakeserviceid = v1_intakeserviceid::UUID limit 1;
      ELSE
       select        
       (case  when invm.householdkey='MP'  then '01'
         when invm.householdkey='MPSP'  then '02'
         when invm.householdkey='UP'  then '03'
         when invm.householdkey='PCP'  then '04'
         when invm.householdkey='BPMSU'  then '05'
         when invm.householdkey='SPMO'  then '06'
         when invm.householdkey='SPFO'  then '07'
         when invm.householdkey='SPMOA'  then '08'
         when invm.householdkey='SPFOA'  then '09'
         when invm.householdkey='NPRC'  then '10'
         when invm.householdkey='NRC'  then '11'
         when invm.householdkey='GHRF'  then '12'
         when invm.householdkey='OS'  then '88'
         else '99' end)::character varying  
        INTO vl_chlvng
       from investigation inve
        join investigationmaltreatment invm on inve.investigationid=invm.investigationid 
         and invm.activeflag=1
       where ( case when length(inve.old_id)>10 then 
          -- substring(inve.old_id,6) = v1_caseid
          inve.old_id = v1_caseid
         else 
          substring(inve.old_id,3) = v1_caseid
         end
         )
       limit 1;

      END IF;
      
      -- RAISE NOTICE 'Child Data - Element #24 %', timeofday();
      select case when count(*) > 0 THEN 1 ELSE 2 END  INTO vl_chmil
       from personmilitaryservices pms
       JOIN intakeservreqchildremoval isrcm ON pms.personid = isrcm.primarycaregiveractorid 
      WHERE (isrcm.intakeserviceid IS NOT NULL AND isrcm.intakeserviceid = v1_intakeserviceid::UUID)
       OR 
       (isrcm.servicecaseid IS NOT NULL AND isrcm.servicecaseid = V1_SERVICE_CASE_ID); 

      -- RAISE NOTICE 'Child Data - Element #25 %', timeofday();  
      IF vs_expung_sw = 'N' THEN
       select case when count(*) > 0 then 1 else 2 end 
       INTO vl_chprior
        from intakeservicerequest ISRI   
        JOIN intakeservicerequestactor insa ON ISRI.intakeserviceid=insa.intakeserviceid
        JOIN investigation inv    ON insa.intakeserviceid=inv.intakeserviceid
        JOIN investigationallegation inva ON inv.investigationid=inva.investigationid
        JOIN allegation alleg    ON inva.allegationid=alleg.allegationid
        JOIN investigationfinding inf    ON inva.investigationallegationid=inf.investigationallegationid
        JOIN IntakeServiceRequestDispositionCode sdi ON sdi.IntakeServiceId=isri.IntakeServiceId
       where 
        insa.personid = v1_p_personid::UUID
        and isri.IntakeServiceId != v1_intakeserviceid::UUID
        and insa.intakeservicerequestpersontypekey in ('OTHERCHILD','BIOCHILD','CHILD','AV')
        and sdi.statusdate < v1_reporteddate
        and (inf.investigationfindingtypekey in ('ID','UD') OR ISRI.actiontype = 'AR');
      ELSE
       select case when count(*) > 0 then 1 else 2 end 
       INTO vl_chprior
        from intakeservicerequest ISRI   
        JOIN intakeservicerequestactor insa ON insa.old_id = ISRI.servicerequestnumber 
        JOIN investigation inv    ON insa.old_id=inv.old_id
        JOIN investigationallegation inva ON inv.investigationid=inva.investigationid
        JOIN allegation alleg    ON inva.allegationid=alleg.allegationid
        JOIN investigationfinding inf    ON inva.investigationallegationid=inf.investigationallegationid
        JOIN IntakeServiceRequestDispositionCode sdi ON sdi.IntakeServiceId=isri.IntakeServiceId
       where 
        insa.personid = v1_p_personid::UUID
        and isri.IntakeServiceId != v1_intakeserviceid::UUID
        and insa.intakeservicerequestpersontypekey in ('OTHERCHILD','BIOCHILD','CHILD','AV')
        and sdi.statusdate < v1_reporteddate
        and (inf.investigationfindingtypekey in ('ID','UD') OR ISRI.actiontype = 'AR');

      END IF;
    
      -- RAISE NOTICE 'Child Data - Element #07 #148 %', timeofday();
      vl_INVDATE := NULL;
      select lpad(extract(month from pt.contactdate)::varchar,2,'0')||lpad(extract(day from pt.contactdate)::varchar,2,'0')||extract(year from pt.contactdate)::varchar,
        to_char(pt.starttime,'HH24MI')  
       INTO vl_invdate, vl_INVSTRTM
       from progressnote pt
       JOIN progressnotetype pty ON pty.progressnotetypeid=pt.progressnotetypeid AND pty.activeflag=1 
        AND pty.progressnotetypekey in ('Initialfacetoface','Migration','Face To Face')
       WHERE pt.entitytypeid = v1_intakeserviceid       
        AND pt.contactdate is not null
        AND pt.contactdate >= v1_reporteddate 
       ORDER BY pt.contactdate 
       LIMIT 1; 
     END IF; 
     
     IF (vl_rptdt = vl_INVDATE  AND vl_RPTTM::INTEGER > vl_INVSTRTM::INTEGER) THEN
      vl_RPTTM := vl_INVSTRTM;
     END IF;
    
     -- RAISE NOTICE 'Child Data - Element #15 #16 #17 #18 #19 #20 %', timeofday();
     V1_RACECOUNT := 0;
     SELECT case  when COUNT(*) FILTER (WHERE pr.racetypekey  like '%AI%'   ) > 0 then '1' 
         when COUNT(*) FILTER (WHERE pr.racetypekey  like '%AN%' ) > 0 then '1' 
        else '2' 
       end, 
       case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%AS%') > 0 then '1' else '2' end, 
       case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%BA%') > 0 then '1' else '2' end, 
       case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%WH%') > 0 then '1' else '2' end, 
       case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%PI%') > 0 then '1' else '2' end,
       case when COUNT(*) FILTER (WHERE pr.racetypekey  like '%UN%'   ) > 0 then '1' 
        when COUNT(*) FILTER (WHERE pr.racetypekey  like '%DC%' ) > 0 then '1' 
        else '2' 
       end
     INTO  vl_chracai,
       vl_chracas,
       vl_chracbl,
       vl_chracwh,
       vl_chracnh,
       vl_chracud
     FROM  personracetypemap  pr
     WHERE pr.personid = v1_p_personid::UUID 
      AND (case when vs_expung_sw = 'N' then
        pr.activeflag = 1
        else
        true
        end );
      
     IF (vl_chracud = '1') THEN
      vl_chracai := '3';
      vl_chracas := '3';
      vl_chracbl := '3';
      vl_chracwh := '3';
      vl_chracnh := '3';           
     END IF;  

     -- RAISE NOTICE 'Child Data - Element #22 %', timeofday();  
     vl_chcnty := null;
     SELECT tpvp.category_tx INTO vl_chcnty
     FROM PERSONADDRESS PA
      JOIN COUNTY C ON C.COUNTYID::varchar = PA.COUNTY
      join tb_picklist_values tpvp ON lower(replace(tpvp.value_tx,' ','')) = lower(replace(C.COUNTYNAME,' ','')) 
       and tpvp.picklist_type_id = 104 
     WHERE PA.PERSONID = v1_p_personid::UUID limit 1;
      
     IF (vl_chcnty IS NULL) THEN
      vl_chcnty := vl_rptcnty;
     END IF;
                    
     insert into ncands_child_data
      ( SUBYR,   STATERR,   RPTID,   CHID,  RPTCNTY, 
       RPTDT,   INVDATE,   RPTSRC,  RPTDISP, RPTDISDT, 
       NOTIFS,  CHAGE,    CHBDATE, CHSEX,   CHRACAI,
       CHRACAS, CHRACBL,  CHRACNH,  CHRACWH, CHRACUD, 
       CHETHN,  CHCNTY,   CHLVNG,  CHMIL,  CHPRIOR)
     values    
      (   vl_subyr,  vl_staterr,   vl_rptid,   vl_chid,   vl_rptcnty,  
       vl_rptdt,   vl_invdate,   vl_rptsrc, vl_rptdisp, vl_rptdisdt,  
       vl_notifs,  vl_chage,    vl_chbdate, vl_chsex,   vl_chracai,  
       vl_chracas, vl_chracbl,   vl_chracnh, vl_chracwh, vl_chracud,  
       vl_chethn,  vl_chcnty,   vl_chlvng,  vl_chmil, vl_chprior
      );
                         
     EXCEPTION WHEN OTHERS THEN 
      vl_output_sqlcode := SQLSTATE;
      RAISE NOTICE 'NCANDS CHILD DATA - INSERT FAILED, % AT %', vl_output_sqlcode, timeofday();
    END;
     
    ---- ******************************************************************************************************************************************************************************************             
    ---- ***********************************************************  MALTREATOR INFO STARTS HERE  ********************************************************************************************
    ---- ******************************************************************************************************************************************************************************************
    -- RAISE NOTICE 'Maltreator Data % % AT %', v1_cjamspid, vl_chid, timeofday();
    BEGIN
     VL_MALTREATOR_RECORD_COUNT := 0;
     vl_CHMAL1 := null;
     vl_CHMAL2 := null;
     vl_CHMAL3 := null;
     vl_CHMAL4 := null;
     vl_MAL1LEV := null;
     vl_MAL2LEV := null;
     vl_MAL3LEV := null;
     vl_MAL4LEV := null;

     -- RAISE NOTICE 'Maltreator Element #26 #27 #28 #29 #30 #31 #32 #33 %', timeofday(); 
  
     FOR VL_MALTREATOR_RECORD in 
      select distinct alleg.name as allegname,
       (case  when LOWER(TRIM(alleg.name))='physical abuse' then 1
         when LOWER(TRIM(alleg.name)) IN ('neglect','neglect by others') then 2
         when LOWER(alleg.name) like '%medical neglect%' then 3
         when LOWER(alleg.name) like '%neglect - medical%' then 3
         when LOWER(TRIM(alleg.name))='sexual abuse' then 4
         when LOWER(alleg.name) like '%mental injury%' then 5
         when alleg.name=null then 9
         else 8 
        end)::character varying as chmal
      from intakeservicerequestactor insa 
       join investigation inv on 
        (case when vs_expung_sw = 'N' THEN
         insa.intakeserviceid = inv.intakeserviceid
         else
         insa.old_id = inv.old_id
         end)   
       join investigationallegation inva on inv.investigationid=inva.investigationid
       join allegation alleg on inva.allegationid=alleg.allegationid 
       join investigationfinding inf on inva.investigationallegationid=inf.investigationallegationid
      where (case when vs_expung_sw = 'N' THEN
         insa.intakeserviceid = v1_intakeserviceid::UUID 
          else
         (  case when length(insa.old_id)>10 then 
           -- substring(insa.old_id,6) = v1_caseid
           insa.old_id = v1_caseid
          else 
           substring(insa.old_id,3) = v1_caseid
          end
         )
          end)  
        and inf.personid = v1_p_personid::UUID
      ORDER BY chmal
       /*
       case when LOWER(TRIM(alleg.name))='physical abuse' then 1
        when LOWER(TRIM(alleg.name)) IN ('neglect','neglect by others') then 2
        when LOWER(alleg.name) like '%medical neglect%' then 3
        when LOWER(alleg.name) like '%neglect - medical%' then 3
        when LOWER(TRIM(alleg.name))='sexual abuse' then 4
        when LOWER(alleg.name) like '%mental injury%' then 5
        when alleg.name IS NOT NULL then 8
        else 9 
       end
       */
      LIMIT 4
     LOOP
      -- RAISE NOTICE 'MTR LOOP1 % at %', VL_MALTREATOR_RECORD.chmal, timeofday();
      VL_MALTREATOR_RECORD_COUNT := VL_MALTREATOR_RECORD_COUNT + 1;
      vl_TEMP_MALLEV := NULL;
      IF (V1_ACTION_TYPE = 'AR') THEN
       -- for AR always report 
       -- IF (vl_rptdisp = '03') THEN
       -- vl_TEMP_MALLEV := '03';
       -- ELSE 
        vl_TEMP_MALLEV := '04';
       -- END IF;
      ELSE
       IF vs_expung_sw = 'N' THEN
        SELECT (case  when COUNT(*) FILTER (WHERE inf.investigationfindingtypekey = 'ID') > 0 then 
           '01' 
          when COUNT(*) FILTER (WHERE inf.investigationfindingtypekey = 'UD') > 0 then 
           '02'
          when COUNT(*) FILTER (WHERE inf.investigationfindingtypekey = 'RO') > 0 then 
           '05'
          else
           '04' 
          end)::character varying as mallev
         INTO vl_TEMP_MALLEV
        from intakeservicerequestactor insa 
         join investigation inv on insa.intakeserviceid=inv.intakeserviceid
         join investigationallegation inva on inv.investigationid=inva.investigationid
         join allegation alleg on inva.allegationid=alleg.allegationid 
         join investigationfinding inf on inva.investigationallegationid=inf.investigationallegationid
        where insa.intakeserviceid = v1_intakeserviceid::UUID 
         AND alleg.name = VL_MALTREATOR_RECORD.allegname
         and inf.personid = v1_p_personid::UUID;
       ELSE
        SELECT (case  when COUNT(*) FILTER (WHERE inf.investigationfindingtypekey = 'ID') > 0 then 
           '01' 
          when COUNT(*) FILTER (WHERE inf.investigationfindingtypekey = 'UD') > 0 then 
           '02'
          when COUNT(*) FILTER (WHERE inf.investigationfindingtypekey = 'RO') > 0 then 
           '05'
          else
           '04' 
          end)::character varying as mallev
         INTO vl_TEMP_MALLEV
        from intakeservicerequestactor insa 
         join investigation inv on insa.old_id = inv.old_id
         join investigationallegation inva on inv.investigationid=inva.investigationid
         join allegation alleg on inva.allegationid=alleg.allegationid 
         join investigationfinding inf on inva.investigationallegationid=inf.investigationallegationid
        where ( case when length(insa.old_id)>10 then 
           -- substring(insa.old_id,6) = v1_caseid
           insa.old_id = v1_caseid
          else 
           substring(insa.old_id,3) = v1_caseid
          end
           )
         AND alleg.name = VL_MALTREATOR_RECORD.allegname
         and inf.personid = v1_p_personid::UUID;
       END IF;
      END IF; 
      
      IF V1_ACTION_TYPE = 'AR' THEN
       IF VL_MALTREATOR_RECORD_COUNT = 1 THEN
        vl_CHMAL1 := VL_MALTREATOR_RECORD.chmal;
        vl_MAL1LEV := '04';
       ELSE 
        IF VL_MALTREATOR_RECORD_COUNT = 2 THEN
         vl_CHMAL2 := VL_MALTREATOR_RECORD.chmal;
         vl_MAL2LEV := '04';
        ELSE 
         IF VL_MALTREATOR_RECORD_COUNT = 3 THEN
          vl_CHMAL3 := VL_MALTREATOR_RECORD.chmal;
          vl_MAL3LEV := '04';
         ELSE 
          IF VL_MALTREATOR_RECORD_COUNT = 4 THEN
           vl_CHMAL4 := VL_MALTREATOR_RECORD.chmal;
           vl_MAL4LEV := '04';
          END IF;
         END IF;
        END IF; 
       END IF; 
      ELSE
       IF VL_MALTREATOR_RECORD_COUNT = 1 THEN
        vl_CHMAL1 := VL_MALTREATOR_RECORD.chmal;
        vl_MAL1LEV := vl_TEMP_MALLEV;
       ELSE 
        IF VL_MALTREATOR_RECORD_COUNT = 2 THEN
         vl_CHMAL2 := VL_MALTREATOR_RECORD.chmal;
         vl_MAL2LEV := vl_TEMP_MALLEV;
        ELSE 
         IF VL_MALTREATOR_RECORD_COUNT = 3 THEN
          vl_CHMAL3 := VL_MALTREATOR_RECORD.chmal;
          vl_MAL3LEV := vl_TEMP_MALLEV;
         ELSE 
          IF VL_MALTREATOR_RECORD_COUNT = 4 THEN
           vl_CHMAL4 := VL_MALTREATOR_RECORD.chmal;
           vl_MAL4LEV := vl_TEMP_MALLEV;
          END IF;
         END IF;
        END IF; 
       END IF; 
      END IF; 
     END LOOP;      
     
     -- New  Logic for AR non Victim - START (12/23/2020)
     -- RAISE NOTICE 'Maltreator Data % ', vl_CHMAL1;
     -- RAISE NOTICE 'V1_ACTION_TYPE % ', V1_ACTION_TYPE;
     
     IF V1_ACTION_TYPE = 'AR' AND vl_CHMAL1 is NULL THEN
      -- RAISE NOTICE 'Inside V1_ACTION_TYPE = AR AND vl_CHMAL1 is NULL';
      -- RAISE NOTICE 'v1_caseid % ', v1_caseid ;
      
      VL_MALTREATOR_RECORD_COUNT := 0;
      vl_CHMAL1 := null;
      vl_CHMAL2 := null;
      vl_CHMAL3 := null;
      vl_CHMAL4 := null;
      vl_MAL1LEV := null;
      vl_MAL2LEV := null;
      vl_MAL3LEV := null;
      vl_MAL4LEV := null;
      
     
      FOR VL_MALTREATOR_RECORD in 
       select distinct alleg.name as allegname,
        (case  when LOWER(TRIM(alleg.name))='physical abuse' then 1
          when LOWER(TRIM(alleg.name)) IN ('neglect','neglect by others') then 2
          when LOWER(alleg.name) like '%medical neglect%' then 3
          when LOWER(alleg.name) like '%neglect - medical%' then 3
          when LOWER(TRIM(alleg.name))='sexual abuse' then 4
          when LOWER(alleg.name) like '%mental injury%' then 5
          when alleg.name=null then 9
          else 8 
         end)::character varying as chmal
       from intakeservicerequestactor insa 
        join investigation inv on 
         (case when vs_expung_sw = 'N' THEN
          insa.intakeserviceid = inv.intakeserviceid
          else
          insa.old_id = inv.old_id
          end)   
        join investigationallegation inva on inv.investigationid=inva.investigationid
        join allegation alleg on inva.allegationid=alleg.allegationid 
        -- join investigationfinding inf on inva.investigationallegationid=inf.investigationallegationid --01/12/2021
       where (case when vs_expung_sw = 'N' THEN
          insa.intakeserviceid = v1_intakeserviceid::UUID 
           else
          
          (  case when length(insa.old_id)>10 then 
            -- substring(insa.old_id,6) = v1_caseid
            insa.old_id = v1_caseid
           else 
            substring(insa.old_id,3) = v1_caseid
           end
          )
           end)  
        -- Do not check for Client   
        -- and inf.personid = v1_p_personid::UUID
       ORDER BY chmal
        /*
        case when LOWER(TRIM(alleg.name))='physical abuse' then 1
         when LOWER(TRIM(alleg.name)) IN ('neglect','neglect by others') then 2
         when LOWER(alleg.name) like '%medical neglect%' then 3
         when LOWER(alleg.name) like '%neglect - medical%' then 3
         when LOWER(TRIM(alleg.name))='sexual abuse' then 4
         when LOWER(alleg.name) like '%mental injury%' then 5
         when alleg.name IS NOT NULL then 8
         else 9 
        end
        */
       LIMIT 4
      LOOP
       -- RAISE NOTICE 'MTR LOOP1 % at %', VL_MALTREATOR_RECORD.chmal, timeofday();
       VL_MALTREATOR_RECORD_COUNT := VL_MALTREATOR_RECORD_COUNT + 1;
       -- RAISE NOTICE 'VL_MALTREATOR_RECORD_COUNT for AR% ', VL_MALTREATOR_RECORD_COUNT;
     
       vl_TEMP_MALLEV := NULL;
       
       vl_MAL1LEV := '04';
       IF VL_MALTREATOR_RECORD_COUNT = 1 THEN
        vl_CHMAL1 := VL_MALTREATOR_RECORD.chmal;
       ELSE 
        IF VL_MALTREATOR_RECORD_COUNT = 2 THEN
         vl_CHMAL1 := VL_MALTREATOR_RECORD.chmal;
         vl_CHMAL2 := NULL;
         vl_MAL2LEV := NULL;
        ELSE 
         IF VL_MALTREATOR_RECORD_COUNT = 3 THEN
          vl_CHMAL1 := VL_MALTREATOR_RECORD.chmal;
          vl_CHMAL3 := NULL;
          vl_MAL3LEV := NULL;
         ELSE 
          IF VL_MALTREATOR_RECORD_COUNT = 4 THEN
           vl_CHMAL1 := VL_MALTREATOR_RECORD.chmal;
           vl_CHMAL4 := NULL;
           vl_MAL4LEV := NULL;
          END IF;
         END IF;
        END IF; 
       END IF; 
      END LOOP;
     END IF;
     -- RAISE NOTICE 'Maltreator Data % ', vl_CHMAL1;
     -- New  Logic for AR non Victim - END (12/23/2020)
     
     vl_MALDEATH := '2';
     IF V1_ACTION_TYPE = 'AR' THEN
      vl_DEATHDT := null;
     ELSE
      IF vl_DEATHDT is NOT NULL THEN
       -- vl_MALDEATH := '1';
      -- ELSE
       IF vs_expung_sw = 'N' THEN
        select (case when count(*) > 0  then '1' else '2' end)
         INTO vl_MALDEATH     
        from intakeservicerequestactor insa 
         join investigation inv on insa.intakeserviceid=inv.intakeserviceid
         join investigationallegation inva on inv.investigationid=inva.investigationid
         join allegation alleg on inva.allegationid=alleg.allegationid 
         join investigationfinding inf on inva.investigationallegationid=inf.investigationallegationid
        where insa.intakeserviceid = v1_intakeserviceid::UUID 
          and inf.personid = v1_p_personid::UUID
          and inva.ischildfatality = 1  ;
       ELSE
        select (case when count(*) > 0  then '1' else '2' end)
         INTO vl_MALDEATH     
        from intakeservicerequestactor insa 
         join investigation inv on insa.old_id = inv.old_id
         join investigationallegation inva on inv.investigationid=inva.investigationid
         join allegation alleg on inva.allegationid=alleg.allegationid 
         join investigationfinding inf on inva.investigationallegationid=inf.investigationallegationid
        where ( case when length(insa.old_id)>10 then 
           -- substring(insa.old_id,6) = v1_caseid
           insa.old_id = v1_caseid
          else 
           substring(insa.old_id,3) = v1_caseid
          end
           )
          and inf.personid = v1_p_personid::UUID
          and inva.ischildfatality = 1  ;
       END IF; 
       
       IF vl_MALDEATH is NULL or vl_MALDEATH = '2' THEN
        select (case when count(*) > 0  then '1' else '2' end)
          INTO vl_MALDEATH     
         from intakeservicerequestsdm isdm 
        where isdm.intakeserviceid = v1_intakeserviceid::UUID 
         and ( isdm.ischildfatality = true
            or isdeathorserious = true -- Child Fatality 
            or ismalpa_suspeciousdeath = true -- Suspicious death of a child due to abuse (PHYSICAL ABUSE)
            or isneggn_suspiciousdeath = true -- Suspicious death of a child due to neglect (NEGLECT)
            or isnegrh_priordeath = true -- Prior child fatality and a new child in the home 
            or isnegrh_fatality_can = true -- Previous Fatality or Serious Injury of a Child due to Child Abuse or Neglect
          )  ;
       END IF;
      END IF; 
     END IF;
     
     IF vl_MALDEATH is NULL THEN
      vl_MALDEATH := '2';
     END IF;
     
     IF vl_MALDEATH = '2' THEN
      vl_DEATHDT := null;
     END IF;
     
     insert into ncands_maltreator_info
      ( CHID, RPTID, chmal1, mal1lev, chmal2, mal2lev,
        chmal3, mal3lev, chmal4, mal4lev, maldeath 
       )   
     values
      ( vl_chid, vl_rptid, vl_CHMAL1,  vl_MAL1LEV,  vl_CHMAL2, vl_MAL2LEV, 
        vl_CHMAL3, vl_MAL3LEV,  vl_CHMAL4,  vl_MAL4LEV,  vl_MALDEATH );
      
      EXCEPTION WHEN OTHERS THEN 
       vl_output_sqlcode := SQLSTATE;
      RAISE NOTICE 'NCANDS MALTREATMENT DATA - INSERT FAILED, %', vl_output_sqlcode;
    END;                          
    
    ---- ******************************************************************************************************************************************************************************************             
    ---- ***********************************************************  CHILD RISK INFO STARTS HERE  ******************************************************************************************** 
    ---- ****************************************************************************************************************************************************************************************** 
    -- RAISE NOTICE 'Child Risk Data % % at %', v1_cjamspid, vl_chid, timeofday();
     
    BEGIN
      
     IF (v1_intakeserviceid != v1_prev_intakeserviceid) THEN
      -- RAISE NOTICE 'Child Risk - Element #35 %', timeofday(); 
      IF vs_expung_sw = 'N' THEN
       SELECT CASE WHEN count(*) > 0  THEN '1' ELSE '2' END 
        INTO vl_CDALC
       from investigation INV 
        join investigationallegation INVA ON INV.investigationid=INVA.investigationid 
         and INVA.activeflag=1 
        join investigationallegationcharacterstics INVAC ON INVAC.investigationallegationid=INVA.investigationallegationid 
         and INVAC.activeflag=1
       where INV.intakeserviceid = v1_intakeserviceid::UUID
        and INVAC.maltreatmentcharactersticstypekey in ('AUCD','AACD') 
        and INV.activeflag=1;  
        
       SELECT CASE WHEN count(*) > 0  THEN '1' ELSE '2' END 
        INTO vl_CDDRUG
       from investigation INV 
        join investigationallegation INVA ON INV.investigationid=INVA.investigationid 
         and INVA.activeflag=1 
        join investigationallegationcharacterstics INVAC ON INVAC.investigationallegationid=INVA.investigationallegationid 
         and INVAC.activeflag=1
       where INV.intakeserviceid = v1_intakeserviceid::UUID
        and INVAC.maltreatmentcharactersticstypekey in ('DUCD','DACD') 
        and INV.activeflag=1;   
      ELSE
       SELECT CASE WHEN count(*) > 0  THEN '1' ELSE '2' END 
        INTO vl_CDALC
       from investigation INV 
        join investigationallegation INVA ON INV.investigationid=INVA.investigationid 
         and INVA.activeflag=1 
        join investigationallegationcharacterstics INVAC ON INVAC.investigationallegationid=INVA.investigationallegationid 
         and INVAC.activeflag=1
       where ( case when length(INV.old_id)>10 then 
          -- substring(INV.old_id,6) = v1_caseid
          INV.old_id = v1_caseid
         else 
          substring(INV.old_id,3) = v1_caseid
         end
          )
        and INVAC.maltreatmentcharactersticstypekey in ('AUCD','AACD') 
        -- and INV.activeflag=1
        ;  
        
       SELECT CASE WHEN count(*) > 0  THEN '1' ELSE '2' END 
        INTO vl_CDDRUG
       from investigation INV 
        join investigationallegation INVA ON INV.investigationid=INVA.investigationid 
         and INVA.activeflag=1 
        join investigationallegationcharacterstics INVAC ON INVAC.investigationallegationid=INVA.investigationallegationid 
         and INVAC.activeflag=1
       where ( case when length(INV.old_id)>10 then 
          -- substring(INV.old_id,6) = v1_caseid
          INV.old_id = v1_caseid
         else 
          substring(INV.old_id,3) = v1_caseid
         end
          )
        and INVAC.maltreatmentcharactersticstypekey in ('DUCD','DACD') 
        -- and INV.activeflag=1
        ;   
      END IF;
     END IF;

     
     -- RAISE NOTICE 'Child Risk - Element #36 %', timeofday();
     IF (vl_CDDRUG = '2') THEN
      SELECT CASE WHEN count(*) > 0  THEN '1' ELSE '2' END 
       INTO vl_CDDRUG
      from personrole pr
      where pr.personid = v1_p_personid::UUID 
       and pr.drugexposedtypekey is not null 
       and (case when vs_expung_sw = 'N' then
         pr.activeflag=1 
         else
         true
         end) 
       and ( pr.drugexposedtypekey::varchar like '%BCOC%' or 
         pr.drugexposedtypekey::varchar like '%BOTH%' or 
         pr.drugexposedtypekey::varchar like '%MMTD%' or 
         pr.drugexposedtypekey::varchar like '%MMJA%' or 
         pr.drugexposedtypekey::varchar like '%MOTH%' or 
         pr.drugexposedtypekey::varchar like '%MCOC%' or 
         pr.drugexposedtypekey::varchar like '%MBS%');

     END IF;
      
     -- RAISE NOTICE 'Child Risk - Element #42 %', timeofday();    
     SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 2 END INTO vl_CDBEHAV
      from  personbehavioralhealth pbh
       inner join personabusesubstance pas on pas.parentabusesubstanceid=pbh.parentbehaviouralhealthid 
        and (case when vs_expung_sw = 'N' then
          pas.activeflag=1
          else
          true
          end)
     WHERE pbh.personid = v1_p_personid::UUID
      and pbh.isbehavioralhealth is true
      and (case when vs_expung_sw = 'N' then
        pbh.activeflag = 1
        else
        true
        end);
   
     -- RAISE NOTICE 'Child Risk - Element #37 #38 #39 #40 #41 #43 %', timeofday();
     SELECT case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'INDIS' and  disabilityconditiontypekey='Yes') > 0 then '1' 
         when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'INDIS' and  disabilityconditiontypekey='No')  > 0 then '2'
        else '9' 
       end, 
       case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'EMDY' and  disabilityconditiontypekey='Yes') > 0 then '1' 
         when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'EMDY' and  disabilityconditiontypekey='No')  > 0 then '2'
        else '9' 
       end, 
       case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey in ('VIDY','HDY') and  disabilityconditiontypekey='Yes') > 0 then '1' 
         when COUNT(*) FILTER (WHERE pd.disabilitytypekey in ('VIDY','HDY') and  disabilityconditiontypekey='No')  > 0 then '2'
        else '9' 
       end,
       case  when COUNT(*) FILTER (WHERE (pd.diagnoiseddisabilitynotes like '%Learning%' or pd.comments like '%Learning%') and  disabilityconditiontypekey='Yes') > 0 then '1' 
        else '2' 
       end,
       
       case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'PYDY' and  disabilityconditiontypekey='Yes') > 0 then '1' 
         when COUNT(*) FILTER (WHERE pd.disabilitytypekey = 'PYDY' and  disabilityconditiontypekey='No')  > 0 then '2'
        else '9' 
       end, 
       case  when COUNT(*) FILTER (WHERE pd.disabilitytypekey not in ('INDIS','EMDY','VIDY','HDY','PYDY') and  disabilityconditiontypekey='Yes') > 0 then '1' 
        else '2' 
       end
     INTO  vl_CDRTRD,
       vl_CDEMOTNL,
       vl_CDVISUAL,
       vl_CDLEARN,
       vl_CDPHYS,
       vl_CDMEDICL
     FROM  persondisability  pd
     WHERE pd.personid = v1_p_personid::UUID;
           
     insert into ncands_childrisk   
      (   CHID,   rptid,  CDALC,  CDDRUG,  CDRTRD,  CDEMOTNL,
       CDVISUAL,  CDLEARN, CDPHYS,  CDBEHAV, CDMEDICL )
     values 
      (   vl_chid,  vl_rptid, vl_CDALC, vl_CDDRUG, vl_CDRTRD, vl_CDEMOTNL,
       vl_CDVISUAL, vl_CDLEARN, vl_CDPHYS, vl_CDBEHAV, vl_CDMEDICL 
      );
              
     EXCEPTION WHEN OTHERS THEN 
      vl_output_sqlcode := SQLSTATE;
      RAISE NOTICE 'NCANDS CHILD RISK DATA - INSERT FAILED, % %', vl_output_sqlcode, timeofday();
    END; 
  
