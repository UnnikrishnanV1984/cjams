CREATE OR REPLACE FUNCTION as_updateihasprovidedmonthlyreport(v_ihasprovidermonthlyreportid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

Begin

UPDATE  Ihasprovidedmonthlyreportdaysconfig  set  activeflag  =  0  where  ihasprovidermonthlyreportid  =  v_ihasprovidermonthlyreportid;
Return  'Success';

End;

$function$

