CREATE OR REPLACE FUNCTION getdatimeline_djs(v_intakeserviceid uuid)
 RETURNS TABLE(intakeserviceid uuid, servicerequestnumber character varying, intakenumber character varying, insertedon timestamp without time zone, createdby character varying, assignedto character varying, status character varying)
 LANGUAGE plpgsql
AS $function$           
      
DECLARE cnt integer;
v_intakenumber character varying;
v_preintakenumber character varying;
BEGIN
   
               
 CREATE SEQUENCE FullResults_Sequence;
  select ISR.intakenumber into v_intakenumber from IntakeserviceRequest AS ISR where ISR.intakeserviceid = v_intakeserviceid and activeflag = 1;
  select R.objectid into v_preintakenumber from routing AS R where R.objectid = v_intakenumber and R.routingstatustypeid = 11;

 --DECLARE 
CREATE TEMP TABLE  Resultsdjs  (              
  ordinal  INT default nextval ('FullResults_Sequence'),              
  Intakeserviceid  uuid,              
  Servicerequestnumber  character varying,              
  Intakenumber   character varying,              
  Insertedon  timestamp without time zone,              
  CreatedBy  character varying,              
  AssignedTo   character varying,              
  Status   character varying             
  ); 

  IF (v_preintakenumber is not null) THEN

   INSERT INTO Resultsdjs  (
   Intakeserviceid,              
   Servicerequestnumber,              
   Intakenumber   ,              
   Insertedon  ,              
   CreatedBy  ,              
   AssignedTo ,              
   Status 
  )
