 WHEN R.routingstatustypeid=6 THEN 'Intake Completed'
 WHEN R.routingstatustypeid=1 THEN 'Intake Completed'
 WHEN R.routingstatustypeid=2 THEN 'Intake Approved' ELSE RST.typedescription END ) as Status
 from IntakeserviceRequest as ISR 
 join intakedastaging as IDAS 
      on IDAS.intakenumber = ISR.intakenumber and IDAS.activeflag=1
 JOIN routing as R 
      ON (R.objectid= IDAS.intakenumber or R.objectid= cast(ISR.intakeserviceid as character varying)) 
 Join userprofile as UP 
      On UP.securityusersid = R.fromsecurityusersid
 Join userprofile as UP1 
      On UP1.securityusersid = R.tosecurityusersid
 join routingstatustype as RST
      on RST.sequencenumber = R.routingstatustypeid and RST.activeflag=1
 where UP.activeflag = 1 and ISR.activeflag=1 and UP1.activeflag = 1 and R.routingstatustypeid!=6  and ISR.intakeserviceid= v_intakeserviceid
 order by R.insertedon asc; */

 select ISR.intakeserviceid,Isr.servicerequestnumber,Isr.intakenumber,
 (CASE 
 WHEN R.routingstatustypeid=2 THEN R.updatedon ELSE R.insertedon END) as insertedon,
 (CASE 
 WHEN R.routingstatustypeid=2 THEN UP1.firstname || ' ' || UP1.lastname ELSE UP.firstname || ' ' || UP.lastname END) as CreatedBy ,
 (CASE 
 WHEN R.routingstatustypeid=2 THEN '' ELSE UP1.firstname || ' ' || UP1.lastname END) as AssignedTo,
 (Case 
 WHEN R.routingstatustypeid=11 THEN 'Pre Intake Created'
 WHEN R.routingstatustypeid=10 THEN 'Intake Assigned'
 WHEN R.routingstatustypeid=6 THEN 'Intake Completed'
 WHEN R.routingstatustypeid=1 THEN 'Intake Completed'
 WHEN R.routingstatustypeid=2 THEN 'Intake Approved' ELSE RST.typedescription END ) as Status
 from IntakeserviceRequest as ISR 
 join intakedastaging as IDAS 
      on IDAS.intakenumber = ISR.intakenumber and IDAS.activeflag=1
 JOIN routing as R 
      ON (R.objectid= IDAS.intakenumber or R.objectid= cast(ISR.intakeserviceid as character varying)) 
 Join userprofile as UP 
      On UP.securityusersid = R.fromsecurityusersid
 Join userprofile as UP1 
      On UP1.securityusersid = R.tosecurityusersid
 join routingstatustype as RST
      on RST.sequencenumber = R.routingstatustypeid and RST.activeflag=1
 where UP.activeflag = 1 and ISR.activeflag=1 and UP1.activeflag = 1 and R.routingstatustypeid!=1  and ISR.intakeserviceid= v_intakeserviceid
 order by R.insertedon asc;
  
  ELSE
         INSERT INTO Resultsdjs  (
   Intakeserviceid,              
   Servicerequestnumber,              
   Intakenumber   ,              
   Insertedon  ,              
   CreatedBy  ,              
   AssignedTo ,              
   Status 
  )

 select * from (select ISR.intakeserviceid,Isr.servicerequestnumber,Isr.intakenumber,R.insertedon,
 UP.firstname || ' ' || UP.lastname as CreatedBy ,
 UP1.firstname || ' ' || UP1.lastname as AssignedTo,
 (Case 
 WHEN R.routingstatustypeid=2 THEN 'Intake Completed' ELSE RST.typedescription END ) as Status
 from IntakeserviceRequest as ISR 
 join intakedastaging as IDAS 
 on IDAS.intakenumber = ISR.intakenumber and IDAS.activeflag=1
 JOIN routing as R 
 ON (R.objectid= IDAS.intakenumber or R.objectid= cast(ISR.intakeserviceid as character varying)) 
 Join userprofile as UP 
 On UP.securityusersid = R.fromsecurityusersid
 Join userprofile as UP1 
 On UP1.securityusersid = R.tosecurityusersid
 join routingstatustype as RST
 on RST.sequencenumber = R.routingstatustypeid and RST.activeflag=1
 where UP.activeflag = 1 and ISR.activeflag=1 and UP1.activeflag = 1   and ISR.intakeserviceid=  v_intakeserviceid

 union all 

 select ISR.intakeserviceid,Isr.servicerequestnumber,Isr.intakenumber,
 (CASE 
 WHEN R.routingstatustypeid=2 THEN R.updatedon ELSE R.insertedon END) as insertedon,
 (CASE 
 WHEN R.routingstatustypeid=2 THEN UP1.firstname || ' ' || UP1.lastname ELSE UP.firstname || ' ' || UP.lastname END) as CreatedBy ,
 (CASE 
 WHEN R.routingstatustypeid=2 THEN '' ELSE UP1.firstname || ' ' || UP1.lastname END) as AssignedTo,
 (Case 
 WHEN R.routingstatustypeid=2 THEN 'Intake Approved' ELSE RST.typedescription END ) as Status
 from IntakeserviceRequest as ISR 
 join intakedastaging as IDAS 
 on IDAS.intakenumber = ISR.intakenumber and IDAS.activeflag=1
 JOIN routing as R 
 ON (R.objectid= IDAS.intakenumber or R.objectid= cast(ISR.intakeserviceid as character varying)) 
 Join userprofile as UP 
 On UP.securityusersid = R.fromsecurityusersid
 Join userprofile as UP1 
 On UP1.securityusersid = R.tosecurityusersid
 join routingstatustype as RST
 on RST.sequencenumber = R.routingstatustypeid and RST.activeflag=1
 where UP.activeflag = 1 and ISR.activeflag=1 and UP1.activeflag = 1   and ISR.intakeserviceid=  v_intakeserviceid) as a
 order by A.insertedon asc;
  
  END IF;     



 INSERT INTO Resultsdjs  (
  Intakeserviceid,              
  Servicerequestnumber,              
  Intakenumber   ,              
  Insertedon  ,              
  CreatedBy  ,              
  AssignedTo ,              
  Status 
 )
select ISR.intakeserviceid,Isr.servicerequestnumber,Isr.intakenumber,IDAS.insertedon,
UP.firstname || ' ' || UP.lastname  as CreatedBy ,'' as AssignedTo,
'Routed to Court Liaison Worker Role' as Status
from IntakeserviceRequest as ISR 
join intakedastaging as IDAS 
     on IDAS.intakenumber = ISR.intakenumber and IDAS.isclw=true and IDAS.clwstatus=1
Join userprofile as UP 
     On UP.securityusersid = IDAS.cruworkername
where UP.activeflag = 1 and ISR.activeflag=1  and ISR.intakeserviceid= v_intakeserviceid
order by IDAS.insertedon desc limit 1;

