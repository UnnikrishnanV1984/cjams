select ISR.intakeserviceid,Isr.servicerequestnumber,Isr.intakenumber,IDAS.insertedon,
UP.firstname || ' ' || UP.lastname as CreatedBy ,UP.firstname || ' ' || UP.lastname as AssignedTo,
'SAO Court Hearing Closed' as Status
from IntakeserviceRequest as ISR 
join intakedastaging as IDAS 
     on IDAS.intakenumber = ISR.intakenumber and IDAS.isclw=true and IDAS.clwstatus =6
Join userprofile as UP 
     On UP.securityusersid = IDAS.cruworkername
where UP.activeflag = 1 and ISR.activeflag=1  and ISR.intakeserviceid= v_intakeserviceid
order by IDAS.insertedon desc limit 1;


 select Count(*) into cnt  FROM Resultsdjs;

 RAISE NOTICE 'CountLength%',cnt;        
                 
 
RETURN QUERY              
  SELECT RS.intakeserviceid,              
   RS.servicerequestnumber ,               
   RS.intakenumber ,                        
   RS.insertedon  ,              
   RS.createdby ,              
   RS.assignedto ,              
   RS.status           
 FROM Resultsdjs RS  order by RS.insertedon asc ;            


 DROP TABLE Resultsdjs;
 DROP SEQUENCE FullResults_Sequence;
  END;
$function$

