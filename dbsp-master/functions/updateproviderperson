CREATE OR REPLACE FUNCTION updateproviderperson(v_objectid character varying, v_type character varying, v_securityuserid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

declare

v_referralid character varying;
v_applicantid character varying;

refid character varying;
appid character varying;
v_returnstatus character varying;
v_inquirystatus character varying;
v_applicationstatus character varying;


begin
  v_referralid := null;
  v_applicantid := null;
 v_inquirystatus := null;
v_applicationstatus := null;
   select referral_id,applicant_id into v_referralid,v_applicantid from providerapprovalphaserecord where provider_id= v_objectid and active_flag=1 limit 1;

  IF (v_type = 'provider') then
  
  for refid in 
    select referral_id from providerapprovalphaserecord where provider_id= v_objectid
  loop 
  select updateinquiryperson into v_inquirystatus from updateinquiryperson(v_referralid,'inquiry',v_securityuserid);
  end loop; 
  for appid in 
  select applicant_id from providerapprovalphaserecord where provider_id= v_objectid
  loop 
  select updateapplicationperson into v_applicationstatus from updateapplicationperson(v_applicantid,'application',v_securityuserid);
  end loop; 
  end if;
 raise notice 'v_referralid%',v_referralid;
 raise notice 'v_applicantid%',v_applicantid;
 raise notice 'v_inquirystatus%',v_inquirystatus;
 raise notice 'v_applicationstatus%',v_applicationstatus;

 
 
IF (v_objectid is not null ) then
update tb_provider set provider_first_nm=t.individual_applicant_first_nm,provider_last_nm = t.individual_applicant_last_nm,provider_middle_nm = t.individual_applicant_middle_nm,
                       tax_id_no = t.individual_applicant_ssn,dob_dt=t.individual_applicant_dob,co_dob_dt=t.co_applicant_dob,
        co_first_nm = t.co_applicant_first_nm , co_last_nm=t.co_applicant_last_nm,co_ssn_no=t.co_applicant_ssn from 
        (select individual_applicant_first_nm,individual_applicant_last_nm,individual_applicant_middle_nm,individual_applicant_ssn,
                        individual_applicant_dob,co_applicant_dob,co_applicant_first_nm,co_applicant_last_nm,co_applicant_ssn from  tb_public_provider_applicant 
      where applicant_id=v_applicantid  ) as t where provider_id=v_objectid::int;

 --update tb_provider_addresses tpa set adr_street_nm=t.adr_street_nm,adr_city_nm=t.adr_city_nm,adr_state_cd=t.adr_state_cd,adr_zip5_no=t.adr_zip5_no from 
--  (select adr_street_nm,adr_city_nm,adr_state_cd,adr_zip5_no,tpam.address_id from tb_provider_applicant_addresses tpaa, tb_provider_address_mapping tpam WHERE 
-- tpam.object_id = v_applicantid and tpam.address_type = 'Individual Applicant Address' and tpam.address_id = tpaa.address_id) as t where tpa.parent_key_id=v_objectid and delete_sw='N';


        
  
  v_returnstatus := 'Provider updated';
 else 
  v_returnstatus := 'Failure';
  END IF;


RETURN v_returnstatus;
                                                      
END;

$function$

