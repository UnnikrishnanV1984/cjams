CREATE OR REPLACE FUNCTION as_updateprogressnote(v_progressnoteid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

BEGIN

    UPDATE Progressnotedetail set activeflag =0 WHERE  progressnoteid = v_progressnoteid;
    UPDATE contactparticipant set activeflag =0 WHERE  progressnoteid = v_progressnoteid;
    UPDATE progressnotereasontypeconfig set activeflag =0 WHERE  progressnoteid = v_progressnoteid;

     RETURN 'Success';
END;

$function$

