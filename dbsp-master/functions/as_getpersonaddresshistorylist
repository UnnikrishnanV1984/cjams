CREATE OR REPLACE FUNCTION as_getpersonaddresshistorylist(addrid uuid)
 RETURNS TABLE(address json)
 LANGUAGE plpgsql
AS $function$     
    
DECLARE
BEGIN
RETURN QUERY
  select json_agg(personaddress order by insertedon desc) from personaddress where addressid = addrid
  and addressstatus=false
  group by addressid;
    
END;
$function$

