CREATE OR REPLACE FUNCTION cpahomeplacementlist(v_casenumber character varying, v_placement_id bigint, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, placement_id bigint, provider_id integer, servicerequestnumber character varying, intakeserviceid uuid, referalstartdate timestamp without time zone, referalstarttime character varying, providername character varying, clientid bigint, clientname character varying, payment_header_id integer, provider_parent_id integer, exittype_picklist_value_cd character varying, exittype_picklist_type_id integer, exittype_description character varying, exitreasontype_picklist_value_cd character varying, exitreasontype_picklist_type_id integer, exitreasontype_description character varying, cpahome_provider_id integer, cpahomeprovidername character varying, cpahomeentrydate timestamp without time zone, cpahomeentrytime character varying, cpahomeexitdate timestamp without time zone, cpahomeexittime character varying)
 LANGUAGE plpgsql
AS $function$


DECLARE 
        v_pagenumber int;
 v_pageoffset int;
 
BEGIN 


v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;


       return query
  
 SELECT COUNT(1) OVER() totalcount, 
 TBPM.placement_id, 
 TBPM.provider_id, 
 ISR.servicerequestnumber, 
 ISR.intakeserviceid, 
 TBPMP.entry_dt, 
 TBPMP.entry_tm ,
 
 (CASE WHEN TBP.provider_nm !='' THEN TBP.provider_nm
 WHEN TBP.provider_nm is null THEN (CAST(INITCAP(TRIM(TBP.provider_first_nm)||' '||TRIM(TBP.provider_last_nm) || CASE WHEN TBP.provider_middle_nm IS NOT NULL AND 
 TRIM(TBP.provider_middle_nm) != '' THEN ', ' || TRIM(TBP.provider_middle_nm)ELSE '' END)as  character varying)) ELSE TBP.provider_nm  END) as providername,
 P.cjamspid as clientid, 
 CAST(INITCAP(TRIM(P.firstname)||' '||TRIM(P.lastname) ||
 CASE WHEN P.middlename IS NOT NULL AND TRIM(P.middlename) != '' THEN ', ' || TRIM(P.middlename) ELSE '' END)as  character varying), 
 TBPM.payment_header_id,
 TBP.affiliate_provider_id,TBPLV.picklist_value_cd,TBPLV.picklist_type_id,TBPLV.description_tx,TBPLV1.picklist_value_cd,TBPLV1.picklist_type_id,TBPLV1.description_tx,
        TBP1.provider_id, 
 (CASE WHEN TBP1.provider_nm !='' THEN TBP1.provider_nm
 WHEN TBP1.provider_nm is null THEN (CAST(INITCAP(TRIM(TBP1.provider_first_nm)||' '||TRIM(TBP1.provider_last_nm) || CASE WHEN TBP1.provider_middle_nm IS NOT NULL AND 
 TRIM(TBP1.provider_middle_nm) != '' THEN ', ' || TRIM(TBP1.provider_middle_nm)ELSE '' END)as  character varying)) ELSE TBP1.provider_nm  END) as cpahomeprovidername,
 TBPCPAH.entry_dt, TBPCPAH.entry_tm , TBPCPAH.exit_dt, TBPCPAH.exit_tm
        FROM tb_placement_cpa_homes as TBPCPAH
        JOIN tb_placement as TBPM
               ON TBPCPAH.placement_id = TBPM.placement_id and TBPM.delete_sw = 'N'
 JOIN tb_placement_providers as TBPMP
      ON TBPMP.placement_id = TBPM.placement_id and TBPMP.delete_sw = 'N'
        JOIN tb_provider as TBP
      ON TBP.provider_id = TBPM.provider_id and TBP.delete_sw = 'N' 
 JOIN tb_provider as TBP1
      ON TBP1.provider_id = TBPCPAH.provider_id and TBP1.delete_sw = 'N'      
 JOIN intakeservicerequest as ISR 
      ON ISR.servicerequestnumber = TBPM.case_id::character varying and ISR.activeflag=1
 JOIN person as P 
      ON P.cjamspid = TBPM.client_id and P.activeflag=1 
 LEFT JOIN tb_picklist_values as TBPLV
      ON TBPLV.picklist_value_cd = TBPCPAH.exit_type_cd and TBPLV.delete_sw = 'N' and TBPLV.picklist_type_id ='737' -- Exit Type
 LEFT JOIN tb_picklist_values as TBPLV1
      ON TBPLV1.picklist_value_cd = TBPCPAH.exit_reason_cd and TBPLV1.delete_sw = 'N' and TBPLV1.picklist_type_id ='165' -- Exit Reason Type       
 WHERE ISR.servicerequestnumber = v_casenumber and TBPCPAH.placement_id= v_placement_id and TBPCPAH.delete_sw = 'N'   
 LIMIT v_liPageSize OFFSET v_pageoffset;      

END;


$function$

