CREATE OR REPLACE FUNCTION prov_getcpaprograminfo(providerid character varying, v_cpa_type character varying)
 RETURNS TABLE(provider_id integer, provider_nm character varying, provider_address character varying)
 LANGUAGE plpgsql
AS $function$ 
declare
v_providerid character varying;
v_programdetails json ;
                                                                                                                                                             
begin                                                                                                                                                                                     
  v_providerid:= providerid; 
 
 RETURN QUERY
        
        select tp.provider_id, tp.provider_nm, (select * from prov_get_formatted_addresses(tp.provider_id)) as provider_address
from tb_provider tp
left join tb_provider_picklist pp on pp.provider_id = tp.provider_id and pp.picklist_type_id = 155 and pp.delete_sw = 'N'
left join tb_provider_licensing tpl on tpl.site_id = tp.provider_id and tpl.delete_sw = 'N' and tpl.active_sw = 'Y'
where 
tp.affiliate_provider_id=v_providerid
and (tp.provider_category_cd=3302 or (pp.picklist_value_cd = 3302 and pp.picklist_type_id=155))
and case when v_cpa_type = 'ILP_SITE' then 
      tpl.license_type_cd in ('3067' , '3062', '3061')
    else 
      tpl.license_type_cd not in ('3067' , '3062', '3061')
    end
    ;

 
end;
$function$

