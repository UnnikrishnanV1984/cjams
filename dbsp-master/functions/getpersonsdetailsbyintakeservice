CREATE OR REPLACE FUNCTION getpersonsdetailsbyintakeservice(v_intakeserviceid uuid)
 RETURNS TABLE(rolename character varying, personid uuid, firstname character varying, lastname character varying, middlename character varying, dob timestamp without time zone, gender character varying, maritalstatus character varying, race character varying, ssn character varying, dcn character varying, drivinglicense character varying, address json, userphoto text, insertedbyid bigint, interfaceid bigint, currentgrade character varying, relationshiptypekey character varying, relationshiptypenumber integer, homephone character varying, mobile character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE          
_offset  integer;
BEGIN


RETURN QUERY


select 
"Person"."intakeservicerequestpersontypekey",
"Person".personid,
"Person".firstname,
"Person".lastname,
"Person".middlename,
"Person".dob,
"Person".gender,
"Person".maritalstatus,
"Person".race,
"Person".SSN,
"Person".DCN,
"Person".DrivingLicense,
(
select json_agg(paddress) as address from (
select pa.address, pa.address2, pa.city, pa.state, pa.zipcode from personaddress pa where pa.personid = "Person".personid 
--and pa.personaddresstypekey = 'C' 
and activeflag = 1 order by insertedon desc limit 1
) as paddress
)::json,
"Person".userphoto ::text,
--"Person".relationship :: character varying,
"Person".insertedbyid,
"Person".interfaceid,
"Person".currentgrade,
"Person".relationshiptypekey,
"Person".relationshiptypenumber,
"Person".HomePhone,
"Person".Mobile
 FROM 
 
        (
        SELECT 
  IAR.intakeservicerequestpersontypekey as "intakeservicerequestpersontypekey",
  P.personid,p.firstname,p.lastname,p.middlename,gt.typedescription as gender,p.dob,p.userphoto,
  ---PA.address,PA.address2,PA.city,Pa.state,PA.zipcode,
  --AC.actorid,
     --max( IAR.intakeservicerequestactorid:: character varying) :: uuid as intakeservicerequestactorid,
  P.maritalstatustypekey as maritalstatus,
  RC.typedescription as race,
  PIDSSN.personidentifiervalue SSN,
  PIDDCN.personidentifiervalue DCN,
  PIDDL.personidentifiervalue DrivingLicense,
     (SELECT PE.currentgradetypekey FROM Personeducation PE where PE.personid = P.personid
  and PE.activeflag =1 order by PE.insertedon desc limit 1) currentgrade,
  
        -- (SELECT RT.relationshiptypekey from relationshiptype RT inner join actorrelationship AR on 
        -- RT.relationshiptypekey= AR.relationshiptypekey and AR.activeflag=1 
  -- and RT.activeflag =1
        -- where AR.intakeservicerequestactorID = 
        -- --max( IAR.intakeservicerequestactorid:: character varying) :: uuid
        -- IAR.intakeservicerequestactorid  
        -- group by RT.relationshiptypekey) as relationship,
  U.id as insertedbyid,
  P.interfaceid,
  AR.relationshiptypekey,
  RT.sequencenumber relationshiptypenumber,
  PHNHM.phonenumber as HomePhone,
  PHNMB.phonenumber as Mobile
 FROM Intakeservicerequestactor as IAR 
 JOIN actor AS AC ON IAR.actorid=AC.actorid  and AC.activeflag =1 and IAR.activeflag =1
 JOIN person AS P ON P.personid=AC.personid and P.activeflag =1
 Left JOIN gendertype GT on GT.gendertypekey = P.gendertypekey
 Left JOIN racetype RC on RC.racetypekey = P.racetypekey
 Left JOIN PersonIdentifier PIDSSN ON PIDSSN.personid = p.personid and PIDSSN.personidentifiertypekey = 'SSN'
 Left JOIN PersonIdentifier PIDDCN ON PIDDCN.personid = p.personid and PIDDCN.personidentifiertypekey = 'DCN'
 Left JOIN PersonIdentifier PIDDL ON PIDDCN.personid = p.personid and PIDDCN.personidentifiertypekey = 'DL'
 Left JOIN actorrelationship AR ON AR.intakeservicerequestactorID = IAR.intakeservicerequestactorid and AR.activeflag=1 
 Left Join relationshiptype RT ON RT.relationshiptypekey= AR.relationshiptypekey and RT.activeflag=1 
 Left JOIN personphonenumber PHNHM ON PHNHM.personid = p.personid and PHNHM.personphonetypekey = 'H'
 Left JOIN personphonenumber PHNMB ON PHNMB.personid = p.personid and PHNMB.personphonetypekey = 'M'
 JOIN UserProfile UP ON UP.securityusersid = P.insertedby
 JOIN muser U ON U.securityusersid = UP.securityusersid
 

        WHERE IAR.IntakeServiceId=v_intakeserviceid 
  --and coalesce(iar.isprimary,false) =true 
        
        ) as "Person";

 END;

$function$

