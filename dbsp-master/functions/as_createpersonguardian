CREATE OR REPLACE FUNCTION as_createpersonguardian(personjson json, v_personid uuid, securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

   persondata json;
   p_Personid uuid;
   v_securityuserid character varying;
   s_workerObj json;
   s_guardianObj json;
   s_hhsdclientObj json;
   s_codestatusObj json;
   s_funeralhObj json;
  s_guardianattorney json;
 s_guardianproperty json;
 s_guardian json;
   v_date timestamp without time zone;
   i json;
  j json;
   l_Status character varying;
  

BEGIN

   persondata := personjson;
   p_Personid := v_personid;
   
   raise notice 'p_Personid --%>',p_Personid;
   v_date:= now() ;
   v_securityuserid := securityuserid;
            

 CREATE TEMP TABLE temp_sp_Create_Temp_personguardian  ( 
      personguardianid character varying,
      personid character varying,
      guadianpersonid character varying,
      guardianpersontypekey character varying,
      typeofperson character varying,
      startdate date,
      enddate date,
      isNew int default 0);  
      
      
 CREATE TEMP TABLE temp_sp_Create_Temp_personguardiandetails  ( 
 
    personguardiandetailsid character varying,
    personid character varying,
    hhsclientid int,
    notes character varying,
    isNew int default 0 );
    
    
CREATE TEMP TABLE temp_sp_Create_Temp_personguardiancode( 
 
    personguardiancodeid character varying,
       personid character varying,
       codestatustypekey character varying,
       othercodestatus character varying,
    isNew int default 0);
    
 
 
CREATE TEMP TABLE temp_sp_Create_Temp_personguardianfuneral  (  
    personguardianfuneralid character varying,
       personid character varying,
       contact character varying,
       contactnumber character varying,
       arrangementsdescription character varying,   
    isNew int default 0);
 
 
 FOR i IN SELECT * FROM json_array_elements(personjson)
 LOOP

   s_guardianObj:= i->>'guardian';
  
 s_workerObj:=s_guardianObj->>'WRK';
 s_guardian:=s_guardianObj->>'GOP';
 s_guardianproperty:=s_guardianObj->>'GOPT';
 s_guardianattorney:=s_guardianObj->>'ATTY';

   insert into temp_sp_Create_Temp_personguardian
 select   * from json_to_recordset(s_workerObj) as x("personguardianid" character varying,
      "personid" character varying,
      "guadianpersonid" character varying,
      "guardianpersontypekey" character varying,
       "typeofperson" character varying,
      "startdate" date,
      "enddate"  date);
        insert into temp_sp_Create_Temp_personguardian
 select   * from json_to_recordset(s_guardianproperty) as x("personguardianid" character varying,
      "personid" character varying,
      "guadianpersonid" character varying,
      "guardianpersontypekey" character varying,
       "typeofperson" character varying,
      "startdate" date,
      "enddate"  date);
 insert into temp_sp_Create_Temp_personguardian
 select   * from json_to_recordset(s_guardian) as x("personguardianid" character varying,
      "personid" character varying,
      "guadianpersonid" character varying,
      "guardianpersontypekey" character varying,
       "typeofperson" character varying,
      "startdate" date,
      "enddate"  date);
     insert into temp_sp_Create_Temp_personguardian
 select   * from json_to_recordset(s_guardianattorney) as x("personguardianid" character varying,
      "personid" character varying,
      "guadianpersonid" character varying,
      "guardianpersontypekey" character varying,
       "typeofperson" character varying,
      "startdate" date,
      "enddate"  date);
     
           
  s_hhsdclientObj := s_guardianObj->>'hhsdclient'; 

  raise notice 's_hhsdclientObj--%>',s_hhsdclientObj;
  insert into temp_sp_Create_Temp_personguardiandetails  (
         personguardiandetailsid,
       personid,
       hhsclientid, 
      notes
  ) values 
  ((s_hhsdclientObj ->> 'personguardiandetailsid'),
     (s_hhsdclientObj ->> 'personid'),
     (s_hhsdclientObj ->> 'hhsclientid')::int,
     (s_hhsdclientObj ->> 'notes')
     
    );
  
      
      
 s_codestatusObj:= s_guardianObj->>'codestatus';
 raise notice 's_codestatusObj--%>',s_codestatusObj;
  insert into temp_sp_Create_Temp_personguardiancode  (
        personguardiancodeid,
       personid,
       codestatustypekey ,
       othercodestatus 
  ) values 
  ((s_codestatusObj ->> 'personguardiancodeid'),
     (s_codestatusObj ->> 'personid'),
     (s_codestatusObj ->> 'codestatustypekey'),
     (s_codestatusObj ->> 'othercodestatus')
     
    );
     
     
 s_funeralhObj := s_guardianObj->>'funeral';     
 insert into temp_sp_Create_Temp_personguardianfuneral
 select   * from json_to_recordset(s_funeralhObj ) as x("personguardianfuneralid" character varying,
     "personid" character varying,
     "contact" character varying,
     "contactnumber" character varying,
     "arrangementsdescription" character varying
     );


 update temp_sp_Create_Temp_personguardian set  isNew =1 where coalesce(personguardianid::character varying,'','') ='';

update temp_sp_Create_Temp_personguardiandetails  set  isNew =1 where coalesce(personguardiandetailsid::character varying,'','') ='';

 update temp_sp_Create_Temp_personguardiancode set  isNew =1 where coalesce(personguardiancodeid::character varying,'','') ='';

      
 update temp_sp_Create_Temp_personguardianfuneral set  isNew =1 where coalesce(personguardianfuneralid::character varying,'','') ='';


UPDATE personguardian pet SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pet.personguardianid::character varying  NOT in (SELECT coalesce( personguardianid::character varying,'')  from      
                                                       temp_sp_Create_Temp_personguardian where isnew=0)
     AND pet.personid = p_Personid; 
 
 
UPDATE personguardiandetails pd SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pd.personguardiandetailsid::character varying  NOT in (SELECT coalesce( personguardiandetailsid::character varying,'')  from      
                                                       temp_sp_Create_Temp_personguardiandetails where isnew=0)
     AND pd.personid = p_Personid; 
        

   
      
UPDATE personguardiancode pc SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pc.personguardiancodeid::character varying  NOT in (SELECT coalesce( personguardiancodeid::character varying,'')  from      
                                                       temp_sp_Create_Temp_personguardiancode where isnew=0)
     AND pc.personid = p_Personid; 

    
   


 
 UPDATE personguardianfuneral pf SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pf.personguardianfuneralid::character varying  NOT in (SELECT coalesce( personguardianfuneralid::character varying,'')  from      
                                                       temp_sp_Create_Temp_personguardianfuneral where isnew=0)
     AND pf.personid = p_Personid; 
    
    
     INSERT INTO personguardian( personid, guadianpersonid, guardianpersontypekey,typeofperson,startdate, enddate, 
     activeflag,insertedby, updatedby, insertedon, updatedon)
 
    SELECT p_Personid::uuid,guadianpersonid::uuid, guardianpersontypekey, typeofperson,startdate, enddate, 
     1,v_securityuserid,v_securityuserid, v_date, v_date FROM   temp_sp_Create_Temp_personguardian WHERE isNew=1; 
    
    insert into personguardiandetails( personid, hhsclientid, notes, 
         
       activeflag,insertedby, updatedby, insertedon, updatedon)

     SELECT p_Personid::uuid,hhsclientid, notes,  
   1,v_securityuserid,v_securityuserid, v_date, v_date FROM   temp_sp_Create_Temp_personguardiandetails WHERE isNew=1;
    
     INSERT INTO personguardiancode(personid,codestatustypekey, othercodestatus,
     activeflag, updatedby,insertedby, updatedon, insertedon)
     
     SELECT p_Personid::uuid,codestatustypekey,othercodestatus ,
               1,v_securityuserid,v_securityuserid, v_date, v_date FROM   
      temp_sp_Create_Temp_personguardiancode WHERE isNew=1;
      
    
    
    insert into personguardianfuneral(personid,contact,contactnumber,arrangementsdescription,
     activeflag, updatedby,insertedby, updatedon, insertedon )
     
     SELECT p_Personid::uuid,contact ,
       contactnumber,
       arrangementsdescription ,  
               1,v_securityuserid,v_securityuserid, v_date, v_date FROM   
      temp_sp_Create_Temp_personguardianfuneral WHERE isNew=1;
      
      
      
 
      
    

END LOOP; 
    
 

l_Status := 'SUCCESS';

DROP TABLE temp_sp_Create_Temp_personguardian;
DROP TABLE temp_sp_Create_Temp_personguardiandetails;
DROP TABLE temp_sp_Create_Temp_personguardiancode;
DROP TABLE temp_sp_Create_Temp_personguardianfuneral;

return l_Status;

END;

$function$

