CREATE OR REPLACE FUNCTION f_prim_worker(ai_entity_id integer, as_entity_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
 
BEGIN  
 RETURN
    CASE
      when as_entity_type_cd = '2955' then
        (select securityusersid from (
SELECT row_number() over() as num, userprofile.securityusersid
     FROM case ca,   
            caseclient,   
            TB_CLIENT,
     TB_ASSIGNMENT,
     userprofile  

     WHERE ( caseclient.caseid = ca.caseid ) and  
            ( TB_CLIENT.CLIENT_ID = caseclient.old_id )  and
     ( TB_ASSIGNMENT.ENTITY_TYPE_CD = '2952') and
     ( TB_ASSIGNMENT.ENTITY_KEY_ID = caseclient.old_id) and 
     ( TB_ASSIGNMENT.RESPONSIBILITY_CD = 'P') and 
     ( TB_ASSIGNMENT.END_DT IS NULL) and 
     ( userprofile.securityusersid = TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID) and 
      --( TB_CLIENT.CLIENT_ID = AI_ENTITY_ID) and
     ( ca.activeflag = 0) and
     ( TB_CLIENT.DELETE_SW = 'N') and
     ( TB_ASSIGNMENT.DELETE_SW = 'N') and
     ( userprofile.activeflag = 0))as er where num=1 )
        
 
    else
  (select securityusersid from (
SELECT  row_number() over() as num,userprofile.securityusersid
     FROM  TB_ASSIGNMENT,
           userprofile
     WHERE ( TB_ASSIGNMENT.ENTITY_TYPE_CD = AS_ENTITY_TYPE_CD) and
            ( TB_ASSIGNMENT.ENTITY_KEY_ID = AI_ENTITY_ID) and
            ( TB_ASSIGNMENT.RESPONSIBILITY_CD = 'P') and
            ( TB_ASSIGNMENT.END_DT IS NULL) and
            ( userprofile.securityusersid = TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID)  and
            ( TB_ASSIGNMENT.DELETE_SW = 'N') and
            ( userprofile.activeflag = 0) ) as ty where num=1)

    END;
END;

$function$

