CREATE OR REPLACE FUNCTION prov_getapprovalcode(v_program character varying, v_programtype character varying, v_providertype character varying)
 RETURNS TABLE(approvaltypecode character varying)
 LANGUAGE plpgsql
AS $function$
 
BEGIN 
 return query
 select prgname.approvaltypecode from provprogramtypename prgname where programtype=v_program and  programname=v_programtype and providertype=v_providertype;

END;

$function$

