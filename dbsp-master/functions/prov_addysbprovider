CREATE OR REPLACE FUNCTION prov_addysbprovider(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
 declare                                                                                                                                                                                                                                                                                                                                                                                               
 v_providerId character varying;                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying;                                                                                                                                                                                                                                                                                                                                                                   
 v_statuscode text;                                                                                                                                                                                                                                                                                                                                                                                    
 v_categorycd text;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
 v_refid character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
 v_addressarr json;                                                                                                                                                                                                                                                                                                                                                                                    
 v_adrtype text;                                                                                                                                                                                                                                                                                                                                                                                       
 v_adrid uuid;                                                                                                                                                                                                                                                                                                                                                                                         
 v_adrtypecd text;
 --Finance values                                                                                                                                                                                                                                                                                                                                                                                  
 v_payToAffiliateCd TEXT;
 v_affiliate_provider_id TEXT;
 v_tax_id TEXT;
 v_pvtcounty TEXT;
 v_licno text;      
 v_effectivedate date;                                                                                                                                                                                                                                                                                                                                                                                                                                   
 v_enddate date;  

 begin                                                                                                                                                                                                                                                                                                                                                                                                 
 v_providerId := insertobj->>'provider_id';                                                                                                                                                                                                                                                                                                                                                            
 v_refid := insertobj->>'ysb_referral_id';                                                                                                                                                                                                                                                                                                                                                                
 v_securityuserid := insertobj->>'securityuserid';                                                                                                                                                                                                                                                                                                                                                     
 v_statuscode :='1791';                                                                                                                                                                                                                                                                                                                                                                                
 --Finance values
 v_payToAffiliateCd := '3368';
 v_pvtcounty := '3824';                                                                                                                                                                                                                                                                                                                                                                                                       
v_categorycd := '3795';

 v_licno := 'DJS'||nextval('tb_provider_licensing_sitedid_seq'::regclass);  
  
 IF LENGTH(v_providerId) > 1                                                                                                                                                                                                                                                                                                                                                                           
 then       

 SELECT yr.eligible_startdt , yr.eligible_enddt                      
into v_effectivedate, v_enddate                                                                                                                                                                                                                                                                                                               
FROM ysb_referral yr where yr.ysb_referral_id = v_refid;                                                                                                                                                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                                                                                                                               
 INSERT INTO prov.tb_provider(provider_id, provider_category_cd, provider_status_cd, affiliate_provider_id, 
 create_ts, create_user_id, update_ts, update_user_id, adr_email_tx , adr_cell_phone_tx, adr_fax_tx, 
 adm_contact_first_nm , adm_contact_last_nm , provider_nm, 
 PROV_TAX_TYPE_CD, MAIL_CODE_TX, INDICATOR_1099_SW, PAY_TO_AFFILIATE_CD, tax_id_no, county_cd)                                                                                                                                         
 select (v_providerId)::int, v_categorycd, v_statuscode , (yr.provider_id)::int, 
 now(),v_securityuserid, now(), v_securityuserid , yr.contact_emailid, yr.contact_phone , yr.fax_number ,
 LEFT(yr.contact_fname,20) , LEFT(yr.contact_lname,20) , yr.ysb_prvdr_name,
 '2517', '000', 'N', v_payToAffiliateCd, yr.tax_id::int, v_pvtcounty
 from ysb_referral yr where yr.ysb_referral_id = v_refid;                                                                               

INSERT INTO prov.tb_provider_picklist
( provider_id, program_id, picklist_type_id, picklist_value_cd, create_user_id, update_user_id, delete_sw, value_desc, create_ts, update_ts)
VALUES( (v_providerId)::int, NULL, 155, v_categorycd, v_securityuserid, v_securityuserid, 'N', NULL, now(), now());
                                                                                                                                                                                                                                                                                                                                                                                                     
update prov.ysb_referral set provider_id = (v_providerId)::int where ysb_referral_id = v_refid;                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                                       
 INSERT INTO prov.tb_provider_addresses                                                                                                                                                                                                                                                                                                                                                                     
 (parent_key_id, adr_type_cd, adr_format_cd, adr_street_no, adr_box_no, adr_pre_dir_cd, adr_street_nm, adr_street_suffix_cd, adr_post_dir_cd, adr_unit_type_cd, adr_unit_no_tx, adr_city_nm, adr_county_cd, adr_state_cd, adr_zip5_no, adr_country_tx, adr_start_dt, adr_end_dt,adr_default_sw,create_ts, create_user_id, update_ts, update_user_id, delete_sw, adr_street_tx)                                                 
 select v_providerId, adr_type_cd, adr_format_cd, adr_street_no, adr_box_no, adr_pre_dir_cd, adr_street_nm, adr_street_suffix_cd, adr_post_dir_cd, adr_unit_type_cd, adr_unit_no_tx, adr_city_nm, adr_county_cd, adr_state_cd, adr_zip5_no, adr_country_tx, adr_start_dt, adr_end_dt,adr_default_sw,now(), v_securityuserid, now(), v_securityuserid, 'N', adr_street_tx
 FROM prov.tb_provider_referral_addresses pra                                                                                                                                                                                                                                                                                                                                                              
 WHERE  pra.parent_key_id = v_refid;  

INSERT INTO tb_provider_licensing                                                                                                                                                                                                                                                                                                                                                                                                                       
(site_id, provider_id, license_type_cd, license_status_cd, application_type_cd, license_decision_cd,                                                                                                                                                                                                                                                                                                                                                    
license_issue_dt, license_expiry_dt, license_modification_dt, license_no, licensing_agency_cd, licensing_corodinator_id, licensed_beds_no, requirement_sw, midterm_issue_dt, active_sw, comments_tx, program_id,                                                                                                                                                                                                                                        
revoke_dt, revoke_approval_status_cd, midterm_rqrmnt_sw, create_ts, create_user_id, update_ts, update_user_id, delete_sw, ref_license_application_id, lic_entry_dt, request_revoke_sw, pre_revoke_status_cd , license_type ,license_level)                                                                                                                                                                                                              
VALUES((v_providerId)::int, (v_providerId)::int, NULL , '3263', '3068', '3263',v_effectivedate, v_enddate, NULL,                                                                                                                                                                                                                                                                                                                        
v_licno, '1491', 0, 0, '', NULL, 'Y', '', 0, NULL, '', '', now(), v_securityuserid, now(),                                                                                                                                                                                                                                                                                                                                                                   
v_securityuserid, 'N'::bpchar, 0, NULL, '', '','Youth Service Bureaus','YSB');                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                                       
 return 'success';                                                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                                                                       
 else                                                                                                                                                                                                                                                                                                                                                                                                  
 return 'failure';                                                                                                                                                                                                                                                                                                                                                                                     
 end if;                                                                                                                                                                                                                                                                                                                                                                                               
 end;                                                                                                                                                                                                                                                                                                                                                                                                  
 $function$

