select tce.eligibility_id, tce.start_dt, tce.end_dt into v_eligibility_id, v_eli_start_dt, v_eli_end_dt from tb_client_eligibility tce where tce.client_id = cjamspid and tce.eligibility_type_cd = '2935' ;
select gapauditid into v_gapauditid from tb_ive_gapaudit where transactionid = v_transactionid;
Update tb_eligibility_period set delete_sw = 'Y' where eligibility_id = v_eligibility_id and sqnm_sw = category;


v_type_cd = '2923';

IF(category = 'R') THEN
 gapeligibilitystatus := extgapeligibilitystatus;
 v_type_cd = '2924';
END IF;

IF(gapeligibilitystatus = 'InComplete_Application') THEN
 gapeligibilitystatus := 'Incomplete'; 
END IF; 

SELECT tpv.picklist_value_cd INTO v_picklist_value_cd FROM tb_picklist_values tpv 
WHERE tpv.picklist_type_id = 262 AND upper(tpv.value_tx) = upper(gapeligibilitystatus);

INSERT INTO tb_eligibility_period
(eligibility_period_id, start_dt, end_dt, status_cd, eligibility_id, create_ts, create_user_id, update_ts, update_user_id, delete_sw, sqnm_sw, finalresult)
