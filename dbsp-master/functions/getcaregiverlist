CREATE OR REPLACE FUNCTION getcaregiverlist(v_personid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                              
 
 DECLARE
  v_response json;                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                            
 BEGIN
   
   SELECT  jsonb_agg(a) INTO v_response FROM ( SELECT  person1id AS personid, (select concat( p.prefx, ' ', p.firstname, ' ', p.middlename, ' ', p.lastname, ' ', p.suffix) as personname from person p where p.personid = ar.person1id) from actorrelationship ar where 
 ar.person2id:: CHARACTER VARYING = v_personid 
 and ar.caregiverflag= 1 ) AS a;

 RETURN v_response;                                                                                                                                                                                                                                                                                                                                                       
 END;                                                                                                                                                                                                                                                                                                                                                
 $function$

