CREATE OR REPLACE FUNCTION sp_check_comm_intrest(v_commingled_account_id integer, v_interest_start_dt date)
 RETURNS boolean
 LANGUAGE plpgsql
AS $function$


declare
 return_val boolean;
 v_exists int;
 
BEGIN 

 
 select count(1) into v_exists from tb_comm_acct_transactions tcat where tcat.comm_account_id  = v_commingled_account_id  and
 EXTRACT(month FROM date_trunc('month', tcat.interest_start_dt)) = 
    EXTRACT(month FROM date_trunc('month', v_interest_start_dt)) and
   EXTRACT(year FROM date_trunc('year', tcat.interest_start_dt)) = 
    EXTRACT(year FROM date_trunc('year', v_interest_start_dt)) and
    tcat.delete_sw = 'N';

   if(v_exists > 0)
   then
   return_val := false; 
   else
   return_val := true;
   end if;
  return return_val;
END;

$function$

