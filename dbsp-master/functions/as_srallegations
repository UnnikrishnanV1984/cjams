CREATE OR REPLACE FUNCTION as_srallegations(_servicerequestnumber character varying, _page integer, _limit integer)
 RETURNS TABLE(servicerequestnumber character varying, name character varying, indicators text, reported boolean)
 LANGUAGE plpgsql
AS $function$
DECLARE
v_liPageNumber  INT;
  v_pageoffset  INT;

BEGIN
  v_liPageNumber := _page -1;
  v_pageoffset = v_liPageNumber * _limit;  

RETURN QUERY
SELECT ISR.ServiceRequestNumber, INVA.Name,INVA.Indicators, INVA.Reported
FROM InvestigationAllegation INVA
     JOIN Investigation INV   ON INV.InvestigationId  = INVA.InvestigationId and INV.ActiveFlag = 1
     JOIN IntakeServiceRequest ISR ON INV.IntakeServiceId  = ISR.IntakeServiceId 
WHERE    ISR.ServiceRequestNumber = _servicerequestnumber and INVA.ActiveFlag = 1 LIMIT _limit OFFSET v_pageoffset;

END;
$function$

