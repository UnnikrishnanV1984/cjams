CREATE OR REPLACE FUNCTION as_updatepurchaseauthorization(searchobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_fiscal_category_cd character(5);
 v_justification_tx character varying;
 v_funding_source_cd character varying;
 v_authorization_id integer;
    


 
BEGIN 
v_fiscal_category_cd := searchobj ->> 'fiscal_category_cd';
v_justification_tx := searchobj ->> 'justification_tx'; 
v_authorization_id := searchobj ->> 'authorization_id'; 




 
        

select trim(picklist_value_cd) as picklist_value_cd into v_funding_source_cd from tb_picklist_values where picklist_type_id=32 and value_tx like '%7177%';


update tb_service_purchase_authorization set justification_tx=v_justification_tx,
fiscal_category_cd=v_fiscal_category_cd,funding_source_cd=v_funding_source_cd
where authorization_id=v_authorization_id;


return 'Success';

END;

$function$

