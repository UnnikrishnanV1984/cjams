CREATE OR REPLACE FUNCTION as_sp_adoption_eligibility_worksheet_info_2(al_client_id bigint)
 RETURNS TABLE(client_id bigint, childjurisdiction character varying, childagency character varying, removalage integer, servicecaseid uuid, casenumber character varying, childremovaldate timestamp without time zone, removalid bigint, removalcourtorderdate timestamp without time zone, dateofbirth timestamp without time zone, gender character varying, childname character varying, childraceethnicity character varying, uscitizen character varying, qualifiedalien character varying, nameofsecondaryeducationorequivalentprogram character varying, startdateofsecondaryeducationorequivalentprogram timestamp without time zone, nameofpostsecondaryorvocationaleducation character varying, startdateofpostsecondaryorvocationaleducation timestamp without time zone, nameofemployer character varying, startdateofemployment timestamp without time zone, hourspermonthemployed integer, promoteemploymentprogram character varying, promoteemploymentprogramstartdate timestamp without time zone, childdisabilitystartdate timestamp without time zone, childdisabilityevaluationdocumentiondate timestamp without time zone, childdisabilitytype character varying, adoptionapplicable timestamp without time zone, adoptionassistancestartdate timestamp without time zone, effortstoplacechildweremade character varying, finalizationdate timestamp without time zone, adoptionnonapplicable character varying, adoptionpetitiondate timestamp without time zone, childdeprivedofparentalsupport character varying, childhasemotionaldisturbance character varying, childphysicaladdress character varying, childexpectedadoptiveproviderid bigint, issingleparent integer, subsidypaymentstartdate timestamp without time zone, dateoflatestpaymentofminorparent timestamp without time zone, tprdetails json, isafdceligibilitymet character varying, wasthechildremovedfromspecifiedrelative character varying, isincomeassetsmet character varying, parent1providerid integer, parent1providername character varying, effortdate timestamp without time zone, isnoeffort character varying, isexceptiongranted character varying, dateofexceptiongranted timestamp without time zone, removaltypekey character varying, remarks text, placementid uuid)
 LANGUAGE plpgsql
AS $function$



DECLARE 
  vs_Procedure_nm             VARCHAR(100) DEFAULT 'sp_adoption_eligibility_worksheet_info';  
  vn_srv_req_id             UUID;
  vs_srv_req_no             VARCHAR(50);
  vd_child_rmvl_dt            TIMESTAMP;
  vd_child_rmvl_crt_ord_dt          TIMESTAMP;
  vd_birth_dt              TIMESTAMP;
  vs_gender              VARCHAR(20);
  vs_nm               VARCHAR(50);
  vs_race               VARCHAR(50);
  vs_us_ctzn              VARCHAR(50);
  vs_qlfd_alien             VARCHAR(50);
  vs_scndry_edu_eqlnt_prgm          VARCHAR(50);
  vd_scndry_edu_eqlnt_prgm_strt_dt        TIMESTAMP;
  vs_post_scndry_vctl_edu           VARCHAR(50);
  vd_post_scndry_vctl_edu_strt_dt         TIMESTAMP;
  vs_empl_nm              VARCHAR(50);
  vd_empl_strt_dt             TIMESTAMP;
  vn_empl_hrs_mnth            INTEGER;
  vs_prmt_empl_nm             VARCHAR(50);
  vd_prmt_empl_strt_dt           TIMESTAMP;
  vd_chd_disablty_strt_dt           TIMESTAMP;
  vd_chd_disablty_evltn_docmntn_dt        TIMESTAMP;
  vs_chd_disablty_tp            VARCHAR(50);
  vd_adp_applcble_dt            TIMESTAMP;
  vd_adp_asst_st_dt            TIMESTAMP;
  vs_efrts_to_place_chld           VARCHAR(50);
  vd_fnlztn_dt             TIMESTAMP;
  vs_adptn_non_applcble           VARCHAR(20);
  vd_adptn_pitn_dt            TIMESTAMP;
  vs_child_dprvd_prntl_sprt          VARCHAR(20);
  vs_chld_has_emtnl_distrbnce          VARCHAR(20);
  vs_child_physical_add           VARCHAR(500);
  vn_chld_expctd_adptv_prvdr          BIGINT;
  vs_jrsdctn              VARCHAR(50);
  vs_chd_agcy              VARCHAR(50);
  vn_child_age_rmvl                  INTEGER;
  vd_removal_id                                                   BIGINT;
     v_isSingleParent                               integer; 
  v_subsidypaymentstartdate                      timestamp without time zone;
  v_parent_details              record;
  v_aagrecord                record;
  v_date_of_latest_payment_of_minor_parent       timestamp without time zone;
     v_tpr_details             JSON;
     v_is_afdc_eligibility_met          VARCHAR(20);
     v_wasthechildremovedfromspecifiedrelative      VARCHAR(20);
     v_is_income_assets_met           VARCHAR(20);
  v_parent_provider_id                 INTEGER; 
  v_parent_provider_name           VARCHAR(100);
  v_effort_date                         timestamp without time zone;
  v_isno_effort             VARCHAR(50);
  v_is_exception_granted            VARCHAR(50);
  v_date_of_exception_granted          timestamp without time zone;
  v_removal_type_key             VARCHAR(50);
  v_remarks               TEXT;
  vd_placementid             UUID;
 BEGIN  
CREATE TEMP TABLE IF NOT EXISTS
Temp_adoption_eligibility_worksheet_info ( 
  client_id             BIGINT,
  childjurisdiction          VARCHAR(50),
  childagency            VARCHAR(50),
  removalage            INTEGER,
  servicecaseid           UUID,
  casenumber            VARCHAR(50),
  childremovaldate          TIMESTAMP,
  removalid            BIGINT,
  removalcourtorderdate         TIMESTAMP,
  dateofbirth            TIMESTAMP,
  gender             VARCHAR(20),
  childname            VARCHAR(50),
  childraceethnicity          VARCHAR(50),
  uscitizen            VARCHAR(50),
  qualifiedalien           VARCHAR(50),
  nameofsecondaryeducationorequivalentprogram    VARCHAR(50),
  startdateofsecondaryeducationorequivalentprogram  TIMESTAMP,
  nameofpostsecondaryorvocationaleducation    VARCHAR(50),
  startdateofpostsecondaryorvocationaleducation   TIMESTAMP,
  nameofemployer           VARCHAR(50),
  startdateofemployment         TIMESTAMP,
  hourspermonthemployed         INTEGER,
  promoteemploymentprogram        VARCHAR(50),
  promoteemploymentprogramstartdate      TIMESTAMP,
  childdisabilitystartdate        TIMESTAMP,
  childdisabilityevaluationdocumentiondate    TIMESTAMP,
  childdisabilitytype          VARCHAR(50),
  adoptionapplicable          TIMESTAMP,
  adoptionassistancestartdate        TIMESTAMP,
  effortstoplacechildweremade        VARCHAR(50),
  finalizationdate          TIMESTAMP,
  adoptionnonapplicable         VARCHAR(20),
  adoptionpetitiondate         TIMESTAMP,
  childdeprivedofparentalsupport       VARCHAR(20),
  childhasemotionaldisturbance       VARCHAR(20),
  childphysicaladdress         VARCHAR(500),
  childexpectedadoptiveproviderid       BIGINT,
  isSingleParent            integer, 
  subsidypaymentstartdate         timestamp without time zone,
  dateoflatestpaymentofminorparent       timestamp without time zone,
  tprdetails             json NULL,
  isafdceligibilitymet         VARCHAR(20),
  wasthechildremovedfromspecifiedrelative     VARCHAR(10),
  isincomeassetsmet          VARCHAR(20),
  parent1providerid           INTEGER,
  parent1providername          VARCHAR(100),
  effortdate             timestamp without time zone, 
  isnoeffort            VARCHAR(50),
  isexceptiongranted           VARCHAR(50),
  dateofexceptiongranted          timestamp without time zone,
  removaltypekey           VARCHAR(50),
  remarks             TEXT,
  placementid           UUID
 ); 
-- Child Jurisdiction  
-- SELECT peradr.county
--   INTO vs_jrsdctn
--    FROM person per, personaddress peradr
-- WHERE per.personid = peradr.personid AND peradr.activeflag = 1
--  AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

select c.countyname,pl.placementid INTO vs_jrsdctn,vd_placementid 
        from caseassignment ca
        join routing r on r.teamid = ca.fromteamid and r.activeflag= 1
        join team t on t.teamid = ca.fromteamid and t.activeflag= 1
        join placement pl on pl.placementid:: character varying = r.objectid :: character varying and pl.activeflag =1
        join intakeservicerequestactor isra on isra.intakeservicerequestactorid = pl.intakeservicerequestactorid and isra.activeflag =1
        join county c on c.countyid :: character varying = t.countyid and c.activeflag =1
 join person per on per.personid = isra.personid
where r.activeflag=1 AND r.eventcode='PLTR'
        and per.cjamspid::BIGINT = al_client_id
        order by r.insertedon desc limit 1;
  

-- Child Agency
SELECT (CASE WHEN teamtypekey = 'CW' THEN
    'DHS'::VARCHAR 
   WHEN teamtypekey = 'DJS' THEN
    'DJS'::VARCHAR
   ELSE NULL END)
 INTO vs_chd_agcy  
 FROM intakeservicerequest isr, permanencyplan pp, intakeservicerequestactor isra, person per 
WHERE pp.servicecaseid = isr.servicecaseid AND pp.activeflag = 1
 AND isra.intakeservicerequestactorid = pp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Child Age At Removal
SELECT extract('years' FROM isrcr.removaldate)::int -  extract('years' FROM per.dob)::int
 INTO vn_child_age_rmvl
   FROM intakeservreqchildremoval isrcr, intakeservicerequestactor isra, person per 
WHERE isrcr.intakeservicerequestactorid = isra.intakeservicerequestactorid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY isrcr.updatedon DESC LIMIT 1;

-- Service Case ID  
SELECT sc.servicecaseid
  INTO vn_srv_req_id
    FROM servicecase sc
    inner join intakeservicerequestactor isra on isra.servicecaseid = sc.servicecaseid
   inner join person per on per.personid = isra.personid
WHERE 
 isra.intakeservicerequestpersontypekey = 'CHILD' 
 AND per.cjamspid::BIGINT =  al_client_id and isra.activeflag = 1 and per.activeflag = 1 order by sc.updatedon limit 1;
-- Case Number  
SELECT sc.servicecasenumber
  INTO vs_srv_req_no
   FROM servicecase sc, placement pl, intakeservicerequestactor isra, person per 
WHERE sc.servicecaseid = pl.servicecaseid AND sc.activeflag = 1 
 AND pl.activeflag = 1
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 order by sc.updatedon limit 1;

-- Child Removal Date
SELECT isrcr.removaldate , isrcr.removalid, isrcr.removaltypekey 
 INTO vd_child_rmvl_dt , vd_removal_id, v_removal_type_key
   FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra     
WHERE isra.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid AND isra.activeflag = 1 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY isrcr.updatedon DESC LIMIT 1;

-- Child Removal Date
--SELECT ( CASE WHEN (rtrim(isrcr.removaltypekey) = 'TLV' 
--    OR rtrim(isrcr.removaltypekey) = 'CDVP' 
--    OR rtrim(isrcr.removaltypekey) = 'EHA' ) 
--    THEN isrcr.removaldate::timestamp ELSE NULL END )
-- INTO vd_child_rmvl_dt
--   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per 
--WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
-- AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
-- AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1; 


-- SELECT ( CASE WHEN (isrcr.removaltypekey = 'JD') 
--     THEN (select MAX(isrco.courtorderdate)::timestamp from intakeservreqcourtorder isrco
--     WHERE isrco.servicecaseid =  isrcr.servicecaseid AND isrco.activeflag = 1) ELSE NULL END )  
--  INTO vd_child_rmvl_crt_ord_dt   
--    FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra     
-- WHERE isra.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
--  AND isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid 
--  AND isra.activeflag = 1
