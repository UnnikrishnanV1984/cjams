--  AND per.cjamspid::BIGINT = al_client_id 
--  AND per.activeflag = 1 ORDER BY isrcr.updatedon DESC LIMIT 1;

-- Removal Court Order Date
SELECT isrco.courtorderdate INTO vd_child_rmvl_crt_ord_dt
FROM  intakeservreqcourtorder isrco, intakeservreqcourtorderdetails iscod, intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra
WHERE  isrco.intakeservreqcourtorderid = iscod.intakeservreqcourtorderid  and isrco.servicecaseid = isrcr.servicecaseid AND isrco.activeflag = 1 
  AND isrco.courtorderdate >= vd_child_rmvl_dt
  AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid = '838f07f5-0c94-4f13-b5c0-658c4b9ad5bc' and iscod.isselected = 1) -- Contrary to Welfare    
  AND isra.intakeserviceid = isrcr.intakeserviceid AND isrcr.activeflag = 1
  AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.activeflag = 1
  AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1  
  AND isrcr.removaltypekey = 'JD' order by isrco.courtorderdate limit 1;

 
-- Date of Birth   
SELECT per.dob  
 INTO vd_birth_dt
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;

-- Gender  
SELECT per.gendertypekey  
 INTO vs_gender
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;
  
-- Name  
SELECT concat(per.firstname, ' ', per.middlename, ' ', per.lastname)  
 INTO vs_nm
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;
 
-- Child Race
SELECT rt.typedescription::VARCHAR
 INTO vs_race
 FROM racetype rt, person per
WHERE rt.activeflag = 1 AND TRIM(rt.racetypekey)=TRIM(per.racetypekey)
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- US Citizen   
SELECT (CASE WHEN (TRIM(per.primarycitizenshiptypekey) = 'US' or  TRIM(per.primarycitizenshiptypekey) = 'USA')
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END)   
 INTO vs_us_ctzn
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;
   
-- Qualified Alien   
SELECT (CASE WHEN (per.alienstatustypekey is not null and  
     per.alienregistrationtext is not null and 
     TRIM(per.alienregistrationtext) != '' ) 
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END)
 INTO vs_qlfd_alien
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Name Of Secondary Education/Equivalent Program   
SELECT ( CASE WHEN (rtrim(pedu.educationtypekey) = 'SECY' )
     THEN ( SELECT typedescription 
       FROM educationtype 
       WHERE TRIM(educationtypekey)=TRIM(pedu.educationtypekey) ) 
     ELSE NULL END )
 INTO vs_scndry_edu_eqlnt_prgm
   FROM personeducation pedu, person per     
WHERE per.personid = pedu.personid AND pedu.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Secondary Education/Equivalent Program Start Date   
SELECT ( CASE WHEN (rtrim(pedu.educationtypekey) = 'SECY' )
     THEN ( SELECT pedu.startdate ) 
     ELSE NULL END )
 INTO vd_scndry_edu_eqlnt_prgm_strt_dt
   FROM personeducation pedu, person per     
WHERE per.personid = pedu.personid AND pedu.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Name Of Post-Secondary/Vocational Education   
SELECT ( CASE WHEN (rtrim(pedu.educationtypekey) = 'PTSECY' )
     THEN ( SELECT typedescription 
       FROM educationtype 
       WHERE TRIM(educationtypekey)=TRIM(pedu.educationtypekey) ) 
     ELSE NULL END )
 INTO vs_post_scndry_vctl_edu
   FROM personeducation pedu, person per     
WHERE per.personid = pedu.personid AND pedu.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
  
-- Post-Secondary/Vocational Education Start Date   
SELECT ( CASE WHEN (rtrim(pedu.educationtypekey) = 'PTSECY' )
     THEN ( SELECT pedu.startdate ) 
     ELSE NULL END )
 INTO vd_post_scndry_vctl_edu_strt_dt
   FROM personeducation pedu, person per     
WHERE per.personid = pedu.personid AND pedu.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Employer Name
SELECT pemp.employername  
 INTO vs_empl_nm
   FROM personemployerdetail pemp, person per     
WHERE per.personid = pemp.personid AND pemp.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Employment Start Date
SELECT pemp.startdate 
 INTO vd_empl_strt_dt
   FROM personemployerdetail pemp, person per     
WHERE per.personid = pemp.personid AND pemp.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Employed Hours/Month
SELECT pemp.noofhours 
 INTO vn_empl_hrs_mnth
   FROM personemployerdetail pemp, person per     
WHERE per.personid = pemp.personid AND pemp.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Promote to Employment Program  
SELECT grd.empprogramname
 INTO vs_prmt_empl_nm
   FROM guardianship grd, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = isra.servicecaseid AND grd.activeflag = 1 
   AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 LIMIT 1;

-- Promote to Employment Program Start Date  
SELECT grd.empprogramstartdate
 INTO vd_prmt_empl_strt_dt
   FROM guardianship grd, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = isra.servicecaseid AND grd.activeflag = 1 
   AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 LIMIT 1;  

-- Child Disability Start Date
SELECT pdis.startdate 
 INTO vd_chd_disablty_strt_dt
   FROM persondisability pdis, person per     
WHERE per.personid =  pdis.personid AND pdis.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
  
 -- Child Disability Evaluation Documentation Date
SELECT pdis.evaluationdate 
 INTO vd_chd_disablty_evltn_docmntn_dt
   FROM persondisability pdis, person per     
WHERE per.personid =  pdis.personid AND pdis.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Child Disability Type
SELECT ( CASE WHEN (pdis.disabilityflag = 1)
   THEN 'Permanent'::VARCHAR ELSE 'Temporary'::VARCHAR END )  
 INTO vs_chd_disablty_tp
   FROM persondisability pdis, person per     
WHERE per.personid =  pdis.personid AND pdis.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;


-- Parent provider name
SELECT aa.parent1providerid, aa.parent1providername INTO v_parent_provider_id, v_parent_provider_name
   FROM adoptionagreementrate aar, adoptionagreement aa, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, 
 intakeservicerequestactor isra, person per, permanencyplan pp
WHERE aar.adoptionagreementid = aa.adoptionagreementid AND ap.adoptionplanningid = aa.adoptionplanningid 
 AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' 
 AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id 
 AND per.activeflag = 1 order by aar.updatedon asc limit 1;
 
 



SELECT ae.effortdate
 INTO vd_adp_applcble_dt
   FROM adoptionefforts ae, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE ap.adoptionplanningid = ae.adoptionplanningid AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid 
 AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id  AND per.activeflag = 1 order by ae.updatedon desc limit 1;

SELECT ae.effectivedate
 INTO vd_adp_asst_st_dt
   FROM adoptionefforts ae, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE ap.adoptionplanningid = ae.adoptionplanningid AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid 
 AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id  AND per.activeflag = 1 order by ae.updatedon desc limit 1;

SELECT (CASE WHEN (ae.activeflag = 1)
   THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END) , ae.effortdate , (CASE WHEN (ap.isnoeffort = 1) THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END) , 
   (CASE WHEN (ap.isexceptiongranted = 1) THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END) , ap.dateofexceptiongranted , ap.remarks
 INTO vs_efrts_to_place_chld , v_effort_date , v_isno_effort, v_is_exception_granted, v_date_of_exception_granted, v_remarks
   FROM adoptionefforts ae, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE ap.adoptionplanningid = ae.adoptionplanningid AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid 
 AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id  AND per.activeflag = 1 order by ae.updatedon desc limit 1;

SELECT abtl.finalizationdate
 INTO vd_fnlztn_dt
   FROM adoptionbreakthelink abtl, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE ap.adoptionplanningid = abtl.adoptionplanningid AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid 
 AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id  AND per.activeflag = 1 order by abtl.updatedon desc limit 1;

SELECT (CASE WHEN (ae.expirationdate IS NOT NULL)
   THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END)
 INTO vs_adptn_non_applcble
   FROM adoptionefforts ae, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE ap.adoptionplanningid = ae.adoptionplanningid AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid 
 AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id  AND per.activeflag = 1 order by ae.updatedon desc limit 1;

SELECT isrp.petitiondate
 INTO vd_adptn_pitn_dt
   FROM intakeservicerequestpetition isrp, intakeservicerequestactor isra, person per     
WHERE isrp.servicecaseid = isra.servicecaseid AND isrp.activeflag = 1 
   AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 order by isrp.updatedon desc limit 1;

-- Child Deprived Of Parental Support
-- If any one parent is deprived, then set as YES
vs_child_dprvd_prntl_sprt = 'NO'; -- set default as 'NO'
SELECT ( CASE WHEN (ipd.childdeprivedofparentalsupport = 'YES') THEN 'YES'::VARCHAR END ) 
 INTO vs_child_dprvd_prntl_sprt
   FROM ivepersondeprivation ipd    
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 AND ipd.childdeprivedofparentalsupport = 'YES' limit 1;

SELECT (CASE WHEN (aed.adoptionemotionalid = ae.adoptionemotionalid)
   THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END)
 INTO vs_chld_has_emtnl_distrbnce
   FROM adoptionemotionaldetails aed, adoptionemotional ae, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE aed.adoptionemotionalid = ae.adoptionemotionalid AND ae.adoptionplanningid = ap.adoptionplanningid AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid 
 AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 order by aed.updatedon desc limit 1;

select ( CAST
 (
 TRIM(COALESCE(pa.address::VARCHAR,''))||' '|| TRIM(COALESCE(pa.county,'')) ||' '||TRIM(COALESCE(pa.city,'')) ||' '||TRIM(COALESCE(pa.zipcode::VARCHAR,'')) ||' '||
 TRIM(COALESCE(pa.state,'')) ||' '||TRIM(COALESCE(pa.country::VARCHAR,''))
 AS CHARACTER VARYING )) 
  INTO vs_child_physical_add
from personaddress pa, person per
where pa.personid = per.personid AND pa.currentlocationflag = 1 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

SELECT aar.provider_id
 INTO vn_chld_expctd_adptv_prvdr
   FROM adoptionagreementrate aar, adoptionagreement aa, adoptionplanning ap, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE aar.adoptionagreementid = aa.adoptionagreementid AND ap.adoptionplanningid = aa.adoptionplanningid 
 AND ap.activeflag = 1 AND ap.servicecaseid = pl.servicecaseid AND pp.permanencyplanid = ap.permanencyplanid AND pp.activeflag = 1
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 order by aar.updatedon desc limit 1;



select aa.startdate, aa.issingleparent,isrq.intakeserviceid into v_aagrecord from intakeservreqchildremoval isrq inner join permanencyplan pp 
on pp.intakeservicerequestactorid = isrq.intakeservicerequestactorid --and pp.primarypermanencytype ='ADOPTNR' 
inner join adoptionplanning ap on ap.permanencyplanid = pp.permanencyplanid
inner join adoptionagreement aa on aa.adoptionplanningid = ap.adoptionplanningid
inner join intakeservicerequestactor isra on isra.servicecaseid = pp.servicecaseid AND isra.intakeservicerequestpersontypekey = 'CHILD'
inner join person per on per.personid = isra.personid
where per.cjamspid::BIGINT = al_client_id order by pp.updatedon desc limit 1;

select extract(year from age(now(),p.dob)) AS parentage,p.dob, p.cjamspid into v_parent_details from intakeservicerequestactor isrq1
inner join person p on p.personid = isrq1.personid
where isrq1.intakeservicerequestpersontypekey = 'LG' and isrq1.intakeserviceid =v_aagrecord.intakeserviceid;

-- TPR Details
select json_agg(to_json(r)) INTO v_tpr_details from 
(SELECT 
    td.tprdetailsid,
  case 
   when td.isgranted = true then 'YES'
   when td.isdenied = false then 'NO'
   else null
  end isgranted,
  td.tprdecisiondate,
  td.reason
FROM 
  intakeservicerequestactor isra, person p,  tprdetails td 
  where 
   isra.intakeservicerequestactorid = td.intakeservicerequestactorid
   and p.personid = isra.personid and td.activeflag = 1  and p.activeflag = 1 and isra.servicecaseid = (SELECT  isra.servicecaseid
   FROM placement pl, intakeservicerequestactor isra, person per, permanencyplan pp
WHERE isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 
 AND isra.intakeservicerequestpersontypekey = 'CHILD' 
 AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid 
 AND per.cjamspid::BIGINT = al_client_id  
 AND per.activeflag = 1 limit 1) ) r;

-- AFDC Details
SELECT 
 CASE
     WHEN (fca.deprivation = 'CRITERIA_PASSED' AND fca.assets = 'CRITERIA_PASSED' AND fca.income = 'CRITERIA_PASSED') THEN 
      'YES'
     ELSE 
      'NO'
   END,
   CASE
     WHEN (fca.assets = 'CRITERIA_PASSED' AND fca.income = 'CRITERIA_PASSED') THEN 
      'YES'
     ELSE 
      'NO'
   END,
 fca.wasthechildremovedfromspecifiedrelative
 INTO v_is_afdc_eligibility_met, v_is_income_assets_met, v_wasthechildremovedfromspecifiedrelative
FROM tb_ive_fostercare_audit fca WHERE fca.sqnm_sw = 'I' AND fca.approvalstatus = 'APPROVED' AND fca.cjamspid = al_client_id ORDER BY fca.insertedon DESC LIMIT 1;


if(v_parent_details.parentage<21) then
 select max(create_ts) into v_date_of_latest_payment_of_minor_parent  from tb_payment_detail pd 
 where client_id like '10000%' and pd.final_fiscal_category_cd like '21%';
end if;



