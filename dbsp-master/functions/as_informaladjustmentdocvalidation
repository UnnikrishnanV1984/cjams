CREATE OR REPLACE FUNCTION as_informaladjustmentdocvalidation(v_intakenumber character varying)
 RETURNS TABLE(adjustmentsupervision boolean, victimconsent boolean)
 LANGUAGE plpgsql
AS $function$

begin

Return query

select (case when 
(select count(*) from evaluationdocument where documenttemplatekey = 'ConsentInfSupervision'
and intakenumber = v_intakenumber) >= 1 then true else false end) as adjustmentsupervision,
(case when 
(select count(*) from evaluationdocument where documenttemplatekey = 'victimconsentis'
and intakenumber = v_intakenumber) >= 1 then true else false end) as victimconsent;


end;

$function$

