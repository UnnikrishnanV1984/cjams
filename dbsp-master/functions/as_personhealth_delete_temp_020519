CREATE OR REPLACE FUNCTION as_personhealth_delete_temp_020519(p_personphycisianinfoid uuid, p_person_id uuid, health json)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE  
     v_response VARCHAR;
  v_result VARCHAR ;
  v_person_id uuid;
        v_personphycisianinfoid uuid;  
  v_active_flag INTEGER DEFAULT 1;
  v_health JSON;
  v_providerinfojson JSON;
  v_providerinfo JSON;
  v_providerinfophysician JSON;
  v_providerinfodentist JSON; 
  v_physician_phone VARCHAR;
  v_physician_email VARCHAR;
  v_dentist_phone VARCHAR;
  v_dentist_email VARCHAR;
  
BEGIN
  v_person_id :=p_person_id;
        v_personphycisianinfoid:=p_personphycisianinfoid;
  v_health := health;
  v_providerinfojson := v_health ->> 'personProviderHistory';
  v_providerinfophysician:=json_array_elements((v_health -> 'personProviderHistory') :: JSON) -> 'provider_info' ;
  v_providerinfodentist :=json_array_elements((v_health -> 'personProviderHistory'):: JSON) -> 'Dental_info';
  v_response := 'SUCCESSFUL';
  
  
  v_physician_phone:=json_array_elements(v_providerinfophysician)  ->>'physician_phone';
  v_physician_email:=json_array_elements(v_providerinfophysician)  ->>'physician_email';
  
  v_dentist_phone:=json_array_elements(v_providerinfodentist)  ->>'dentist_phone';
  v_dentist_email:=json_array_elements(v_providerinfodentist)  ->>'dentist_email';
  
  --RAISE NOTICE 'output from space %',v_physician_phone;
  --RAISE NOTICE 'output from space %',v_hysician_email;
  
  
 IF (v_personphycisianinfoid IS NOT NULL) then
 
   DELETE FROM personphycisianinfo_temp t
   WHERE t.personphycisianinfoid= v_personphycisianinfoid AND  activeflag=v_active_flag; 
   RAISE NOTICE 'DATA HAS DELETED ON provider_info WITH USING : personphycisianinfoid %',v_personphycisianinfoid;
   
 ELSIF(v_providerinfophysician IS NOT NULL)then
   
   DELETE FROM personphycisianinfo_temp t
   WHERE t.personid = v_person_id 
   AND t.phone=v_physician_phone 
   AND t.email=v_physician_email   
   AND activeflag=v_active_flag;
 
   RAISE NOTICE 'DATA HAS DELETED WITHOUT USING personphycisianinfoid %  %  %' ,v_person_id,v_physician_phone,v_physician_email;
   
   IF(v_providerinfodentist IS NOT NULL)then
    
    DELETE FROM personphycisianinfo_temp t
    WHERE t.personid = v_person_id 
    AND t.phone=v_dentist_phone 
    AND t.email= v_dentist_email    
    AND activeflag=v_active_flag;
    RAISE NOTICE 'DATA HAS DELETED ON Dental_info WITHOUT USING personphycisianinfoid %  %  %' ,v_person_id,v_physician_phone,v_physician_email;
    END IF;
 ELSIF(v_providerinfodentist IS NOT NULL)then
   
   DELETE FROM personphycisianinfo_temp t
   WHERE t.personid = v_person_id 
   AND t.phone=v_dentist_phone 
   AND t.email= v_dentist_email    
   AND activeflag=v_active_flag;
   RAISE NOTICE 'DATA HAS DELETED ON Dental_info WITHOUT USING personphycisianinfoid %  %  %' ,v_person_id,v_physician_phone,v_physician_email;
 ELSE
  
   RAISE NOTICE ' DATA IS NOT AVAILABLE ';

   
 END IF; 
 
RETURN v_response;
END;
$function$

