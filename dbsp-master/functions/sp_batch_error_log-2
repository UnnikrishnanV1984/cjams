CREATE OR REPLACE FUNCTION sp_batch_error_log(as_sp_nm character varying, vl_batch_log_id bigint, vl_batch_sp_log_id bigint, vs_batch_no character varying, vl_err_line_no integer, vs_err_cd character varying, vl_err_sqlcode character varying, vs_err_desc_tx character varying, vs_create_user_id character varying, OUT vl_return_status integer)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
            
------------------------------------------------------------------------
-- SQL Stored Procedure
-- 06/18/2012 - Vineet Tirodkar (PRJ-02667 - MD CHESSIE Batch Process Redesign)
-- New SP with same Name & additional arguments.

-- Arguments:
-- 1) IN as_sp_nm (SP name from table TB_BATCH_SP_MASTER)
-- 2) IN vl_batch_log_id (Script run Id - BATCH_LOG_ID)
-- 3) IN vl_batch_sp_log_id (SP run Id - BATCH_SP_LOG_ID)
-- 4) IN vs_batch_no (Provision to update specific values in BATCH_NO varchar(5) column.)
-- 5) IN vl_err_line_no (Provision to update Error Line # in ERR_LINE_NO Integer column.)
-- 6) IN vs_err_cd (Provision to update Error code in ERR_CD varchar(5) column.)
-- 7) IN vl_err_sqlcode (SQL Error code)
-- 8) IN vs_err_desc_tx (SQL Error text)
-- 9) IN vs_create_user_id (User Id)
-- 10) OUT vl_return_status (Status 0 - success & 1 - failure)

DECLARE vl_output_sqlcode varchar DEFAULT '00000';--

BEGIN
     vl_return_status := 0;
   INSERT INTO TB_BATCH_ERROR_LOG (   ERROR_ID,
           BATCH_LOG_ID,
           BATCH_SP_LOG_ID,
           PROGRAM_NM ,
           BATCH_NO,
           ERR_LINE_NO,
           ERR_CD,
           ERR_SQLCODE,
           ERR_DESC_TX,
           CREATE_USER_ID,
           CREATE_TS 
          )
        VALUES (    NEXTVAL('sq_batch_error_log'),
           vl_batch_log_id,
           vl_batch_sp_log_id,
           as_sp_nm,
           vs_batch_no,
           vl_err_line_no,
           vs_err_cd,
           vl_err_sqlcode,
           vs_err_desc_tx,
           vs_create_user_id,
           CURRENT_TIMESTAMP
          );
EXCEPTION WHEN OTHERS THEN
     vl_output_sqlcode:=SQLSTATE;
  vl_return_status:=1;

  
END ;

$function$

