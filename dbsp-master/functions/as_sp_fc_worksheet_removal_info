CREATE OR REPLACE FUNCTION as_sp_fc_worksheet_removal_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, typeofremoval character varying, courtordered character varying, typeofvpa character varying, issafehavenbaby character varying, childphysicalremovaldate date, childphysicaladdressafterremoval character varying, clientidofpersonfromwhomchildwasphysicallyremoved integer, clientnameofpersonfromwhomchildwasphysicallyremoved character varying, relationshipidofpersonfromwhomchildwasphysicallyremoved integer, relationshipofpersonfromwhomchildwasphysicallyremoved character varying, dateof1stparentsignatureonvpa date, dateof2ndparentsignatureonvpa date, mandatorynoteonmissing2ndparentsignatureonvpa character varying, dateofyouthsignatureonvpa date, previousfostercareepisodeexist character varying, reasonforexit character varying, exitcaredatefrompreviousfostercareepisode date, dateofguardiansignatureonvpa date, clientidwhosignedvpa integer, parent2id integer, guardianid integer, clientnamewhosignedvpa character varying, dateofldsssignatureonvpa date, dateofreasonableeffortscourthearing timestamp without time zone, isreasonableeffortsfindingtimely character varying)
 LANGUAGE plpgsql
AS $function$\r
\r
DECLARE \r
  vs_Procedure_nm               VARCHAR(100) DEFAULT 'sp_fc_worksheet_removal_info';  \r
  vs_typeofremoval              VARCHAR(50);\r
  vs_crt_ord                VARCHAR(50);\r
  vs_typeofvpa               VARCHAR(50);\r
  vs_safehavenbaby              VARCHAR(50);\r
  vd_child_physical_rmvl_dt            DATE;\r
  vs_child_physical_add_after_rmvl          VARCHAR(500);\r
  vn_client_id_of_person_from_whom_child_physically_removed    INTEGER;\r
  vs_clientname_of_person_from_whom_child_physically_removed    VARCHAR(250);\r
  vn_relationship_id_of_person_from_whom_child_physically_removed   INTEGER;\r
  vs_relationship_of_person_from_whom_child_physically_removed   VARCHAR(100);\r
  vd_first_prnt_sign_dt             DATE;\r
  vd_second_prnt_sign_dt             DATE;\r
  vs_missing_scnd_prnt_note            VARCHAR(50);\r
  vd_youth_sign_dt              DATE;\r
  vs_prvs_fc_epsde_exist             VARCHAR(50);\r
  vs_rsn_for_exit               VARCHAR(100);\r
  vd_prvs_fc_exit_dt              DATE;\r
  vd_grdn_sign_dt               DATE;\r
  vn_vpa_sign_client_id             INTEGER;\r
  vd_second_prnt_id               INTEGER;\r
  vd_grdn_sign_id               INTEGER;\r
  vs_vpa_sign_client              VARCHAR(250);\r
  vd_ldss_sign_dt               DATE;\r
  vd_rsnbl_efrts_crt_hrng_dt            TIMESTAMP;\r
  vs_rsnbl_effrts_fndng_tmly            VARCHAR(50);\r
 \r
 BEGIN \r
CREATE TEMP TABLE IF NOT EXISTS\r
Temp_worksheet_removal_info ( \r
  client_id              BIGINT,  \r
  typeofremoval            VARCHAR(50),\r
  courtordered            VARCHAR(50),\r
  typeofvpa             VARCHAR(50),\r
  issafehavenbaby            VARCHAR(50),\r
  childphysicalremovaldate         DATE,\r
  childphysicaladdressafterremoval       VARCHAR(500),\r
  clientidofpersonfromwhomchildwasphysicallyremoved   INTEGER,\r
  clientnameofpersonfromwhomchildwasphysicallyremoved   VARCHAR(250),\r
  relationshipidofpersonfromwhomchildwasphysicallyremoved  INTEGER,\r
  relationshipofpersonfromwhomchildwasphysicallyremoved  VARCHAR(100),\r
  dateof1stparentsignatureonvpa        DATE,\r
  dateof2ndparentsignatureonvpa        DATE,\r
  mandatorynoteonmissing2ndparentsignatureonvpa    VARCHAR(50),\r
  dateofyouthsignatureonvpa         DATE,\r
  previousfostercareepisodeexist        VARCHAR(50),\r
  reasonforexit            VARCHAR(100),\r
  exitcaredatefrompreviousfostercareepisode     DATE,\r
  dateofguardiansignatureonvpa        DATE,\r
  clientidwhosignedvpa          INTEGER,\r
  parent2id             INTEGER,\r
  guardianid             INTEGER,\r
  clientnamewhosignedvpa          VARCHAR(250),\r
  dateofldsssignatureonvpa         DATE,\r
  dateofreasonableeffortscourthearing       TIMESTAMP,\r
  isreasonableeffortsfindingtimely       VARCHAR(50)\r
 );\r
\r
-- Type of Removal\r
SELECT ( CASE WHEN (rtrim(isrcr.removaltypekey) = 'TLV' \r
    OR rtrim(isrcr.removaltypekey) = 'CDVP' \r
    OR rtrim(isrcr.removaltypekey) = 'EHA' ) \r
    THEN 'Voluntary_Placement_Agreement'::VARCHAR \r
     WHEN (isrcr.removaltypekey = 'JD') \r
    THEN 'Court_Order'::VARCHAR ELSE 'None'::VARCHAR END )  \r
 INTO vs_typeofremoval\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
  \r
-- Court Order\r
SELECT ( CASE WHEN (rtrim(isrcr.removaltypekey) = 'JD')\r
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ) \r
 INTO vs_crt_ord\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
   \r
-- Type of VPA\r
SELECT ( CASE rv.value_text WHEN 'Time-limited Voluntary Placement'\r
     THEN 'Time-Limited'::VARCHAR WHEN 'Children With Disabilities Voluntary Placement' THEN 'Child with Disabilities'::VARCHAR\r
     WHEN 'Enhanced aftercare' THEN 'EA-VPA'::VARCHAR END )\r
 INTO vs_typeofvpa\r
   FROM referencevalues rv, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per\r
WHERE referencetypeid = 53 AND rv.activeflag = 1\r
    AND TRIM(rv.ref_key) = TRIM(isrcr.removaltypekey)\r
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
   \r
-- Safehaven Baby   \r
SELECT ( CASE WHEN (rtrim(isrcr.removaltypekey) = 'SHB')\r
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END )  \r
 INTO vs_safehavenbaby\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
 \r
-- Child Physical Removal Date\r
SELECT isrcr.removaldate\r
 INTO vd_child_physical_rmvl_dt\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
\r
-- Child Physical Address After Removal  \r
SELECT ( CAST\r
 (\r
 TRIM(COALESCE(tpa.adr_street_tx::VARCHAR,''))||' '|| TRIM(COALESCE(tpa.adr_street_nm,'')) ||' '||TRIM(COALESCE(tpa.adr_city_nm,'')) ||' '||\r
 TRIM(COALESCE(tpa.adr_state_cd,'')) ||' '||TRIM(COALESCE(tpa.adr_zip5_no::VARCHAR,'')) \r
 AS CHARACTER VARYING ))\r
  INTO vs_child_physical_add_after_rmvl\r
 FROM tb_provider_addresses tpa, tb_provider tp, placement pl, intakeservicerequestactor isra, person per\r
WHERE tpa.delete_sw = 'N' AND tpa.adr_default_sw = 'Y'\r
 AND tp.delete_sw = 'N' AND tp.provider_id = tpa.parent_key_id::int4\r
 AND pl.altproviderid = tp.provider_id AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 limit 1;\r
\r
-- Client ID of Person From Whom Child Physically Removed\r
SELECT DISTINCT crgvr.cjamspid\r
 INTO vn_client_id_of_person_from_whom_child_physically_removed\r
 FROM person crgvr, intakeservicerequestactor crgvrisra, placement pl, intakeservicerequestactor isra, person per\r
WHERE crgvrisra.personid = crgvr.personid AND crgvrisra.intakeservicerequestpersontypekey = 'LG' \r
 AND crgvrisra.servicecaseid = pl.servicecaseid AND crgvrisra.activeflag = 1 AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
\r
-- Client Name of Person From Whom Child Physically Removed\r
SELECT (COALESCE(crgvr.firstname)||' '|| COALESCE(crgvr.lastname))::VARCHAR\r
 INTO vs_clientname_of_person_from_whom_child_physically_removed\r
 FROM person crgvr, intakeservicerequestactor crgvrisra, placement pl, intakeservicerequestactor isra, person per\r
WHERE crgvrisra.personid = crgvr.personid AND crgvrisra.intakeservicerequestpersontypekey = 'LG' \r
 AND crgvrisra.servicecaseid = pl.servicecaseid AND crgvrisra.activeflag = 1 AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
\r
-- Relationship ID of Person From Whom Child Physically Removed \r
SELECT DISTINCT rt.fourerelid\r
 INTO vn_relationship_id_of_person_from_whom_child_physically_removed\r
   FROM relationshiptype rt, actorrelationship ar, person crgvr, intakeservicerequestactor crgvrisra, placement pl, intakeservicerequestactor isra, person per\r
WHERE crgvrisra.intakeservicerequestactorid = ar.intakeservicerequestactorid AND crgvrisra.intakeservicerequestpersontypekey = 'LG' \r
 AND TRIM(rt.relationshiptypekey) = TRIM(ar.relationshiptypekey) AND rt.activeflag = 1\r
 AND crgvrisra.servicecaseid = pl.servicecaseid AND crgvrisra.activeflag = 1 AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
\r
-- Relationship of Person From Whom Child Physically Removed \r
SELECT rt.description\r
 INTO vs_relationship_of_person_from_whom_child_physically_removed\r
   FROM relationshiptype rt, actorrelationship ar, person crgvr, intakeservicerequestactor crgvrisra, placement pl, intakeservicerequestactor isra, person per\r
WHERE crgvrisra.intakeservicerequestactorid = ar.intakeservicerequestactorid AND crgvrisra.intakeservicerequestpersontypekey = 'LG' \r
 AND TRIM(rt.relationshiptypekey) = TRIM(ar.relationshiptypekey) AND rt.activeflag = 1\r
 AND crgvrisra.servicecaseid = pl.servicecaseid AND crgvrisra.activeflag = 1 AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
  \r
-- VPA 1st Parent Signed ID and Date  \r
SELECT isrcr.vpaparentssigneddate, isrcr.parent1id\r
 INTO vd_first_prnt_sign_dt, vn_vpa_sign_client_id\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
\r
-- VPA 2nd Parent Signed ID and Date  \r
SELECT isrcr.parent2signeddate, isrcr.parent2id\r
 INTO vd_second_prnt_sign_dt, vd_second_prnt_id\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
  \r
-- Mandatory Note On Missing 2nd Parent Signature On VPA   \r
SELECT isrcr.parent2comments  \r
 INTO vs_missing_scnd_prnt_note\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
  \r
-- VPA Youth Signed Date  \r
SELECT isrcr.vpayouthsigneddate\r
 INTO vd_youth_sign_dt\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
 \r
-- Previous Foster Care Eepisode Exist,   \r
SELECT ( CASE WHEN (isrcr.returndate IS NOT NULL)\r
     THEN 'YES'::VARCHAR  END )  \r
 INTO vs_prvs_fc_epsde_exist\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1; \r
\r
-- Reason For Exit\r
SELECT DISTINCT ( CASE rv.value_text WHEN 'Reunification' THEN \r
        'Reunification'::VARCHAR \r
       WHEN 'Adoption Finalization (when selected the Removal and Program Assignment will automatically end date)' THEN \r
        'Adoption'::VARCHAR\r
       WHEN 'Adoption Disruption' THEN \r
        'Adoption'::VARCHAR\r
       WHEN 'Adoption Disruption' THEN \r
        'Adoption'::VARCHAR\r
       WHEN 'Permanency Step: Adoptive or pre-adoptive Placement' THEN \r
        'Adoption'::VARCHAR\r
        WHEN 'Guardianship Non-Relative' THEN \r
         'Guardianship'::VARCHAR\r
        WHEN 'Custody/Guardianship – Relative' THEN \r
         'Guardianship'::VARCHAR\r
        WHEN 'Custody/Guardianship – Non-Relative' THEN \r
         'Guardianship'::VARCHAR       \r
        WHEN 'Marriage' THEN \r
        'Marriage'::VARCHAR \r
       WHEN 'Military' THEN \r
        'Military'::VARCHAR ELSE 'Other'::VARCHAR END )  \r
 INTO vs_rsn_for_exit\r
   FROM referencevalues rv, intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per\r
WHERE referencetypeid = 87 AND rv.activeflag = 1\r
   AND TRIM(rv.ref_key) = TRIM(isrcr.removalreasontypekey)\r
 AND pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
   \r
-- Previous FC Episode Exit Care Date  \r
SELECT isrcr.returndate\r
 INTO vd_prvs_fc_exit_dt\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
  \r
-- VPA Guardian Signed Date & VPA Signed Client ID\r
SELECT isrcr.vpaguardiansigneddate, isrcr.guardianid\r
 INTO vd_grdn_sign_dt, vd_grdn_sign_id\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;\r
  \r
--  VPA Signed Client\r
SELECT DISTINCT ( CASE WHEN ( rtrim(isrcr.removaltypekey) = 'TLV' \r
    OR rtrim(isrcr.removaltypekey) = 'CDVP' \r
    OR rtrim(isrcr.removaltypekey) = 'EHA' ) \r
    THEN ( SELECT (COALESCE(crgvr.firstname)||' '|| COALESCE(crgvr.lastname))::VARCHAR ) \r
      ELSE NULL END )\r
 INTO vs_vpa_sign_client\r
 FROM intakeservreqchildremoval isrcr, person crgvr, intakeservicerequestactor crgvrisra, placement pl, intakeservicerequestactor isra, person per\r
WHERE crgvrisra.personid = crgvr.personid AND crgvrisra.intakeservicerequestpersontypekey = 'AM' \r
 AND crgvrisra.servicecaseid = pl.servicecaseid AND crgvrisra.activeflag = 1 AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 limit 1;\r
\r
-- VPA LDSS Signed Date  \r
SELECT isrcr.agencysigneddate\r
 INTO vd_ldss_sign_dt\r
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per \r
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'\r
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid \r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;  \r
  \r
-- Reasonable efforts Court Hearing Date\r
SELECT MIN(isrch.hearingdatetime)\r
   INTO vd_rsnbl_efrts_crt_hrng_dt\r
   FROM intakeservicerequestcourtaction isrca, intakeservicerequestcourthearing isrch, intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra \r
WHERE isrca.intakeservicerequestcourthearingid = isrch.intakeservicerequestcourthearingid AND isrch.activeflag = 1\r
 AND isrca.reasonableeffortsflag = 1 AND isrca.intakeservicerequestid = isrcr.intakeserviceid AND isrca.activeflag = 1\r
 AND isra.intakeserviceid = isrcr.intakeserviceid AND isrcr.activeflag = 1\r
 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.activeflag = 1\r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;   \r
  \r
-- Reasonable Efforts Finding Timely \r
SELECT ( CASE WHEN ( (vs_typeofremoval = 'Court_Order' AND extract(day from age(vd_rsnbl_efrts_crt_hrng_dt, isrcr.removaldate)) <= 60) \r
    OR (vs_typeofremoval = 'Voluntary_Placement_Agreement' AND extract(day from age(vd_rsnbl_efrts_crt_hrng_dt, isrcr.removaldate)) <= 180) )\r
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END  ) \r
 INTO vs_rsnbl_effrts_fndng_tmly\r
   FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra \r
WHERE isra.intakeserviceid = isrcr.intakeserviceid AND isrcr.activeflag = 1\r
 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.activeflag = 1\r
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1; \r
 \r
INSERT INTO Temp_worksheet_removal_info\r
SELECT \r
  al_client_id,\r
  vs_typeofremoval,\r
  vs_crt_ord,\r
  vs_typeofvpa,\r
  vs_safehavenbaby,\r
  vd_child_physical_rmvl_dt,\r
  vs_child_physical_add_after_rmvl,\r
  vn_client_id_of_person_from_whom_child_physically_removed,\r
  vs_clientname_of_person_from_whom_child_physically_removed,\r
  vn_relationship_id_of_person_from_whom_child_physically_removed,\r
  vs_relationship_of_person_from_whom_child_physically_removed,\r
  vd_first_prnt_sign_dt,\r
  vd_second_prnt_sign_dt,\r
  vs_missing_scnd_prnt_note,\r
  vd_youth_sign_dt,\r
  vs_prvs_fc_epsde_exist,\r
  vs_rsn_for_exit,\r
  vd_prvs_fc_exit_dt,\r
  vd_grdn_sign_dt,\r
  vn_vpa_sign_client_id,\r
  vd_second_prnt_id,\r
  vd_grdn_sign_id,\r
  vs_vpa_sign_client,\r
  vd_ldss_sign_dt,\r
  vd_rsnbl_efrts_crt_hrng_dt,\r
