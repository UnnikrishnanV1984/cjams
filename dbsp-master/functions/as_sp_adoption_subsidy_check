      SELECT count(*)
      INTO vl_adop_count
      FROM tb_ADOPTION  TA, 
          tb_ADOPTION_SUBSIDY_AGREEMENT TAS
      WHERE TA.ADOPTION_ID = TAS.ADOPTION_ID 
           AND TA.DELETE_SW = 'N' 
           AND TAS.DELETE_SW = 'N' 
           AND TA.PROVIDER_ID IS NOT NULL 
           AND TAS.APPROVAL_STATUS_CD = '3047' 
           AND TA.SUBSIDY_START_DT >= ad_placement_dt 
           AND ( (TA.SUBSIDY_END_DT IS NULL) OR  (TA.SUBSIDY_END_DT > vd_previous_month_start_dt)) 
           AND ((TAS.RATE_OVERWRITTEN_SW IS NULL) OR (TAS.RATE_OVERWRITTEN_SW = 'Y')) 
            AND TA.CLIENT_ID = al_client_id ;--
      


      IF vl_adop_count > 0 THEN
         as_adpsub_exist := 'Y';--
      ELSE
         as_adpsub_exist := 'N';--
      END IF;--

END;

