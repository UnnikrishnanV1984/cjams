CREATE OR REPLACE FUNCTION getpersonwork(v_personid uuid)
 RETURNS TABLE(personid uuid, personworkcarrergoalid uuid, personemployerdetailid uuid, personemploymentid uuid, careergoals character varying, employername character varying, currentemployer boolean, noofhours character varying, duties character varying, startdate timestamp without time zone, enddate timestamp without time zone, reasonforleaving character varying, supervisorprefixtypekey character varying, supervisorfirstname character varying, supervisormiddlename character varying, supervisorlastname character varying, supervisorsuffixtypekey character varying, clienttitle character varying, workschedule character varying, emplymenttypekey character varying, income integer, wagefreqtypekey character varying, addresstypekey character varying, workphone json, email json, address1 character varying, address2 character varying, cityname character varying, countytypekey character varying, countyname character varying, statetypekey character varying, zip5no integer)
 LANGUAGE plpgsql
AS $function$

declare 
details json;
begin
 return QUERY select 
 pe.personid,
 ped.personworkcarrergoalid,
 ped.personemployerdetailid,
 pe.personemploymentid,
 pcg.careergoals,
 ped.employername,
 ped.currentemployer,
 ped.noofhours,
 ped.duties,
 ped.startdate,
 ped.enddate,
 ped.reasonforleaving,
 pe.supervisorprefixtypekey,
 pe.supervisorfirstname,
 pe.supervisormiddlename,
 pe.supervisorlastname,
 pe.supervisorsuffixtypekey,
 pe.clienttitle,
 pe.workschedule,
 pe.emplymenttypekey,
 pe.income,
 pe.wagefreqtypekey,
 pe.addresstypekey,
 pe.workphone :: json,
 pe.email :: json,
 pe.address1,
 pe.address2,
 pe.cityname,
 pe.countytypekey,
 c.countyname as county,
 pe.statetypekey,
 pe.zip5no
  from personemployment pe  
  inner  join personemployerdetail ped on pe.personemployerdetailsid = ped.personemployerdetailid and ped.activeflag = 1
  and ped.personid=v_personid 
  left  join personworkcarrergoal pcg on pcg.personworkcarrergoalid = ped.personworkcarrergoalid 
  and pcg.personid=v_personid   
  left join county c on pe.countytypekey = c.countyid::character varying
  where pe.personid = v_personid and pe.activeflag = 1 and pe.promotedemploymentflag = 0;
  -- 1) pcg.activeflag = 1;'personworkcarrergoal/pcb' does not exist CHESIE ; hence commented out (2) 'promotedemploymentflag=1' connected to 18-21 yrs/ 4e functionality
end;

$function$

