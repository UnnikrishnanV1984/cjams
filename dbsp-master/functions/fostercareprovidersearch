CREATE OR REPLACE FUNCTION fostercareprovidersearch(searchobj json, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, provider_id integer, providername character varying, programname character varying, preferred character varying, vacancy integer, placementstructure character varying, provider_category_cd character varying, provider_category_name character varying, comar_sw character, contract_program_id integer, placement_service_id integer, providerdetails json, childcharacteristicsdetails json, ssnno character varying, dob_dt date, affiliate_provider_id integer, countyname character varying, service_status text)
 LANGUAGE plpgsql
AS $function$\r
------------------------------------------------------------------------------------------------\r
-- Revisions:\r
-- Vineet Tirodkar - 05/04/2021 - Modifications for New Provider Category 3794 - Residential Treatment Center (B-102022)\r
------------------------------------------------------------------------------------------------\r
DECLARE \r
        \r
 v_picklist_value_cd_childcharacteristics character varying;   \r
 v_service_id_placementstructures character varying;    \r
 v_service_id_bundledplacementservices character varying;     \r
 v_prov_tax_type_cd_taxid VARCHAR(30);\r
 v_adr_zip5_no_zipcode numeric; \r
 v_localdepartmenthomecaregiver boolean; \r
 v_provider_id INTEGER;   \r
 v_lvService VARCHAR(50);                        \r
 v_lvServiceSubType VARCHAR(50);                         \r
 v_lvPaymentType VARCHAR(50);     \r
 v_lvChildCharacter json;                                                     \r
 v_liZipCode INT;       \r
 v_liCounty uuid;\r
 v_lvProvider VARCHAR(50);\r
 v_liCount INT;                              \r
 v_lvSortCol VARCHAR(50);                              \r
 v_lvSortDir VARCHAR(10); \r
 v_pagenumber int;\r
 v_pageoffset int;\r
 v_fodertype VARCHAR(50);\r
 v_isoperatedbydjs bool;\r
 v_organization_name VARCHAR(100);\r
 v_fname VARCHAR(50);\r
 v_mname VARCHAR(50);\r
 v_lname VARCHAR(50);\r
 v_pname VARCHAR(100);\r
 v_gender VARCHAR(50);\r
 v_age int;\r
 v_agecheck bool;\r
 v_agemin int;\r
 v_agemax int;\r
 v_otherLocalDeptmntTypeId VARCHAR(10);\r
 v_tax_id_no numeric;\r
  v_fromproviderplacement  VARCHAR(50) ; \r
  \r
 \r
BEGIN \r
v_picklist_value_cd_childcharacteristics := searchobj ->> 'childcharacteristics';\r
v_service_id_placementstructures := searchobj ->> 'placementstructures'; \r
v_service_id_bundledplacementservices := searchobj ->> 'bundledplacementservices'; \r
v_prov_tax_type_cd_taxid := searchobj ->> 'taxid';\r
v_adr_zip5_no_zipcode := searchobj ->> 'zipcode';\r
v_localdepartmenthomecaregiver := searchobj ->> 'localdepartmenthomecaregiver';\r
v_provider_id := searchobj ->> 'providerid';\r
v_organization_name := searchobj ->> 'organizationName';\r
v_fname := searchobj ->> 'firstname';\r
v_mname := searchobj ->> 'middlename';\r
v_lname := searchobj ->> 'lastname';\r
v_gender := searchobj ->> 'gender';\r
v_pname := searchobj ->> 'providername';\r
v_age := searchobj ->> 'age';\r
v_agecheck := searchobj ->> 'isAge';\r
v_agemin := searchobj ->> 'agemin';\r
v_agemax := searchobj ->> 'agemax';\r
v_otherLocalDeptmntTypeId := searchobj ->> 'otherLocalDeptmntTypeId';\r
v_tax_id_no := searchobj ->> 'taxId';\r
v_fromproviderplacement := searchobj ->> 'fromproviderplacement';\r
\r
IF v_localdepartmenthomecaregiver is null THEN\r
    v_localdepartmenthomecaregiver = false;\r
END IF;\r
\r
IF v_fromproviderplacement = 'true' THEN\r
    v_fromproviderplacement = 'true';\r
    else\r
     v_fromproviderplacement = null;\r
END IF;\r
\r
\r
\r
\r
\r
v_pagenumber := v_liPageNumber - 1;\r
v_pageoffset := v_pagenumber * v_liPageSize;\r
\r
IF v_localdepartmenthomecaregiver = true THEN\r
  return query\r
    SELECT COUNT(1) OVER() totalcount, \r
 TBP.provider_id ,\r
 (CASE WHEN (TBP.provider_nm = null OR TBP.provider_nm='') \r
 THEN CONCAT(TBP.provider_first_nm,' ',TBP.provider_last_nm)::character varying ELSE TBP.provider_nm END),\r
 (SELECT ''::character varying ) as program_nm, (SELECT ''::character varying ) as preferred, \r
 TBP.vacancy_no,  \r
 TBS.service_nm,\r
    TBP.provider_category_cd,\r
 'Local Department Home'::character varying,    \r
    'Y'::character as comar_sw, (SELECT null::integer ) as contract_program_id, TBS.service_id,\r
 (SELECT json_agg(x) from (\r
 select a.provider_id , a.prov_tax_type_cd, a.tax_id_no, a.affiliate_provider_id as provider_organization_id,(CASE WHEN (a.provider_nm = null OR a.provider_nm='') \r
 THEN CONCAT(a.provider_first_nm,' ',a.provider_last_nm)::character varying ELSE a.provider_nm END) as provider_organization_name,\r
 a.adr_work_phone_tx as phonenumber,\r
 (select concat_ws(' ',tpa.adr_street_tx,(select coalesce(tpv.value_tx,'') from tb_picklist_values tpv where trim(tpv.picklist_value_cd) in (trim(tpa.adr_pre_dir_cd)) and tpv.picklist_type_id='69'),(case when tpa.adr_format_cd = 'P' then 'PO Box ' else '' end ),tpa.adr_box_no,tpa.adr_unit_no_tx,tpa.adr_street_nm,tpa.adr_street_suffix_cd,\r
  (select coalesce(value_tx,'') from tb_picklist_values where trim(picklist_value_cd) in (trim(tpa.adr_post_dir_cd)) and picklist_type_id='69'),tpa.adr_city_nm,(select cnty.countyname from county cnty where cnty.statecountycode = tpa.adr_county_cd and cnty.activeflag = 1),tpa.adr_state_cd,tpa.adr_zip5_no)\r
        from tb_provider_addresses tpa where   tpa.parent_key_id = TBP.provider_id::character varying and adr_default_sw = 'Y' ORDER BY tpa.update_ts DESC Limit 1)::character varying as address,\r
 TBS.service_id , TBS.service_nm as placementstructure , 0::integer as bundled_service_id, '' as bundledplacementstructure, TBPS.provider_service_id,\r
 (select json_agg(x) from (select concat(up.firstname,' ',up.lastname) as license_cordinator from userprofile up where up.securityusersid=a.create_user_id and up.activeflag=1) as x) as license_cordinators\r
 from tb_provider as a \r
 where a.provider_id = TBP.provider_id and a.delete_sw = 'N') as x) as providerdetails,\r
 (select json_agg(x) from ( select TBP.provider_id, TBPLV.picklist_value_cd as childcharacteristics_picklist_value_cd, \r
 TBPLV.description_tx as childcharacteristics_description from tb_provider_picklist as TBPPL  \r
 JOIN tb_picklist_values as TBPLV ON TBPLV.picklist_value_cd = TBPPL.picklist_value_cd and TBPLV.delete_sw = 'N' and TBPLV.picklist_type_id = 43 \r
 Where TBPPL.provider_id = TBP.provider_id and TBPPL.delete_sw = 'N' AND \r
 (CASE WHEN v_picklist_value_cd_childcharacteristics IS NOT NULL THEN TBPLV.picklist_value_cd = v_picklist_value_cd_childcharacteristics ELSE TRUE END)) as x) as childcharacteristicsdetails, TBP.tax_id_no :: character varying, TBP.dob_dt\r
 ,TBP.affiliate_provider_id\r
  ,(select c.countyname from county c where trim(c.statecountycode)=trim(TBP.county_cd) limit 1) as countyname,\r
  --TBPS.service_status\r
  CASE WHEN (TBPS.end_dt IS NULL OR TBPS.end_dt>=now()::date) THEN 'Active' ELSE 'Inactive' END AS service_status\r
 \r
 FROM tb_provider as TBP\r
 INNER JOIN tb_provider_approval as TBAA ON  TBAA.provider_id = TBP.provider_id and  TBAA.delete_sw = 'N' ---and (TBAA.approved_beds_no is not null  )-- Placement structures  \r
 and TBAA.approval_status_cd='3579' AND TBAA.approval_dt<= current_date and (TBAA.effective_end_dt >= current_date or TBAA.effective_end_dt is null) and TBAA.active_sw='Y'\r
 INNER JOIN tb_provider_services as TBPS ON TBPS.provider_id = TBP.provider_id and TBPS.delete_sw = 'N' and (TBPS.end_dt is null or TBPS.end_dt >= current_date)\r
 INNER JOIN tb_services as TBS ON  TBS.service_id =  TBPS.service_id and TBS.structure_service_cd='P' and TBS.delete_sw = 'N' -- Placement structures  \r
 \r
 WHERE TBP.provider_status_cd = '1791'  -- Provider Status Active\r
 AND TBP.delete_sw = 'N' \r
    AND TBP.provider_id in (\r
  SELECT tpcl1.provider_id FROM TB_PROVIDER_PICKLIST tpcl1 WHERE tpcl1.PICKLIST_TYPE_ID=155 \r
  AND tpcl1.PICKLIST_VALUE_CD IN ('1783') \r
  AND tpcl1.PROVIDER_ID = TBP.PROVIDER_ID AND tpcl1.DELETE_SW = 'N') \r
\r
 AND (CASE WHEN v_fname IS NOT NULL THEN lower(TBP.provider_first_nm) % lower(v_fname) ELSE TRUE END)\r
 AND (CASE WHEN v_mname IS NOT NULL THEN lower(TBP.provider_middle_nm) % lower(v_mname) ELSE TRUE END)\r
 AND (CASE WHEN v_lname IS NOT NULL THEN lower(TBP.provider_last_nm) % lower(v_lname) ELSE TRUE END)\r
 AND (CASE WHEN v_pname IS NOT NULL THEN \r
   CASE WHEN (TBP.provider_nm = null OR TBP.provider_nm='')\r
   THEN lower(CONCAT(TBP.provider_first_nm,' ',TBP.provider_last_nm)::character varying) % lower(v_pname)\r
   ELSE\r
   lower(TBP.provider_nm) % lower(v_pname) \r
   END \r
   ELSE TRUE END)\r
 AND \r
  (v_adr_zip5_no_zipcode is null OR \r
    EXISTS(\r
         SELECT TBPA.adr_zip5_no FROM \r
               tb_provider_addresses AS TBPA \r
            WHERE TBPA.adr_zip5_no = v_adr_zip5_no_zipcode::numeric\r
            AND TBPA.parent_key_id::integer=TBP.provider_id\r
    ) \r
    )\r
 AND (CASE WHEN v_provider_id IS NOT NULL THEN TBP.provider_id = v_provider_id ELSE TRUE END)\r
 AND (CASE WHEN v_tax_id_no IS NOT NULL THEN TBP.tax_id_no = v_tax_id_no ELSE TRUE END)\r
 AND (CASE WHEN v_organization_name IS NOT NULL THEN TBP.provider_nm ilike '%' || v_organization_name || '%' ELSE TRUE END)\r
 AND \r
  (v_otherLocalDeptmntTypeId is null OR \r
  TBP.county_cd in (select * from unnest(string_to_array(v_otherLocalDeptmntTypeId, ',')))\r
  )\r
 AND (CASE WHEN v_fromproviderplacement IS NOT NULL THEN TBS.service_id not in (71,501,503) ELSE TRUE END)\r
 AND ( v_picklist_value_cd_childcharacteristics IS null\r
   or EXISTS \r
   (SELECT tpcl2.provider_id FROM TB_PROVIDER_PICKLIST tpcl2 WHERE tpcl2.PICKLIST_TYPE_ID in(43) \r
   AND tpcl2.PROVIDER_ID = TBP.provider_id AND tpcl2.DELETE_SW = 'N'\r
   and tpcl2.picklist_value_cd ::text in (select * from unnest(string_to_array(v_picklist_value_cd_childcharacteristics, ','))) )\r
  )\r
 AND \r
  (v_service_id_placementstructures is null OR \r
  TBPS.service_id::text in (select * from unnest(string_to_array(v_service_id_placementstructures, ',')))\r
  )\r
 AND \r
  (v_service_id_bundledplacementservices is null OR \r
    EXISTS(\r
         SELECT TBS1.service_id  FROM \r
                tb_services as TBS1 WHERE  TBS1.service_id =  TBPS.service_id \r
                and TBS1.paid_non_paid_cd in ('3334','3335') and TBS1.delete_sw = 'N' \r
             and TBS1.service_id::text in (select * from unnest(string_to_array(v_service_id_bundledplacementservices, ',')))\r
    )\r
  \r
  )\r
and (\r
 v_agecheck is null\r
 OR (\r
  (\r
   v_agemin is null\r
   OR EXISTS(\r
    select\r
     TPA.gender_cd\r
    from\r
     tb_prov_accomodation as TPA\r
    where\r
     TBAA.provider_approval_id = TPA.provider_approval_id\r
     and TPA.delete_sw = 'N'\r
     and TPA.minimum_age_no <= v_agemin\r
   )\r
  )\r
  AND (\r
   v_agemax is null\r
   OR EXISTS(\r
    select\r
     TPA.gender_cd\r
    from\r
     tb_prov_accomodation as TPA\r
    where\r
     TBAA.provider_approval_id = TPA.provider_approval_id\r
     and TPA.delete_sw = 'N'\r
     and TPA.maximum_age_no >= v_agemax\r
   )\r
  )\r
 )\r
)\r
 order by vacancy_no  desc  nulls last\r
 LIMIT v_liPageSize OFFSET v_pageoffset;           \r
\r
ELSE \r
  RETURN query\r
    SELECT COUNT(1) OVER() totalcount,* from ( \r
  (SELECT  TBP.provider_id ,\r
  (CASE WHEN (TBP.provider_nm = null OR TBP.provider_nm='') \r
  THEN CONCAT(TBP.provider_first_nm,' ',TBP.provider_last_nm)::character varying ELSE TBP.provider_nm END),\r
  (TBCP.program_nm || ' (' || to_char(TBCP.start_dt, 'Mon,YYYY')  || ' to ' || to_char(TBCP.end_dt, 'Mon,YYYY') || ' #' || to_char(TBCP.program_id) || ')' )::character varying as program_nm, \r
  (CASE WHEN TBCP.preferred_cd = '3482' THEN 'Preferred' WHEN TBCP.preferred_cd = '3483' THEN 'Non-Preferred' ELSE ''::character varying END ),TBCP.vacancy_no,\r
  TBS.service_nm,\r
        TBP.provider_category_cd,\r
  (\r
     SELECT  \r
   CASE WHEN piclist.PICKLIST_VALUE_CD = '1783' THEN 'Local Department Home' \r
    WHEN piclist.PICKLIST_VALUE_CD = '1782' THEN 'CPA Home'\r
    WHEN piclist.PICKLIST_VALUE_CD = '1785' THEN 'ICPC Home Study'\r
    WHEN piclist.PICKLIST_VALUE_CD = '3049' THEN 'Private Organization'\r
    WHEN piclist.PICKLIST_VALUE_CD = '3274' THEN 'RCC Facility' \r
    WHEN piclist.PICKLIST_VALUE_CD = '3794' THEN 'Residential Treatment Center' \r
    WHEN piclist.PICKLIST_VALUE_CD = '3302' THEN 'CPA Office' \r
    ELSE ''::character varying \r
   END \r
   FROM TB_PROVIDER_PICKLIST piclist WHERE piclist.PICKLIST_TYPE_ID=155 \r
    AND piclist.PICKLIST_VALUE_CD IN ('3274','3302','3794' ) \r
    AND piclist.PROVIDER_ID = TBP.PROVIDER_ID AND piclist.DELETE_SW = 'N'\r
       order by piclist.update_ts desc limit 1\r
  ), \r
  'Y'::character as comar_sw ,TBCP.program_id as contract_program_id ,TBS.service_id,\r
  (select json_agg(x) from (\r
  select a.provider_id , a.prov_tax_type_cd, a.tax_id_no, a.affiliate_provider_id as provider_organization_id,(CASE WHEN (a.provider_nm = null OR a.provider_nm='') \r
  THEN CONCAT(a.provider_first_nm,' ',a.provider_last_nm)::character varying ELSE a.provider_nm END) as provider_organization_name, TBCP.program_id as contract_program_id, \r
  -- TBCP.program_nm as programname,\r
  (TBCP.program_nm || ' (' || to_char(TBCP.start_dt, 'Mon,YYYY')  || ' to ' || to_char(TBCP.end_dt, 'Mon,YYYY') || ' #' || to_char(TBCP.program_id) || ')' )::character varying as programname,\r
  a.adr_work_phone_tx as phonenumber,\r
  --(CAST(INITCAP(TRIM(TBPA.adr_street_tx)||' '||TRIM(TBPA.adr_street_nm)||' '||TRIM(TBPA.adr_city_nm) ||' '||TRIM(TBPA.adr_state_cd) ||' '||TRIM(TBPA.adr_zip5_no::character varying)) as  character varying)) as address,\r
  (select concat_ws(' ',tpa.adr_street_tx,(select coalesce(tpv.value_tx,'') from tb_picklist_values tpv where trim(tpv.picklist_value_cd) in (trim(tpa.adr_pre_dir_cd)) and tpv.picklist_type_id='69'),(case when tpa.adr_format_cd = 'P' then 'PO Box ' else '' end ), tpa.adr_box_no,tpa.adr_unit_no_tx,tpa.adr_street_nm,tpa.adr_street_suffix_cd,\r
   (select coalesce(value_tx,'') from tb_picklist_values where trim(picklist_value_cd) in (trim(tpa.adr_post_dir_cd)) and picklist_type_id='69'),tpa.adr_city_nm,(select cnty.countyname from county cnty where cnty.statecountycode = tpa.adr_county_cd and cnty.activeflag = 1),tpa.adr_state_cd,tpa.adr_zip5_no)\r
        from tb_provider_addresses tpa where   tpa.parent_key_id = TBP.provider_id ::character varying and adr_default_sw = 'Y' ORDER BY tpa.update_ts DESC Limit 1)::character varying as address,\r
  TBS.service_id , TBS.service_nm as placementstructure , 0::integer as bundled_service_id,'' as bundledplacementstructure, TBPS.provider_service_id,\r
  (select json_agg(x) from (select concat(up.firstname,' ',up.lastname) as license_cordinator from userprofile up where up.securityusersid=a.create_user_id and up.activeflag=1) as x) as license_cordinators\r
  from tb_provider as a where a.provider_id = TBP.provider_id and a.delete_sw = 'N') as x) as providerdetails,\r
  (select json_agg(x) from ( select TBP.provider_id, TBPLV.picklist_value_cd as childcharacteristics_picklist_value_cd, \r
  TBPLV.description_tx as childcharacteristics_description from tb_provider_picklist as TBPPL  \r
  JOIN tb_picklist_values as TBPLV ON TBPLV.picklist_value_cd = TBPPL.picklist_value_cd and TBPLV.delete_sw = 'N' and TBPLV.picklist_type_id = 43 \r
  Where TBPPL.provider_id = TBP.affiliate_provider_id and TBPPL.delete_sw = 'N' AND \r
  (CASE WHEN v_picklist_value_cd_childcharacteristics IS NOT NULL THEN TBPLV.picklist_value_cd = v_picklist_value_cd_childcharacteristics ELSE TRUE END)) as x) as childcharacteristicsdetails \r
  ,TBP.tax_id_no :: character varying,TBP.dob_dt,TBP.affiliate_provider_id \r
  ,(select c.countyname from county c where trim(c.statecountycode)=trim(TBP.county_cd) limit 1) as countyname,\r
  --TBPS.service_status\r
  'Active':: text AS service_status\r
  FROM tb_provider as TBP\r
  INNER JOIN tb_provider_contracts as TBPC on COALESCE(TBP.affiliate_provider_id, TBP.provider_id) = TBPC.provider_id and TBPC.delete_sw = 'N' and (TBPC.end_dt>=now()::date or TBPC.end_dt is null)\r
   INNER JOIN tb_contract_program as TBCP on TBPC.contract_id= TBCP.contract_id and TBCP.delete_sw = 'N' and (TBCP.end_dt>=now()::date or TBCP.end_dt is null) and TBCP.program_status_cd = '3625' \r
  INNER JOIN tb_provider_services as TBPS ON TBPS.program_id = TBCP.program_id and TBPS.delete_sw = 'N'\r
     INNER JOIN tb_services as TBS ON  TBS.service_id =  TBPS.service_id and TBS.structure_service_cd='P' and TBS.delete_sw = 'N' -- Placement structures\r
  INNER JOIN tb_prov_program_sites as TBPPS ON  TBPPS.program_id =  TBCP.program_id and TBPPS.site_id=TBP.provider_id AND TBPPS.delete_sw = 'N'\r
  WHERE TBP.provider_status_cd = '1791'  -- Provider Status Active\r
  --AND TBCP.program_id is not null\r
  AND TBP.delete_sw = 'N' \r
  AND TBP.provider_id in (\r
  SELECT tpcl1.provider_id FROM TB_PROVIDER_PICKLIST tpcl1 WHERE tpcl1.PICKLIST_TYPE_ID=155 \r
  AND tpcl1.PICKLIST_VALUE_CD IN ('3274','3302','3794') --1782','1785','3049'\r
  AND tpcl1.PROVIDER_ID = TBP.PROVIDER_ID AND tpcl1.DELETE_SW = 'N')\r
  AND ( -- Licence is ACTIVE \r
    --1. 3263 License Issued\r
    --2. 3266 License Issued Under CAP\r
    --3. 3260 License Sanctioned - Allow Placement Referrals\r
         SELECT trim(TPL.license_status_cd) IN ('3263', '3266', '3260') FROM\r
               tb_provider_licensing as TPL \r
            WHERE\r
            TPL.site_id = TBP.provider_id AND\r
            TPL.provider_id = TBP.affiliate_provider_id AND\r
              trim(TPL.license_status_cd) IN ('3263', '3266', '3260') AND\r
      TPL.license_expiry_dt >= now ():: date AND\r
            TPL.delete_sw = 'N' ORDER BY TPL.license_application_id DESC LIMIT 1\r
  )\r
  AND ( v_picklist_value_cd_childcharacteristics IS null\r
   or EXISTS\r
   (SELECT tpcl2.provider_id FROM TB_PROVIDER_PICKLIST tpcl2 WHERE tpcl2.PICKLIST_TYPE_ID in(43) \r
   AND tpcl2.PROVIDER_ID = TBP.affiliate_provider_id AND tpcl2.DELETE_SW = 'N'\r
   and tpcl2.picklist_value_cd=v_picklist_value_cd_childcharacteristics )\r
  )\r
   \r
  AND (CASE WHEN v_pname IS NOT NULL THEN \r
    CASE WHEN (TBP.provider_nm = null OR TBP.provider_nm='') \r
  THEN lower(CONCAT(TBP.provider_first_nm,' ',TBP.provider_last_nm))::character varying like '%' || lower(v_pname) || '%'\r
  ELSE\r
  lower(TBP.provider_nm) like '%' || lower(v_pname) || '%' END ELSE TRUE END)\r
  \r
  AND \r
  (v_service_id_placementstructures is null OR \r
  TBPS.service_id ::text in (select * from unnest(string_to_array(v_service_id_placementstructures, ',')))\r
  )\r
  AND \r
  (v_gender is null OR \r
    EXISTS(\r
         select TPA.gender_cd from \r
               tb_provider_licensing as TPL \r
            LEFT JOIN tb_prov_accomodation as TPA on TPA.license_application_id = TPL.license_application_id and TPA.delete_sw = 'N'\r
            where TPA.gender_cd=v_gender and TPL.provider_id = TBP.affiliate_provider_id and TPL.delete_sw = 'N'\r
    )\r
  \r
  )\r
  AND \r
  (v_agecheck is null OR \r
    (\r
 (\r
  v_agemin is null\r
  OR EXISTS(\r
   select\r
    TPA.minimum_age_no\r
   from\r
    tb_provider_licensing as TPL\r
    LEFT JOIN tb_prov_accomodation as TPA on TPA.license_application_id = TPL.license_application_id\r
    and TPA.delete_sw = 'N'\r
   where\r
    TPA.minimum_age_no <= v_agemin\r
    and TPL.provider_id = TBP.affiliate_provider_id\r
    and TPL.delete_sw = 'N'\r
  )\r
 )\r
 AND (\r
  v_agemax is null\r
  OR EXISTS(\r
   select\r
    TPA.maximum_age_no\r
   from\r
    tb_provider_licensing as TPL\r
    LEFT JOIN tb_prov_accomodation as TPA on TPA.license_application_id = TPL.license_application_id\r
    and TPA.delete_sw = 'N'\r
   where\r
    TPA.maximum_age_no >= v_agemax\r
    and TPL.provider_id = TBP.affiliate_provider_id\r
    and TPL.delete_sw = 'N'\r
  )\r
 )\r
)\r
  \r
  )\r
  AND \r
  (v_adr_zip5_no_zipcode is null OR \r
    EXISTS(\r
         SELECT TBPA.adr_zip5_no FROM \r
               tb_provider_addresses AS TBPA \r
            WHERE TBPA.adr_zip5_no = v_adr_zip5_no_zipcode::numeric\r
            AND TBPA.parent_key_id::integer=TBP.provider_id\r
    )\r
  \r
  )\r
  AND \r
  (v_service_id_bundledplacementservices is null OR \r
    EXISTS(\r
         SELECT TBS1.service_id  FROM \r
                tb_services as TBS1 WHERE  TBS1.service_id =  TBPS.service_id \r
                and TBS1.paid_non_paid_cd in ('3334','3335') and TBS1.delete_sw = 'N' \r
            and TBS1.service_id::character varying in (select * from unnest(string_to_array(v_service_id_bundledplacementservices, ',')))\r
    )\r
  \r
  )\r
  \r
  \r
  --AND (CASE WHEN v_service_id_bundledplacementservices IS NOT NULL THEN TBS1.service_id = v_service_id_bundledplacementservices::integer ELSE TRUE END)\r
  AND (CASE WHEN v_prov_tax_type_cd_taxid IS NOT NULL THEN TBP.prov_tax_type_cd = v_prov_tax_type_cd_taxid ELSE TRUE END)\r
  AND (CASE WHEN v_provider_id IS NOT NULL THEN TBP.provider_id = v_provider_id ELSE TRUE END)\r
  AND (CASE WHEN v_tax_id_no IS NOT NULL THEN TBP.tax_id_no = v_tax_id_no ELSE TRUE END)\r
  AND (CASE WHEN v_organization_name IS NOT NULL THEN TBP.provider_nm ilike '%' || v_organization_name || '%' ELSE TRUE END)\r
  AND (CASE WHEN v_fromproviderplacement IS NOT NULL THEN TBS.service_id not in (71,501,503) ELSE TRUE END)\r
  )\r
 ) as providerlist order by vacancy_no desc  nulls last LIMIT v_liPageSize OFFSET v_pageoffset;        \r
\r
END IF;\r
END;\r
