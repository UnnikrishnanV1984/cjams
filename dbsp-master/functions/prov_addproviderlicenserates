CREATE OR REPLACE FUNCTION prov_addproviderlicenserates(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE
returnStatus text;
providerId numeric;
monthlyRate numeric;
annualRate numeric;
dimRate numeric;
stdate date;
enddate date;
providerrateid numeric;
rateCode text;

BEGIN

providerId=insertedtlsobj->>'provider_id';
monthlyRate =insertedtlsobj->>'monthly_rate';
annualRate= insertedtlsobj->>'annual_rate';
dimRate =insertedtlsobj->>'per_diem_rate';
stdate=insertedtlsobj->>'start_dt';
enddate= insertedtlsobj->>'end_dt';
providerrateid= insertedtlsobj->>'provider_rate_id';
rateCode=insertedtlsobj->>'rate_code';

IF providerrateid>1
then 
update tb_provider_rates_master set rate_status='Expired' where provider_id=providerId and provider_rate_id=providerrateid;


/*
update tb_provider_rates_master set start_dt=stdate,end_dt=enddate,per_diem_rate=dimRate,rate_code=rateCode,license_type=insertedtlsobj->>'license_type',rate_status='Active' where provider_rate_id=providerrateid;
*/
insert into tb_provider_rates_master (provider_id, license_type, annual_rate, monthly_rate, per_diem_rate, start_dt, end_dt, create_ts, create_user_id, update_ts, update_user_id, rate_code, rate_status, bed_capacity, total_no_weeks, total_no_days, isratepreferred, ratecheck, rate_type_switch)
                values(providerId,insertedtlsobj->>'license_type', annualRate, 
                monthlyRate, dimRate,stdate ,enddate,
                insertedtlsobj->>'create_ts', insertedtlsobj->>'create_user_id', insertedtlsobj->>'update_ts', insertedtlsobj->>'update_user_id',
                rateCode, 'Active',(insertedtlsobj->>'bed_capacity') ::bigint , (insertedtlsobj->>'total_no_weeks') ::bigint, (insertedtlsobj->>'total_no_days') ::bigint, (insertedtlsobj->>'isratepreferred') ::bigint, (insertedtlsobj->>'ratecheck') ::bigint, insertedtlsobj->>'rate_type_switch');

else

/*update tb_provider_rates_master set rate_status='Expired'  where provider_id=providerId;*/

insert into tb_provider_rates_master (provider_id, license_type, annual_rate, monthly_rate, per_diem_rate, start_dt, end_dt, create_ts, create_user_id, update_ts, update_user_id, rate_code, rate_status, bed_capacity, total_no_weeks, total_no_days, isratepreferred, ratecheck, rate_type_switch)
                values(providerId,insertedtlsobj->>'license_type', annualRate, 
                monthlyRate, dimRate,stdate ,enddate,
                insertedtlsobj->>'create_ts', insertedtlsobj->>'create_user_id', insertedtlsobj->>'update_ts', insertedtlsobj->>'update_user_id',
                rateCode, 'Active',(insertedtlsobj->>'bed_capacity') ::bigint , (insertedtlsobj->>'total_no_weeks') ::bigint, (insertedtlsobj->>'total_no_days') ::bigint, (insertedtlsobj->>'isratepreferred') ::bigint, (insertedtlsobj->>'ratecheck') ::bigint, insertedtlsobj->>'rate_type_switch');


returnStatus:= 'Success';
END IF;
RETURN returnStatus;
                                                      
END;

$function$

