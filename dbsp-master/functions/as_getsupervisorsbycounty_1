CREATE OR REPLACE FUNCTION as_getsupervisorsbycounty_1(countyid character varying)
 RETURNS TABLE(securityusersid character varying, firstname character varying, lastname character varying, fullname character varying, countyname character varying, email character varying)
 LANGUAGE plpgsql
AS $function$


DECLARE 
        
   v_County character varying;
 
 
BEGIN 

v_County:=countyid;


return query
 
select muser.securityusersid,userprofile.firstname,userprofile.lastname,userprofile.fullname,
county.countyname,muser.email
from userprofile
inner join as_teammemberassignment ta on ta.securityusersid=userprofile.securityusersid
inner join teammember tm on ta.teammemberid=tm.teammemberid and tm.activeflag =1
inner join team t on t.teamid=tm.teamid and t.activeflag =1
inner join county on t.countyid::uuid=county.countyid::uuid and county.activeflag =1
inner join securityusers on securityusers.securityusersid=userprofile.securityusersid and userprofile.activeflag =1
inner join muser on muser.securityusersid=userprofile.securityusersid and muser.activeflag =1
join rolemapping rm on rm.principalid::int=muser.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int 
where t.countyid = v_County
and t.teamtypekey ='AS' and r.roletypekey='ASSP'
  

ORDER by userprofile.fullname asc;



END;

$function$

