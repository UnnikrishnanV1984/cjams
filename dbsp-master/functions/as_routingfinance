update routing set activeflag=0  where eventcode = appeventcode and objectid = v_objectid;
end if;

if (status in (40,41,42,44,45,56,57,73,81)) then  /*request  - Write off request from FW to FS */
 RAISE NOTICE 'inside:%', status;
 
 SELECT  tm.teamid ,tm.loadnumber ,rty.roletypecode, --tm.roletypekey,
    t.countyid into 
