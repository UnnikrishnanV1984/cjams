select ISRST.description into v_dispositionstatusdesc from intakeserreqstatustype as ISRST where ISRST.intakeserreqstatustypeid::character varying = v_intakeserreqstatustypeid;
END IF;
RAISE NOTICE 'v_intakeserviceid first :%', v_intakeserviceid;

if (coalesce(v_intakeserviceid,'') = '') THEN
 v_intakeserviceid = v_objectid; END IF ;
SELECT servicerequestnumber into v_servicerequestno FROM intakeservicerequest 
WHERE intakeserviceid :: character varying = v_intakeserviceid;
end if;

