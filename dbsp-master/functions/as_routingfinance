        WHERE  tma.SecurityUsersId = v_securityuserid
        AND   tma.activeflag =1;
        
   
      
        if(appeventcode != 'ASPCAUTHR')
        then
          
             SELECT routingid into v_routingid
        FROM routing r where
--        r.toroleid=--v_role
--  (select r.roletypekey from muser mu 
--  join rolemapping rm on rm.principalid = mu.id :: character varying
--  join "role" r on r.id = rm.roleid
--  where mu.securityusersid = v_securityuserid  and rm.activeflag =1 ORDER BY roletypekey DESC LIMIT 1)
--        --tosecurityusersid = v_securityuserid 
--        AND 
        activeflag =1
        AND r.objectid  = v_objectid 
  AND r.eventcode in ('ASPCAUTH','ASPCAUTHR')
        ORDER BY insertedon desc limit 1;
  
       if(appeventcode = 'MANREC')
        then
          
             SELECT routingid into v_routingid
        FROM routing r where
        activeflag =1
        AND r.objectid  = v_objectid 
  AND r.eventcode in ('MANREC')
        ORDER BY insertedon desc limit 1;
       end if;
       
        UPDATE routing SET activeflag =0 --,remarks =commenttext
        ,updatedon= v_date 
        WHERE routingid = v_routingid;
       
      raise notice '>>>> inside ASPCAUTH';
            INSERT INTO routing(
                        eventcode, fromsecurityusersid, tosecurityusersid, teamid, 
                        fromroleid, toroleid,objectid , routingstatustypeid,
            
                        insertedby,  updatedby,insertedon,updatedon, isreviewrequest,
                remarks,routeddescription,servicerequestnumber,objecttypekey)

            SELECT rc.eventcode, v_securityuserid,
                    tma.SecurityUsersId   , tm.teamid,
