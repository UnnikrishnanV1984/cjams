CREATE OR REPLACE FUNCTION get_purchase_auth_fiscal()
 RETURNS TABLE(fiscalcode integer, fiscal_description character varying, costnot_exceed numeric, justification_text character varying, voucher_requested character, authorization_id integer, service_log_id integer)
 LANGUAGE plpgsql
AS $function$

BEGIN
RETURN QUERY
SELECT  CASE WHEN TPV.picklist_type_id IS NOT NULL 
             THEN TPV.picklist_type_id 
    END AS "fiscalcode"
    ,CASE WHEN TPV.picklist_type_id IS NOT NULL 
             THEN TPV.value_tx 
    END AS "fiscal_description"
       ,CASE WHEN SPA.final_amount_no IS NOT NULL 
          THEN SPA.final_amount_no 
    END AS "costnot_exceed"
       ,SPA.justification_tx AS "justification_text"
       ,SPA.Voucher_sw       AS "voucher_requested"
    ,SPA.authorization_id AS "authorization_id"
    ,SPA.service_log_id   AS "service_log_id"
    
FROM tb_service_purchase_authorization AS SPA  
LEFT JOIN tb_picklist_values AS TPV ON TPV.picklist_type_id ::character  = SPA.fiscal_category_cd;
--WHERE TPV.picklist_type_id = 217

END

$function$

