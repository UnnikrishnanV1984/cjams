CREATE OR REPLACE FUNCTION getsupervisorsbycounty(countyid character varying)
 RETURNS TABLE(securityusersid character varying, firstname character varying, lastname character varying, fullname character varying, countyname character varying, email character varying)
 LANGUAGE plpgsql
AS $function$


DECLARE 
        
   v_County character varying;
 
 
BEGIN 

v_County:=countyid;


return query
 
select mu.securityusersid,up.firstname,up.lastname,up.fullname,c.countyname,mu.email from team t 
join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int 
left join userprofile up on up.securityusersid=mu.securityusersid and up.activeflag=1
 left join userprofileaddress upa on upa.securityusersid=up.securityusersid and upa.activeflag=1
left join county c on c.countyid=upa.countyid and c.activeflag=1
  where upa.countyid=v_County::uuid and r.roletypekey='ASSP'
  

ORDER by up.fullname asc;



END;

$function$

