CREATE OR REPLACE FUNCTION updateapplicationperson(v_objectid character varying, v_type character varying, v_securityuserid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

declare

v_inquiryid character varying;
v_inquirystatus character varying;
v_returnstatus character varying;
v_apppersonid character varying;
v_coapppersonid character varying;
v_actorid uuid;
v_actorrecord record;
v_personrecord record;
v_ssno int;
v_addressid uuid;



begin
  
v_apppersonid := null;
 
 select personid into v_apppersonid from intakeservicerequestactor where objectid in (v_objectid) and intakeservicerequestpersontypekey='APLCNT' and activeflag=1 order by insertedon desc limit 1;
 

 raise notice 'v_apppersonid%',v_apppersonid;

 if v_apppersonid is not null then 
 raise notice 'v_apppersonid%',v_apppersonid;

  for v_actorrecord in
  select ppn.phonenumber as homephonenumber,
   ppc.phonenumber as cellphonenumber,
   p.firstname,
   p.middlename,
   p.lastname,
   p.prefx,
   p.suffix,
   p.ssnno,
   p.dob,
   (
    case
     p.citizenalenageflag
     when 1 then true
     else false
    end
   ) as uscitizen,
   pe.email,
   pa.address,
   pa.address2,
   pa.city,
   pa.state,
   pa.zipcode,
   pep.employername,
   pep.workphone
  from person p --where eventcode like '%PRWS%'
   left join personphonenumber ppn on ppn.personid = p.personid
   and ppn.activeflag = 1
   and ppn.personphonetypekey in ('HM')
   left join personphonenumber ppc on ppc.personid = p.personid
   and ppc.activeflag = 1
   and ppc.personphonetypekey in ('CL')
   left join personemail pe on pe.personid = p.personid
   and pe.activeflag = 1
   left join personaddress pa on pa.personid = p.personid
   and pa.activeflag = 1
   and pa.currentlocationflag = 1
   left join personemployment pep on pep.personid = p.personid
   and pep.activeflag = 1
  where p.activeflag = 1
   and p.personid::character varying = v_apppersonid loop if (v_actorrecord.ssnno = '') then v_ssno = null;
  else v_ssno := v_actorrecord.ssnno;
  end if;
  update tb_public_provider_applicant
  set individual_applicant_hm_phone = COALESCE(
    v_actorrecord.homephonenumber,
    individual_applicant_hm_phone
   ),
   individual_applicant_cell_nm = COALESCE(
    v_actorrecord.cellphonenumber,
    individual_applicant_cell_nm
   ),
   individual_applicant_email = COALESCE(v_actorrecord.email, individual_applicant_email),
   individual_applicant_first_nm = COALESCE(
    v_actorrecord.firstname,
    individual_applicant_first_nm
   ),
   individual_applicant_last_nm = COALESCE(
    v_actorrecord.lastname,
    individual_applicant_last_nm
   ),
   individual_applicant_middle_nm = COALESCE(
    v_actorrecord.middlename,
    individual_applicant_middle_nm
   ),
   individual_applicant_prefix = COALESCE(v_actorrecord.prefx, individual_applicant_prefix),
   individual_applicant_suffix = COALESCE(
    v_actorrecord.suffix,
    individual_applicant_suffix
   ),
   individual_applicant_dob = COALESCE(v_actorrecord.dob, individual_applicant_dob),
   individual_applicant_ssn = COALESCE(v_ssno, individual_applicant_ssn),
   individual_applicant_employer_nm = COALESCE(
    v_actorrecord.employername,
    individual_applicant_employer_nm
   ),
   individual_applicant_us_citizen = COALESCE(
    v_actorrecord.uscitizen,
    individual_applicant_us_citizen
   )
  where applicant_id in (v_objectid);
  v_addressid := null;
  end loop;
  v_returnstatus := 'Application updated';
 end if;
 select personid into v_coapppersonid from intakeservicerequestactor where objectid in (v_objectid) and intakeservicerequestpersontypekey = 'COAPLCNT'
 and activeflag = 1 order by insertedon desc limit 1;

 if v_coapppersonid is not null then raise notice 'v_apppersonid%',
  v_apppersonid;
  for v_actorrecord in
  select ppn.phonenumber as homephonenumber,
   ppc.phonenumber as cellphonenumber,
   p.firstname,
   p.middlename,
   p.lastname,
   p.prefx,
   p.suffix,
   p.ssnno,
   p.dob,
   (
    case
     p.citizenalenageflag
     when 1 then true
     else false
    end
   ) as uscitizen,
   pe.email,
   pa.address,
   pa.address2,
   pa.city,
   pa.state,
   pa.zipcode,
   pep.employername,
   pep.workphone
  from person p --where eventcode like '%PRWS%'
   left join personphonenumber ppn on ppn.personid = p.personid
   and ppn.activeflag = 1
   and ppn.personphonetypekey in ('HM')
   left join personphonenumber ppc on ppc.personid = p.personid
   and ppn.activeflag = 1
   and ppc.personphonetypekey in ('CL')
   left join personemail pe on pe.personid = p.personid
   and pe.activeflag = 1
   left join personaddress pa on pa.personid = p.personid
   and pa.activeflag = 1
   and pa.currentlocationflag = 1
   left join personemployment pep on pep.personid = p.personid
   and pep.activeflag = 1
  where p.activeflag = 1
   and p.personid::character varying = v_coapppersonid loop if (v_actorrecord.ssnno = '') then v_ssno = null;
  else v_ssno := v_actorrecord.ssnno;
  end if;
  update tb_public_provider_applicant
  set co_applicant_hm_phone = COALESCE(
    v_actorrecord.homephonenumber,
    individual_applicant_hm_phone
   ),
   co_applicant_cell_nm = COALESCE(
    v_actorrecord.cellphonenumber,
    individual_applicant_cell_nm
   ),
   co_applicant_email = COALESCE(v_actorrecord.email, individual_applicant_email),
   co_applicant_first_nm = COALESCE(
    v_actorrecord.firstname,
    individual_applicant_first_nm
   ),
   co_applicant_last_nm = COALESCE(
    v_actorrecord.lastname,
    individual_applicant_last_nm
   ),
   co_applicant_middle_nm = COALESCE(
    v_actorrecord.middlename,
    individual_applicant_middle_nm
   ),
   co_applicant_prefix = COALESCE(v_actorrecord.prefx, individual_applicant_prefix),
   co_applicant_suffix = COALESCE(
    v_actorrecord.suffix,
    individual_applicant_suffix
   ),
   co_applicant_dob = COALESCE(v_actorrecord.dob, individual_applicant_dob),
   co_applicant_ssn = COALESCE(v_ssno, individual_applicant_ssn),
   co_applicant_employer_nm = COALESCE(
    v_actorrecord.employername,
    individual_applicant_employer_nm
   ),
   co_applicant_us_citizen = COALESCE(
    v_actorrecord.uscitizen,
    individual_applicant_us_citizen
   )
  where applicant_id in (v_objectid);
  v_addressid := null;
  end loop;
  v_returnstatus := 'Application updated';
 else 
  update tb_public_provider_applicant set 
   co_applicant_hm_phone = null,
   co_applicant_cell_nm = null,
   co_applicant_email = null,
   co_applicant_first_nm = null,
   co_applicant_last_nm = null,
   co_applicant_middle_nm = null,
   co_applicant_prefix = null,
   co_applicant_suffix = null,
   co_applicant_dob = null,
   co_applicant_ssn = null,
   co_applicant_employer_nm = null,
   co_applicant_us_citizen = null
  where applicant_id in (v_objectid);
 end if; 

 if (v_returnstatus = 'Application updated') then 
  v_returnstatus := 'Success';
 else
   v_returnstatus := 'Failure';
 end if;
RETURN v_returnstatus;

END;

$function$

