CREATE OR REPLACE FUNCTION as_createduplicatemonthlyreport(v_intakeserviceid uuid, v_newintakeserviceid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare
v_monthlyreport RECORD;
v_ihasprovidermonthlyreportid uuid;

 begin
 
FOR v_monthlyreport IN 
SELECT * 
FROM ihasprovidermonthlyreport i 
WHERE activeflag =1 
AND i.intakeserviceid =v_intakeserviceid
  
loop

v_ihasprovidermonthlyreportid :=gen_random_uuid();
  insert into ihasprovidermonthlyreport(
  ihasprovidermonthlyreportid,
    intakeserviceid,
    providername,
    provideraddress,
    providercity,
    providerstate,
    providerzipcode,
    providerphoneno,
    categoryihasfamily,
    categoryihasadults,
    categoryeligible,
    categoryihasanothereservice,
    providerihasfamily,
    providerihasadults,
    providereligible,
    providerihasanothereservice,
    pca,
    agencyobject,
    ldsssignature,
    aidesignature,
    caregiversignature,
    caregiversigndate,
    activeflag,
    updatedby,
    updatedon,
    insertedby,
    insertedon,
    effectivedate,
    expirationdate,
    totalinvoiceamount,
    reportstatus,
    ldsssignaturedate,
    aidesignaturedate,
    accountclerksign,
    providerssn,
    reportedmonthyear,
    intakeservicerequestactorid1,
    intakeservicerequestactorid2,
    isattached,
    respite,
    familyorfriend,
    inhomecareagency,
    adultdaycare,
    camp,
    assistedliving,
    nursinghome,
    isdocumentattach,
    other,
    status,
    caregiversignaturedg,
    ldsssignaturedg,
    aidesignaturedg,
    accountclerksigndg)
  SELECT  v_ihasprovidermonthlyreportid,v_newintakeserviceid,
    v_monthlyreport.providername,
    v_monthlyreport.provideraddress,
    v_monthlyreport.providercity,
    v_monthlyreport.providerstate,
    v_monthlyreport.providerzipcode,
    v_monthlyreport.providerphoneno,
    v_monthlyreport.categoryihasfamily,
    v_monthlyreport.categoryihasadults,
    v_monthlyreport.categoryeligible,
    v_monthlyreport.categoryihasanothereservice,
    v_monthlyreport.providerihasfamily,
    v_monthlyreport.providerihasadults,
    v_monthlyreport.providereligible,
    v_monthlyreport.providerihasanothereservice,
    v_monthlyreport.pca,
    v_monthlyreport.agencyobject,
    v_monthlyreport.ldsssignature,
    v_monthlyreport.aidesignature,
    v_monthlyreport.caregiversignature,
    v_monthlyreport.caregiversigndate,
    1,
    v_securityusersid,
    now(),
    v_securityusersid,
    now(),
    now(),
    v_monthlyreport.expirationdate,
    v_monthlyreport.totalinvoiceamount,
    v_monthlyreport.reportstatus,
    v_monthlyreport.ldsssignaturedate,
    v_monthlyreport.aidesignaturedate,
    v_monthlyreport.accountclerksign,
    v_monthlyreport.providerssn,
    v_monthlyreport.reportedmonthyear,
    v_monthlyreport.intakeservicerequestactorid1,
    v_monthlyreport.intakeservicerequestactorid2,
    v_monthlyreport.isattached,
    v_monthlyreport.respite,
    v_monthlyreport.familyorfriend,
    v_monthlyreport.inhomecareagency,
    v_monthlyreport.adultdaycare,
    v_monthlyreport.camp,
    v_monthlyreport.assistedliving,
    v_monthlyreport.nursinghome,
    v_monthlyreport.isdocumentattach,
    v_monthlyreport.other,
    v_monthlyreport.status,
    v_monthlyreport.caregiversignaturedg,
    v_monthlyreport.ldsssignaturedg,
    v_monthlyreport.aidesignaturedg,
    v_monthlyreport.accountclerksigndg;
  

  insert into ihasprovidedmonthlyreportdaysconfig(
  ihasprovidermonthlyreportid,
  activitykey,
  day01,day02,day03,day04,day05,day06,day07,day08,day09,day10,
  day11,day12,day13,day14,day15,day16,day17,day18,day19,day20,
  day21,day22,day23,day24,day25,day26,day27,day28,day29,day30,day31,
  total,
  "version",
  activeflag,
  updatedby,
  updatedon,
  insertedby,
  insertedon,
  effectivedate,
  expirationdate)
  select v_ihasprovidermonthlyreportid,
  activitykey,
  day01,day02,day03,day04,day05,day06,day07,day08,day09,day10,
  day11,day12,day13,day14,day15,day16,day17,day18,day19,day20,
  day21,day22,day23,day24,day25,day26,day27,day28,day29,day30,day31,
  total,
  "version",
  1,
  v_securityusersid,
  now(),
  v_securityusersid,
  now(),
  now(),
  ihpmrdc.expirationdate
from ihasprovidedmonthlyreportdaysconfig ihpmrdc where ihpmrdc.ihasprovidermonthlyreportid=v_monthlyreport.ihasprovidermonthlyreportid;

end loop;
  
  return 'Success';
 END;
$function$

