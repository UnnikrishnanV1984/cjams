CREATE OR REPLACE FUNCTION prov_relicensure_notify()
 RETURNS TABLE(status text, msgdata jsonb, username character varying)
 LANGUAGE plpgsql
AS $function$
DECLARE

v_providernm character varying;
v_notifymsg character varying;
v_msg character varying;
v_username character varying;
v_toemailid character varying;
v_provideruserid character varying;
v_prov_id integer;
v_hasattachments boolean default false;
v_deficiency character varying;
v_notifystatus text;
i json;
v_msgdata jsonb;


BEGIN  
-- Subject and Body for Email
 
select  jsonb_agg(A) as msgdata 
into v_msgdata 
from ( 
---120EXE----
select distinct prm.license_application_id,prm.license_expiry_dt,tp.provider_nm,up.email,up.username, up.securityusersid,tp.provider_id,'120'::text as days
from tb_provider_licensing prm 
join muser up on up.securityusersid=prm.create_user_id
join tb_provider tp on tp.provider_id=prm.provider_id
where prm.license_expiry_dt is not null
and (prm.license_expiry_dt::date - interval '120 day')::date=now()::date

union

-----120PM-----
select distinct prm.license_application_id,prm.license_expiry_dt,tp.provider_nm,up.email,up.username, up.securityusersid,tp.provider_id,'120'::text as days
from tb_provider_licensing prm
join tb_provider tp on tp.provider_id=prm.provider_id
join muser up on up.securityusersid=tp.create_user_id
where prm.license_expiry_dt is not null
and (prm.license_expiry_dt::date - interval '120 day')::date=now()::date

union

-----120QA---
select distinct prm.license_application_id,prm.license_expiry_dt,tp.provider_nm,'jason@com' as email,'Jason West' as username, '250a0c1a-06ec-40d4-88af-b7f509e4e53f' as securityusersid,tp.provider_id,'120'::text as days
from tb_provider_licensing prm
join tb_provider tp on tp.provider_id=prm.provider_id
join muser up on up.securityusersid=tp.create_user_id
where prm.license_expiry_dt is not null
and (prm.license_issue_dt::date + '1 year'::interval  - '120 day'::interval)::date=now()::date

union

--45EXE---
select distinct prm.license_application_id,prm.license_expiry_dt,tp.provider_nm,up.email,up.username, up.securityusersid,tp.provider_id,'45'::text as days
from tb_provider_licensing prm 
join muser up on up.securityusersid=prm.create_user_id
join tb_provider tp on tp.provider_id=prm.provider_id
where prm.license_expiry_dt is not null
and (prm.license_expiry_dt::date - interval '45 day')::date=now()::date

union

--45PM--
select distinct prm.license_application_id,prm.license_expiry_dt,tp.provider_nm,up.email,up.username, up.securityusersid,tp.provider_id,'45'::text as days
from tb_provider_licensing prm
join tb_provider tp on tp.provider_id=prm.provider_id
join muser up on up.securityusersid=tp.create_user_id
where prm.license_expiry_dt is not null
and (prm.license_expiry_dt::date - interval '45 day')::date=now()::date
union
--45QA--
select distinct prm.license_application_id,prm.license_expiry_dt,tp.provider_nm,'jason@com' as email,'Jason West' as username, '250a0c1a-06ec-40d4-88af-b7f509e4e53f' as securityusersid,tp.provider_id,'45'::text as days
from tb_provider_licensing prm
join tb_provider tp on tp.provider_id=prm.provider_id
join muser up on up.securityusersid=tp.create_user_id
where prm.license_expiry_dt is not null
and (prm.license_issue_dt::date + '1 year'::interval  - '45 day'::interval)::date=now()::date


)A;


FOR i in select jsonb_array_elements(v_msgdata)
loop
RAISE NOTICE 'v_msgdata(v_msgdata)---:%',v_msgdata;
v_msg := coalesce(i->>'provider_nm','') || ' Re-Licensure is due in '||cast( i ->> 'days' as varchar)||' days' ;
v_notifymsg :=coalesce(i->>'provider_nm','') || ' Re-Licensure is due in '||cast( i ->> 'days' as varchar)||' days' ;
v_username := i->>'username';

RAISE NOTICE 'v_msg(v_msg)---:%',v_msg;
RAISE NOTICE 'v_notifymsg-:%',v_notifymsg;

SELECT prov_send_notification INTO v_notifystatus 
FROM prov_send_notification(i->>'securityusersid',i->>'securityusersid',i->>'securityusersid',
'System', 'High', v_msg,  v_notifymsg , i ->> 'license_application_id',false , v_hasattachments);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   

end loop;

v_notifystatus:='SUCCESS';  
return query

select v_notifystatus,v_msgdata,v_username ;

END;
$function$

