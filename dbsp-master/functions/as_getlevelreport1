CREATE OR REPLACE FUNCTION as_getlevelreport1(p_youthid integer, p_providername character varying, p_level character varying, p_pagesize integer, p_pageoffset integer, p_nolimit boolean)
 RETURNS TABLE(reccount bigint, pid bigint, clientname character varying, dob timestamp without time zone, level character varying, region character varying, phonenumber character varying, admitdate date, releasedate date, providername character varying, placementadmissiontypekey character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                          
 BEGIN                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                          
      RETURN QUERY                                                                                                                                                                                                                                                                                        
                 select count(*) over() as reccount,                                                                                                                                                                                                                                                      
                         p.cjamspid as pid,                                                                                                                                                                                                                                                               
                         cast(p.firstname||' '||p.lastname as character varying) as clientname,                                                                                                                                                                                                           
                         p.dob as dob,                                                                                                                                                                                                                                                                    
                         rv.description  as "level",                                                                                                                                                                                                                                                      
                         rg.regionname as region,                                                                                                                                                                                                                                                         
                         cast((case when pc.phoneextension is null or pc.phoneextension = '' then '000' else pc.phoneextension end)||'-'||pc.phonenumber as character varying)  as phonenumber,                                                                                                           
                         pl.addate as admitdate,                                                                                                                                                                                                                                                          
                         pl.releasedate,                                                                                                                                                                                                                                                                  
                         pr.providername,                                                                                                                                                                                                                                                                 
                         pat.description as placementadmissiontypekey                                                                                                                                                                                                                                     
                 from placement pl                                                                                                                                                                                                                                                                        
                 join provider pr on pl.providerid = pr.providerid                                                                                                                                                                                                                                        
                 join provideraddress pa on pa.providerid = pr.providerid and pa.activeflag = 1                                                                                                                                                                                                           
                 join providercontactinfo pc on pc.providerid = pr.providerid and pc.activeflag = 1                                                                                                                                                                                                       
                 join placementadmissiontype pat on pat.placementadmissiontypekey = pl.placementadmissiontypekey and pat.activeflag = 1                                                                                                                                                                   
                 join (select distinct actorid ,intakeserviceid from intakeservicerequestactor where activeflag = 1) isra on isra.intakeserviceid = pl.intakeserviceid                                                                                                                                    
                 join actor a on a.actorid = isra.actorid and a.activeflag =1 and a.actortype = 'Youth'                                                                                                                                                                                                   
                 join person p on p.personid = a.personid and p.activeflag =1                                                                                                                                                                                                                             
                 left join ( select r.description,r.ref_key                                                                                                                                                                                                                                               
                                                         from referencetype rt                                                                                                                                                                                                                            
                                                         join referencevalues r on rt.referencetypeid = r.referencetypeid and r.activeflag = 1                                                                                                                                                            
                                                         where rt.tablename = 'providerunittype' and rt.activeflag = 1 ) rv on rv.ref_key = pr.providerunit                                                                                                                                               
                 left join county jc on jc.countyid = pl.county                                                                                                                                                                                                                                           
                 left join region rg on rg.regionid = jc.regionid                                                                                                                                                                                                                                         
                 where pl.activeflag = 1                                                                                                                                                                                                                                                                  
                 and case when p_youthid is not null then p.cjamspid = p_youthid else true end                                                                                                                                                                                                            
                 and case when p_providername is not null then pr.providername ilike '%'||p_providername||'%' else true end                                                                                                                                                                               
                 and case when p_level is not null then pr.providerunit = p_level else true end                                                                                                                                                                                                           
                 limit (case when p_nolimit is false then p_pagesize else null end ) offset (case when p_nolimit is false then p_pageoffset else null end);                                                                                                                                               
                                                                                                                                                                                                                                                                                                          
 END;                                                                                                                                                                                                                                                                                                     
 $function$

