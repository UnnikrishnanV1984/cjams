 LANGUAGE plpgsql
AS $function$
 declare 
_offset integer;
jsondatas json;
narativeval json;
obj json;
incidentdate timestamp without time zone;
incidentdateval character varying;
persondetails json;
v_intakeserviceid uuid;
v_intakenumber CHARACTER VARYING;

begin
_offset := (_page - 1) * _limit;

v_intakeserviceid := null;
v_intakenumber := v_objectid;

For    jsondatas    in    SELECT   idas.jsondata::json    FROM    intakedastaging idas where 
 idas.intakenumber =coalesce(v_intakenumber, (select inss.intakenumber from intakeservicerequest inss where inss.intakeserviceid = v_intakeserviceid)) and idas.activeflag =1
LOOP 
    obj := jsondatas->>'General';
raise notice 'teslsldst %' ,incidentdate;
incidentdateval := obj->>'RecivedDate';
if(incidentdateval != '' )
then
raise notice 'qqqqqqqqqqqqqqqqqqqq %' ,incidentdate;
 incidentdate := incidentdateval ::timestamp without time zone; 
else 
incidentdate := null;
raise notice 'else %' ,incidentdate;
end if;
END  loop ;

raise notice 'test %',incidentdate;

return QUERY 

