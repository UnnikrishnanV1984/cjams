CREATE OR REPLACE FUNCTION getpersonsbyinvestigation_(invetsigationid uuid)
 RETURNS TABLE(rolename character varying, personid uuid, firstname character varying, lastname character varying, gender character varying, dob timestamp without time zone, phonenumber character varying, dangerous text, pirors text)
 LANGUAGE plpgsql
AS $function$
BEGIN
RETURN QUERY
SELECT IAR.intakeservicerequestpersontypekey,P.personid,p.firstname,p.lastname,p.gendertypekey,p.dob,PP.phonenumber,
(CASE WHEN p.dangerlevel = 0 THEN 'NO' ELSE 'YES' END) AS dangerous
/*(CASE WHEN (SELECT COUNT(*) FROM intakeservicerequest as A 
JOIN  intakeservicerequestactor as B  ON A.intakeserviceid = B.intakeserviceid 
JOIN  actor as C on C.ActorId = B.ActorId  
JOIN person as D ON C.personid=D.personid 
WHERE A.activeflag=1 AND C.activeflag=1 AND D.personid=P.personid)>1 THEN 'YES' ELSE 'NO' END) AS priors*/
FROM Intakeservicerequestactor as IAR 
LEFT JOIN actor AS AC ON IAR.actorid=AC.actorid 
LEFT JOIN person AS P ON P.personid=AC.personid 
LEFT JOIN personaddress AS PA ON PA.personid=P.personid 
LEFT JOIN personphonenumber AS PP ON PP.personid=P.personid 
WHERE IAR.IntakeServiceId=invetsigationid; 
--LIMIT 2 OFFSET 5;
 END;
$function$

