CREATE OR REPLACE FUNCTION prov_providerroutingmonitoring(objectls json)
 RETURNS TABLE(emailnotify json)
 LANGUAGE plpgsql
AS $function$ 

declare
v_fromsecurityuserid character varying;
v_appstatus character varying;
v_objectid character varying;
v_eventcode character varying;
v_msg character varying;
v_msgs character varying;
v_tosecurityusersid character varying;
v_tousersid RECORD;
v_username character varying;
v_notification character varying;
v_notifymsg character varying DEFAULT ''::character varying;
v_site_id character varying;
v_request_no character varying;
v_request_type character varying;
v_status character varying;
v_isfinal boolean;
v_activeflag integer;
v_rejectedbyid character varying;
resubmit integer;
v_toroleid character varying;
v_touserid character varying;
v_emailid json;
v_provider_id integer;
v_expiry_dt date;


begin
v_fromsecurityuserid:= objectls->>'fromsecurityuserid';
v_toroleid:= objectls->>'toroleid';
v_touserid:= objectls->>'tosecurityuserid';
v_appstatus:= objectls->>'statusvalue';
v_objectid:= objectls->>'objectid';
v_eventcode := objectls->>'eventcode';


update tb_provider_decision 
set activeflag = 0,
updatedby = v_fromsecurityuserid,
updatedon = now()
where objectid = v_objectid and eventcode in ('MVR');




INSERT INTO tb_provider_decision
(decisionid, eventcode, fromsecurityusersid, fromroleid, objectid, activeflag, insertedby, insertedon, updatedby, updatedon, isreviewrequest, remarks, status, decisiondate,
toroleid,tosecurityusersid)
VALUES(gen_random_uuid(),'MVR', v_fromsecurityuserid, objectls->>'fromroleid', v_objectid, 1, v_fromsecurityuserid, now(), v_fromsecurityuserid,
now(), false, objectls->>'remarks', v_appstatus,  now() ,v_toroleid,v_touserid);


RETURN QUERY
select json_agg(x) from (
select 
v_emailid,v_msg,v_objectid ,v_provider_id) as x
;
end;
$function$

