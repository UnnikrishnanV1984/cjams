CREATE OR REPLACE FUNCTION as_accreceivableprovidersearch(searchobj json)
 RETURNS TABLE(totalcount bigint, provider_id integer, provider_nm character varying, tax_id_no numeric, taxidtype character varying, prov_tax_type_cd character varying, mail_code_tx character varying, adm_cell_phone_tx character varying, adm_home_phone_tx character varying, adm_work_phone_tx character varying, adm_fax_tx character varying, adr_fax_tx character varying, adr_cell_phone_tx character varying, adr_home_phone_tx character varying, adr_work_phone_tx character varying, adm_work_xtn_tx character, adr_work_xtn_tx character varying, adr_street_nm character varying, adr_city_nm character varying, adr_state_cd character varying, adr_zip5_no numeric, adr_county_cd character varying, adr_county_nm character varying, totalbalancedue numeric, under_payment numeric, localdept jsonb, receivabletype jsonb, categorytype character varying, provider_category_cd character varying, totalplacement bigint, collectionresp character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_Providerid INT;
    v_ProviderName VARCHAR(50);
    v_taxid INT;
    v_Firstname varchar(50); 
    v_Lastname varchar(50);
   v_Mailcode varchar(50);
    v_liPageNumber INT;                              
    v_liPageSize INT;
    v_pagenumber int;
 v_pageoffset int;

 
BEGIN 
v_Providerid := searchobj ->> 'providerid';
v_ProviderName := searchobj ->> 'providername';  
v_taxid := searchobj ->> 'taxid'; 
v_Firstname := searchobj ->> 'fname'; 
v_Lastname := searchobj ->> 'lname'; 
v_Mailcode := searchobj ->> 'mailcode';
v_liPageNumber := searchobj ->> 'pagenumber';
v_liPageSize := searchobj ->> 'pagesize'; 

 
IF COALESCE(v_liPageSize, 0) < 1 THEN                     
 v_liPageSize := 10;
END IF;

IF COALESCE(v_liPageNumber, 0) < 1 
THEN
 v_liPageNumber := 1; 
end if;

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

return query
 
select count(1) over() as totalcount,x.* from (select distinct prov.provider_id,CASE WHEN (prov.provider_nm = null OR prov.provider_nm='') 
THEN CONCAT(prov.provider_first_nm,' ',prov.provider_last_nm) ELSE prov.provider_nm END AS provider_nm,prov.tax_id_no,(select value_tx from tb_picklist_values where 
TRIM(PICKLIST_VALUE_CD)=prov.prov_tax_type_cd
AND PICKLIST_TYPE_ID='216') as taxidtype,prov.prov_tax_type_cd,prov.mail_code_tx,prov.adm_cell_phone_tx,prov.adm_home_phone_tx,prov.adm_work_phone_tx,
prov.adm_fax_tx,prov.adr_fax_tx,prov.adr_cell_phone_tx,prov.adr_home_phone_tx,prov.adr_work_phone_tx,
prov.adm_work_xtn_tx,prov.adr_work_xtn_tx
,tpa.adr_street_nm AS adr_street_nm             
,tpa.adr_city_nm   AS adr_city_nm         
,tpa.adr_state_cd  AS adr_state_cd       
,tpa.adr_zip5_no   AS adr_zip5_no
,tpa.adr_county_cd AS adr_county_cd,(select value_tx from tb_picklist_values where 
TRIM(PICKLIST_VALUE_CD)=tpa.adr_county_cd
AND PICKLIST_TYPE_ID='328') as adr_county_nm, sum(recdet.receivable_balance_no) as totalbalancedue,

(select sum(trde.receivable_balance_no) from routing r
 join as_tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
  and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
 join as_tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
 where r.eventcode = 'MANREC' --and r.objectid = '10000079'--and trhr.provider_id = 201900420
 and r.routingstatustypeid in (73) and r.activeflag = 1 
 and trhr.provider_id = v_Providerid  and  trhr.delete_sw='N'
) as under_payment,

(select json_agg(x) from
( select trd.county_cd,(select value_tx from tb_picklist_values where trim(picklist_value_cd)=trd.county_cd and picklist_type_id='104') 
as localdept,case when trd.county_cd is not null then sum(trd.receivable_balance_no) else null end as sum from tb_payment_header tph
inner join tb_payment_detail tpd on tpd.payment_id= tph.payment_id
inner join as_tb_receivable_detail trd on trd.payment_detail_id = tpd.payment_detail_id
left join routing rtd on trd.receivable_detail_id = rtd.objectid
--inner join tb_provider tp on tp.provider_id = prov.provider_id
where tph.provider_id=prov.provider_id and rtd.routingstatustypeid = 74 and rtd.activeflag = 1
group by trd.county_cd) as x)::jsonb as localdept,
(select json_agg(x) from
( select trd.receivable_type,(select value_tx from tb_picklist_values where trim(picklist_value_cd)=trd.receivable_type and picklist_type_id='64') as 
receivablenm,case when trd.receivable_type is not null then sum(trd.receivable_balance_no) else null end as sum from tb_payment_header tph
inner join tb_payment_detail tpd on tpd.payment_id= tph.payment_id
inner join as_tb_receivable_detail trd on trd.payment_detail_id = tpd.payment_detail_id
inner join routing rtd on trd.receivable_detail_id = rtd.objectid
where tph.provider_id=prov.provider_id and rtd.routingstatustypeid = 74 and rtd.activeflag = 1
group by trd.receivable_type) as x)::jsonb as receivabletype,
(select value_tx from tb_picklist_values where 
trim(picklist_value_cd)=prov.provider_category_cd and picklist_type_id='155') as categorytype,prov.provider_category_cd,
(select count(1) from tb_placement tp where tp.provider_id=prov.provider_id and tp.delete_sw='N' and tp.approval_status_cd = '3047' and exit_dt is null) as totalplacement,
(select value_tx from tb_picklist_values where 
TRIM(PICKLIST_VALUE_CD)=prov.county_cd
AND PICKLIST_TYPE_ID='328') as collectionresp
--,(select count(1) from tb_placement where provider_id = v_Providerid and delete_sw ='N' and approval_status_cd = '3047' and exit_dt is null) placement_no
from prov.tb_provider prov
left join prov.tb_provider_addresses tpa on tpa.parent_key_id = prov.provider_id :: character varying
and tpa.delete_sw = 'N'
left join tb_payment_header payhead on payhead.provider_id = prov.provider_id
left join tb_payment_detail paydet on paydet.payment_id = payhead.payment_id
left join as_tb_receivable_detail recdet on recdet.payment_detail_id = paydet.payment_detail_id
left join routing routetb on recdet.receivable_detail_id = routetb.objectid
where prov.provider_id=v_Providerid and routetb.routingstatustypeid = 74 and routetb.activeflag = 1
group by prov.provider_id,prov.provider_nm,prov.provider_first_nm,prov.provider_last_nm,prov.tax_id_no,
prov.prov_tax_type_cd,prov.mail_code_tx,prov.adm_cell_phone_tx,prov.adm_home_phone_tx,prov.adm_work_phone_tx,
prov.adm_fax_tx,prov.adr_fax_tx,prov.adr_cell_phone_tx,prov.adr_home_phone_tx,prov.adr_work_phone_tx,
prov.adm_work_xtn_tx,prov.adr_work_xtn_tx,tpa.adr_street_nm,tpa.adr_city_nm,tpa.adr_state_cd,tpa.adr_zip5_no,tpa.adr_county_cd,prov.provider_category_cd
) as x
LIMIT 1 OFFSET v_pageoffset; 

END;

$function$

