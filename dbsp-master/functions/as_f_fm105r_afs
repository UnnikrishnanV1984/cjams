CREATE OR REPLACE FUNCTION as_f_fm105r_afs(start_date date, end_date date)
 RETURNS TABLE(ldss_desc character varying, payment_amount numeric, payment_id character varying, fiscal_category_cd character, fiscal_category_desc character varying, create_ts timestamp without time zone)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY 
( 


 SELECT
       distinct  CASE
            WHEN afs.ldss_nm::text = '01'::text THEN 'ALLEGANY'::character varying
            WHEN afs.ldss_nm::text = '02'::text THEN 'ANNE ARUNDEL'::character varying
            WHEN afs.ldss_nm::text = '03'::text THEN 'BALTIMORE COUNTY'::character varying
            WHEN afs.ldss_nm::text = '04'::text THEN 'CALVERT'::character varying
            WHEN afs.ldss_nm::text = '05'::text THEN 'CAROLINE'::character varying
            WHEN afs.ldss_nm::text = '06'::text THEN 'CARROLL'::character varying
            WHEN afs.ldss_nm::text = '07'::text THEN 'CECIL'::character varying
            WHEN afs.ldss_nm::text = '08'::text THEN 'CHARLES'::character varying
            WHEN afs.ldss_nm::text = '09'::text THEN 'DORCHESTER'::character varying
            WHEN afs.ldss_nm::text = '10'::text THEN 'FREDERICK'::character varying
            WHEN afs.ldss_nm::text = '11'::text THEN 'GARRETT'::character varying
            WHEN afs.ldss_nm::text = '12'::text THEN 'HARFORD'::character varying
            WHEN afs.ldss_nm::text = '13'::text THEN 'HOWARD'::character varying
            WHEN afs.ldss_nm::text = '14'::text THEN 'KENT'::character varying
            WHEN afs.ldss_nm::text = '15'::text THEN 'MONTGOMERY'::character varying
            WHEN afs.ldss_nm::text = '16'::text THEN 'PRINCE GEORGES'::character varying
            WHEN afs.ldss_nm::text = '17'::text THEN 'QUEEN ANNES'::character varying
            WHEN afs.ldss_nm::text = '18'::text THEN 'ST. MARYS'::character varying
            WHEN afs.ldss_nm::text = '19'::text THEN 'SOMERSET'::character varying
            WHEN afs.ldss_nm::text = '20'::text THEN 'TALBOT'::character varying
            WHEN afs.ldss_nm::text = '21'::text THEN 'WASHINGTON'::character varying
            WHEN afs.ldss_nm::text = '22'::text THEN 'WICOMICO'::character varying
            WHEN afs.ldss_nm::text = '23'::text THEN 'WORCESTER'::character varying
            WHEN afs.ldss_nm::text = '30'::text THEN 'BALTIMORE CITY'::character varying
            ELSE afs.ldss_nm
        END AS ldss_desc,
    afs.payment_amt AS payment_amount,afs.payment_id,
    fcm.fiscal_category_cd,
    fcm.fiscal_category_desc,
    afs.create_ts
   FROM tb_afs_interfaces afs,
    tb_fiscal_category_master fcm
  WHERE fcm.fiscal_category_cd = afs.budget_cd::bpchar AND fcm.delete_sw = 'N'::bpchar 
  and afs.CREATE_TS>=CAST(Start_date AS DATE)
 AND afs.CREATE_TS<=CAST(End_date  AS DATE) );
end;
$function$

