CREATE OR REPLACE FUNCTION as_get_finance_adoption_details(request json)
 RETURNS TABLE(totalcount bigint, addiction_cd character varying, adoption_granted_sw character, adoption_id integer, adoption_plan_begin_dt timestamp without time zone, adoption_subsidy_sw character, adoptive_case_creation_dt timestamp without time zone, adoptive_father_id double precision, adoptive_mother_id integer, adoptive_placement_status_cd character varying, adoptive_placement_sw character, agency_involvement_cd character varying, applicable_child_assess_cd character varying, applicable_child_cd character varying, applicable_child_dt timestamp without time zone, approval_status_cd character varying, attached_documents_tx character varying, case_id integer, checklist_comments_tx character varying, chil_new_last_nm character varying, child_health_cd character varying, child_living_sw character, child_new_first_nm character varying, child_new_middle_nm character varying, child_new_prefix_cd character varying, child_new_suffix_cd character varying, client_history_tx character varying, client_id integer, client_merge_id integer, court_order_id integer, deeply_commited_cd character varying, designee_agreement_dt timestamp without time zone, disclosed_to_tx character varying, disclosure_approval_status_cd character varying, disclosure_dt timestamp without time zone, disclosure_non_staff_tx character varying, disclosure_staff_id integer, disruption_comments_tx character varying, disruption_dt timestamp without time zone, dissolution_comments_tx character varying, dissolution_dt timestamp without time zone, dss_custody_cd character varying, father_agreement_dt timestamp without time zone, finalization_dt timestamp without time zone, health_cd character varying, legally_free_sw character, ma_only_payment_cd character varying, medication_history_cd character varying, mother_agreement_dt timestamp without time zone, only_subsidy_sw character, placed_by_cd character varying, placed_from_cd character varying, placement_agreement_dt timestamp without time zone, placement_agreement_sw character, placement_id integer, placements_cd character varying, provider_id integer, relationship_cd character varying, relationship_info_cd character varying, schooling_cd character varying, siblings_seperated_cd character varying, subsidy_end_dt timestamp without time zone, subsidy_start_dt timestamp without time zone, suspension_begin_dt timestamp without time zone, suspension_end_date timestamp without time zone, suspension_id integer, suspension_reason_cd character varying, suspension_tx character varying, admin_approval_status_cd character varying, agreement_end_dt timestamp without time zone, agreement_start_dt timestamp without time zone, agreement_type_cd character varying, calculate_board_rate_sw character, child_medically_fragile_sw character, comments_tx character varying, court_hearing_id integer, designee_agreement_sw character, father_agreement_sw character, mother_agreement_sw character, negotiated_percentage_no numeric, payment_amount_no numeric, prim_basis_spl_needs_cd character varying, rate_overwritten_sw character, ssa_approval_dt timestamp without time zone, ssa_approval_sw character, subsidy_agreement_id integer, client_sw character, prefix_cd character varying, first_nm character varying, middle_nm character varying, last_nm character varying, suffix_cd character varying, dob_dt timestamp without time zone, approximate_age_no integer, ssn_no numeric, marital_status_cd character varying, gender_cd character varying, dod_dt timestamp without time zone, county_cd character varying, adr_cell_phone_tx character varying, adr_fax_tx character varying, adr_email_tx character varying, adr_pager_tx character varying, adr_home_phone_tx character varying, adr_work_phone_tx character varying, adr_work_xtn_tx character varying, adr_url_tx character varying, adr_other_contact_tx character varying, cis_client_id character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_pageNumber INT; 
 v_pageSize INT;
 v_pageNum INT; 
 v_pageOffset INT;
 
 v_clientId        INT;
 v_providerId       INT; 
 v_adoptionId           INT;
 v_providerName      character varying (50);
 v_clientName          character varying (50); 
 v_adoptionStartDtFrom  TIMESTAMP(3);                        
 v_adoptionStartDtTo  TIMESTAMP(3); 
 v_adoptionEndDtFrom  TIMESTAMP(3);                        
 v_adoptionEndDtTo      TIMESTAMP(3);   
 
 v_address        character varying (50);                        
 v_city           character varying (50);   
 v_zipCode        character varying (5);
 v_county        character varying (50);
 v_region        character varying (50);
 v_phoneNumber       character varying (10);
                        
 v_sortcol       character varying (50);
 v_sortdir       character varying (50);
            
 

BEGIN
 
 v_pageNumber := request ->> 'pagenumber';
 v_pageNum := v_pageNumber - 1;
 v_pageSize := request ->> 'pagesize';
 v_pageOffset = v_pageNum  * v_pageSize; 
 
 --raise notice 'v_pageSize: %', v_pageSize;
 --raise notice 'v_pageOffset: %', v_pageOffset;

 v_clientId       := request ->> 'clientid' ; 
 v_adoptionId          := request ->> 'adoptionid'; 
 v_clientName     := request ->> 'clientname' ; 
 v_providerId       := request ->> 'providerid';                           
 v_providerName      := request ->> 'providername';                                                                                      
 v_adoptionStartDtFrom := request ->> 'adoptionstartdatefrom';                                                     
 v_adoptionStartDtTo   := request ->> 'adoptionstartdateto';    
 v_adoptionEndDtFrom   := request ->> 'adoptionenddatefrom';                                                     
 v_adoptionEndDtTo     := request ->> 'adoptionenddateto';  
 v_address          := request ->> 'address';                                                     
 v_city             := request ->> 'city'; 
 v_zipCode          := request ->> 'zip';                       
 v_county          := request ->> 'county';                                                              
 v_region          := request ->> 'region';                                                     
 v_phoneNumber         := request ->> 'phonenumber';  

 v_sortcol    := request ->> 'sortcol';                                                     
 v_sortdir   := request ->> 'sortdir'; 
 
 
 IF v_adoptionStartDtTo IS NULL THEN
 v_adoptionStartDtTo := current_timestamp;
 END IF;
 IF v_adoptionEndDtTo IS NULL THEN
 v_adoptionEndDtTo := current_timestamp;
 END IF;
 
 
RETURN QUERY 
SELECT 
count(1)  over(),

-- TB_ADOPTION
adoption.addiction_cd                       AS addiction_cd,
adoption.adoption_granted_sw                AS adoption_granted_sw,
adoption.adoption_id                        AS adoption_id,
adoption.adoption_plan_begin_dt             AS adoption_plan_begin_dt,
adoption.adoption_subsidy_sw                AS adoption_subsidy_sw,
adoption.adoptive_case_creation_dt          AS adoptive_case_creation_dt,
adoption.adoptive_father_id                 AS adoptive_father_id,
adoption.adoptive_mother_id                 AS adoptive_mother_id,
adoption.adoptive_placement_status_cd       AS adoptive_placement_status_cd,
adoption.adoptive_placement_sw              AS adoptive_placement_sw,
adoption.agency_involvement_cd              AS agency_involvement_cd,
adoption.applicable_child_assess_cd         AS applicable_child_assess_cd,
adoption.applicable_child_cd                AS applicable_child_cd,
adoption.applicable_child_dt                AS applicable_child_dt,
adoption.approval_status_cd                 AS approval_status_cd,
adoption.attached_documents_tx              AS attached_documents_tx,
adoption.case_id                            AS case_id,
adoption.checklist_comments_tx              AS checklist_comments_tx,
adoption.chil_new_last_nm                   AS chil_new_last_nm,
adoption.child_health_cd                    AS child_health_cd,
adoption.child_living_sw                    AS child_living_sw,
adoption.child_new_first_nm                 AS child_new_first_nm,
adoption.child_new_middle_nm                AS child_new_middle_nm,
adoption.child_new_prefix_cd                AS child_new_prefix_cd,
adoption.child_new_suffix_cd                AS child_new_suffix_cd,
adoption.client_history_tx                  AS client_history_tx,
adoption.client_id                          AS client_id,
adoption.client_merge_id                    AS client_merge_id,
adoption.court_order_id                     AS court_order_id,
adoption.deeply_commited_cd                 AS deeply_commited_cd,
adoption.designee_agreement_dt              AS designee_agreement_dt,
adoption.disclosed_to_tx                    AS disclosed_to_tx,
adoption.disclosure_approval_status_cd      AS disclosure_approval_status_cd,
adoption.disclosure_dt                      AS disclosure_dt,
adoption.disclosure_non_staff_tx            AS disclosure_non_staff_tx,
adoption.disclosure_staff_id                AS disclosure_staff_id,
adoption.disruption_comments_tx             AS disruption_comments_tx,
adoption.disruption_dt                      AS disruption_dt,
adoption.dissolution_comments_tx            AS dissolution_comments_tx,
adoption.dissolution_dt                     AS dissolution_dt,
adoption.dss_custody_cd                     AS dss_custody_cd,
adoption.father_agreement_dt                AS father_agreement_dt,
adoption.finalization_dt                    AS finalization_dt,
adoption.health_cd                          AS health_cd,
adoption.legally_free_sw                    AS legally_free_sw,
adoption.ma_only_payment_cd                 AS ma_only_payment_cd,
adoption.medication_history_cd              AS medication_history_cd,
adoption.mother_agreement_dt                AS mother_agreement_dt,
adoption.only_subsidy_sw                    AS only_subsidy_sw,
adoption.placed_by_cd                       AS placed_by_cd,
adoption.placed_from_cd                     AS placed_from_cd,
adoption.placement_agreement_dt             AS placement_agreement_dt,
adoption.placement_agreement_sw             AS placement_agreement_sw,
adoption.placement_id                       AS placement_id,
adoption.placements_cd                      AS placements_cd,
adoption.provider_id                        AS provider_id,
adoption.relationship_cd                    AS relationship_cd,
adoption.relationship_info_cd               AS relationship_info_cd,
adoption.schooling_cd                       AS schooling_cd,
adoption.siblings_seperated_cd              AS siblings_seperated_cd,
adoption.subsidy_end_dt                     AS subsidy_end_dt,
adoption.subsidy_start_dt                   AS subsidy_start_dt,

--TB_ADOPTION_PAYMENT_SUSPENSION
--adoption_id,
--approval_status_cd,
adopPaySusp.suspension_begin_dt           AS suspension_begin_dt,
adopPaySusp.suspension_end_date            AS suspension_end_date,
adopPaySusp.suspension_id                AS suspension_id,
adopPaySusp.suspension_reason_cd          AS suspension_reason_cd,
adopPaySusp.suspension_tx                AS suspension_tx,

--TB_ADOPTION_AGREEMENT
adopAgreement.admin_approval_status_cd      AS admin_approval_status_cd,
--adopAgreement.adoption_id                 AS adoption_id,
adopAgreement.agreement_end_dt              AS agreement_end_dt,
adopAgreement.agreement_start_dt            AS agreement_start_dt,
adopAgreement.agreement_type_cd             AS agreement_type_cd,
--adopAgreement.approval_status_cd          AS approval_status_cd,
adopAgreement.calculate_board_rate_sw       AS calculate_board_rate_sw,
adopAgreement.child_medically_fragile_sw    AS child_medically_fragile_sw,
adopAgreement.comments_tx                   AS comments_tx,
adopAgreement.court_hearing_id              AS court_hearing_id,
adopAgreement.designee_agreement_sw         AS designee_agreement_sw,
adopAgreement.father_agreement_sw           AS father_agreement_sw,
adopAgreement.mother_agreement_sw           AS mother_agreement_sw,
adopAgreement.negotiated_percentage_no      AS negotiated_percentage_no,
adopAgreement.payment_amount_no             AS payment_amount_no,
adopAgreement.prim_basis_spl_needs_cd       AS prim_basis_spl_needs_cd,
--adopAgreement.provider_id                 AS provider_id,
adopAgreement.rate_overwritten_sw           AS rate_overwritten_sw,
adopAgreement.ssa_approval_dt               AS ssa_approval_dt,
adopAgreement.ssa_approval_sw               AS ssa_approval_sw,
adopAgreement.subsidy_agreement_id          AS subsidy_agreement_id,

--TB_CLIENT
client.client_sw                            AS  client_sw,             
client.prefix_cd                            AS  prefix_cd,             
client.first_nm                             AS  first_nm,              
client.middle_nm                            AS  middle_nm,             
client.last_nm                              AS  last_nm,               
client.suffix_cd                            AS  suffix_cd,            
client.dob_dt                               AS  dob_dt,                
client.approximate_age_no                   AS  approximate_age_no,    
client.ssn_no                               AS  ssn_no,                
client.marital_status_cd                    AS  marital_status_cd,     
client.gender_cd                            AS  gender_cd,             
client.dod_dt                               AS  dod_dt,                
client.county_cd                            AS  county_cd,             
client.adr_cell_phone_tx                    AS  adr_cell_phone_tx,     
client.adr_fax_tx                           AS  adr_fax_tx,            
client.adr_email_tx                         AS  adr_email_tx,          
client.adr_pager_tx                         AS  adr_pager_tx,          
client.adr_home_phone_tx                    AS  adr_home_phone_tx,     
client.adr_work_phone_tx                    AS  adr_work_phone_tx,     
client.adr_work_xtn_tx                      AS  adr_work_xtn_tx,       
client.adr_url_tx                           AS  adr_url_tx,            
client.adr_other_contact_tx                 AS  adr_other_contact_tx,  
--client.provider_id                          AS  provider_id           
client.cis_client_id                        AS  cis_client_id         

FROM tb_adoption AS adoption
INNER JOIN tb_adoption_payment_suspension AS adopPaySusp ON adoption.adoption_id = adopPaySusp.adoption_id
INNER JOIN tb_adoption_subsidy_agreement AS adopAgreement ON adopPaySusp.adoption_id = adopAgreement.adoption_id
INNER JOIN tb_client AS client ON adoption.client_id=client.client_id
WHERE CASE WHEN v_clientId IS NOT NULL THEN adoption.client_id = v_clientId ELSE TRUE END
AND   CASE WHEN v_providerId IS NOT NULL THEN adoption.provider_id = v_providerId ELSE TRUE END 
AND   CASE WHEN v_adoptionId IS NOT NULL THEN adoption.adoption_id = v_adoptionId ELSE TRUE END 
AND   CASE WHEN v_adoptionStartDtFrom IS NOT NULL THEN to_date(cast(adoption.subsidy_start_dt as TEXT), 'YYYY-MM-DD') 
  between to_date(cast(v_adoptionStartDtFrom as TEXT), 'YYYY-MM-DD') and to_date(cast(v_adoptionStartDtTo as TEXT), 'YYYY-MM-DD')  ELSE TRUE END
AND   CASE WHEN v_adoptionEndDtFrom IS NOT NULL THEN to_date(cast(adoption.subsidy_end_dt as TEXT), 'YYYY-MM-DD') 
  between to_date(cast(v_adoptionEndDtFrom as TEXT), 'YYYY-MM-DD') and to_date(cast(v_adoptionEndDtTo as TEXT), 'YYYY-MM-DD')  ELSE TRUE END
LIMIT v_pageSize OFFSET v_pageOffset;

 END;

$function$

