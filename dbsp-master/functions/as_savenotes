CREATE OR REPLACE FUNCTION as_savenotes(intakeserviceid uuid, v_intakenumber character varying, jsondata json, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE  

v_intakejson json;
j_notes json;
j_progressnoteroletype json;
j_history_progressnoteroletype json;
j_progressnotelist json;
i json;
j json;
k json;
v_progressnoteid uuid;
v_progressnotedetailid uuid;
v_intakeserviceid uuid;
v_progressnoteroletypeid uuid;
jsondata_history json;
j_notes_history json;
v_history_progressnoteid uuid;
v_history_progressnoteroletypeid uuid;

 
BEGIN
IF (intakeserviceid is null) THEN
v_intakeserviceid:= '00000000-0000-0000-0000-000000000000';
ELSE
v_intakeserviceid:= intakeserviceid;
END IF;

    For j_notes in Select * from json_array_elements(jsondata)
    LOOP

        -- RAISE NOTICE ' j_notes %',j_notes;  
     -- j_notes := i;
     j_progressnoteroletype := j_notes ->> 'progressnoteroletype';

     -- Notes All Inserted
   
     --  Progressnote Insert
     
     v_progressnoteid :=   gen_random_uuid();
     Insert Into progressnote (progressnoteid, progressnotetypeid, title, description, entitytype, entitytypeid, insertedby, updatedby, progressnotesubtypeid,
     contactdate, contactname, progressnotetypekey, activeflag, stafftypekey, instantresults, contactstatus, drugscreen, progressnotepurposetypekey,notesid )
     values (v_progressnoteid, cast(j_notes ->> 'progressnotetypeid' as uuid), cast(j_notes ->> 'description' as text), cast(j_notes ->> 'description' as text),
     'intakeservicerequest', v_intakeserviceid, v_securityuserid, v_securityuserid,
     cast(j_notes ->> 'progressnotesubtypeid' as uuid), cast(j_notes ->> 'contactdate' as timestamp without time zone),
     cast(j_notes ->> 'contactname' as character varying), cast(j_notes ->> 'progressnotetypekey' as character varying),1,
     cast(j_notes ->> 'stafftype' as character varying), cast(j_notes ->> 'instantresults' as integer), cast(j_notes ->> 'contactstatus' as boolean),
     cast(j_notes ->> 'drugscreen' as boolean), cast(j_notes ->> 'progressnotepurposetypekey' as character varying), cast(j_notes ->> 'notesid' as character varying));

     --  Progressnotedetail Insert
     
    /* v_progressnotedetailid :=   gen_random_uuid();
     Insert Into progressnotedetail (progressnotedetailid, progressnoteid, description, activeflag, insertedby, updatedby)
     Values (v_progressnotedetailid, v_progressnoteid, cast(j_notes ->> 'description' as text), 1, v_securityuserid, v_securityuserid); */ -- Comment by 

     --  Progressnoteroletype Insert
    
     For j in Select * from json_array_elements(j_progressnoteroletype)
     LOOP
      v_progressnoteroletypeid :=   gen_random_uuid();
      Insert Into progressnoteroletype (progressnoteroletypeid, progressnoteid, contactroletypekey, activeflag, insertedby,updatedby)
      values (v_progressnoteroletypeid, v_progressnoteid, cast(j ->> 'contactroletypekey' as character varying),1, v_securityuserid, v_securityuserid);
     
     END LOOP;
     
      -- Notes All Inserted History Data
   jsondata_history := j_notes ->> 'histories';
   
   For j_notes_history in Select * from json_array_elements(jsondata_history)
         LOOP
      j_history_progressnoteroletype := j_notes_history ->> 'progressnoteroletype';
      
               --  Progressnote History Insert      
      v_history_progressnoteid :=   gen_random_uuid();
      Insert Into progressnote (progressnoteid, progressnotetypeid, title, description, entitytype, entitytypeid, insertedby, updatedby, progressnotesubtypeid,
      contactdate, contactname, progressnotetypekey, activeflag, stafftypekey, instantresults, contactstatus, drugscreen, progressnotepurposetypekey,notesid )
      values (v_history_progressnoteid, cast(j_notes_history ->> 'progressnotetypeid' as uuid), cast(j_notes_history ->> 'description' as text), cast(j_notes_history ->> 'description' as text),
      'intakeservicerequest', v_intakeserviceid, v_securityuserid, v_securityuserid,
      cast(j_notes_history ->> 'progressnotesubtypeid' as uuid), cast(j_notes_history ->> 'contactdate' as timestamp without time zone),
      cast(j_notes_history ->> 'contactname' as character varying), cast(j_notes_history ->> 'progressnotetypekey' as character varying),0,
      cast(j_notes_history ->> 'stafftype' as character varying), cast(j_notes_history ->> 'instantresults' as integer), cast(j_notes_history ->> 'contactstatus' as boolean),
      cast(j_notes_history ->> 'drugscreen' as boolean), cast(j_notes_history ->> 'progressnotepurposetypekey' as character varying), cast(j_notes_history ->> 'notesid' as character varying));
      
      --  Progressnoteroletype History Insert
    
        For k in Select * from json_array_elements(j_history_progressnoteroletype)
        LOOP
      v_history_progressnoteroletypeid :=   gen_random_uuid();
      Insert Into progressnoteroletype (progressnoteroletypeid, progressnoteid, contactroletypekey, activeflag, insertedby,updatedby)
      values (v_history_progressnoteroletypeid, v_history_progressnoteid, cast(k ->> 'contactroletypekey' as character varying),0, v_securityuserid, v_securityuserid);
     
       END LOOP;
   
   END LOOP;
   

    END LOOP;
    
   
 
 Return 'Success';
 
END;

$function$

