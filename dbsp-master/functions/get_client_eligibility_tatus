CREATE OR REPLACE FUNCTION get_client_eligibility_tatus(v_client_id integer, v_case_id bigint)
 RETURNS TABLE(eligibility_id integer, eligibility_type_cd character varying, eligibility_status_cd character varying, start_dt date, end_dt date)
 LANGUAGE plpgsql
AS $function$

declare total_count bigint;
 
BEGIN 

 select count(1) 
  into total_count 
 from tb_client_eligibility tce 
 where tce.client_id = v_client_id
  and tce.case_id = v_case_id 
  and tce.delete_sw ='N' ;

 if(total_count > 0)
 then
  return query
  select tce.eligibility_id,
   tce.eligibility_type_cd,
   btrim(tce.eligibility_status_cd)::character varying as eligibility_status_cd,
   tce.start_dt,tce.end_dt 
  from tb_client_eligibility tce 
  where tce.client_id = v_client_id
   and tce.case_id = v_case_id 
   and tce.delete_sw = 'N' 
  order by tce.start_dt desc; 
  
 else 
  return query
  select 0 as eligibility_id,
   null::character varying eligibility_type_cd,
   '2914'::character varying eligibility_status_cd,
   now():: date start_dt,
   now():: date end_dt ;
  --'3952'
    end if;
END;

$function$

