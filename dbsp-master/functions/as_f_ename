CREATE OR REPLACE FUNCTION as_f_ename(as_user_id character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

 
BEGIN
return
      (SELECT COALESCE (firstname || ' ','') || 
    COALESCE (middlename || ' ','') || 
    COALESCE (lastname || ' ','') || 
    COALESCE (F_PDESC(suffix_cd,214),'') 
   from userprofile
   where user_id = f_ename.as_user_id and delete_sw = 'N');

END;
 

$function$

