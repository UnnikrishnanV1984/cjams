CREATE OR REPLACE FUNCTION as_updatedatavaluemethod()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE dateval bigint;
begin
   RAISE NOTICE 'sequencenumber: %', new."sequencenumber";

   dateval  :=new."sequencenumber";

   update providernonagreementtype set "datavalue" =dateval where "sequencenumber"=dateval;
   
return new;
end;
$function$

