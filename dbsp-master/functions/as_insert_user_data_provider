AS $function$
DECLARE
 l_securityusersid uuid;
 l_muser_id int;
 l_rolemapping_id int;
 l_role_id int;
 l_message text;
begin
select gen_random_uuid() into l_securityusersid; 
select id into l_role_id from role where name=rolenamex;
