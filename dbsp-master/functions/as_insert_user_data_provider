select nextval('rolemapping_id_seq'::regclass) into l_rolemapping_id;
INSERT INTO rolemapping
(id, principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id)
VALUES(l_rolemapping_id, 'USER', l_muser_id, l_role_id, 1, 'admin', 'admin', now(), now(), NULL);
