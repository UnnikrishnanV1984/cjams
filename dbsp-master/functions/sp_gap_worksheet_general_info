CREATE OR REPLACE FUNCTION sp_gap_worksheet_general_info(al_client_id bigint, al_removal_id bigint)
 RETURNS TABLE(client_id bigint, dateoffullapprovalfp date, primaryguardianisrelative character varying, primaryguardianrelationshipid integer, primaryguardianrelationship character varying, secondaryguardianisrelative character varying, secondguardianrelationshipid integer, secondguardianrelationship character varying, latestfcplacementstartdatewithperpectiveguardian timestamp without time zone, guardianshipapplicationdate timestamp without time zone, isconsultationchildage character varying, isguardianattach character varying, ischildsecondguardianattach character varying, isreunificationremoved character varying, isadoptionremoved character varying, iscgprovidesafe character varying, childagency character varying, fosterhomeapprover character varying, secondguardianexists boolean, secguardlivingwithpriguard character varying, successorguardianexists boolean, successorguardianname character varying, successorguardianid integer, dateofsuccessionaddendum timestamp without time zone, gapeligibilitystatus character varying, placementid uuid, removalcourtorderdate timestamp without time zone, childremovedbyvpa character varying, last6monthfiscalpaymentstatus character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm             VARCHAR(100) DEFAULT 'sp_gap_worksheet_summary_info';
  vd_full_apprvl_fp_dt           DATE;
  vs_pri_is_rltv             VARCHAR(20);       
  vn_pri_rltn_id             INTEGER;
  vs_pri_rltn              VARCHAR(200);
  vs_sec_is_rltv             VARCHAR(20);
  vn_sec_rltn_id             INTEGER;
  vs_sec_rltn              VARCHAR(200);
  vd_ltst_fc_plcmt_st_dt_with_grd         TIMESTAMP;
  vd_grd_appl_dt             TIMESTAMP;
     vs_age_appr_cnslt_pl            VARCHAR(20);
     vs_chd_grd_attch             VARCHAR(20);
     vs_chd_sec_grd_attch           VARCHAR(20);
     vs_reunfn_rmvd              VARCHAR(20);
     vs_adp_rmvd                 VARCHAR(20);
  vs_iscgprovidesafe             VARCHAR(20);
  vs_chd_agcy              VARCHAR(50);
   vs_fstr_hm_aprvr             varchar(50);
   vs_scnd_grd_exts             boolean;
  vs_sec_grd_lvng_with_pri_grd          varchar(25);
  vs_suc_grd_exts             boolean;
  vs_succ_grdn_nm             VARCHAR(250);
  vn_succ_grdn_id             INTEGER;
  vd_succ_adndm_dt            TIMESTAMP;
  vs_gap_elig_sts             VARCHAR(50);
  vd_placementid                                            UUID;
  vd_child_rmvl_crt_ord_dt          TIMESTAMP;
  vs_chld_rmvd_vpa            VARCHAR(20);
  vs_lst_6_mnth_pymnt_stus          VARCHAR(20);
 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_general_info ( 
  client_id              BIGINT,
  dateoffullapprovalfp          DATE,
  primaryguardianisrelative         VARCHAR(20),
  primaryguardianrelationshipid        INTEGER,
  primaryguardianrelationship         VARCHAR(200),
  secondaryguardianisrelative         VARCHAR(20),
  secondguardianrelationshipid        INTEGER,
  secondguardianrelationship         VARCHAR(200),
  latestfcplacementstartdatewithperpectiveguardian   TIMESTAMP,
  guardianshipapplicationdate         TIMESTAMP,
  isconsultationchildage                        VARCHAR(20),
  isguardianattach                              VARCHAR(20),
  ischildsecondguardianattach                           VARCHAR(20),
  isreunificationremoved                        VARCHAR(20),
  isadoptionremoved                            VARCHAR(20),
  iscgprovidesafe             VARCHAR(20),
     childagency                VARCHAR(50),
     fosterhomeapprover             varchar(50),
     secondguardianexists           boolean,
  secguardlivingwithpriguard          varchar(25),
  successorguardianexists          boolean,
  successorguardianname          VARCHAR(250),
  successorguardianid           INTEGER,
  dateofsuccessionaddendum         TIMESTAMP,
  gapeligibilitystatus          VARCHAR(50),
  placementid                                               UUID,
  removalcourtorderdate          TIMESTAMP,
  childremovedbyvpa           VARCHAR(20),
  last6monthfiscalpaymentstatus        VARCHAR(20)
 ); 

vs_lst_6_mnth_pymnt_stus = 'YES';

-- Foster Home Approver                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
select (CASE when tp.picklist_value_cd = '1782' then 'CPS' else 'LDSS' end) 
 into vs_fstr_hm_aprvr 
from tb_provider_picklist tp, tb_guardian_subsidy ts, tb_client_eligibility te
 where tp.provider_id = ts.provider_id and tp.picklist_type_id = 155 
 and ts.guardian_subsidy_id = te.guardian_subsidy_id and te.client_id = al_client_id
 order by ts.update_ts desc limit 1;


-- Second Guardian Exists  / Guardian Two living with Primary Guardian / Successor Guardian Name / Successor Guardian ID / Succession Addendum Date / Successor Guardian Exists                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
select (case when (grd.guardiantwoid is null) then 'NO'::varchar else 'YES'::varchar end ) , 
(case when (grd.guardiantwoproviderid is not null) then true else false end ),
grd.successorguardianname , grd.successorguardianid, grd.successionaddendumdate,
( CASE WHEN (grd.successorguardianname IS NOT NULL) THEN true ELSE false END )
into vs_sec_grd_lvng_with_pri_grd , vs_scnd_grd_exts , vs_succ_grdn_nm , vn_succ_grdn_id , vd_succ_adndm_dt, vs_suc_grd_exts
from guardianship grd, intakeservicerequestactor isra, person per
where grd.servicecaseid = isra.servicecaseid and grd.activeflag = 1
and isra.intakeservicerequestpersontypekey in ('CHILD', 'OTHERCHILD') and isra.activeflag = 1
and per.personid = isra.personid and per.cjamspid::bigint = al_client_id
and per.activeflag = 1 order by grd.updatedon desc limit 1;
 

-- gap eligibility status
SELECT taer.eligibilitystatus
 INTO vs_gap_elig_sts
   FROM tb_ive_gapaudit ga, tb_audit_eligibility_result taer
WHERE ga.gapauditid = taer.gapauditid AND ga.category = 'I' 
 AND taer.client_id::BIGINT = al_client_id ORDER BY taer.updatedon DESC LIMIT 1;

--- Placement ID
SELECT pl.placementid into vd_placementid
  from placement pl join intakeservreqchildremoval isrcr on pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid and isrcr.activeflag =1 
  where pl.activeflag = 1 and isrcr.removalid::bigint = al_removal_id
limit 1;

-- Child Removed By VPA 
SELECT (CASE WHEN typeofremoval = 'Voluntary_Placement_Agreement'
   THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END)  INTO vs_chld_rmvd_vpa 
FROM  tb_ive_fostercare_audit
WHERE  cjamspid = al_client_id;

-- Removal Court Order Date
if vs_chld_rmvd_vpa = 'NO' then 
SELECT courtorderremovaldate  INTO vd_child_rmvl_crt_ord_dt 
FROM  tb_ive_fostercare_audit
WHERE  cjamspid = al_client_id and typeofremoval = 'Court_Order';
ELSE
SELECT vparemovaldate  INTO vd_child_rmvl_crt_ord_dt 
FROM  tb_ive_fostercare_audit
WHERE  cjamspid = al_client_id and typeofremoval = 'Voluntary_Placement_Agreement';
end if;

-- Foster Parent Full Approval Date  
SELECT tpa.approval_dt
 INTO vd_full_apprvl_fp_dt
   FROM tb_provider_approval tpa, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tpl, intakeservicerequestactor isra, person per     
WHERE tpa.provider_id = grd.guardianoneproviderid AND grd.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1 
   AND tpl.case_id = sc.servicecasenumber::BIGINT AND tpl.delete_sw = 'N' AND tpl.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tpl.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY tpa.update_ts DESC LIMIT 1;

-- Primary Guardian Relationship ID /-- Primary Guardian Relationship 
SELECT rt.fourerelid , rt.description::VARCHAR , 
 (case 
  when rt.fourerelid = '1001' then 'YES'
  when rt.fourerelid = '1014' then 'YES'
  else 'NO'
   end)     
 INTO vn_pri_rltn_id , vs_pri_rltn , vs_pri_is_rltv
   FROM 
 guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per , relationshiptype rt
 WHERE grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1 AND grd.activeflag = 1
 AND lower(rt.relationshiptypekey) = lower(grd.primaryrelationshipkey) 
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1 AND isra.servicecaseid = sc.servicecaseid
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ;
  
-- Secondary Guardian Relationship ID /Secondary Guardian Relationship
SELECT rt.fourerelid , rt.description::VARCHAR , 
 (case 
  when rt.fourerelid = '1001' then 'YES'
  when rt.fourerelid = '1014' then 'YES'
  else 'NO'
   end)  
 INTO vn_sec_rltn_id , vs_sec_rltn , vs_sec_is_rltv
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per , relationshiptype rt
WHERE grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1 AND grd.activeflag = 1
 AND lower(rt.relationshiptypekey) = lower(grd.secondaryrelationshipkey)
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1 AND isra.servicecaseid = sc.servicecaseid
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ;

-- Child Agency
SELECT (CASE WHEN teamtypekey = 'CW' THEN
    'DHS'::VARCHAR 
   WHEN teamtypekey = 'DJS' THEN
    'DJS'::VARCHAR
   ELSE NULL END)
 INTO vs_chd_agcy  
FROM intakeservicerequest isr join intakeservreqchildremoval isrcr on (isrcr.intakeserviceid = isr.intakeserviceid or isrcr.servicecaseid = isr.servicecaseid)  
WHERE isr.activeflag = 1 AND isr.activeflag = 1 AND isrcr.removalid::BIGINT = al_removal_id;

SELECT pl.startdatetime INTO vd_ltst_fc_plcmt_st_dt_with_grd FROM person p
 INNER JOIN intakeservicerequestactor isra ON isra.personid = p.personid AND p.activeflag= 1
 INNER JOIN placement pl ON pl.servicecaseid = isra.servicecaseid AND pl.activeflag = 1
 INNER JOIN guardianship gs ON gs.servicecaseid = isra.servicecaseid AND gs.guardianoneproviderid = pl.altproviderid AND gs.activeflag = 1
WHERE p.cjamspid::BIGINT = al_client_id ORDER BY pl.startdatetime DESC LIMIT 1;

-- Guardian Application Date 
SELECT gdis.disclosuredate
 INTO vd_grd_appl_dt
   FROM gapdisclosure gdis, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE gdis.gapid = grd.gapid AND gdis.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;
 

 -- Age Appropriate Consult Place
-- Child Guardian Attachment
 -- Child Second Guardian Attachment  
 -- Appropriate Permanency For Child For Not Being Returned Home      
  -- Appropriate Permanency For Child For Being Adopted
 SELECT ( CASE WHEN (gdis.isconsultationchildage = 'true')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ),
( CASE WHEN (gdis.isguardianattach = 'true')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                                 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ),
( CASE WHEN (gdis.isguardiantwoattach = 'true')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                                 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ),
( CASE WHEN (gdis.isreunificationremoved = 'true')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ),
( CASE WHEN (gdis.isadoptionremoved = 'true')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
                                 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ),
( CASE WHEN (gdis.iscgprovidesafe = 'true')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
                                 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END )                 
into vs_age_appr_cnslt_pl , vs_chd_grd_attch, vs_chd_sec_grd_attch, vs_reunfn_rmvd, vs_adp_rmvd, vs_iscgprovidesafe
         FROM gapdisclosure gdis, guardianship grd, intakeservicerequestactor isra, person per                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
 WHERE gdis.gapid = grd.gapid AND gdis.activeflag = 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
         AND grd.servicecaseid = isra.servicecaseid AND grd.activeflag = 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
         AND isra.intakeservicerequestpersontypekey in ('CHILD', 'OTHERCHILD') AND isra.activeflag = 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
         AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 LIMIT 1;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
 
INSERT INTO Temp_worksheet_general_info
SELECT 
  al_client_id,
  vd_full_apprvl_fp_dt,
  vs_pri_is_rltv,
  vn_pri_rltn_id,
  vs_pri_rltn,
  vs_sec_is_rltv,
  vn_sec_rltn_id,
  vs_sec_rltn,
  vd_ltst_fc_plcmt_st_dt_with_grd,
  vd_grd_appl_dt,
  vs_age_appr_cnslt_pl,
  vs_chd_grd_attch,
  vs_chd_sec_grd_attch,
  vs_reunfn_rmvd,
  vs_adp_rmvd,
  vs_iscgprovidesafe,
  vs_chd_agcy,
  case when (vs_fstr_hm_aprvr is null) then 'LDSS'::varchar else vs_fstr_hm_aprvr end,
  vs_scnd_grd_exts,
  vs_sec_grd_lvng_with_pri_grd,
  vs_suc_grd_exts,
  vs_succ_grdn_nm,
  vn_succ_grdn_id,
  vd_succ_adndm_dt,
  vs_gap_elig_sts,
  vd_placementid,
  vd_child_rmvl_crt_ord_dt,
  vs_chld_rmvd_vpa,
  vs_lst_6_mnth_pymnt_stus;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_general_info;
              
DROP TABLE Temp_worksheet_general_info;

END
$function$

