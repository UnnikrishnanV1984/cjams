CREATE OR REPLACE FUNCTION as_getlegalcustody(v_personid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE l_legalcustody json;

BEGIN
 

 IF ( v_personid is not null ) THEN  
  RAISE  NOTICE  'v_personid>>>>>>>>>>>%',v_personid;   
SELECT json_agg(legalcustody) INTO l_legalcustody FROM (
SELECT lc.legalcustodyid, lc.servicecaseid, lc.intakeservicerequestactorid,lc.permanencyplanid,
       lc.legalcustodytypekey, lc.reason, lc.fromdate, lc.todate, pn.personid, arp.relationshiptypekey,
    padd.address As personaddress, (pn.firstname || ' ' || pn.lastname) As personname, ppn.phonenumber,
 (SELECT  json_agg(legalcustodydetail)  AS  legalcustodydetail  FROM  (
      SELECT lcy.legalcustodytypekey, rv.description FROM legalcustody lcy
   INNER JOIN referencevalues rv ON rv.ref_key = lcy.legalcustodytypekey AND rv.activeflag =1 AND lcy.activeflag =1
   WHERE lcy.legalcustodyid = lc.legalcustodyid               
 )  legalcustodydetail)
FROM legalcustody lc
INNER JOIN person pn ON pn.personid = lc.personid AND pn.activeflag = 1
INNER JOIN intakeservicerequestactor isra ON isra.personid = lc.personid AND isra.activeflag =1 
LEFT JOIN actorrelationship arp ON arp.intakeservicerequestactorid = isra.intakeservicerequestactorid AND arp.activeflag =1
LEFT JOIN personphonenumber ppn ON ppn.personid = pn.personid AND ppn.activeflag =1
LEFT JOIN (SELECT max(personaddressid:: character varying) personaddressid, personid FROM personaddress
  WHERE personaddresstypekey = 'C' AND activeflag =1 GROUP BY personid) pa 
     ON pa.personid = pn.personid
LEFT JOIN personaddress padd ON padd.personaddressid:: character varying = pa.personaddressid
WHERE isra.intakeservicerequestactorid =  v_personid
) AS legalcustody;

RETURN l_legalcustody;     

end if;


end;

$function$

