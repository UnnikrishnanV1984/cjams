CREATE OR REPLACE FUNCTION f_servicename(al_service_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN
RETURN

        ( SELECT distinct 
     CASE 
             WHEN structure_service_cd = 'S' AND service_category_cd IS not null THEN 
      f_plvalue(service_category_cd,1196) || '/' || service_nm ELSE SERVICE_NM
          END AS "S_NAME"  
          FROM TB_SERVICES  
          WHERE DELETE_SW = 'N' AND service_id = al_service_id )
;
 
END

$function$

