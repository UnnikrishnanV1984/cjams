CREATE OR REPLACE FUNCTION as_userresourcelist(v_securityusersid character varying)
 RETURNS TABLE(id integer, name character varying, description character varying, roletypekey character varying)
 LANGUAGE plpgsql
AS $function$

begin

Return query

select r.id,r.name,r.description,r.roletypekey
from role r
join userresource ur on ur.roleid = r.id and ur.activeflag = 1
join muser mu on mu.id = ur.userid and mu.activeflag = 1
where mu.securityusersid = v_securityusersid
and r.activeflag = 1
union
select r.id,r.name,r.description,r.roletypekey
from role r
join rolemapping rm on rm.roleid = r.id and rm.activeflag = 1
join muser mu on mu.id = rm.principalid::bigint and mu.activeflag = 1
where r.activeflag = 1 and mu.securityusersid = v_securityusersid;

end;
$function$

