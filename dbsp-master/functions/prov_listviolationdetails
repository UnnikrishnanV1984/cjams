CREATE OR REPLACE FUNCTION prov_listviolationdetails(v_providerid integer, p_status character varying, pagenumber integer, pagelimit integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
 DECLARE                                                                                                                                                                                                                                                                                                           
 v_pageoffset int;                                                                                                                                                                                                                                                                                                 
 v_pagenumber int;                                                                                                                                                                                                                                                                                                 
 v_pagelimit int;                                                                                                                                                                                                                                                                                                  
 v_limit int;                                                                                                                                                                                                                                                                                                      
  totalcount integer;                                                                                                                                                                                                                                                                                              
              v_result json;                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                   
  BEGIN                                                                                                                                                                                                                                                                                                            
  v_limit=pagelimit;                                                                                                                                                                                                                                                                                               
  v_pagenumber := pageNumber-1;                                                                                                                                                                                                                                                                                 
  v_pageoffset = v_pagenumber * v_limit;                                                                                                                                                                                                                                                                        

--   SELECT JSON_AGG(pla) into v_result FROM 
-- (select distinct(reference_value_id),referencetype,cap_status,
--  (case (referencetype) 
--      when 'Monitoring' then (select date(monitoring_dt)::text||'-'||date(end_dt)::text from prov_monitoring where monitoring_id=pv.reference_value_id) 
--      when 'Complaints' then (select date(complaint_date)::text from tb_provider_complaint where complaint_number=pv.reference_value_id) 
--   end ) as receiveddate
--  from prov_violation pv
--  where pv.provider_id=v_providerid   
-- ) pla;

 SELECT JSON_AGG(pla) into v_result FROM 
 (select reference_value_id,referencetype,
  (select json_agg(deta) from 
      (select
   (case (referencetype) 
       when 'Monitoring' then (select date(monitoring_dt)::text||'-'||date(end_dt)::text from prov_monitoring where monitoring_id=pv.reference_value_id) 
       when 'Complaints' then (select date(complaint_date)::text from tb_provider_complaint where complaint_number=pv.reference_value_id) 
     end ) as receiveddate,
   (case (referencetype) 
       when 'Monitoring' then (select periodic from prov_monitoring where monitoring_id=pv.reference_value_id) 
       when 'Complaints' then (select complaint_status from tb_provider_complaint where complaint_number=pv.reference_value_id) 
     end ) as compstatus
   from prov_violation pvr where pvr.reference_value_id=pv.reference_value_id 
   limit 1
     ) deta) violationdetails
  from prov_violation pv
  where pv.provider_id=v_providerid
  group by reference_value_id,referencetype
  ) pla;
return v_result;

END;

$function$

