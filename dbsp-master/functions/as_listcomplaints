CREATE OR REPLACE FUNCTION as_listcomplaints(v_intakenumber character varying)
 RETURNS TABLE(intakeservicerequestevaluationid uuid, complaintid character varying, arrestdate timestamp without time zone, isdetention boolean, complaintreceiveddate timestamp without time zone, zipcode integer, offensedate timestamp without time zone, countyname character varying, evaluationsourcetypekey character varying, sourcetype character varying, evaluationsourceagencykey character varying, sourceagency character varying, offenselocation character varying, offenses json, victims json, lawenforcement json, isotheroffense boolean, otheroffensetext character varying, countyid uuid, evaluationsourcetypeid uuid, evaluationsourceagencyid uuid, offencelocationtypekey character, yearsofage integer, dateunknown boolean, daterange boolean, begindate timestamp without time zone, enddate timestamp without time zone, countycode character varying, evaluationsourceid uuid, ismcasp boolean, ispeaceorder boolean, peaceordernotes text, intakeservicerequestpetitionid uuid)
 LANGUAGE plpgsql
AS $function$

begin

Return query

select isre.intakeservicerequestevaluationid,isre.complaintid,isre.arrestdate,isre.isdetention,isre.complaintreceiveddate,isre.zipcode,isre.offensedate,c.countyname,
est.evaluationsourcetypekey,est.description as sourcetype,esa.evaluationsourceagencykey,esa.description as sourceagency,olt.description
, (select json_agg(ad) from (select isrec.intakeservicerequestevaluationconfigid,alg.name,alg.allegationid  
from allegation alg 
inner join intakeservicerequestevaluationconfig isrec on alg.allegationid = isrec.allegationid and isrec.activeflag = 1
where alg.activeflag = 1 and isrec.intakeservicerequestevaluationid = isre.intakeservicerequestevaluationid) as ad) as offenses
, (select json_agg(pa) from (select isac.intakeservreqevalactorconfigid,pn.firstname,pn.lastname,pn.dob,pn.personid 
 from intakeservreqevalactorconfig isac 
join person pn on pn.personid = isac.personid  where isac.intakeservicerequestevaluationid = isre.intakeservicerequestevaluationid and pn.activeflag = 1)as pa) as victims
, (select json_agg(es) from (select esrc.title,esrc.badgeno,esrc.firstname,esrc.lastname,esrc.streetno,esrc.street1,esrc.street2 
from EvaluationSource esrc where esrc.evaluationsourceid = isre.evaluationsourceid ) as es) as lawenforcement,isre.isotheroffense,isre.otheroffensetext,
c.countyid,est.evaluationsourcetypeid,esa.evaluationsourceagencyid,olt.offencelocationtypekey,isre.yearsofage::int,
(case when isre.unknownrange = 1 then true else false end) as dateunknown,(case when isre.unknownrange = 2 then true else false end) as daterange,
isre.begindate,isre.enddate,c.countycode,isre.evaluationsourceid,isre.ismcasp,isre.ispeaceorder,isre.peaceordernotes,isec.intakeservicerequestpetitionid
from intakeservicerequestevaluation isre  
left join intakeservreqevalactorconfig isac on isre.intakeservicerequestevaluationid = isac.intakeservicerequestevaluationid 
and isac.activeflag = 1
left join person P on P.personid = isac.personid and P.activeflag = 1
join county c on isre.countyid = c.countyid and c.activeflag = 1
left join evaluationsourcetype est on est.evaluationsourcetypeid = isre.evaluationsourcetypeid and est.activeflag = 1
left join evaluationsourceagency esa on esa.evaluationsourceagencyid = isre.evaluationsourceagencyid and esa.activeflag = 1
left join intakeservreqevalpetitionconfig isec on isec.intakeservicerequestevaluationid = isre.intakeservicerequestevaluationid and isec.activeflag = 1
join offencelocationtype olt on olt.offencelocationtypekey = isre.offencelocationtypekey and olt.activeflag = 1
where isre.intakenumber = v_intakenumber and isre.activeflag = 1;

end;

$function$

