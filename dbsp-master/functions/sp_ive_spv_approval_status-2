CREATE OR REPLACE FUNCTION sp_ive_spv_approval_status(approval_id uuid, approval_status character varying, v_placementtype character varying, pagenumber bigint, pagesize bigint, approved_user character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare
v_approval_id uuid;
v_approval_status character varying;
v_picklist_value_cd character varying;
v_client_id bigint;
v_eligibility_id integer;
v_approved_user CHARACTER VARYING;

begin
v_approval_id = approval_id;
v_approval_status = approval_status;
v_approved_user = approved_user;
------------------------------------foster care-----------------------------------------
if(v_placementtype = 'Fostercare') then

UPDATE tb_eligibility_period tep SET tep.approvalstatus = v_approval_status, tep.approvedby = v_approved_user ,tep.approvedon = now()   where tep.approvalid = v_approval_id::varchar returning tep.eligibility_id, tep.status_cd into v_eligibility_id, v_picklist_value_cd;

UPDATE tb_client_eligibility tce SET tce.eligibility_status_cd=v_picklist_value_cd, tce.update_ts = now() WHERE tce.eligibility_id=v_eligibility_id;

------------------------------------Gap-----------------------------------------
elseif(v_placementtype = 'Gap') then

UPDATE tb_eligibility_period tep SET tep.approvalstatus = v_approval_status, tep.approvedby = v_approved_user ,tep.approvedon = now() where tep.approvalid = v_approval_id::varchar returning tep.eligibility_id, tep.status_cd into v_eligibility_id, v_picklist_value_cd;

UPDATE tb_client_eligibility tce SET tce.eligibility_status_cd=v_picklist_value_cd, tce.update_ts = now() WHERE tce.eligibility_id=v_eligibility_id;

------------------------------------Adoption-----------------------------------------
elseif(v_placementtype = 'Adoption') then

UPDATE tb_eligibility_period tep SET tep.approvalstatus = v_approval_status, tep.approvedby = v_approved_user ,tep.approvedon = now() where tep.approvalid = v_approval_id::varchar returning tep.eligibility_id, tep.status_cd into v_eligibility_id, v_picklist_value_cd;

UPDATE tb_client_eligibility tce SET tce.eligibility_status_cd=v_picklist_value_cd, tce.update_ts = now() WHERE tce.eligibility_id=v_eligibility_id;

elseif(v_placementtype = 'Adoptionapplicability') then

UPDATE tb_ive_adoption_audit tiaa SET  approvalstatus=v_approval_status where approvalid = v_approval_id returning tiaa.cjamspid into v_client_id;

UPDATE adoptionapplicabilityinfo SET  ivestatus = v_approval_status where clientid = v_client_id;

end if;
return 'success';
end
 $function$

