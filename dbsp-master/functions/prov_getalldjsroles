CREATE OR REPLACE FUNCTION prov_getalldjsroles(v_userid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
v_data json;
 
BEGIN 

if (v_userid IS NOT NULL) THEN 
  select array_to_json(array_agg(row_to_json(t)))
  from (
  select count(1) over() as totalcount, a.* from (
            select distinct 'OLMDJS' as teamtypekey, r.name , r.id , r.description
            from  role r  
            where r.id in (
                            5970,
                            5971,
                            5972,
                            5973,
                            5974,
                            5975,
                            5976,
                            4556,
                            4557,
                            -- 5980,
                            -- 5981,
                            -- 5982,
                            4558,
                            4559
                            )
            UNION ALL
            select distinct 'RESDJS' as teamtypekey, r.name , r.id , r.description
            from  role r  
            where r.id in (
                            5980,
                            5981,
                            5982
                            )
             ) a
            order by a.id 
  ) t into v_data;
END IF;

return v_data;
END;

$function$

