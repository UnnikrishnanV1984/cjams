CREATE OR REPLACE FUNCTION as_namrs_getinvestigationfindings_as(caseno character varying)
 RETURNS TABLE(cjamspid character varying, age integer, gendertypekey integer, racetypekey character varying, ethnicgrouptypekey integer, investigationfinding integer, allegation integer)
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_intakeserviceid uuid;
v_intakeservreqtypekey character varying;
v_intakenumber character varying;
v_cjamspid bigint;
v_personid uuid;
v_allegationlist text;

BEGIN
  

 
RETURN QUERY  


(
select f_afcars_encrypt(p.cjamspid:: character varying),
date_part('year',age(p.dob)) :: integer,
case when p.gendertypekey in ('M') then 1 when p.gendertypekey in ('F') then 2 when p.gendertypekey in ('TG','TGIM','TGIF') then 3 else 0 end,
p.racetypekey,
case p.ethnicgrouptypekey when 'H' then 10 else 20 end,
(case when i.investigationfindingtypekey = 'ID' then 1 when i.investigationfindingtypekey ='RO' then 2 when i.investigationfindingtypekey ='UD' then 3 when i.investigationfindingtypekey ='UC' then 4 
end) as investigationfinding,
--(case when a."name" = 'Financial Exploitation' then 31 when a."name" = 'Neglect by Others' then 40 when a."name" = 'Physical Abuse' then 50  when a."name" = 'Sexual Abuse/Exploitation' then 60 when a."name" = 'Self-Neglect' then 80 end) as allegation,
80 as allegation
from investigationfinding i 
inner join person p on p.personid =i.personid 
inner join investigationallegation ia on ia.investigationallegationid =i.investigationallegationid and ia.activeflag =1
inner join investigation inv on inv.investigationid = ia.investigationid and inv.activeflag =1
inner join intakeservicerequest isr on isr.intakeserviceid =inv.intakeserviceid 
inner join allegation a on a.allegationid = ia.allegationid 
where isr.servicerequestnumber = caseno and i.activeflag =1 and
(a."name" ='Self-Neglect' or ia.allegationid ='00000000-0000-0000-0000-000000000000') order by i.insertedon desc limit 1)

