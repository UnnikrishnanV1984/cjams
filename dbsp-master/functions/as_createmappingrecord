CREATE OR REPLACE FUNCTION as_createmappingrecord(v_objectid character varying, v_casenumber character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare
  l_cisrefid character varying;
BEGIN
   IF EXISTS (SELECT * FROM cjamscisref WHERE casenumber::character varying=v_casenumber::character varying or objectid::character varying = v_objectid::character varying ) then
      select cisrefid into l_cisrefid from cjamscisref WHERE casenumber::character varying=v_casenumber::character varying or objectid::character varying = v_objectid::character varying;
      RAISE NOTICE 'Iam exi (%)', l_cisrefid;
   ELSE 
     INSERT INTO cjamscisref (casenumber,objectid)
     VALUES(v_casenumber,v_objectid::uuid)
     returning "cisrefid"::character varying  INTO l_cisrefid; 
     RAISE NOTICE 'Iam not (%)', l_cisrefid;
      END IF;
      return  l_cisrefid;
END;
$function$

