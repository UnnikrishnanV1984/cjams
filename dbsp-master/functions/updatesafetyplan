CREATE OR REPLACE FUNCTION updatesafetyplan(v_safetyplanid uuid, v_external_templateid character varying DEFAULT ''::character varying, v_intakeserviceid character varying DEFAULT ''::character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE  

l_safetyplanid  uuid;
BEGIN

IF  COALESCE(v_external_templateid,'')<>''  AND    v_safetyplanid  IS  NULL  AND  COALESCE(v_external_templateid,'')<>''  THEN   

 SELECT  safetyplan  INTO  l_safetyplanid  from  safetyplan  WHERE  external_templateid  =  v_external_templateid::uuid  AND  intakeserviceid  =  v_intakeserviceid::uuid  AND  activeflag=1;
 
 UPDATE  safetyplan  SET  activeflag=0  WHERE  external_templateid  =  v_external_templateid::uuid  AND  intakeserviceid  =  v_intakeserviceid::uuid;
 UPDATE  safetyplanaction  SET  activeflag  =0  WHERE    safetyplanid  in  (l_safetyplanid);
 UPDATE  safetyplanactor  SET  activeflag  =0  WHERE    safetyplanid  in  (l_safetyplanid);
END  IF;

 
IF  v_safetyplanid  IS  NOT  NULL  THEN  

 UPDATE  safetyplanaction  SET  activeflag  =0  WHERE    safetyplanid  =  v_safetyplanid;
 UPDATE  safetyplanactor  SET  activeflag  =0  WHERE    safetyplanid  =  v_safetyplanid;
END  IF;
 

          RETURN  'Success';
END;

$function$

