CREATE OR REPLACE FUNCTION getpageprofile(userid character varying, parentid uuid)
 RETURNS TABLE(id uuid, task character varying, action character varying, field character varying, resourcetype integer, resourcetypedesc character varying)
 LANGUAGE plpgsql
AS $function$

declare v_parentid uuid;


BEGIN

v_parentid := parentid;

    RETURN QUERY
 

SELECT res.id, res1.resourcename task, res.resourcename as action, '' as field
, res.resourcetype, rt.resourcetypedesc as resourcetype 
FROM rolemapping rm 
INNER JOIN role_resource rr ON rr.roleid = rm.roleid AND rm.principaltype = 'USER'
INNER JOIN role r ON rr.roleid = r.id
INNER JOIN resource res ON rr.resourceid = res.id
INNER JOIN resourcetype rt ON res.resourcetype = rt.id
INNER JOIN resource res1 ON res1.id = res.parentid 
WHERE 
res.parentid = v_parentid AND
res.resourcetype = 3 AND rm.principalid = userid AND rr.isallowed = true
 Union All
SELECT res.id, res1.resourcename task, '' as action, res.resourcename as field
, res.resourcetype, rt.resourcetypedesc as resourcetype 
FROM rolemapping rm 
INNER JOIN role_resource rr ON rr.roleid = rm.roleid AND rm.principaltype = 'USER'
INNER JOIN role r ON rr.roleid = r.id
INNER JOIN resource res ON rr.resourceid = res.id
INNER JOIN resourcetype rt ON res.resourcetype = rt.id
INNER JOIN resource res1 ON res1.id = res.parentid
WHERE 
res.parentid = v_parentid AND
res.resourcetype = 4 AND rm.principalid = userid AND rr.isallowed = true;

  END;
$function$

