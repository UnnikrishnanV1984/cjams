CREATE OR REPLACE FUNCTION interstatecompact80thnotification()
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE  

v_intakeserviceid uuid;
v_intakeservreqtypeid uuid;
v_intakeservicerequestclassid uuid;
v_investigationid uuid;
v_securityusersid character varying;
v_status character varying;
v_status1 character varying;
v_activity  record;
v_msg character varying;

BEGIN            
/* DJS - 10 days before expiration date of the ICJ event, a notification should be sent to the supervisor and ICJ Unit : System --- Tonya & Jackb --- 80th day from 2nd Case Assignment Date */
FOR  v_activity  IN

select distinct ISR.intakeserviceid, ISR.servicerequestnumber, ISR.intakenumber, coalesce(UP.lastname,'')||', '|| coalesce(UP.firstname,'') as fromuser,
coalesce(UP1.lastname,'')||', '|| coalesce(UP1.firstname,'') as touser,R.fromsecurityusersid,R1.tosecurityusersid,
cast((TRIM(P.lastname)|| '' , '' ||TRIM(P.firstname)) as  character varying) as youthname  
from intakeservicerequest as ISR
      JOIN routing as R 
           ON R.objectid = ISR.intakeserviceid::character varying and R.routingstatustypeid = 23
      JOIN routing as R1 
           ON R1.objectid = ISR.intakeserviceid::character varying and R1.routingstatustypeid = 22     
      JOIN IntakeServiceRequestType as ISRT
           ON ISRT.intakeservreqtypeid = ISR.intakeservreqtypeid and ISRT.intakeservreqtypekey = 'Interstate Compact' and ISRT.activeflag = 1
      JOIN userprofile as UP
           ON UP.securityusersid = R.fromsecurityusersid and UP.activeflag = 1  
      JOIN userprofile as UP1
           ON UP1.securityusersid = R1.tosecurityusersid and UP1.activeflag = 1
      JOIN intakeservicerequestactor as ISRA
           ON ISR.intakeserviceid  = ISRA.intakeserviceid  and ISRA.activeflag = 1 and lower(ISRA.intakeservicerequestpersontypekey) = 'youth'
      JOIN actor as A
           ON A.actorid  = ISRA.actorid  and A.activeflag = 1  
      JOIN Person as P
           ON P.personid  = A.personid  and P.activeflag = 1  
      JOIN intakeserreqstatustype IRST 
           ON IRST.intakeserreqstatustypeid = ISR.intakeserreqstatustypeid AND IRST.activeflag = 1 
                
      --WHERE R.insertedon < now() - '80 day'::interval
      WHERE R.insertedon::date = now()::date - '80 day'::interval AND lower( IRST.intakeserreqstatustypekey ) NOT IN ( 'closed' )

LOOP

-- Case# is due to expire in 10 days. Please submit the Supervision decision on or before “90th Day – Date”.
v_msg:=   'Case ('|| v_activity.servicerequestnumber ||') is due to expire in 10 days. Please submit the Supervision decision on or before ' || TO_CHAR(NOW() :: DATE + '10 day'::interval, 'dd/mm/yyyy') ||' .';

SELECT send_notification INTO v_status FROM send_notification(v_activity.tosecurityusersid, v_activity.fromsecurityusersid, v_activity.tosecurityusersid,
'System', 'High', v_msg, v_msg , v_activity.intakeserviceid::character varying);

SELECT send_notification INTO v_status1 FROM send_notification(v_activity.fromsecurityusersid, v_activity.fromsecurityusersid, v_activity.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_activity.intakeserviceid::character varying);

END  LOOP;


RETURN

'Success';

END;


$function$

