CREATE OR REPLACE FUNCTION sp_fc_worksheet_income_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, incometype json, benefitamount integer, childcarecost integer, typeofbenefit character varying, standardunitno integer, notinstandardunitno integer, noofmembersinau integer, noofmembersnotinau integer, grossincome185pct integer, assetallowance integer, assetsmarketvalue integer, childdeprivedofparentalsupport character varying, reasonforabsence character varying, deprivationfactor character varying, dateofparentdeath date, incarcerationdate date, unemploymentorunderemployment character varying, ivepersondeprevationid uuid)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm        VARCHAR(100) DEFAULT 'sp_fc_worksheet_income_info';
  vn_ive_prsn_inc_typ       JSON;  
  vn_bnft_amnt        INTEGER;
  vn_chd_cre_cst        INTEGER;
  vs_bnft_type        VARCHAR(50);
  vn_no_strd_unt        INTEGER;
  vn_no_nt_strd_unt       INTEGER; 
  vn_no_mmbrs_au        INTEGER;
  vn_no_mmbrs_nt_au       INTEGER;
  vn_grs_inc_185        INTEGER; 
  vn_asset_allwnce       INTEGER;
  vn_asset_mrkt_val       INTEGER;  
  vs_child_dprvd_prntl_sprt     VARCHAR(50);
  vs_rsn_abs         VARCHAR(50);
  vs_dprvtn_fctr        VARCHAR(50);
  vd_prnt_death_dt       DATE;
  vd_incrtn_dt        DATE;
  vs_unempl_undrempl       VARCHAR(50);
  vn_ive_prsn_depr_id       UUID;
 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_income_info ( 
  client_id          BIGINT,
  incometype         JSON,  
  benefitamount        INTEGER,
  childcarecost        INTEGER,
  typeofbenefit        VARCHAR(50),
  standardunitno        INTEGER,
  notinstandardunitno       INTEGER,
  noofmembersinau        INTEGER,
  noofmembersnotinau       INTEGER,
  grossincome185pct       INTEGER,
  assetallowance        INTEGER,
  assetsmarketvalue       INTEGER,
  childdeprivedofparentalsupport    VARCHAR(50),
  reasonforabsence       VARCHAR(50),
  deprivationfactor       VARCHAR(50),
  dateofparentdeath       DATE,
  incarcerationdate       DATE,
  unemploymentorunderemployment    VARCHAR(50),
  ivepersondeprevationid      UUID
 ); 
 
SELECT json_agg(json_build_object(
 'involvedclientid', ipi.involvedclientid , 
 'involvedclientname', ipi.involvedclientname,
 'assistanceunit', ipi.assistanceunit,
 'earnedincomeno', ipi.earnedincomeno,
 'deemedincome', ipi.deemedincome,
 'supportexpenseamount', ipi.supportexpenseamount,
 'unearnedincome', ipi.unearnedincome,
 'ivepersonincomeid', ipi.ivepersonincomeid,
 'clientid', ipi.toclientid 
))
 INTO vn_ive_prsn_inc_typ
   FROM ivepersonincome ipi 
WHERE ipi.toclientid::BIGINT = al_client_id AND ipi.activeflag = 1;

 -- Benefit Amount
SELECT ipd.benefitamount 
 INTO vn_bnft_amnt
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- Child Care Cost
SELECT ipd.childcarecost 
 INTO vn_chd_cre_cst
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- Benefit Type
SELECT ipd.benefittype 
 INTO vs_bnft_type
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- No of Members in Standard Unit
SELECT ipd.standardunitno  
 INTO vn_no_strd_unt
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- No of Members not in Standard Unit
SELECT ipd.notinstandardunitno  
 INTO vn_no_nt_strd_unt
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- No of Members in AU
SELECT ipd.assistanceunitno  
 INTO vn_no_mmbrs_au
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- No of Members not in AU
SELECT ipd.notinassistanceunitno  
 INTO vn_no_mmbrs_nt_au
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;
 
 -- Gross Income 185%
SELECT ipd.grossincome185pcunitno
 INTO vn_grs_inc_185
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- Asset Allowance
SELECT ipd.assetsallowance  
 INTO vn_asset_allwnce
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;
  
-- Assets Market Value
SELECT ipd.assetsmarketvalue
 INTO vn_asset_mrkt_val
   FROM ivepersondeprivation ipd  
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;
 
-- Child Deprived Of Parental Support   
SELECT ( CASE WHEN (ipd.deprivationtype is NOT NULL)
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END )  
 INTO vs_child_dprvd_prntl_sprt
   FROM ivepersondeprivation ipd    
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

-- Reason For Absence
SELECT rv.value_text   
 INTO vs_rsn_abs
   FROM referencevalues rv, ivepersondeprivation ipd
WHERE referencetypeid = 73 AND rv.activeflag = 1 
    AND TRIM(rv.ref_key) = TRIM(ipd.reasonforabsence)
    AND ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

-- Deprivation Factor
SELECT rv.value_text   
 INTO vs_dprvtn_fctr
   FROM referencevalues rv, ivepersondeprivation ipd
WHERE referencetypeid = 81 AND rv.activeflag = 1 
    AND TRIM(rv.ref_key) = TRIM(ipd.deprivationtype)
    AND ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;
 
-- Parent Death Date
SELECT ipd.dateofparentdeath
 INTO vd_prnt_death_dt
   FROM ivepersondeprivation ipd
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;
  
-- Incarceration Date
SELECT ipd.dateofincarceration  
 INTO vd_incrtn_dt
   FROM ivepersondeprivation ipd
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

-- Un-employment/Under-employment   
SELECT ( CASE WHEN (ipd.deprivationtype = 'DFUE' OR ipd.deprivationtype = 'DFUPWE')
     THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END ) 
 INTO vs_unempl_undrempl
   FROM ivepersondeprivation ipd
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

 -- Support Expense Amount
SELECT ipd.ivepersondeprivationid 
 INTO vn_ive_prsn_depr_id
   FROM ivepersondeprivation ipd
WHERE ipd.clientid::BIGINT = al_client_id AND ipd.activeflag = 1 ORDER BY ipd.updatedon asc limit 1;

INSERT INTO Temp_worksheet_income_info
SELECT 
  al_client_id,
  vn_ive_prsn_inc_typ,
  vn_bnft_amnt,
  vn_chd_cre_cst,
  vs_bnft_type,
  vn_no_strd_unt,
  vn_no_nt_strd_unt, 
  vn_no_mmbrs_au,
  vn_no_mmbrs_nt_au,
  vn_grs_inc_185,
  vn_asset_allwnce,
  vn_asset_mrkt_val,
  vs_child_dprvd_prntl_sprt,
  vs_rsn_abs,
  vs_dprvtn_fctr,
  vd_prnt_death_dt,
  vd_incrtn_dt,
  vs_unempl_undrempl,
  vn_ive_prsn_depr_id;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_income_info;
              
DROP TABLE Temp_worksheet_income_info;

   END
    $function$

