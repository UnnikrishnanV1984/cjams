CREATE OR REPLACE FUNCTION prov_publicprovider_changeapplicant(v_objectid character varying, v_referralid character varying, v_fromsecurityuserid character varying, v_tosecurityuserid character varying, v_approval_type character varying, v_comments character varying, v_communication character varying, v_requesteddate character varying, v_isclosereopen boolean DEFAULT NULL::boolean, v_application_type character varying, v_prgram character varying, v_prgramtype character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

declare

  v_referralold character varying;
 v_returnstatus character varying;
 v_nextno character varying;
 v_applicantoldid character varying;
 v_applicantid character varying;
  v_providerrouting character varying;
-- v_prgram character varying;
-- v_prgramtype character varying;
v_providerroutingstatus character varying;
v_updateinquiryhousehold character varying;
v_reconsider character varying;
v_application_typedesc character varying;
--v_teamtypekey character varying;
v_initial_applicantid character varying;
begin
 v_providerroutingstatus:=v_prgramtype; 
if (v_prgramtype is not null) then
   select replace(v_referralid,'R','A') into v_applicantid; 
 select value_text into v_application_typedesc from referencevalues r where referencetypeid=1750 and ref_key=v_application_type; 
if (v_application_type='REOPENPROV') then
     update tb_provider set provider_status_cd=1794 where provider_id=v_objectid and  provider_category_cd =1783; 
end if;

--select rm.teamtypekey into v_teamtypekey from muser m 
--join rolemapping rm on m.id = rm.principalid and m.activeflag =1 
--join "role" r1 on r1.id = rm.roleid  and rm.activeflag =1 and r1.activeflag =1 
--where m.securityusersid = v_fromsecurityuserid;
--Sudha commented the below as the provider is showing the updated one even before approving  we are having the same insert in prov_approvepublicproviderapplication so not needed here
-- update providerinfoconfig set activeflag=0 where providerid=v_objectid and activeflag=1;

-- INSERT INTO providerinfoconfig ( providerid, "program", programtype, activeflag, effectivedate, insertedby, updatedby, insertedon, updatedon, old_id) 
-- VALUES( v_objectid, v_prgram, v_prgramtype, 1, now(), v_fromsecurityuserid, v_fromsecurityuserid, now(), now(), v_applicantid);

INSERT INTO tb_public_provider_referral
 (referral_id, create_ts, create_user_id, update_ts, update_user_id,
 individual_applicant_first_nm , individual_applicant_last_nm , individual_applicant_middle_nm, individual_applicant_ssn , individual_applicant_dob, 
 --co_applicant_dob  , co_applicant_first_nm  ,co_applicant_last_nm , co_applicant_ssn , 
 jurisdiction,individual_applicant_cell_nm,prgram,provider_program_type)
SELECT 
 (v_referralid), now(), v_fromsecurityuserid, now(),v_fromsecurityuserid, 
 --pr.provider_first_nm, pr.provider_last_nm , pr.provider_middle_nm , pr.tax_id_no , pr.dob_dt ,
  pr.co_first_nm, pr.co_last_nm ,co_middle_nm, pr.co_ssn_no ,pr.co_dob_dt,
 (select countyid from county cnty where cnty.statecountycode=pr.county_cd ),adr_work_phone_tx,v_prgram,v_prgramtype
FROM 
 tb_provider pr 
WHERE 
 pr.provider_id = v_objectid;




 INSERT INTO tb_public_provider_applicant 
 (applicant_id, prgram, create_ts, create_user_id, update_ts, delete_sw, update_user_id, organization_first_nm, organization_tax_id, individual_applicant_first_nm, individual_applicant_ssn, individual_applicant_dob, individual_applicant_background_check, co_applicant_first_nm, co_applicant_ssn, co_applicant_dob, co_applicant_background_check, medical_info_license_no, medical_info_speciality, payment_info_medicaid_provider, payment_info_payee_first_nm, payment_info_1099_indicator, individual_applicant_middle_nm, individual_applicant_last_nm, organization_middle_nm, organization_last_nm, co_applicant_middle_nm, co_applicant_last_nm, payment_info_payee_middle_nm, payment_info_payee_last_nm, communication_medium, date_of_contact, provider_program_type, individual_applicant_prefix, individual_applicant_suffix, co_applicant_prefix, co_applicant_suffix, is_home_water, home_info_children_no, home_info_bedroom_no, is_home_swimming_pool, home_info_pool_location, home_is_other_agency, home_info_agency_nm, is_child_care_provider, home_info_child_care_details, individual_applicant_hm_phone, individual_applicant_cell_nm, individual_applicant_email, individual_applicant_employer_nm, individual_applicant_phone_nm, individual_applicant_us_citizen, co_applicant_hm_phone, co_applicant_cell_nm, co_applicant_email, co_applicant_employer_nm, co_applicant_phone_nm, co_applicant_us_citizen, age_group, inquiry_source, inquiry_source_details, jurisdiction, phase,application_status,applicant_decision,application_typecode,application_typedesc)
 (select v_applicantid,  prgram, create_ts, create_user_id, update_ts, delete_sw, update_user_id, organization_first_nm, organization_tax_id, individual_applicant_first_nm, individual_applicant_ssn, individual_applicant_dob, individual_applicant_background_check, co_applicant_first_nm, co_applicant_ssn, co_applicant_dob, co_applicant_background_check, medical_info_license_no, medical_info_speciality, payment_info_medicaid_provider, payment_info_payee_first_nm, payment_info_1099_indicator, individual_applicant_middle_nm, individual_applicant_last_nm, organization_middle_nm, organization_last_nm, co_applicant_middle_nm, co_applicant_last_nm, payment_info_payee_middle_nm, payment_info_payee_last_nm, communication_medium, date_of_contact, provider_program_type, individual_applicant_prefix, individual_applicant_suffix, co_applicant_prefix, co_applicant_suffix, is_home_water, home_info_children_no, home_info_bedroom_no, is_home_swimming_pool, home_info_pool_location, home_is_other_agency, home_info_agency_nm, is_child_care_provider, home_info_child_care_details, individual_applicant_hm_phone, individual_applicant_cell_nm, individual_applicant_email, individual_applicant_employer_nm, individual_applicant_phone_nm, individual_applicant_us_citizen, co_applicant_hm_phone, co_applicant_cell_nm, co_applicant_email, co_applicant_employer_nm, co_applicant_phone_nm, co_applicant_us_citizen, age_group, 'Other', inquiry_source_details, jurisdiction, 'Application','Accepted','Accepted',v_application_type,v_application_typedesc FROM tb_public_provider_referral WHERE referral_id=v_referralid);

 INSERT INTO providerapprovetypeconfig
 ( providerid, referralid, applicantid, "comments", activeflag, effectivedate, insertedby, insertedon,approval_type,communication,requested_date,isclosereopen)
 VALUES( v_objectid, v_referralid, v_applicantid, v_comments, 1, now(), v_fromsecurityuserid, now(),v_approval_type,v_communication,v_requesteddate::timestamp,v_isclosereopen);
 
 select prov_publicproviderrouting into v_providerrouting from prov_publicproviderrouting(v_applicantid,v_fromsecurityuserid,v_tosecurityuserid,
 86,'PRRHSW',v_providerroutingstatus,v_providerroutingstatus,'','','');

 


 select prov_updateinquiryhouseholdforapplicantchange into v_updateinquiryhousehold from prov_updateinquiryhouseholdforapplicantchange(v_objectid,'prov_provider',v_applicantid,'prov_application',v_fromsecurityuserid);
--select prov_updateinquiryhousehold into v_updateinquiryhousehold from prov_updateinquiryhousehold(v_referralold,'prov_referral',v_referralid,'prov_referral',v_fromsecurityuserid);
--select prov_updateinquiryhousehold into v_updateinquiryhousehold from prov_updateinquiryhousehold(v_referralid,'prov_referral',v_applicantid,'prov_application',v_fromsecurityuserid);
 raise notice 'v_updateinquiryhousehold%',v_updateinquiryhousehold;

--if (v_application_type ='ARECONSIDER' or ) then
   select prov_applicantchangeinfoupdates into v_reconsider from prov_applicantchangeinfoupdates(v_objectid,v_applicantid,v_referralid,v_fromsecurityuserid,v_application_type);
--end if;

INSERT INTO tb_public_provider_application_mapping
(applicant_id,old_provider_id,provider_id,create_ts,create_user_id,update_ts,update_user_id,delete_sw) 
VALUES(v_applicantid,v_objectid::INTEGER,NULL,now(),v_fromsecurityuserid,now(),v_fromsecurityuserid,'N');

select tbpa.applicant_id into v_initial_applicantid from 
  providerapprovalphaserecord patr
  inner join tb_public_provider_applicant tbpa on tbpa.applicant_id=patr.applicant_id
  where patr.provider_id = v_objectid and tbpa.application_typecode = 'INITIAL';

if (v_initial_applicantid is not null) then
 INSERT INTO publicproviderreferencecheck
 ( object_id, reference_check_date, is_relative, is_reference_recommends, narrative, create_ts, create_user_id, update_ts, update_user_id, delete_sw, active_flag, reference_first_nm, reference_middle_nm, reference_last_nm, relationship_to_application, type_of_contact, is_school_recommends, household_member_id)
 select v_applicantid,reference_check_date, is_relative, is_reference_recommends, narrative,now(),v_fromsecurityuserid,now(),v_fromsecurityuserid,delete_sw, active_flag, reference_first_nm, reference_middle_nm, reference_last_nm, relationship_to_application, type_of_contact, is_school_recommends, household_member_id from publicproviderreferencecheck 
 where object_id = v_initial_applicantid;

 INSERT INTO publicproviderhomestudyvisit
 ( object_id, interview_date, interview_start_time, interview_end_time, duration, interview_location, create_ts, create_user_id, update_ts, update_user_id, delete_sw, active_flag, narrative, islocationhome, provider_contact_id)
 select v_applicantid,interview_date, interview_start_time, interview_end_time, duration, interview_location, now(), v_fromsecurityuserid, now(), v_fromsecurityuserid, delete_sw, active_flag, narrative, islocationhome, provider_contact_id from publicproviderhomestudyvisit 
 where object_id = v_initial_applicantid;
end if;

 INSERT INTO providerassignment
( fromworkeridno, fromsupervisoridno, toworkeridno, tosupervisoridno, objecttypekey, objectid, activeflag, startdate, enddate, fromteamid, toteamid, remarks, statustypekey, fromldssid, toldssid, assigndate, isrestricted, assigndescription, summary, insertedby, updatedby, insertedon, updatedon)
       SELECT fromworkeridno, fromsupervisoridno, toworkeridno, tosupervisoridno, objecttypekey, objectid, activeflag, startdate, enddate, fromteamid, toteamid, remarks, statustypekey, fromldssid, toldssid, assigndate, isrestricted, assigndescription, summary, insertedby, updatedby, insertedon, updatedon
FROM providerassignment
WHERE objectid = v_objectid ;

 raise notice 'v_providerrouting%',v_providerrouting;
  
  v_returnstatus := v_applicantid;
 else 
   v_returnstatus := 'Failure no corresponding approved applicantion exists for the provider '|| v_objectid;
 END IF;

RETURN v_returnstatus;
                                                      
END;

$function$

