CREATE OR REPLACE FUNCTION addproviderapplicantservices(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE
returnStatus text;
applicant_id text;
service_id numeric;
start_dt date;
end_dt date;
paid_cd text;
primary_sw char;
location_sw char;
delete_sw char;
service_status text;

service_category text;
service_classification text;
service_cost numeric;
service_description text;
service_paid_by text;
service_unit text;


BEGIN

applicant_id=insertedtlsobj->>'applicant_id';
service_id =insertedtlsobj->>'service_id';
start_dt=insertedtlsobj->>'start_dt';
end_dt= insertedtlsobj->>'end_dt';
paid_cd =insertedtlsobj->>'paid_cd';
primary_sw =insertedtlsobj->>'primary_sw';
location_sw =insertedtlsobj->>'location_sw';
delete_sw= insertedtlsobj->>'delete_sw';
service_status= insertedtlsobj->>'service_status';
service_category= insertedtlsobj->>'service_category';
service_classification= insertedtlsobj->>'service_classification';
service_cost= insertedtlsobj->>'service_cost';
service_description= insertedtlsobj->>'service_description';
service_paid_by= insertedtlsobj->>'service_paid_by';
service_unit= insertedtlsobj->>'service_unit';



/*IF providerServiceId>0
then 
update tb_applicant_services set service_status='Expired' where provider_service_id=providerServiceId;
END IF;*/

service_status:= 'Active';

insert into tb_provider_applicant_services (applicant_id, service_id,start_dt,end_dt, paid_cd, 
primary_sw,location_sw,create_ts, create_user_id,update_ts, update_user_id, delete_sw,
service_status,service_category,service_classification,service_cost,service_description,service_paid_by,service_unit)
values
(applicant_id,service_id,start_dt,end_dt,paid_cd,primary_sw,location_sw,insertedtlsobj->>'create_ts', insertedtlsobj->>'create_user_id',
insertedtlsobj->>'update_ts', insertedtlsobj->>'update_user_id',delete_sw,service_status,service_category,service_classification,
service_cost,service_description,service_paid_by,service_unit);


returnStatus:= 'Success';

RETURN returnStatus;
                                                      
END;

$function$

