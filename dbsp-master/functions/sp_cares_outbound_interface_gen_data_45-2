CREATE OR REPLACE FUNCTION sp_cares_outbound_interface_gen_data_45(vl_client_id integer, vl_other_id character varying, vs_transaction_type_cd character varying, vl_transaction_sequence integer, vd_transaction_ts timestamp without time zone, OUT vs_message character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- Author: Sudhin
-- Date Created :08/01/2005
-- generates Cares Interface Outbound Data
------------------------------------------------------------------------

    DECLARE VS_RECORD_TYPE VARCHAR(2);--
     VL_RECORD_SEQUENCE INTEGER DEFAULT 000;--
     VS_TRANSACTION_SEQUENCE VARCHAR(5);--
     VS_RECORD_SEQUENCE VARCHAR(3);--
    -- Client Variables
     VS_CIS_CLIENT_ID VARCHAR(10);      --  CARES_OUT_COL6

     CARES_OUT_EMPLOY_COL1 VARCHAR(50);--
     CARES_OUT_EMPLOY_COL2 INTEGER;--
     CARES_OUT_EMPLOY_COL3 INTEGER;--
     CARES_OUT_EMPLOY_COL4 CHAR(5);--
     CARES_OUT_EMPLOY_COL5 DECIMAL(10,2);--
     CARES_OUT_EMPLOY_COL5_CONV VARCHAR(15);--
     CARES_OUT_EMPLOY_COL6 CHAR(3);--
     CARES_OUT_EMPLOY_COL7 VARCHAR(9); -- INTEGER
     CARES_OUT_EMPLOY_COL8 VARCHAR(50);--
     CARES_OUT_EMPLOY_COL9 CHAR(5);--
     CARES_OUT_EMPLOY_COL10 CHAR(3);--
     CARES_OUT_EMPLOY_COL11 CHAR(5);--
     CARES_OUT_EMPLOY_COL12 VARCHAR(50);--
     CARES_OUT_EMPLOY_COL13 CHAR(2);--
     CARES_OUT_EMPLOY_COL14 INTEGER;--
     CARES_OUT_EMPLOY_COL15 VARCHAR(10);--

    DECLARE CURSOR_EMPLOY CURSOR FOR
        SELECT personemployerdetail.employername,
          (SUBSTRING(personemployment.startdate::VARCHAR,1,4)||SUBSTRING(personemployment.startdate::VARCHAR,6,2)||SUBSTRING(personemployment.startdate::VARCHAR,9,2))::INTEGER,
                 (SUBSTRING(personemployment.enddate::VARCHAR,1,4)||SUBSTRING(personemployment.enddate::VARCHAR,6,2)||SUBSTRING(personemployment.enddate::VARCHAR,9,2))::INTEGER,
                 personemployment.wagefreqtypekey,
                 personemployment.income,
   SUBSTRING(F_PLVALUE(personemployment.predirtypekey,69),1,3),
         SUBSTRING(personemployment.address1,'(^[0-9]+)'), -- TB_CLIENT_EMPLOYMENT.ADR_STREET_NO
         TRIM(substring(personemployment.address1,'([[:alpha:]\\s]+)')),
         personemployment.streetsuffixtypekey,
         SUBSTRING(F_PLVALUE(personemployment.postdirtypekey,69),1,3),
         personemployment.address2,
         personemployment.cityname,
         personemployment.statetypekey,
          (SUBSTRING(COALESCE(personemployment.zip5no::VARCHAR,'00000'),1,5) || SUBSTRING(COALESCE(personemployment.zip4no::VARCHAR,'0000'),1,4))::INTEGER,
                 personemployment.workphone
           FROM   personemployment, personemployerdetail, person 
           WHERE  personemployment.personid = person.personid
     and   person.cjamspid = VL_CLIENT_ID
     AND personemployerdetail.personemployerdetailid = personemployment.personemployerdetailsid
  AND personemployerdetail.personid = personemployment.personid
           AND    personemployment.personemployerdetailsid IS NULL
           AND    personemployment.activeflag = 1;--

BEGIN    
   VL_OUTPUT_SQLCODE:='00000';
    -- SET transaction sequence
     VS_TRANSACTION_SEQUENCE := LTRIM(RTRIM(VL_TRANSACTION_SEQUENCE::VARCHAR)) ;--

    -- Get CIS_CLIENT_ID
 BEGIN
    SELECT  person.cisclientid
   INTO    VS_CIS_CLIENT_ID
    FROM    person   
    WHERE   person.cjamspid = VL_CLIENT_ID
    AND     person.activeflag  = 1;   --
 
 EXCEPTION WHEN OTHERS THEN 
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
    VS_MESSAGE :=  'SELECT CIS_CLIENT_ID FAILED FOR TB_CLIENT'  ;--
       RETURN;
    END ;--

    -- Generate records for record type 45
  
     VS_RECORD_TYPE := '45';--
  
     VL_RECORD_SEQUENCE := 000 ;--

     VS_RECORD_SEQUENCE := '';--

    IF  VS_RECORD_TYPE = '45' THEN

       OPEN CURSOR_EMPLOY;--
       <<CURS_EMPLOY>>
       WHILE VL_OUTPUT_SQLCODE = '00000' LOOP
             FETCH CURSOR_EMPLOY INTO CARES_OUT_EMPLOY_COL1, CARES_OUT_EMPLOY_COL2, CARES_OUT_EMPLOY_COL3,
                                      CARES_OUT_EMPLOY_COL4, CARES_OUT_EMPLOY_COL5, CARES_OUT_EMPLOY_COL6,
                                      CARES_OUT_EMPLOY_COL7, CARES_OUT_EMPLOY_COL8, CARES_OUT_EMPLOY_COL9,
                                      CARES_OUT_EMPLOY_COL10, CARES_OUT_EMPLOY_COL11, CARES_OUT_EMPLOY_COL12,
                                      CARES_OUT_EMPLOY_COL13, CARES_OUT_EMPLOY_COL14, CARES_OUT_EMPLOY_COL15  ;--

            EXIT CURS_EMPLOY WHEN NOT FOUND;--
     

      VL_RECORD_SEQUENCE := VL_RECORD_SEQUENCE + 1 ;--
 
      VS_RECORD_SEQUENCE := LTRIM(RTRIM(VL_RECORD_SEQUENCE::VARCHAR));--
 

       CARES_OUT_EMPLOY_COL5_CONV := LTRIM(RTRIM(CARES_OUT_EMPLOY_COL5::VARCHAR)) ;--
 
       CARES_OUT_EMPLOY_COL5_CONV := SUBSTRING('00000000000',1,11 - LENGTH(CARES_OUT_EMPLOY_COL5_CONV)) ||CARES_OUT_EMPLOY_COL5_CONV ;--

      -- Set Interface Data
      INSERT INTO TB_CARES_OUTBOUND_INTERFACE
         (CARES_RECORD_ID,
          STATUS_CD,
          BATCH_SEQ_NO,
          TRANSACTION_SEQ_NO,
   TRANSACTION_TYPE_CD,
       CIS_CLIENT_ID,
   RECORD_TYPE_CD,
   TRANSACTION_TS,
          RECORD_SEQ_NO,
   CARES_OUT_COL1,
   CARES_OUT_COL2,
   CARES_OUT_COL3,
   CARES_OUT_COL4,
   CARES_OUT_COL5,
   CARES_OUT_COL6,
   CARES_OUT_COL7,
   CARES_OUT_COL8,
   CARES_OUT_COL9,
   CARES_OUT_COL10,
   CARES_OUT_COL11,
   CARES_OUT_COL12,
   CARES_OUT_COL13,
   CARES_OUT_COL14,
   CARES_OUT_COL15
   ) 
             SELECT
  NEXTVAL ('SQ_CARES_OUTBOUND_INTERFACE'),
  '000',
  '',
  CASE WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 1 THEN '0000'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 2 THEN '000'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 3 THEN '00'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 4 THEN '0'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 5 THEN VS_TRANSACTION_SEQUENCE
       END,
  VS_TRANSACTION_TYPE_CD,
  COALESCE(SUBSTRING('000000000',1,9 - LENGTH(LTRIM(RTRIM(VS_CIS_CLIENT_ID)))) || LTRIM(RTRIM(VS_CIS_CLIENT_ID)),'000000000'),
  '45',
  VD_TRANSACTION_TS,
  CASE WHEN LENGTH(VS_RECORD_SEQUENCE) = 1 THEN '00'||VS_RECORD_SEQUENCE
       WHEN LENGTH(VS_RECORD_SEQUENCE) = 2 THEN '0'||VS_RECORD_SEQUENCE
       WHEN LENGTH(VS_RECORD_SEQUENCE) = 3 THEN VS_RECORD_SEQUENCE
       END,
                CARES_OUT_EMPLOY_COL1,
                COALESCE(CARES_OUT_EMPLOY_COL2::VARCHAR,'00000000'),
                COALESCE(CARES_OUT_EMPLOY_COL3::VARCHAR,'00000000'),
                CARES_OUT_EMPLOY_COL4,
                CASE WHEN CARES_OUT_EMPLOY_COL5_CONV = '' THEN '00000000.00'
                     WHEN LENGTH(CARES_OUT_EMPLOY_COL5_CONV) <= 0 THEN '00000000.00'
                     ELSE COALESCE(CARES_OUT_EMPLOY_COL5_CONV::VARCHAR,'00000000.00')
                END,
                CARES_OUT_EMPLOY_COL6,
                CARES_OUT_EMPLOY_COL7,
                CARES_OUT_EMPLOY_COL8,
                CARES_OUT_EMPLOY_COL9,
                CARES_OUT_EMPLOY_COL10,
                CARES_OUT_EMPLOY_COL11,
                CARES_OUT_EMPLOY_COL12,
                CARES_OUT_EMPLOY_COL13,
                CASE WHEN CARES_OUT_EMPLOY_COL14 = 0 THEN '000000000'
                     WHEN CARES_OUT_EMPLOY_COL14 IS NULL THEN '000000000'
                     ELSE SUBSTRING('000000000',1,9 - LENGTH(LTRIM(RTRIM(CARES_OUT_EMPLOY_COL14::VARCHAR)))) || LTRIM(RTRIM(CARES_OUT_EMPLOY_COL14::VARCHAR))
                END,
                COALESCE(CARES_OUT_EMPLOY_COL15,'0000000000')
      ;--
 
 
       END LOOP;--
       CLOSE CURSOR_EMPLOY;--

       
    END IF;--
  
   
 RETURN ;--
    EXCEPTION WHEN OTHERS THEN 
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
    VS_MESSAGE :='INSERT INTO TB_CARES_OUTBOUND_INTERFACE FAILED'||SQLERRM  ;--
     RETURN;
    
END 
;
$function$

