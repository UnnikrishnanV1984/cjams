CREATE OR REPLACE FUNCTION as_auditlog(v_logtypekey character varying, v_description character varying, v_referenceid uuid, v_servicerequestnumber character varying, v_intakeserviceid uuid, v_securityusersid character varying, v_metadata json, v_ipaddress character varying, v_isnew boolean, v_isedit boolean, v_isdelete boolean)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

                                                      
DECLARE
auditlogtype character varying; 
v_date timestamp without time zone;

BEGIN

v_date:= now() ;

 SELECT * FROM auditlogtype WHERE logtypekey = v_logtypekey INTO auditlogtype;
 IF LENGTH(auditlogtype) > 0 THEN
  INSERT INTO auditlog(
      logtypekey,intakeserviceid ,servicerequestnumber,referenceid,description,
            isnew,isedit,isdelete,updatedby,insertedby,updatedon,insertedon,metadata,
            ipaddress)
            VALUES(v_logtypekey,v_intakeserviceid,v_servicerequestnumber,v_referenceid,
                   v_description,v_isnew,v_isedit, v_isdelete,v_securityusersid,
                   v_securityusersid, v_date,v_date,v_metadata,v_ipaddress);

   
           END IF;
RETURN
  'Success';
END;

$function$

