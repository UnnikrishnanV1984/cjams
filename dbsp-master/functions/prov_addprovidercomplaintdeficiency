CREATE OR REPLACE FUNCTION prov_addprovidercomplaintdeficiency(securityuserid character varying, v_provider_complaint_deficiencyid character varying, v_planofcorrection character varying, v_targetdate timestamp without time zone, v_disbutecomarcitation character varying, v_isdisbute boolean, v_findings character varying, v_comments character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
 DECLARE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                   
 BEGIN                                                                                                                                                                                                                                                                                                            
update tb_provider_complaint_deficiency 
set planofcorrection =  v_planofcorrection,
targetdate =  v_targetdate ,
disbutecomarcitation =  v_disbutecomarcitation,
isdisbute = v_isdisbute,
findings = v_findings,
"comments" = v_comments
where tb_provider_complaint_deficiencyid::character varying = v_provider_complaint_deficiencyid ;          
 
RETURN  'success';
 end;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 $function$

