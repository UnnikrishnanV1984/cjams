CREATE OR REPLACE FUNCTION createpersoneducation(personjson json, personid uuid, securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

persondata json;
p_Personid uuid;
v_securityuserid character varying;
s_SchoolObj json;
t_TestingObj json;
v_VocationObj json;
a_AccomplishmentObj json;
l_Status character varying;
i json; 
personeducation character varying;

v_date timestamp without time zone;

BEGIN

persondata := personjson;
p_Personid := personid;
v_date:= now() ;
v_securityuserid := securityuserid;

    CREATE TEMP TABLE temp_sp_Create_Temp_personeducation  ( 
    personeducationid character varying,
      personid character varying,
      educationname character varying,
      educationtypekey character varying,
      countyid  character varying,
      statecode character varying,
      startdate date,
      enddate date,
      lastgradetypekey character varying,
      currentgradetypekey character varying,
      isspecialeducation bool,
      specialeducationtypekey character varying,
      absentdate date,
      isreceived bool,
      isverified bool,
      isexcuesed bool,
      effectivedate date,
      expirationdate date,
      isNew int default 0);   
    
 CREATE TEMP TABLE temp_sp_Create_Temp_PersonEducationTesting  ( 
    personeducationtestingid character varying,
      personid character varying,
      testingtypekey character varying,
      readinglevel int,
      readingtestdate date,
      mathlevel int,
      mathtestdate date,
      testingprovider character varying,
      effectivedate date,
      expirationdate date,
      isNew int default 0);   
     
 CREATE TEMP TABLE temp_sp_Create_Temp_PersonAccomplishment(
    personaccomplishmentid character varying,
      personid character varying,
      highestgradetypekey character varying,
      accomplishmentdate date,
      isrecordreceived bool,
      receiveddate date,
      effectivedate date,
      expirationdate date,
      isNew int default 0
      );

 CREATE TEMP TABLE temp_sp_Create_Temp_PersonEducationVocation(
    personeducationvocationid character varying,
      personid character varying,
      vocationinterest character varying,
      vocationaptitude character varying,
      isvocationaltest bool,
      certificatename character varying,
      certificatepath character varying,
      isNew int default 0
      );

   
       RAISE NOTICE ' personjson %',personjson;         
FOR i IN SELECT * FROM json_array_elements(personjson)
LOOP
     
   s_SchoolObj:= i->>'school';
   
           insert into temp_sp_Create_Temp_personeducation
   select   * from json_to_recordset(s_SchoolObj ) as x("personeducationid" character varying,
      "personid" character varying,
      "educationname" character varying,
      "educationtypekey" character varying,
      "countyid"  character varying,
      "statecode" character varying,
      "startdate" date,
      "enddate" date,
      "lastgradetypekey" character varying,
      "currentgradetypekey" character varying,
      "isspecialeducation" bool,
      "specialeducationtypekey" character varying,
      "absentdate" date,
      "isreceived" bool,
      "isverified" bool,
      "isexcuesed" bool);
   
   t_TestingObj:= i->>'testing';
   
    insert into temp_sp_Create_Temp_PersonEducationTesting
   select   * from json_to_recordset(t_TestingObj ) as x("personeducationtestingid" character varying,
      "personid" character varying,
      "testingtypekey" character varying,
      "readinglevel" int,
      "readingtestdate" date,
      "mathlevel" int,
      "mathtestdate" date,
      "testingprovider" character varying);

    a_AccomplishmentObj := i ->>'accomplishment';
    
      insert into temp_sp_Create_Temp_PersonAccomplishment
   select   * from json_to_recordset(a_AccomplishmentObj ) as x("personaccomplishmentid" character varying,
      "personid" character varying,
      "highestgradetypekey" character varying,
      "accomplishmentdate" date,
      "isrecordreceived" bool,
      "receiveddate" date,
      "effectivedate" date,
      "expirationdate" date);

   v_VocationObj := i ->>'vocation';
   
   insert into temp_sp_Create_Temp_PersonEducationVocation
   select   * from json_to_recordset(v_VocationObj ) as x("personeducationvocationid" character varying,
      "personid" character varying,
      "vocationinterest" character varying,
      "vocationaptitude" character varying,
      "isvocationaltest" bool,
      "certificatename" character varying,
      "certificatepath" character varying);

 update temp_sp_Create_Temp_personeducation set  isNew =1 where coalesce(personeducationid::character varying,'','') ='';
 update temp_sp_Create_Temp_PersonEducationTesting set  isNew =1 where coalesce(personeducationtestingid::character varying,'','') ='';
 update temp_sp_Create_Temp_PersonAccomplishment set  isNew =1 where coalesce(personaccomplishmentid::character varying,'','') ='';
 update temp_sp_Create_Temp_PersonEducationVocation set  isNew =1 where coalesce(personeducationvocationid::character varying,'','') ='';

 
    UPDATE personeducation pe SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pe.personeducationid::character varying  NOT in (
                       SELECT coalesce( personeducationid::character varying,'') 
                       FROM temp_sp_Create_Temp_personeducation where isnew=0) 
                       AND pe.personid = p_Personid;
 
 
   UPDATE personeducationtesting pet SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pet.personeducationtestingid::character varying  NOT in (SELECT coalesce( personeducationtestingid::character varying,'')  from      
                                                       temp_sp_Create_Temp_PersonEducationTesting where isnew=0)
     AND pet.personid = p_Personid; 

   UPDATE personaccomplishment pa SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pa.personaccomplishmentid::character varying   NOT in (select coalesce( personaccomplishmentid::character varying,'')  from 
       temp_sp_Create_Temp_PersonAccomplishment where isnew=0)
                   AND pa.personid = p_Personid; 

   UPDATE personeducationvocation pec SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE pec.personeducationvocationid::character varying   NOT in (select coalesce(  personeducationvocationid::character varying,'')  from
                                                        temp_sp_Create_Temp_PersonEducationVocation where isnew=0)
      AND pec.personid = p_Personid;         

       RAISE NOTICE ' s_SchoolObj %',s_SchoolObj; 
       
   INSERT INTO personeducation( personid, educationname, educationtypekey, 
     statecode, startdate, enddate, lastgradetypekey, currentgradetypekey, 
    isspecialeducation, specialeducationtypekey, absentdate, isreceived, 
    isverified, isexcuesed, activeflag, 
    insertedby, updatedby, insertedon, updatedon)
   SELECT p_Personid::uuid,educationname, educationtypekey, 
    statecode, startdate,enddate, lastgradetypekey,currentgradetypekey, 
    isspecialeducation,specialeducationtypekey, absentdate, isreceived, 
    isverified, isexcuesed,1,
    v_securityuserid,v_securityuserid, v_date, v_date 
    FROM   temp_sp_Create_Temp_personeducation WHERE isNew=1;

   INSERT INTO personeducationtesting( personid, testingtypekey, readinglevel, 
    readingtestdate, mathlevel, mathtestdate, testingprovider, activeflag, 
    expirationdate, insertedby, updatedby, insertedon, 
    updatedon)
   SELECT p_Personid::uuid, testingtypekey, readinglevel, readingtestdate, 
    mathlevel, mathtestdate, testingprovider, 1, 
    v_date, v_securityuserid,v_securityuserid, v_date, v_date 
   FROM   temp_sp_Create_Temp_PersonEducationTesting WHERE isnew=1; 

   INSERT INTO personaccomplishment(personid, highestgradetypekey, accomplishmentdate, 
    isrecordreceived, receiveddate, activeflag, expirationdate, 
    insertedby, updatedby, insertedon, updatedon)
   SELECT p_Personid, highestgradetypekey, accomplishmentdate, isrecordreceived, 
    receiveddate,1, v_date, 
    v_securityuserid,v_securityuserid, v_date, v_date 
   FROM temp_sp_Create_Temp_PersonAccomplishment WHERE isnew=1;

    INSERT INTO personeducationvocation(personid, vocationinterest, vocationaptitude, 
       isvocationaltest, certificatename, certificatepath, activeflag, 
        expirationdate, insertedby, updatedby, insertedon, 
       updatedon)
   SELECT p_Personid, vocationinterest,vocationaptitude, isvocationaltest, 
       certificatename, certificatepath, 1,  
      v_date, v_securityuserid,v_securityuserid, v_date, v_date 
   FROM temp_sp_Create_Temp_PersonEducationVocation WHERE isnew=1;

   
   

END LOOP;

l_Status := 'SUCCESS';

DROP TABLE temp_sp_Create_Temp_personeducation;
DROP TABLE temp_sp_Create_Temp_PersonEducationTesting;
DROP TABLE temp_sp_Create_Temp_PersonAccomplishment;
DROP TABLE temp_sp_Create_Temp_PersonEducationVocation;
return l_Status;

END

$function$

