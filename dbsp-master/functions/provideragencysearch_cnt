                   LEFT JOIN ProviderDetail    AS PD ON PD.AgencyId = AG.AgencyId                                                                                                                           
                   LEFT JOIN   ProviderAgreementType       AS PAT  ON PA.ProviderAgreementTypeKey = PAT.ProviderAgreementTypeKey                                                                            
                   LEFT JOIN ProviderAgreementQAS  AS Q ON Q.ProviderAgreementId = PA.ProviderAgreementId                                                                                                   
                   LEFT JOIN AgencyAlias     AS ali ON ali.AgencyId = AG.AgencyId                                                                                                                           
                   LEFT JOIN AgencyCategory    AS ac ON ac.AgencyCategoryKey = at.AgencyCategoryKey                                                                                                         
                   --LEFT JOIN AgencyAddress    AS aa ON aa.AgencyAddressId = KY.AgencyAddressId                                                                                                            
                   --LEFT JOIN AgencyPhoneNumber   AS ap ON ap.AgencyPhoneNumberId = KY.AgencyPhoneNumberId                                                                                                 
                   LEFT JOIN   ProviderAgreementLocation   AS pal  ON pal.ProviderAgreementId = PA.ProviderAgreementId                                                                                      
                   Left JOIN   ProviderAgreementLocationAddress AS paa   ON paa.ProviderAgreementLocationId = pal.ProviderAgreementLocationId                                                               
                   LEFT JOIN ProviderAgreementLocationCounty AS palc ON palc.ProviderAgreementLocationId = pal.ProviderAgreementLocationId                                                                  
                   LEFT JOIN   ProviderAgreementLocationPhoneNumber AS plph   ON plph.ProviderAgreementLocationId = pal.ProviderAgreementLocationId                                                         
                                    and plph.ProviderAgreementLocationPhoneNumberTypeKey = 'O'                                                                                                              
                    LEFT JOIN County AS con  ON con.ZipCode  = CASE WHEN paa.ZipCode ~ '^([0-9]+\\.?[0-9]*|\\.[0-9]+)$' THEN  CAST(SUBSTRING(paa.ZipCode,1,5)as int) ELSE 0 END                               
                   --LEFT JOIN County      AS con  ON con.CountyId = palc.CountyId                                                                                                                          
                   LEFT join   ProviderAgreementService AS pas  ON pas.ProviderAgreementId = PA.ProviderAgreementId                                                                                         
                   LEFT JOIN   Service      AS ser  ON ser.ServiceId = pas.ServiceId                                                                                                                        
                   LEFT JOIN PASpecialTermsNSanction     AS past ON past.ContractId = PA.ProviderAgreementId                                                                                                
                    LEFT JOIN AgencyASPENDetail AASP ON AASP.AgencyID = AG.AgencyId                                                                                                                         
                   WHERE  v_lvName IS NULL OR (AG.AgencyName ILIKE v_lvName OR ali.Name ILIKE v_lvName )                                                                                                    
                   AND  AG.ActiveFlag = COALESCE(v_liActiveFlag, AG.ActiveFlag)                                                                                                                             
                   AND  (v_lvStatus   IS NULL OR AG.AgencyStatusTypeKey = v_lvStatus)                                                                                                                       
                   AND  (v_lvAgencyType  IS NULL OR AG.AgencyTypeKey = v_lvAgencyType)                                                                                                                      
                   AND  (v_lvAgencySubType IS NULL OR AG.AgencyTypeKey = v_lvAgencySubType)                                                                                                                 
                   AND  (v_lvProviderAgreementType IS NULL OR PA.ProviderAgreementTypeKey = v_lvProviderAgreementType)                                                                                      
                   AND  (v_lvAgencyName  IS NULL OR AG.AgencyName ILIKE v_lvAgencyName)                                                                                                                     
                   AND  (v_lvSSBG   IS NULL OR PA.SSBG = v_lvSSBG)                                                                                                                                          
                   AND  (v_luRegionid   IS NULL OR con.RegionId = v_luRegionid)                                                                                                                             
                   AND  (v_liZipCode   IS NULL OR paa.ZipCode = v_liZipCode)                                                                                                                                
                   AND  (v_lvCounty   IS NULL OR con.CountyName = v_lvCounty)                                                                                                                               
                   AND  (v_lvSpecialTerms IS NULL OR past.ProviderAgreementSpecialTermTypeKey = v_lvSpecialTerms)                                                                                           
                   AND  (v_lvAssignedQAS  IS NULL OR Q.SecurityUsersId = v_lvAssignedQAS)                                                                                                                   
                   AND  (v_lvPhoneNumber  IS NULL OR plph.phoneNumber = v_lvPhoneNumber)                                                                                                                    
                   --AND  (ISNULL(@lvSanctions, '0') = '0' OR AG.AgencyId IS NOT NULL )                                                                                                                     
                   AND  (v_lvLocationFilter IS NULL  OR pal.ProviderAgreementLocationTypeKey = v_lvLocationFilter)                                                                                          
                   AND  (v_lvCategory IS NULL OR ac.AgencyCategoryKey = v_lvCategory)                                                                                                                       
                   AND  (v_lvAgencyId IS NULL OR AG.AgencyId = v_lvAgencyId)                                                                                                                                
                   AND  (v_lvCity IS NULL OR lower(TRIM(paa.City)) like ('%' || v_lvCity || '%'))                                                                                                           
                   AND  (v_lvCity IS NULL OR lower(TRIM(paa.City)) like ('%' || v_lvCity || '%'))                                                                                                           
                   AND  (v_lvAddress1 IS NULL OR paa.address LIKE ('%' || v_lvAddress1 || '%'))                                                                                                             
                   AND  (v_lvAddress2 IS NULL OR paa.address2 LIKE ('%' || v_lvAddress2 || '%'))                                                                                                            
                   AND  (v_lFACID   IS NULL OR AASP.FACID = v_lFACID)                                                                                                                                       
                   AND  (v_lServiceID IS NULL OR pas.ServiceId = v_lServiceID)                                                                                                                              
                   --AND  (NOW() BETWEEN  PA.StartDate AND PA.EndDate)                                                                                                                                      
                   --AND   PA.ProviderAgreementId IS NOT NULL                                                                                                                                               
 GROUP BY ag.agencyid,pa.ssbg,ac.Description,at.TypeDescription,q.securityusersid,paa.address,paa.city,paa.state,paa.state,paa.zipcode,plph.phonenumber,                                                    
 pa.provideragreementtypekey,pat.provideragreementtypename,ali.name,pa.provideragreementid,con.countyname,pal.provideragreementlocationtypekey,ast.typedescription,                                         
 aasp.facid;                                                                                                                                                                                                
  END IF;                                                                                                                                                                                                   
                                                                                                                                                                                                            
                                                                                                                                                                                                            
                                                                                                                                                                                                            
