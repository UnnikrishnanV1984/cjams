CREATE OR REPLACE FUNCTION provideragencysearch_cnt(searchobj json)
 RETURNS SETOF bigint
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                              
                                                                                                                                                                                                            
   DECLARE                                                                                                                                                                                                  
     v_ldNow    TIMESTAMP(3);                                                                                                                                                                               
