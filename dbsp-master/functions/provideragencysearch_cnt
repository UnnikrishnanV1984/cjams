 v_liActiveFlag1 := searchObj ->> 'activeflag1';                                                                                                                                                            
 v_ldNow := NOW();                                                                                                                                                                                          
                                                                                                                                                                                                            
 v_pagenumber := v_liPageNumber-1;                                                                                                                                                                          
 v_pageoffset = v_pagenumber * v_liPageSize;                                                                                                                                                                
                                                                                                                                                                                                            
                                                                                                                                                                                                            
   IF v_lvName IS NULL THEN                                                                                                                                                                                 
    v_lvName := '';                                                                                                                                                                                         
   END IF;                                                                                                                                                                                                  
