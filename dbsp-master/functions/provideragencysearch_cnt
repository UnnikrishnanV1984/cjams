 v_lvAgencyId := searchObj ->> 'agencyid';                                                                                                                                                                  
 v_lvCity  := lower(searchObj ->> 'city');                                                                                                                                                                  
 v_lvState := searchObj ->> 'state';                                                                                                                                                                        
 v_lvAddress1 := searchObj ->> 'address1';                                                                                                                                                                  
 v_lvAddress2 := searchObj ->> 'address2';                                                                                                                                                                  
 v_lFACID  := searchObj ->> 'facid';                                                                                                                                                                        
 v_lServiceID := searchObj ->> 'serviceid';                                                                                                                                                                 
 v_lServiceRequestID  := searchObj ->> 'servicerequestid';                                                                                                                                                  
