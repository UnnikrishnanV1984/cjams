 BEGIN                                                                                                                                                                                                      
                                                                                                                                                                                                            
 v_liPageNumber := searchObj ->> 'pagenumber' ;                                                                                                                                                             
 v_liPageSize := searchObj ->> 'pagesize' ;                                                                                                                                                                 
 v_lvName := searchObj ->> 'name';                                                                                                                                                                          
 v_lvStatus := searchObj ->> 'status';                                                                                                                                                                      
 v_lvSSBG := searchObj ->> 'ssbg';                                                                                                                                                                          
 v_lvAgencyType := searchObj ->> 'agencytype';                                                                                                                                                              
 v_lvAgencySubType := searchObj ->> 'agencysubtype';                                                                                                                                                        
 v_luRegionid := searchObj ->> 'region';                                                                                                                                                                    
 v_lvAssignedQAS := searchObj ->> 'assignedqas';                                                                                                                                                            
 v_lvSpecialTerms := searchObj ->> 'specialterms';                                                                                                                                                          
 v_lvSanctions := searchObj ->> 'sanctions';                                                                                                                                                                
 v_liActiveFlag := searchObj ->> 'activeflag';                                                                                                                                                              
 v_liCount := searchObj ->> 'count';                                                                                                                                                                        
 v_lvSortCol := searchObj ->> 'sortcol';                                                                                                                                                                    
 v_lvSortDir := searchObj ->> 'sortdir';                                                                                                                                                                    
 v_lvCounty := searchObj ->> 'county';                                                                                                                                                                      
 v_liZipCode := searchObj ->> 'zipcode';                                                                                                                                                                    
 v_lvAgencyName := searchObj ->> 'agencyname';                                                                                                                                                              
 v_liFiscalYear := searchObj ->> 'fiscalyear';                                                                                                                                                              
 v_lvProviderAgreementType := searchObj ->> 'provideragreementtype';                                                                                                                                        
 v_lvLocationFilter := searchObj ->> 'locationfilter';                                                                                                                                                      
 v_lvPhoneNumber := searchObj ->> 'phonenumber';                                                                                                                                                            
