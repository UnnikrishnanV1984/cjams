CREATE OR REPLACE FUNCTION prov_getabpsites(reqjson json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
jsondata  json;
v_abpid character varying;

BEGIN

v_abpid = reqjson->>'object_id';


SELECT  Json_agg(a)  INTO  jsondata  FROM  (

select
count(1) over() as totalcount,
    t.*
    from
    (select tabp.site_id, tabp.object_id, tabp.ann_budget_mapping_id, p.provider_nm ,tpl.license_no, tpl.license_level, tpl.license_type
        from tb_annualbudgetmappings tabp
        join prov.tb_provider p on p.provider_id = tabp.site_id and p.delete_sw = 'N'
        join prov.tb_provider_licensing tpl on tpl.site_id = tabp.site_id and tpl.delete_sw = 'N' and tpl.active_sw ='Y'
        where tabp.delete_sw = 'N'
        and tabp.object_id = v_abpid
    ) t 
)  a;

RETURN  jsondata;
END;

$function$

