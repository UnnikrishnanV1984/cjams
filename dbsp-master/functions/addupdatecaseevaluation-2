           v_caseevaluation->>'updatedby',
           v_caseevaluation->>'updatedon',
           v_caseevaluation->>'activeflag',
           v_caseevaluation->>'fmlyclosingreasontypekey',
           v_caseevaluation->>'fmlyclosingreason',
           v_caseevaluation->>'concurtypekey',
           v_caseevaluation->>'concurrecommendation',
           v_caseevaluation->>'safedate',
           v_caseevaluation->>'safetydecisiontypekey',
           v_caseevaluation->>'safetyplaninitiatedflag',
           v_caseevaluation->>'riskassessmentdate',
           v_caseevaluation->>'overallriskrating',
           v_caseevaluation->>'summary',
           v_caseevaluation->>'serviceplanid',
           v_caseevaluation->>'old_id',
           v_caseevaluation->>'approvalagencyflag',
           v_caseevaluation->>'adminextnsinfsflag',
