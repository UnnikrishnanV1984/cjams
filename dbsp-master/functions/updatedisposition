CREATE OR REPLACE FUNCTION updatedisposition(v_intakeserviceid uuid)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE


v_date  timestamp    without    time    zone;
v_intakeserreqstatustypeid uuid;

begin
 
  v_date :=  now()    at    time    zone    'utc';
  v_intakeserreqstatustypeid := (select intakeserreqstatustypeid from intakeserreqstatustype where intakeserreqstatustypekey = 'Closed' limit 1);
  
  
update intakeservicerequest set exitdate = v_date, intakeserreqstatustypeid = v_intakeserreqstatustypeid
where intakeserviceid = v_intakeserviceid;

    RETURN    'SUCCESS';    
END;    

$function$

