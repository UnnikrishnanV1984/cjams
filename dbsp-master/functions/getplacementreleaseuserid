CREATE OR REPLACE FUNCTION getplacementreleaseuserid(v_placementid uuid)
 RETURNS TABLE(userid character varying, placementtype json)
 LANGUAGE plpgsql
AS $function$
 
begin
 RETURN query
select tma.securityusersid as userid,(select json_agg(a) from (select pr.providername,pl.intakeserviceid,pr.providercategorytypekey,p.firstname,p.lastname,pr.providercategorytypekey from placement pl
left join provider pr 
on pr.providerid = pl.providerid
left join intakeservicerequestactor insra 
   on insra.intakeserviceid = pl.intakeserviceid and insra.activeflag =1 and insra.intakeservicerequestpersontypekey = 'Youth'
left join person p 
   on p.personid = insra.personid and p.activeflag =1
where placementid=v_placementid limit 1)a) as placementtype from team t 
left join teammember tm 
    on tm.teamid = t.teamid 
left join teammemberassignment tma 
    on tma.teammemberid = tm.teammemberid
where t.teamname = 'Titleive-Unit';
end;
 
$function$

