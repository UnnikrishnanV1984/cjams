CREATE OR REPLACE FUNCTION as_getassesmentprepopulation(v_intakeserviceid uuid, v_securityuserid character varying)
 RETURNS TABLE(youthname character varying, firstname character varying, lastname character varying, suffix character varying, dateofbirth character varying, youthage character varying, cjamspid bigint, casenumber character varying, address character varying, zipcode character varying, city character varying, state character varying, country character varying, race character varying, height_in character varying, weight_lbs character varying, gender character varying, hair_color character varying, eye_color character varying, tattoo character varying, youthethnicity character varying, youthstatus character varying, phone character varying, providername character varying, agency character varying, agencyaddress character varying, admissiondate character varying, currentdate date, county character varying, offense character varying[], cw_name character varying, adjudicationdate character varying, parentguaridanname character varying, relationship character varying, parentcontactnumber character varying, parentaddress1 character varying, parentaddress2 character varying, parentzipcode character varying, parentcity character varying, parentcounty character varying, parentstate character varying, parentemail character varying, sendingstate character varying, receivingstate character varying, casesupervisorname character varying, petitionnumber character varying, judgename character varying, disposition character varying, maxdateofexpiration character varying, livingwithflag boolean, rel_name character varying, living_relationship character varying, rel_addr1 character varying, rel_addr2 character varying, rel_county character varying, rel_city character varying, rel_state character varying, rel_zipcode character varying, rel_phonenumber character varying, rel_email character varying, rel_primary_phone character varying, rel_sec_phone character varying, youthcounty character varying, mothername character varying, fathername character varying, progressnotes jsonb, youthssn character varying, youthstateid character varying, youth_maritalstatus character varying)
 LANGUAGE plpgsql
AS $function$

declare
v_intakenumber character varying;
assessmentname character varying;
adjudicationdate character varying ;
parentguaridanname character varying;
relationship character varying;
parentcontactnumber character varying;
parentaddress1 character varying;
parentaddress2 character varying;
parentzipcode character varying;
parentcity character varying;
parentcounty character varying;
parentstate character varying;
parentemail character varying;
livingwithflag boolean;
rel_name character varying;
living_relationship character varying;
rel_addr1 character varying;
rel_addr2 character varying;
rel_county character varying;
rel_city character varying;
rel_state character varying;
rel_zipcode character varying;
rel_phonenumber character varying;
rel_email character varying;
rel_primary_phone character varying;
rel_sec_phone character varying;
v_mothername character varying;
v_fathername character varying;
v_progressnotes jsonb;

begin
 select 
  intakenumber into v_intakenumber 
 from intakeservicerequest where activeflag =1 and intakeserviceid = v_intakeserviceid;

 select 
  cast(to_char(ica.adjudicationdatetime,'MM/DD/YYYY') as character varying) into adjudicationdate
 from intakeservicerequestcourthearing ich 
 join intakeservicerequestcourtaction  ica on ich.intakeservicerequestcourthearingid = ica.intakeservicerequestcourthearingid
 where  ica.activeflag =1 
 and ich.activeflag = 1
 and ich.hearingtypekey ='Adjudi'
 and ich.intakenumber = v_intakenumber;

 select  
  cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying),
  cast(ac.relationshiptypekey as character varying),
  cast(coalesce(pph.phoneextension,'000')||pph.phonenumber as character varying),
  cast(pa.address as character varying) ,
  cast(pa.address2 as character varying),
  cast(pa.zipcode as character varying),
  cast(pa.city as character varying),
  cast(pa.county as character varying),
  cast(pa.state as character varying),
  cast(pe.email as character varying)
  into parentguaridanname,relationship,parentcontactnumber,parentaddress1,parentaddress2,parentzipcode,parentcity,parentcounty,parentstate,parentemail
 from intakeservicerequestactor isra  
 left join actorrelationship ac on ac.intakeservicerequestactorid = isra.intakeservicerequestactorid
 join actor a on a.actorid = isra.actorid and a.activeflag =1
 join person p on p.personid = a.personid and p.activeflag = 1
 left join (select ph.phoneextension,ph.phonenumber,ph.personid from personphonenumber ph left join personphonetype pp on ph.personphonetypekey = pp.personphonetypekey and ph.activeflag =1 and pp.activeflag =1 order by pp.sequencenumber limit 1)pph on pph.personid = p.personid 
 left join (select ad.* from personaddress ad left join personaddresstype pat on ad.personaddresstypekey = pat.personaddresstypekey and pat.activeflag = 1 and ad.activeflag = 1 order by pat.sequencenumber limit 1)pa on pa.personid = p.personid 
 left join (select e.* from personemail e left join personemailtype pet on e.personemailtypekey = pet.personemailtypekey and e.activeflag =1 and pet.activeflag =1 order by pet.sequencenumber limit 1)pe on pe.personid = p.personid 
 join (select 1 as seq,'father' as relation union 
   select 2 as seq,'mother' as relation union
   select 3 as seq,'fosterparent' as relation union 
   select 4 as seq,'stepparent' as relation union
   select 5 as seq,'adoptiveparent' as relation union 
   select 6 as seq,'guardian' as relation)rel on rel.relation = ac.relationshiptypekey 
 where isra.intakeserviceid=v_intakeserviceid
 order by rel.seq limit 1;


 --select titleheadertext into assessmentname from assessmenttemplate where assessmenttemplateid=v_templateid;
 select pr.livingwith,
  cast(INITCAP(TRIM(coalesce(relperson.lastname,''))|| CASE WHEN (relperson.suffix is not null and p.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(relperson.suffix,'')) || ', ' ||TRIM(coalesce(relperson.firstname,''))) as  character varying),
  cast(pr.actorrelationshipkey as character varying),
  cast(reladdr.address as character varying),
  cast(reladdr.address2 as character varying),
  cast(reladdr.county as character varying),
  cast(reladdr.city as character varying),
  cast(reladdr.state as character varying),
  cast(reladdr.zipcode as character varying),
  cast(coalesce(relphone.phoneextension,'000')||relphone.phonenumber as character varying),
  cast(rel_email.email as character varying),
  cast((select coalesce(ph.phoneextension,'000')||ph.phonenumber from personphonenumber ph where ph.personid = relperson.personid and ph.activeflag =1 and ph.personphonetypekey = 'P' limit 1) as character varying),
  cast((select coalesce(ph.phoneextension,'000')||ph.phonenumber from personphonenumber ph where ph.personid = relperson.personid and ph.activeflag =1 and ph.personphonetypekey = 'S' limit 1) as character varying)
  into livingwithflag,rel_name,living_relationship,rel_addr1,rel_addr2,rel_county,rel_city,rel_state,rel_zipcode,rel_phonenumber,rel_email,rel_primary_phone,rel_sec_phone
 from intakeservicerequest isr 
 left join intakeservicerequestactor ISRA on ISRA.intakeserviceid = isr.intakeserviceid and isr.activeflag = 1
 left join actor a on ISRA.actorid = a.actorid and a.activeflag = 1
 left join person p on p.personid = a.personid and p.activeflag = 1
 left join personrelation pr on pr.personid = p.personid and pr.activeflag = 1
 left join person relperson on pr.personrelativeid = p.personid and relperson.activeflag = 1
 left join (select ad.* from personaddress ad left join personaddresstype pat on ad.personaddresstypekey = pat.personaddresstypekey and pat.activeflag = 1 and ad.activeflag = 1 order by pat.sequencenumber limit 1) reladdr on reladdr.personid = p.personid 
 left join (select ph.phoneextension,ph.phonenumber,ph.personid from personphonenumber ph left join personphonetype pp on ph.personphonetypekey = pp.personphonetypekey and ph.activeflag =1 and pp.activeflag =1 order by pp.sequencenumber limit 1) relphone on relphone.personid = relperson.personid 
 left join (select e.* from personemail e left join personemailtype pet on e.personemailtypekey = pet.personemailtypekey and e.activeflag =1 and pet.activeflag =1 order by pet.sequencenumber limit 1) rel_email on rel_email.personid = relperson.personid 
 where ISRA.intakeservicerequestpersontypekey = 'Youth' 
 and isr.intakeserviceid = v_intakeserviceid;

 select  
  max(case when ac.relationshiptypekey ilike 'mother' then cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying) else null end) as mothername,
  max(case when ac.relationshiptypekey ilike 'father' then cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying) else null end) as fathername
  into v_mothername,v_fathername
 from intakeservicerequestactor isra  
 left join actorrelationship ac on ac.intakeservicerequestactorid = isra.intakeservicerequestactorid and ac.activeflag = 1
 join actor a on a.actorid = isra.actorid and a.activeflag =1
 join person p on p.personid = a.personid and p.activeflag = 1
 where isra.activeflag = 1 and isra.intakeserviceid=v_intakeserviceid;

 select jsonb_agg(prgnotes) from (
  select distinct count(*) over() as reccount,  
   cast(coalesce (pn.contactdate, pn.insertedon) as date) as contactdate,
   pn.description as description,
   coalesce(pnt.progressnotetypekey, '') as contactype
  from intakeservicerequest isr                           
  join progressnote pn on cast(isr.intakeserviceid as character varying) = pn.entitytypeid AND pn.activeflag= 1
  join progressnotetype pnt on pnt.progressnotetypeid = pn.progressnotetypeid  AND pnt.activeflag= 1
  where isr.intakeserviceid = v_intakeserviceid and isr.activeflag = 1
 )prgnotes into v_progressnotes;

 return query

 select  -- assessmentname,
  distinct
  cast(INITCAP(TRIM(coalesce(p.lastname,''))|| CASE WHEN (p.suffix is not null and p.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(p.suffix,'')) || ', ' ||TRIM(coalesce(p.firstname,''))) as  character varying)   as youthname,
  p.firstname,
  p.lastname,
  p.suffix,
  cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,
  cast(age(now()::date,p.dob) as character varying) as youthage,
  p.cjamspid,
  isr.servicerequestnumber as casenumber,
  CAST(pa.address as character varying) as address,
  CAST(pa.zipcode as character varying) as zipcode,
  CAST(pa.city as character varying) as city,
  CAST(pa.state as character varying) as state,
  CAST(pa.country as character varying) as country,
  (select distinct typedescription from racetype where racetypekey=p.racetypekey) as race,                                                                                                                                                                                                                                                                                                                                             
  cast((select attributevalue from personphysicalattribute where physicalattributetypekey='Ht' and activeflag=1 and personid=p.personid) as character varying) as height_in,                                                                                                                                                                                                                                                                                                                                                                                 
  cast((select attributevalue from personphysicalattribute where physicalattributetypekey='Wt' and activeflag=1 and personid=p.personid) as character varying) as weight_lbs,                                                                                                                                                                                                                                                                                                                                                                                   
  (select distinct typedescription from gendertype where gendertypekey=p.gendertypekey) as gender,                                                                                                                                                                                                                                                                                                                                     
  cast((select attributevalue from personphysicalattribute where physicalattributetypekey='Haircolor' and activeflag=1 and personid=p.personid) as character varying) as hair_color, 
  cast((select attributevalue from personphysicalattribute where physicalattributetypekey='Eyecolor' and activeflag=1 and personid=p.personid) as character varying) as eye_color,  
  cast((select attributevalue from personphysicalattribute where physicalattributetypekey='Tattoo' and activeflag=1 and personid=p.personid) as character varying) as tattoo,  
  cast((select typedescription from ethnicgrouptype where activeflag=1 and ethnicgrouptypekey=p.ethnicgrouptypekey) as character varying) as youthethnicity,  
  cast((select string_agg(description,',') from as_listfocuspersoncasestatus(isr.intakeserviceid,isr.intakenumber,p.personid, 'Open', null, null, false)) as character varying) as youthstatus,
  CAST(ppn.phonenumber as character varying) as phone,
  pro.providername,
  esa.description as agency,
  CAST(es.streetno||', '||es.street1||', '|| es.street2 as character varying) as agencyaddress,
  cast(to_char(pl.addate,'MM/DD/YYYY') as character varying)  as admissiondate,
  now()::date as currentdate,
  c.countyname,
  (select array_agg(cast(alg.name  as character varying ))
  from intakeservicerequestevaluation isre
  join intakeservicerequestevaluationconfig isrec on isre.intakeservicerequestevaluationid = isrec.intakeservicerequestevaluationid
  join allegation alg on alg.allegationid = isrec.allegationid and alg.activeflag = 1
  where isre.intakenumber = isr.intakenumber) as offense,
  (select displayname from userprofile where securityusersid = v_securityuserid) as cw_name,
  adjudicationdate ,
  parentguaridanname ,
  relationship ,
  parentcontactnumber ,
  parentaddress1 ,
  parentaddress2 ,
  parentzipcode ,
  parentcity ,
  parentcounty ,
  parentstate ,
  parentemail ,
  cast((select distinct statename from state where stateabbr = isri.demandingstate) as character varying)  as sendingstate,
  cast((select distinct statename from state where stateabbr = (select c.state from county c where c.countyid=isri.countyid)) as character varying)  as receivingstate,
  cast(sup.supname as character varying) as casesupervisorname,
  cast(isrp.petitionid as character varying) as petitionnumber ,
  cast(iscra.legalcounselname as character varying) as judgename,
  cast(iscra.conditiontypedescription  as character varying) as disposition,
  cast(isri.maxdateofexpiration as character varying) as maxdateofexpiration,
  livingwithflag,
  rel_name,
  living_relationship,
  rel_addr1,
  rel_addr2,
  rel_county,
  rel_city,
  rel_state,
  rel_zipcode,
  rel_phonenumber,
  rel_email,
  rel_primary_phone,
  rel_sec_phone,
  cast(pa.county as character varying) as youthcounty,
  v_mothername,
  v_fathername,
  v_progressnotes as progressnotes,
  pidn.personidentifiervalue as youthssn,
  p.stateid as youthstateid,
  cast((select typedescription from maritalstatustype where activeflag=1 and maritalstatustypekey=p.maritalstatustypekey) as character varying) as youth_maritalstatus
 from intakeservicerequest isr 
 left join intakeservicerequestevaluation inve on isr.intakenumber=inve.intakenumber
 left join evaluationsource es on es.evaluationsourceid=inve.evaluationsourceid and es.activeflag=1
 left join evaluationsourceagency esa on es.evaluationsourceagencykey=esa.evaluationsourceagencykey 
 left join intakeservicerequestactor ISRA on ISRA.intakeserviceid = isr.intakeserviceid and isr.activeflag = 1
 left join person p on p.personid = ISRA.personid and p.activeflag = 1 and ISRA.activeflag = 1
 left join personphonenumber ppn on p.personid = ppn.personid and ppn.activeflag=1
 left join placement pl on pl.intakeserviceid = ISRA.intakeserviceid and pl.activeflag = 1
 left join provider pro on pro.providerid = pl.providerid and pro.activeflag = 1
 left join personaddress  pa on pa.personid = p.personid and pa.activeflag=1
 left join personidentifier pidn on pidn.personid = p.personid and pidn.activeflag = 1 and pidn.personidentifiertypekey = 'SSN'
 left join county c on (c.countyname = pa.county or c.countycode= pa.county) and c.activeflag = 1
 left join intakeserreqinterstate isri on isri.intakeserviceid=isr.intakeserviceid and isri.activeflag=1
 left join (select *,row_number() over(partition by intakenumber order by updatedon desc) as recno from intakeservicerequestcourthearing) ich on ich.intakenumber = isr.intakenumber and ich.activeflag = 1 and ich.recno = 1 
 left join intakeservicerequestcourtaction iscra on iscra.intakeservicerequestcourthearingid = ich.intakeservicerequestcourthearingid and iscra.activeflag = 1
 left join intakeservreqpetitionhearingconfig ichc on ichc.intakeservicerequestcourthearingid = ich.intakeservicerequestcourthearingid and ichc.activeflag = 1
 left join intakeservicerequestpetition isrp on isrp.intakeservicerequestpetitionid = ichc.intakeservicerequestpetitionid and isrp.activeflag = 1
 left join (select objectid,up.fullname as supname from routing  join userprofile up
 on routing.tosecurityusersid=up.securityusersid and up.activeflag=1 and routing.toroleid='JSSP'  ) sup
 on isr.intakenumber=sup.objectid
 where ISRA.intakeservicerequestpersontypekey = 'Youth' 
 and isr.intakeserviceid = v_intakeserviceid;

end;
$function$

