            vl_other_id,
            vs_transaction_type_cd,
            vl_transaction_sequence,
            vd_transaction_ts
             );
             
 if vl_output_sqlcode <> '00000' then vs_excep_message := '01-' || vs_message || ';' ;
  -- RETURN;
 end if ;

