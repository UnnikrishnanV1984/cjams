CREATE OR REPLACE FUNCTION prov_addupdateproviderstaffclearnce(updatedtlsobj json)
 RETURNS TABLE(status text, providerstaff_id uuid)
 LANGUAGE plpgsql
AS $function$ 

DECLARE
    v_provstaff_id uuid;
    returnStatus text;
    v_Securityuserid text;
    v_provstaffhistory uuid;

BEGIN
    v_provstaff_id := updatedtlsobj->>'provider_staff_id';
    v_Securityuserid := updatedtlsobj->>'securityuserid';
    v_provstaffhistory := updatedtlsobj->>'provider_staffclearnce_history_id';
    IF(v_provstaff_id IS NOT NULL ) THEN 

        IF (v_provstaffhistory IS NOT NULL) THEN
            UPDATE tb_prov_staffclearnce_history SET  
            provider_staff_id = v_provstaff_id,
            cps_clearance_request_date = (updatedtlsobj ->> 'cps_clearance_request_date')::date,
            cps_clearance_result_date = (updatedtlsobj ->> 'cps_clearance_result_date')::date,
            cps_rcc_compliant = updatedtlsobj ->> 'cps_rcc_compliant',
            cps_cpa_compliant = updatedtlsobj ->> 'cps_cpa_compliant',
            cps_compliance_documentation = (updatedtlsobj ->> 'cps_compliance_documentation')::boolean,
            federal_clearance_request_date = (updatedtlsobj ->> 'federal_clearance_request_date')::date,
            federal_clearance_result_date = (updatedtlsobj ->> 'federal_clearance_result_date')::date,
            federal_rcc_compliant = updatedtlsobj ->> 'federal_rcc_compliant',
            federal_cpa_compliant = updatedtlsobj ->> 'federal_cpa_compliant',
            federal_compliance_documentation = (updatedtlsobj ->> 'federal_compliance_documentation')::boolean,
            state_clearance_request_date = (updatedtlsobj ->> 'state_clearance_request_date')::date,
            state_clearance_result_date = (updatedtlsobj ->> 'state_clearance_result_date')::date,
            state_rcc_compliant = updatedtlsobj ->> 'state_rcc_compliant',
            state_cpa_compliant = updatedtlsobj ->> 'state_cpa_compliant',
            state_compliance_documentation = (updatedtlsobj ->> 'state_compliance_documentation')::boolean,
            create_ts = now()::timestamp,
            create_user_id = v_Securityuserid, 
            update_ts = now()::timestamp,
            update_user_id = v_Securityuserid,
            delete_sw = 'N'::bpchar,
            active_flag =1
        WHERE provider_staffclearnce_history_id = v_provstaffhistory;
        ELSE
        INSERT INTO tb_prov_staffclearnce_history
            (provider_staffclearnce_history_id, provider_staff_id, 
            cps_clearance_request_date, cps_clearance_result_date, 
            cps_rcc_compliant, cps_cpa_compliant,
            cps_compliance_documentation, 
            federal_clearance_request_date, federal_clearance_result_date, 
            federal_rcc_compliant, federal_cpa_compliant, 
            federal_compliance_documentation,
            state_clearance_request_date, state_clearance_result_date, 
            state_rcc_compliant, state_cpa_compliant, 
            state_compliance_documentation,
            create_ts, create_user_id, update_ts, 
            update_user_id, delete_sw, active_flag)
        VALUES(gen_random_uuid(), v_provstaff_id, 
            (updatedtlsobj->>'cps_clearance_request_date')::date,(updatedtlsobj->>'cps_clearance_result_date')::date, 
            updatedtlsobj->>'cps_rcc_compliant',updatedtlsobj->>'cps_cpa_compliant', 
            (updatedtlsobj ->> 'cps_compliance_documentation')::boolean,
            (updatedtlsobj->>'federal_clearance_request_date')::date,(updatedtlsobj->>'federal_clearance_result_date')::date, 
            updatedtlsobj->>'federal_rcc_compliant',updatedtlsobj->>'federal_cpa_compliant',
            (updatedtlsobj ->> 'federal_compliance_documentation')::boolean, 
            (updatedtlsobj->>'state_clearance_request_date')::date,(updatedtlsobj->>'state_clearance_result_date')::date, 
            updatedtlsobj->>'state_rcc_compliant', updatedtlsobj->>'state_cpa_compliant',
            (updatedtlsobj ->> 'state_compliance_documentation')::boolean,
            now()::timestamp, v_Securityuserid, now()::timestamp,v_Securityuserid,'N'::bpchar,1);
        END IF;
        UPDATE providerstaff SET  
            cps_clearance_request_date = (updatedtlsobj ->> 'cps_clearance_request_date')::date,
            cps_clearance_result_date = (updatedtlsobj ->> 'cps_clearance_result_date')::date,
            cps_rcc_compliant = updatedtlsobj ->> 'cps_rcc_compliant',
            cps_cpa_compliant = updatedtlsobj ->> 'cps_cpa_compliant',
            cps_compliance_documentation = (updatedtlsobj ->> 'cps_compliance_documentation')::boolean,
            federal_clearance_request_date = (updatedtlsobj ->> 'federal_clearance_request_date')::date,
            federal_clearance_result_date = (updatedtlsobj ->> 'federal_clearance_result_date')::date,
            federal_rcc_compliant = updatedtlsobj ->> 'federal_rcc_compliant',
            federal_cpa_compliant = updatedtlsobj ->> 'federal_cpa_compliant',
            federal_compliance_documentation = (updatedtlsobj ->> 'federal_compliance_documentation')::boolean,
            state_clearance_request_date = (updatedtlsobj ->> 'state_clearance_request_date')::date,
            state_clearance_result_date = (updatedtlsobj ->> 'state_clearance_result_date')::date,
            state_rcc_compliant = updatedtlsobj ->> 'state_rcc_compliant',
            state_cpa_compliant = updatedtlsobj ->> 'state_cpa_compliant',
            state_compliance_documentation = (updatedtlsobj ->> 'state_compliance_documentation')::boolean
        WHERE provider_staff_id = v_provstaff_id;

        returnStatus := 'Success';

    ELSE
        returnStatus := 'failed';

    END IF;

    RETURN query
        SELECT returnStatus, v_provstaff_id;                                                
END;

$function$

