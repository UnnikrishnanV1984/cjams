CREATE OR REPLACE FUNCTION sp_cares_outbound_interface_gen_data_01(vl_client_id integer, vl_other_id bigint, vs_transaction_type_cd character varying, vl_transaction_sequence integer, vd_transaction_ts timestamp without time zone, OUT vs_message character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$\r
------------------------------------------------------------------------\r
-- SQL Stored Procedure\r
-- Author: Sudhin\r
-- Date Created :08/25/2005\r
-- generates Cares Interface Outbound Data\r
\r
-- Revision(s)\r
-- 5/31/06 - Tanya Lee - Incident #7739 -- Updated eligibility fields to look at FC and Adoption\r
-- 02/09/2007 - Sandhya -- #12329    - Added condition for transaction type = '15' (Subsidy Guardianship)\r
-- 02/16/07 - sandhya - #12329 - Added condition before disability for no records found.\r
-- #12329 02/19/07 - sandhya - default dates to null for subsidy guardianship\r
-- #7739 04/18/07  -- sandhya - To pick Transaction date when eligibility status has been end dated.\r
-- 04.10.08 -#17248 sandhya-  Check for telephone nos having spaces and store zeros in place.\r
-- 04.14.2010 --GAYATHRI RAJUKMAR - MAPPED DECLINED RACE TO UNKNOWN\r
-- 26.06.2019 --- Ram Kumar changes are commented with tag #26062019\r
-- 06/10/2020 Vineet Tirodkar - To fix the get Caseworker & get Case county logic.\r
-- 06/24/2020 Vineet Tirodkar - To modify logic to send Gender as 'U' for all other types than Male & Female \r
-- 06/30/2020 Vineet Tirodkar - Modifications to send 'Unknown' for racetypekey 'Other' ro any not known code to MD CHESSIE \r
-- 07/06/2020 Vineet Tirodkar - To report Person's Insurance info use personhealthinsurance table (Instead of personinsurance)\r
-- 08/20/2020 Vineet Tirodkar - Modifications to send only Valid (Numeric) SSN attribute values (CDM-3270)\r
-- 09/25/2020 Vineet Tirodkar - Changes to trim and compare Eligibility Status Code (CDM-4684)\r
-- 10/05/2020 Vineet Tirodkar - Changes to send first 50 characters only for Person’s educationname (CIDM-1010)\r
-- 03/08/2021 Vineet Tirodkar - Modifications for person name suffix logic fix (CIDM-2203)\r
-- 03/11/2021 Vineet Tirodkar - Modifications to get the personaddress using personid (uuid) (CIDM-2203)\r
-- 08/03/2021 Vineet Tirodkar - Modifications to send Client Person First/Last Names first 20 characters only \r
--        and Middle Name first 10 characters (CDM-15668)\r
-- 11/02/2021 Vineet Tirodkar - Modifications to send numeric values for telephone numbers (CIDM-4020)\r
------------------------------------------------------------------------\r
\r
DECLARE VS_RECORD_TYPE VARCHAR(2);\r
VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';\r
VL_RECORD_SEQUENCE INTEGER DEFAULT 000;\r
VS_TRANSACTION_SEQUENCE VARCHAR(5);\r
VS_RECORD_SEQUENCE VARCHAR(3);\r
  -- Client Variables\r
VL_STAFF_ID VARCHAR;\r
VL_TRANSACTION_DATE INTEGER;   -- CARES_OUT_COL1\r
VS_PLACEMENT_STRUCTURE_ID CHAR(1); -- CARES_OUT_COL2\r
VS_PRIMARY_COUNTY_CD CHAR(2);   -- CARES_OUT_COL3\r
VS_WORKER_NAME VARCHAR(50);     -- CARES_OUT_COL4\r
VS_WORKER_PHONE VARCHAR(32);        -- CARES_OUT_COL5\r
VS_CIS_CLIENT_ID VARCHAR(10);      --  CARES_OUT_COL6\r
VS_CLIENT_SURNAME VARCHAR(20);  --  CARES_OUT_COL7\r
VS_CLIENT_GIVENNAME VARCHAR(20); -- CARES_OUT_COL8\r
VS_CLIENT_MIDDLENAME VARCHAR(10); -- CARES_OUT_COL9\r
VS_CLIENT_SUFFIX VARCHAR(5);     -- CARES_OUT_COL10  \r
VS_AKA_LAST_NM VARCHAR(20);       -- CARES_OUT_COL11\r
VL_SSN_NO VARCHAR;                 -- CARES_OUT_COL12\r
VL_DOB_DT INTEGER;                  -- CARES_OUT_COL13\r
VS_CLIENT_GENDER CHAR(1);           -- CARES_OUT_COL14 \r
VS_CLIENT_RACE VARCHAR(20);          -- CARES_OUT_COL15 -- length increased #26062019\r
VL_PLACEMENT_START_DATE INTEGER;   -- CARES_OUT_COL16\r
VL_PLACEMENT_END_DATE INTEGER;     -- CARES_OUT_COL17\r
VS_PLACEMENT_NAME VARCHAR(100);     -- CARES_OUT_COL18\r
VS_LONG_TERM_CF_INDICATOR CHAR(1);    -- CARES_OUT_COL19\r
VL_LTCF_ADMISSION_DATE INTEGER;       -- CARES_OUT_COL20\r
VL_LTCF_DISCHARGE_DATE INTEGER;       -- CARES_OUT_COL21\r
VL_PROVIDER_ID INTEGER;\r
VL_PLACEMENT_CASE_ID BIGINT;\r
VS_CLIENT_BIRTH_HOSPITAL VARCHAR(50);  -- CARES_OUT_COL22\r
VS_CLIENT_BIRTH_CITY VARCHAR(50);      -- CARES_OUT_COL23\r
VS_CLIENT_BIRTH_STATE CHAR(2);         -- CARES_OUT_COL24\r
VS_CLIENT_MARITAL_STATUS VARCHAR(5);    -- CARES_OUT_COL25\r
VS_CLIENT_RESIDENCY_STATUS CHAR(1);    -- CARES_OUT_COL26\r
VS_CLIENT_DISABLED CHAR(1) default 'N';             -- CARES_OUT_COL27\r
VS_CLIENT_PHYSICAL_DISABILITY CHAR(2);   -- CARES_OUT_COL28\r
VS_CLIENT_MENTAL_DISABILITY CHAR(2);      -- CARES_OUT_COL29\r
VS_CLIENT_VISUAL_DISABILITY CHAR(2);       -- CARES_OUT_COL30\r
VS_CLIENT_HEARING_DISABILITY CHAR(2);     -- CARES_OUT_COL31\r
VS_CLIENT_MENTAL_RETARDATION CHAR(2);      -- CARES_OUT_COL32\r
VS_CLIENT_LEARNING_DISABILITY CHAR(2);      -- CARES_OUT_COL33\r
VS_CLIENT_COGNITIVE_DISABILITY CHAR(2);  -- CARES_OUT_COL34\r
VS_CLIENT_DEV_DELAY_DISABILITY CHAR(2);   -- CARES_OUT_COL35\r
VS_CLIENT_OTHER_DISABILITY CHAR(2);       -- CARES_OUT_COL36\r
VS_CLIENT_MEDICAL_INSURANCE CHAR(1);      -- CARES_OUT_COL37\r
CARES_OUT_COL38 CHAR(1);\r
CARES_OUT_COL39 INTEGER;\r
CARES_OUT_COL40 INTEGER;\r
CARES_OUT_COL41 INTEGER;\r
CARES_OUT_COL42 DECIMAL(10,2);\r
CARES_OUT_COL42_CONVERT VARCHAR(15);\r
CARES_OUT_COL43 VARCHAR(50);\r
VL_PRIMARY_CAREGIVER_ID INTEGER;\r
CARES_OUT_COL44 CHAR(3);\r
CARES_OUT_COL45 VARCHAR(9); -- INTEGER\r
CARES_OUT_COL46 VARCHAR(50);\r
CARES_OUT_COL47 CHAR(5);\r
CARES_OUT_COL48 CHAR(3);\r
CARES_OUT_COL49 CHAR(5);\r
CARES_OUT_COL50 VARCHAR(50);\r
CARES_OUT_COL51 CHAR(2);\r
CARES_OUT_COL52 INTEGER;\r
CARES_OUT_COL53 CHAR(3);\r
CARES_OUT_COL54 VARCHAR(9); -- INTEGER\r
CARES_OUT_COL55 VARCHAR(50);\r
CARES_OUT_COL56 CHAR(5);\r
CARES_OUT_COL57 CHAR(3);\r
CARES_OUT_COL58 CHAR(5);\r
CARES_OUT_COL59 VARCHAR(50);\r
CARES_OUT_COL60 CHAR(2);\r
CARES_OUT_COL61 INTEGER;\r
CARES_OUT_COL62 VARCHAR(32);\r
CARES_OUT_COL63 VARCHAR(100);\r
CARES_OUT_COL64 CHAR(3);\r
CARES_OUT_COL65 VARCHAR(9); -- INTEGER\r
CARES_OUT_COL66 VARCHAR(50);\r
CARES_OUT_COL67 CHAR(5);\r
CARES_OUT_COL68 CHAR(3);\r
CARES_OUT_COL69 CHAR(5);\r
CARES_OUT_COL70 VARCHAR(50);\r
CARES_OUT_COL71 CHAR(2);\r
CARES_OUT_COL72 INTEGER;\r
CARES_OUT_COL73 VARCHAR(10);\r
VL_ADOPTIVE_FATHER_ID INTEGER;\r
VL_ADOPTIVE_MOTHER_ID INTEGER;\r
CARES_OUT_COL74 VARCHAR(20);\r
CARES_OUT_COL75 VARCHAR(20);\r
CARES_OUT_COL76 VARCHAR(10);\r
CARES_OUT_COL77 CHAR(5);\r
CARES_OUT_COL78 CHAR(3);\r
CARES_OUT_COL79 VARCHAR(9); -- INTEGER\r
CARES_OUT_COL80 VARCHAR(50);\r
CARES_OUT_COL81 CHAR(5);\r
CARES_OUT_COL82 CHAR(3);\r
CARES_OUT_COL83 CHAR(5);\r
CARES_OUT_COL84 VARCHAR(50);\r
CARES_OUT_COL85 CHAR(2);\r
CARES_OUT_COL86 INTEGER;\r
CARES_OUT_COL87 VARCHAR(10);\r
CARES_OUT_COL88 CHAR(1);\r
CARES_OUT_COL89 CHAR(1);\r
CARES_OUT_COL90 CHAR(5);\r
CARES_OUT_COL91 CHAR(5);\r
CARES_OUT_COL92 VARCHAR(20);\r
CARES_OUT_COL93 VARCHAR(20);\r
CARES_OUT_COL94 CHAR(1);\r
CARES_OUT_COL95 CHAR(5);\r
CARES_OUT_COL96 CHAR(5);\r
CARES_OUT_COL97 VARCHAR;\r
CARES_OUT_COL98 VARCHAR(50);\r
CARES_OUT_COL99 CHAR(3);\r
CARES_OUT_COL100 VARCHAR(9); -- INTEGER\r
CARES_OUT_COL101 VARCHAR(50);\r
CARES_OUT_COL102 CHAR(5);\r
CARES_OUT_COL103 CHAR(3);\r
CARES_OUT_COL104 CHAR(5);\r
CARES_OUT_COL105 VARCHAR(50);\r
CARES_OUT_COL106 CHAR(2);\r
CARES_OUT_COL107 INTEGER;\r
service_case_id uuid;\r
sec_id uuid;\r
\r
-- New Variables for Provider Payment Address\r
VS_PAY_TO_AFFILIATE_CD VARCHAR(5);\r
VS_ALTERNATE_ADR_TYPE_CD VARCHAR(5);\r
VS_PAY_TO_AFFILIATE_CD_1 VARCHAR(5);\r
VL_AFFILIATE_PROVIDER_ID INTEGER DEFAULT 0;\r
VL_TEMP_PROVIDER_ID INTEGER DEFAULT 0;\r
LS_temp_PROVIDER_NM varchar(100);\r
LS_temp_PROV_FIRST_NM varchar(100);\r
LS_temp_PROV_MIDDLE_NM varchar (100);\r
LS_temp_PROV_LAST_NM varchar (100);\r
LS_temp_PROV_SUFFIX varchar (100);\r
V_PRIMARY_COUNTY_CD VARCHAR(4);\r
\r
BEGIN    \r
 VL_OUTPUT_SQLCODE:='00000';  \r
\r
 --   RAISE NOTICE 'GEN DATA 01 STARTS';\r
\r
\r
 -- SET transaction sequence\r
 VS_TRANSACTION_SEQUENCE := LTRIM(RTRIM(CAST(VL_TRANSACTION_SEQUENCE AS VARCHAR))) ;\r
\r
 -- Get CIS_CLIENT_ID\r
 BEGIN\r
  SELECT  person.cisclientid\r
   INTO    VS_CIS_CLIENT_ID\r
  FROM    person   \r
  WHERE   person.cjamspid = VL_CLIENT_ID\r
  AND     person.activeflag  = 1;  \r
  \r
  EXCEPTION WHEN OTHERS THEN \r
  VL_OUTPUT_SQLCODE  :=  SQLSTATE;\r
  VS_MESSAGE :=  'SELECT CIS_CLIENT_ID FAILED FOR TB_CLIENT'  ;\r
  RETURN;\r
    END ;\r
   \r
 -- Generate records for record type 01\r
    VS_RECORD_TYPE := '01';\r
 IF  VS_RECORD_TYPE = '01' THEN\r
  VL_RECORD_SEQUENCE := VL_RECORD_SEQUENCE + 1 ;\r
  IF VS_TRANSACTION_TYPE_CD = '15' THEN -- #12329\r
\r
   BEGIN   \r
   \r
    SELECT  *\r
    INTO    VS_PLACEMENT_STRUCTURE_ID,\r
      VL_PLACEMENT_START_DATE,\r
      VL_PLACEMENT_END_DATE,\r
      VS_PLACEMENT_NAME,\r
      VS_LONG_TERM_CF_INDICATOR,\r
      --   VL_LTCF_ADMISSION_DATE,VL_LTCF_DISCHARGE_DATE,\r
      VL_PROVIDER_ID,\r
      VL_PLACEMENT_CASE_ID\r
    FROM\r
     (SELECT   'S',\r
        to_char(TBS.SUBSIDY_START_DT,'yyyymmdd')::integer,\r
        to_char(TBS.SUBSIDY_END_DT,'yyyymmdd')::integer,      \r
        (SELECT\r
         CASE   WHEN LENGTH(RTRIM(PROVIDER_NM)) > 0 THEN PROVIDER_NM\r
          ELSE\r
          COALESCE(PROVIDER_FIRST_NM || ' ','')  ||\r
          COALESCE(PROVIDER_MIDDLE_NM || ' ','') ||\r
          COALESCE(PROVIDER_LAST_NM,'')\r
         END\r
        FROM TB_PROVIDER\r
        WHERE PROVIDER_ID = TB_GUARDIAN_SUBSIDY.PROVIDER_ID AND DELETE_SW = 'N'),\r
        '',\r
        TB_GUARDIAN_SUBSIDY.PROVIDER_ID,\r
        TB_GUARDIAN_SUBSIDY.CASE_ID\r
       /*  FROM     TB_GUARDIAN_SUBSIDY\r
     WHERE    CLIENT_ID = VL_CLIENT_ID AND     \r
        SUBSIDY_START_DT IS NOT NULL AND     \r
        SUBSIDY_END_DT IS NOT NULL AND     \r
        --CHECK_LIST_APPROVAL_STATUS_CD = '3047'  AND    -- coulumn doesnt exist in dev db  \r
        SUSBSIDY_APPROVAL_STATUS_CD = '3047' AND     \r
        DELETE_SW = 'N'\r
     ORDER BY SUBSIDY_START_DT DESC, GUARDIAN_SUBSIDY_ID DESC ) AS A\r
     LIMIT 1 ;-- */ \r
    FROM    TB_GUARDIAN_SUBSIDY TBS , TB_GUARDIAN_SUBSIDY_DELETE TGSD\r
    WHERE   TBS.CLIENT_ID = VL_CLIENT_ID\r
      and     TGSD.case_id = TBS.case_id\r
      AND     TBS.SUBSIDY_START_DT IS NOT NULL\r
      AND     TBS.SUBSIDY_END_DT IS NOT NULL\r
      AND     TGSD.CHECK_LIST_APPROVAL_STATUS_CD = '3047'\r
      AND     TBS.SUSBSIDY_APPROVAL_STATUS_CD = '3047'\r
      AND     TBS.DELETE_SW = 'N'\r
    ORDER BY TBS.SUBSIDY_START_DT DESC, TBS.GUARDIAN_SUBSIDY_ID DESC ) AS A \r
    LIMIT 1; \r
       \r
    EXCEPTION WHEN OTHERS THEN\r
\r
    VL_OUTPUT_SQLCODE  :=  SQLSTATE;\r
    VS_MESSAGE := 'SELECT  FAILED FOR GUARDIAN SUBSIDY '||SQLERRM  ;\r
    RETURN ;\r
   END;\r
   \r
   VL_LTCF_ADMISSION_DATE := NULL; -- #12329 02/19/07\r
   VL_LTCF_DISCHARGE_DATE := NULL; -- #12329 02/19/07\r
\r
  ELSIF VS_TRANSACTION_TYPE_CD <> '70' AND VS_TRANSACTION_TYPE_CD <>'15' THEN -- #12329 \r
   BEGIN\r
    SELECT  *\r
    INTO    VS_PLACEMENT_STRUCTURE_ID,\r
      VL_PLACEMENT_START_DATE,\r
      VL_PLACEMENT_END_DATE,\r
      VS_PLACEMENT_NAME,\r
      VS_LONG_TERM_CF_INDICATOR,\r
      VL_LTCF_ADMISSION_DATE,\r
      VL_LTCF_DISCHARGE_DATE,\r
      VL_PROVIDER_ID,\r
      VL_PLACEMENT_CASE_ID\r
    FROM\r
     (SELECT  \r
      CASE WHEN PLACEMENT_STRUCTURE_ID = 501 THEN 'A'\r
        WHEN PLACEMENT_STRUCTURE_ID = 8 THEN 'K'\r
       ELSE 'F'\r
      END,\r
      to_char(ENTRY_DT,'yyyymmdd')::integer,\r
      to_char(EXIT_DT,'yyyymmdd')::integer,\r
      (SELECT\r
        CASE   WHEN LENGTH(RTRIM(PROVIDER_NM)) > 0 THEN PROVIDER_NM\r
        ELSE\r
         COALESCE(PROVIDER_FIRST_NM || ' ','')  ||\r
         COALESCE(PROVIDER_MIDDLE_NM || ' ','') ||\r
         COALESCE(PROVIDER_LAST_NM,'')\r
        END\r
      FROM  TB_PROVIDER\r
      WHERE  PROVIDER_ID = TB_PLACEMENT.PROVIDER_ID AND DELETE_SW = 'N'),\r
      CASE WHEN PLACEMENT_STRUCTURE_ID = 76 THEN 'Y'\r
       ELSE 'N'\r
      END,\r
      CASE  WHEN PLACEMENT_STRUCTURE_ID = 76\r
        THEN to_char(ENTRY_DT,'yyyymmdd')::integer\r
      END,\r
      CASE WHEN PLACEMENT_STRUCTURE_ID = 76\r
        THEN to_char(EXIT_DT,'yyyymmdd')::integer\r
      END,\r
      TB_PLACEMENT.PROVIDER_ID,\r
      TB_PLACEMENT.CASE_ID\r
     FROM    TB_PLACEMENT\r
     WHERE   CLIENT_ID = VL_CLIENT_ID\r
       AND     EXIT_DT IS NULL\r
       AND     ENTRY_DT IS NOT NULL\r
       AND     PLACEMENT_STRUCTURE_ID IS NOT NULL\r
       AND     APPROVAL_STATUS_CD = '3047'\r
       AND     DELETE_SW = 'N'\r
     ORDER BY ENTRY_DT DESC, PLACEMENT_ID DESC) AS A\r
     LIMIT 1 ;\r
   \r
\r
    EXCEPTION WHEN OTHERS THEN\r
    VL_OUTPUT_SQLCODE  :=  SQLSTATE;\r
    VS_MESSAGE := 'SELECT  FAILED FOR TB_PLACEMENT '||SQLERRM  ;\r
    RETURN ;\r
   END;\r
  END IF; \r
  \r
  IF VS_TRANSACTION_TYPE_CD = '70' THEN\r
   BEGIN \r
    SELECT *\r
    INTO    VS_PLACEMENT_STRUCTURE_ID,\r
      VL_PLACEMENT_START_DATE,\r
      VL_PLACEMENT_END_DATE,\r
      VS_PLACEMENT_NAME,\r
      VS_LONG_TERM_CF_INDICATOR,\r
      VL_LTCF_ADMISSION_DATE,\r
      VL_LTCF_DISCHARGE_DATE,\r
      VL_PROVIDER_ID,\r
      VL_PLACEMENT_CASE_ID\r
    FROM\r
    (SELECT  CASE    WHEN PLACEMENT_STRUCTURE_ID = 501 THEN 'A'\r
      WHEN PLACEMENT_STRUCTURE_ID = 8 THEN 'K'\r
      ELSE 'F'\r
      END,\r
      to_char(ENTRY_DT,'yyyymmdd')::integer,\r
      to_char(EXIT_DT,'yyyymmdd')::integer,\r
       \r
    (SELECT\r
    CASE   WHEN LENGTH(RTRIM(PROVIDER_NM)) > 0 THEN PROVIDER_NM\r
    ELSE\r
      COALESCE(PROVIDER_FIRST_NM || ' ','')  ||\r
      COALESCE(PROVIDER_MIDDLE_NM || ' ','') ||\r
      COALESCE(PROVIDER_LAST_NM,'')\r
    END\r
    FROM TB_PROVIDER\r
    WHERE PROVIDER_ID = TB_PLACEMENT.PROVIDER_ID AND DELETE_SW = 'N'),\r
    CASE WHEN PLACEMENT_STRUCTURE_ID = 76 THEN 'Y'\r
        ELSE 'N'\r
      END,\r
      CASE WHEN PLACEMENT_STRUCTURE_ID = 76\r
        THEN to_char(ENTRY_DT,'yyyymmdd')::integer\r
        \r
      END,\r
      CASE WHEN PLACEMENT_STRUCTURE_ID = 76 THEN \r
      to_char(EXIT_DT,'yyyymmdd')::integer\r
        \r
      END,\r
      TB_PLACEMENT.PROVIDER_ID,\r
      TB_PLACEMENT.CASE_ID\r
    FROM    TB_PLACEMENT\r
    WHERE   CLIENT_ID = VL_CLIENT_ID\r
    AND     EXIT_DT IS NOT NULL\r
    AND     ENTRY_DT IS NOT NULL\r
    AND     PLACEMENT_STRUCTURE_ID IS NOT NULL\r
    AND     DELETE_SW = 'N'\r
    ORDER BY ENTRY_DT DESC , PLACEMENT_ID DESC) AS A\r
    LIMIT 1 ;\r
\r
    EXCEPTION WHEN OTHERS THEN\r
    VL_OUTPUT_SQLCODE  :=  SQLSTATE;\r
    VS_MESSAGE := 'SELECT  FAILED FOR TB_PLACEMENT '||SQLERRM  ;\r
    RETURN ;\r
   END;\r
   \r
  END IF;\r
\r
  --SET VL_TRANSACTION_DATE = INTEGER(SUBSTRING(CHAR(DATE(VD_TRANSACTION_TS)),7,4)||SUBSTRING(CHAR(DATE(VD_TRANSACTION_TS)),1,2)||SUBSTRING(CHAR(DATE(VD_TRANSACTION_TS)),4,2));\r
  BEGIN\r
   select f_prim_county(VL_PLACEMENT_CASE_ID,'NULL') \r
    into V_PRIMARY_COUNTY_CD ;\r
   /* -- old code \r
   SELECT f_prim_county_interface(VL_PLACEMENT_CASE_ID::varchar)\r
    INTO V_PRIMARY_COUNTY_CD;\r
   */\r
       \r
   VS_PRIMARY_COUNTY_CD := CASE WHEN  V_PRIMARY_COUNTY_CD = '1427' THEN '01' -- Allegany\r
           WHEN V_PRIMARY_COUNTY_CD = '1428' THEN '02'     -- Anne Arundel\r
           WHEN V_PRIMARY_COUNTY_CD = '1430' THEN '03'     -- Baltimore County\r
           WHEN V_PRIMARY_COUNTY_CD = '1431' THEN '04'     -- Calvert County\r
           WHEN V_PRIMARY_COUNTY_CD = '1432' THEN '05'     -- Caroline County\r
           WHEN V_PRIMARY_COUNTY_CD = '1433' THEN '06'     -- Carroll County\r
           WHEN V_PRIMARY_COUNTY_CD = '1434' THEN '07'     -- Cecil County\r
           WHEN V_PRIMARY_COUNTY_CD = '1435' THEN '08'     -- Charles County\r
           WHEN V_PRIMARY_COUNTY_CD = '1436' THEN '09'     -- Dorchester County\r
           WHEN V_PRIMARY_COUNTY_CD = '1437' THEN '10'     -- Frederick County\r
           WHEN V_PRIMARY_COUNTY_CD = '1438' THEN '11'     -- Garrett County\r
           WHEN V_PRIMARY_COUNTY_CD = '1439' THEN '12'     -- Harford County\r
           WHEN V_PRIMARY_COUNTY_CD = '1440' THEN '13'     -- Howard County\r
           WHEN V_PRIMARY_COUNTY_CD = '1441' THEN '14'     -- Kent County\r
           WHEN V_PRIMARY_COUNTY_CD = '1442' THEN '15'     -- Montgomery County\r
           WHEN V_PRIMARY_COUNTY_CD = '1443' THEN '16'     -- Prince Georges County\r
           WHEN V_PRIMARY_COUNTY_CD = '1444' THEN '17'     -- Queen Annes County\r
           WHEN V_PRIMARY_COUNTY_CD = '1446' THEN '18'     -- St. Marys County\r
           WHEN V_PRIMARY_COUNTY_CD = '1445' THEN '19'     -- Somerset County\r
           WHEN V_PRIMARY_COUNTY_CD = '1447' THEN '20'     -- Talbot County\r
           WHEN V_PRIMARY_COUNTY_CD = '1448' THEN '21'     -- Washington County\r
           WHEN V_PRIMARY_COUNTY_CD = '1449' THEN '22'     -- Wicomico County\r
           WHEN V_PRIMARY_COUNTY_CD = '1450' THEN '23'     -- Worcester County\r
           WHEN V_PRIMARY_COUNTY_CD = '1429' THEN '30'     -- Baltimore City\r
           WHEN V_PRIMARY_COUNTY_CD = '3824' THEN '00'     -- DHR/SSA\r
           END  ;\r
  \r
   service_case_id = (SELECT servicecaseid \r
        from servicecase where servicecasenumber = VL_PLACEMENT_CASE_ID::varchar);\r
   \r
   \r
   -- Get Primary Casewroker\r
   select ca.toworkeridno\r
    into sec_id\r
    from caseassignment ca,\r
     userprofile up \r
   where ca.toworkeridno = up.securityusersid\r
    and ca.objectid = service_case_id\r
    and lower(ca.responsibilitytypekey) = 'family'\r
    and ca.activeflag = 1\r
    and up.activeflag = 1\r
    and ca.enddate is null\r
   order by ca.insertedon desc\r
   limit 1 ;\r
   \r
   /* -- old code\r
   SELECT routing.tosecurityusersid into sec_id\r
   FROM  routing \r
   WHERE ((routing.objectid = service_case_id::varchar) ) and \r
   routing.activeflag=1 and routing.eventcode= 'SRVC';\r
   */\r
   \r
   IF sec_id is null THEN\r
    -- Get Child Casewroker\r
    select ca.toworkeridno\r
     into sec_id\r
     from caseassignment ca,\r
      userprofile up \r
    where ca.toworkeridno = up.securityusersid\r
     and ca.objectid = service_case_id\r
     and ca.old_id::bigint = VL_CLIENT_ID\r
     and lower(ca.responsibilitytypekey) = 'child'\r
     and ca.activeflag = 1\r
     and up.activeflag = 1\r
     and ca.enddate is null\r
    order by ca.insertedon desc\r
    limit 1 ;\r
   END IF;\r
   \r
   IF sec_id is null THEN\r
    -- Get LDSS Director\r
    select up.securityusersid\r
     into sec_id\r
     from team t\r
      join teammember tm on tm.teamid = t.teamid and tm.activeflag = 1\r
      join teammemberassignment tma on tma.teammemberid = tm.teammemberid and tma.activeflag = 1\r
      join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag = 1\r
      join rolemapping rm on rm.principalid::int = mu.id and rm.activeflag = 1\r
      join county c on c.countyid::character varying = t.countyid\r
      join userresource ur on ur.userid = mu.id and ur.activeflag = 1\r
      join role r on r.id = rm.roleid::int and r.activeflag = 1\r
      join userprofile up on up.securityusersid = mu.securityusersid and up.activeflag = 1\r
     where ur.permissiongroupid = '57a390b8-3387-428a-97a8-0b8559fd1f1e'    \r
      and lower(tm.description) like '%director%'\r
      and btrim(c.statecountycode) = btrim(V_PRIMARY_COUNTY_CD)\r
    order by (case when tm.description = 'LDSS Director' then 1 else 2 end) \r
    limit 1;\r
   END IF;\r
   \r
   --#GET Staff Telephone Number & Name\r
   SELECT right( regexp_replace (upn.phonenumber::varchar, '[- ]+','','g')::varchar, 10) as phonenumber,\r
