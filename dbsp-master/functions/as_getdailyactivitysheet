CREATE OR REPLACE FUNCTION as_getdailyactivitysheet(p_intakenumber character varying, p_detenworker character varying)
 RETURNS TABLE(persons text, cdofficername character varying, officeaddress character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN

     RETURN QUERY 
  select distinct 
  (select da.jsondata->>'persons' as persons from intakedastaging da where da.intakenumber = p_intakenumber and da.activeflag = 1),
        cast(up.lastname||', '||up.firstname as character varying) as cdofficername,
        cast(upa.address as character varying) as officeaddress
  from userprofile up 
  left join userprofileaddress upa on upa.securityusersid = up.securityusersid and upa.userprofileaddresstypekey = 'O'
  where up.activeflag = 1 
  and (case when p_detenworker is not null then up.securityusersid = p_detenworker else true end);
  
END;
$function$

