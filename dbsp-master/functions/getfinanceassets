CREATE OR REPLACE FUNCTION getfinanceassets(al_person_id character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 
declare
v_result json;
v_personid varchar;
begin
v_personid = al_person_id;
select array_to_json(array_agg(row_to_json(t)))
from (
SELECT pa.personassetid,pa.assettypekey, pa.purchasedate, pa.disposaldate, pa.disregardflag, pa.accountno, pa.beneficiaryname, pa.verificationtypekey, pa.notes, pa.marketvaluetypekey, pa.facevalue, pa.amountowed,
pa.locationname, pa.cityname, pa.statetypekey, pa.countytypekey, pa.zip5no, pa.addressline1, pa.addressline2,pa.insertedon,
coalesce((select up.fullname from userprofile up where up.securityusersid = pa.insertedby), pa.insertedby) as  insertedby, 
(select value_text from referencevalues where ref_key = pa.assettypekey and referencetypeid = 194 and activeflag = 1) as  assettypename 
from personasset pa
WHERE pa.personid::character varying = v_personid and pa.activeflag = 1
 ) t into v_result;

RETURN v_result; 
end
 $function$

