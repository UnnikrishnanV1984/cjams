CREATE OR REPLACE FUNCTION getassessmentvalue(v_intakenumber character varying, v_intakeserviceid uuid, v_templatename character varying, v_fieldname character varying, v_fieldvalue character varying)
 RETURNS boolean
 LANGUAGE plpgsql
AS $function$


DECLARE
 v_isDetention BOOLEAN;
 

BEGIN

SELECT count(1) > 0 into v_isDetention FROM assessmenttemplate at 
JOIN assessment a ON a.assessmenttemplateid = at.assessmenttemplateid AND a.activeflag = 1
JOIN assessmentsubmission ats ON ats.assessmentid = a.assessmentid AND ats.activeflag = 1
WHERE at.activeflag = 1 AND at."name" = v_templatename 
AND ats.datakey = v_fieldname AND ats.datavalue = v_fieldvalue
AND (a.intakenumber = v_intakenumber OR (a.objectid IS NULL OR a.objectid = v_intakeserviceid));

    
RETURN v_isDetention;

END;


$function$

