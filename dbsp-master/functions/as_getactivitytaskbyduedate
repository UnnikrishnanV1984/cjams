CREATE OR REPLACE FUNCTION as_getactivitytaskbyduedate(userid character varying, pageno integer, pagesize integer, sortcolumn character varying, sortorder character varying)
 RETURNS TABLE(totalcount bigint, activityid uuid, activitytaskid uuid, actvityname text, duedate timestamp without time zone, task character varying, required boolean, assignedon timestamp without time zone, taskstatustype character varying, completeddate timestamp without time zone, activitytasktypekey character varying, insertedon timestamp without time zone, assignloadnumber character varying, outofoffice boolean, activitytaskstatustypekey character varying, activitytaskdispositiontypekey character varying, taskdescription text, caseno character varying, type character varying, subtype character varying, focus character varying, intakeserviceid uuid)
 LANGUAGE plpgsql
AS $function$

DECLARE v_pageoffset int;
  v_pagenumber int;
  
BEGIN
v_pagenumber := pageno-1;
v_pageoffset = v_pagenumber * pagesize;
RETURN QUERY

select count(1) over() totalcount,x.* from ( SELECT
  -- count(1) OVER() totalcount,
 --count(*) as TotalCount
 --,COUNT(CASE WHEN atst.typedescription = 'Open' THEN 1 END) as OpenTask
 --,COUNT(CASE WHEN atst.typedescription = 'Closed' THEN 1 END) as CancelledTask
 act.ActivityId,
 acttask.ActivityTaskId,
 act.description,
 acttask.duedate,
 acttask.name As task,
 acttask.Required ,
 acttask.AssignedOn ,
 atst.typedescription as taskstatus,
acttask.completeddate,
acttask.ActivityTaskTypeKey,
acttask.insertedon,
acttask.assignedto as assignloadnumber,
acttask.outofoffice,
acttask.ActivityTaskStatusTypeKey,
acttask.ActivityTaskDispositionTypekey,
acttask.description as taskdescription,
ISR.servicerequestnumber as caseno,
(SELECT  itsrt.description FROM  intakeservicerequesttype  as  itsrt
  WHERE  itsrt.intakeservreqtypeid=ISR.intakeservreqtypeid AND  itsrt.activeflag  =1 limit  1) as type,
(SELECT  srst.classkey  FROM  servicerequestsubtype  as  srst WHERE  srst.servicerequestsubtypeid=ISR.intakeservicerequestclassid
  AND  srst.activeflag  =1    limit  1) as subtype,
(SELECT cast(INITCAP(TRIM(coalesce(PN.lastname,''))|| CASE WHEN PN.suffix is not null THEN ' ' ELSE '' END  || TRIM(coalesce(PN.suffix,'')) || ', ' ||TRIM(coalesce(PN.firstname,''))) as  character varying)
  FROM intakeservicerequestactor ISRA
  INNER JOIN actor a ON ISRA.actorid = a.actorid AND a.activeflag = 1 AND ISRA.activeflag = 1
  INNER JOIN person PN ON PN.personid = a.personid
  WHERE ISRA.intakeserviceid = ISR.intakeserviceid AND ISRA.intakeservicerequestpersontypekey IN ('RA','AV') ORDER BY ISRA.intakeservicerequestpersontypekey DESC NULLS LAST LIMIT 1) as focus,
ISR.IntakeServiceId
FROM intakeservicerequest AS ISR
INNER JOIN caseassignment CA ON ISR.intakeserviceid = CA.objectid AND CA.toworkeridno = userid AND
(CA.enddate IS NULL OR CA.enddate>=current_date) AND CA.activeflag = 1
INNER JOIN AreaTeamMemberServiceRequest  AS ATSR  ON  ATSR.IntakeServiceId   = ISR.IntakeServiceId AND   ATSR.ActiveFlag = 1                                                          
INNER JOIN TeamMember AS TM  ON  ATSR.TeamMemberId   = TM.TeamMemberId                                                                        
INNER JOIN as_teammemberassignment   AS TMA  ON  TMA.TeamMemberId   = ATSR.TeamMemberId     AND TMA.ActiveFlag = 1                                                    
--INNER JOIN muser muser ON muser.securityusersid=TMA.securityusersid and muser.activeflag=1
INNER JOIN Investigation invst ON ISR.intakeserviceid=invst.intakeserviceid and invst.activeflag=1
INNER JOIN Activity act on invst.investigationid = act.objectid and act.activeflag=1
INNER JOIN Activitytask acttask on act.activityid = acttask.activityid  and acttask.activeflag = 1 and act.activeflag = 1  
inner join activitytaskstatustype atst on acttask.activitytaskstatustypekey = atst.activitytaskstatustypekey and atst.activeflag=1 and acttask.activeflag=1
--and muser.id=userid
and TMA.securityusersid = userid and (date(acttask.duedate))>=(date(now())-30) and atst.typedescription != 'Closed'
WHERE ISR.teamtypekey = 'AS' and ( ISR.isclosecpshistory is null or ISR.isclosecpshistory!=1 )


) as x 


   ORDER BY 
   -- duedate asc
 
   CASE sortorder
     WHEN 'asc' THEN
      CASE sortcolumn 
       when 'caseno' then x.caseno
       when 'type' then x.type
       when 'subtype' then x.subtype
       when 'task' then x.task
       when 'focus' then x.focus
       when 'actvityname' then x.description
       WHEN 'duedate' then x.duedate :: character varying
       END
 END 
 ASC,
 CASE sortorder
      WHEN 'desc' THEN
       CASE sortcolumn 
       when 'caseno' then x.caseno
       when 'type' then x.type
       when 'subtype' then x.subtype
       when 'task' then x.task
       when 'focus' then x.focus
       when 'actvityname' then description
       WHEN 'duedate' then x.duedate :: character varying

       END
 END
 desc 


 limit pagesize  offset v_pageoffset ;
END;

--

$function$

