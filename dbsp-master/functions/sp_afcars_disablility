CREATE OR REPLACE FUNCTION sp_afcars_disablility(al_client_id integer, ad_removal_dt date, ad_return_dt date, as_afcars_type character varying)
 RETURNS TABLE(vs_child_diagnosed_cd text, vs_mental_retardation_cd text, vs_visual_hearing_cd text, vs_physical_disabled_cd text, vs_emotional_disturbed_cd text, vs_other_diagnosed_condition_cd text)
 LANGUAGE plpgsql
AS $function$
DECLARE 
VS_RECORD_TYPE VARCHAR(2);
VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';
VS_RECORD_SEQUENCE VARCHAR(3);
VL_EXCEP_MESSAGE VARCHAR;
VL_EXCEP_FLAG INTEGER;
VS_MESSAGE VARCHAR;
VL_OUTPUT_SQLCODE VARCHAR;

BEGIN 

 RAISE NOTICE 'sp_afcars_disablility BEGUN ';--
 VL_OUTPUT_SQLCODE:= ''; --
begin
return query
  
  SELECT
    case  when PD.disabilityconditiontypekey like 'Yes' THEN '1'
      when PD.disabilityconditiontypekey like 'No' THEN '2'
      when PD.disabilityconditiontypekey like '' THEN '3' 
    end  AS VS_CHILD_DIAGNOSED_CD,
    case  when PD.disabilitytypekey = 'VIDY' AND PD.disabilitytypekey ='HDY' THEN '1' 
      ELSE  '0' 
    END  AS VS_MENTAL_RETARDATION_CD,
    case  when PD.disabilitytypekey IN ('VIDY', 'HDY') THEN '1' 
      ELSE '0' 
    END  AS VS_VISUAL_HEARING_CD,
    case  when PD.disabilitytypekey = 'PYDY' THEN '1' 
      ELSE '0' 
    END  AS VS_PHYSICAL_DISABLED_CD,
    case  when PD.disabilitytypekey = 'EMDY' THEN '1' 
      ELSE '0' 
    END  AS VS_EMOTIONAL_DISTURBED_CD,
    case  when PD.disabilitytypekey = 'ODY' THEN '1' 
      ELSE '0' 
    END  AS VS_OTHER_DIAGNOSED_CONDITION_CD
  from  persondisability PD, 
    person PP 
  WHERE  PD.activeflag = 1 
    and PP.activeflag = 1 
    AND PP.cjamspid = AL_CLIENT_ID;--
   -- AND   (PD.startdate <= adt_to::DATE OR PD.startdate IS NULL)
    --AND (PD.enddate IS NULL OR PD.enddate >= ADT_FROM::DATE);

  EXCEPTION WHEN OTHERS THEN
                VS_OUTPUT_STATE := SQLSTATE;
                VL_OUTPUT_SQLCODE :=SQLERRM;
                                VS_MESSAGE := 'SQLSTATE:' || VS_OUTPUT_STATE || '. SELECT  FAILED FOR DISABILITY #152 FOR -->'|| CAST(AL_CLIENT_ID AS VARCHAR) ;--
                                VL_EXCEP_FLAG := 1;--
                                VL_EXCEP_MESSAGE := CAST(VL_OUTPUT_SQLCODE AS VARCHAR)|| VS_OUTPUT_STATE ;--
        
END; 


 IF VL_EXCEP_FLAG = 1 THEN
   INSERT INTO interfaceserrorlog(
                                         interfaceid,
                                         currentruntimestamp,
                                         errorlineno,
                                         errorcode,
                                         errordescription,
                                         insertedon)VALUES ('AFACRS FOSTER CARE',
                                                CURRENT_TIMESTAMP,
                                                0,
                                                VL_EXCEP_MESSAGE,
                                                VS_OUTPUT_STATE,
                                                CURRENT_DATE);
END IF;--
end;
$function$

