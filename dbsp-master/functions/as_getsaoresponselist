CREATE OR REPLACE FUNCTION as_getsaoresponselist(v_intakenumber character varying, v_intakeserviceid uuid)
 RETURNS TABLE(saoresponseid uuid, saoresponsedate timestamp without time zone, saoresponsestatustypekey character varying, description character varying, intakenumber character varying, saoresponseconditiontype json)
 LANGUAGE plpgsql
AS $function$
                                                                                     
BEGIN   

RETURN Query 
SELECT SR.saoresponseid, SR.saoresponsedate, SR.saoresponsestatustypekey,
SRST.description,SR.intakenumber,

(SELECT json_agg(x) from (
 SELECT SRCTC.saoresponseconditiontypeconfigid, SRCTC.saoresponseid , SRCTC.conditiontypekey ,CT.description,
 SRCTC.intakenumber , SRCTC.intakeserviceid, ISR.servicerequestnumber,ISR.intakeservreqtypeid as intakeservreqtypeid, ISR.intakeservicerequestclassid as servicerequestsubtypeid
 FROM saoresponseconditiontypeconfig as SRCTC
    JOIN conditiontype as CT
         ON CT.conditiontypekey = SRCTC.conditiontypekey and CT.activeflag = 1
    JOIN intakeservicerequest as ISR
         ON ISR.intakeserviceid = SRCTC.intakeserviceid and ISR.activeflag = 1
 where SRCTC.saoresponseid = SR.saoresponseid and SRCTC.intakenumber = v_intakenumber and 
 SRCTC.activeflag = 1 and SRCTC.intakeserviceid = v_intakeserviceid
) as x) as saoresponseconditiontype
 
FROM saoresponse AS SR 
JOIN saoresponsestatustype as  SRST 
     ON SRST.saoresponsestatustypekey = SR.saoresponsestatustypekey and SRST.activeflag = 1
WHERE SR.activeflag = 1 and SR.intakenumber = v_intakenumber;


END;
                    
$function$

