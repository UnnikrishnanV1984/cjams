CREATE OR REPLACE FUNCTION adoptionsignature(v_permanencyplanid uuid, v_signtext text, v_status integer)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
 
begin
if(v_status = 67)
then
update adoptionagreement set cwsignimage = v_signText where adoptionagreementid =
(select adoptionagreementid from adoptionagreement aa
join adoptionplanning ap on ap.adoptionplanningid = aa.adoptionplanningid and aa.activeflag=1
join permanencyplan pp on pp.permanencyplanid = ap.permanencyplanid and pp.activeflag =1
where pp.permanencyplanid = v_permanencyplanid limit 1);
else if(v_status = 68)
then
update adoptionagreement set ivesvsignimage = v_signText where adoptionagreementid =
(select adoptionagreementid from adoptionagreement aa
join adoptionplanning ap on ap.adoptionplanningid = aa.adoptionplanningid and aa.activeflag=1
join permanencyplan pp on pp.permanencyplanid = ap.permanencyplanid and pp.activeflag =1
where pp.permanencyplanid = v_permanencyplanid limit 1);
else if(v_status = 69)
then
update adoptionagreement set ivesvsignimage = v_signText where adoptionagreementid =
(select adoptionagreementid from adoptionagreement aa
join adoptionplanning ap on ap.adoptionplanningid = aa.adoptionplanningid and aa.activeflag=1
join permanencyplan pp on pp.permanencyplanid = ap.permanencyplanid and pp.activeflag =1
where pp.permanencyplanid = v_permanencyplanid limit 1);
end if;
end if;
end if;

return 'Success';
END;

$function$

