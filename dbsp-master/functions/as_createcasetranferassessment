CREATE OR REPLACE FUNCTION as_createcasetranferassessment(v_intakeserviceid uuid, v_newintakeserviceid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 


BEGIN  
INSERT INTO assessment
( assessmenttemplateid,
 personid,
 securityusersid, 
 assessmentstatustypekey, 
 activeflag, 
 insertedby, 
 insertedon,
 updatedby, 
 updatedon, 
 effectivedate, 
 expirationdate,
 objectid,
 objectname,
 executerules, requiredind, 
 submissionid, score, 
 intakenumber,
 submissiondata,
 ischildsafe, 
 old_id, 
 ismigrated, 
 assessmentsubmissiontypekey)
 
 SELECT assessmenttemplateid, 
 personid, 
 securityusersid,
 assessmentstatustypekey, 
 1, insertedby,
 insertedon, 
 updatedby,
 updatedon, 
 effectivedate, 
 expirationdate,
 v_newintakeserviceid, 
 objectname, 
 executerules,
 requiredind, submissionid, score, 
 intakenumber, submissiondata, ischildsafe, 
 old_id, ismigrated, assessmentsubmissiontypekey
FROM assessment
WHERE objectid=v_intakeserviceid and assessmenttemplateid ='e81df351-04f7-48a7-b27a-b6f284f74b3b';


Return 'Successfull';
   
end;

$function$

