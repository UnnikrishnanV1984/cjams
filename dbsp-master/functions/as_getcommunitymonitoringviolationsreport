CREATE OR REPLACE FUNCTION as_getcommunitymonitoringviolationsreport(fromdate date, todate date, byregion character varying, cmleve character varying, alerts character varying, p_pagesize integer, p_pageoffset integer, nolimit boolean)
 RETURNS TABLE(dt json)
 LANGUAGE plpgsql
AS $function$

DECLARE

BEGIN

RETURN QUERY
 
SELECT json_agg(a) as result FROM (
 SELECT * FROM  communitymonitoringviolations  CMV   
 where 
 CASE  WHEN  fromdate  is  NOT  NULL  THEN  (startdate >= fromdate)  ELSE  TRUE  END
 AND CASE  WHEN  todate  is  NOT  NULL  THEN  (enddate <=  todate)  ELSE  TRUE  END
 AND CASE  WHEN  byregion  is  NOT  NULL  THEN  (region = byregion )  ELSE  TRUE  END
 AND CASE WHEN alerts is NOT NULL THEN 
 CMV.personid in(select distinct personid from personalert where alerttype=ANY(string_to_array(alerts, ',')::text[] )) ELSE  TRUE  END
 AND CASE  WHEN  (cmleve !=null or cmleve !='')  THEN  (cmlevel =  cmleve)  ELSE  TRUE  END)as a
 order by CMV.insertedon desc
 limit (case when nolimit is false then p_pagesize else null end ) offset (case when nolimit is false then p_pageoffset else null end);
 
 END;

$function$

