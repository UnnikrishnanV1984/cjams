CREATE OR REPLACE FUNCTION as_sp_ive_eligibility_worksheet_court_info(reqobj json)
 RETURNS TABLE(v_clientid bigint, v_removalid integer, v_clientidofsubjectctwfinding bigint, v_nameofsubjectctwfinding character varying, v_relationshipofsubjectctwfinding integer)
 LANGUAGE plpgsql
AS $function$
DECLARE
 v_clientid int8;
    v_removalid int4;
        v_clientidofsubjectctwfinding int8;
        v_nameofsubjectctwfinding VARCHAR;
        v_relationshipofsubjectctwfinding int4;
 v_num INT;

BEGIN
 v_clientid := reqObj ->> 'clientId';
 v_removalid := reqObj ->> 'removalid';
 v_clientidofsubjectctwfinding := reqObj ->> 'clientidofsubjectctwfinding';
 v_nameofsubjectctwfinding := reqObj ->> 'nameofsubjectctwfinding';
 v_relationshipofsubjectctwfinding := reqObj ->> 'relationshipofsubjectctwfinding';

 SELECT count(*) into v_num FROM iveincomesumary WHERE clientId = v_clientid and removalid = v_removalid;

 IF (v_num) >= 1
 THEN
   UPDATE iveincomesumary
                SET
                        clientidofsubjectctwfinding = v_clientidofsubjectctwfinding,
                        nameofsubjectctwfinding = v_nameofsubjectctwfinding,
                        relationshipofsubjectctwfinding = v_relationshipofsubjectctwfinding
                WHERE clientId = v_clientid and removalid = v_removalid;

 else
  Insert into iveincomesumary(iveincomesumaryid, clientid, removalid, activeflag, clientidofsubjectctwfinding, nameofsubjectctwfinding, relationshipofsubjectctwfinding)
                VALUES(gen_random_uuid(), v_clientid, v_removalid, 1, v_clientidofsubjectctwfinding, v_nameofsubjectctwfinding, v_relationshipofsubjectctwfinding);
 end if;

RETURN QUERY
        SELECT
        ipd.clientid,
        ipd.removalid,
        ipd.clientidofsubjectctwfinding,
        ipd.nameofsubjectctwfinding,
        ipd.relationshipofsubjectctwfinding
        FROM iveincomesumary ipd
        WHERE ipd.clientid = v_clientid AND removalid = v_removalid;
end;

$function$

