CREATE OR REPLACE FUNCTION listassessment_test(servicerequestid uuid, assessmentstatus character varying, pageno integer, pagesize integer, v_roletypecode character varying, v_nolimit boolean)
 RETURNS TABLE(totalcount bigint, assessmenttemplateid uuid, external_templateid character varying, duedays character varying, description text, target character varying, intakassessment json, routinginfo json)
 LANGUAGE plpgsql
AS $function$

declare categoryid uuid;
 subcategoryid uuid;
 targetid uuid;
 agencycode character varying;
 v_intakenumber character varying;
 v_accpecteddate timestamp without time zone;
BEGIN

   if (assessmentstatus ='null'   ) then
  assessmentstatus:=null;
 end if;
   
  SELECT intakeservreqtypeid, intakeservicerequestclassid,teamtypekey,accepteddate,intakenumber into categoryid,
 subcategoryid,agencycode,v_accpecteddate,v_intakenumber  FROM intakeservicerequest where intakeserviceid=servicerequestid;

  -- SELECT    assessmenttemplatetargetid into   targetid from assessmenttemplatetarget   where lower(target )='investigation' and activeflag =1;
RAISE NOTICE '%',categoryid ;   
IF (v_nolimit = true) THEN
RETURN QUERY  

select count(1) OVER() totalcount,* from 
   ( select  at.AssessmentTemplateId,  at.external_templateid ,
   case when (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate)))< 0 then 0 else (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate))) end :: character varying,
  cast(at.titleheadertext as text)    as description
,ATT.target ,(select * from getassessmentdetails(servicerequestid :: character varying,At.assessmenttemplateid,true)) as intakassessment,

 (SELECT json_agg(e) as routinginfo 
    from (select  UP.lastname ||','|| up.firstname as fromusername,  
  upto.lastname ||','|| upto.firstname as tousername,
   RT.roletypename as fromrole,  RT1.roletypename as torole,case R.routingstatustypeid when 4 then 'Assigned' 
   else  RST.routingstatustypekey  end routingstatustypekey,R.insertedon as routedon from  routing R 
  inner join routingstatustype RST on RST.sequencenumber = R.routingstatustypeid
  inner join  userprofile UP on UP.securityusersid = R.fromsecurityusersid 
  inner join userprofile upto on upto.securityusersid = r.tosecurityusersid 
  inner join (select rt.*, rtt.roletypename from role  RT   
  inner join roletype rtt on rtt.shortname = rt.name ) RT on R.fromroleid = RT.roletypekey
  inner join (select rt.*, rtt.roletypename from role  RT
  inner join roletype rtt on rtt.shortname = rt.name ) RT1 on R.toroleid = RT1.roletypekey
  where R.objectid in (v_intakenumber,servicerequestid::character varying)
  order by r.updatedon asc  )e) 
      from AssessmentTemplate at inner join  AssessmentTemplateCategoryFilterMap  atcm on at.AssessmentTemplateId =atcm.AssessmentTemplateId   
   INNER JOIN AssessmentTemplateTarget ATT 
   ON ATT.AssessmentTemplateTargetid = atcm.AssessmentTemplateTargetid
   AND lower(att.target ) IN ('investigation')
   and att.activeflag =1
   and atcm.teamtypekey  = agencycode
      and atcm.activeflag =1 
      and at.activeflag =1
  where  atcm.intakeservicerequesttypeid = '00000000-0000-0000-0000-000000000000' 
   and atcm.intakeservicerequestsubtypeid = '00000000-0000-0000-0000-000000000000'
  
      UNION ALL
       select   at.AssessmentTemplateId,  at.external_templateid ,
       case when (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate)))< 0 then 0 else (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate))) end :: character varying,
   cast(at.titleheadertext as text)    as description
 ,ATT.target ,(select * from getassessmentdetails(servicerequestid :: character varying,At.assessmenttemplateid,true)) as intakassessment,
 
 (SELECT json_agg(e) as routinginfo 
    from (select  UP.lastname ||','|| up.firstname as fromusername,  
  upto.lastname ||','|| upto.firstname as tousername,
   RT.roletypename as fromrole,  RT1.roletypename as torole,case R.routingstatustypeid when 4 then 'Assigned' 
   else  RST.routingstatustypekey  end routingstatustypekey,R.insertedon as routedon from  routing R 
  inner join routingstatustype RST on RST.sequencenumber = R.routingstatustypeid
  inner join  userprofile UP on UP.securityusersid = R.fromsecurityusersid 
  inner join userprofile upto on upto.securityusersid = r.tosecurityusersid 
  inner join (select rt.*, rtt.roletypename from role  RT   
  inner join roletype rtt on rtt.shortname = rt.name ) RT on R.fromroleid = RT.roletypekey
  inner join (select rt.*, rtt.roletypename from role  RT
  inner join roletype rtt on rtt.shortname = rt.name ) RT1 on R.toroleid = RT1.roletypekey
  where R.objectid in (v_intakenumber,servicerequestid::character varying)
  order by r.updatedon asc  )e) 
      from AssessmentTemplate at inner join  AssessmentTemplateCategoryFilterMap  atcm on at.AssessmentTemplateId =atcm.AssessmentTemplateId   
   INNER JOIN AssessmentTemplateTarget ATT 
   ON ATT.AssessmentTemplateTargetid = atcm.AssessmentTemplateTargetid
   AND lower(att.target ) IN ('investigation')
   and att.activeflag =1
      and atcm.activeflag =1 
      and at.activeflag =1
       inner join (select distinct atrc.AssessmentTemplateId from assessmenttemplateroleconfig  atrc
                     where atrc.activeflag =1 
           and atrc.roletypecode = case coalesce(v_roletypecode ,'') when '' then atrc.roletypecode else v_roletypecode end 
                 ) as  atrc on atrc.AssessmentTemplateId= at.AssessmentTemplateId
      -- and atrc.activeflag =1 
       --and atrc.roletypecode = case coalesce(v_roletypecode ,'') when '' then atrc.roletypecode else v_roletypecode end 
   where  atcm.intakeservicerequesttypeid = categoryid 
   and atcm.intakeservicerequestsubtypeid = subcategoryid
  
   
      UNION ALL
     select   at.AssessmentTemplateId,  at.external_templateid ,
       case when (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate)))< 0 then 0 else (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate))) end :: character varying,
   cast(at.titleheadertext as text)    as description
 ,ATT.target ,(select * from getassessmentdetails(servicerequestid :: character varying,At.assessmenttemplateid,true)) as intakassessment,
 (SELECT json_agg(e) as routinginfo 
    from (select  UP.lastname ||','|| up.firstname as fromusername,  
  upto.lastname ||','|| upto.firstname as tousername,
   RT.roletypename as fromrole,  RT1.roletypename as torole,case R.routingstatustypeid when 4 then 'Assigned' 
   else  RST.routingstatustypekey  end routingstatustypekey,R.insertedon as routedon from  routing R 
  inner join routingstatustype RST on RST.sequencenumber = R.routingstatustypeid
  inner join  userprofile UP on UP.securityusersid = R.fromsecurityusersid 
  inner join userprofile upto on upto.securityusersid = r.tosecurityusersid 
  inner join (select rt.*, rtt.roletypename from role  RT   
  inner join roletype rtt on rtt.shortname = rt.name ) RT on R.fromroleid = RT.roletypekey
  inner join (select rt.*, rtt.roletypename from role  RT
  inner join roletype rtt on rtt.shortname = rt.name ) RT1 on R.toroleid = RT1.roletypekey
  where R.objectid in (v_intakenumber,servicerequestid::character varying)
  order by r.updatedon asc  )e) 
      from AssessmentTemplate at inner join  AssessmentTemplateCategoryFilterMap  atcm on at.AssessmentTemplateId =atcm.AssessmentTemplateId   
   INNER JOIN AssessmentTemplateTarget ATT 
   ON ATT.AssessmentTemplateTargetid = atcm.AssessmentTemplateTargetid
   and lower(att.target ) IN ('intake') 
   and att.activeflag =1
      and atcm.activeflag =1 
      and at.activeflag =1
   where  ( atcm.teamtypekey  = agencycode or (atcm.intakeservicerequesttypeid = categoryid 
   and atcm.intakeservicerequestsubtypeid = subcategoryid))
   and ATT.AssessmentTemplateTargetid in (select A.AssessmentTemplateId from assessment A where A.objectid =servicerequestid
   and activeflag =1 and submissionid is not null)
  ) as ast order by ast.description;
  

ELSE

RETURN QUERY  

