CREATE OR REPLACE FUNCTION prov_gettrainings(trngobj json, pagenumber integer, pagesize integer)
 RETURNS TABLE(totalcount bigint, orientation_training_id character varying, training_number character varying, training_type character varying, training_date character varying, start_datetime character varying, end_datetime character varying, duration character varying, medium character varying, addr_line1 character varying, addr_line2 character varying, addr_city character varying, addr_state character varying, addr_zip character varying, training_url character varying, narrative character varying, instructor_1 character varying, instructor_2 character varying, jurisdiction character varying, training_topic character varying, training_status character varying, room_no character varying, session_type character varying, session_no character varying, countyname character varying)
 LANGUAGE plpgsql
AS $function$
 
DECLARE
v_pageoffset int;
v_pagenumber int;
v_training_number character varying;
v_jurisdiction character varying;
v_training_type character varying;
v_st_date character varying;
v_end_date character varying;
v_order_column character varying;
v_order_dir character varying; 

BEGIN

v_training_number=trngobj->>'training_number';
v_jurisdiction=trngobj->>'jurisdiction';
v_training_type=trngobj->>'training_type';  
v_st_date=trngobj->>'start_date';
v_end_date=trngobj->>'end_date';
v_order_column=trngobj->>'sortby';
v_order_dir=trngobj->>'sortdirection';
  v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;

return query 
 select count(1) over(),pt.orientation_training_id ::character varying, pt.training_number, pt.training_type, pt.training_date::character varying,
 pt.start_datetime ::character varying, pt.end_datetime::character varying, pt.duration::character varying, pt.medium, pt.addr_line1, pt.addr_line2, 
 pt.addr_city, pt.addr_state, pt.addr_zip,pt.training_url,pt.narrative, pt.instructor_1::character varying, 
pt.instructor_2 ::character varying,  pt.jurisdiction, pt.training_topic, pt.training_status, pt.room_no,
pt.session_type, pt.session_no:: character varying, 
 (select cnty.countyname from county cnty where cnty.statecountycode=pt.jurisdiction) as countyname 
 from providerorientationtraining pt where
          case when v_training_number ::character varying is not null then pt.training_number =v_training_number ::character varying else true end and
          case when v_jurisdiction ::character varying is not null then pt.jurisdiction=v_jurisdiction ::character varying else true end and  
          case when v_training_type ::character varying is not null then pt.training_type=v_training_type::character varying else true end and
          case when v_st_date ::character varying is not null then pt.training_date>=v_st_date::date else true end and
          case when v_end_date ::character varying is not null then pt.training_date<=v_end_date::date else true end and
          (pt.delete_sw='N' or pt.delete_sw is null) AND (pt.session_type is null or pt.session_type not ilike 'EXTERNAL') 
           order by (
    CASE v_order_dir
     WHEN 'asc'
     THEN
                         CASE v_order_column
                            WHEN 'training_number' THEN  cast(pt.training_number as character varying)
                          WHEN 'jurisdiction' THEN  cast(pt.jurisdiction as character varying)       
                          WHEN 'training_type' THEN cast(pt.training_type  as character varying)
                          WHEN 'training_date' THEN cast(pt.training_date  as character varying)
                          WHEN 'start_datetime' THEN cast(pt.start_datetime  as character varying)
                          WHEN 'duration' THEN cast(pt.duration  as character varying)
                          WHEN 'training_status' THEN cast(pt.training_status  as character varying)
                          WHEN 'session_type' THEN cast(pt.session_type  as character varying)
               ELSE
                      cast(pt.training_number as character varying)
               END
              END) ASC NULLS LAST,
                (CASE v_order_dir
                   WHEN 'desc'
     THEN
      CASE v_order_column
                            WHEN 'training_number' THEN  cast(pt.training_number as character varying)
                          WHEN 'jurisdiction' THEN  cast(pt.jurisdiction as character varying)       
                          WHEN 'training_type' THEN cast(pt.training_type  as character varying)
                          WHEN 'training_date' THEN cast(pt.training_date  as character varying)
                          WHEN 'start_datetime' THEN cast(pt.start_datetime  as character varying)
                          WHEN 'duration' THEN cast(pt.duration  as character varying)
                          WHEN 'training_status' THEN cast(pt.training_status  as character varying)
                          WHEN 'session_type' THEN cast(pt.session_type  as character varying)
               ELSE
                      cast(pt.training_number as character varying)
               END
                   END) DESC NULLS LAST  
  LIMIT pagesize OFFSET v_pageoffset;

END;
$function$

