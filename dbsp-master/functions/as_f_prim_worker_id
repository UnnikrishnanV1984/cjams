CREATE OR REPLACE FUNCTION as_f_prim_worker_id(ai_entity_id integer, ai_entity_cd character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE
declare ai_entity1_cd varchar(5);
declare ai_case_cd varchar(5);

BEGIN 

if ai_entity_cd='NULL' then
                              
 ai_case_cd = (select servicecasenumber from servicecase where old_id=ai_entity_id);

 if ai_case_cd='3333' then
     ai_entity1_cd='5590';
 else
     ai_entity1_cd='2952'; 
 end if;        
else
  ai_entity1_cd= ai_entity_cd; 
end if;

return
(select staff_id from (
select row_number() over() as num, staff_id, assignment_id from
   (SELECT  userprofile.old_id as staff_id, assignment.assignmentid as assignment_id
    FROM  assignment, userprofile  
     WHERE   
  ( assignment.entitykeyid = ai_entity_id) and
  ( assignment.entitytypetypekey = ai_entity1_cd) and
  ( assignment.responsibilitytypekey = 'P') and 
  ( userprofile.old_id = cast(assignment.assigntostaffid as varchar)) and 
  ( assignment.activeflag = 0) and
  ( userprofile.activeflag = 0) 
   order by assignment_id desc) te ) ryt where num=1);

END;

$function$

