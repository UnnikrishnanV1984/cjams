CREATE OR REPLACE FUNCTION as_addpersonprivatetransportation(v_intakenumber character varying, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE v_count bigint;

v_rec RECORD;

BEGIN  
   
 FOR  v_rec  IN 
 
  SELECT intakeserviceid FROM intakeservicerequest WHERE activeflag =1 
  AND intakenumber =v_intakenumber
 LOOP
 
  insert into persontransportation(dateoftransport,pickuptime,droptime,youthname,
          dob,courttime,courtlocation,chargereason,
          locationfromtypekey,locationtotypekey,otherlocationfrom,otherlocationto,
          notes,transportationtypekey,allegationid,personid,
          intakeserviceid,appointmentdate,effectivedate, updatedby,
          updatedon, insertedby,insertedon,activeflag) 
  select  pt.dateoftransport,pt.pickuptime,pt.droptime,pt.youthname,
     pt.dob,pt.courttime,pt.courtlocation,pt.chargereason,
     pt.locationfromtypekey,pt.locationtotypekey,pt.otherlocationfrom,pt.otherlocationto,
     pt.notes,pt.transportationtypekey,pt.allegationid,pt.personid,
     v_rec.intakeserviceid,pt.appointmentdate,now(),v_securityusersid,
     now(),v_securityusersid,now(),1
  FROM persontransportation pt 
  WHERE pt.intakenumber = v_intakenumber
  AND pt.activeflag=1;
 
    insert into privatetransportation(transportationtypekey,intakenumber,intakeserviceid,personid,
             notes,effectivedate, updatedby,updatedon,
             insertedby,insertedon,activeflag)
  select  pv.transportationtypekey, pv.intakenumber,v_rec.intakeserviceid,pv.personid,
            pv.notes ,now(),v_securityusersid,  now(),
            v_securityusersid,now(),1 
  FROM privatetransportation pv 
  WHERE pv.intakenumber = v_intakenumber
  AND pv.activeflag=1;            
    
 END LOOP;

  UPDATE persontransportation SET activeflag =0 
  WHERE intakenumber =v_intakenumber AND  activeflag =1; 
    
  UPDATE privatetransportation SET activeflag =0 
  WHERE intakenumber =v_intakenumber AND  activeflag =1; 
  
RETURN 'Successfull';
end;

$function$

