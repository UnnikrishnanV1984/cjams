CREATE OR REPLACE FUNCTION cap_acknowledge_notification(v_securityuserid character varying, v_cap_no character varying)
 RETURNS TABLE(status text, msgdata jsonb, username character varying)
 LANGUAGE plpgsql
AS $function$
DECLARE

v_providernm character varying;
v_notifymsg character varying;
v_msg character varying;
v_providername character varying;
v_toemailid character varying;
v_provideruserid character varying;
v_prov_id integer;
v_hasattachments boolean default false;
v_deficiency character varying;
v_notifystatus text;
i json;
v_msgdata jsonb;
v_provider_complaintid uuid;
v_username character varying;
v_notificationsecurityuserid character varying;

BEGIN  
-- Subject and Body for Email

update tb_provider_complaint_deficiency set isacknowledged =  true where cap_number = v_cap_no;
 
SELECT coalesce(lastname,'') ||', '|| coalesce(firstname,'') into v_providername                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     FROM userprofile WHERE securityusersid = v_securityuserid;

SELECT notificationsecurityuserid into v_notificationsecurityuserid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     FROM tb_provider_complaint_deficiency tpcd WHERE tpcd.cap_number = v_cap_no;
    
SELECT coalesce(lastname,'') ||', '|| coalesce(firstname,'') into v_username                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     FROM userprofile WHERE securityusersid = v_notificationsecurityuserid;
    
select  jsonb_agg(x) as msgdata into v_msgdata from (
 SELECT email from userprofile u where u.securityusersid = v_notificationsecurityuserid
)x;


v_msg := 'CAP Acknowledged on Deficiency/Violation of ' || v_cap_no || ' by ' || v_providername;
v_notifymsg :='ack by provider' ;

RAISE NOTICE 'v_msg(v_msg)---:%',v_msg;
RAISE NOTICE 'v_notifymsg-:%',v_notifymsg;
RAISE NOTICE 'v_providernm()---:%',i->>'securityusersid';

SELECT prov_send_notification INTO v_notifystatus FROM prov_send_notification(v_notificationsecurityuserid,v_securityuserid,v_notificationsecurityuserid,
                         'System', 'High', v_msg,  v_notifymsg ,v_cap_no ,false , v_hasattachments);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   



v_notifystatus:='SUCCESS';

return query

select v_notifystatus,v_msgdata,v_providername ;

END;
$function$

