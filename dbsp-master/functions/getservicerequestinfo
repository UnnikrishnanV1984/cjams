CREATE OR REPLACE FUNCTION getservicerequestinfo(v_objectid character varying, appeventcode character varying)
 RETURNS TABLE(intakeserviceid uuid, servicerequestnumber character varying, createdby character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE                    

v_intakeserviceid uuid;
v_servicerequestnumber character varying; 
v_insertedby character varying;

BEGIN




IF (appeventcode='ASST' OR appeventcode='SPLA') THEN

 RETURN  QUERY
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
   SELECT ASST.objectid 
   FROM assessment ASST 
   WHERE ASST.assessmentid = v_objectid::uuid limit 1
   );

ELSIF (appeventcode='PPLR') THEN

 RETURN  QUERY
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR
 WHERE ISR.intakeserviceid = (
   SELECT PP.intakeserviceid 
   FROM Permanencyplan PP 
   WHERE PP.permanencyplanid =  v_objectid::uuid limit 1
   );

ELSIF (appeventcode='CORR') THEN

 RETURN  QUERY
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby 
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
   SELECT CR.intakeserviceid 
   FROM Intakeservreqcourtorder CR 
   WHERE CR.Intakeservreqcourtorderid =  v_objectid::uuid limit 1
   );

ELSIF (appeventcode='GAAR') THEN

 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby 
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
   SELECT G.intakeserviceid
   FROM guardianship G
   INNER JOIN Gapagreement GA ON GA.gapid = G.gapid
   WHERE GA.gapagreementid = v_objectid::uuid limit 1
   );

ELSIF (appeventcode='GAARR') THEN

 RETURN  QUERY

 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
     SELECT G.intakeserviceid 
     FROM guardianship G
     INNER JOIN Gapagreement GA ON GA.gapid = G.gapid
     INNER JOIN Gapagreementrate GAR ON GAR.gapagreementid = GA.gapagreementid
     WHERE GAR.gapagreementid = v_objectid::uuid limit 1
     );
 

ELSIF (appeventcode='GAYR') THEN

 RETURN  QUERY

 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
    SELECT G.intakeserviceid 
    FROM guardianship G
    INNER JOIN Gapannualreview GAR ON GAR.gapid = G.gapid
    WHERE GAR.gapannualreviewid = v_objectid::uuid limit 1
    );

ELSIF (appeventcode='GADR') THEN

 RETURN  QUERY

 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
     SELECT G.intakeserviceid FROM guardianship G
     INNER JOIN Gapdisclosure GD ON GD.gapid = G.gapid
     WHERE GD.gapdisclosureid = v_objectid::uuid limit 1
     ); 
ELSIF (appeventcode='GASR') THEN

 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
    SELECT G.intakeserviceid 
    FROM guardianship G
    INNER JOIN Gapsuspension GS ON GS.gapid = G.gapid
    WHERE GS.gapsuspensionid = v_objectid::uuid limit 1
    );

ELSIF (appeventcode='CHRR') THEN

 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
    SELECT ISRCR.intakeserviceid 
    FROM Intakeservreqchildremoval ISRCR 
    WHERE ISRCR.intakeservreqchildremovalid = v_objectid::uuid limit 1
    );

ELSIF (appeventcode='INDR') THEN

 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
    SELECT INDR.intakeserviceid 
    FROM Intakeservicerequestdispositioncode INDR 
    WHERE INDR.intakeservicerequestdispositioncodeid = v_objectid::uuid limit 1
    );

ELSIF (appeventcode='TPRR') THEN

 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
    SELECT TPR.intakeserviceid 
    FROM Tprrecommendation TPR 
    WHERE TPR.tprrecommendationid = v_objectid::uuid limit 1);


ELSIF (appeventcode='ADPR') THEN

 RETURN  QUERY

 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
   SELECT AP.intakeserviceid 
   FROM adoptionplanning AP 
   WHERE AP.adoptionplanningid = v_objectid::uuid limit 1
   );


ELSIF (appeventcode='ABLR') THEN

 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = (
   SELECT AP.intakeserviceid 
   FROM adoptionplanning AP 
   INNER join Adoptionbreakthelink ABL ON ABL.adoptionplanningid = AP.adoptionplanningid
   WHERE ABL.adoptionbreakthelinkid = v_objectid::uuid limit 1
   );

ELSIF (appeventcode='IHSA') THEN
    RAISE NOTICE 'in dddv_objectid:%', v_objectid;
 RETURN  QUERY 
 SELECT ISR.intakeserviceid  ,ISR.servicerequestnumber ,ISR.insertedby  
 FROM intakeservicerequest ISR 
 WHERE ISR.intakeserviceid = v_objectid::uuid;


END IF;



  END;

$function$

