 CREATE  temp  TABLE  sp_createintake_temp_dapersontemp  (  

        personid  UUID  
    );  

 CREATE  temp  TABLE  sp_createintake_temp_personrole  (  

          personid      UUID,  

          personrole  CHARACTER  varying  

    );  

 IF LOWER(v_objecttypekey)<>'servicecase' THEN

      SELECT  intakeservreqtypeid,intakeservicerequestclassid  INTO  v_datypeid,v_dasubtypeid
   FROM  intakeservicerequest  WHERE  intakeserviceid  =  v_intakeserviceid  AND  activeflag  =1;

 
   SELECT  investigationid  INTO  v_investigationid
   FROM  investigation  WHERE  intakeserviceid  =  v_intakeserviceid  AND  activeflag  =1;

    END IF;
  
    FOR  v_person  IN  SELECT  *  FROM    json_array_elements(v_personjsondata)  LOOP

  INSERT  INTO  sp_createintake_temp_daperson (  

      id,  

      personid  ,  

      firstname  ,  

      lastname  ,  

      middlename,  

      dob  ,  

      dateofdeath,

      isapproxdod,

      stateid  ,  

      gender  ,  

      race  ,  

      ssn  ,  

                        mdm_id ,  

      ethicity,  

      occupation,  

      maritalstatustypekey,  

      religiontypekey,  

      tribalassociation,  

      physicalattributes,  

      relationshiptora,  

      dangerousself  ,  

      dangerousselfreason  ,  

      dangerousworker,  

      dangerousworkerreason,  

      mentealillness  ,  

      mentealillnessdetail,  

      mentealimpair,  

      mentealimpairdetail,  

      actorroletype  ,  

      suffix,
      
      salutation,  

      personalias  ,  

      userphoto,

      strengths,

      needs,  

      weight,

      livingsituationkey,

      licensedfacilitykey,

      otherlicensedfacility,

      livingsituationdesc,

      primarylanguage,

      secondarylanguage,

      otherprimarylanguage,

      otherreligion,

      citizenalenageflag,

      isqualifiedalien ,

      primarycitizenshiptypekey ,

                  seccitizenshiptypekey ,
                
                  nationalitytypekey ,

      alienregistrationtext ,

      verificationremarks,

      alienstatustypekey,
      safehavenbabyflag)  

        VALUES (  

      CAST(v_person  ->>  'id'  AS  INT),  (  

      CASE  length(v_person->>'Pid')  

      WHEN  0  THEN  '00000000-0000-0000-0000-000000000000'  

      ELSE  (v_person->>'Pid')  

      END  )::uuid,  

      v_person  ->>'Firstname',  

      v_person  ->>'Lastname',  

      v_person  ->>'Middlename',  

      (v_person  ->>'Dob')::  DATE,  

      (v_person  ->>'dateofdeath')::  DATE,

      (v_person  ->>'isapproxdod')::INT,

      v_person  ->>'stateid',  

      v_person  ->>'Gender',  

      v_person  ->>  'Race',  

      lower(v_person  ->>  'SSN'),

                        v_person  ->>  'mdm_id', 

      v_person  ->>'Ethicity',  

      v_person  ->>  'occupation',  

      v_person->>  'maritalstatustypekey',  

      v_person  ->>  'religiontypekey',  

      v_person  ->>  'tribalassociation',  

      v_person  ->>  'physicalattributes',  

      v_person  ->>  'RelationshiptoRA',  

      v_person  ->>  'Dangerousself',  

      v_person  ->>  'DangerousselfReason',  

      v_person  ->>  'Dangerousworker',  

      v_person  ->>  'DangerousWorkerReason',  

      v_person  ->>  'Mentealillness',  

      v_person  ->>  'MentealillnessDetail',  

      v_person  ->>  'Mentealimpair',  

      v_person  ->>  'MentealimpairDetail',  

      v_person  ->>  'Role'  ,  

      v_person  ->>'suffix',

      v_person  ->>'prefix',  

      v_person  ->>'aliasname',  

      v_person  ->>'userphoto',

      v_person  ->>'strengths',

      v_person  ->>'needs',

      v_person  ->>  'weight',

      v_person  ->>  'livingsituationkey',

      v_person  ->>  'licensedfacilitykey',

      v_person  ->>  'otherlicensedfacility',

      v_person  ->>  'livingsituationdesc',

      v_person  ->>  'primarylanguage',

      v_person  ->>  'secondarylanguage',

      v_person ->> 'otherprimarylanguage',

      v_person ->>'otherreligion',
      
      (v_person ->>'citizenalenageflag'):: int,
      
      (v_person ->>'isqualifiedalien') :: int,

      v_person ->> 'primarycitizenship' ,

                  v_person ->> 'secondarycitizenship' ,
                
                  v_person ->> 'nationality' ,
      
      v_person ->>'alienregistrationtext',
      
      v_person ->>'verificationremarks',
      
      v_person ->>'alienstatustypekey',
      
      (v_person ->>'safehavenbabyflag') :: int

                                );  
          /*  Person  maritalstatus  add  */

    v_personmaritalstatus:=  v_person->>'personmaritalstatus';
 
 INSERT  INTO  sp_createintake_temp_marital_status (

        personmaritalstatusid,   
        personid,                
        startdate,               
        enddate,                 
        marriageplace,           
        divorceplace,            
        prefixtypekey,           
        firstname,               
        middlename,              
        lastname,                
        suffixtypekey,           
        informallivingcomments,  
        childrenno,              
        statustypekey,           
        activeflag,              
        adrhomephone,           
        adrworkphone,            
        adrworkxtn                                                  
        
        )  
    VALUES(

        v_personmaritalstatus ->>'maritalstatusid',
        v_person->>'Pid',
        (v_personmaritalstatus ->>'startdate') :: timestamp without time zone,
        (v_personmaritalstatus ->>'enddate') :: timestamp without time zone,
        v_personmaritalstatus ->>'marriageplace',
        v_personmaritalstatus ->>'divorceplace',
        v_personmaritalstatus ->>'prefixtypekey',
        v_personmaritalstatus ->>'firstname',
        v_personmaritalstatus ->>'middlename',
        v_personmaritalstatus ->>'lastname',
        v_personmaritalstatus ->>'suffixtypekey',
        v_personmaritalstatus ->>'informallivingcomments',
        (v_personmaritalstatus ->>'childrenno') :: integer,
        v_personmaritalstatus ->>'statustypekey',
        (v_personmaritalstatus ->>'activeflag') :: integer,
        v_personmaritalstatus ->>'adrhomephone',
        v_personmaritalstatus ->>'adrworkphone',
        v_personmaritalstatus ->>'adrworkxtn'

    );

          /*  Person  phonenumber  add  */

 v_contacts:=  v_person->>'contacts';  
 
    
 INSERT  INTO  sp_createintake_temp_personcontact  
 SELECT  *  FROM  

     json_to_recordset(v_contacts)  AS  x(

    "contacttypeid"  CHARACTER  varying,  

    "contacttype"  CHARACTER  varying,  

    "ismobile"  bool,  "contactnumber"  CHARACTER  varying,  

    "isactive"  INT

     );

        /*  Person  email  add  */  

 v_contactsmail:=  v_person->>'contactsmail';  
 
 INSERT  INTO  sp_createintake_temp_personmail  
 SELECT  *  FROM  
 
     json_to_recordset(v_contactsmail)  AS  x(

    "mailtypeid"  CHARACTER  varying,  "mailtype"  CHARACTER  varying,  

    "mailid"  CHARACTER  varying,  "isactive"  INT

     );

        /*  Person  address  add  */ 
  
 v_addressdata  :=  v_person  ->>  'address';

 INSERT  INTO  sp_createintake_temp_address  
 SELECT  *  FROM    
 
  json_to_recordset(v_addressdata)  AS  x(

    "personaddressid"  CHARACTER  varying,  "addresstype"  CHARACTER  varying,   

    "address1"  CHARACTER  varying,  "Address2"  CHARACTER  varying,  

    "zipcode"  CHARACTER  varying,  "city"  CHARACTER  varying,  "county"  CHARACTER  varying,  

    "country"  CHARACTER  varying,  "state"  CHARACTER  varying,  

    "startDate"  DATE,  "endDate"  DATE,  

    "isactive"  INT,  "knownDangerAddress"  CHARACTER  varying,  

    "knownDangerAddressReason"  CHARACTER  varying,
    
    "personaddresstypekey" CHARACTER  varying,
    
    "changereason" CHARACTER  varying,

    "activeflag" INT

     );

 UPDATE  sp_createintake_temp_marital_status  
 SET        isnew  =1  
 WHERE    coalesce(personmaritalstatusid,'')  ='';

 UPDATE  sp_createintake_temp_personcontact  
 SET        isnew  =1  
 WHERE    coalesce(contacttypeid,'')  ='';  

 UPDATE  sp_createintake_temp_personmail  
 SET        isnew  =1  
 WHERE    coalesce(mailtypeid,'')  ='';  

 UPDATE  sp_createintake_temp_address  
 SET        isnew  =1  
 WHERE    coalesce(addressid,'')  ='';  

 UPDATE  sp_createintake_temp_daperson  
 SET        newperson  =1  
 WHERE    personid  ='00000000-0000-0000-0000-000000000000';  

 l_generatedpersonid  :=  gen_random_uuid();  

 /*UPDATE  personaddress    pa
 SET   activeflag=0,  
       updatedby  =  v_securityuserid,  
       updatedon  =  v_date  
 WHERE    personaddressid  NOT  IN  (  
     SELECT  addressid::uuid  
     FROM      sp_createintake_temp_address  ps
     WHERE    isnew=0  )
 AND  pa.personid  =l_generatedpersonid;  */

 UPDATE  personphonenumber  pa
 SET   activeflag=0,  
       updatedby  =  v_securityuserid,  
       updatedon  =  v_date  
 WHERE    personphonenumberid    NOT  IN  (  
     SELECT  contacttypeid::uuid  
     FROM      sp_createintake_temp_personcontact  ps
     WHERE    isnew=0 )
 AND  pa.personid  =l_generatedpersonid;  

   
 UPDATE  personemail  pa
 SET    activeflag=0,  
       updatedby  =  v_securityuserid,  
       updatedon  =  v_date  
 WHERE    personemailid  NOT  IN(  
     SELECT  mailtypeid::uuid  
     FROM      sp_createintake_temp_personmail  ps
     WHERE    isnew=0 )

 AND  pa.personid  =l_generatedpersonid;  

   

 IF  length(v_person  ->>  'Pid')  >  1  THEN  

     UPDATE  person  
     SET        dangertoself  =  (v_person  ->>  'Dangerousself')::  int,  

  dangertoselfreason  =  v_person  ->>  'DangerousselfReason',  

  ethnicgrouptypekey  =  v_person  ->>  'Ethicity',  

  racetypekey  =  v_person  ->>  'Race',  

  firstname  =  v_person->>'Firstname',  

  lastname=v_person->>'Lastname',  

  middlename=  v_person->>'Middlename',  

  dob  =  (v_person->>'Dob')::date,  

  dateofdeath  =  (v_person->>'dateofdeath')::date,  

  isapproxdod  =  (v_person->>'isapproxdod')::int,  

  religiontypekey=  v_person  ->>  'religiontypekey',  

  gendertypekey = v_person  ->>'Gender', 

  tribalassociation=  v_person  ->>  'tribalassociation',  

  physicalattributes=  v_person  ->>  'physicalattributes'  ,

  strengths = v_person  ->>'strengths',

  needs =  v_person  ->>'needs',

  occupation=v_person  ->>'occupation',

  name_suffix=  v_person  ->>'suffix',

  salutation=  v_person  ->>'prefix',  

  stateid= v_person  ->>'stateid',

  maritalstatustypekey= v_person->>  'maritalstatustypekey',

  livingsituationkey= v_person  ->>'livingsituationkey',

  licensedfacilitykey= v_person->>  'licensedfacilitykey',

  otherlicensedfacility= v_person  ->>'otherlicensedfacility',

  livingsituationdesc= v_person->>  'livingsituationdesc',

  primarylanguageid = v_person  ->>  'primarylanguage',

  secondarylanguageid = v_person  ->>  'secondarylanguage',

  otherprimarylanguagetypekey = v_person ->> 'otherprimarylanguage',

  otherreligion=v_person ->>'otherreligion',
  
  citizenalenageflag=(v_person ->>'citizenalenageflag') :: int,
  
  isqualifiedalien=(v_person ->>'isqualifiedalien') :: int,
      
  primarycitizenshiptypekey=v_person ->> 'primarycitizenship',

  seccitizenshiptypekey=v_person ->> 'secondarycitizenship',
                
  nationalitytypekey=v_person ->> 'nationality',
  
  alienregistrationtext=v_person ->>'alienregistrationtext',
  
  verificationremarks=v_person ->>'verificationremarks',
  
  alienstatustypekey=v_person ->>'alienstatustypekey',
  
  /**
   * Adding userphoto defect  D-06912 Photo uploaded but not saving.
        */
  
  userphoto =v_person  ->>'userphoto',
  safehavenbabyflag  =  (v_person->>'safehavenbabyflag')::int
  
 
     WHERE    personid  =  (v_person  ->>  'Pid')::uuid;   

     l_generatedpersonid  :=  (v_person  ->>  'Pid')::uuid; 

  /* Update person marital status */ 
  
  UPDATE  personmaritalstatus    pm
     
        SET 
  
          personid  = (v_person->>'Pid') :: uuid,                 
          startdate  = (v_personmaritalstatus ->>'startdate') :: timestamp without time zone,                
          enddate  = (v_personmaritalstatus ->>'enddate') :: timestamp without time zone,                  
          marriageplace  = v_personmaritalstatus ->>'marriageplace',            
          divorceplace  = v_personmaritalstatus ->>'divorceplace',             
          prefixtypekey  = v_personmaritalstatus ->>'prefixtypekey',            
          firstname  = v_personmaritalstatus ->>'firstname',                
          middlename  = v_personmaritalstatus ->>'middlename',               
          lastname  = v_personmaritalstatus ->>'lastname',                 
          suffixtypekey  = v_personmaritalstatus ->>'suffixtypekey',            
          informallivingcomments  = v_personmaritalstatus ->>'informallivingcomments',   
          childrenno  = (v_personmaritalstatus ->>'childrenno') :: integer,               
          statustypekey  = v_personmaritalstatus ->>'statustypekey',            
          activeflag  = (v_personmaritalstatus ->>'activeflag') :: integer,               
          adrhomephone  = v_personmaritalstatus ->>'adrhomephone',             
          adrworkphone  = v_personmaritalstatus ->>'adrworkphone',             
          adrworkxtn  = v_personmaritalstatus ->>'adrworkxtn',        
       updatedby  =  v_securityuserid,  
       updatedon  =  v_date

  WHERE  (pm.personmaritalstatusid) :: Character  varying  = v_personmaritalstatus ->>'maritalstatusid';

  /* Update person Address */
  
  
  UPDATE  personaddress    pa
     SET   activeflag=0,  
       updatedby  =  v_securityuserid,  
       updatedon  =  v_date  
  WHERE  pa.personid  =l_generatedpersonid; 
  
 
        Update personaddress pa
  set 
  
  activeflag =address.isactive,
  
  personaddresstypekey=address.personaddresstypekey,

  address = address.address1,

     address2 = address.Address2,  

     zipcode = address.zipcode,  

     city = address.city,  

     state = address.state,  

     county = address.county,  

     country = address.country,  

     effectivedate = address.startdate,  

     expirationdate = address.enddate,  

     danger = address.knowndangeraddress,  

     dangerreason = address.knowndangeraddressreason,
 
     changereason = address.changereason,
 
     personadrstartdate = address.v_startDate,
 
     personadrenddate =address.v_endDate
 
 FROM (SELECT    

               isactive ,

               --'C'  , 
          
                  COALESCE(addresstype ,personaddresstypekey) as personaddresstypekey ,

               COALESCE(  address1,'  ') as address1 ,  

               address2,  

               zipcode,  

               COALESCE(city,'') as city,  

               COALESCE(statekey,'') as state,  

      COALESCE(county,'') as county,  

               COALESCE(country,'') as country,  

               COALESCE(startdate,v_date) as startDate,  

               endDate,  

               CASE  Lower(knowndangeraddress)  

     WHEN  'yes'  THEN  true  

     WHEN  'no'  THEN  false  

     ELSE  NULL  

               END as knowndangeraddress,  

               knowndangeraddressreason  ,
               
               changereason,addressid,
  COALESCE(startdate,v_date) as v_startDate,  

               enddate as v_endDate

 FROM      sp_createintake_temp_address  
 where isactive=1) as address
   
   Where pa.personaddressid=(address.addressid) ::uuid; 
 
 
 
 /*
    SELECT  createpersoneducation  INTO  v_perspmedu  
    FROM  as_createpersoneducation(v_Personjsondata,l_generatedpersonid::uuid, v_securityuserid);

 SELECT  createpersonhealth  into  v_pershealth
 FROM  as_createpersonhealth(v_Personjsondata,l_generatedpersonid::uuid,v_securityuserid);  */ 

 SELECT  json_agg(e)FROM  (  
   SELECT     
    v_person->>'Firstname'  firstname,

    v_person->>'Lastname'  lastname,

    --v_person->>'Dob'  dob,

    v_person->>'maritalstatus'  maritalstatus,

    v_person->>'SSN'  ssn, 
    
    v_person->>'weight'  weight,
    
    v_person->>'occupation'  occupation)e  INTO  dadetails;

 SELECT  json_strip_nulls(json_build_object(
   'lastname',  a.lastname,  
   'firstname',  a.firstname,
   --,  'dob',  a.dob,
   'maritalstatustypekey',  a.maritalstatustypekey,  
   'occupation',  a.occupation))  
 FROM  (
   SELECT  CASE  WHEN  p.lastname  !=  v_person->>'Lastname'  THEN  
     (SELECT  json_build_object('oldvalue',  p.lastname,  
     'newvalue',  v_person->>'Lastname')  x) 
     ELSE  null  
     END  lastname,  
     CASE  WHEN  p.firstname  !=  v_person->>'Firstname'  THEN  
     (SELECT  json_build_object('oldvalue',  p.firstname,  
     'newvalue',  v_person->>'Firstname')  x)  
     ELSE  null  
     END  firstname,
     --,  CASE  WHEN  p.dob  !=  v_person->>'Dob'  THEN  
     --(SELECT  json_build_object('oldvalue',  p.dob, 
     --'newvalue',  v_person->>'Dob')  x)  
