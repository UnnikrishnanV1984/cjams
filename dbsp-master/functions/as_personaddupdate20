 personpayeecontact json; 
 

    BEGIN  

    v_Personjsondata  :=  persondetails->>'persondetails';

 v_date:=  now()  at  time  zone  'utc';

 IF LOWER(v_objecttypekey) = 'servicecase' THEN 
 v_IntakeServiceId = null; 
 END IF;
  

