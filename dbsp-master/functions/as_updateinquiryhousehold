CREATE OR REPLACE FUNCTION as_updateinquiryhousehold(v_inquiryid text, v_applicantid text, v_securityuserid text)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

declare

v_actorrecord record;
v_actorid uuid;
v_rolerecord record;
v_roletype character varying;
v_personroleid uuid;



BEGIN

raise notice 'v_inquiryid%',v_inquiryid;
raise notice 'v_applicantid%',v_applicantid;


    for v_actorrecord in 
 select  actorid,activeflag, personid, actortype, dangerlevel, dangerreason, insertedby, insertedon,expirationdate, "timestamp", primarylanguageid, secondarylanguageid, employeetypeid, employeetypename, medicaideligibility, blockgranteligibility, recipientstatus, livingarrangementtypekey, interpreterrequired, guardianname, guardianinfo, ramentalhealth, ramentalretarted, ramentalretartedtype, manualupdateflag, intakeserviceid, iscollateralcontact, old_id, ismentalillness, mentalillnessdetail, ismentalimpair, mentalimpairdetail, ishouseholdmember, isdangertoworker, dangertoworkerreason, sphouseholdmemberflag, spchildflag, spreporteranonymousflag, spreporternoletterflag, spexpungementflag, fetalalcoholspctrmdisordflag, drugexposednewbornflag, probationsearchconductedflag, sexoffenderregisteredflag, otherdrugs, unknownreporterflag, spproviderid, servicecaseid, fk_id, fk_c_id, personroletypeid, drugexposedkey, intakenumber from actor
 where intakenumber=v_inquiryid and activeflag=1
 
 loop
 raise notice 'v_actorrecord%',v_actorrecord;
 v_actorid = gen_random_uuid();
 
 INSERT INTO actor
(actorid, activeflag, personid, actortype, dangerlevel, dangerreason, insertedby, insertedon,expirationdate, primarylanguageid, 
secondarylanguageid, employeetypeid, employeetypename, medicaideligibility, blockgranteligibility, recipientstatus, livingarrangementtypekey,
interpreterrequired, guardianname, guardianinfo, ramentalhealth, ramentalretarted, ramentalretartedtype, manualupdateflag, intakeserviceid, iscollateralcontact, old_id, ismentalillness, 
mentalillnessdetail, ismentalimpair, mentalimpairdetail, ishouseholdmember, isdangertoworker, dangertoworkerreason, sphouseholdmemberflag, spchildflag, spreporteranonymousflag, spreporternoletterflag, spexpungementflag,
fetalalcoholspctrmdisordflag, drugexposednewbornflag, probationsearchconductedflag, sexoffenderregisteredflag, otherdrugs, unknownreporterflag, spproviderid, servicecaseid, fk_id, fk_c_id, personroletypeid, drugexposedkey, intakenumber)
  VALUES(v_actorid, 1, v_actorrecord.personid, v_actorrecord.actortype, v_actorrecord.dangerlevel, v_actorrecord.dangerreason, v_securityuserid, now(),now(), v_actorrecord.primarylanguageid,
  v_actorrecord.secondarylanguageid, v_actorrecord.employeetypeid, v_actorrecord.employeetypename, v_actorrecord.medicaideligibility,
v_actorrecord.blockgranteligibility, v_actorrecord.recipientstatus, v_actorrecord.livingarrangementtypekey,
v_actorrecord.interpreterrequired, v_actorrecord.guardianname, 
   v_actorrecord.guardianinfo, v_actorrecord.ramentalhealth, v_actorrecord.ramentalretarted, v_actorrecord.ramentalretartedtype, v_actorrecord.manualupdateflag, v_actorrecord.intakeserviceid, v_actorrecord.iscollateralcontact, v_actorrecord.old_id, 
   v_actorrecord.ismentalillness, v_actorrecord.mentalillnessdetail, v_actorrecord.ismentalimpair, v_actorrecord.mentalimpairdetail, v_actorrecord.ishouseholdmember, v_actorrecord.isdangertoworker, 
   v_actorrecord.dangertoworkerreason, v_actorrecord.sphouseholdmemberflag, v_actorrecord.spchildflag, v_actorrecord.spreporteranonymousflag, v_actorrecord.spreporternoletterflag, v_actorrecord.spexpungementflag,
  v_actorrecord.fetalalcoholspctrmdisordflag, v_actorrecord.drugexposednewbornflag, v_actorrecord.probationsearchconductedflag, v_actorrecord.sexoffenderregisteredflag,
  v_actorrecord.otherdrugs,
 v_actorrecord.unknownreporterflag, v_actorrecord.spproviderid, v_actorrecord.servicecaseid, v_actorrecord.fk_id, v_actorrecord.fk_c_id, v_actorrecord.personroletypeid, v_actorrecord.drugexposedkey, v_applicantid);
  
  insert into intakeservicerequestactor (actorid, intakeservicerequestpersontypekey, rapersontypekey, insertedby, insertedon, expirationdate,
  intakeserviceid, routingaddressid, employeetypeid, employeetypename, medicaideligibility, blockgranteligibility, livingarrangementtypekey, 
  guardianname, guardianinfo, ramentalhealth, ramentalretarted, ramentalretartedtype, refusessn, refusedob, activeflag, reported, isprimary, 
  personid, old_id, ismaltreator, rcprimaryroletypekey, ncpspriorhistoryflag, householdnumber, ssnverifytypekey, rchandicapflag, rchomelessflag, 
  lvgarrangementtypekey, livingprefixtypekey, lvgfirstname, lvgmiddlename, lvglastname, lvgsuffixtypekey, lvgrelationshiptypekey, lvgcomments,
  rchouseholdflag, rcchildflag, nonparticipatingflag, householdheadflag, rcinsertedon, rcinsertedby, rcupdatedon, rcupdatedby, rcactiveflag, 
  livingwith, rcreporteranonymousflag, rcreporternoletterflag, clientflag, rcexpungementflag, rcdatavalidflag, rcclientmergeid, arclientid, 
  arsummaryid, altrespclientid, participatingchildflag, aractiveflag, screeningpersonid, prexpungementflag, prdatavalidflag, prinsertedby,
  prupdatedby, practiveflag, referralclientid, caseclientid, crexpungementflag, crdatavalidflag, crinsertedby, crupdatedby, sphouseholdmemberflag,
  spchildflag, spreporteranonymousflag, spreporternoletterflag, spexpungementflag, fetalalcoholspctrmdisordflag, drugexposednewbornflag,
  probationsearchconductedflag, sexoffenderregisteredflag, otherdrugs, unknownreporterflag, spproviderid, fk_id, isvictim, servicecaseid,
  fk_cl_id, intakenumber)
  (select v_actorid,intakeservicerequestpersontypekey, rapersontypekey, v_securityuserid, now(), now(), intakeserviceid, routingaddressid, 
  employeetypeid, employeetypename, medicaideligibility, blockgranteligibility, livingarrangementtypekey, guardianname, guardianinfo, 
  ramentalhealth, ramentalretarted, ramentalretartedtype, refusessn, refusedob, activeflag, reported, isprimary, personid, old_id, ismaltreator,
  rcprimaryroletypekey, ncpspriorhistoryflag, householdnumber, ssnverifytypekey, rchandicapflag, rchomelessflag, lvgarrangementtypekey, 
  livingprefixtypekey, lvgfirstname, lvgmiddlename, lvglastname, lvgsuffixtypekey, lvgrelationshiptypekey, lvgcomments, rchouseholdflag, 
  rcchildflag, nonparticipatingflag, householdheadflag, rcinsertedon, rcinsertedby, rcupdatedon, rcupdatedby, rcactiveflag, livingwith, 
  rcreporteranonymousflag, rcreporternoletterflag, clientflag, rcexpungementflag, rcdatavalidflag, rcclientmergeid, arclientid, arsummaryid,
  altrespclientid, participatingchildflag, aractiveflag, screeningpersonid, prexpungementflag, prdatavalidflag, prinsertedby, prupdatedby, 
  practiveflag, referralclientid, caseclientid, crexpungementflag, crdatavalidflag, crinsertedby, crupdatedby, sphouseholdmemberflag, 
  spchildflag, spreporteranonymousflag, spreporternoletterflag, spexpungementflag, fetalalcoholspctrmdisordflag, drugexposednewbornflag,
  probationsearchconductedflag, sexoffenderregisteredflag, otherdrugs, unknownreporterflag, spproviderid, fk_id, isvictim, servicecaseid,
  fk_cl_id, v_applicantid from intakeservicerequestactor where actorid=v_actorrecord.actorid );
  
 
 end loop;
raise notice 'before role%','rle';
 for v_rolerecord in 
 SELECT personroleid, personid, ishouseholdmember, iscollateralcontact, drugexposednewbornflag, drugexposedtypekey, otherdrugs, safehavenbabyflag, probationsearchconductedflag, sexoffenderregisteredflag, dangertoself, dangertoselfreason, isdangertoworker, dangertoworkerreason, ismentalillness, mentalillnessdetail, ismentalimpair, mentalimpairdetail, intakenumber
FROM personrole
WHERE intakenumber=v_inquiryid and activeflag=1
loop 
INSERT INTO personrole
(activeflag, personid, ishouseholdmember, iscollateralcontact, drugexposednewbornflag, drugexposedtypekey, otherdrugs, safehavenbabyflag, probationsearchconductedflag, sexoffenderregisteredflag, dangertoself, dangertoselfreason, isdangertoworker, dangertoworkerreason, ismentalillness, mentalillnessdetail, ismentalimpair, mentalimpairdetail, insertedby, insertedon,  intakenumber)
VALUES( 1, v_rolerecord.personid,v_rolerecord.ishouseholdmember,v_rolerecord.iscollateralcontact,v_rolerecord.drugexposednewbornflag, v_rolerecord.drugexposedtypekey, v_rolerecord.otherdrugs, v_rolerecord.safehavenbabyflag, v_rolerecord.probationsearchconductedflag,v_rolerecord.sexoffenderregisteredflag, v_rolerecord.dangertoself, v_rolerecord.dangertoselfreason,v_rolerecord.isdangertoworker, v_rolerecord.dangertoworkerreason, v_rolerecord.ismentalillness, v_rolerecord.mentalillnessdetail, v_rolerecord.ismentalimpair, v_rolerecord.mentalimpairdetail, v_securityuserid, now(),
v_applicantid) RETURNING personroleid into v_personroleid;
select roletype into v_roletype from personroletype where personroleid=v_rolerecord.personroleid;
raise notice 'v_personroleid%',v_personroleid;
if (v_roletype is not null) then 
INSERT INTO personroletype
( personroleid, roletype, activeflag, insertedby, insertedon,  isprimary)
VALUES( v_personroleid, v_roletype, 1, v_securityuserid, now(), '1');
end if;

raise notice 'v_roletype%',v_roletype;
end loop;



RETURN 'Success';
                                                      
END;

$function$

