CREATE OR REPLACE FUNCTION prov_openoiginvestigation(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE
returnStatus text;
v_provider_uir_id uuid;
v_provider_oig_investigation_id uuid;
v_created_by character varying;


BEGIN

v_provider_uir_id=insertedtlsobj->>'provider_uir_id';
v_created_by=insertedtlsobj->>'create_user_id';


select provider_oig_investigation_id into v_provider_oig_investigation_id 
from provider_oig_investigation 
where provider_uir_id = v_provider_uir_id 
order by create_ts desc limit 1;

INSERT INTO provider_oig_investigation  
(provider_oig_investigation_id,      provider_uir_id,      investigation_required,      staff_arrested,      staff_narrative,      youth_criminally_charged,      youth_criminal_charge,      staff_criminally_charged,      staff_criminal_charge,      prea_hotline,      preahotline_narrative,      oig_investigation,      cps_finding,      cpsfinding_narrative,  
    create_user_id, create_ts, update_user_id, update_ts,       related_incident,      youth_charge_additional_info,      staff_charge_additional_info,      investigation_narrative,      incident_narrative)
select gen_random_uuid(),       poig.provider_uir_id, poig.investigation_required, poig.staff_arrested, poig.staff_narrative,   poig.youth_criminally_charged, poig.youth_criminal_charge, poig.staff_criminally_charged, poig.staff_criminal_charge, poig.prea_hotline, poig.preahotline_narrative, 'Open', poig.cps_finding, poig.cpsfinding_narrative,  
    v_created_by, now(), v_created_by, now(),              poig.related_incident, poig.youth_charge_additional_info, poig.staff_charge_additional_info, poig.investigation_narrative, poig.incident_narrative 
from  provider_oig_investigation poig
where poig.provider_oig_investigation_id = v_provider_oig_investigation_id;


returnStatus:= 'Success';

RETURN returnStatus;
                                                      
END;

$function$

