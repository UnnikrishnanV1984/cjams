CREATE OR REPLACE FUNCTION mycasesearch(userid character varying, page integer, pagelimit integer, casesearchval character varying, v_worker character varying, actiontype character varying, v_foldertypekey character varying, v_status character varying)
 RETURNS TABLE(totalcount bigint, intakeserviceid character varying, legalguardian json, servicerequestnumber character varying, srtype text, datereceived timestamp without time zone, workername character varying, updateon timestamp without time zone, adoptionplanningid uuid, startdate timestamp without time zone, restrictedstatus text, outcomes json, istagged integer)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 DECLARE  v_pageoffset  int;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 v_pagenumber  int;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 l_actiontype  character  varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     v_pagenumber  :=  (page-1)*10;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     l_actiontype:=actiontype;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     

     RETURN  QUERY
     select count(1) over(),x.*
   , COALESCE((SELECT 1 FROM userreference WHERE securityusersid = userid AND objectid=x.intakeserviceid),0)
 from 
    (( select  
     ins.intakeserviceid ::character varying,
     (select getcasepersonname as legalguardian from getcasepersonname ('servicerequest',ins.intakeserviceid::character varying)),
     ins.servicerequestnumber,
     case when ins.actiontype = 'IR' then 'CPS IR' when ins.actiontype = 'AR' then 'CPS AR' end as casetype,
--  (SELECT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
--  CASE WHEN ins.TargetCompleteDate is null then CAST(ins.ReportedDate as date) + CAST(src.DueDateOffset as integer)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
--  ELSE  ins.TargetCompleteDate                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
--   END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
--   FROM ServiceRequestTypeConfig as src                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
--   WHERE src.intakeservreqtypeid=ins.IntakeServReqTypeId 
--   AND src.servicerequestsubtypeid= ins.IntakeServiceRequestClassId and src.activeflag=1 limit 1  ),
 CAST(ins.ReportedDate as date),
     (select string_agg(distinct up.fullname, '- ')::character varying from routing r
      inner join userprofile up on up.securityusersid = r.tosecurityusersid 
      and r.objectid::text=ins.intakeserviceid :: text and r.eventcode = 'INVT' 
      and r.toroleid = 'CWCW') as fullname,
     ins.updatedon
     ,null :: uuid ,null ::timestamp without time zone,
     (SELECT * FROM getRestrictedCaseStatus(ins.intakeserviceid::text,userid)) AS restrictStatus,
     (  
  select json_agg(distinct alle."name")
  from investigation inv  
  join Investigationmaltreatment im on im.investigationid= inv.investigationid and im.activeflag =1
  JOIN Investigationallegation ia ON  ia.maltreatmentid = im.maltreatmentid        
  INNER JOIN allegation  alle on  alle.allegationid = ia.allegationid AND alle.activeflag = 1
  where  inv.intakeserviceid = ins.intakeserviceid  
  )
     from IntakeServiceRequestActor Actor
 join intakeservicerequest ins on ins.intakeserviceid = Actor.intakeserviceid
 --left join routing r on r.objectid = ins.intakeserviceid :: character varying and r.eventcode = 'INVT' and r.toroleid = 'CWCW'
    --left join userprofile up on up.securityusersid = r.tosecurityusersid
     where  ins.activeflag=1 and ins.teamtypekey ='CW' -- and ins.routedusersid is not null
     and ins.isdraft = 0
     and (l_actiontype is null or l_actiontype = '' or ins.actiontype =  l_actiontype)
     and (casesearchval is null or casesearchval = '' or LOWER(ins.servicerequestnumber)  LIKE   '%' ||   LOWER(casesearchval)  ||  '%')
-- and (casesearchval is null or casesearchval = '' or LOWER(ins.servicerequestnumber) =  LOWER(casesearchval))
     and ( v_worker is null or v_worker = '' or 
     (ins.intakeserviceid::text in (select objectid::text from routing r where  LOWER(r.tosecurityusersid) =   LOWER(v_worker)))  ) group by ins.intakeserviceid                                                                                                                                   
     )
     
union all

    ( select  
     ins.servicecaseid ::character varying,
     (select getcasepersonname as legalguardian from getcasepersonname ('servicecase',ins.servicecaseid::character varying)),
     ins.servicecasenumber,
     'Service' as casetype,
     ins.startdate,
     (select string_agg(distinct up.fullname, '- ')::character varying from routing r
    inner join userprofile up on up.securityusersid = r.tosecurityusersid and r.objectid=ins.servicecaseid :: character varying and r.eventcode = 'SRVC' and r.toroleid = 'CWCW') as fullname,
     ins.updatedon
     ,null :: uuid ,null ::timestamp without time zone,
     (SELECT * FROM getRestrictedCaseStatus(ins.servicecaseid::text,userid)) AS restrictStatus,
     null :: json
     from servicecase ins
   -- left join intakeservicerequest insq on insq.servicecaseid = ins.servicecaseid and insq.routedusersid is not null
    
    -- left join routing r on r.objectid = ins.servicecaseid :: character varying and r.eventcode = 'SRVC' and r.toroleid = 'CWCW' and r.activeflag =1 
     --left join userprofile up on up.securityusersid = r.tosecurityusersid
--     join userprofile up on up.securityusersid =ins.insertedby  
     where  ins.activeflag=1 
          and (l_actiontype is null or l_actiontype = '' or l_actiontype = 'SC')
     and (casesearchval is null or casesearchval = '' or LOWER(ins.servicecasenumber)  LIKE   '%' ||   LOWER(casesearchval)  ||  '%')
--and (casesearchval is null or casesearchval = '' or LOWER(ins.servicecasenumber) =  LOWER(casesearchval) )
     and ( v_worker is null or v_worker = '' or  (ins.servicecaseid::text in (select objectid::text from routing r where  LOWER(r.tosecurityusersid) =   LOWER(v_worker)))  )                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     )
    
union all

      (select 
      adc.adoptioncaseid ::character varying,
     (select getcasepersonname as legalguardian from getcasepersonname ('adoptioncase',adc.adoptioncaseid::character varying)),
   adc.adoptioncasenumber,
     'Adoption' as casetype,
     adc.startdate,
     (select string_agg(distinct up.fullname, '- ')::character varying from routing r
    inner join userprofile up on up.securityusersid = r.tosecurityusersid and r.objectid=adc.adoptioncaseid :: character varying and r.eventcode = 'ADPC' and r.toroleid = 'CWCW') as fullname,
     
     adc.updatedon
     ,adc.adoptionplanningid,adc.startdate,
     (SELECT * FROM getRestrictedCaseStatus( adc.adoptioncaseid::text,userid)) AS restrictStatus,
     null :: json
     from adoptioncase adc
--      join servicecase sc on sc.servicecaseid = adc.servicecaseid
--      join intakeservicerequest insq on insq.servicecaseid = sc.servicecaseid and insq.routedusersid is not null
    
     --left join routing r on r.objectid = adc.adoptioncaseid :: character varying and r.eventcode = 'ADPC' and r.fromroleid = 'CWCW' and r.activeflag =1 
     --left join userprofile up on up.securityusersid = r.tosecurityusersid
    -- join userprofile up on  up.securityusersid = adc.insertedby
     where  adc.activeflag=1 
               and (l_actiontype is null or l_actiontype = '' or l_actiontype = 'AD')
     and (casesearchval is null or casesearchval = '' or LOWER(adc.adoptioncasenumber)  LIKE   '%' ||   LOWER(casesearchval)  ||  '%')
 --and (casesearchval is null or casesearchval = '' or LOWER(adc.adoptioncasenumber)  =   LOWER(casesearchval))
     and ( v_worker is null or v_worker = '' or  (adc.adoptioncaseid::text in (select objectid::text from routing r where  LOWER(r.tosecurityusersid) =   LOWER(v_worker)))  )                                          
       )
    
union all

     ( select 
     
      ids.intakenumber,
     (select getcasepersonname as legalguardian from getcasepersonname ('intake',ids.intakenumber::character varying)),
   ids.intakenumber,
     'Referral' as casetype,
     ids.submitteddate daterecieved,
     up.fullname,
     ids.updatedon,
     null :: uuid ,null ::timestamp without time zone,
     (SELECT * FROM getRestrictedCaseStatus(ids.intakenumber::text,userid)) AS restrictStatus,
     null :: json
     from intakedastatus ids
     join userprofile up on  up.securityusersid = ids.intakeuser
     where  ids.activeflag=1 
               and (l_actiontype is null or l_actiontype = '' or l_actiontype = 'REF')
     and (casesearchval is null or casesearchval = '' or LOWER(ids.intakenumber)  LIKE   '%' ||   LOWER(casesearchval)  ||  '%')
   --   and (casesearchval is null or casesearchval = '' or LOWER(ids.intakenumber) =   LOWER(casesearchval))
     and ( v_worker is null or v_worker = '' or LOWER(up.securityusersid) =   LOWER(v_worker)  ) 
     )) x  WHERE x.restrictStatus in ('INCL','INCLRES')
    ORDER  BY COALESCE( x.updatedon)  DESC LIMIT  pagelimit OFFSET    v_pagenumber ;

 END;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 $function$

