CREATE OR REPLACE FUNCTION as_f_fm680r(start_date date, end_date date)
 RETURNS TABLE(county_nm character varying, total_active_fc bigint, total_fc_reimbur bigint, total_fc_nonreimburse1 bigint, total_fc_nonreimburse2 bigint, total_fc_ineligible bigint, total_fc_pending bigint, total_fc_incomp bigint, percent_fc_active numeric, total_sa_active bigint, total_sa_reimbur bigint, total_sa_nonreim bigint, total_sa_ineliglible bigint, total_sa_pending bigint, total_sa_incomp bigint, pecent_active_sa numeric, total_gs_active bigint, total_gs_reimbur bigint, total_gs_nonreimburse bigint, total_gs_ineligible bigint, total_gs_pending bigint, total_gs_incomp bigint, pecent_active_gs numeric, total_active_kc bigint, total_kc_reimbur bigint, total_kc_nonreimburse2 bigint, total_kc_ineligible bigint, total_kc_pending bigint, total_kc_incomp bigint, pecent_active_ks numeric, total_fc_sa_gs bigint, total_fc_sa_gs_reim bigint, total_fc_sa_gs_nonreimb1 bigint, total_fc_sa_gs_nonreimb2 bigint, total_fc_sa_gs_ineligible bigint, total_fc_sa_gs_pending bigint, total_fc_sa_gs_incomp bigint, percent_total_ive_active numeric, rank1 bigint)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY (
SELECT 
AA.COUNTY_NM,
AA.TOTAL_ACTIVE_FC,
AA.TOTAL_FC_REIMBUR,
AA.TOTAL_FC_NONREIMBURSE1,
AA.TOTAL_FC_NONREIMBURSE2,
AA.TOTAL_FC_INELIGIBLE,
AA.TOTAL_FC_PENDING,
AA.TOTAL_FC_INCOMP,
AA.PERCENT_FC_ACTIVE,
AA.TOTAL_SA_ACTIVE,
AA.TOTAL_SA_REIMBUR,
AA.TOTAL_SA_NONREIM,
AA.TOTAL_SA_INELIGLIBLE,
AA.TOTAL_SA_PENDING,
AA.TOTAL_SA_INCOMP,
AA.PECENT_ACTIVE_SA,
AA.TOTAL_GS_ACTIVE,
AA.TOTAL_GS_REIMBUR,
AA.TOTAL_GS_NONREIMBURSE,
AA.TOTAL_GS_INELIGIBLE,
AA.TOTAL_GS_PENDING,
AA.TOTAL_GS_INCOMP,
AA.PECENT_ACTIVE_GS,
AA.TOTAL_ACTIVE_KC,
AA.TOTAL_KC_REIMBUR,
AA.TOTAL_KC_NONREIMBURSE2,
AA.TOTAL_KC_INELIGIBLE,
AA.TOTAL_KC_PENDING,
AA.TOTAL_KC_INCOMP,
AA.PECENT_ACTIVE_KS,
AA.TOTAL_FC_SA_GS,
AA.TOTAL_FC_SA_GS_REIM,
AA.TOTAL_FC_SA_GS_NONREIMB1,
AA.TOTAL_FC_SA_GS_NONREIMB2,
AA.TOTAL_FC_SA_GS_INELIGIBLE,
AA.TOTAL_FC_SA_GS_PENDING,
AA.TOTAL_FC_SA_GS_INCOMP,
AA.PERCENT_TOTAL_IVE_ACTIVE,
AA.RANK1
FROM (
  WITH FC AS (
         SELECT CE.CLIENT_ID,
            F_PRIM_COUNTY(CE.CASE_ID) AS COUNTY,
            CE.ELIGIBILITY_TYPE_CD,
            CE.ELIGIBILITY_STATUS_CD,
            NULL::TIMESTAMP WITHOUT TIME ZONE AS SUBSIDY_START_DT,
            NULL::TIMESTAMP WITHOUT TIME ZONE AS SUBSIDY_END_DT,
            R.REMOVALDATE,
            R.RETURNDATE,
            'FOSTER CARE' AS CASE_TYPE
           FROM TB_CLIENT_ELIGIBILITY CE
             JOIN INTAKESERVREQCHILDREMOVAL R ON CE.REMOVAL_ID::TEXT = R.OLD_ID::TEXT AND CE.CLIENT_ID = (( SELECT LTRIM(PI.PERSONIDENTIFIERVALUE::TEXT, 'CL'::TEXT)::INTEGER AS LTRIM
                   FROM PERSONIDENTIFIER PI,
                    PERSON P,
                    INTAKESERVICEREQUESTACTOR ISR
                  WHERE P.PERSONID = PI.PERSONID AND P.PERSONID = ISR.PERSONID AND ISR.INTAKESERVICEREQUESTACTORID = R.INTAKESERVICEREQUESTACTORID)) AND CE.ELIGIBILITY_TYPE_CD::TEXT = '2931'::TEXT
          WHERE R.REMOVALDATE >= CAST(START_DATE AS DATE) AND R.REMOVALDATE <= CAST(END_DATE  AS DATE) AND NOT (CE.CLIENT_ID IN ( SELECT TB_PLACEMENT.CLIENT_ID
                   FROM TB_PLACEMENT
                  WHERE (TB_PLACEMENT.PLACEMENT_ID IN ( SELECT MAX(TB_PLACEMENT_1.PLACEMENT_ID) AS MAX
                           FROM TB_PLACEMENT TB_PLACEMENT_1
                          WHERE (TB_PLACEMENT_1.ENTRY_DT <= CAST(END_DATE  AS DATE) OR TB_PLACEMENT_1.ENTRY_DT IS NOT NULL) 
        
        AND (TB_PLACEMENT_1.EXIT_DT IS NULL OR TB_PLACEMENT_1.EXIT_DT >= CAST(START_DATE  AS DATE) ) AND TB_PLACEMENT_1.DELETE_SW = 'N'::BPCHAR AND (TB_PLACEMENT_1.VOID_SW IS NULL OR TB_PLACEMENT_1.VOID_SW = 'N'::BPCHAR) AND TB_PLACEMENT_1.PLACEMENT_STRUCTURE_ID = 8
                          GROUP BY TB_PLACEMENT_1.CLIENT_ID
                          ORDER BY TB_PLACEMENT_1.CLIENT_ID
                         LIMIT 1))
                 LIMIT 1)) AND NOT (CE.CLIENT_ID IN ( SELECT PI.PERSONIDENTIFIERVALUE::INTEGER AS PERSONIDENTIFIERVALUE
                   FROM PERSONIDENTIFIER PI
                     JOIN LIVINGARRANGEMENT LIV ON PI.PERSONID = LIV.PERSONID
                  WHERE LIV.ACTIVEFLAG = 0 AND LIV.LIVINGSTARTDATE <= CAST(END_DATE AS DATE)
      AND LIV.LIVINGARRANGEMENTTYPEKEY::TEXT = ANY (ARRAY['1505'::CHARACTER VARYING, '1532'::CHARACTER VARYING]::TEXT[]))
      AND NOT (EXISTS ( SELECT TB_PLACEMENT.PLACEMENT_ID
                           FROM TB_PLACEMENT
                          WHERE (TB_PLACEMENT.ENTRY_DT <= CAST(END_DATE  AS DATE) OR TB_PLACEMENT.ENTRY_DT IS NOT NULL) AND (TB_PLACEMENT.EXIT_DT IS NULL OR TB_PLACEMENT.EXIT_DT > CAST(END_DATE  AS DATE)) AND TB_PLACEMENT.DELETE_SW = 'N'::BPCHAR AND (TB_PLACEMENT.VOID_SW IS NULL OR TB_PLACEMENT.VOID_SW = 'N'::BPCHAR) AND TB_PLACEMENT.CLIENT_ID::CHARACTER VARYING::TEXT = ((( SELECT PI_1.PERSONIDENTIFIERVALUE
                                   FROM PERSONIDENTIFIER PI_1
                                     JOIN LIVINGARRANGEMENT LIV1_1 ON PI_1.PERSONID = LIV1_1.PERSONID))::TEXT))) AND (LIV1_1.LIVINGENDDATE IS NULL 
          OR LIV1_1.LIVINGENDDATE >= CAST(START_DATE  AS DATE)) AND (LIV1_1.OLD_ID::TEXT IN ( SELECT LIV2.OLD_ID
                           FROM LIVINGARRANGEMENT LIV2                          
                          WHERE LIV2.ACTIVEFLAG = 0 AND LIV2.LIVINGSTARTDATE <= CAST(END_DATE  AS DATE) AND (LIV2.LIVINGENDDATE IS NULL 
        OR LIV2.LIVINGENDDATE >= CAST(START_DATE AS DATE))
                          ORDER BY (COALESCE(LIV2.LIVINGENDDATE, CAST(END_DATE AS DATE))) DESC, 
            LIV2.LIVINGSTARTDATE DESC
                         LIMIT 1))) AND CE.DELETE_SW = 'N'::BPCHAR AND R.ACTIVEFLAG = 1
        ), ADOPTION AS (
         SELECT CE.CLIENT_ID,
            F_PRIM_COUNTY(CE.CASE_ID) AS COUNTY,
            CE.ELIGIBILITY_TYPE_CD,
            CE.ELIGIBILITY_STATUS_CD,
            SA.SUBSIDY_START_DT,
            SA.SUBSIDY_END_DT,
            'SUBSIDIZED ADOPTION' AS CASE_TYPE
           FROM TB_ADOPTION SA
             FULL JOIN TB_CLIENT_ELIGIBILITY CE ON SA.ADOPTION_ID = CE.ADOPTION_ID
          WHERE SA.SUBSIDY_START_DT <= CAST(END_DATE AS DATE) AND (SA.SUBSIDY_END_DT IS NULL OR SA.SUBSIDY_END_DT >= 
    CAST(START_DATE AS DATE)) AND SA.DELETE_SW = 'N'::BPCHAR
        ), GUARDIAN AS (
         SELECT CE.CLIENT_ID,
            F_PRIM_COUNTY(CE.CASE_ID) AS COUNTY,
            CE.ELIGIBILITY_TYPE_CD,
            CE.ELIGIBILITY_STATUS_CD,
            GS.SUBSIDY_START_DT,
            GS.SUBSIDY_END_DT,
            'SUBSIDIZED GUARDIANSHIP' AS CASE_TYPE
           FROM TB_GUARDIAN_SUBSIDY GS
             JOIN TB_CLIENT_ELIGIBILITY CE ON CE.CLIENT_ID = GS.CLIENT_ID AND CE.DELETE_SW = 'N'::BPCHAR AND GS.DELETE_SW = 'N'::BPCHAR
          WHERE GS.SUBSIDY_START_DT <= CAST(END_DATE AS DATE) AND GS.SUBSIDY_START_DT >= CAST(START_DATE AS DATE)
    AND (GS.SUBSIDY_END_DT >= CAST(START_DATE AS DATE) OR GS.SUBSIDY_END_DT IS NULL) 
    AND CE.ELIGIBILITY_TYPE_CD::TEXT = '2935'::TEXT AND GS.SUSBSIDY_APPROVAL_STATUS_CD::TEXT = '3047'::TEXT
        ), KC AS (
         SELECT CE.CLIENT_ID,
            F_PRIM_COUNTY(CE.CASE_ID) AS COUNTY,
            CE.ELIGIBILITY_TYPE_CD,
            CE.ELIGIBILITY_STATUS_CD,
            NULL::TIMESTAMP WITHOUT TIME ZONE AS SUBSIDY_START_DT,
            NULL::TIMESTAMP WITHOUT TIME ZONE AS SUBSIDY_END_DT,
            'KINSHIP CARE' AS CASE_TYPE,
            R.REMOVALDATE,
            R.RETURNDATE
           FROM TB_CLIENT_ELIGIBILITY CE
             JOIN INTAKESERVREQCHILDREMOVAL R ON CE.REMOVAL_ID::TEXT = R.OLD_ID::TEXT
          WHERE R.REMOVALDATE >= CAST(START_DATE AS DATE) AND R.REMOVALDATE <= CAST(END_DATE  AS DATE) AND (CE.CLIENT_ID IN ( SELECT TB_PLACEMENT.CLIENT_ID
                   FROM TB_PLACEMENT
                  WHERE (TB_PLACEMENT.PLACEMENT_ID IN ( SELECT MAX(TB_PLACEMENT_1.PLACEMENT_ID) AS MAX
                           FROM TB_PLACEMENT TB_PLACEMENT_1
                          WHERE (TB_PLACEMENT_1.ENTRY_DT <= CAST(END_DATE  AS DATE) OR TB_PLACEMENT_1.ENTRY_DT IS NOT NULL) 
        AND (TB_PLACEMENT_1.EXIT_DT IS NULL OR TB_PLACEMENT_1.EXIT_DT >= CAST(START_DATE AS DATE)) AND TB_PLACEMENT_1.DELETE_SW = 'N'::BPCHAR AND (TB_PLACEMENT_1.VOID_SW IS NULL OR TB_PLACEMENT_1.VOID_SW = 'N'::BPCHAR) AND TB_PLACEMENT_1.PLACEMENT_STRUCTURE_ID = 8
                          GROUP BY TB_PLACEMENT_1.CLIENT_ID)))) AND CE.DELETE_SW = 'N'::BPCHAR AND R.ACTIVEFLAG = 1
        ), FOSTER_CARE AS (
         SELECT FC.CLIENT_ID,
            FC.COUNTY,
            FC.ELIGIBILITY_TYPE_CD,
            FC.ELIGIBILITY_STATUS_CD,
            FC.SUBSIDY_START_DT,
            FC.SUBSIDY_END_DT,
            FC.CASE_TYPE
           FROM FC
          WHERE NOT (EXISTS ( SELECT 1
                   FROM GUARDIAN
                  WHERE GUARDIAN.CLIENT_ID = FC.CLIENT_ID AND FC.RETURNDATE >= CAST(START_DATE AS DATE) AND FC.RETURNDATE <= CAST(END_DATE  AS DATE) AND GUARDIAN.SUBSIDY_END_DT >= FC.RETURNDATE
                UNION
                 SELECT 1
                   FROM ADOPTION
                  WHERE ADOPTION.CLIENT_ID = FC.CLIENT_ID AND FC.RETURNDATE >= CAST(START_DATE AS DATE) AND FC.RETURNDATE <= CAST(END_DATE  AS DATE) AND ADOPTION.SUBSIDY_END_DT >= FC.RETURNDATE))
        ), KINSHIP AS (
         SELECT KC.CLIENT_ID,
            KC.COUNTY,
            KC.ELIGIBILITY_TYPE_CD,
            KC.ELIGIBILITY_STATUS_CD,
            KC.SUBSIDY_START_DT,
            KC.SUBSIDY_END_DT,
            KC.CASE_TYPE
           FROM KC
          WHERE NOT (EXISTS ( SELECT 1
                   FROM GUARDIAN
                  WHERE GUARDIAN.CLIENT_ID = KC.CLIENT_ID AND KC.RETURNDATE >= CAST(START_DATE AS DATE) AND KC.RETURNDATE <= CAST(END_DATE  AS DATE) AND GUARDIAN.SUBSIDY_END_DT >= KC.RETURNDATE
                UNION
                 SELECT 1
                   FROM ADOPTION
                  WHERE ADOPTION.CLIENT_ID = KC.CLIENT_ID AND KC.RETURNDATE >= CAST(START_DATE AS DATE) AND KC.RETURNDATE <= CAST(END_DATE  AS DATE) AND ADOPTION.SUBSIDY_END_DT >= KC.RETURNDATE))
        ), KIDS AS (
         SELECT FOSTER_CARE.CLIENT_ID,
            FOSTER_CARE.COUNTY,
            FOSTER_CARE.ELIGIBILITY_TYPE_CD,
            FOSTER_CARE.ELIGIBILITY_STATUS_CD,
            FOSTER_CARE.SUBSIDY_START_DT,
            FOSTER_CARE.SUBSIDY_END_DT,
            FOSTER_CARE.CASE_TYPE::TEXT AS CASE_TYPE
           FROM FOSTER_CARE
        UNION
         SELECT KINSHIP.CLIENT_ID,
            KINSHIP.COUNTY,
            KINSHIP.ELIGIBILITY_TYPE_CD,
            KINSHIP.ELIGIBILITY_STATUS_CD,
            KINSHIP.SUBSIDY_START_DT,
            KINSHIP.SUBSIDY_END_DT,
            KINSHIP.CASE_TYPE::TEXT AS CASE_TYPE
           FROM KINSHIP
        UNION
         SELECT GUARDIAN.CLIENT_ID,
            GUARDIAN.COUNTY,
            GUARDIAN.ELIGIBILITY_TYPE_CD,
            GUARDIAN.ELIGIBILITY_STATUS_CD,
            GUARDIAN.SUBSIDY_START_DT,
            GUARDIAN.SUBSIDY_END_DT,
            GUARDIAN.CASE_TYPE::TEXT AS CASE_TYPE
           FROM GUARDIAN
        UNION
         SELECT ADOPTION.CLIENT_ID,
            ADOPTION.COUNTY,
            ADOPTION.ELIGIBILITY_TYPE_CD,
            ADOPTION.ELIGIBILITY_STATUS_CD,
            ADOPTION.SUBSIDY_START_DT,
            ADOPTION.SUBSIDY_END_DT,
            ADOPTION.CASE_TYPE::TEXT AS CASE_TYPE
           FROM ADOPTION
        ), ALL_KIDS AS (
         SELECT B.CLIENT_ID,
            B.COUNTY,
            B.ELIGIBILITY_TYPE_CD,
            B.ELIGIBILITY_STATUS_CD,
            B.SUBSIDY_START_DT,
            B.SUBSIDY_END_DT,
            B.CASE_TYPE,
            B.AGE,
            B.FISCAL_CATEGORY_CD
           FROM ( SELECT DISTINCT A.CLIENT_ID,
                    A.COUNTY,
                    A.ELIGIBILITY_TYPE_CD,
                    A.ELIGIBILITY_STATUS_CD,
                    A.SUBSIDY_START_DT,
                    A.SUBSIDY_END_DT,
                    A.CASE_TYPE,
                    ( SELECT F_AGE(C.DOB_DT) AS F_AGE
                           FROM TB_CLIENT C
                          WHERE C.DELETE_SW = 'N'::BPCHAR AND C.CLIENT_ID = A.CLIENT_ID) AS AGE,
                    ( SELECT PD.FINAL_FISCAL_CATEGORY_CD
                           FROM TB_PAYMENT_DETAIL PD
                          WHERE PD.CLIENT_ID = A.CLIENT_ID AND PD.DELETE_SW::TEXT = 'N'::TEXT AND PD.PAYMENT_ID = (( SELECT MAX(PD2.PAYMENT_ID) AS MAX
                                   FROM TB_PAYMENT_DETAIL PD2
                                  WHERE PD.CLIENT_ID = PD2.CLIENT_ID AND PD2.DELETE_SW::TEXT = 'N'::TEXT AND PD2.FINAL_SERVICE_ID IS NOT NULL AND (PD2.PAYMENT_ID IN ( SELECT TB_PAYMENT_HEADER.PAYMENT_ID
   FROM TB_PAYMENT_HEADER
  WHERE TB_PAYMENT_HEADER.DELETE_SW = 'N'::BPCHAR AND TB_PAYMENT_HEADER.PAYMENT_DT <= CAST(END_DATE  AS DATE)))))
                         LIMIT 1) AS FISCAL_CATEGORY_CD
                   FROM KIDS A) B
        )
 SELECT S1.VALUE_TX AS COUNTY_NM,
    COALESCE(S1.TOTAL_ACTIVE_FC, 0::BIGINT) AS TOTAL_ACTIVE_FC,
    COALESCE(S1.TOTAL_FC_REIMBUR, 0::BIGINT) AS TOTAL_FC_REIMBUR,
    COALESCE(S1.TOTAL_FC_NONREIMBURSE1, 0::BIGINT) AS TOTAL_FC_NONREIMBURSE1,
    COALESCE(S1.TOTAL_FC_NONREIMBURSE2, 0::BIGINT) AS TOTAL_FC_NONREIMBURSE2,
    COALESCE(S1.TOTAL_FC_INELIGIBLE, 0::BIGINT) AS TOTAL_FC_INELIGIBLE,
    COALESCE(S1.TOTAL_FC_PENDING, 0::BIGINT) AS TOTAL_FC_PENDING,
    COALESCE(S1.TOTAL_FC_INCOMP, 0::BIGINT) AS TOTAL_FC_INCOMP,
    COALESCE(S1.PERCENT_FC_ACTIVE, 0::NUMERIC) AS PERCENT_FC_ACTIVE,
    COALESCE(S1.TOTAL_SA_ACTIVE, 0::BIGINT) AS TOTAL_SA_ACTIVE,
    COALESCE(S1.TOTAL_SA_REIMBUR, 0::BIGINT) AS TOTAL_SA_REIMBUR,
    COALESCE(S1.TOTAL_SA_NONREIM, 0::BIGINT) AS TOTAL_SA_NONREIM,
    COALESCE(S1.TOTAL_SA_INELIGLIBLE, 0::BIGINT) AS TOTAL_SA_INELIGLIBLE,
    COALESCE(S1.TOTAL_SA_PENDING, 0::BIGINT) AS TOTAL_SA_PENDING,
    COALESCE(S1.TOTAL_SA_INCOMP, 0::BIGINT) AS TOTAL_SA_INCOMP,
    COALESCE(S1.PERCENT_ACTIVE_SA, 0::NUMERIC) AS PECENT_ACTIVE_SA,
    COALESCE(S1.TOTAL_GS_ACTIVE, 0::BIGINT) AS TOTAL_GS_ACTIVE,
    COALESCE(S1.TOTAL_GS_REIMBUR, 0::BIGINT) AS TOTAL_GS_REIMBUR,
    COALESCE(S1.TOTAL_GS_NONREIMBURSE, 0::BIGINT) AS TOTAL_GS_NONREIMBURSE,
    COALESCE(S1.TOTAL_GS_INELIGIBLE, 0::BIGINT) AS TOTAL_GS_INELIGIBLE,
    COALESCE(S1.TOTAL_GS_PENDING, 0::BIGINT) AS TOTAL_GS_PENDING,
    COALESCE(S1.TOTAL_GS_INCOMP, 0::BIGINT) AS TOTAL_GS_INCOMP,
    COALESCE(S1.PERCENT_ACTIVE_GS, 0::NUMERIC) AS PECENT_ACTIVE_GS,
    COALESCE(S1.TOTAL_ACTIVE_KC, 0::BIGINT) AS TOTAL_ACTIVE_KC,
    COALESCE(S1.TOTAL_KC_REIMBUR, 0::BIGINT) AS TOTAL_KC_REIMBUR,
    COALESCE(S1.TOTAL_KC_NONREIMBURSE2, 0::BIGINT) AS TOTAL_KC_NONREIMBURSE2,
    COALESCE(S1.TOTAL_KC_INELIGIBLE, 0::BIGINT) AS TOTAL_KC_INELIGIBLE,
    COALESCE(S1.TOTAL_KC_PENDING, 0::BIGINT) AS TOTAL_KC_PENDING,
    COALESCE(S1.TOTAL_KC_INCOMP, 0::BIGINT) AS TOTAL_KC_INCOMP,
    COALESCE(S1.PERCENT_ACTIVE_KS, 0::NUMERIC) AS PECENT_ACTIVE_KS,
    COALESCE(S1.TOTAL_FC_SA_GS, 0::BIGINT) AS TOTAL_FC_SA_GS,
    COALESCE(S1.TOTAL_FC_SA_GS_REIM, 0::BIGINT) AS TOTAL_FC_SA_GS_REIM,
    COALESCE(S1.TOTAL_FC_SA_GS_NONREIMB1, 0::BIGINT) AS TOTAL_FC_SA_GS_NONREIMB1,
    COALESCE(S1.TOTAL_FC_SA_GS_NONREIMB2, 0::BIGINT) AS TOTAL_FC_SA_GS_NONREIMB2,
    COALESCE(S1.TOTAL_FC_SA_GS_INELIGIBLE, 0::BIGINT) AS TOTAL_FC_SA_GS_INELIGIBLE,
    COALESCE(S1.TOTAL_FC_SA_GS_PENDING, 0::BIGINT) AS TOTAL_FC_SA_GS_PENDING,
    COALESCE(S1.TOTAL_FC_SA_GS_INCOMP, 0::BIGINT) AS TOTAL_FC_SA_GS_INCOMP,
    COALESCE(S1.PERCENT_TOTAL_IVE_ACTIVE, 0::NUMERIC) AS PERCENT_TOTAL_IVE_ACTIVE,
        CASE
            WHEN COALESCE(S1.PERCENT_TOTAL_IVE_ACTIVE, 0::NUMERIC) = 0::NUMERIC THEN 0::BIGINT
            ELSE RANK() OVER (ORDER BY S1.PERCENT_TOTAL_IVE_ACTIVE)
        END AS RANK1
   FROM ( SELECT PLV.COUNTY,
            PLV.VALUE_TX,
            IVE_FC_ACTIVE.COUNT AS TOTAL_ACTIVE_FC,
            FC_REIMBUR.COUNT AS TOTAL_FC_REIMBUR,
            FC_INE.COUNT AS TOTAL_FC_INELIGIBLE,
            FC_PENDING.COUNT AS TOTAL_FC_PENDING,
            FC_INCOMP.COUNT AS TOTAL_FC_INCOMP,
            FC_NONREIMBUR1.COUNT AS TOTAL_FC_NONREIMBURSE1,
            FC_NONREIMBUR2.COUNT AS TOTAL_FC_NONREIMBURSE2,
                CASE
                    WHEN IVE_FC_ACTIVE.COUNT = 0 THEN 0::NUMERIC
                    ELSE ROUND((COALESCE(FC_REIMBUR.COUNT, 0::BIGINT)::NUMERIC(7,2) + COALESCE(FC_NONREIMBUR1.COUNT, 0::BIGINT)::NUMERIC(7,2)) / 
     IVE_FC_ACTIVE.COUNT::NUMERIC(7,2) * 100::NUMERIC, + 1)
                END AS PERCENT_FC_ACTIVE,
            TOTAL_SA.COUNT AS TOTAL_SA_ACTIVE,
            ADOP_REIM.COUNT AS TOTAL_SA_REIMBUR,
            ADP_INE.COUNT AS TOTAL_SA_INELIGLIBLE,
            ADP_PEND.COUNT AS TOTAL_SA_PENDING,
            ADP_INCOMP.COUNT AS TOTAL_SA_INCOMP,
            ADOP_NONREIM.COUNT AS TOTAL_SA_NONREIM,
                CASE
                    WHEN TOTAL_SA.COUNT = 0 THEN 0::NUMERIC
                    ELSE ROUND((COALESCE(ADOP_REIM.COUNT, 0::BIGINT)::NUMERIC(7,2) + COALESCE(ADOP_NONREIM.COUNT, 0::BIGINT)::NUMERIC(7,2)) / TOTAL_SA.COUNT::NUMERIC(7,2) * 100::NUMERIC, + 1)
                END AS PERCENT_ACTIVE_SA,
            IVE_GUARD_ACTIVE.COUNT AS TOTAL_GS_ACTIVE,
            IVE_GUARD_REIMB.COUNT AS TOTAL_GS_REIMBUR,
            IVE_GUARD_INELIGIBLE.COUNT AS TOTAL_GS_INELIGIBLE,
            IVE_GUARD_PENDING.COUNT AS TOTAL_GS_PENDING,
            IVE_GUARD_INCOMP.COUNT AS TOTAL_GS_INCOMP,
            IVE_GUARD_NONREIMB.COUNT AS TOTAL_GS_NONREIMBURSE,
                CASE
                    WHEN IVE_GUARD_ACTIVE.COUNT = 0 THEN 0::NUMERIC
                    ELSE ROUND((COALESCE(IVE_GUARD_REIMB.COUNT, 0::BIGINT)::NUMERIC(7,2) + COALESCE(IVE_GUARD_NONREIMB.COUNT, 0::BIGINT)::NUMERIC(7,2)) / IVE_GUARD_ACTIVE.COUNT::NUMERIC(7,2) * 100::NUMERIC, + 1)
                END AS PERCENT_ACTIVE_GS,
            KC_ACTIVE.COUNT AS TOTAL_ACTIVE_KC,
            KC_REIMBUR.COUNT AS TOTAL_KC_REIMBUR,
            KC_INE.COUNT AS TOTAL_KC_INELIGIBLE,
            KC_PENDING.COUNT AS TOTAL_KC_PENDING,
            KC_INCOMP.COUNT AS TOTAL_KC_INCOMP,
            KC_NONREIMBUR2.COUNT AS TOTAL_KC_NONREIMBURSE2,
                CASE
                    WHEN KC_ACTIVE.COUNT = 0 THEN 0::NUMERIC
                    ELSE ROUND(COALESCE(KC_REIMBUR.COUNT, 0::BIGINT)::NUMERIC(7,2) / KC_ACTIVE.COUNT::NUMERIC(7,2) * 100::NUMERIC, + 1)
                END AS PERCENT_ACTIVE_KS,
            COALESCE(IVE_FC_ACTIVE.COUNT, 0::BIGINT) + COALESCE(TOTAL_SA.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_ACTIVE.COUNT, 0::BIGINT) AS TOTAL_FC_SA_GS,
            COALESCE(FC_REIMBUR.COUNT, 0::BIGINT) + COALESCE(ADOP_REIM.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_REIMB.COUNT, 0::BIGINT) AS TOTAL_FC_SA_GS_REIM,
            COALESCE(FC_INE.COUNT, 0::BIGINT) + COALESCE(ADP_INE.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_INELIGIBLE.COUNT, 0::BIGINT) AS TOTAL_FC_SA_GS_INELIGIBLE,
            COALESCE(FC_PENDING.COUNT, 0::BIGINT) + COALESCE(ADP_PEND.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_PENDING.COUNT, 0::BIGINT) AS TOTAL_FC_SA_GS_PENDING,
            COALESCE(FC_INCOMP.COUNT, 0::BIGINT) + COALESCE(ADP_INCOMP.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_INCOMP.COUNT, 0::BIGINT) AS TOTAL_FC_SA_GS_INCOMP,
            COALESCE(FC_NONREIMBUR1.COUNT, 0::BIGINT) + 0 + 0 AS TOTAL_FC_SA_GS_NONREIMB1,
            COALESCE(FC_NONREIMBUR2.COUNT, 0::BIGINT) + COALESCE(ADOP_NONREIM.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_NONREIMB.COUNT, 0::BIGINT) AS TOTAL_FC_SA_GS_NONREIMB2,
                CASE
                    WHEN (COALESCE(IVE_FC_ACTIVE.COUNT, 0::BIGINT) + COALESCE(TOTAL_SA.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_ACTIVE.COUNT, 0::BIGINT)) = 0 THEN 0::NUMERIC
                    ELSE ROUND((COALESCE(FC_REIMBUR.COUNT, 0::BIGINT) + COALESCE(FC_NONREIMBUR1.COUNT, 0::BIGINT) + COALESCE(ADOP_REIM.COUNT, 0::BIGINT) + COALESCE(ADOP_NONREIM.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_REIMB.COUNT, 0 + COALESCE(IVE_GUARD_NONREIMB.COUNT, 0::BIGINT)))::NUMERIC(7,2) / (COALESCE(IVE_FC_ACTIVE.COUNT, 0::BIGINT) + COALESCE(TOTAL_SA.COUNT, 0::BIGINT) + COALESCE(IVE_GUARD_ACTIVE.COUNT, 0::BIGINT))::NUMERIC(7,2) * 100::NUMERIC, + 1)
                END AS PERCENT_TOTAL_IVE_ACTIVE
           FROM ( SELECT PP.PICKLIST_VALUE_CD AS COUNTY,
                    PP.VALUE_TX
                   FROM TB_PICKLIST_VALUES PP
                  WHERE PP.PICKLIST_TYPE_ID = 104 AND (PP.PICKLIST_VALUE_CD::TEXT <> ALL (ARRAY['3824'::CHARACTER VARYING, '3825'::CHARACTER VARYING, '3826'::CHARACTER VARYING]::TEXT[])) AND PP.DELETE_SW = 'N'::BPCHAR) PLV
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_FC_ACTIVE ON PLV.COUNTY::TEXT = IVE_FC_ACTIVE.COUNTY::TEXT
             LEFT JOIN ( SELECT C1.COUNTY,
                    COUNT(DISTINCT C1.CLIENT_ID) AS COUNT
                   FROM ( SELECT ALL_KIDS.COUNTY,
                            ALL_KIDS.CLIENT_ID
                           FROM ALL_KIDS
                          WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2913'::TEXT AND ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT AND NOT (ALL_KIDS.CLIENT_ID::TEXT IN ( SELECT PI.PERSONIDENTIFIERVALUE
                                   FROM PERSONIDENTIFIER PI
                                     JOIN LIVINGARRANGEMENT LV ON PI.PERSONID = LV.PERSONID
                                  WHERE LV.ACTIVEFLAG = 0 AND (LV.LIVINGARRANGEMENTTYPEKEY::TEXT = ANY (ARRAY['10460'::CHARACTER VARYING, '6589'::CHARACTER VARYING]::TEXT[])) AND LV.LIVINGSTARTDATE <= CAST(END_DATE  AS DATE) AND (LV.LIVINGENDDATE IS NULL OR LV.LIVINGENDDATE >= CAST(START_DATE AS DATE)))) AND NOT (ALL_KIDS.CLIENT_ID IN ( SELECT CE2.CLIENT_ID
                                   FROM TB_CLIENT_ELIGIBILITY CE2
                                  WHERE (CE2.ELIGIBILITY_STATUS_CD::TEXT = ANY (ARRAY['2277'::CHARACTER VARYING, '2278'::CHARACTER VARYING, '2286'::CHARACTER VARYING]::TEXT[])) AND (CE2.ELIGIBILITY_TYPE_CD::TEXT = ANY (ARRAY['2274'::CHARACTER VARYING, '2275'::CHARACTER VARYING]::TEXT[])) AND CE2.START_DT <= CAST(END_DATE  AS DATE) AND (CE2.END_DT IS NULL OR CE2.END_DT >= CAST(START_DATE AS DATE)) AND CE2.DELETE_SW = 'N'::BPCHAR))) C1
                  GROUP BY C1.COUNTY) FC_REIMBUR ON PLV.COUNTY::TEXT = FC_REIMBUR.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2914'::TEXT AND ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) FC_INE ON PLV.COUNTY::TEXT = FC_INE.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2909'::TEXT AND ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) FC_PENDING ON PLV.COUNTY::TEXT = FC_PENDING.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '3597'::TEXT AND ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) FC_INCOMP ON PLV.COUNTY::TEXT = FC_INCOMP.COUNTY::TEXT
             LEFT JOIN ( SELECT C1.COUNTY,
                    COUNT(DISTINCT C1.CLIENT_ID) AS COUNT
                   FROM ( SELECT DISTINCT FCA.COUNTY,
                            FCA.CLIENT_ID
                           FROM ALL_KIDS FCA
                             JOIN LIVINGARRANGEMENT LA ON FCA.CLIENT_ID::TEXT = ((( SELECT PI.PERSONIDENTIFIERVALUE
                                   FROM PERSONIDENTIFIER PI
                                  WHERE PI.PERSONID = LA.PERSONID))::TEXT) AND LA.ACTIVEFLAG = 0 AND (LA.LIVINGARRANGEMENTTYPEKEY::TEXT = ANY (ARRAY['10460'::CHARACTER VARYING, '6589'::CHARACTER VARYING]::TEXT[])) AND FCA.CASE_TYPE = 'FOSTER CARE'::TEXT AND LA.LIVINGSTARTDATE <= CAST(END_DATE  AS DATE) AND (LA.LIVINGENDDATE IS NULL OR LA.LIVINGENDDATE >= CAST(START_DATE AS DATE)) AND (DATE_PART('DAYS'::TEXT, COALESCE(LA.LIVINGENDDATE, CAST(END_DATE  AS DATE))) - DATE_PART('DAYS'::TEXT, COALESCE(LA.LIVINGSTARTDATE, CAST(START_DATE AS DATE)))) <= 180::DOUBLE PRECISION AND (FCA.ELIGIBILITY_STATUS_CD::TEXT = ANY (ARRAY['2912'::CHARACTER VARYING, '2913'::CHARACTER VARYING]::TEXT[]))
                        UNION
                         SELECT DISTINCT ALL_KIDS.COUNTY,
                            ALL_KIDS.CLIENT_ID
                           FROM ALL_KIDS
                          WHERE (ALL_KIDS.CLIENT_ID IN ( SELECT CE2.CLIENT_ID
                                   FROM TB_CLIENT_ELIGIBILITY CE2
                                  WHERE (CE2.ELIGIBILITY_STATUS_CD::TEXT = ANY (ARRAY['2277'::CHARACTER VARYING, '2278'::CHARACTER VARYING, '2286'::CHARACTER VARYING]::TEXT[])) AND (CE2.ELIGIBILITY_TYPE_CD::TEXT = ANY (ARRAY['2274'::CHARACTER VARYING, '2275'::CHARACTER VARYING]::TEXT[])) AND CE2.START_DT <= CAST(END_DATE  AS DATE) AND (CE2.END_DT IS NULL OR CE2.END_DT >= CAST(START_DATE AS DATE)) AND CE2.DELETE_SW = 'N'::BPCHAR)) AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2913'::TEXT AND ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT) C1
                  GROUP BY C1.COUNTY) FC_NONREIMBUR1 ON PLV.COUNTY::TEXT = FC_NONREIMBUR1.COUNTY::TEXT
             LEFT JOIN ( SELECT C1.COUNTY,
                    COUNT(DISTINCT C1.CLIENT_ID) AS COUNT
                   FROM ( SELECT DISTINCT FCA.COUNTY,
                            FCA.CLIENT_ID
                           FROM ALL_KIDS FCA
                             JOIN LIVINGARRANGEMENT LA ON FCA.CLIENT_ID::TEXT = ((( SELECT PI.PERSONIDENTIFIERVALUE
                                   FROM PERSONIDENTIFIER PI
                                  WHERE PI.PERSONID = LA.PERSONID))::TEXT) AND LA.ACTIVEFLAG = 0
                          WHERE (LA.LIVINGARRANGEMENTTYPEKEY::TEXT = ANY (ARRAY['10460'::CHARACTER VARYING, '6589'::CHARACTER VARYING]::TEXT[])) AND FCA.CASE_TYPE = 'FOSTER CARE'::TEXT AND LA.LIVINGSTARTDATE <= CAST(END_DATE  AS DATE) AND (LA.LIVINGENDDATE IS NULL OR LA.LIVINGENDDATE >= CAST(START_DATE AS DATE)) AND (DATE_PART('DAYS'::TEXT, COALESCE(LA.LIVINGENDDATE, CAST(END_DATE  AS DATE))) - DATE_PART('DAYS'::TEXT, COALESCE(LA.LIVINGSTARTDATE, CAST(START_DATE AS DATE)))) > 180::DOUBLE PRECISION AND FCA.ELIGIBILITY_STATUS_CD::TEXT = '2913'::TEXT
                        UNION
                         SELECT ALL_KIDS.COUNTY,
                            ALL_KIDS.CLIENT_ID
                           FROM ALL_KIDS
                          WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2912'::TEXT AND ALL_KIDS.CASE_TYPE = 'FOSTER CARE'::TEXT AND NOT (ALL_KIDS.CLIENT_ID IN ( SELECT FCA.CLIENT_ID
                                   FROM LIVINGARRANGEMENT LA
                                     JOIN ALL_KIDS FCA ON FCA.CLIENT_ID::TEXT = ((( SELECT PI.PERSONIDENTIFIERVALUE
   FROM PERSONIDENTIFIER PI
  WHERE PI.PERSONID = LA.PERSONID))::TEXT)
                                  WHERE LA.ACTIVEFLAG = 0 AND FCA.CASE_TYPE = 'FOSTER CARE'::TEXT AND (LA.LIVINGARRANGEMENTTYPEKEY::TEXT = ANY (ARRAY['10460'::CHARACTER VARYING, '6589'::CHARACTER VARYING]::TEXT[])) AND LA.LIVINGSTARTDATE <= CAST(END_DATE  AS DATE) AND (LA.LIVINGENDDATE IS NULL OR LA.LIVINGENDDATE >= CAST(START_DATE AS DATE)) AND (DATE_PART('DAYS'::TEXT, COALESCE(LA.LIVINGENDDATE, CAST(END_DATE  AS DATE))) - DATE_PART('DAYS'::TEXT, COALESCE(LA.LIVINGSTARTDATE, CAST(START_DATE AS DATE)))) <= 180::DOUBLE PRECISION AND FCA.ELIGIBILITY_STATUS_CD::TEXT = '2912'::TEXT))) C1
                  GROUP BY C1.COUNTY) FC_NONREIMBUR2 ON PLV.COUNTY::TEXT = FC_NONREIMBUR2.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED ADOPTION'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) TOTAL_SA ON PLV.COUNTY::TEXT = TOTAL_SA.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED ADOPTION'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2913'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) ADOP_REIM ON PLV.COUNTY::TEXT = ADOP_REIM.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED ADOPTION'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2914'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) ADP_INE ON PLV.COUNTY::TEXT = ADP_INE.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED ADOPTION'::TEXT AND (ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2909'::TEXT OR ALL_KIDS.ELIGIBILITY_STATUS_CD IS NULL)
                  GROUP BY ALL_KIDS.COUNTY) ADP_PEND ON PLV.COUNTY::TEXT = ADP_PEND.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED ADOPTION'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '3597'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) ADP_INCOMP ON PLV.COUNTY::TEXT = ADP_INCOMP.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED ADOPTION'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2912'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) ADOP_NONREIM ON PLV.COUNTY::TEXT = ADOP_NONREIM.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED GUARDIANSHIP'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_GUARD_ACTIVE ON PLV.COUNTY::TEXT = IVE_GUARD_ACTIVE.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED GUARDIANSHIP'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2913'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_GUARD_REIMB ON PLV.COUNTY::TEXT = IVE_GUARD_REIMB.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED GUARDIANSHIP'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2914'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_GUARD_INELIGIBLE ON PLV.COUNTY::TEXT = IVE_GUARD_INELIGIBLE.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED GUARDIANSHIP'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2909'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_GUARD_PENDING ON PLV.COUNTY::TEXT = IVE_GUARD_PENDING.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED GUARDIANSHIP'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '3597'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_GUARD_INCOMP ON PLV.COUNTY::TEXT = IVE_GUARD_INCOMP.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'SUBSIDIZED GUARDIANSHIP'::TEXT AND ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2912'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) IVE_GUARD_NONREIMB ON PLV.COUNTY::TEXT = IVE_GUARD_NONREIMB.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.CASE_TYPE = 'KINSHIP CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) KC_ACTIVE ON PLV.COUNTY::TEXT = KC_ACTIVE.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2913'::TEXT AND ALL_KIDS.CASE_TYPE = 'KINSHIP CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) KC_REIMBUR ON PLV.COUNTY::TEXT = KC_REIMBUR.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2914'::TEXT AND ALL_KIDS.CASE_TYPE = 'KINSHIP CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) KC_INE ON PLV.COUNTY::TEXT = KC_INE.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2909'::TEXT AND ALL_KIDS.CASE_TYPE = 'KINSHIP CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) KC_PENDING ON PLV.COUNTY::TEXT = KC_PENDING.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '3597'::TEXT AND ALL_KIDS.CASE_TYPE = 'KINSHIP CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) KC_INCOMP ON PLV.COUNTY::TEXT = KC_INCOMP.COUNTY::TEXT
             LEFT JOIN ( SELECT ALL_KIDS.COUNTY,
                    COUNT(DISTINCT ALL_KIDS.CLIENT_ID) AS COUNT
                   FROM ALL_KIDS
                  WHERE ALL_KIDS.ELIGIBILITY_STATUS_CD::TEXT = '2912'::TEXT AND ALL_KIDS.CASE_TYPE = 'KINSHIP CARE'::TEXT
                  GROUP BY ALL_KIDS.COUNTY) KC_NONREIMBUR2 ON PLV.COUNTY::TEXT = KC_NONREIMBUR2.COUNTY::TEXT) S1
  ORDER BY S1.VALUE_TX) AA);
  
 END;
