CREATE OR REPLACE FUNCTION f_ad_format(t_address_id integer, t_adr_format_cd character varying, t_emp_school_nm character varying, t_adr_street_no character varying, t_adr_box_no character varying, t_adr_pre_dir_cd character varying, t_adr_street_nm character varying, t_adr_street_sx_cd character varying, t_adr_post_dir_cd character varying, t_adr_unit_type_cd character varying, t_adr_unit_no_tx character varying, t_adr_city_nm character varying, t_adr_county_cd character varying, t_adr_state_cd character varying, t_adr_zip5_no character varying, t_adr_zip4_no character varying, t_adr_direction_tx character varying, t_adr_foreign_tx character varying, t_adr_foreign_sttx character varying, t_adr_country_tx character varying, t_adr_postal_cd_tx character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
declare f_final varchar(1500) default '';--
 lb_po_box varchar(1);--


 f_adr_street_NM VARCHAR(50)          default '';--
 f_ADR_STREET_NO VARCHAR(10)           default '';--
 f_ADR_BOX_NO VARCHAR(10)             default '';--
 f_ADR_PRE_DIR_CD VARCHAR(100)        default '';--
 f_ADR_POST_DIR_CD VARCHAR(100)       default '';--
 f_ADR_STREET_SUFFIX_CD VARCHAR(100)  default '';--
 f_ADR_FORMAT_CD     VARCHAR(15)      default '';--
 f_ADR_UNIT_TYPE_CD varchar(100)      default '';--
 f_ADR_UNIT_NO_TX      varchar(6)     default '';--
 f_ADR_CITY_NM          VARCHAR(50)   default '';   --
 f_ADR_COUNTY_CD        VARCHAR(5)    default '';--
 f_ADR_STATE_CD         VARCHAR(100)  default '';   --
 f_ADR_ZIP5_NO          VARCHAR(10)   default '';   --
 f_ADR_ZIP4_NO          VARCHAR(10)   default ''; --

 f_ADR_ZIP5_NO_t          VARCHAR(10)   default '';   --
 f_ADR_ZIP4_NO_t          VARCHAR(10)   default ''; --

 f_ADR_DIRECTION_TX     VARCHAR(500)  default '';  --
 f_ADR_FOREIGN_TX       VARCHAR(500)  default '';   --
 f_ADR_FOREIGN_STATE_TX VARCHAR(50)   default '';   --
 f_ADR_COUNTRY_TX       VARCHAR(50)   default '';   --
 f_ADR_POSTAL_CODE_TX   VARCHAR(10)   default '';--

 n_ADR_FORMAT_CD VARCHAR(15);
begin
--


n_ADR_FORMAT_CD := T_ADR_FORMAT_CD ;--
f_ADR_ZIP5_NO_t := t_ADR_ZIP5_NO;--
f_ADR_ZIP4_NO_t := t_ADR_ZIP4_NO;--

if (n_ADR_FORMAT_CD is null) or length(ltrim(rtrim(n_ADR_FORMAT_CD)))=0 then
    n_ADR_FORMAT_CD:='S';--
end if;--


if length(rtrim(ltrim(t_adr_zip5_no))) > 0 and t_adr_zip5_no is not null  and t_adr_zip5_no<>'' then
   f_ADR_ZIP5_NO = cast(t_adr_zip5_no as int);--
end if;--

if length(rtrim(ltrim(t_adr_zip4_no))) > 0 and t_adr_zip4_no is not null and t_adr_zip4_no<>''  then
   f_ADR_ZIP4_NO = cast(t_adr_zip4_no as int);
end if;--

---address type and street
     IF (RTRIM(UPPER(n_ADR_FORMAT_CD)) = 'P' ) THEN
         IF n_ADR_FORMAT_CD is not null AND length(ltrim(rtrim(n_ADR_FORMAT_CD)))>0 THEN
         f_ADR_FORMAT_CD  := 'PO Box'  ;--
         END IF;--
         IF (t_ADR_BOX_NO is not null ) AND length(ltrim(rtrim(t_ADR_BOX_NO)))>0 THEN
         f_ADR_STREET_NO := ltrim(RTRIM(t_ADR_BOX_NO)) || chr(10);--
  lb_po_box  := 'T' ;--
         END IF;--

     ELSEIF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'R' ) THEN
           IF ( n_ADR_FORMAT_CD is not null ) AND length(ltrim(rtrim(n_ADR_FORMAT_CD)))>0 THEN
    f_ADR_FORMAT_CD := 'Rural Rte'  ;--
           END IF; --
           IF (t_ADR_STREET_NO is not null) AND length(ltrim(rtrim(t_ADR_STREET_NO)))>0 THEN
     f_ADR_STREET_NO := ltrim(RTRIM(t_ADR_STREET_NO)) || ' ';--
     lb_po_box  := 'T';--
           END IF;--
           IF (t_ADR_BOX_NO is not null) AND length(ltrim(rtrim(t_ADR_BOX_NO)))>0 THEN
     f_ADR_BOX_NO := ltrim(RTRIM(t_ADR_BOX_NO)) || chr(10);--
     lb_po_box  := 'T';--
           END IF;--
     ELSEIF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'F' ) THEN
           IF (t_ADR_FOREIGN_TX is not null) AND length(ltrim(rtrim(t_ADR_FOREIGN_TX)))>0 THEN
     f_ADR_FOREIGN_tx := ltrim(RTRIM(t_ADR_FOREIGN_TX)) || chr(10);--
     lb_po_box  := 'T';--
           END IF;--
     END IF;--

---Building --  NOTHING BUT STREET NO

IF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'S' ) THEN
 IF ( t_ADR_STREET_NO is not null) AND length(ltrim(rtrim(t_ADR_STREET_NO)))>0 THEN
  f_ADR_STREET_NO := RTRIM(ltrim(t_ADR_STREET_NO)) ;--
 END IF ;--

 --- Description for Prefix Direction
 IF ( t_ADR_PRE_DIR_CD is not null) AND length(ltrim(rtrim(t_ADR_PRE_DIR_CD)))>0 THEN
  f_ADR_PRE_DIR_CD := RTRIM(ltrim(t_ADR_PRE_DIR_CD));--
 END IF ;--

end if;--

/*IF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'S' ) then
 --- IF Not PO Box

 --IF ( lb_po_box <> 'T' ) THEN
  --- Street Name
  IF (t_ADR_STREET_NM <> '' ) THEN
              set f_adr_street_nm = ltrim(RTRIM(t_ADR_STREET_NM)) || chr(10);--
         END IF;--
end if;--
  */

if (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'R' ) THEN
 --- IF Not PO Box

 --IF ( lb_po_box <> 'T' ) THEN
  --- Street Name
  IF (t_ADR_STREET_NM is not null ) AND length(ltrim(rtrim(t_ADR_STREET_NM)))>0 THEN
              f_adr_street_nm := ltrim(RTRIM(t_ADR_STREET_NM)) || chr(10);--
         END IF;--
end if;--


IF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'S' ) THEN
  IF (t_ADR_STREET_NM is not null ) AND length(ltrim(rtrim(t_ADR_STREET_NM)))>0 THEN
              f_adr_street_nm := ltrim(RTRIM(t_ADR_STREET_NM)) ;--
         END IF;--

  --- Street Type
  IF ( t_ADR_STREET_SX_CD is not null ) AND length(ltrim(rtrim(t_ADR_STREET_SX_CD)))>0 THEN
      f_ADR_STREET_SUFFIX_CD := ltrim(RTRIM(t_ADR_STREET_SX_CD)) ;--
  END IF;--
  IF ( t_ADR_POST_DIR_CD is not null) AND length(ltrim(rtrim(t_ADR_POST_DIR_CD)))>0 THEN
       f_ADR_POST_DIR_CD := RTRIM(ltrim(t_ADR_POST_DIR_CD)) || chr(10);--
  ELSE --
      f_ADR_POST_DIR_CD := chr(10);--
         END IF; --

 --IF ( lb_po_box <> 'T' ) THEN
 --- Unit Designator Bldg Room etc
 IF ( t_ADR_UNIT_TYPE_CD is not null) AND length(ltrim(rtrim(t_ADR_UNIT_TYPE_CD)))>0 THEN
  f_ADR_UNIT_TYPE_CD := ltrim(RTRIM(t_ADR_UNIT_TYPE_CD))  ; --
 END IF ;--
 --- Unit Name No
 IF ( t_ADR_UNIT_NO_TX  is not null ) AND length(ltrim(rtrim(t_ADR_UNIT_NO_TX)))>0 THEN
  f_ADR_UNIT_NO_TX := ltrim(RTRIM(t_ADR_UNIT_NO_TX)) || chr(10);--
 ELSE
       IF ( t_ADR_UNIT_TYPE_CD is not null) AND length(ltrim(rtrim(t_ADR_UNIT_TYPE_CD)))>0 THEN
               f_ADR_UNIT_NO_TX := CHR(10)  ; --
              END IF;  --
 END IF ;--


end if;--

--- City
IF ( t_ADR_CITY_NM is not null ) AND length(ltrim(rtrim(t_ADR_CITY_NM)))>0 THEN
 f_ADR_CITY_NM := ltrim(RTRIM(t_ADR_CITY_NM)) || ','; --
END IF ;--

--- State

IF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'F' ) THEN
-- IF ( t_ADR_STATE_CD <> '' ) THEN
    f_ADR_STATE_CD := ltrim(RTRIM(t_ADR_FOREIGN_STTX)) || ',' ; --
    f_ADR_STATE_CD := f_ADR_STATE_CD || ltrim(RTRIM(t_ADR_POSTAL_CD_TX)) || chr(10);--
    f_ADR_STATE_CD := f_ADR_STATE_CD || rtrim(t_ADR_COUNTRY_TX);--
-- END IF ;--
ELSE
 IF ( t_ADR_STATE_CD is not null ) AND length(ltrim(rtrim(t_ADR_STATE_CD)))>0 THEN
    f_ADR_STATE_CD := ltrim(RTRIM(t_ADR_STATE_CD)) ; --
 END IF ;--
END IF;--


--- Zip  CONCATENATE ZIP5 AND ZIP4 WITH A DASH
IF ( f_ADR_ZIP4_NO_t is not null ) AND length(ltrim(rtrim(f_ADR_ZIP4_NO_t)))>0 THEN
      f_ADR_ZIP4_NO := ltrim(RTRIM (f_ADR_ZIP4_NO_t))  ;--
END IF ;--
IF ( f_ADR_ZIP5_NO_t <> '') THEN
     f_ADR_ZIP5_NO := ltrim(RTRIM(f_ADR_ZIP5_NO_t));--
END IF ;--


IF (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'F' ) THEN

     /*  set f_final = ltrim(f_ADR_FORMAT_CD)    || ' ' ||
              ltrim(f_ADR_STREET_NO)    || ' ' ||
       ltrim(f_ADR_PRE_DIR_CD)   || ' ' ||
              ltrim(f_ADR_STREET_NM)    || ' ' ||
       ltrim(f_ADR_POST_DIR_CD)  || ' ' ||
       ltrim(f_ADR_STREET_SUFFIX_CD) || ' '||
              ltrim(f_ADR_UNIT_TYPE_CD) || ' ' ||
              ltrim(f_ADR_UNIT_NO_TX)   || ' ' ||
              ltrim(f_ADR_CITY_NM)      || ' ' ||
              ltrim(f_ADR_STATE_CD)    ;--
       */

   if length(ltrim(rtrim(f_ADR_FOREIGN_TX)))>0 and f_ADR_FOREIGN_TX is not null then
    f_final := ltrim(f_ADR_FOREIGN_TX) ;--
   end if ;--
   if length(ltrim(rtrim(f_ADR_CITY_NM)))>0 and f_ADR_CITY_NM is not null then
    f_final := f_final  || ltrim(f_ADR_CITY_NM) || '' ;--
   end if ;--
   if length(ltrim(rtrim(f_ADR_STATE_CD)))>0 and f_ADR_STATE_CD is not null then
    f_final := f_final  || ' ' || ltrim(f_ADR_STATE_CD) ;--
   end if ;--


elseif (RTRIM(UPPER(n_ADR_FORMAT_CD))  = 'R' ) THEN

   if length(ltrim(rtrim(f_ADR_FORMAT_CD)))>0 and f_ADR_FORMAT_CD is not null then
    f_final := ltrim(f_ADR_FORMAT_CD) || ' ' ;--
   end if ;--
   if length(ltrim(rtrim(f_ADR_STREET_NO)))>0 and f_ADR_STREET_NO is not null then
    f_final := f_final  || '' ||ltrim(f_ADR_STREET_NO) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_adr_box_no)))>0 and f_adr_box_no is not null then
    f_final := f_final  || ' ' ||ltrim(f_adr_box_no) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_STREET_NM)))>0 and f_ADR_STREET_NM is not null then
      if length(rtrim(ltrim(f_final))) > 0 then
    f_final := f_final  || ' ' ||ltrim(f_ADR_STREET_NM) || '' ;--
      else
     f_final := f_final  ||ltrim(f_ADR_STREET_NM) || '' ;--
      end if;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_CITY_NM)))>0 and f_ADR_CITY_NM is not null then
    f_final := f_final  || ltrim(f_ADR_CITY_NM) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_STATE_CD)))>0 and f_ADR_STATE_CD is not null then
    f_final := f_final  || ' ' ||ltrim(f_ADR_STATE_CD) || '' ;--
   end if ; --


else
  if length(ltrim(rtrim(f_ADR_ZIP4_NO)))>0 then
      f_ADR_ZIP5_NO := f_ADR_ZIP5_NO || ' - ';--
   end if;--

   if length(ltrim(rtrim(f_ADR_FORMAT_CD)))>0 and f_ADR_FORMAT_CD is not null then
    f_final := ltrim(f_ADR_FORMAT_CD) || ' ' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_STREET_NO)))>0 and f_ADR_STREET_NO is not null then
    f_final := f_final  || '' ||ltrim(f_ADR_STREET_NO) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_PRE_DIR_CD)))>0 and f_ADR_PRE_DIR_CD is not null then
    f_final := f_final  || ' ' || ltrim(f_ADR_PRE_DIR_CD) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_STREET_NM)))>0 and f_ADR_STREET_NM is not null then
      if length(rtrim(ltrim(f_final))) > 0 then
    f_final := f_final  || ' ' ||ltrim(f_ADR_STREET_NM) || '' ;--
      else
     f_final := f_final  ||ltrim(f_ADR_STREET_NM) || '' ;--
      end if;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_STREET_SUFFIX_CD)))>0 and f_ADR_STREET_SUFFIX_CD is not null then
    f_final := f_final  || ' ' ||ltrim(f_ADR_STREET_SUFFIX_CD) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_POST_DIR_CD)))>0 and f_ADR_POST_DIR_CD is not null then
    f_final := f_final  || ' ' || ltrim(f_ADR_POST_DIR_CD) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_UNIT_TYPE_CD)))>0 and f_ADR_UNIT_TYPE_CD is not null then
    f_final := f_final  || ''||ltrim(f_ADR_UNIT_TYPE_CD) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_UNIT_NO_TX)))>0 and f_ADR_UNIT_NO_TX is not null then
      if length(ltrim(rtrim(f_ADR_UNIT_TYPE_CD)))>0 and f_ADR_UNIT_TYPE_CD is not null then
    f_final := rtrim(f_final)  || ' ' ||ltrim(rtrim(f_ADR_UNIT_NO_TX)) || '' ;--
 else
    f_final := rtrim(f_final)  || '' ||ltrim(rtrim(f_ADR_UNIT_NO_TX)) || '' ; --
 end if;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_CITY_NM)))>0 and f_ADR_CITY_NM is not null then
    f_final := f_final  || ''||ltrim(f_ADR_CITY_NM) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_STATE_CD)))>0 and f_ADR_STATE_CD is not null then
    f_final := f_final  ||' ' || ltrim(f_ADR_STATE_CD) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_ZIP5_NO)))>0 and f_ADR_ZIP5_NO is not null then
    f_final := f_final  ||' ' || ltrim(f_ADR_ZIP5_NO) || '' ;--
   end if ; --
   if length(ltrim(rtrim(f_ADR_ZIP4_NO)))>0 and f_ADR_ZIP4_NO is not null then
    f_final := f_final  ||' ' || ltrim(f_ADR_ZIP4_NO) || '' ;--
   end if ; --


end if;--



RETURN f_final ;--

END  
;
$function$

