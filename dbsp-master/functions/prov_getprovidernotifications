CREATE OR REPLACE FUNCTION prov_getprovidernotifications(searchobj json)
 RETURNS TABLE(totalcount bigint, usernotificationid uuid, objecttype character varying, usernotificationtypekey character varying, url text, subject character varying, priorityleveltypekey character varying, body text, hasattachments boolean, updatedby character varying, updatedon timestamp without time zone, insertedby character varying, insertedon timestamp without time zone, teammemberid uuid, attachmentlocation character, tosecurityusersid character varying, isreplied boolean, isforwarded boolean, iscarboncopy boolean, isread boolean, effectivedate timestamp without time zone, expirationdate timestamp without time zone, intakeserviceid character varying, provider_id character varying, fromusername character varying, tousername character varying, old_id character varying)
 LANGUAGE plpgsql
AS $function$
DECLARE 
v_userID character varying;
v_providerid character varying;
v_liPageNumber      INT;                                                          
v_liPageSize       INT; 
v_pageNumber INT;                                                          
v_pageSize  INT; 
v_pageOffset int;


BEGIN

v_userID := searchObj ->> 'userid';
v_providerid := searchObj ->> 'provider_id';
v_liPageNumber := searchObj ->> 'pagenumber';
v_liPageSize := searchObj ->> 'pagesize';

 v_pageNumber := v_liPageNumber-1;
v_pageOffset = v_pageNumber * v_liPageSize;    


RETURN QUERY 
select count(1) over(), un.usernotificationid,un.objecttype,
un.usernotificationtypekey,un.url
,un.subject,un.priorityleveltypekey,un.body,un.hasattachments,un.updatedby,un.updatedon::timestamp,un.insertedby,
un.insertedon, un.teammemberid,un.attachmentlocation,
unmap.tosecurityusersid,unmap.isreplied,unmap.isforwarded,unmap.iscarboncopy,unmap.isread,
unmap.effectivedate,unmap.expirationdate,
un.objectid , un.provider_id, (select up.firstname||' '||up.lastname  from userprofile up where securityusersid =un.insertedby limit 1)::character varying as fromusername, (select up2.firstname||' '||up2.lastname from userprofile up2 where securityusersid =un.securityusersid limit 1)::character varying as tousername, un.old_id

from prov_usernotification un 
inner join prov_usernotificationmap unmap on un.usernotificationid=unmap.usernotificationid 
where un.provider_id = v_providerid
and un.activeflag=1 
order by un.updatedon desc

LIMIT v_liPageSize OFFSET v_pageOffset;

 END;
$function$

