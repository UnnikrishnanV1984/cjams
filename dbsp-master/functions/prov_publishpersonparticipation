CREATE OR REPLACE FUNCTION prov_publishpersonparticipation(v_entityid uuid, v_entitytype character varying, v_personid uuid)
 RETURNS void
 LANGUAGE plpgsql
AS $function$

BEGIN
 
 IF v_entitytype = 'servicerequest' THEN
  INSERT INTO tb_cjams_client_participation(cjams_person_id, chessie_client_id, cis_client_id, action_flag, participation_sw, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
  SELECT  DISTINCT
      p.cjamspid     CJAMS_PERSON_ID
    , CASE WHEN p.old_id IS NULL
     THEN NULL 
     ELSE cjamspid END   CHESSIE_CLIENT_ID
    , p.cisclientid    CIS_CLIENT_ID
    , 'A'      ACTION_FLAG
    , 'Y'      PARTICIPATION_SW
    , NOW()      CREATE_TS
    , 'CJAMS'     CREATE_USER_ID
    , NOW()      UPDATE_TS
    , 'CJAMS'     UPDATE_USER_ID
    , 'N'      DELETE_SW
  FROM  intakeservicerequest ir 
    INNER JOIN intakeservicerequestactor ira ON ira.intakeserviceid = ir.intakeserviceid AND ira.activeflag = 1
    INNER JOIN person p ON p.personid = ira.personid AND p.activeflag = 1
  WHERE ir.intakeserviceid = v_entityid
    AND (v_personid IS NULL OR p.personid = v_personid); 
 END IF;
 
 IF v_entitytype = 'servicecase' THEN
  INSERT INTO tb_cjams_client_participation(cjams_person_id, chessie_client_id, cis_client_id, action_flag, participation_sw, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
  SELECT  DISTINCT 
      p.cjamspid     CJAMS_PERSON_ID
    , CASE WHEN p.fk_id IS NULL
     THEN NULL 
     ELSE cjamspid END   CHESSIE_CLIENT_ID
    , p.cisclientid    CIS_CLIENT_ID
    , 'A'      ACTION_FLAG
    , 'Y'      PARTICIPATION_SW
    , NOW()      CREATE_TS
    , 'CJAMS'     CREATE_USER_ID
    , NOW()      UPDATE_TS
    , 'CJAMS'     UPDATE_USER_ID
    , 'N'      DELETE_SW
  FROM  servicecase sc 
    INNER JOIN intakeservicerequestactor ira ON ira.servicecaseid = sc.servicecaseid AND ira.activeflag = 1
    INNER JOIN person p ON p.personid = ira.personid AND p.activeflag = 1
  WHERE sc.servicecaseid = v_entityid; 
 END IF;

END

$function$

