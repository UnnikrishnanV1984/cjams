CREATE OR REPLACE FUNCTION as_schdproviderapppointment(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE
v_applicantdata json;
returnStatus text;
v_securityuserid text;
v_ReqApplicantId character varying;
v_contactemail character varying;
v_appstatus character varying;
v_appTitle character varying;

begin
 
v_ReqApplicantId := insertedtlsobj->>'provider_applicant_id';
v_securityuserid := insertedtlsobj->>'securityuserid';
v_appTitle := insertedtlsobj->>'appointment_title';
v_appStatus := insertedtlsobj->>'appointment_status';
RAISE NOTICE '%','11111111111111111111111111111111111111111111111111111';

IF(v_appStatus = 'Cancelled'  or v_appStatus = 'Rescheduled')
then
UPDATE tb_provider_applicant_appointment set appointment_status = v_appStatus  WHERE v_ReqApplicantId = provider_applicant_id and v_appTitle = appointment_title;
END if;

IF((LENGTH(v_ReqApplicantId) > 1) and (v_appStatus = 'Scheduled'))
then 

INSERT INTO tb_provider_applicant_appointment(appointmnet_id, provider_applicant_id, appointment_title, appointment_date, notes, appointment_worker, person_fullname, person_role, create_ts, create_user_id, update_ts, update_user_id, delete_sw,appointment_status)
VALUES(gen_random_uuid(), insertedtlsobj->>'provider_applicant_id', insertedtlsobj->>'appointment_title', (insertedtlsobj->>'appointment_date')::timestamp, insertedtlsobj->>'notes', insertedtlsobj->>'appointment_worker',
insertedtlsobj->>'person_fullname', insertedtlsobj->>'person_role', now(), v_securityuserid, now(), v_securityuserid, 'N'::bpchar,v_appStatus);

SELECT contact_email into v_contactemail FROM tb_provider_applicant WHERE v_ReqApplicantId = applicant_id;
else
returnStatus:= 'cancelled';
END IF;
returnStatus:= v_contactemail;
RETURN returnStatus;
                                                      
END;
$function$

