CREATE OR REPLACE FUNCTION as_getrestrictedcasestatus(v_intakeserviceid character varying, v_userid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE v_count integer; 
BEGIN  
    SELECT count(*) INTO v_count FROM restricteditems WHERE objectid=v_intakeserviceid and activeflag = 1;
    IF v_count=0 THEN 
      RETURN 'INCL';
    END IF;
 IF v_count>0 THEN 
   SELECT count(*) INTO v_count FROM restricteditems WHERE objectid=v_intakeserviceid AND accessuserid=v_userid and activeflag = 1;
   IF v_count>0 THEN 
     RETURN 'INCLRES';
   ELSE
     RETURN 'EXCLUDE';
   END IF;
 END IF;
END;
$function$

