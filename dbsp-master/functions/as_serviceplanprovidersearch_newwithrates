CREATE OR REPLACE FUNCTION as_serviceplanprovidersearch_newwithrates(searchobj json)
 RETURNS TABLE(totalcount bigint, providerid integer, providername character varying, firstname character varying, lastname character varying, countycode character varying, providertaxttypecode character varying, providertaxid numeric, vacancyno integer, approvaleffectivedate timestamp without time zone, approvedbeds integer, approvaldate timestamp without time zone, addrboxno integer, addrpredircode character varying, addrstreetname character varying, addrstreetsuffixcode character varying, addrpostaldircd character varying, addrcityname character varying, addrcountycode character varying, addrstate character varying, addrzipcode numeric, servicename character varying, fostercarestartdate timestamp without time zone, fostercareenddate timestamp without time zone, fostercareminage integer, fostercaremaxage integer, fostercaremonthlyrate numeric, fostercareperdiemrate numeric)
 LANGUAGE plpgsql
AS $function$

DECLARE 
    v_lvService VARCHAR(50);
    v_lvServiceType VARCHAR(50);                              
    v_lvServiceSubType VARCHAR(50);                         
    v_lvPaymentType VARCHAR(50);     
    v_lvChildCharacter json;                                                     
    v_liZipCode INT;       
    v_liCounty VARCHAR(50);
       v_lvProvider VARCHAR(50);
    v_liPageNumber INT;                              
    v_liPageSize INT;
       v_liCount INT;                              
    v_lvSortCol VARCHAR(50);                              
    v_lvSortDir VARCHAR(10); 
       v_pagenumber int;
       v_pageoffset int;
       
BEGIN 
v_lvServiceType := searchobj ->> 'servicetype';
v_lvService := searchobj ->> 'service'; 
v_lvServiceSubType := searchobj ->> 'servicesubtype';   
v_lvPaymentType := searchobj ->> 'paymenttype'; 
v_liZipCode := searchobj ->> 'zipcode';
v_liCounty := searchobj ->> 'county';
v_lvProvider := searchobj ->> 'provider';
v_lvChildCharacter := searchobj ->> 'childcharacteristic';
v_liPageNumber := searchobj ->> 'pagenumber';
v_liPageSize := searchobj ->> 'pagesize'; 

IF COALESCE(v_liPageSize, 0) < 1 THEN                     
       v_liPageSize := 10;
END IF;

IF COALESCE(v_liPageNumber, 0) < 1 
THEN
       v_liPageNumber := 1;      
end if;

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

return query
       
SELECT 
COUNT(1) OVER() totalcount, P.PROVIDER_ID,P.PROVIDER_NM,P.PROVIDER_FIRST_NM,P.PROVIDER_LAST_NM,P.COUNTY_CD,
P.PROV_TAX_TYPE_CD,P.TAX_ID_NO,P.VACANCY_NO, PA.EFFECTIVE_DT, PA.APPROVED_BEDS_NO, PA.APPROVAL_DT, PADDR.ADR_BOX_NO, PADDR.ADR_PRE_DIR_CD, PADDR.ADR_STREET_NM, PADDR.ADR_STREET_SUFFIX_CD,
PADDR.ADR_POST_DIR_CD, PADDR.ADR_CITY_NM, PADDR.ADR_COUNTY_CD, PADDR.ADR_STATE_CD,  PADDR.ADR_ZIP5_NO,
services.SERVICE_NM,
rate.START_DT, rate.END_DT, rate.MIN_AGE_NO, rate.MAX_AGE_NO, rate.MONTHLY_RATE_NO, rate.PER_DIEM_RATE_NO
FROM TB_PROVIDER P JOIN TB_PROVIDER_APPROVAL PA ON P.PROVIDER_ID = PA.PROVIDER_ID 
JOIN TB_PROVIDER_ADDRESSES PADDR ON P.PROVIDER_ID = PADDR.PARENT_KEY_ID
JOIN TB_PROVIDER_SERVICES ps on p.PROVIDER_ID = ps.PROVIDER_ID
JOIN TB_SERVICES services on ps.SERVICE_ID = services.SERVICE_ID
join TB_FOSTER_CARE_RATE rate on ps.SERVICE_ID = rate.SERVICE_ID
and P.provider_category_cd='1783' and 
(v_liZipCode IS NULL OR PADDR.ADR_ZIP5_NO = v_liZipCode) 
AND (v_liCounty IS NULL OR P.COUNTY_CD = v_liCounty)
and rate.end_dt is null and rate.start_dt>='2010-04-01' group by P.PROVIDER_ID,P.PROVIDER_NM,P.PROVIDER_FIRST_NM,P.PROVIDER_LAST_NM,P.COUNTY_CD,
P.PROV_TAX_TYPE_CD,P.TAX_ID_NO,P.VACANCY_NO, PA.EFFECTIVE_DT, PA.APPROVED_BEDS_NO, PA.APPROVAL_DT, PADDR.ADR_BOX_NO, PADDR.ADR_PRE_DIR_CD, PADDR.ADR_STREET_NM, PADDR.ADR_STREET_SUFFIX_CD,
PADDR.ADR_POST_DIR_CD, PADDR.ADR_CITY_NM, PADDR.ADR_COUNTY_CD, PADDR.ADR_STATE_CD,  PADDR.ADR_ZIP5_NO,
services.SERVICE_NM, rate.START_DT, rate.END_DT, rate.MIN_AGE_NO, rate.MAX_AGE_NO, rate.MONTHLY_RATE_NO, rate.PER_DIEM_RATE_NO

LIMIT v_liPageSize OFFSET v_pageoffset; 

END;

$function$

