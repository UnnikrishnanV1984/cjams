CREATE OR REPLACE FUNCTION prov_providerrouting(objectls json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


declare
v_fromsecurityuserid character varying;
v_appstatus character varying;

v_objectid character varying;
v_eventcode character varying;
v_msg character varying;
v_msgs character varying;
v_tosecurityusersid character varying;
v_tousersid json;
response json;

v_username character varying;
v_notification character varying;
v_notifymsg character varying DEFAULT ''::character varying;
v_site_id character varying;
v_provider_id character varying;
v_request_no character varying;
v_request_type character varying;
v_status character varying;
v_isfinal boolean;
v_activeflag integer;
v_rejectedbyid character varying;
v_provider_nm character varying;
v_execsignature json;
old_lic_application_id bigint;
new_lic_application_id bigint;
v_old_prov_accomodation_id uuid;
v_minimum_age_no integer;
v_maximum_age_no integer;
v_gender_cd integer;
v_children_no integer;
l_siteid integer;
v_address_type_cd integer;
v_pay_to_cd integer;
v_expiration_date timestamp;

begin

v_fromsecurityuserid:= objectls->>'fromsecurityuserid';
v_appstatus:= objectls->>'status';
v_objectid:= objectls->>'objectid';
v_eventcode := objectls->>'eventcode';
v_tosecurityusersid := objectls->>'tosecurityusersid';
v_isfinal := objectls->>'isfinalapproval';
v_execsignature:= (objectls->>'execsignature')::json;

select site_id :: character varying,provider_id,request_no,request_type
into v_site_id,v_provider_id,v_request_no,v_request_type
 from providerportalrequest where request_no = v_objectid ;

RAISE NOTICE 'v_objectid %', v_objectid;
RAISE NOTICE 'v_request_type %', v_request_type;

select (CASE WHEN (tp.provider_nm is null OR tp.provider_nm ='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) into v_provider_nm
from tb_provider tp where tp.provider_id::character varying  = v_provider_id;



select fromsecurityusersid into v_rejectedbyid from tb_provider_decision where objectid = v_objectid and eventcode in ('LICR','LIC') and activeflag= 1;

update tb_provider_decision set tosecurityusersid = v_fromsecurityuserid
where objectid = v_objectid and eventcode in ('LICR') and activeflag= 1;

if(v_appstatus = 'Approved') then

if(v_request_type = 'Voluntary Closure') then
 update tb_provider_licensing set(license_expiry_dt, license_status_cd)
 = (select coalesce(pp.request_date,null) , 3268
 from Providerportalrequest pp
 where request_no = v_objectid )
 WHERE license_application_id = (select license_application_id from tb_provider_licensing
 where site_id = (select site_id from providerportalrequest where request_no = v_objectid )::int and  license_no=(select license_no from providerportalrequest where request_no =v_objectid) and active_sw = 'Y' limit 1 );



elsif(v_request_type = 'License Change') then
  RAISE NOTICE 'v_execsignature %', v_execsignature;

  update Providerportalrequest set execsignature = v_execsignature where request_no = v_objectid;


  select license_application_id into old_lic_application_id
  from tb_provider_licensing
  WHERE active_sw = 'Y'
  and site_id = (select site_id from providerportalrequest where request_no = v_objectid )::int and  license_no=(select license_no from providerportalrequest where request_no =v_objectid)  limit 1;

  update tb_provider_licensing
  set active_sw = 'N'
  where license_application_id = old_lic_application_id;

                                                                                                                                                                                               select site_id::int into l_siteid from providerportalrequest where request_no = v_objectid;
  INSERT INTO tb_provider_licensing(
             provider_id, license_type_cd, license_status_cd,
            application_type_cd, license_decision_cd, license_issue_dt, license_expiry_dt,
            license_modification_dt, license_no, licensing_agency_cd, licensing_corodinator_id,
            licensed_beds_no, requirement_sw, midterm_issue_dt, active_sw,
            comments_tx, program_id, site_id, revoke_dt, revoke_approval_status_cd,
            midterm_rqrmnt_sw, create_ts, create_user_id, update_ts, update_user_id,
            delete_sw, ref_license_application_id, lic_entry_dt, request_revoke_sw,
            pre_revoke_status_cd, license_level, license_type)
  (SELECT  provider_id, license_type_cd, license_status_cd,
       application_type_cd, license_decision_cd, license_issue_dt, license_expiry_dt,
       license_modification_dt, license_no, licensing_agency_cd, licensing_corodinator_id,
       licensed_beds_no, requirement_sw, midterm_issue_dt, 'Y',
       comments_tx, program_id, site_id, revoke_dt, revoke_approval_status_cd,
       midterm_rqrmnt_sw, create_ts, create_user_id, update_ts, update_user_id,
       delete_sw, ref_license_application_id, lic_entry_dt, request_revoke_sw,
       pre_revoke_status_cd, license_level, license_type
    FROM tb_provider_licensing where license_application_id = old_lic_application_id) returning license_application_id into new_lic_application_id;


  select prov_accomodation_id into v_old_prov_accomodation_id from tb_prov_accomodation where license_application_id = old_lic_application_id;

  select coalesce(pp.min_age_to,pp.min_age_from)::integer , coalesce(pp.max_age_to,pp.max_age_from) ::integer,
        coalesce(pp.gender_to,pp.gender_from), coalesce(pp.children_no_to,pp.children_no_from) :: integer, execsignature
        into v_minimum_age_no, v_maximum_age_no, v_gender_cd, v_children_no, v_execsignature
  from Providerportalrequest pp
  where request_no = v_objectid;


  INSERT INTO tb_prov_accomodation(
    prov_accomodation_id,license_application_id,minimum_age_no, maximum_age_no, gender_cd, children_no,
      create_ts, create_user_id, update_ts, update_user_id, delete_sw,
      min_age_months_no, max_age_months_no, old_prov_accomodation_id,  execsignature, program_type_id, license_no, requested_license_end_date, requested_license_effective_date)
  (select gen_random_uuid(),new_lic_application_id, v_minimum_age_no, v_maximum_age_no, v_gender_cd, v_children_no,
    now(), v_fromsecurityuserid, now(), v_fromsecurityuserid, 'N',
    min_age_months_no, max_age_months_no, old_prov_accomodation_id,  v_execsignature, program_type_id, license_no, requested_license_end_date, requested_license_effective_date
   FROM tb_prov_accomodation where prov_accomodation_id = v_old_prov_accomodation_id limit 1);


elsif (v_request_type = 'Address Change') then 

  
  select  type_of_request, reason, site_id, provider_id
    , expiration_date
  into  v_address_type_cd, v_pay_to_cd, v_site_id, v_provider_id
    , v_expiration_date
  from providerportalrequest where request_no = v_objectid ;

  update tb_provider tp 
  set tp.pay_to_affiliate_cd = v_pay_to_cd 
  where tp.provider_id = v_site_id;

  update tb_provider_addresses tpa 
  set tpa.adr_default_sw = 'N' 
   , tpa.adr_end_dt = v_expiration_date::timestamp without time zone
  where tpa.parent_key_id = v_site_id::integer and tpa.adr_type_cd = v_address_type_cd and tpa.adr_default_sw='Y';

  INSERT INTO tb_provider_addresses
  (parent_key_id, adr_type_cd, adr_format_cd, adr_street_no, adr_box_no, adr_pre_dir_cd, adr_street_nm, adr_street_suffix_cd, adr_post_dir_cd, adr_unit_type_cd, adr_unit_no_tx, adr_city_nm, adr_county_cd, adr_state_cd, adr_zip5_no, adr_zip4_no, adr_direction_tx, adr_foreign_tx, adr_foreign_state_tx, adr_country_tx, adr_postal_code_tx, adr_default_sw, adr_start_dt, adr_end_dt, create_ts, create_user_id, update_ts, update_user_id, delete_sw, adr_street_tx, adr_county_cd_tx)
  SELECT v_site_id::integer, adr_type_cd, adr_format_cd, adr_street_no, adr_box_no, adr_pre_dir_cd, adr_street_nm, adr_street_suffix_cd, adr_post_dir_cd, adr_unit_type_cd, adr_unit_no_tx, adr_city_nm, adr_county_cd, adr_state_cd, adr_zip5_no, adr_zip4_no, adr_direction_tx, adr_foreign_tx, adr_foreign_state_tx, adr_country_tx, adr_postal_code_tx, 'Y', adr_start_dt, adr_end_dt, now(), v_fromsecurityuserid, now(), v_fromsecurityuserid, delete_sw, adr_street_tx, adr_county_cd_tx
  FROM tb_provider_applicant_addresses pra
  WHERE pra.parent_key_id = v_objectid and pra.adr_type_cd = v_address_type_cd and delete_sw='N';


end if;

RETURN 'success';
else 
return 'Not Approved';
end if;
end;
$function$

