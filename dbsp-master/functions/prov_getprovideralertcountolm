CREATE OR REPLACE FUNCTION prov_getprovideralertcountolm(v_provider_id character varying, fromsource character varying)
 RETURNS SETOF bigint
 LANGUAGE plpgsql
AS $function$
                                                                                                                                          
                                                                                                                                                        
                                                                                                                                                        
                                                                                                                                                        
 BEGIN                                                                                                                                                  
                                                                                                                                                        
  IF fromsource='count' THEN                                                                                                                            
  RETURN QUERY                                                                                                                                          
         select count(1) over() as count                                                                                                                       
         from prov_usernotification un                                                                                                                       
         inner join prov_usernotificationmap unmap  on un.usernotificationid=unmap.usernotificationid                                                                                      
         where  coalesce(unmap.isread,false)=false   and un.provider_id =  v_provider_id 
         and un.activeflag=1 ;                                                                                                                          
  END IF;                                                                                                                                               
                                                                                                                                                        
  END;
$function$

