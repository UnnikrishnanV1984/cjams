CREATE OR REPLACE FUNCTION getassessmentlist(intakenumber character varying, target character varying, agencycode character varying, servreqtypeid uuid, servreqsubtypeid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

 DECLARE 

assessmenttemplateid uuid;
v_target character varying;
assessmenttemplate_data json;
v_servreqtypeid uuid;
v_servreqsubtypeid uuid;


 BEGIN 

 v_target := target;
 v_servreqtypeid := servreqtypeid;
 v_servreqsubtypeid := servreqsubtypeid;

 if (coalesce(servreqtypeid::text,'')='') then
 
 v_servreqtypeid := '00000000-0000-0000-0000-000000000000';
 end if;

  if (coalesce(servreqsubtypeid::text,'')='') then
 
 v_servreqsubtypeid := '00000000-0000-0000-0000-000000000000';
 end if;
 

  select json_agg(a) from ( select A.assessmentTextPositionTypeKey,A.assessmentscoresetupid,     A.assessmenttemplateid,A.calculationmethod,A.datamappingenabled,A.description,
          A.effectivedate,A.enableassessmentscore,A.expirationdate,
   A.external_templateid,A.helptext,A.instructions,A.isvisible,A.name,B.old_id,
   A.scoringname,C.target,B.timestamp,A.titleheadertext,A.version 
  from assessmenttemplate A 
  inner join assessmenttemplatecategoryfiltermap B 
  On A.assessmenttemplateid  = B.assessmenttemplateid 
  inner join assessmenttemplatetarget C 
  on B.assessmenttemplatetargetid  = C.assessmenttemplatetargetid
   where C.target = v_target and B.teamtypekey = agencycode 
   and B.intakeservicerequesttypeid = v_servreqtypeid  
   and B.intakeservicerequestsubtypeid= v_servreqsubtypeid
   and A.activeflag = 1) a INTO assessmenttemplate_data;
    

RETURN assessmenttemplate_data; 
 END

 $function$

