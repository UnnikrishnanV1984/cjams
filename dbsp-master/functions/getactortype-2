CREATE OR REPLACE FUNCTION getactortype(teamtypekey character varying, v_datypeid uuid DEFAULT NULL::uuid)
 RETURNS TABLE(totalcount bigint, actortype character varying, typedescription character varying, sequencenumber integer, effictivedate timestamp without time zone, expirationdate timestamp without time zone, tasktype integer, activeflag integer, rolegroup character varying)
 LANGUAGE plpgsql
AS $function$

declare  v_teamtypekey  character  varying  =  null;
BEGIN
 v_teamtypekey:=  teamtypekey;
 
 IF(v_datypeid IS NOT NULL) THEN
  
  RETURN Query
  
  SELECT count(1) OVER() totalcount,a.actortype,a.typedescription,a.sequencenumber,a.effectivedate,
  a.expirationdate,a.tasktype,a.activeflag,a.rolegroup 
  FROM 
  (
   SELECT sat.actortype,sat.typedescription,sat.sequencenumber,sat.effectivedate,
   sat.expirationdate,sat.tasktype,sat.activeflag,sat.rolegroup 
   FROM 
   (
    SELECT at.actortype,at.typedescription,at.sequencenumber,at.effectivedate,
    at.expirationdate,at.tasktype,at.activeflag,at.rolegroup 
    FROM actortype at
    JOIN actortypeagency ata ON ata.actortypekey=at.actortype
    JOIN servicerequesttypeconfigrole srtcr ON srtcr.entityroletypekey=at.actortype AND srtcr.activeflag=1
                JOIN servicerequesttypeconfig sc ON sc.servicerequesttypeconfigid=srtcr.servicerequesttypeconfigid AND sc.activeflag=1
    WHERE ata.teamtypekey=v_teamtypekey AND at.activeflag=1 AND ata.activeflag=1  
    AND at.actortype!='Others' AND sc.intakeservreqtypeid=v_datypeid AND sc.servicerequestsubtypeid='00000000-0000-0000-0000-000000000000'
    GROUP BY at.actortype,at.typedescription,at.sequencenumber,at.effectivedate,
    at.expirationdate,at.tasktype,at.activeflag,at.rolegroup
    ORDER BY at.typedescription
   ) sat
   UNION ALL
   SELECT at.actortype,at.typedescription,at.sequencenumber,at.effectivedate,
    at.expirationdate,at.tasktype,at.activeflag,at.rolegroup 
    FROM actortype at
    JOIN actortypeagency ata ON ata.actortypekey=at.actortype
    JOIN servicerequesttypeconfigrole srtcr ON srtcr.entityroletypekey=at.actortype AND srtcr.activeflag=1
                JOIN servicerequesttypeconfig sc ON sc.servicerequesttypeconfigid=srtcr.servicerequesttypeconfigid AND sc.activeflag=1
    WHERE ata.teamtypekey=v_teamtypekey AND at.activeflag=1 AND ata.activeflag=1 
    AND sc.intakeservreqtypeid=v_datypeid AND sc.servicerequestsubtypeid='00000000-0000-0000-0000-000000000000'
    AND at.actortype='Others'
  ) a;
 
 ELSE 
  
  RETURN Query
  
  SELECT count(1) OVER() totalcount,a.actortype,a.typedescription,a.sequencenumber,a.effectivedate,
  a.expirationdate,a.tasktype,a.activeflag,a.rolegroup 
  FROM 
  (
   SELECT sat.actortype,sat.typedescription,sat.sequencenumber,sat.effectivedate,
    sat.expirationdate,sat.tasktype,sat.activeflag,sat.rolegroup 
    FROM
    (
     SELECT at.actortype,at.typedescription,at.sequencenumber,at.effectivedate,
     at.expirationdate,at.tasktype,at.activeflag,at.rolegroup 
     FROM actortype at
     JOIN actortypeagency ata ON ata.actortypekey=at.actortype
     WHERE ata.teamtypekey=v_teamtypekey AND at.activeflag=1 AND ata.activeflag=1  
     AND at.actortype!='Others' ORDER BY at.typedescription
    ) sat
   UNION ALL
   SELECT at.actortype,at.typedescription,at.sequencenumber,at.effectivedate,
   at.expirationdate,at.tasktype,at.activeflag,at.rolegroup
   FROM actortype at
   JOIN actortypeagency ata ON ata.actortypekey=at.actortype
   WHERE ata.teamtypekey=v_teamtypekey AND at.activeflag=1 AND ata.activeflag=1  
   AND at.actortype='Others'
  )  a;
  
 END IF;
 
END;

$function$

