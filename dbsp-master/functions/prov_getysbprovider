CREATE OR REPLACE FUNCTION prov_getysbprovider(searchobj json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
 
    v_provider_id INTEGER;
    v_json_data json;

BEGIN

 v_provider_id := searchobj ->> 'provider_id';
    


select json_agg(a) into v_json_data from (
   
  SELECT TBP.*, tpl.*, tpl.update_ts as approval_dt,
  (select c.countyname::character varying from county c where c.statecountycode = tbp.county_cd limit 1) as jurisdiction
  FROM tb_provider as TBP
  LEFT JOIN ProviderAssignment PVA ON PVA.objectid = TBP.provider_id::character varying
    left join providerinfoconfig PICG on PICG.providerid = TBP.provider_id and PICG.activeflag=1
  INNER JOIN TB_PROVIDER_PICKLIST tpp 
    ON tpp.provider_id = tbp.provider_id
        LEFT JOIN tb_provider_licensing tpl 
    ON tpl.provider_id = tbp.provider_id and tpl.active_sw = 'Y'
        LEFT JOIN userprofile up 
                ON up.securityusersid = tpl.update_user_id
  WHERE TBP.delete_sw <> 'Y' and tpp.delete_sw <> 'Y' and tpp.PICKLIST_TYPE_ID=155 AND tpp.picklist_value_cd = '3795'
    AND (CASE WHEN v_provider_id IS NOT NULL THEN TBP.provider_id like '%' || v_provider_id ||'%' ELSE TRUE END)
    
) a ;

return v_json_data;
 
END;
$function$

