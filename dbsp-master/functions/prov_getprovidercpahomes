CREATE OR REPLACE FUNCTION prov_getprovidercpahomes(v_affiliate_provider_id character varying, v_sort_by character varying)
 RETURNS TABLE(totalcount bigint, provider_id integer, provider_first_nm character varying, provider_last_nm character varying, contact_number character varying, address character varying)
 LANGUAGE plpgsql
AS $function$
 
BEGIN 
 return query
 select count(1) over() as totalcount,
 p.provider_id,
 p.provider_first_nm, p.provider_last_nm, p.adr_cell_phone_tx as contact_number,
    (cast(initcap(trim(tad.adr_street_tx) 
                                                    ||' ' 
                                                    ||trim(tad.adr_street_nm) 
                                                    ||' ' 
                                                    ||trim(tad.adr_city_nm) 
                                                    ||' ' 
                                                    ||trim(tad.adr_state_cd) 
                                                    ||' ' 
                                                    || trim(tad.adr_zip5_no::character VARYING)) AS character VARYING)) AS address
   from tb_provider p
      left join tb_provider_addresses tad on tad.parent_key_id = p.provider_id :: character varying and tad.delete_sw='N'
      left join tb_provider_picklist tpp on tpp.provider_id = p.provider_id
    where p.affiliate_provider_id=v_affiliate_provider_id
 and p.delete_sw='N' and (p.provider_category_cd = 1782 or (tpp.picklist_type_id=155 and tpp.picklist_value_cd = 1782 )) 
  order by (
    CASE v_sort_by
     WHEN 'asc'
     THEN                    
              p.provider_first_nm
              END) ASC NULLS LAST,
                (CASE v_sort_by
     WHEN 'desc'
     THEN                    
              p.provider_first_nm
              END) DESC NULLS LAST;

END;

$function$

