CREATE OR REPLACE FUNCTION update_fmis_vendor_payment_nxtyr_update(p_year integer, securityuserid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE
    
    v_fmis_pmnt_vendor_dt_id int;
 v_new_id int;
    v_securityuserid varchar;
 v_result json;
 v_year int;
 v_month int;
 v_vendor_file_1_dt timestamp; 
v_pay_file_1_dt timestamp; 
v_vendor_file_2_dt timestamp; 
v_pay_file_2_dt timestamp; 
v_comments varchar;
v_prev_rcd int;
v_mth_cnt int := 1;
v_Date date;

 
BEGIN
    
    
    --v_securityuserid := securityuserid;
 select fullname into v_securityuserid from userprofile up where up.securityusersid = securityuserid :: varchar;
 v_year  := p_year;
 --v_mth_cnt := 12;
 
 select count(*) into v_prev_rcd from tb_fmis_pmnt_vendor_dt where year_no = v_year and teamtypekey = 'CW';
 
 if(v_prev_rcd >=12) then
   
   raise notice 'Data available for the year %s',v_year;
   
 else
   loop
     exit when v_mth_cnt > 12 ;
  
  v_date := make_date(v_year,v_mth_cnt,1);
  v_vendor_file_1_dt := (date_trunc('month', v_date)) :: date ;
   v_pay_file_1_dt := (date_trunc('month', v_date)) :: date +3 ;--4th day
  v_vendor_file_2_dt := (date_trunc('month', v_date)) :: date +12 ;--13th day
  v_pay_file_2_dt := (date_trunc('month', v_date)) :: date +15 ; --16th day
    INSERT INTO tb_fmis_pmnt_vendor_dt
( year_no, month_no, vendor_file_1_dt, pay_file_1_dt, vendor_file_2_dt, pay_file_2_dt, comments_tx, delete_sw, create_user_id, create_ts, update_user_id, update_ts, teamtypekey)
VALUES( v_year, v_mth_cnt, v_vendor_file_1_dt,v_pay_file_1_dt,v_vendor_file_2_dt, v_pay_file_2_dt,  v_comments, 'N', coalesce(v_securityuserid :: varchar,'finance'),  now(), coalesce(v_securityuserid :: varchar,'finance'),now(), 'CW');
  
   v_mth_cnt := v_mth_cnt + 1;
   
   end loop;    
 
 end if;
  
  
 
    
    

    
    
    select json_agg(e) into v_result from (select 

   fmis_pmnt_vendor_dt_id, year_no, month_no, 
vendor_file_1_dt, 
pay_file_1_dt, 
vendor_file_2_dt, 
pay_file_2_dt, 
comments_tx, delete_sw, create_user_id, create_ts, update_user_id, update_ts
    from tb_fmis_pmnt_vendor_dt where delete_sw = 'N' and year_no = v_year and teamtypekey = 'CW'
 order by year_no ,month_no ) e;

 
RETURN v_result;

END;



$function$

