CREATE OR REPLACE FUNCTION addprovidercontractlicenseservices(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE
returnStatus text;
providerId numeric;
programId numeric;
serviceCategory numeric;
serviceCost numeric;
serviceDescription text;
serviceId numeric;
servicePaidBy text;
stdate date;
v_enddate date;
serviceClassification text;
providerServiceId character VARYING;
serviceUnit text;
v_service_status CHARACTER VARYING;
v_provider_service_id numeric;
createdBy CHARACTER VARYING;
createdTs timestamp;


BEGIN

providerId=insertedtlsobj->>'provider_id';
programId =insertedtlsobj->>'program_id';
serviceCategory =insertedtlsobj->>'service_category';
serviceCost =insertedtlsobj->>'service_cost';
serviceDescription =insertedtlsobj->>'service_description';
serviceId= insertedtlsobj->>'service_id';
stdate=insertedtlsobj->>'start_dt';
v_enddate= insertedtlsobj->>'end_dt';
servicePaidBy= insertedtlsobj->>'service_paid_by';
serviceUnit= insertedtlsobj->>'service_unit';
serviceClassification= insertedtlsobj->>'service_classification';
providerServiceId= insertedtlsobj->>'provider_service_id';
v_service_status = 'Active';
createdBy = insertedtlsobj->>'create_user_id';
createdTs = insertedtlsobj->>'create_ts';

select count(1) into v_provider_service_id from tb_provider_services where provider_service_id=providerServiceId::integer;

if providerServiceId > 0
then
    update tb_provider_services set 
    service_id = serviceId,
    service_category = serviceCategory,
    service_cost = serviceCost,
    service_description = serviceDescription,
    service_paid_by = servicePaidBy,
    service_unit = serviceUnit,
    service_classification = serviceClassification,
    start_dt = stdate,
    end_dt = v_enddate,
    update_ts=now(), 
    update_user_id=createdBy
    where provider_service_id=providerServiceId::integer;

else

insert into tb_provider_services (provider_id, program_id,service_category,service_cost, service_description, 
service_id,service_paid_by,service_unit, service_classification,start_dt, end_dt, service_status,
create_ts,create_user_id,update_ts,update_user_id)
values
(providerId,programId,serviceCategory,serviceCost,serviceDescription,serviceId,servicePaidBy,serviceUnit, serviceClassification,stdate ,v_enddate, 'Active',
now(), createdBy, now(), createdBy);

end if;

returnStatus:= 'Success';

RETURN returnStatus;
                                                      
END;

$function$

