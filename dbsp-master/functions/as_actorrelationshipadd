CREATE OR REPLACE FUNCTION as_actorrelationshipadd(v_intakenumber character varying, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE v_count bigint;

v_rec RECORD;
v_person RECORD;
v_relationship RECORD;

BEGIN  
 
   
 FOR  v_rec  IN 
 
  SELECT intakeserviceid FROM intakeservicerequest WHERE activeflag =1 
  AND intakenumber =v_intakenumber
 LOOP
  
   INSERT INTO actor(
        intakeserviceid,
        personid,
        actortype,
        dangerlevel,
        dangerreason,
        insertedby,
        insertedon,                
        updatedby,                
        updatedon, 
        activeflag)
         
   SELECT   v_rec.intakeserviceid, 
      personid,
      actortype,
      dangerlevel,
      dangerreason,
      v_securityusersid,
      now(),
      v_securityusersid,
      now(),
      1 
   FROM actor 
   WHERE activeflag =1
   AND intakenumber = v_intakenumber;
  
 for v_person in
 
  SELECT * FROM actor WHERE activeflag =1 
  AND intakeserviceid =v_rec.intakeserviceid
 
  LOOP 
            INSERT INTO intakeservicerequestactor (
            actorid ,
            intakeservicerequestpersontypekey,
            intakeserviceid,        
                                                ramentalhealth ,
            ramentalretarted,      
                                                reported,
            isprimary,
            personid,
                                                fetalalcoholspctrmdisordflag, 
                                                drugexposednewbornflag, 
                                                probationsearchconductedflag,  
                                                sexoffenderregisteredflag,
            insertedby,
            insertedon,                
                                                updatedby,                
            updatedon, 
            activeflag            
            )
            
   SELECT v_person.actorid, 
          pa.intakeservicerequestpersontypekey,
       v_rec.intakeserviceid,
       pa.ramentalhealth ,
       pa.ramentalretarted,      
       pa.reported,
       pa.isprimary,
       v_person.personid,
       pa.fetalalcoholspctrmdisordflag, 
       pa.drugexposednewbornflag, 
       pa.probationsearchconductedflag,  
       pa.sexoffenderregisteredflag,
       v_securityusersid,
       now(),
       v_securityusersid,
       now(),
       1
      FROM   intakeservicerequestactor pa 
      WHERE pa.intakenumber =v_intakenumber AND pa.activeflag =1
      and pa.personid =v_person.personid ;
 end loop;    
     
   for v_relationship in 
   
   
   SELECT * FROM intakeservicerequestactor WHERE activeflag =1 
   AND intakeserviceid =v_rec.intakeserviceid
   
   LOOP
   INSERT    INTO    actorrelationship(              
            relationshiptypekey,
            intakeservicerequestactorid,
            effectivedate,
            insertedby, 
            insertedon,  
            updatedby, 
            updatedon,
                                                activeflag,
                                                intakeserviceid
                                                )
   SELECT    acr.relationshiptypekey,
      v_relationship.intakeservicerequestactorid,
      now(),
       v_securityusersid,
      now(),
      v_securityusersid,
      now(),
      1,
       v_rec.intakeserviceid
   FROM  actorrelationship  acr
   inner  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = acr.intakeservicerequestactorid
   WHERE acr.intakenumber =v_intakenumber
   AND acr.activeflag =1 
   and isra.personid =v_relationship.personid ;
    
   end loop;
  
 END LOOP;
  
  UPDATE actorrelationship SET activeflag =0, updatedby = v_securityusersid, updatedon = now()
  WHERE intakenumber =v_intakenumber AND  activeflag =1;  
    
  UPDATE intakeservicerequestactor SET activeflag =0, updatedby = v_securityusersid, updatedon = now()
  WHERE intakenumber =v_intakenumber AND activeflag =1; 
    
  UPDATE actor SET activeflag =0, updatedby = v_securityusersid, updatedon = now()
  WHERE intakenumber =v_intakenumber AND activeflag =1;
  
 
RETURN 'Successfull';
end;

$function$

