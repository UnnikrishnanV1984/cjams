CREATE OR REPLACE FUNCTION as_getreassigncaseworkerlist(v_securityusersid character varying, v_intakerviceid uuid)
 RETURNS TABLE(address text, countyid uuid)
 LANGUAGE plpgsql
AS $function$


DECLARE 
        
  v_countyid uuid;
 v_tosecurityusersid character varying ;
 v_toroleid character varying;
 v_teamid uuid;
 v_teamtypekey character varying;
 
 
BEGIN 
 SELECT  tm.teamid ,t.teamtypekey  into v_teamid,v_teamtypekey
        FROM    as_teammemberassignment tma 
        INNER JOIN  teammember tm 
            ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
        inner join team t on t.teamid = tm.teamid  and t.activeflag =1
        WHERE  tma.SecurityUsersId = v_securityusersid
        AND   tma.activeflag =1;
select R.tosecurityusersid,R.toroleid into v_tosecurityusersid,v_toroleid
 from routing R where R.objectid=v_intakerviceid::character varying and R.activeflag=1 and R.routingstatustypeid=4;
Return QUERY 

SELECT distinct  
  upa.address||','||upa.city||','||upa.state||','||upa.zipcode||','||cou.countyname as address,upa.countyid
        FROM as_teammemberassignment tma
        INNER join teammember tm
          ON tm.teammemberid = tma.teammemberid  AND tm.activeflag= 1
        inner join team t on t.teamid=tm.teamid and t.activeflag=1
        INNER join teammemberroletype  tmrt 
          ON tmrt.roletypekey = tm.roletypekey  AND tmrt.activeflag= 1
         
        left join teamtype tty on tty.teamtypekey = tmrt.teamtypekey 
          AND tty.activeflag= 1
          left join userprofile up on up.securityusersid=tma.securityusersid
          
        left JOIN UserProfileAddress upa 
          ON upa.securityusersid = tma.securityusersid  AND upa.activeflag= 1 
        left Join county cou on cou.countyid=upa.countyid and cou.activeflag=1
        WHERE   tm.roletypekey =v_toroleid and t.teamid=v_teamid
        and up.securityusersid not in(v_tosecurityusersid)
        AND tma.activeflag =1;
        

END;

$function$

