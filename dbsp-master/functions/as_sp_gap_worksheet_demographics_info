CREATE OR REPLACE FUNCTION as_sp_gap_worksheet_demographics_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, childname character varying, dateofbirth timestamp without time zone, gender character varying, childguardianid integer, childguardianname character varying, childguardiandob date, childsecguardianid integer, childsecguardianname character varying, countyofjurisdiction character varying, guardianshippetitiondate timestamp without time zone, guardianshipagreementsigneddate timestamp without time zone, secondaryguardianshipagreementsigneddate timestamp without time zone, dateofcourtorderguardianshipfinalization timestamp without time zone)
 LANGUAGE plpgsql
AS $function$ 

DECLARE 
  vs_Procedure_nm           VARCHAR(100) DEFAULT 'sp_gap_worksheet_demographics_info';
  vs_chld_nm            VARCHAR(250);
  vd_birth_dt            TIMESTAMP;
  vs_gender            VARCHAR(20);
  vn_grd_id            INTEGER;
  vs_grd_one_nm           VARCHAR(200);
  vn_grd_two_id           INTEGER;
  vs_grd_two_nm           VARCHAR(200);
  vs_ldss_jrsdctn           VARCHAR(50);
  vd_grd_pitn_dt           TIMESTAMP;
  vd_grd_agmt_dt           TIMESTAMP;
  vd_sec_grd_agmt_dt          TIMESTAMP;
  vd_grd_fnl_crt_ord_dt         TIMESTAMP;  
  vn_grd_dob            DATE;
  
 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_demographics_info ( 
  client_id             BIGINT,
  childname            VARCHAR(250),
  dateofbirth            TIMESTAMP,
  gender             VARCHAR(20),
  childguardianid           INTEGER,
  childguardianname          VARCHAR(250),
  childguardiandob          DATE,
  childsecguardianid          INTEGER,
  childsecguardianname         VARCHAR(250),
  countyofjurisdiction         VARCHAR(50),
  guardianshippetitiondate        TIMESTAMP,
  guardianshipagreementsigneddate       TIMESTAMP,
  secondaryguardianshipagreementsigneddate    TIMESTAMP,
  dateofcourtorderguardianshipfinalization    TIMESTAMP  
 ); 


-- Child Name  
SELECT concat(per.firstname, ' ', per.middlename, ' ', per.lastname)  
 INTO vs_chld_nm
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
  
-- Date of Birth   
SELECT per.dob  
 INTO vd_birth_dt
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Gender  
SELECT per.gendertypekey  
 INTO vs_gender
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;

-- Guardian ID  
SELECT grd.guardianoneproviderid
 INTO vn_grd_id
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Guardian Name  
SELECT grd.guardianoneid
 INTO vs_grd_one_nm
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Guardian DOB
SELECT tpv.dob_dt
 INTO vn_grd_dob
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per, tb_provider tpv     
WHERE grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND tpv.provider_id = grd.guardianoneproviderid
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Guardian Two ID  
SELECT grd.guardiantwoproviderid
 INTO vn_grd_two_id
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Guardian Two Name  
SELECT grd.guardiantwoid
 INTO vs_grd_two_nm
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Child Jurisdiction  
SELECT tigrd.ldsscounty
  INTO vs_ldss_jrsdctn
   FROM tb_iveguardianship tigrd, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per
WHERE tigrd.gapid = grd.gapid AND grd.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY tigrd.updatedon DESC LIMIT 1;

-- Guardianship Petition Filed Date
SELECT ( CASE WHEN (isrp.petitiontypekey IN ('GAPTPR', 'CINA', 'CINS')) 
    THEN isrp.petitiondate ELSE NULL END )
 INTO vd_grd_pitn_dt
   FROM intakeservicerequestpetition isrp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE isrp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY isrp.updatedon DESC LIMIT 1;

-- Guardian Agreement  
SELECT ( CASE WHEN (pp.primarypermanencytype IN ('Guardianship')) 
    THEN gagmt.guardianonedate ELSE NULL END )
 INTO vd_grd_agmt_dt
   FROM gapagreement gagmt, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per  
WHERE gagmt.gapid = grd.gapid AND grd.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1 AND pp.permanencyplanid = grd.permanencyplanid
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY gagmt.updatedon DESC LIMIT 1;

-- Secondary Guardianship Agreement Signed Date  
SELECT ( CASE WHEN (pp.primarypermanencytype IN ('Guardianship')) 
    THEN ( CASE WHEN grd.guardiantwoid IS NOT NULL 
    THEN gagmt.guardianonedate ELSE NULL END) ELSE NULL END )
 INTO vd_sec_grd_agmt_dt
   FROM gapagreement gagmt, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per  
WHERE gagmt.gapid = grd.gapid AND grd.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1 AND pp.permanencyplanid = grd.permanencyplanid
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY gagmt.updatedon DESC LIMIT 1;

-- Guardian Finalization Date  
SELECT ( CASE WHEN (isrco.childpermanencyplankey IN ('GBN')) 
    THEN isrco.courtorderdate ELSE NULL END )
 INTO vd_grd_fnl_crt_ord_dt
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per , intakeservreqcourtorder isrco    
WHERE grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 and isrco.servicecaseid = sc.servicecaseid
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY isrco.insertedon DESC LIMIT 1;


INSERT INTO Temp_worksheet_demographics_info
SELECT 
  al_client_id,
  vs_chld_nm,
  vd_birth_dt,
  vs_gender,
  vn_grd_id,
  vs_grd_one_nm,
  vn_grd_dob,
  vn_grd_two_id,
  vs_grd_two_nm,
  vs_ldss_jrsdctn,
  vd_grd_pitn_dt,
  vd_grd_agmt_dt,
  vd_sec_grd_agmt_dt,
  vd_grd_fnl_crt_ord_dt;
  
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_demographics_info;
              
DROP TABLE Temp_worksheet_demographics_info;

   END
    $function$

