CREATE OR REPLACE FUNCTION as_routingdasao(jsondata json, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


DECLARE  

v_date timestamp without time zone;
j_interstate json;
j_residingwithdetails json;
j_warranttypedetails json;
i json;
j json;
v_intakeserreqinterstateid uuid;
v_intakeserreqinterstateresidingconfigid uuid;
v_intakeserreqinterstatewarranttypeconfigid uuid;
v_intakeserviceid uuid;
v_intakeservicerequestactorid uuid; 
l_focuspersonid uuid;
I_isdetaintheyouth boolean;
I_getfocuspersoncasestatusconfig character varying;
v_routingdadjs  character varying;
v_appeventcode character varying;
v_intake_service_req_id uuid;
v_fromuserid character varying;
v_assignedsecurity json;
v_responsibilitytypekey character varying;
j_assignfolder json;
 
BEGIN
v_date:= now() ;

v_appeventcode := jsondata -> 'informaladjustment' ->> 'appeventcode'; 
v_intake_service_req_id := jsondata -> 'informaladjustment' ->> 'serreqid';
v_assignedsecurity := jsondata -> 'informaladjustment' ->> 'assigneduserid'; 
j_assignfolder := jsondata -> 'informaladjustment' ->> 'assignfolder'; 

RAISE NOTICE' v_appeventcode : %',v_appeventcode; 
RAISE NOTICE' v_intake_service_req_id : %',v_intake_service_req_id; 
RAISE NOTICE' v_assignedsecurity : %',v_assignedsecurity; 
RAISE NOTICE' j_assignfolder : %',j_assignfolder; 

   
 Select routingdadjs INTO v_routingdadjs from routingdadjs(v_appeventcode , v_intake_service_req_id , v_securityuserid , v_assignedsecurity, null , j_assignfolder , true);
 
 
 Return 'Success';
 
END;


$function$

