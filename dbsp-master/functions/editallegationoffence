CREATE OR REPLACE FUNCTION editallegationoffence(u_intakeservicerequestevaluationid uuid, u_allegationid uuid, v_securityuserid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
 i_evaluationconfigcount bigint;
 v_intakeservicerequestevaluationconfigid uuid;
BEGIN

  select count(1) into i_evaluationconfigcount from intakeservicerequestevaluationconfig INSE where INSE.allegationid = u_allegationid and INSE.intakeservicerequestevaluationid = u_intakeservicerequestevaluationid;
          IF (i_evaluationconfigcount = 0) THEN

               v_intakeservicerequestevaluationconfigid :=   gen_random_uuid();
Insert Into intakeservicerequestevaluationconfig (intakeservicerequestevaluationconfigid, intakeservicerequestevaluationid, allegationid, activeflag, insertedby,updatedby,offenceaddedtype)
        values (v_intakeservicerequestevaluationconfigid, u_intakeservicerequestevaluationid, u_allegationid, 1, v_securityuserid, v_securityuserid,'Court');
         
          ELSE

               Update intakeservicerequestevaluationconfig set activeflag = 1 where allegationid = u_allegationid and intakeservicerequestevaluationid = u_intakeservicerequestevaluationid;
          
          END IF;

RETURN  'success';
 
