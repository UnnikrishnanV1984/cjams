CREATE OR REPLACE FUNCTION as_routingda(appeventcode character varying, intake_service_req_id uuid, fromuserid character varying, waiting boolean, v_assignedsecurityid character varying, v_responsibilitytypekey character varying, v_countyid character varying, j_assignfolder json DEFAULT '{}'::json, isnotifyuser boolean DEFAULT true, fromrolekey character varying DEFAULT NULL::character varying, torolekey character varying DEFAULT NULL::character varying)
 RETURNS routeda_temp_type
 LANGUAGE plpgsql
AS $function$

DECLARE 
result routeda_temp_type;
 
 
v_teamid uuid;
v_investigationid uuid;
v_intakesecurityid character varying;
v_usernotificationid uuid;
v_createduser character varying;
v_servicetype character varying;
 
v_fromroletypekey  character varying;
v_toroletypekey  character varying;
v_team_member_id  uuid;

v_fromrolesupervisor bool;
v_torolesupervisor bool;
v_status  int;
v_routingid uuid;
v_isavailable int ;
v_intakenumber character varying;
v_date timestamp without time zone;
v_notifystatus character varying;
v_metadata json;
v_jsondata json;
v_auditlog  character varying;
v_auditlogassign character varying;
v_datypeid  uuid;
v_dasubtypeid  uuid;
v_roletypecode character varying;
s_Actmsg  character varying;
v_teamtypekey character varying;
prgmType character varying;
v_prgmType character varying;

v_foldertypekey character varying;
v_folderreasontypekey character varying;
v_folderopendatetime timestamp without time zone;
v_foldernotes text;
--teamtypekey character varying;
v_servicerequestnumber character varying;
v_focuspersonname character varying;
v_focuspersonid uuid;
v_alertnotes character varying;
v_savepersonalert character varying;
v_servicerequestno character varying;
v_routingdata character varying;
v_message character varying;
v_fromuserrole character varying;
v_icjprobationcount bigint;
v_actiontype character varying;
v_fromteamid uuid;
v_activity_investigationid  uuid;
v_tocountyid character varying;
v_fromcountyid character varying;
v_servicecasetype character varying;
BEGIN

v_date:= now() ;

v_foldertypekey := j_assignfolder->>'foldertypekey';
v_folderreasontypekey := j_assignfolder->>'folderreasontypekey';
v_folderopendatetime := j_assignfolder->>'folderopendatetime';
v_foldernotes := j_assignfolder->>'foldernotes';

v_status:= 4; /*Default routed status assigned*/
RAISE NOTICE 'status:%', v_status;
v_servicerequestno:='';
/*Intake service request raised user and da type*/
SELECT  a.insertedby,b.intakeservreqtypekey, a.intakeservreqtypeid ,a.intakeservicerequestclassid,
teamtypekey,servicerequestnumber
INTO v_intakesecurityid,v_servicetype,v_datypeid,v_dasubtypeid,v_teamtypekey,v_servicerequestno 
FROM intakeservicerequest AS a JOIN intakeservicerequesttype AS b ON a.intakeservreqtypeid = b.intakeservreqtypeid 
where intakeserviceid =intake_service_req_id;

SELECT investigationid INTO v_investigationid FROM investigation WHERE intakeserviceid=intake_service_req_id;

IF v_servicetype = 'RF' THEN
/*Routing the case to Catherine if the service type is RF*/
v_assignedsecurityid := 'S-1-5-21-152097760-152508613-1969071786-1011';
 
END IF;

/*Get caseworker name for Notification*/
SELECT cast( lastname ||',' || firstname as character varying) INTO result.caseworker_name 
 FROM userprofile WHERE SecurityUsersId=v_assignedsecurityid and activeflag =1;

/*Intake service request raised user */
SELECT cast( lastname ||',' || firstname as character varying)  INTO v_createduser 
FROM userprofile 
WHERE SecurityUsersId=fromuserid and activeflag =1;

/*Assigned user team details*/
SELECT  tm.teamid ,tm.loadnumber ,r.roletypekey , t.teamname, tm.teammemberid ,coalesce(tmrt.isupervisor,false), t.countyid 
        into  v_teamid ,result.loadnumber, v_toroletypekey, result.teamname,v_team_member_id,v_torolesupervisor, v_tocountyid
  FROM muser m
  INNER  JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
  INNER  JOIN role r on rm.roleid = r.id and r.activeflag=1
  INNER  JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1  
        INNER JOIN  teammember tm  ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
        inner join team t on t.teamid = tm.teamid  and t.activeflag =1
        inner join teammemberroletype tmrt on tmrt.roletypekey = r.roletypekey 
     WHERE  m.SecurityUsersId = v_assignedsecurityid
        and r.roletypekey = torolekey
        AND CASE WHEN v_countyid IS NOT NULL THEN (t.countyid = v_countyid) ELSE true END
        AND   tmrt.activeflag=1;

IF v_team_member_id IS NULL THEN 
    SELECT  tm.teamid ,tm.loadnumber ,r.roletypekey , t.teamname, tm.teammemberid ,coalesce(tmrt.isupervisor,false), t.countyid 
            into  v_teamid ,result.loadnumber, v_toroletypekey, result.teamname,v_team_member_id,v_torolesupervisor, v_tocountyid
    FROM muser m
    INNER  JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
    INNER  JOIN role r on rm.roleid = r.id and r.activeflag=1
    INNER  JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1  
    INNER JOIN  teammember tm  ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
    inner join team t on t.teamid = tm.teamid  and t.activeflag =1
    inner join teammemberroletype tmrt on tmrt.roletypekey = r.roletypekey  
    WHERE  m.SecurityUsersId = v_assignedsecurityid
        AND   tmrt.activeflag=1 ORDER BY rm.insertedon DESC nulls LAST LIMIT 1;
END IF;
 
 /*Assigned user roletypecode*/
 Select rt.roletypecode  into v_roletypecode
  from role R inner join roletype rt on  rt.shortname = r.name 
  and rt.activeflag =1
 where r.roletypekey = v_toroletypekey 
  and r.activeflag =1 limit 1;
 
/*Logged in user role details*/ 
SELECT  r.roletypekey ,tm.teamid, t.countyid 
        into  v_fromroletypekey ,v_fromteamid, v_fromcountyid 
        FROM muser m
  INNER  JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
  INNER  JOIN role r on rm.roleid = r.id and r.activeflag=1
  INNER  JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1 
        INNER JOIN  teammember tm ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
        inner join team t on t.teamid = tm.teamid  and t.activeflag =1
        WHERE  tma.SecurityUsersId = fromuserid
        and r.roletypekey = fromrolekey 
        AND   m.activeflag =1;
        

 IF (coalesce(v_torolesupervisor,false) =true) THEN
  RAISE NOTICE 'inside true:%', v_torolesupervisor; 
     SELECT routingid ,1 into v_routingid,v_isavailable 
        FROM routing r WHERE tosecurityusersid = fromuserid 
        AND activeflag =1
        AND r.objectid  = intake_service_req_id :: character varying
        ORDER BY insertedon desc limit 1;
          
        if (coalesce(v_isavailable,0) =0 ) THEN /*if routing is not availble for sevice id */
          select intakenumber into v_intakenumber from intakeservicerequest   
              where  intakeserviceid=intake_service_req_id;
            
                SELECT routingid ,1 into v_routingid,v_isavailable
                FROM routing r WHERE tosecurityusersid = fromuserid 
                AND activeflag =1
                AND r.objectid  = v_intakenumber
                ORDER BY insertedon desc limit 1;
        
        END IF;
        select  coalesce(tmrt.isupervisor,false)  into v_fromrolesupervisor from routing r
        inner join teammemberroletype tmrt on tmrt.roletypekey =r.fromroleid 
        where r.routingid = v_routingid;
  /*Mark previous data as inactive and mark as accepted*/
        if (coalesce(v_fromrolesupervisor,false) =true AND coalesce(v_torolesupervisor,false) = true ) THEN
           IF   (fromuserid <> v_assignedsecurityid) THEN
    RAISE NOTICE 'NOT IN Block:%', v_assignedsecurityid;
    UPDATE routing SET routingstatustypeid =9,activeflag =0  , remarks ='Deactivating and Routed from Supervisor ',
          updatedon= v_date
    WHERE routingid = v_routingid;
    v_status:= 9;
   ELSIF  (fromuserid = v_assignedsecurityid) THEN
    RAISE NOTICE 'EQUAL BLOCK%', v_assignedsecurityid;
     UPDATE routing SET routingstatustypeid =2,activeflag =0 ,   remarks ='Deactivating and Routed to Case Worker  ',
          updatedon= v_date
    WHERE routingid = v_routingid;
    v_status:= 4;
  END IF;
   
  ELSE
            UPDATE routing SET routingstatustypeid =2,activeflag =0 ,  remarks ='Deactivating and Routed to Supervisor    ',
                                 updatedon= v_date
            WHERE routingid = v_routingid;
    v_status:= 9; /*Routed to Supervisor status  */
        END IF;     
        --v_status:= 9; /*Routed to Supervisor status  */ /*Changed from 9 to 4 */
 END IF;
 

/*Routing to  user*/
  INSERT INTO routing(
                    eventcode, fromsecurityusersid, tosecurityusersid, teamid, 
                    fromroleid, toroleid,objectid , routingstatustypeid,
                    insertedby,  updatedby , servicerequestnumber,remarks)

 values(appeventcode,fromuserid,v_assignedsecurityid,v_teamid,
       v_fromroletypekey,v_toroletypekey,intake_service_req_id,v_status,
       fromuserid,fromuserid,v_servicerequestno, 'Routing to  user');

 UPDATE caseassignment SET enddate = now()::date, updatedby = fromuserid, updatedon = now() WHERE toworkeridno=fromuserid AND objectid= intake_service_req_id AND objecttypekey = 'servicerequest' AND enddate IS NULL ;
    
    IF v_responsibilitytypekey IS NULL THEN 
        SELECT (CASE WHEN r.roletypekey IN ('ASSP','ASFD','ASFS') THEN 'administrative' ELSE 'primary' END) INTO v_responsibilitytypekey 
        FROM muser m
        INNER  JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
        INNER  JOIN role r on rm.roleid = r.id and r.activeflag=1
        WHERE  m.SecurityUsersId = v_assignedsecurityid AND m.activeflag=1 ORDER BY rm.insertedon DESC nulls LAST LIMIT 1;
    END IF;

    select st.description into v_servicecasetype from asservicesoncase sc
    join intakeserv st on st.intakeservid = sc.caseservicetypeid 
    where sc.ascaseid =intake_service_req_id and sc.approvalstatus ='approved' order by sc.insertedon asc limit 1;
    
    if (v_servicecasetype is null) then 
        select  CONCAT(intakeservreqtypekey, ' ', classkey) into v_servicecasetype as cc from intakeservicerequest isr
        join intakeservicerequesttype ist on ist.intakeservreqtypeid = isr.intakeservreqtypeid 
        join servicerequestsubtype st on st.servicerequestsubtypeid = isr.intakeservicerequestclassid 
        where intakeserviceid =intake_service_req_id;
    END if;

    INSERT INTO caseassignment
 (fromworkeridno, toworkeridno, fromldssid,toldssid,effectivetime,effectivedate, insertedby, updatedby, insertedon, updatedon, objecttypekey, objectid,responsibilitytypekey,fromteamid,toteamid,startdate,assignmenttype,assigndate, servicetype)
 VALUES(fromuserid,v_assignedsecurityid,v_fromcountyid::uuid, v_tocountyid::uuid, now(),now(), fromuserid,fromuserid,now(),now(),'servicerequest',intake_service_req_id,v_responsibilitytypekey,v_fromteamid,v_teamid,now() ,'W',now()::date, v_servicecasetype);
 
    IF (waiting = TRUE) THEN
        UPDATE intakeservicerequest 
        SET intakeserreqstatustypeid = '52ad4cc7-e8f8-4cbb-9e27-d86f2b817690', isrouted = true, updatedby = fromuserid, updatedon = now()
        WHERE intakeserviceid = intake_service_req_id;
        
        UPDATE intakeservicerequestdispositioncode 
        SET servicerequesttypeconfigiddispostionid = 'fdea9cd7-296a-447a-9d03-623c0b2d7d7d', updatedby = fromuserid, updatedon = now()
        WHERE intakeserviceid = intake_service_req_id;

        SELECT ids.jsondata INTO v_jsondata
        FROM    intakeservicerequest isr 
                INNER JOIN intakedastaging ids ON ids.intakenumber = isr.intakenumber AND ids.activeflag = 1
                WHERE isr.intakeserviceid = intake_service_req_id LIMIT 1;

        IF (((v_jsondata->>'createdCases') IS NOT NULL) AND ((v_jsondata->>'createdCases')::json #>>'{0}' IS NOT NULL)
            AND ((v_jsondata->>'createdCases')::json #>>'{0}')::json->>'programTypeKey' IS NOT NULL) THEN 
            v_prgmType := ((v_jsondata->>'createdCases')::json #>>'{0}')::json->>'programTypeKey';
            RAISE NOTICE 'inside false:%', v_prgmType; 

            IF v_prgmType NOT ilike '[%' THEN v_prgmType := '["'||v_prgmType||'"]'; END IF;
            RAISE NOTICE 'inside true:%', v_prgmType; 
            For prgmType IN SELECT * FROM json_array_elements((v_prgmType)::json)
            LOOP 
                prgmType:= replace(prgmType,'"','');                
                INSERT INTO asservicesoncase (ascaseid,approvalstatus,caseserviceid,caseservicetypeid,caseservicesubtypekey,startdate,insertedon,insertedby,personprogramid, personid) 
                SELECT isr.intakeserviceid, 'approved', isr.intakeservreqtypeid , 
                        (CASE isr.intakeservicerequestclassid
                        -------   servicerequestsubtype       intakeserv
                            WHEN 'b32016e0-97a4-430a-a9e0-43aea651a44d' THEN '87ef359f-96b7-4303-82ed-2001e424220e'     -- PH
                            WHEN '1f26128c-3758-4bdf-aa00-6769f0d7cb09' THEN '6d99d88a-3ce1-4ed8-a11e-a49978d120da'  -- Adult Guardianship
                            WHEN '38253f34-ab82-4941-95db-1dd90e943d01' THEN '11bc5e1f-01ae-4526-b041-32a2672422f6'  -- SSTA
                            WHEN '4ff00291-ac73-4bc2-9b9e-327bf27dbc7f' THEN '25e9fbf7-15c9-4b5e-abce-98b5244b4433'  -- AFC
                            WHEN '624c6ecd-c6ea-47c0-8d5d-bfdf87ef4e3f' THEN 'c564a9d0-1227-40ef-8539-ded1970e35ee'  -- IHAS
                            WHEN '29640685-40d0-46aa-a066-84bd893b9603' THEN '55bf9f5b-571d-40aa-a93d-a9921c1816af'  -- Respite Care
                            WHEN 'ea37d861-e0c7-4977-bda3-2081087e44e7' THEN 'ce96240b-6eac-4573-866d-3c17c35f4bee'  -- 24 Hours
                            WHEN 'e43e0291-4e5a-4d2f-899b-128521c8b37f' THEN 'b91ce433-57a1-4005-a139-4dceae30573e'  -- 5 Days
                            ELSE 'eca26d10-5e81-4311-a233-04e08e0e7a93'             -- Registered Nurse assigment
                            --ELSE 'e43e0291-4e5a-4d2f-899b-128521c8b37f'
                            END)::uuid,prgmType,now(),now(), fromuserid, null, 
                            (SELECT   PN.personid FROM  intakeservicerequestactor   ISRA
                                INNER  JOIN  person  as  PN  ON  PN.personid=ISRA.personid  AND  PN.activeflag  =  1  
                                WHERE  intakeservicerequestpersontypekey  IN  ('RA','AV')  
                                AND  ISRA.activeflag  = 1 AND ISRA.intakeserviceid = isr.intakeserviceid LIMIT 1)
                FROM    intakeservicerequest isr 
                INNER JOIN intakedastaging ids ON ids.intakenumber = isr.intakenumber AND ids.activeflag = 1
                WHERE isr.intakeserviceid = intake_service_req_id;
            END LOOP;
        END IF;
    END IF;
  /*IF (coalesce(v_torolesupervisor,false) =false) THEN
   RAISE NOTICE 'inside false:%', v_torolesupervisor;  */
 /* Added to create checklist for SP and avoid duplicates */
 select objectid into v_activity_investigationid from activity where objectid = v_investigationid;
 if (v_activity_investigationid is null) then 
 /* DSDS ACTION TASK GOAL DETAILS(Create action tasks) */
    select as_createinvestigation INTO s_Actmsg from as_createinvestigation(
   v_datypeid,
   v_dasubtypeid ,
   v_investigationid,
    v_assignedsecurityid ,
       'CW',
      v_teamtypekey); 
     
    INSERT INTO areateammemberservicerequest(
                activeflag, teammemberid, intakeserviceid, 
                routingstatustypekey,securityusersid, routedby, insertedby, insertedon)
        VALUES (1, v_team_member_id, intake_service_req_id, 
                'New',v_assignedsecurityid, NULL, fromuserid, v_date);
 INSERT INTO intakeservicerequestuseraccess(
                activeflag, securityusersid, 
                intakeserviceid, insertedby)
        VALUES (1, v_assignedsecurityid, intake_service_req_id,fromuserid);
  /*  UPDATE activitytask set assignedto = result.loadnumber where activityid in (
        SELECT activityid  from activity where objectid = v_investigationid); */

    /*Routing details updated into service request */
    if  (v_roletypecode =  'CW'  ) then
        UPDATE intakeservicerequest set isrouted=true,routedon = v_date,
            routedusersid= v_assignedsecurityid,responsibilitytypekey = v_responsibilitytypekey  where  intakeserviceid=intake_service_req_id;
 end if;
 
  
  
End if; 
/* END IF; */ 

IF (coalesce(v_torolesupervisor,false) =true  AND fromuserid = v_assignedsecurityid) THEN
  UPDATE intakeservicerequest set isrouted=true,routedon = v_date,
  routedusersid= v_assignedsecurityid,responsibilitytypekey = v_responsibilitytypekey  where  intakeserviceid=intake_service_req_id;
END  IF;
    /*NOTIFICATION */ 

    if(isnotifyuser=true) THEN
      SELECT servicerequestnumber into v_intakenumber from intakeservicerequest   
                    where  intakeserviceid=intake_service_req_id;
                    
       SELECT as_send_notification into v_notifystatus from as_send_notification(fromuserid, fromuserid,v_assignedsecurityid,
            'System', 'Normal', 'Case #'||v_intakenumber|| ' Routed to '|| result.caseworker_name ,
             'Case #'||v_intakenumber|| ' Routed to '|| result.caseworker_name ,
             cast(intake_service_req_id as character varying));

         
         select count(1) into v_icjprobationcount  from intakeservicerequest ins 
join intakeservicerequesttype inst on inst.intakeservreqtypeid=ins.intakeservreqtypeid and inst.activeflag=1
join servicerequestsubtype sst on sst.servicerequestsubtypeid=ins.intakeservicerequestclassid and sst.activeflag=1
where ins.intakeserviceid=intake_service_req_id and sst.classkey in ('ICJ Receiving Re-Entry','ICJ Receiving Probation')
and inst.intakeservreqtypekey='Interstate Compact';

select r.roletypekey into v_fromuserrole from muser mu 
join  rolemapping rm on rm.principalid=mu.id::character varying  and rm.activeflag=1
join "role" r on r.id=rm.roleid and r.activeflag=1
where mu.securityusersid=fromuserid;
if(v_icjprobationcount > 0 and v_fromuserrole='')
   then
    v_message = 'New case ('|| v_intakenumber||') is assigned by '|| v_createduser ||' (Note : Home Evaluation Report form VIII needs to be completed in 30 days.)';
   else
   v_message = 'New case ('|| v_intakenumber||') is assigned by '|| v_createduser ;
  end if;
        SELECT as_send_notification into v_notifystatus from as_send_notification(v_assignedsecurityid,fromuserid,v_assignedsecurityid,
            'System', 'Normal',  v_message ,
               v_message,
             cast(intake_service_req_id as character varying));
 
--       SELECT as_send_notification into v_notifystatus from as_send_notification(v_assignedsecurityid,fromuserid,v_assignedsecurityid,
--            'System', 'Normal',   'New case ('|| v_intakenumber||') is assigned by '|| v_createduser ,
--               'New case ('|| v_intakenumber||') is assigned by '|| v_createduser,
--             cast(intake_service_req_id as character varying));

        /*AUDIT LOG */   

        

        SELECT json_agg(e) from (SELECT result.caseworker_name  caseworkername,result.loadnumber  loadnumber, v_intakenumber  intakenumber, result.teamname teamname)e INTO v_metadata;

        SELECT auditlog into v_auditlog from auditlog
        ('IR','Case #'||v_intakenumber|| ' Routed to '|| result.caseworker_name,null,v_intakenumber,null,
         v_intakesecurityid,
         v_metadata,
         null,
         true,false,false);
   
   
     SELECT auditlog into v_auditlogassign from auditlog
    ('IR', 'New case ('|| v_intakenumber||') is assigned by '|| v_createduser,null,v_intakenumber,null,
     v_intakesecurityid,
     v_metadata,     null,
     true,false,false);
    END IF;         
    --select teamtypekey into teamtypekey from userprofile where securityusersid = fromuserid;
    IF v_teamtypekey = 'DJS' THEN

             select ISR.servicerequestnumber,IDAS.raname,IDAS.focuspersonid into v_servicerequestnumber,v_focuspersonname,v_focuspersonid from intakeservicerequest as ISR
      join intakeservicerequestcourtaction as ISRCA
    on ISRCA.intakenumber = ISR.intakenumber and ISRCA.activeflag = 1
             join intakeservicerequestcourtordertypeconfig as ISRCOTC
    on ISRCOTC.intakeservicerequestcourtactionid = ISRCA.intakeservicerequestcourtactionid and ISRCOTC.activeflag=1
      join intakedastaging as IDAS
    on IDAS.intakenumber = ISR.intakenumber and IDAS.activeflag = 1
      where ISR.intakeserviceid = intake_service_req_id and ISRCOTC.courtordertypekey = 'PS' and ISR.activeflag = 1;
               
             IF ((cast(v_servicerequestnumber as character varying)!='') and (cast(v_focuspersonname as character varying)!='') and (cast(v_focuspersonid as character varying)!='')) THEN
             v_alertnotes = 'Safety Plan Initiative is set for '||v_focuspersonname ||'  in Case '||  v_servicerequestnumber;
             SELECT as_savepersonalert INTO v_savepersonalert FROM as_savepersonalert('YSPL'::character varying,'Active'::character varying,now()::timestamp without time zone,v_alertnotes,v_focuspersonid,fromuserid);
      
     END IF;
 
    END IF;

    IF (SELECT count(*) > 0 FROM caseassignment WHERE objectid = intake_service_req_id AND enddate IS NULL AND activeflag = 1) THEN 
        UPDATE intakeservicerequest 
        SET isrouted = true, updatedby = fromuserid, updatedon = now()
        WHERE intakeserviceid = intake_service_req_id AND coalesce(isrouted,false) = false;
    END IF;
        
RETURN result;
END;

$function$

