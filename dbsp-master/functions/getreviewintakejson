CREATE OR REPLACE FUNCTION getreviewintakejson(v_intakenumber character varying)
 RETURNS TABLE(intake jsonb)
 LANGUAGE plpgsql
AS $function$
begin

 return query  
 
select ids.jsondata as intake  from intakedastaging  ids where ids.intakenumber=v_intakenumber and activeflag=1 ;

   
end
$function$

