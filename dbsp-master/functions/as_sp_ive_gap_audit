childdisabilitystartdate, startdateofpostsecondaryorvocationaleducation, nameofsecondaryeducationorequivalentprogram,
nameofemployer, extgapeligibilitystatus, missinginfo, gapv, gr, sa, hhcheck, hhdetails, ivereimb, egapv, finalresult, category, cjamspid, removalid, inputjson, outputjson, pagesnapshot)

VALUES(v_transactionid, childsecondguardianattachment, sg_numberofadditionalhouseholdmembers, sg_nationalandstatecriminalhistorybackgroundcheck, sg_childabuseandmaltreatmentdatabasecheck,
