childdisabilitystartdate, startdateofpostsecondaryorvocationaleducation, nameofsecondaryeducationorequivalentprogram,
nameofemployer, extgapeligibilitystatus, missinginfo, gapv, gr, sa, hhcheck, hhdetails, ivereimb, egapv, finalresult, category, cjamspid, removalid, inputjson, outputjson, pagesnapshot);

select gapauditid into v_gapauditid from tb_ive_gapaudit where transactionid = v_transactionid;

SELECT count(*)
into v_num_tce
FROM tb_client_eligibility tce
where tce.client_id = cjamspid and tce.delete_sw = 'N'
group by tce.eligibility_id;

if (v_num_tce >= 1) then
 update tb_client_eligibility
 set delete_sw = 'Y'
 where client_id = cjamspid and delete_sw = 'N';
end if;

IF(category = 'I') THEN
  INSERT INTO tb_audit_eligibility_result(auditeligibilityresultid, client_id, removal_id, eligibilitystatus, transactionid, auditperiodid, gapauditid, adoptionauditid, activeflag, insertedby, insertedon, updatedby, updatedon, exteligibilitystatus)
  VALUES(gen_random_uuid(), cjamspid, removalid, gapeligibilitystatus, v_transactionid, NULL, v_gapauditid, NULL, 1, 'Admin', now(), 'Admin', now(), NULL);
  
  IF(gapeligibilitystatus = 'InComplete_Application') THEN
   gapeligibilitystatus := 'Incomplete'; 
  END IF; 
 
  SELECT tpv.picklist_value_cd 
  INTO v_picklist_value_cd 
  FROM tb_picklist_values tpv 
  WHERE tpv.picklist_type_id = 262 
   AND upper(tpv.value_tx) = upper(gapeligibilitystatus);  
  
  INSERT INTO tb_client_eligibility(eligibility_id, start_dt, end_dt, eligibility_type_cd, eligibility_status_cd, client_id, removal_id, create_user_id, update_user_id)
   VALUES(nextval('seq_tb_client_eligibility'::regclass), NULL, NULL, '2935', v_picklist_value_cd, cjamspid, removalid, 'Admin', 'Admin');
 END IF;

IF(category = 'R') THEN
  INSERT INTO tb_audit_eligibility_result(auditeligibilityresultid, client_id, removal_id, eligibilitystatus, transactionid, auditperiodid, gapauditid, adoptionauditid, activeflag, insertedby, insertedon, updatedby, updatedon, exteligibilitystatus)
  VALUES(gen_random_uuid(), cjamspid, removalid, gapeligibilitystatus, v_transactionid, NULL, v_gapauditid, NULL, 1, 'Admin', now(), 'Admin', now(), extgapeligibilitystatus);
  
  IF(extgapeligibilitystatus = 'InComplete_Application') THEN
   extgapeligibilitystatus := 'Incomplete'; 
  END IF; 
 
  SELECT tpv.picklist_value_cd 
  INTO v_picklist_value_cd 
  FROM tb_picklist_values tpv 
  WHERE tpv.picklist_type_id = 262 
   AND upper(tpv.value_tx) = upper(extgapeligibilitystatus);  
  
  INSERT INTO tb_client_eligibility(eligibility_id, start_dt, end_dt, eligibility_type_cd, eligibility_status_cd, client_id, removal_id, create_user_id, update_user_id)
   VALUES(nextval('seq_tb_client_eligibility'::regclass), NULL, NULL, '2935', v_picklist_value_cd, cjamspid, removalid, 'Admin', 'Admin');
 END IF;

FOR v_counter IN SELECT * FROM json_array_elements(secondguardianhouseholdmembers)  
  loop   
   sg_dateofbirthofhouseholdmember := v_counter ->> 'sg_dateofbirthofhouseholdmember';
  sg_nationalandstatecriminalhistorybackgroundcheck_HH := v_counter ->> 'sg_nationalandstatecriminalhistorybackgroundcheck';
  sg_outofstatewithinpast5yearsoftheapplicationforgap_HH := v_counter ->> 'sg_outofstatewithinpast5yearsoftheapplicationforgap';
  sg_applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation_HH := v_counter ->> 'sg_applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation';
  sg_dateofchildabuseandmaltreatmentdatabasecheckoutofstate_HH := v_counter ->> 'sg_dateofchildabuseandmaltreatmentdatabasecheckoutofstate';
  sg_dateofnationalandstatecriminalhistorybackgroundcheck_HH := v_counter ->> 'sg_dateofnationalandstatecriminalhistorybackgroundcheck';
  sg_childabuseandmaltreatmentdatabasecheck_HH := v_counter ->> 'sg_childabuseandmaltreatmentdatabasecheck';
  sg_dateofchildabuseandmaltreatmentdatabasecheck_HH := v_counter ->> 'sg_dateofchildabuseandmaltreatmentdatabasecheck';
 
   insert into tb_gapaudit_secondguardianhouseholdmembers(secondguardianhouseholdmembersid, gapauditid, sg_dateofbirthofhouseholdmember, sg_nationalandstatecriminalhistorybackgroundcheck_HH, 
   sg_outofstatewithinpast5yearsoftheapplicationforgap_HH, sg_applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation_HH, 
   sg_dateofchildabuseandmaltreatmentdatabasecheckoutofstate_HH, sg_dateofnationalandstatecriminalhistorybackgroundcheck_HH, sg_childabuseandmaltreatmentdatabasecheck_HH, 
   sg_dateofchildabuseandmaltreatmentdatabasecheck_HH)
   
   values(gen_random_uuid(), v_gapauditid, sg_dateofbirthofhouseholdmember, sg_nationalandstatecriminalhistorybackgroundcheck_HH, 
   sg_outofstatewithinpast5yearsoftheapplicationforgap_HH, sg_applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation_HH, 
   sg_dateofchildabuseandmaltreatmentdatabasecheckoutofstate_HH, sg_dateofnationalandstatecriminalhistorybackgroundcheck_HH, sg_childabuseandmaltreatmentdatabasecheck_HH, 
   sg_dateofchildabuseandmaltreatmentdatabasecheck_HH);
--     RAISE NOTICE 'output from space %', v_counter ->> 'unearnedincometype';
  END LOOP;
 
FOR v_counter IN SELECT * FROM json_array_elements(siblingdetails)  
  loop   
   siblinggapeligiblitystatus := v_counter ->> 'sibling_gap_eligiblitystatus';
  siblingname := v_counter ->> 'siblingname';
  siblingguardianid := v_counter ->> 'siblingguardianid';  
 
   insert into tb_gapaudit_siblingdetails(siblingdetailsid, gapauditid, siblinggapeligiblitystatus, siblingname, siblingguardianid)
   
   values(gen_random_uuid(), v_gapauditid, siblinggapeligiblitystatus, siblingname, siblingguardianid);
--     RAISE NOTICE 'output from space %', v_counter ->> 'unearnedincometype';
  END LOOP;
 
FOR v_counter IN SELECT * FROM json_array_elements(licensedfosterhome)  
  loop   
   lastsixmonthfiscalcodeandpaymentstatus := v_counter ->> 'lastsixmonthfiscalcodeandpaymentstatus';
  dateofnationalandstatecriminalhistorybackgroundcheck := v_counter ->> 'dateofnationalandstatecriminalhistorybackgroundcheck';
  dateoffullapproval_fp := v_counter ->> 'dateoffullapproval_fp';
  nationalandstatecriminalhistorybackgroundcheck := v_counter ->> 'nationalandstatecriminalhistorybackgroundcheck';
  outofstatewithinpast5yearsoftheapplicationfor_gap := v_counter ->> 'outofstatewithinpast5yearsoftheapplicationfor_gap';
  dateofchildabuseandmaltreatmentdatabasecheckoutofstate := v_counter ->> 'dateofchildabuseandmaltreatmentdatabasecheckoutofstate';
  latestfostercareplacementstartdatewithperpectiveguardian := v_counter ->> 'latestfostercareplacementstartdatewithperpectiveguardian';
  applicablechildwelfareagenciesinthepreviousstatescontacted := v_counter ->> 'applicablechildwelfareagenciesinthepreviousstatescontacted';
  dateofchildabuseandmaltreatmentdatabasecheck := v_counter ->> 'dateofchildabuseandmaltreatmentdatabasecheck';
  fosterhomeapprover := v_counter ->> 'fosterhomeapprover';
  childabuseandmaltreatmentdatabasecheck := v_counter ->> 'childabuseandmaltreatmentdatabasecheck';
 
   insert into tb_gapaudit_licensedfosterhome(licensedfosterhomeid, gapauditid, lastsixmonthfiscalcodeandpaymentstatus, dateofnationalandstatecriminalhistorybackgroundcheck, 
   dateoffullapproval_fp, nationalandstatecriminalhistorybackgroundcheck, outofstatewithinpast5yearsoftheapplicationfor_gap, dateofchildabuseandmaltreatmentdatabasecheckoutofstate, 
   latestfostercareplacementstartdatewithperpectiveguardian, applicablechildwelfareagenciesinthepreviousstatescontacted, dateofchildabuseandmaltreatmentdatabasecheck,
   fosterhomeapprover, childabuseandmaltreatmentdatabasecheck)
   
   values(gen_random_uuid(), v_gapauditid, lastsixmonthfiscalcodeandpaymentstatus, dateofnationalandstatecriminalhistorybackgroundcheck, 
   dateoffullapproval_fp, nationalandstatecriminalhistorybackgroundcheck, outofstatewithinpast5yearsoftheapplicationfor_gap, dateofchildabuseandmaltreatmentdatabasecheckoutofstate, 
   latestfostercareplacementstartdatewithperpectiveguardian, applicablechildwelfareagenciesinthepreviousstatescontacted, dateofchildabuseandmaltreatmentdatabasecheck,
   fosterhomeapprover, childabuseandmaltreatmentdatabasecheck);
--     RAISE NOTICE 'output from space %', v_counter ->> 'unearnedincometype';
  END LOOP;

FOR v_counter IN SELECT * FROM json_array_elements(householdmember)  
  loop   
   nationalandstatecriminalhistorybackgroundcheck_hh := v_counter ->> 'nationalandstatecriminalhistorybackgroundcheck_hh';
  applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation := v_counter ->> 'applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation';
  outofstatewithinpast5yearsoftheapplicationforgap := v_counter ->> 'outofstatewithinpast5yearsoftheapplicationforgap';
  dateofbirthofhouseholdmember := v_counter ->> 'dateofbirthofhouseholdmember';
  childabuseandmaltreatmentdatabasecheck_hh := v_counter ->> 'childabuseandmaltreatmentdatabasecheck_hh';
   
   insert into tb_gapaudit_householdmember(householdmemberid, gapauditid, nationalandstatecriminalhistorybackgroundcheck_hh, 
   applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation, outofstatewithinpast5yearsoftheapplicationforgap,
   dateofbirthofhouseholdmember, childabuseandmaltreatmentdatabasecheck_hh)
   
   values(gen_random_uuid(), v_gapauditid, nationalandstatecriminalhistorybackgroundcheck_hh, 
   applicablechildwelfareagenciesinthepreviousstatescontactedtoobtainchildabuseandmaltreatmentinformation, outofstatewithinpast5yearsoftheapplicationforgap,
   dateofbirthofhouseholdmember, childabuseandmaltreatmentdatabasecheck_hh);
--     RAISE NOTICE 'output from space %', v_counter ->> 'unearnedincometype';
  END LOOP;
 
FOR v_counter IN SELECT * FROM json_array_elements(gapauditmessages)  
  loop   
   v_severity := v_counter ->> 'severity';
  v_text := v_counter ->> 'message';  
 
   insert into tb_gapaudit_messages(gapauditmessagesid, gapauditid, severity, message, cjamspid, insertedby, updatedby, insertedon, updatedon)
   values(gen_random_uuid(), v_gapauditid, v_severity, v_text, cjamspid, 'admin', 'admin', now(), now());
--     RAISE NOTICE 'output from space %', v_rdcounter ->> 'eventreason';
  END LOOP; 
 
RETURN QUERY
select
 --tb_audit_periods
 ga.transactionid             AS  v_transactionid,
 ga.cjamspid              AS  cjamspid,
 ga.gapauditid               AS  v_gapauditid,
 ga.category              AS  category,
 ga.gapeligibilitystatus           AS  gapeligibilitystatus,
 ga.extgapeligibilitystatus           AS  extgapeligibilitystatus,
 ga.missinginfo              AS  missinginfo,
 ga.gapv               AS  gapv,
 ga.gr                AS  gr,
 ga.sa                AS  sa,
 ga.hhcheck               AS  hhcheck,
 ga.hhdetails              AS  hhdetails,
 ga.ivereimb              AS  ivereimb,
 ga.egapv               AS  egapv,
 ga.finalresult              AS  finalresult

 FROM tb_ive_gapaudit AS ga
 where ga.transactionid = v_transactionid;
 
end
 $function$

