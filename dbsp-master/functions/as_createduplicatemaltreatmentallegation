   oahearingdatesetflag,oahearingdate,oanorhearingreason,oahearingdecision,oahearingdecisiondate,oadetails,ccstayrequestedflag,ccstaygrantedflag,ccappealedflag,
   cchearingdecisiontypekey,cchearingdecisiondate,ccdetails,csastayrequestedflag,csastaygrantedflag,csaappealedflag,csahearingdecisiontypekey,csahearingdecisiondate,
   csadetails,oaappealedflag,scicesentdate,scconfheldflag,scdecisiontypekey,scconferencedetail,scconferencedate,overridedate,overrideby,overridefindingtypekey,
   overridecomments,overrideapprflag,cccourtdecisionflag,cccompileddate,csacourtdecisionflag,csacompileddate,expungementflag,expungementprocessedflag,coastayreqflag,
   coastaygrantedflag,coaappealedflag,coahearingdecisiontypekey,coahearingdecisiondate,coadetails,coacase,coacourtdecisionflag,coacompileddate,isvictim,coacasenumber,
