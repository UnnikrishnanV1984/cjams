  FROM Investigationallegationmaltreators iam where  investigationallegationid = v_oldinvestigationallegationid AND activeflag = 1;

  INSERT INTO investigationallegationinjury(investigationallegationid,injurytypekey,activeflag,updatedby,updatedon,insertedby,insertedon)
  SELECT v_newinvestigationallegationid,injurytypekey,activeflag,v_securityusersid,now(),v_securityusersid,now() 
