  RETURNING investigationallegationid INTO v_newinvestigationallegationid;

  SELECT investigationallegationid INTO v_oldinvestigationallegationid FROM investigationallegation i WHERE investigationid = v_oldinvestigationid AND allegationid = '00000000-0000-0000-0000-000000000000' AND activeflag = 1;

  INSERT INTO investigationallegationmaltreators(investigationallegationid,intakeservicerequestactorid,activeflag,updatedby,updatedon,insertedby,insertedon,othermaltreator,clientroleid,oaicesentdate,
