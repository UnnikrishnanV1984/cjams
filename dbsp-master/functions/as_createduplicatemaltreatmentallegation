   FROM maltreatmentjurisdictionuser WHERE maltreatmentid = v_oldmaltreatmentid AND activeflag = 1;

   INSERT INTO investigationmaltreatmentactor(maltreatmentid,intakeservicerequestactorid,activeflag,insertedby,updatedby,effectivedate,insertedon,updatedon,ismaltreator)
   SELECT v_newmaltreatmentid,(SELECT intakeservicerequestactorid FROM intakeservicerequestactor isra1
   JOIN actor a1 ON a1.actorid = isra1.actorid 
   WHERE a1.personid = (SELECT a2.personid FROM intakeservicerequestactor isra2
   JOIN actor a2 ON a2.actorid = isra2.actorid
   WHERE intakeservicerequestactorid = ima.intakeservicerequestactorid)
   AND isra1.intakeserviceid = v_newintakeserviceid AND isra1.intakeservicerequestpersontypekey in ( 'AV','RA') LIMIT 1),activeflag,v_securityusersid,v_securityusersid,effectivedate,now(),now(),ismaltreator 
   FROM Investigationmaltreatmentactor ima WHERE ima.maltreatmentid = v_oldmaltreatmentid AND activeflag = 1 ORDER BY updatedon DESC  LIMIT 1
