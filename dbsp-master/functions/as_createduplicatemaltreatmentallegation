  collateral_interviews,criminal_history_inv,home_conditions,finalfinding 
  FROM investigationfinding WHERE investigationallegationid = v_oldinvestigationallegationid AND activeflag = 1;
 END IF;
 --ELSE 
  FOR v_oldmaltreatmentid IN SELECT maltreatmentid FROM investigationmaltreatment WHERE investigationid = v_oldinvestigationid AND activeflag = 1
  LOOP

   INSERT INTO Investigationmaltreatment (investigationid,householdkey,isjurisdiction,countyid,activeflag,insertedby,updatedby,effectivedate,insertedon,updatedon,notes,remarks,
   old_id,isapproximatedate,timeofincidence,incidentlocationtypekey,enddate,isreported,providerid,providername,providerphonenumber,isnotapplicable,notapplicablecomments)
