   overridecomments,overrideapprflag,cccourtdecisionflag,cccompileddate,csacourtdecisionflag,csacompileddate,expungementflag,expungementprocessedflag,coastayreqflag,
   coastaygrantedflag,coaappealedflag,coahearingdecisiontypekey,coahearingdecisiondate,coadetails,coacase,coacourtdecisionflag,coacompileddate,isvictim,coacasenumber,
   oacasenumber,cccasenumber,csacasenumber,scisappealed,scappealedby,scappealeddate,oaldssname,oaappellentatrny,oalocaldept,oarunningmotion,ccldssname,ccappellentatrny,
   coaldssname,coaappellentatrny,csaldssname,csaappellentatrny,csanotifiedtodirector,csacertiorari,ccwhoappealed,ccnotifiedtodirector,cccicuitcourtkey,ccldssnotifieddate,
   csaldssnotifieddate,scsummarymailed,scappealedsetdate,csawhoappealed,oahearingheldreason,oahearingheld,oalocationofhearing,oahearingnarrative,oamodificationsmade,
   oarunningmotiondate,oatranslator,cclocationofhearing,cchearingheld,cchearingheldreason,csaarguementheld,csaarguementnotheldreason,coacertioraristatus,
   coacertgranteddate,coacertdenieddate,csalocationofhearing,coalocationofhearing,csahearingheldreason,scisappealformsent,oasummarydecisionfiledflag,
   oasummarydecisionfileddate,oacompiledwithoah,finalizeflag,approveappeal,appealfinding,workercomments,finalizeddate)
   SELECT v_newinvestigationallegationid,(SELECT intakeservicerequestactorid FROM intakeservicerequestactor isra1
   JOIN actor a1 ON a1.actorid = isra1.actorid 
