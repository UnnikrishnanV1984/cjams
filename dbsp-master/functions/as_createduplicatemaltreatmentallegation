   maltreatmentdate,accidentalinjuryflag,maltreatmentkeyid,expungementflag,sextraffickingflag,victim_explanation,sibling_explanation,guardian_explanation,
   maltreator_explanation,med_assessmnts,expert_assessmnts,collateral_interviews,criminal_history_inv,home_conditions,law_enforcement_inv,aps_reason,investigation_action) 
   SELECT v_newinvestigationid,(SELECT allegationid FROM allegation WHERE "name" = (
   SELECT "name" FROM allegation WHERE allegationid = investigationallegation.allegationid) AND intakeservicereqtypeid='475bdb44-c347-41bc-91d1-af15979e0e27' 
   AND intakeservicereqsubtypeid='609903ca-2c4e-464a-9760-6dcb31df7238'),"name",reported,indicators,activeflag,updatedby,now(),insertedby,now(),effectivedate,expirationdate,financial,
   addedindicators,"comments",incidentdate,v_newmaltreatmentid,injurycomments,sextrafficking,v_newinvestigationmaltreatmentactorid,isapproximatedate,timeofincidence,
   incidentlocationtypekey,enddate,isproviderinvolved,investigationallegationstatus,outcome,relationshiptypekey,ischildfatality,clientroleid,maltreatmenttypekey,
   maltreatmentdate,accidentalinjuryflag,maltreatmentkeyid,expungementflag,sextraffickingflag,victim_explanation,sibling_explanation,guardian_explanation,
   maltreator_explanation,med_assessmnts,expert_assessmnts,collateral_interviews,criminal_history_inv,home_conditions,law_enforcement_inv,aps_reason,
   investigation_action FROM investigationallegation WHERE maltreatmentid = v_oldmaltreatmentid AND activeflag = 1 ORDER BY updatedon DESC  LIMIT 1
   RETURNING investigationallegationid INTO v_newinvestigationallegationid;

   SELECT investigationallegationid INTO v_oldinvestigationallegationid FROM investigationallegation i WHERE maltreatmentid = v_oldmaltreatmentid AND activeflag = 1;

   INSERT INTO investigationallegationindicator(investigationallegationid,indicatorid,activeflag,updatedby,updatedon,insertedby,insertedon)
   SELECT v_newinvestigationallegationid,indicatorid,activeflag,v_securityusersid,now(),v_securityusersid,now()
   FROM investigationallegationindicator WHERE investigationallegationid = v_oldinvestigationallegationid AND activeflag = 1;

   INSERT INTO investigationallegationmaltreators(investigationallegationid,intakeservicerequestactorid,activeflag,updatedby,updatedon,insertedby,insertedon,othermaltreator,clientroleid,oaicesentdate,
   oahearingdatesetflag,oahearingdate,oanorhearingreason,oahearingdecision,oahearingdecisiondate,oadetails,ccstayrequestedflag,ccstaygrantedflag,ccappealedflag,
   cchearingdecisiontypekey,cchearingdecisiondate,ccdetails,csastayrequestedflag,csastaygrantedflag,csaappealedflag,csahearingdecisiontypekey,csahearingdecisiondate,
