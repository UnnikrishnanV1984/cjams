CREATE OR REPLACE FUNCTION get_county_values(v_securityuserid character varying)
 RETURNS TABLE(countyname character varying, countyid uuid, statecountycode character varying)
 LANGUAGE plpgsql
AS $function$
 
BEGIN 
return query 
select c.countyname,c.countyid,Trim(c.statecountycode) :: character varying from team t 
join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join county c on c.countyid :: character varying =t.countyid  
join role r on r.id = rm.roleid :: int 
where  mu.securityusersid = v_securityuserid
and trim(lower(rm.teamtypekey)) = 'cw' ;
    

END;

$function$

