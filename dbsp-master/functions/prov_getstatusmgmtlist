CREATE OR REPLACE FUNCTION prov_getstatusmgmtlist(v_provider_id character varying)
 RETURNS TABLE(provider_status_management_id character varying, object_id character varying, narrative character varying, provider_status character varying, delete_sw character varying, active_flag character varying, approval_status character varying, dirty_status boolean, start_dt character varying, end_dt character varying, decision_dt character varying, status_reason character varying, approvalids text[], openvendor boolean, approvals text)
 LANGUAGE plpgsql
AS $function$
 
BEGIN 
 return query
SELECT psmt.provider_status_management_id ::character varying , psmt.object_id::character varying, psmt.narrative, psmt.provider_status, psmt.delete_sw::character varying, 
psmt.active_flag::character varying,psmt.approval_status, psmt.dirty_status, psmt.start_dt::character varying, psmt.end_dt::character varying, psmt.decision_dt::character varying,
 psmt.status_reason ,string_to_array(psmt.approvalids,','), psmt.openvendor,(select array_to_string(array_agg(tpv.value_tx),',') 
from tb_provider_approval tpa 
left join tb_picklist_values tpv on tpv.picklist_value_cd=tpa.approval_type_cd
where tpa.provider_approval_id= any(string_to_array(psmt.approvalids,',')))::text as approvalsdesc
FROM publicproviderstatusmanagement psmt
where psmt.object_id=v_provider_id and (psmt.delete_sw='N' or psmt.delete_sw is null) and psmt.active_flag='1';
END;

$function$

