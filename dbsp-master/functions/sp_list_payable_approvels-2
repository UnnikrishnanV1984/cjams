 r.toroleid= '''||v_toroleid||''' and r.fromroleid= ANY ('''||v_fromroleid||''') and r.eventcode= ''PCAUTHR'' and 
sprvsr_approval_status_cd='''|| v_sprvsr_approval_status_cd ||'''
