CREATE OR REPLACE FUNCTION prov_listsanction(v_provider_id integer, v_license_type character varying, pagenumber integer, pagesize integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
v_sanctiondata json;
v_pageoffset int;                                                                                                                                                                                                                                                                                                                                                            
v_pagenumber int;      

BEGIN  
     v_pagenumber := pagenumber-1;                                                                                                                                                                                                                                                                                                                                                     
     v_pageoffset = v_pagenumber * pagesize;     

if (v_license_type = 'RCC')then
    
select  jsonb_agg(x) as sanctiondata into v_sanctiondata from
(select * from tb_provider_rcc_sanctions where provider_id =  v_provider_id
LIMIT pagesize OFFSET v_pageoffset)x;

elseif (v_license_type = 'CPA') then
select  jsonb_agg(x) as sanctiondata into v_sanctiondata from
(select * from tb_provider_cpa_sanctions where  provider_id =  v_provider_id
LIMIT pagesize OFFSET v_pageoffset)x;
end if ;
return v_sanctiondata;
END;
$function$

