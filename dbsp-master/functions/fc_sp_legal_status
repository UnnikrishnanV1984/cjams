CREATE OR REPLACE FUNCTION fc_sp_legal_status(requestobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

declare

 v_responseText varchar(50);
 al_sqlcode integer default 0;
 
 v_vpaFlag varchar(5) default null;
 v_judicialFlag varchar(5) default null;
 v_safeHavenFlag varchar(5) default null;
 v_clientId integer;
 v_personId uuid;
 v_securityId uuid;
 v_intakeserviceid uuid;

 v_typeofvpa varchar(20);
 v_eavpaagreementflag integer;
 v_vpaparentssigneddate date;
 v_parent2signeddate date;
 v_dateofguardiansignatureonvpa date;
 v_primarycaregiverid integer;
 v_dateofchildsignatureonvpa date;
 v_vpadsssigneddate date;
 v_vpabegindate date;
 v_mandatorynoteonmissing2ndparentsignatureonvpa varchar(20);
 v_entry_dt date;

 v_ctwsanctioningchildremoval varchar(50);
 v_childphysicalremovaldate date;
 v_petitionfiledate date;
 v_dateofremovalcourthearing date;
 v_magistrateorjudgename varchar(50);
 v_judgesigned varchar(50);
 v_ctwdecision varchar(50);
 v_dateoffindingctwdecision date;
 v_hearingdate date;
 v_whoisresponsibleforplacementandcare varchar(50);
 v_nameofsubjectctwfinding varchar(50);
 v_clientidofsubjectctwfinding int4;
 v_relationshipofsubjectctwfinding varchar(50);
 v_physicalremovalafterdetermination varchar(50);
 v_removalcourtorderdate date;
 v_childphysicalremovaladdress varchar(50);
 v_courtorderdelayremoval varchar(50);
 v_courtorderdelaytimeframe int4;
 v_childphysicaladdressafterremoval varchar(50);
 v_specifiedrelativephysicaladdressafterremoval varchar(50);
 v_specifiedrelativename varchar(50);
 v_specifiedrelativeclientid int4;
 v_specifiedrelativedatechildlastlivedwith date;
 v_specifiedrelativephysicaladdress varchar(50); 
 v_specifiedrelativerelationshipid int4;
 v_dateofreasonableeffortscourthearing date;
 v_reasonableeffortsmade varchar(50);
 v_reasonableEffortsnotnecessaryduetoemergentcircumstances varchar(50);
 v_sheltergranted varchar(50);

 v_issafehavenbaby varchar(20);

begin
 
 v_responseText := 'Success';
 v_securityId := gen_random_uuid();  
 v_vpaflag := requestObj ->> 'vpaFlag';
 v_judicialFlag := requestObj ->> 'judicialFlag';
 v_safeHavenFlag := requestObj ->> 'safeHavenFlag';
 v_clientId := requestObj ->> 'clientId';

 v_typeofvpa := requestObj ->> 'typeofvpa';
 v_eavpaagreementflag := requestObj ->> 'eavpaagreementflag';
 v_vpaparentssigneddate := requestObj ->> 'vpaparentssigneddate';
 v_parent2signeddate := requestObj ->> 'parent2signeddate';
 v_dateofguardiansignatureonvpa := requestObj ->> 'dateofguardiansignatureonvpa';
 v_primarycaregiverid := requestObj ->> 'primarycaregiverid';
 v_dateofchildsignatureonvpa := requestObj ->> 'dateofchildsignatureonvpa';
 v_vpadsssigneddate := requestObj ->> 'vpadsssigneddate';
 v_vpabegindate := requestObj ->> 'vpabegindate';
 v_mandatorynoteonmissing2ndparentsignatureonvpa := requestObj ->> 'mandatorynoteonmissing2ndparentsignatureonvpa';
 v_entry_dt := requestObj ->> 'entry_dt';

 v_ctwsanctioningchildremoval := requestObj ->> 'ctwsanctioningchildremoval';
 v_childphysicalremovaldate := requestObj ->> 'childphysicalremovaldate';
 v_petitionfiledate := requestObj ->> 'petitionfiledate';
 v_dateofremovalcourthearing := requestObj ->> 'dateofremovalcourthearing';
 v_magistrateorjudgename := requestObj ->> 'magistrateorjudgename';
 v_judgesigned := requestObj ->> 'judgesigned';
 v_ctwdecision := requestObj ->> 'ctwdecision';
 v_dateoffindingctwdecision := requestObj ->> 'dateoffindingctwdecision';
 v_hearingdate := requestObj ->> 'hearingdate';
 v_whoisresponsibleforplacementandcare := requestObj ->> 'whoisresponsibleforplacementandcare';
 v_nameofsubjectctwfinding := requestObj ->> 'nameofsubjectctwfinding';
 v_clientidofsubjectctwfinding := requestObj ->> 'clientidofsubjectctwfinding';
 v_relationshipofsubjectctwfinding := requestObj ->> 'relationshipofsubjectctwfinding';
 v_physicalremovalafterdetermination := requestObj ->> 'physicalremovalafterdetermination';
 v_removalcourtorderdate := requestObj ->> 'removalcourtorderdate';
 v_childphysicalremovaladdress := requestObj ->> 'childphysicalremovaladdress';
 v_courtorderdelayremoval := requestObj ->> 'courtorderdelayremoval';
 v_courtorderdelaytimeframe := requestObj ->> 'courtorderdelaytimeframe';
 v_childphysicaladdressafterremoval := requestObj ->> 'childphysicaladdressafterremoval';
 v_specifiedrelativephysicaladdressafterremoval := requestObj ->> 'specifiedrelativephysicaladdressafterremoval';
 v_specifiedrelativename := requestObj ->> 'specifiedrelativename';
 v_specifiedrelativeclientid := requestObj ->> 'specifiedrelativeclientid';
 v_specifiedrelativedatechildlastlivedwith := requestObj ->> 'specifiedrelativedatechildlastlivedwith';
 v_specifiedrelativephysicaladdress := requestObj ->> 'specifiedrelativephysicaladdress';
 v_specifiedrelativerelationshipid := requestObj ->> 'specifiedrelativerelationshipid';
 v_dateofreasonableeffortscourthearing := requestObj ->> 'dateofreasonableeffortscourthearing';
 v_reasonableeffortsmade := requestObj ->> 'reasonableeffortsmade';
 v_reasonableEffortsnotnecessaryduetoemergentcircumstances := requestObj ->> 'reasonableEffortsnotnecessaryduetoemergentcircumstances';
 v_sheltergranted := requestObj ->> 'sheltergranted';

 v_issafehavenbaby := requestObj ->> 'issafehavenbaby';

 select personid into v_personId from person where cjamspid = v_clientId; 
 
 select isrp.intakeserviceid into v_intakeserviceid 
   FROM person AS per
 INNER JOIN intakeservicerequestperson AS isrp ON per.personid = isrp.personid
 WHERE per.cjamspid = v_clientId;
 
 if v_safeHavenFlag = 'YES'
 then
 
 insert into intakeservreqchildremoval (issafehavenbaby, intakeserviceid,nameofsubjectctwfinding,
 clientidofsubjectctwfinding, relationshipofsubjectctwfinding, childphysicalremovaladdress, childphysicaladdressafterremoval,  specifiedrelativephysicaladdressafterremoval, intakeservreqchildremovalid)
 values (v_issafehavenbaby, v_intakeserviceid::uuid,v_nameofsubjectctwfinding,
 v_clientidofsubjectctwfinding,v_relationshipofsubjectctwfinding,v_childphysicalremovaladdress,v_childphysicaladdressafterremoval,v_specifiedrelativephysicaladdressafterremoval, gen_random_uuid());

-- al_sqlcode := sqlcode;
-- IF sqlcode <> 0  THEN
--  v_responseText := 'Update Failed.';
-- END IF ;

 elseif v_vpaFlag = 'YES'
 then
   
 insert into intakeservreqchildremoval (typeofvpa, eavpaagreementflag, vpaparentssigneddate, parent2signeddate, dateofguardiansignatureonvpa, primarycaregiverid
 , dateofchildsignatureonvpa, vpadsssigneddate, vpabegindate, mandatorynoteonmissing2ndparentsignatureonvpa, intakeserviceid, nameofsubjectctwfinding,
 clientidofsubjectctwfinding, relationshipofsubjectctwfinding, childphysicalremovaladdress, childphysicaladdressafterremoval,  specifiedrelativephysicaladdressafterremoval, intakeservreqchildremovalid) 
 values(v_typeofvpa, v_eavpaagreementflag, v_vpaparentssigneddate, v_parent2signeddate, v_dateofguardiansignatureonvpa, v_primarycaregiverid, 
 v_dateofchildsignatureonvpa, v_vpadsssigneddate, v_vpabegindate, v_mandatorynoteonmissing2ndparentsignatureonvpa, v_intakeserviceid, v_nameofsubjectctwfinding,
 v_clientidofsubjectctwfinding,v_relationshipofsubjectctwfinding,v_childphysicalremovaladdress,v_childphysicaladdressafterremoval,v_specifiedrelativephysicaladdressafterremoval,
 gen_random_uuid());
  
 insert into tb_placement (client_id, entry_dt, create_user_id, update_user_id)
 values (v_clientId, v_entry_dt, v_securityId, v_securityId);

 elseif v_judicialFlag = 'YES'
 then
 
 insert into intakeservreqchildremoval (ctwsanctioningchildremoval, childphysicalremovaldate, petitionfiledate, dateofremovalcourthearing,
 magistrateorjudgename, judgesigned, ctwdecision, dateoffindingctwdecision, hearingdate, whoisresponsibleforplacementandcare, 
 nameofsubjectctwfinding, clientidofsubjectctwfinding, relationshipofsubjectctwfinding, physicalremovalafterdetermination, removalcourtorderdate,
 childphysicalremovaladdress, courtorderdelayremoval, courtorderdelaytimeframe, childphysicaladdressafterremoval, specifiedrelativephysicaladdressafterremoval,
 specifiedrelativename, specifiedrelativeclientid, specifiedrelativedatechildlastlivedwith, specifiedrelativephysicaladdress,
 specifiedrelativerelationshipid, dateofreasonableeffortscourthearing, reasonableeffortsmade, reasonableEffortsnotnecessaryduetoemergentcircumstances,
 sheltergranted, intakeserviceid, intakeservreqchildremovalid) 
 values (v_ctwsanctioningchildremoval, v_childphysicalremovaldate, v_petitionfiledate, v_dateofremovalcourthearing, v_magistrateorjudgename,
 v_judgesigned, v_ctwdecision, v_dateoffindingctwdecision, v_hearingdate, v_whoisresponsibleforplacementandcare, v_nameofsubjectctwfinding,
 v_clientidofsubjectctwfinding, v_relationshipofsubjectctwfinding, v_physicalremovalafterdetermination, v_removalcourtorderdate,
 v_childphysicalremovaladdress, v_courtorderdelayremoval, v_courtorderdelaytimeframe, v_childphysicaladdressafterremoval, 
 v_specifiedrelativephysicaladdressafterremoval, v_specifiedrelativename, v_specifiedrelativeclientid, v_specifiedrelativedatechildlastlivedwith,
 v_specifiedrelativephysicaladdress, v_specifiedrelativerelationshipid, v_dateofreasonableeffortscourthearing, v_reasonableeffortsmade,
 v_reasonableEffortsnotnecessaryduetoemergentcircumstances, v_sheltergranted, v_intakeserviceid, gen_random_uuid()); 
 
 else
 v_responseText := 'Failure';
 
 end if; 

 return v_responseText;
end;
$function$

