CREATE OR REPLACE FUNCTION as_servicecasevalidation(l_intakeserviceid uuid)
 RETURNS bigint
 LANGUAGE plpgsql
AS $function$


DECLARE
 l_count bigint;

BEGIN 
 SELECT COUNT(*) INTO l_count FROM actor ac1 
 INNER JOIN intakeservicerequest isr1 ON ac1.intakeserviceid = isr1.intakeserviceid AND isr1.activeflag = 1 
 WHERE ac1.personid = (
 SELECT personid FROM actor ac 
 INNER JOIN intakeservicerequest isr ON ac.intakeserviceid = isr.intakeserviceid AND isr.activeflag = 1 
 WHERE isr.intakeserviceid = l_intakeserviceid AND ac.actortype IN ('RA','AV','RC') ORDER BY actiontype ASC LIMIT 1)
  AND ac1.activeflag = 1 AND ac1.actortype IN ('RA','AV','RC') AND ac1.intakeserviceid <> l_intakeserviceid
  AND isr1.intakeservreqtypeid = 'd207bdd4-f281-4ec8-949c-8fd9657227f9';
   
   RETURN l_count;
END;


$function$

