CREATE OR REPLACE FUNCTION prov_financeincidentreportupdate(v_provider_id integer, v_fir_no character varying)
 RETURNS TABLE(provider_id integer, program_nm character varying, fir_no character varying, insertedon timestamp without time zone)
 LANGUAGE plpgsql
AS $function$
declare 

BEGIN
 RETURN QUERY
 select pi.provider_id as provider_id, pi.site_id::character varying as program_nm, pi.fir_no as fir_no,
inserted_on as insertedon from provider_fir pi where pi.fir_no = v_fir_no AND active_flag =1
AND case when v_provider_id is not null then pi.provider_id = v_provider_id else true end;
 
end;
$function$

