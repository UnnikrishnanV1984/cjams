CREATE OR REPLACE FUNCTION as_createcasetranferplacementadd(v_oldintakeserviceid uuid, v_newintakeserviceid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 


BEGIN

INSERT into placement
(providerid, intakeserviceid, intakeservicerequestactorid, remarks,
  startdatetime, enddatetime, statustypekey, updatedby, insertedby)

select providerid, v_newintakeserviceid , intakeservicerequestactorid, remarks,
  startdatetime, enddatetime, statustypekey, updatedby, insertedby from placement
  where intakeserviceid = v_oldintakeserviceid;
  
Return 'Successfull';
   
end;

$function$

