CREATE OR REPLACE FUNCTION getadoptionannualreview(v_adoptioncaseid uuid)
 RETURNS TABLE(adoptionannualreviewid uuid, reviewdate timestamp without time zone, ischilddisability boolean, ischildspecialneed boolean, isparentlegalresponsible boolean, isrenewalsigned boolean, isfinancialsupport boolean, ischildenrolledschool boolean, isdoumentationimmurization boolean, ischildschoolemployeedisabled boolean, iscompletesecondaryeducation boolean, isenrolledinstitution boolean, isparticipatingemployement boolean, isemployeehrspermonth boolean, isincapableactivities boolean, adoptiveparentonedate timestamp without time zone, adoptiveparenttwodate timestamp without time zone, ldssdirectorsigndate timestamp without time zone, disabilitynotes character varying, notes character varying, status text)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 RETURN  query                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 SELECT aar.adoptionannualreviewid, aar.reviewdate,  aar.ischilddisability, aar.ischildspecialneed, aar.isparentlegalresponsible,
        aar.isrenewalsigned, aar.isfinancialsupport, aar.ischildenrolledschool, aar.isdoumentationimmurization,
        aar.ischildschoolemployeedisabled, aar.iscompletesecondaryeducation, aar.isenrolledinstitution, aar.isparticipatingemployement,
        aar.isemployeehrspermonth, aar.isincapableactivities, aar.adoptiveparentonedate, aar.adoptiveparenttwodate,
        aar.ldssdirectorsigndate, aar.disabilitynotes, aar.notes,
        (select typedescription from routingstatustype where sequencenumber =  r.routingstatustypeid) as status                                                                                                                                                                                                                                                                                                                                                                                                                                                     
 FROM adoptionannualreview aar 
 inner join routing r on r.objectid = aar.adoptionannualreviewid :: character varying and r.activeflag = 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
 INNER JOIN adoptioncase ac ON ac.adoptioncaseid = aar.adoptioncaseid AND ac.activeflag =1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
 WHERE aar.adoptioncaseid = v_adoptioncaseid AND aar.activeflag =1;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 END;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 $function$

