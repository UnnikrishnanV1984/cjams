CREATE OR REPLACE FUNCTION as_convertvarchartoint(v_input character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
 
DECLARE v_int_value INTEGER DEFAULT NULL;
BEGIN
    BEGIN
        v_int_value := v_input::INTEGER;
    EXCEPTION WHEN OTHERS THEN
        RETURN NULL;
    END;
RETURN v_int_value;
END; 
$function$

