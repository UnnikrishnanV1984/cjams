 (SELECT CAST(substring(COALESCE(TRIM(PA.address),''),1,20)||'~'|| substring(COALESCE(TRIM(PA.address2),''),1,20) ||'~'|| COALESCE(TRIM(PA.city),'') ||'~'|| COALESCE(TRIM(PA.zipcode),'')||'~'|| COALESCE(TRIM(PA.county),'') ||'~'|| COALESCE(PA.state,'')as character varying) 
   FROM PersonAddress AS PA
