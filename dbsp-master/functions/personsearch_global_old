CREATE TEMP TABLE KeyResults(PersonId uuid , PersonAddressId uuid);
INSERT INTO KeyResults (PersonId)
    SELECT DISTINCT p.PersonId
    FROM  Person AS p
    LEFT JOIN PersonIdentifier AS i ON i.PersonId = p.PersonId
    LEFT JOIN PersonAddress  AS a ON a.PersonId = p.PersonId   AND a.PersonAddressTypeKey = 'C' and a.ActiveFlag = 1
    LEFT JOIN PersonPhoneNumber AS pn ON pn.PersonId = p.PersonId
    LEFT JOIN   County    AS c ON  a.county = c.CountyName
    WHERE 
 CASE WHEN v_lvLastName is NOT NULL THEN (p.LastName ILIKE  v_lvLastName || '%') ELSE TRUE END
 AND CASE WHEN v_lvFirstName is NOT NULL THEN (p.FirstName ILIKE  v_lvFirstName || '%') ELSE TRUE END 
 AND CASE WHEN v_lvMiddleName is NOT NULL THEN (p.MiddleName ILIKE  v_lvMiddleName || '%') ELSE TRUE END 
    /*( p.LastName LIKE  v_lvLastName || '%' OR COALESCE(p.LastNameSoundex,'') = v_lLastNameSoundEx)
    AND  (p.FirstName LIKE  v_lvFirstName || '%' OR COALESCE(p.FirstNameSoundex,'') = v_lFirstNameSoundEx)
    AND  (v_liAge  IS NULL OR DATEDIFF(YEAR, p.DOB, v_ldNow) = v_liAge)*/
 AND CASE WHEN v_lvRace is NOT NULL THEN (p.RaceTypeKey = v_lvRace) ELSE TRUE END
 AND CASE WHEN v_lvGender is NOT NULL THEN (p.GenderTypeKey = v_lvGender) ELSE TRUE END
 AND CASE WHEN v_ldDOB is NOT NULL THEN (p.DOB = v_ldDOB) ELSE TRUE END
 AND CASE WHEN v_ldDOBFrom is NOT NULL THEN (p.DOB BETWEEN v_ldDOBFrom AND v_ldDOBTo) ELSE TRUE END
    AND  p.ActiveFlag = COALESCE(v_liActiveFlag, p.ActiveFlag)
 AND CASE WHEN v_lvCity is NOT NULL THEN (a.city ILIKE v_lvCity || '%') ELSE TRUE END
 AND CASE WHEN v_lvAddress is NOT NULL THEN (a.address ILIKE v_lvAddress   || '%') ELSE TRUE END    
    AND CASE WHEN v_lvZip is NOT NULL THEN (a.zipcode ILIKE v_lvZip || '%') ELSE TRUE END    
    AND CASE WHEN v_lvState is NOT NULL THEN (a.state ILIKE v_lvState  || '%') ELSE TRUE END 
    AND CASE WHEN v_lvCounty is NOT NULL THEN (a.county ILIKE v_lvCounty  || '%') ELSE TRUE END
    AND CASE WHEN v_lvPhone is NOT NULL THEN (pn.phoneNumber = v_lvPhone) ELSE TRUE END
    AND CASE WHEN v_lDCNValue is NOT NULL THEN (i.PersonIdentifierValue = v_lDCNValue) ELSE TRUE END
    AND CASE WHEN v_lDCNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lDCNType) ELSE TRUE END
    AND CASE WHEN v_lSSNValue is NOT NULL THEN (i.PersonIdentifierValue ILIKE v_lSSNValue  || '%') ELSE TRUE END
 AND CASE WHEN v_lSSNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lSSNType) ELSE TRUE END
 AND CASE WHEN v_lDLValue is NOT NULL THEN (i.PersonIdentifierValue ILIKE v_lDLValue  || '%') ELSE TRUE END
 AND CASE WHEN v_lDLType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lDLType) ELSE TRUE END
    AND CASE WHEN v_liDangerous is NOT NULL THEN (p.DangerLevel = v_liDangerous) ELSE TRUE END
    AND CASE WHEN v_liRegion is NOT NULL THEN (c.APSRegion = v_liRegion) ELSE TRUE END 
 
 AND CASE WHEN v_lvMaidenName is NOT NULL THEN (p.maidenname = v_lvMaidenName) ELSE TRUE END 
 AND CASE WHEN v_lvSocialMediaSrc is NOT NULL THEN (p.socialmediasource = v_lvSocialMediaSrc) ELSE TRUE END 
 AND CASE WHEN v_lvDateOfDeath is NOT NULL THEN (p.dateofdeath = v_lvDateOfDeath) ELSE TRUE END 
 AND CASE WHEN v_lvStateId is NOT NULL THEN (p.stateid = v_lvStateId) ELSE TRUE END 
 AND CASE WHEN v_lvOccupation is NOT NULL THEN (p.occupation = v_lvOccupation) ELSE TRUE END 
 
 
