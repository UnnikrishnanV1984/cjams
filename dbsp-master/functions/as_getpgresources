CREATE OR REPLACE FUNCTION as_getpgresources(in_limit integer, in_page integer, _roleid integer)
 RETURNS TABLE(parentid uuid, parentname character varying, resourceid uuid, resourcename character varying, isvisible boolean, isenabled boolean, resourcetype integer, permissiontype integer)
 LANGUAGE plpgsql
AS $function$

 BEGIN
            in_page := (in_page-1)*   10;
 
        RETURN QUERY
  select Distinct  r.parentid, r.parentname,r.id as resourceid, 
  r.resourcename, rr.isvisible, rr.isenabled, r.resourcetype, rr.permissiontype
  from role_resource  rr 
  join (select r2.resourcename as parentname, r1.* from resource r1 left join resource r2 on r1.parentid = r2.id 
  and r1.activeflag = 1 and r2.activeflag = 1
  )r on r.id = rr.resourceid
  where rr.permissiontype = 2 and rr.roleid = _roleid
   LIMIT in_limit OFFSET in_page;
        END;
$function$

