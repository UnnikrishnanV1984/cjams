CREATE OR REPLACE FUNCTION getadoptioncaseannualreview(v_adoptioncaseid uuid)
 RETURNS TABLE(adoptioniverenewalid uuid, assessmentdate timestamp without time zone, ischilddisability integer, ischildspecialneed integer, isparentlegalresponsible integer, isrenewalsigned integer, fatheragreementdate timestamp without time zone, motheragreementdate timestamp without time zone, designeeagreementdate timestamp without time zone, disabilitynotes character varying, comments character varying, parentsupportflag integer, schoolenrollflag integer, immunizationflag integer, mededuvoccertflag integer, paytill22educhkflag integer, paytill22enrollchkflag integer, paytill22emppgmchkflag integer, paytill22emp80hrchkflag integer, paytill22medchkflag integer, status text, enteredby character varying)
 LANGUAGE plpgsql
AS $function$    

 BEGIN
 
 RETURN  query
 SELECT aar.adoptioniverenewalid, aar.assessmentdate,  aar.ischilddisability, aar.ischildspecialneed, aar.isparentlegalresponsible,
        aar.isrenewalsigned
  , COALESCE(aar.fatheragreementdate, aar.motheragreementdate)
  , CASE WHEN aar.fatheragreementdate IS NOT NULL THEN aar.motheragreementdate ELSE NULL END motheragreementdate
  , aar.designeeagreementdate, aar.paytill22medchk as disabilitynotes, aar.comments,
  aar.parentsupportflag, aar.schoolenrollflag, aar.immunizationflag,
        aar.mededuvoccertflag, aar.paytill22educhkflag, aar.paytill22enrollchkflag, aar.paytill22emppgmchkflag,
        aar.paytill22emp80hrchkflag, aar.paytill22medchkflag,
        (select typedescription from routing r 
        inner join  routingstatustype rst on rst.sequencenumber=r.routingstatustypeid where 
        r.objectid  = aar.adoptioniverenewalid :: character varying and r.activeflag=1 limit 1) as status,
  (SELECT displayname FROM userprofile WHERE securityusersid = aar.insertedby) enteredby
 FROM adoptioniverenewal aar                                                                                                                                                
 INNER JOIN adoptioncase ac ON ac.adoptioncaseid = aar.adoptionid AND ac.activeflag =1
 WHERE aar.adoptionid = v_adoptioncaseid AND aar.activeflag =1
 order by aar.assessmentdate asc;                                                                                                                                                                                
 END;                                                                                                                                                                                      
 $function$

