CREATE OR REPLACE FUNCTION prov_addprovidercontractstatus(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
                                                                                                                                                                                              
                                                                                                                                                                                                            
 DECLARE                                                                                                                                                                                                    
 returnStatus text;                                                                                                                                                                                         
 --providerId numeric;                                                                                                                                                                                      
 programId numeric;                              
contractId numeric;                                                                                                                                                                
 contractNoOfbeds numeric;                                                                                                                                                                                  
 contractCapacityPercent numeric;                                                                                                                                                                           
 stdate date;                                                                                                                                                                                               
 enddate date;    
v_insertedby character varying;    
v_license_bed integer;
v_irc_bed_capacity integer;
v_fiscal_date character VARYING ;
v_contract_license_type_status character varying;     
v_eff_start_date date;
v_eff_end_date date;
v_contract_term_status character VARYING;
v_oth_license_type character varying;
v_securityusersid character varying;
  
 BEGIN                                                                                                                                                                                                      
                                                                                                                                                                                                            
 programId :=insertedtlsobj->>'program_id';         
 contractId := insertedtlsobj->>'contract_id';                                                                                                                                                                 
-- contractNoOfbeds :=insertedtlsobj->>'contract_beds_no';                                                                                                                                                     
-- contractCapacityPercent :=insertedtlsobj->>'capacity_percentage_no';                                                                                                                                        
-- stdate:=insertedtlsobj->>'start_dt';                                                                                                                                                                        
-- enddate:= insertedtlsobj->>'end_dt'; 
--v_insertedby := insertedtlsobj->>'create_user_id'; 
--v_license_bed := insertedtlsobj->>'license_bed';
--v_irc_bed_capacity := insertedtlsobj->>'irc_bed_capacity';
--v_fiscal_date := insertedtlsobj->>'fiscal_date';
v_contract_license_type_status :=  insertedtlsobj->>'contract_license_type_status';
v_contract_term_status :=  insertedtlsobj->>'contract_term_status';
v_eff_start_date:=insertedtlsobj->>'effective_start_date';
v_eff_end_date:=insertedtlsobj->>'effective_end_date';
v_oth_license_type:=insertedtlsobj->>'other_contract_license_type_status';
--update tb_contract_program set delete_sw='Y' where program_id=programId;

v_securityusersid := insertedtlsobj->>'update_user_id';

if ((insertedtlsobj->>'objecttype')::character varying != 'contract') then 
INSERT INTO tb_contract_program_history
(program_id,contract_id, program_nm, start_dt, end_dt, capacity_percentage_no, contract_beds_no, vacancy_no, preferred_cd,
program_status_cd, admission_comments_tx, create_ts, create_user_id, update_ts, update_user_id, delete_sw, program_purpose_cd,
child_specific_agreement_cd, child_specific_update_staff_id, child_specific_change_ts, license_no,license_bed,irc_bed_capacity,fiscal_date,contract_license_type_status,effective_start_date,effective_end_date,other_contract_license_type_status)

select program_id,contract_id, program_nm, start_dt, end_dt, capacity_percentage_no, contract_beds_no, vacancy_no, preferred_cd,
program_status_cd, admission_comments_tx, create_ts, create_user_id, update_ts, update_user_id, delete_sw, program_purpose_cd,
child_specific_agreement_cd, child_specific_update_staff_id, child_specific_change_ts, license_no,license_bed,irc_bed_capacity,fiscal_date,contract_license_type_status,effective_start_date,effective_end_date,other_contract_license_type_status
from tb_contract_program where program_id=programId ;                                                                                                                                                                                                         

 update tb_contract_program set contract_license_type_status = v_contract_license_type_status,
 update_ts = now(),
 update_user_id = v_securityusersid,
 effective_start_date=v_eff_start_date,effective_end_date=v_eff_end_date,other_contract_license_type_status=v_oth_license_type,
 program_status_cd = case when v_contract_license_type_status = 'Active' then 3625 when v_contract_license_type_status = 'Closed' then 3626 else null end 
 where program_id=programId;
 else 
    update tb_provider_contracts set contract_term_status =  (insertedtlsobj->>'contract_term_status')::character varying,
    start_dt =v_eff_start_date,end_dt =v_eff_end_date,
    update_ts = now(),
    update_user_id = v_securityusersid,
    status_cd = case when v_contract_term_status = 'Active' then 3625 
                    when v_contract_term_status = 'Expired' then 3626 
                    when v_contract_term_status = 'In Progress' then 3627 
                    else null end 
    where contract_id=contractId;

end if;
 returnStatus:= 'Success';                                                                                                                                                                                  
 RETURN returnStatus;                                                                                                                                                                                       
                                                                                                                                                                                                            
 END;
$function$

