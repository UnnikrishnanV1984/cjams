CREATE OR REPLACE FUNCTION as_getservicecaseworker(v_intakeserviceid uuid, v_serviceid uuid)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE 

v_caseworkername  character  varying;
BEGIN 
 

 select u.displayname into v_caseworkername from caseassignment c 
 inner join intakeserv iv on iv.description=c.servicetype 
 inner join asservicesoncase ac on ac.caseservicetypeid = iv.intakeservid 
 inner join userprofile u on u.securityusersid = c.toworkeridno 
 where ac.activeflag =1 and c.activeflag =1 and c.objectid =v_intakeserviceid and ac.ascaseid =v_intakeserviceid
and ac.caseservicetypeid =v_serviceid and c.responsibilitytypekey='primary' order by c.insertedon desc limit 1;
   
if(v_caseworkername is null) then 
select u.displayname into v_caseworkername from caseassignment c 
 inner join intakeserv iv on iv.description=c.servicetype 
 inner join asservicesoncase ac on ac.caseservicetypeid = iv.intakeservid 
 inner join userprofile u on u.securityusersid = c.toworkeridno 
 where ac.activeflag =1 and c.activeflag =1 and c.objectid =v_intakeserviceid and ac.ascaseid =v_intakeserviceid
and ac.caseservicetypeid =v_serviceid and c.responsibilitytypekey='administrative' order by c.insertedon desc limit 1;

end if;

return v_caseworkername;
END;
$function$

