CREATE OR REPLACE FUNCTION as_caseclosuresummarylist(v_intakeserviceid uuid, pagenumber integer, pagesize integer)
 RETURNS TABLE(caseclosuresummaryid uuid, reason character varying, referralreason character varying, riskissues character varying, recommendation character varying, closuresubtypekey character varying, closuresubtypevaluetext character varying, closuresubtypedescription character varying, closuretypekey character varying, closuretypevaluetext character varying, closuretypedescription character varying, closuredate timestamp without time zone, notes character varying, participants json, interventionissues json)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_pagenumber integer;
 v_pageoffset integer;

BEGIN
v_pagenumber := pagenumber-1;
v_pageoffset = v_pagenumber * pagesize;

RETURN QUERY

SELECT 
 ccs.caseclosuresummaryid,ccs.reason,ccs.referralreason,ccs.riskissues,ccs.recommendation,
 ccs.closuresubtypekey,rv2.value_text AS closuresubtypevaluetext,rv2.description AS closuresubtypedescription,ccs.closuretypekey,rv1.value_text AS closuretypevaluetext,rv1.description AS closuretypedescription,ccs.closuredate,ccs.notes,
    (SELECT json_agg((SELECT y FROM (SELECT p.firstname,p.lastname,p.dob,ccp.caseclosureparticipantid,ccp.intakeservicerequestactorid,ccp.ischild) AS y)) AS items
  FROM caseclosureparticipant ccp
      INNER JOIN intakeservicerequestactor isra ON isra.intakeservicerequestactorid=ccp.intakeservicerequestactorid AND isra.activeflag=1
      INNER JOIN person p ON p.personid=isra.personid AND p.activeflag=1
  WHERE ccp.activeflag=1 and ccp.caseclosuresummaryid=ccs.caseclosuresummaryid
 ) AS participants,
    (SELECT json_agg((SELECT z FROM (SELECT cs.caseclosureserviceid,cs.interventiontypekey,rv.value_text,rv.description) AS z)) AS items
  FROM caseclosureservice cs
        INNER JOIN referencevalues rv ON rv.ref_key=cs.interventiontypekey AND rv.activeflag=1 AND rv.referencetypeid=103
        WHERE cs.activeflag=1 and cs.caseclosuresummaryid=ccs.caseclosuresummaryid
 ) AS interventionissues
FROM caseclosuresummary ccs 
INNER JOIN referencevalues rv1 ON rv1.ref_key=ccs.closuretypekey AND rv1.activeflag=1 AND rv1.referencetypeid=101
INNER JOIN referencevalues rv2 ON rv2.ref_key=ccs.closuresubtypekey AND rv2.activeflag=1 AND rv2.referencetypeid=102
WHERE ccs.activeflag=1 AND ccs.intakeserviceid=v_intakeserviceid
LIMIT pagesize OFFSET v_pageoffset;  

END;

$function$

