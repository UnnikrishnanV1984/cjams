CREATE OR REPLACE FUNCTION f_prvpcklst_cat(ai_prov_id bigint, as_category_type character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------------------------------
-- SQL Stored Procedure
-- Description: SP to identify Provider Category

-- Revisions:
-- Vineet Tirodkar - 09/14/2020 - To Add Adult Services Service Plan Provider Category
-- Vineet Tirodkar - 05/03/2021 - Modifications for New Provider Category 3794 - Residential Treatment Center (B-102022)
-- Vineet Tirodkar - 01/03/2022 - Modifications to avoid sp_batch_prov_checklist failure due to duplicate PICKLIST_VALUE_CDs (CIDM-4135)
------------------------------------------------------------------------------------------------
DECLARE
BEGIN
    RETURN
        CASE
        WHEN as_category_type = 'PLACEMENT' THEN 
   (SELECT PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD IN ('1782','1783','1785','3049','3274','3302','3794') 
       AND PROVIDER_ID = ai_prov_id 
       AND DELETE_SW = 'N')

  WHEN as_category_type = 'VENDOR' THEN
   (SELECT distinct PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD = '3304' 
       AND PROVIDER_ID = ai_prov_id 
       AND DELETE_SW = 'N')

  WHEN as_category_type = 'COMMUNITY' THEN
   (SELECT distinct PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD = '3305' 
       AND PROVIDER_ID = ai_prov_id 
       AND DELETE_SW = 'N')
    
  WHEN as_category_type = 'ASSERVICEPLAN' THEN  
   (SELECT distinct PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD = '1787' -- Service Plan Provider
       AND PROVIDER_ID = ai_prov_id 
       AND DELETE_SW = 'N')
       END;
END;

$function$

