CREATE OR REPLACE FUNCTION prov_vendorprofileinfo(v_vendorid character varying)
 RETURNS TABLE(provider_id integer, org_nm character varying, primary_prefix_cd character varying, primary_first_nm character varying, primary_middle_nm character varying, primary_last_nm character varying, primary_suffix_cd character varying, isprimaryadmin boolean, admin_prefix_cd character varying, admin_first_nm character varying, admin_middle_nm character varying, admin_last_nm character varying, admin_suffix_cd character varying, taxidtype character varying, taxid numeric, is1099indicator boolean, ismedicalaidprov boolean, status character varying, vendorid character varying, regularfrom character varying, regularto character varying, narrative text, jurisdiction character varying, services json, ismanagevendor boolean, ref_key text, approvalcomments character varying)
 LANGUAGE plpgsql
AS $function$
 
DECLARE
v_category_cd character varying;
 
BEGIN
--select provider_category_cd into v_category_cd from tb_provider tpr where tpr.provider_id=v_vendorid;
--if ((v_category_cd is null ) or (v_category_cd=1783)) then
--  select picklist_value_cd into v_category_cd  from tb_provider_picklist ppl  where ppl.picklist_value_cd=3304 and  ppl.provider_id=v_vendorid; 
-- end if;
return query 
select pr.provider_id, pr.provider_nm as org_nm, pr.provider_prefix_cd as primary_prefix_cd, pr.provider_first_nm as primary_first_nm, pr.provider_middle_nm as primary_middle_nm, pr.provider_last_nm as primary_last_nm, pr.provider_suffix_cd as primary_suffix_cd, false, pr.adm_contact_prefix_cd as admin_prefix_cd, pr.adm_contact_first_nm as admin_first_nm, pr.adm_contact_middle_nm as admin_middle_nm, pr.adm_contact_last_nm as admin_last_nm, pr.adm_contact_suffix_cd as admin_suffix_cd, pr.prov_tax_type_cd as taxidtype, pr.tax_id_no as taxid, 
(case when pr.indicator_1099_sw = 'Y' then true else false end) as is1099indicator, 
(case when pr.medicaid_sw = 'Y' then true else false end) as ismedicalaidprov, pval.value_tx as status,pr.provider_id::character varying as vendorid,pr.business_start_tm::character varying as regularfrom,pr.business_end_tm::character varying as regularto,''::text as narrative,
pr.county_cd as jurisdiction,
(select json_agg(x) from (select ps.provider_service_id,ps.provider_id,ps.service_id,ps.start_dt as startdate,ps.end_dt as enddate, ss.service_nm,ps.delete_sw from tb_provider_services ps inner join tb_services ss on ss.service_id = ps.service_id where ps.provider_id=pr.provider_id and ps.delete_sw='N' and ss.delete_sw='N') as x) as services,
case when ((pr.provider_id is null)) then false else true end, case when pval.value_tx='Closed' then 'REJ' else 'APR' end as ref_key, ''::character varying as approvalcomments
from tb_provider pr 
join tb_provider_picklist pl on pl.provider_id = pr.provider_id and picklist_type_id='155' and (pl.picklist_value_cd=3304 or pl.picklist_value_cd=1787) 
join tb_picklist_values pval on pr.provider_status_cd = pval.picklist_value_cd 
--join tb_picklist_values pval1 on pval1.picklist_value_cd = v_category_cd
where pr.provider_id=(v_vendorid) and pr.delete_sw='N';

END;

$function$

