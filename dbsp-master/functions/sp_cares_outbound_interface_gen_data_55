CREATE OR REPLACE FUNCTION sp_cares_outbound_interface_gen_data_55(vl_client_id integer, vl_other_id character varying, vs_transaction_type_cd character varying, vl_transaction_sequence integer, vd_transaction_ts timestamp without time zone, OUT vs_message character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- Author: Sudhin
-- Date Created :08/01/2005
-- generates Cares Interface Outbound Data
-- 02/09/2007 - Sandhya -- #12329    - Added condition for trnasaction type = '15' (Subsidy Guardianship)
-- 04.10.08 -#17248 sandhya -  Check for telephone nos having spaces and store zeros in place.
-- 04.14.2010  -GAYATHRI RAJKUMAR MAPPED DECLINED RACE TO UNKNOWN
------------------------------------------------------------------------

    DECLARE VS_RECORD_TYPE VARCHAR(2);--
     VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';--
     VL_RECORD_SEQUENCE INTEGER DEFAULT 000;--
     VS_TRANSACTION_SEQUENCE VARCHAR(5);--
     VS_RECORD_SEQUENCE VARCHAR(3);--
    -- Client Variables
     VS_CIS_CLIENT_ID VARCHAR(10);      --  CARES_OUT_COL6

     VL_PARENT_ID INTEGER;--
     VL_NEW_PARENT_ID INTEGER;--
     VL_PARENT_EMPLOYMENT_ID INTEGER;--
     VD_CURR_EMPL_DATE DATE;--
  VS_SERVICE_CASEID   VARCHAR;--
  VS_ADOPTION_CASEID   VARCHAR;--
     CARES_OUT_PARENT_COL1 CHAR(1);--
     CARES_OUT_PARENT_COL2 VARCHAR(10);--
     CARES_OUT_PARENT_COL3 VARCHAR(20);--
     CARES_OUT_PARENT_COL4 VARCHAR(20);--
     CARES_OUT_PARENT_COL5 VARCHAR(10);--
     CARES_OUT_PARENT_COL6  CHAR(5);--
     CARES_OUT_PARENT_COL7  VARCHAR(20);--
     CARES_OUT_PARENT_COL8  INTEGER;--
     CARES_OUT_PARENT_COL9  INTEGER;--
     CARES_OUT_PARENT_COL10  CHAR(5);--
     CARES_OUT_PARENT_COL11  CHAR(15);--
     CARES_OUT_PARENT_COL12  CHAR(5);--
     VD_CLIENT_DOB DATE;--
     CARES_OUT_PARENT_COL13  INTEGER;--
     CARES_OUT_PARENT_COL14  VARCHAR(50);--
     CARES_OUT_PARENT_COL15  VARCHAR(20);--
     CARES_OUT_PARENT_COL16  VARCHAR(20);--
     CARES_OUT_PARENT_COL17  VARCHAR(10);--
     CARES_OUT_PARENT_COL18  CHAR(5);--
     CARES_OUT_PARENT_COL19 CHAR(3);--
     CARES_OUT_PARENT_COL20 VARCHAR(9); -- INTEGER
     CARES_OUT_PARENT_COL21 VARCHAR(50);--
     CARES_OUT_PARENT_COL22 CHAR(5);--
     CARES_OUT_PARENT_COL23 CHAR(3);--
     CARES_OUT_PARENT_COL24 CHAR(5);--
     CARES_OUT_PARENT_COL25 VARCHAR(50);--
     CARES_OUT_PARENT_COL26 CHAR(2);--
     CARES_OUT_PARENT_COL27 INTEGER;--
     CARES_OUT_PARENT_COL28 VARCHAR(10);--
     CARES_OUT_PARENT_COL29 INTEGER;--
     CARES_OUT_PARENT_COL30 CHAR(3);--
     CARES_OUT_PARENT_COL31 VARCHAR(9); -- INTEGER
     CARES_OUT_PARENT_COL32 VARCHAR(50);--
     CARES_OUT_PARENT_COL33 CHAR(5);--
     CARES_OUT_PARENT_COL34 CHAR(3);--
     CARES_OUT_PARENT_COL35 CHAR(5);--
     CARES_OUT_PARENT_COL36 VARCHAR(50);--
     CARES_OUT_PARENT_COL37 CHAR(2);--
     CARES_OUT_PARENT_COL38 INTEGER;--
     CARES_OUT_PARENT_COL39 VARCHAR(10);--
     CARES_OUT_PARENT_COL40 INTEGER;--

     CARES_OUT_PARENT_COL41 VARCHAR(50);--
     CARES_OUT_PARENT_COL42 CHAR(2);--

     CARES_OUT_PARENT_COL43 CHAR(4);--
     CARES_OUT_PARENT_COL44 CHAR(5);--
     CARES_OUT_PARENT_COL45 CHAR(5);--
     CARES_OUT_PARENT_COL46 INTEGER;--

     CARES_OUT_PARENT_COL47 CHAR(5);--
     CARES_OUT_PARENT_COL48 VARCHAR(20);--
     CARES_OUT_PARENT_COL49 CHAR(5);--
     CARES_OUT_PARENT_COL50 INTEGER;--
     CARES_OUT_PARENT_COL51 INTEGER;--

     CARES_OUT_PARENT_COL52 VARCHAR(50);--
     CARES_OUT_PARENT_COL53 VARCHAR(50);--
     CARES_OUT_PARENT_COL54 INTEGER;--
     CARES_OUT_PARENT_COL55 INTEGER;--

     CARES_OUT_PARENT_COL56 CHAR(3);--
     CARES_OUT_PARENT_COL57 VARCHAR(9); -- INTEGER
     CARES_OUT_PARENT_COL58 VARCHAR(50);--
     CARES_OUT_PARENT_COL59 CHAR(5);--
     CARES_OUT_PARENT_COL60 CHAR(3);--
     CARES_OUT_PARENT_COL61 CHAR(5);--
     CARES_OUT_PARENT_COL62 VARCHAR(50);--
     CARES_OUT_PARENT_COL63 CHAR(2);--
     CARES_OUT_PARENT_COL64 INTEGER;--

     CARES_OUT_PARENT_COL65 VARCHAR(10);--

     CARES_OUT_PARENT_COL66 VARCHAR(50);--
     CARES_OUT_PARENT_COL67 VARCHAR(50);--
     CARES_OUT_PARENT_COL68 INTEGER;--
     CARES_OUT_PARENT_COL69 INTEGER;--

     CARES_OUT_PARENT_COL70 CHAR(3);--
     CARES_OUT_PARENT_COL71 VARCHAR(9); -- INTEGER
     CARES_OUT_PARENT_COL72 VARCHAR(50);--
     CARES_OUT_PARENT_COL73 CHAR(5);--
     CARES_OUT_PARENT_COL74 CHAR(3);--
     CARES_OUT_PARENT_COL75 CHAR(5);--
     CARES_OUT_PARENT_COL76 VARCHAR(50);--
     CARES_OUT_PARENT_COL77 CHAR(2);--
     CARES_OUT_PARENT_COL78 INTEGER;--

     CARES_OUT_PARENT_COL79 VARCHAR(10);--

     CARES_OUT_PARENT_COL80 VARCHAR(50);--
     CARES_OUT_PARENT_COL81 VARCHAR(50);--
     CARES_OUT_PARENT_COL82 INTEGER;--
     CARES_OUT_PARENT_COL83 INTEGER;--

     CARES_OUT_PARENT_COL84 CHAR(3);--
     CARES_OUT_PARENT_COL85 VARCHAR(9); -- INTEGER
     CARES_OUT_PARENT_COL86 VARCHAR(50);--
     CARES_OUT_PARENT_COL87 CHAR(5);--
     CARES_OUT_PARENT_COL88 CHAR(3);--
     CARES_OUT_PARENT_COL89 CHAR(5);--
     CARES_OUT_PARENT_COL90 VARCHAR(50);--
     CARES_OUT_PARENT_COL91 CHAR(2);--
     CARES_OUT_PARENT_COL92 INTEGER;--

     CARES_OUT_PARENT_COL93 VARCHAR(10);--

     PARENT_INCOME_ID_1 INTEGER;--
     CARES_OUT_PARENT_COL94 CHAR(5);--
     PARENT_AMOUNT_NO_1 DECIMAL(10,2);--

     PARENT_INCOME_ID_2 INTEGER;--
     CARES_OUT_PARENT_COL95 CHAR(5);--
     PARENT_AMOUNT_NO_2 DECIMAL(10,2);--

     PARENT_INCOME_ID_3 INTEGER;--
     CARES_OUT_PARENT_COL96 CHAR(5);--
     PARENT_AMOUNT_NO_3 DECIMAL(10,2);--

     CARES_OUT_PARENT_COL97 INTEGER;--
     CARES_OUT_PARENT_COL98 DECIMAL(10,2);--

    DECLARE CURSOR_PARENT CURSOR FOR
          SELECT DISTINCT PPT.cjamspid
           FROM actorrelationship ACR, person PP, person PPT
           WHERE ACR.person1id = PP.personid
     AND   PPT.personid = ACR.person2id
    AND   PP.cjamspid =  VL_CLIENT_ID
           AND   ACR.relationshiptypekey IN ('3447','3449', 'BGCHLD')
           AND   ACR.activeflag = 1;--

   
BEGIN 
  -- SET transaction sequence
 
    VS_TRANSACTION_SEQUENCE := LTRIM(RTRIM((VL_TRANSACTION_SEQUENCE)::VARCHAR)) ;--
 
 VS_SERVICE_CASEID:= (SELECT servicecasenumber FROM SERVICECASE WHERE servicecasenumber = vl_other_id); --
 VS_ADOPTION_CASEID:= (SELECT adoptioncasenumber FROM ADOPTIONCASE WHERE adoptioncasenumber = vl_other_id); -- 

    -- Get CIS_CLIENT_ID
BEGIN 
  SELECT  person.cisclientid
   INTO    VS_CIS_CLIENT_ID
    FROM    person   
    WHERE   person.cjamspid = VL_CLIENT_ID
    AND     person.activeflag  = 1;--
 EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
     VS_MESSAGE  := 'SELECT CIS_CLIENT_ID FAILED FOR person '||SQLERRM  ;--
       
    RETURN;
    END ;--

    -- Generate records for record type 55
     VS_RECORD_TYPE := '55';--
     VL_RECORD_SEQUENCE := 000 ;--
     VS_RECORD_SEQUENCE := '';--

    IF  VS_RECORD_TYPE = '55' THEN

         IF VS_TRANSACTION_TYPE_CD IN ('10','15','20','30','40','62','64','70') THEN       -- #12329
             CARES_OUT_PARENT_COL1 := 'X';--
         ELSIF VS_TRANSACTION_TYPE_CD IN ('50') THEN
             CARES_OUT_PARENT_COL1 := 'N';--
         ELSIF VS_TRANSACTION_TYPE_CD IN ('60')  THEN
             CARES_OUT_PARENT_COL1 := 'E';--
         END IF ;--

         OPEN CURSOR_PARENT;--
         <<CURS_PARENT>>
        LOOP
            FETCH CURSOR_PARENT INTO VL_PARENT_ID ;--
                  EXIT CURS_PARENT WHEN NOT FOUND;
 
      VL_RECORD_SEQUENCE := VL_RECORD_SEQUENCE + 1 ;--
      VS_RECORD_SEQUENCE := LTRIM(RTRIM((VL_RECORD_SEQUENCE::VARCHAR)));--
 
            IF VS_TRANSACTION_TYPE_CD IN ('10','15','20','30','40','62','64','70') THEN               -- #12329
               CARES_OUT_PARENT_COL1 := 'X';--
            ELSIF VS_TRANSACTION_TYPE_CD IN ('50') THEN
           
        BEGIN
     SELECT PPT.cjamspid
             INTO VL_NEW_PARENT_ID
              FROM actorrelationship ACR, Person PP, person PPT, intakeservicerequest ISR, servicecase SC, adoptioncase AC
     WHERE ACR.intakeserviceid = ISR.intakeserviceid
     AND ACR.person1id = PP.personid
     AND ACR.person2id = PPT.personid
     AND ISR.servicecaseid = SC.servicecaseid
     AND SC.servicecaseid = AC.servicecaseid
     AND (SC.servicecasenumber =  VS_SERVICE_CASEID OR AC.adoptioncasenumber = VS_ADOPTION_CASEID ); --
EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
     VS_MESSAGE  := 'SELECT  FAILED FOR NEW PARENT FOR actorrelationship' ||SQLERRM  ;--
       
    RETURN;
    END ;--
      

              IF VL_NEW_PARENT_ID = VL_PARENT_ID THEN
                 CARES_OUT_PARENT_COL1 := 'N';--
              ELSE
                 CARES_OUT_PARENT_COL1 := 'X';--
              END IF;--
            ELSIF VS_TRANSACTION_TYPE_CD IN ('60')  THEN
              IF VL_OTHER_ID = VL_PARENT_ID THEN
                 CARES_OUT_PARENT_COL1 := 'E';--
              ELSE
                 CARES_OUT_PARENT_COL1 := 'X';--
              END IF;--
            END IF ;  --
 BEGIN
      SELECT  person.cisclientid,
         COALESCE(person.lastname,''),
         COALESCE(person.firstname,''),
         COALESCE(person.middlename,''),
         SUBSTRING(person.suffix,1,5),
         (alias.ssn)::INTEGER,
   to_char(person.dob,'yyyymmdd')::INTEGER,
         racetypekey
     INTO CARES_OUT_PARENT_COL2,
          CARES_OUT_PARENT_COL3,
          CARES_OUT_PARENT_COL4,
          CARES_OUT_PARENT_COL5,
          CARES_OUT_PARENT_COL6,
          CARES_OUT_PARENT_COL8,
          CARES_OUT_PARENT_COL9,
          CARES_OUT_PARENT_COL10
     FROM person
  LEFT OUTER JOIN alias ON person.personid = alias.personid AND alias.activeflag = 1
     WHERE  person.cjamspid = VL_PARENT_ID
     AND person.activeflag =  1;--
 EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
     VS_MESSAGE  := 'SELECT  FAILED FOR PARENT FOR person '||SQLERRM  ;--
       
    RETURN;
    END ;--
    
         ---Gayathri Rajkumar Mapped Declined race to Unknown
         IF LTRIM(RTRIM(CARES_OUT_PARENT_COL10))   = '3004' THEN
             CARES_OUT_PARENT_COL10 := '2008-9' ;--
    ELSIF LTRIM(RTRIM(CARES_OUT_PARENT_COL10)) = 'DC' THEN
    CARES_OUT_PARENT_COL10 := 'UN';--
         END IF;--
 BEGIN
     SELECT *
     INTO  CARES_OUT_PARENT_COL7
     FROM
     (SELECT COALESCE(alias.lastname,'')
     FROM  alias, person
     WHERE alias.personid = person.personid
    AND  person.cjamspid =  VL_PARENT_ID
     AND alias.activeflag = 1
     AND alias.akatypetypekey = '2553'
     ORDER BY alias.insertedon DESC , alias.akaid DESC) AS A
     limit 1 ;--
 EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
      VS_MESSAGE  := 'SELECT PARENT AKA FAILED FOR alias '||SQLERRM  ;--
      
    RETURN;
    END ;--
   
 BEGIN
     SELECT *
     INTO CARES_OUT_PARENT_COL11
     FROM 
     (SELECT CASE WHEN  ACR.relationshiptypekey = 'mother' THEN '1974'
           WHEN  ACR.relationshiptypekey = 'father' THEN '1910'
     WHEN  ACR.relationshiptypekey = 'grandparent' THEN '1974'
   -- CASE WHEN ACR.relationshiptypekey like 'BGCHLD' THEN '1974'
     WHEN  ACR.relationshiptypekey = 'brother' THEN '8045'
     WHEN  ACR.relationshiptypekey = 'sister' THEN '8046'
     WHEN  ACR.relationshiptypekey = 'BIOBR' THEN '8045'
   -- CASE WHEN ACR.relationshiptypekey like 'STPBR' THEN '1974'
   -- CASE WHEN ACR.relationshiptypekey like 'STPFTHR' THEN '1974'
   -- CASE WHEN ACR.relationshiptypekey like 'STMTHR' THEN '1974'
     WHEN  ACR.relationshiptypekey = 'BGFTHR' THEN '1974'
     WHEN  ACR.relationshiptypekey = 'BGMTHR' THEN '1910'
     WHEN  ACR.relationshiptypekey = 'BGSISTR' THEN '8046'
     WHEN  ACR.relationshiptypekey = '' THEN '    '
    ELSE ACR.relationshiptypekey
    END
    FROM actorrelationship ACR, person PP, person PPT
                WHERE ACR.person1id = PP.personid
    AND PP.cjamspid = VL_PARENT_ID 
    AND ACR.person2id = PPT.personid 
    AND PPT.cjamspid = VL_CLIENT_ID
                AND ACR.activeflag = 1
    AND PP.activeflag = 1
    AND PPT.activeflag = 1
                ORDER BY ACR.startdate DESC) AS A
                limit 1 ;--
 EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
      VS_MESSAGE  := 'SELECT RELATIONSHIP TYPE CD FAILED FOR actorrelationship '||SQLERRM  ;--
      
    RETURN;
    END ;--     
         --
 BEGIN
    SELECT dob
     INTO VD_CLIENT_DOB
     FROM    person   
     WHERE  person.cjamspid =  VL_CLIENT_ID
   AND person.activeflag = 1;--
  
  EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
      VS_MESSAGE  := 'SELECT DOB_DT FAILED FOR person '||SQLERRM  ;--
      
    RETURN;
    END ;-- 
 
   
 
     IF VD_CLIENT_DOB IS NULL THEN
          CARES_OUT_PARENT_COL12 := '' ;--
     ELSE
     BEGIN  
    SELECT *
         INTO CARES_OUT_PARENT_COL12
         FROM
         (SELECT  CASE WHEN CMS.statustypekey = 'DV' THEN '1568'
          WHEN CMS.statustypekey = 'MR' THEN '1569' 
       WHEN CMS.statustypekey = 'LS' THEN '1570' 
       WHEN CMS.statustypekey = 'SG' THEN '1571' 
       WHEN CMS.statustypekey = 'WD' THEN '3673' 
       WHEN CMS.statustypekey = 'UK' THEN '7791' 
       ELSE CMS.statustypekey
       END
                FROM personmaritalstatus CMS, person p
                WHERE  CMS.startdate <= VD_CLIENT_DOB
                AND (CMS.enddate IS NULL  OR
                        CMS.enddate >=  VD_CLIENT_DOB)
    AND CMS.personid = P.personid   
                AND P.cjamspid  = VL_PARENT_ID
                AND CMS.activeflag = 1
                ORDER BY CMS.startdate DESC) AS A
                limit 1 ;--
    
    EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT MARITAL STATUS FAILED FOR personmaritalstatus '||SQLERRM  ;--
                
              RETURN;
                  END ;--   
         
     END IF;--
 BEGIN
     SELECT *
            INTO CARES_OUT_PARENT_COL13,
                 CARES_OUT_PARENT_COL14
            FROM
     (SELECT to_char(startdate,'yyyymmdd')::INTEGER,
                MARRIAGEPLACE
                FROM personmaritalstatus CMS, person p
                WHERE CMS.personid = p.personid
    AND P.cjamspid = VL_PARENT_ID
                AND CMS.statustypekey IN ('1569', 'MR')
                AND CMS.activeflag = 1
                ORDER BY CMS.startdate DESC,  CMS.old_id DESC) AS A
                limit 1 ;--
   
   EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT MARRIAGE INFO FOR PARENT FAILED FOR personmaritalstatus '||SQLERRM  ;--
                
              RETURN;
                  END ;--  
    
 BEGIN
     SELECT *
         INTO CARES_OUT_PARENT_COL15,
              CARES_OUT_PARENT_COL16,
              CARES_OUT_PARENT_COL17,
              CARES_OUT_PARENT_COL18    
     FROM
     (SELECT alias.lastname, alias.firstname, alias.middlename, SUBSTRING(person.suffix,1,5)
         FROM alias, person
         WHERE alias.personid = person.personid
   AND person.cjamspid = VL_PARENT_ID
         AND alias.activeflag = 1
         ORDER BY alias.insertedon DESC  --, alias.akaid DESC  ---- check with HADI
   ) AS A
         limit 1 ;--
 
 EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT CLIENT AKA FOR PARENT FAILED FOR TB_CLIENT_AKA '||SQLERRM  ;--
                
              RETURN;
                  END ;-- 
    
 BEGIN
     SELECT *
                INTO CARES_OUT_PARENT_COL19,
                     CARES_OUT_PARENT_COL20,
                     CARES_OUT_PARENT_COL21,
                     CARES_OUT_PARENT_COL22,
                     CARES_OUT_PARENT_COL23,
                     CARES_OUT_PARENT_COL24,
                     CARES_OUT_PARENT_COL25,
                     CARES_OUT_PARENT_COL26,
                     CARES_OUT_PARENT_COL27,
                     CARES_OUT_PARENT_COL29
            FROM
     (SELECT SUBSTRING(F_PLVALUE(personaddress.adrpredirtypekey,69),1,3),
           SUBSTRING(personaddress.address,'(^[0-9]+)'), -- personaddress.ADR_STREET_NO
           TRIM(SUBSTRING(personaddress.address,'([[:alpha:]\\s]+)')),
           personaddress.adrstreetsuffixtypekey,
           SUBSTRING(F_PLVALUE(personaddress.adrpostdirtypekey,69),1,3),
           personaddress.adrunitno,
           personaddress.city,
           personaddress.state,
           (SUBSTRING(COALESCE((personaddress.zipcode::VARCHAR),'00000'),1,5) || SUBSTRING(COALESCE((personaddress.adrzip4no::VARCHAR),'0000'),1,4))::INTEGER,
                  TO_CHAR(personaddress.personadrstartdate,'yyyymmdd')::INTEGER
             FROM  personaddress
                WHERE personaddress.old_id::INTEGER = VL_PARENT_ID
                AND   personaddress.personadrstartdate IS NOT NULL
                AND   personaddress.personadrenddate IS NULL
                AND   personaddress.activeflag = 1
                ORDER BY personadrstartdate DESC, old_id DESC) AS A
                limit 1 ;--
 
        EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT CLIENT CURRENT ADDRESS FOR PARENT FAILED FOR TB_CLIENT_ADDRESSES '||SQLERRM  ;--
                
              RETURN;
                  END ;-- 

 
 BEGIN           --
        
     SELECT *
     INTO  CARES_OUT_PARENT_COL28
     FROM
     (SELECT SUBSTRING(personphonenumber.personphonetypekey,1,10) 
     FROM personphonenumber, person 
     WHERE  personphonenumber.personid =  person.personid
  AND person.cjamspid = VL_PARENT_ID 
 AND personphonenumber.personphonetypekey IN ('1663','1664','1667','1672', 'S', 'P', 'O')
     AND personphonenumber.effectivedate IS NOT NULL
     AND personphonenumber.expirationdate IS NULL
     AND personphonenumber.activeflag = 1
     ORDER BY personphonenumber.effectivedate DESC , personphonenumber.old_id DESC) AS A
     limit 1 ;--
 
 EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT CLIENT CURRENT CONTACT INFO FOR PARENT FAILED FOR personphonenumber '||SQLERRM  ;--
                
              RETURN;
                  END ;-- 
        
 BEGIN
     SELECT *
                INTO CARES_OUT_PARENT_COL30,
                     CARES_OUT_PARENT_COL31,
                     CARES_OUT_PARENT_COL32,
                     CARES_OUT_PARENT_COL33,
                     CARES_OUT_PARENT_COL34,
                     CARES_OUT_PARENT_COL35,
                     CARES_OUT_PARENT_COL36,
                     CARES_OUT_PARENT_COL37,
                     CARES_OUT_PARENT_COL38,
                     CARES_OUT_PARENT_COL40
            FROM
     (SELECT SUBSTRING(F_PLVALUE(personaddress.adrpredirtypekey,69),1,3),
           SUBSTRING(personaddress.address,'(^[0-9]+)'), -- personaddress.ADR_STREET_NO
           TRIM(SUBSTRING(personaddress.address,'([[:alpha:]\\s]+)')),
           personaddress.adrstreetsuffixtypekey,
           SUBSTRING(F_PLVALUE(personaddress.adrpostdirtypekey,69),1,3),
           personaddress.adrunitno,
           personaddress.city,
           personaddress.state,
           (SUBSTRING(COALESCE((personaddress.zipcode::VARCHAR),'00000'),1,5) || SUBSTRING(COALESCE((personaddress.adrzip4no::VARCHAR),'0000'),1,4))::INTEGER,
                  TO_CHAR(personaddress.personadrstartdate,'yyyymmdd')::INTEGER
             FROM  personaddress
                WHERE personaddress.old_id::INTEGER = VL_PARENT_ID
                AND   personaddress.personadrstartdate IS NOT NULL
                AND   personaddress.personadrenddate IS NOT NULL
                AND   personaddress.activeflag = 1
                ORDER BY personadrstartdate DESC, old_id DESC) AS A
                limit 1 ;--
     EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT CLIENT PREVIOUS ADDRESS FOR PARENT FAILED FOR personaddress '||SQLERRM  ;--
                
              RETURN;
                  END ;--      

 BEGIN       
     SELECT *
     INTO  CARES_OUT_PARENT_COL39
     FROM  
     (SELECT SUBSTRING(personphonenumber.personphonetypekey,1,10) 
     FROM personphonenumber, person 
     WHERE  personphonenumber.personid =  person.personid
  AND person.cjamspid = VL_PARENT_ID 
 AND personphonenumber.personphonetypekey IN ('1663','1664','1667','1672', 'S', 'P', 'O')
     AND personphonenumber.effectivedate IS NOT NULL
     AND personphonenumber.expirationdate IS NOT NULL
     AND personphonenumber.activeflag = 1
     ORDER BY personphonenumber.effectivedate DESC , personphonenumber.old_id DESC) AS A
     limit 1 ;--
        
  EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT CLIENT PREVIOUS CONTACT INFO FOR PARENT FAILED FOR personphonenumber '||SQLERRM  ;--
                
              RETURN;
                  END ;--

  
 BEGIN
     SELECT *
     INTO CARES_OUT_PARENT_COL41,
          CARES_OUT_PARENT_COL42
     FROM
     (SELECT clientunder5yearsinfo.cityname,
            clientunder5yearsinfo.statetypekey
     FROM clientunder5yearsinfo, person
     WHERE clientunder5yearsinfo.personid = person.personid
     and person.cjamspid = VL_PARENT_ID
     AND clientunder5yearsinfo.activeflag = 1
     ORDER BY clientunder5yearsinfo.insertedon DESC) AS A
     limit 1 ;--

    EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT CLIENT DETAILS FOR PARENT FAILED FOR TB_CLIENT_MEDICAL_INFO '||SQLERRM  ;--
                
              RETURN;
     END ;--

    
     BEGIN        
     SELECT PPA.attributevalue,
           PP.haircolortypekey,
           PP.eyecolortypekey,
           PPB.attributevalue
     INTO   CARES_OUT_PARENT_COL43,
            CARES_OUT_PARENT_COL44,
            CARES_OUT_PARENT_COL45,
            CARES_OUT_PARENT_COL46
     FROM personphysicalattribute PPA, personphysicalattribute PPB, person PP
     WHERE PP.personid = PPA.personid
  AND PP.personid = PPB.personid
  AND PP.cjamspid = VL_PARENT_ID
  AND PPA.physicalattributetypekey = 'Ht'
  AND PPB.physicalattributetypekey =  'Wt'
     AND PP.activeflag = 1 
  AND PPA.activeflag = 1
  AND PPB.activeflag = 1;--
 
 EXCEPTION WHEN OTHERS THEN
                VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
                VS_MESSAGE  := 'SELECT PARENT DETAILS FOR PARENT FAILED FOR TB_CLIENT '||SQLERRM  ;--
                
              RETURN;
     END ;--
 
    
 BEGIN
     SELECT *
     INTO    CARES_OUT_PARENT_COL47,
             CARES_OUT_PARENT_COL48,
             CARES_OUT_PARENT_COL49,
             CARES_OUT_PARENT_COL50,
             CARES_OUT_PARENT_COL51
