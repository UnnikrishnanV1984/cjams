CREATE OR REPLACE FUNCTION as_guardianshippersonadd(v_intakeserviceid uuid, v_newintakeserviceid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 


v_person RECORD;
v_relationship RECORD;

BEGIN  

   INSERT INTO actor(
        intakeserviceid,
        personid,
        actortype,
        dangerlevel,
        dangerreason,
        insertedby,
        insertedon,                
        updatedby,                
        updatedon, 
        activeflag)
         
   SELECT   v_newintakeserviceid, 
      personid,
      actortype,
      dangerlevel,
      dangerreason,
      v_securityusersid,
      now(),
      v_securityusersid,
      now(),
      1 
   FROM actor 
   WHERE activeflag =1
   AND intakeserviceid = v_intakeserviceid;
  
 for v_person in
 
  SELECT * FROM actor WHERE activeflag =1 
  AND intakeserviceid =v_newintakeserviceid
 
  LOOP 
            INSERT INTO intakeservicerequestactor (
            actorid ,
            intakeservicerequestpersontypekey,
            intakeserviceid,        
                                                ramentalhealth ,
            ramentalretarted,      
                                                reported,
            isprimary,
            personid,
                                                fetalalcoholspctrmdisordflag, 
                                                drugexposednewbornflag, 
                                                probationsearchconductedflag,  
                                                sexoffenderregisteredflag,
            insertedby,
            insertedon,                
                                                updatedby,                
            updatedon, 
            activeflag            
            )
            
   SELECT v_person.actorid, 
          pa.intakeservicerequestpersontypekey,
       v_newintakeserviceid,
       pa.ramentalhealth ,
       pa.ramentalretarted,      
       pa.reported,
       pa.isprimary,
       v_person.personid,
       pa.fetalalcoholspctrmdisordflag, 
       pa.drugexposednewbornflag, 
       pa.probationsearchconductedflag,  
       pa.sexoffenderregisteredflag,
       v_securityusersid,
       now(),
       v_securityusersid,
       now(),
       1
      FROM   intakeservicerequestactor pa 
      WHERE pa.intakeserviceid =v_intakeserviceid AND pa.activeflag =1
      and pa.personid =v_person.personid ;
 end loop;    
     
   for v_relationship in 
   
   
   SELECT * FROM intakeservicerequestactor WHERE activeflag =1 
   AND intakeserviceid =v_newintakeserviceid
   
   LOOP
   INSERT    INTO    actorrelationship(              
            relationshiptypekey,
            intakeservicerequestactorid,
            effectivedate,
            insertedby, 
            insertedon,  
            updatedby, 
            updatedon,
                                                activeflag,
                                                intakeserviceid
                                                )
   SELECT    acr.relationshiptypekey,
      v_relationship.intakeservicerequestactorid,
      now(),
       v_securityusersid,
      now(),
      v_securityusersid,
      now(),
      1,
      v_newintakeserviceid
   FROM  actorrelationship  acr
   inner  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = acr.intakeservicerequestactorid
   WHERE acr.intakeserviceid =v_intakeserviceid
   AND acr.activeflag =1 
   and isra.personid =v_relationship.personid ;
    
   end loop;
   RETURN 'Successfull';
end;

$function$

