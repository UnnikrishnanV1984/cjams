   BEGIN   
    --#151
    SELECT -- SE.STATUS_CD
     (case when SE.STATUS_CD = '2276' then '1' -- A - No Disabilities
      when SE.STATUS_CD = '2277' then '4' -- B - Receiving SSI, State is Rep Payee
      when SE.STATUS_CD = '2278' then '4' -- C - Receiving SSI, State is Not Rep Payee
      when SE.STATUS_CD = '2279' then '3' -- D - Eligible, Not Receiv SSI Due to Receipt of IVE
      when SE.STATUS_CD = '2280' then '2' -- Denied SSA
      when SE.STATUS_CD = '2281' then '3' -- E - Eligible,Not Receiving SSI Due to Other Reason
      when SE.STATUS_CD = '2282' then '1' -- F - SSI Not Applied For, LDSS Action Needed
      when SE.STATUS_CD = '2283' then '1' -- G - SSI Not App For, Disabil Lev Insuff/Inaccurate
      when SE.STATUS_CD = '2284' then '1' -- H - SSI Not Applied For, Child's Income Over Scale
      when SE.STATUS_CD = '2285' then '1' -- I - SSI Not Applied For, Child Receives IV-E
      when SE.STATUS_CD = '2286' then '4' -- Receiving SSA
      when SE.STATUS_CD = '10540' then '1' -- J - SSI Applied For, Social Security Decision Pend
      when SE.STATUS_CD = '10541' then '2' -- K - Denied
      when SE.STATUS_CD = '10542' then '2' -- L - Appeal Filed
     end) 
     INTO VS_SSI_CODE
    FROM TB_SSI_ELIGIBILITY_EVENTS SE,
     TB_CLIENT_ELIGIBILITY CE
    WHERE SE.ELIGIBILITY_ID = CE.ELIGIBILITY_ID
     AND CE.CLIENT_ID = VL_CLIENT_ID
     AND SE.DELETE_SW = 'N'
     AND CE.DELETE_SW = 'N'
    ORDER BY SE.START_DT DESC
    limit 1   ;
    
    EXCEPTION WHEN OTHERS THEN
     VS_OUTPUT_STATE := SQLSTATE;
     VL_OUTPUT_SQLCODE :=SQLERRM;
     VS_MESSAGE := 'SQLSTATE:' || VS_OUTPUT_STATE || '. SELECT  FAILED FOR SSI_CODE#151 FOR -->'|| CAST(VL_CLIENT_ID AS VARCHAR) ;
     VL_EXCEP_FLAG := 1;
     VL_EXCEP_MESSAGE := VL_EXCEP_MESSAGE || 'C151N'||CAST(VL_OUTPUT_SQLCODE AS VARCHAR)||'T'|| VS_OUTPUT_STATE ;

   END;
   
