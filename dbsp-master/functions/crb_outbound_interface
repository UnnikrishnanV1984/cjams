     -- VDT_PLCMT_DATE := to_char(to_date(VDT_PLCMT_DATE,'yyyy-mm-dd'), 'mmddyyyy');
     VDT_PLCMT_DATE := to_char(to_date(VDT_PLCMT_DATE,'yyyy-mm-dd'), 'mmddyy');
