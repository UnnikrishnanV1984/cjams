       WHERE icr.intakeservicerequestactorid = isa.intakeservicerequestactorid
        and pga.personid = isa.personid
        and pga.cjamspid = VL_CLIENT_ID
        AND icr.activeflag = 1
       )
    join crbreferencevalues CRBV on crbv.cjamscode = pl.exitreasontypekey 
     and crbv.referencetype = 'exitreasontypekey'
    JOIN serviceCASE sc on icr.serviceCASEid=sc.serviceCASEid 
     AND icr.activeflag=1 
     AND sc.activeflag=1 
    JOIN intakeservicerequestactor isra on isra.intakeservicerequestactorid=icr.intakeservicerequestactorid 
     AND isra.activeflag=1
    JOIN person p on p.personid = isra.personid 
     AND p.activeflag=1 
     and p.cjamspid = VL_CLIENT_ID 
     and p.activeflag = 1
    order by pl.enddatetime desc limit 1 ;

