MAIN_CUR CURSOR FOR
 SELECT distinct TC.cjamspid, 
  SC.servicecasenumber,
  -- CAST(PGM.startdate AS VARCHAR(10)), 
  PGM.startdate::date,
  -- CAST(PGM.enddate AS VARCHAR(10)),
  PGM.enddate::date,
  case when PGM.programkey = 'OOH' then 2 end, 
  -- PGM.clientmergeid
  PGM.alternateid,
  PGM.insertedon::date as pgm_createdate 
 FROM personprogramarea PGM
  INNER JOIN person TC ON TC.personid = PGM.personid 
   AND TC.activeflag = 1 
   AND COALESCE(TC.firstname,'') <> '' 
   AND COALESCE(TC.lastname,'') <> '' 
   AND COALESCE(TC.gendertypekey,'') <> ''
 -- INNER JOIN actor CC ON CC.personid = PGM.personid 
 --  AND actortype = 'CHILD'  
  INNER JOIN servicecase SC ON SC.servicecaseid = PGM.objectid::UUID 
 --  AND SC.startdate IS NOT NULL
   AND SC.activeflag = 1
  inner join intakeservicerequestactor isr on isr.servicecaseid = sc.servicecaseid
   and isr.personid = pgm.personid
   and isr.intakeservicerequestpersontypekey in ('BIOCHILD','OTHERCHILD','AV', 'CHILD')
   and isr.activeflag = 1  
 WHERE PGM.startdate IS NOT NULL
  AND PGM.programkey = 'OOH' 
 -- AND PGM.objecttypekey = 'servicecase'
  AND PGM.activeflag = 1
 -- AND CC.activeflag = 1
 -- AND SC.activeflag = 1
 -- AND TC.activeflag = 1
 -- Vineet for pre-test in Fin-batch
 --  and tc.cjamspid in (200799719, 200799808, 200806863)
 -- and tc.cjamspid = 3463999
 and ( PGM.enddate is null
   or 
    ( PGM.enddate is not null and PGM.updatedon >= v_last_batchrun_ts) -- current_date - 1 ) 
  )  
 ORDER BY TC.cjamspid,
  PGM.startdate::date desc,
  -- CAST(PGM.startdate AS VARCHAR(10)),           
  -- SC.servicecasenumber,
  -- CAST(PGM.enddate AS VARCHAR(10)),
  -- case when PGM.programkey = 'OOH' then 2 end,
  -- PGM.clientmergeid  
  PGM.alternateid DESC;

-- 128  REMOVAL CURSOR
-- Picklist ID: 27 Caregiver Factors at Entry 
/*
RLQ - 278   Relinquishment for Adoption (incl. Safe Haven)
AAP - 279   Alcohol Abuse (Parent)
CIIO - 280  Caregiver's Inability to Cope Due to Illness or Other Reason
DP - 281 Death of Parent(s)
DAP - 282 Drug Abuse (Parent)
IP - 283 Incarceration of Parent(s)
?? - 284 No Caregivers
*/
REMOVAL_CUR CURSOR FOR
 SELECT (case when btrim(ISCR.removalreasontypekey) = 'RLQ' then 'R' --Relinquishment
   when btrim(ISCR.removalreasontypekey) = 'AAP' then 'A' -- Alcohol Abuse
   when btrim(ISCR.removalreasontypekey) = 'CIIO' then 'P' -- Caregivers Inability to Cope due to Illness 
   when btrim(ISCR.removalreasontypekey) = 'DP' then 'Z' -- Death of Parent 
   when btrim(ISCR.removalreasontypekey) = 'DAP' then 'D' -- Drug Abuse
   when btrim(ISCR.removalreasontypekey) = 'IP' then 'I' -- Incarceration of Parent 
   end)
   -- CRBV.chessiecode
  FROM intakeservreqchildremoval icr, 
   person pp, 
  -- intakeservicerequestactor isa, 
   servicecase SC, 
   intakeservreqchildremovalreason ISCR 
  -- crbreferencevalues CRBV
 WHERE icr.servicecaseid = SC.servicecaseid 
  and icr.personid = pp.personid
 -- and isa.servicecaseid = SC.servicecaseid 
 -- and isa.personid = pp.personid
  and ISCR.intakeservreqchildremovalid = icr.intakeservreqchildremovalid
 -- and ISCR.removalreasontypekey IN ('AAP', 'DAP', 'DAC', 'AAC', 'DP', 'IP', 'CIIO', 'RLQ')
  and ISCR.removalreasontypekey IN ('RLQ', 'AAP', 'CIIO', 'DP', 'DAP', 'IP')
 --  and icr.removaltypekey = CRBV.cjamscode
 -- and btrim(ISCR.removalreasontypekey) = btrim(CRBV.cjamscode)
 -- and CRBV.referencetype = 'removaltype'
 -- and CRBV.referencetype = 'removalreasontype'
  AND icr.returndate IS null
  AND icr.activeflag = 1
  and pp.cjamspid = VL_CLIENT_ID
  and SC.servicecasenumber =  VL_CASE_ID;

   
--168 CHILD_FACTOR_CURSOR
-- Picklist ID: 44 Child Factors at Entry 
/*
PA - 4330 Physical abuse 
SA - 4331 Sexual Abuse
HG - 4332 Neglect
AAC - 4333 Alcohol Abuse (Child)
DAC - 4334 Drug Abuse (Child)
CD - 4335 Child’s Disabilities
CBP - 4336 Child’s Behavior Problem
ADT - 4337 Abandonment
IDH - 4338 Inadequate Housing
*/
CHILD_FACTOR_CUR  CURSOR FOR
 SELECT (case when btrim(ISCR.removalreasontypekey) = 'PA' then '0' -- Physical abuse 
   when btrim(ISCR.removalreasontypekey) = 'SA' then '1' -- Sexual Abuse
   when btrim(ISCR.removalreasontypekey) = 'HG' then '2' -- Neglect
   when btrim(ISCR.removalreasontypekey) = 'AAC' then '3' -- Alcohol Abuse (Child)
   when btrim(ISCR.removalreasontypekey) = 'DAC' then '4' -- Drug Abuse
   when btrim(ISCR.removalreasontypekey) = 'CD' then '5' -- Child's Disabilities
   when btrim(ISCR.removalreasontypekey) = 'CBP' then '6' -- Child's Behavior Problem  
   when btrim(ISCR.removalreasontypekey) = 'ADT' then '7' -- Abandonment
   when btrim(ISCR.removalreasontypekey) = 'IDH' then '8'-- Inadequate Housing 
   end)
  -- DISTINCT CRBV.chessiecode
  from intakeservreqchildremoval icr, 
   person pp, 
  -- intakeservicerequestactor isa,
   servicecase SC, 
   intakeservreqchildremovalreason ISCR
  -- crbreferencevalues CRBV
 WHERE icr.servicecaseid = SC.servicecaseid
  and icr.personid = pp.personid
 -- and isa.servicecaseid = SC.servicecaseid
 -- and isa.personid = pp.personid
  and ISCR.intakeservreqchildremovalid = icr.intakeservreqchildremovalid
 --  and ISCR.removalreasontypekey IN ('ADT', 'DAP', 'CD', 'AAC', 'CBP', 'SA', 'HG', 'AAC', 'DAC', 'AAP', 'PA',  'IDH')
  and ISCR.removalreasontypekey IN ( 'PA', 'SA', 'HG', 'AAC', 'DAC', 'CD', 'CBP', 'ADT', 'IDH' )
 -- and btrim(ISCR.removalreasontypekey) = btrim(CRBV.cjamscode)
 -- and CRBV.referencetype = 'removalreasontype'
  AND icr.returndate IS null
  AND icr.activeflag = 1
  and pp.cjamspid = VL_CLIENT_ID
  and SC.servicecasenumber =  VL_CASE_ID; 
 
-- EMPTY INTERFACECRBOUTBOUND
BEGIN
 RAISE NOTICE 'Start Time % ', now() ;
 vl_output_sqlcode:='';
 VL_EXCEP_FLAG  := 0;
 VL_EXCEP_MESSAGE := '';
 CRB_CNT := (SELECT CAST(COUNT(*) AS INTEGER) FROM INTERFACECRBOUTBOUND);
 
 IF CRB_CNT > 0 THEN
  BEGIN
   DELETE FROM INTERFACECRBOUTBOUND;
   
  EXCEPTION WHEN OTHERS THEN
   VS_OUTPUT_STATE := SQLSTATE;
   VL_OUTPUT_SQLCODE :=SQLERRM;
   VS_MESSAGE := 'DELETE FAILED FROM INTERFACECRBOUTBOUND';    
   VL_EXCEP_FLAG := 1;

