    AND (VOID_SW = 'N' OR VOID_SW IS NULL)
    AND CONVERSION_SW IS NULL
    AND APPROVAL_STATUS_CD= '3047') ;    */

         
    SELECT  pl.startdatetime :: VARCHAR(10),
     pl.enddatetime ::VARCHAR(10),
     -- RTRIM(pl.service_id::VARCHAR),
     (case when pl.service_id = 1 then '35' -- Semi Independent Living Arrangement
      when pl.service_id = 8 then '03' -- Formal Kinship Care
      when pl.service_id = 9 then '02' -- Restricted (Relative) Foster Care
      when pl.service_id = 10 then '11' -- Regular Foster Care
      when pl.service_id = 11 then '11' -- Intermediate Foster Care
      when pl.service_id = 12 then '05' -- Treatment Foster Care
      when pl.service_id = 13 then '06' -- Emergency Foster Home Care
      when pl.service_id = 14 then '33' -- Residential Group Homes
      when pl.service_id = 15 then '32' -- Emergency Group Shelter Care
      when pl.service_id = 73 then '99' -- CHAFEE After care room and board
      when pl.service_id = 74 then '36' -- Alternative Living Units
      when pl.service_id = 75 then '33' -- Teen Mother Programs
      when pl.service_id = 76 then '33' -- Residential Treatment Centers
      when pl.service_id = 77 then '99' -- Refugee Child
      when pl.service_id = 167 then '38' -- Therapeutic Group Homes
      when pl.service_id = 500 then '11' -- Pre-Finalized Adoptive Home with Subsidy
      when pl.service_id = 501 then '26' -- Adoptive Home with Subsidy
      when pl.service_id = 503 then '14'  -- Subsidized Guardianship
      when pl.service_id = 78 then '13' -- Treatment Foster Care (Private)
     end),
     pl.altproviderid,
     pl.fiscalcategorytypekey
    INTO
     VDT_LA_BEG_DATE,
     VDT_LA_CAN_DATE,
     VS_LA_TYPE,
     VL_PROVIDER_ID,
     VS_FUND_SOURCE
    FROM PLACEMENT pl
    JOIN servicecase sc ON sc.servicecaseid = pl.servicecaseid 
     AND sc.activeflag = 1
    JOIN person pr ON pr.personid = pl.personid 
     AND pr.activeflag = 1
    JOIN routing rt on rt.objectid::character varying = pl.placementid::character varying
     and rt.routingstatustypeid = 16 
     AND rt.eventcode::character varying = 'PLTR'::character varying 
     AND rt.activeflag = 1
    WHERE  pr.cjamspid  = VL_CLIENT_ID
     AND sc.servicecasenumber::bigint = VL_CASE_ID::bigint
     AND pl.activeflag = 1
     AND pl.startdatetime IS NOT NULL
     AND pl.startdatetime >= VDT_START_DT:: DATE
     --  AND EXIT_DT IS NULL
     AND ((CASE COALESCE(pl.isvoided, 0)  WHEN 1 THEN 'Y'::text  ELSE NULL::text END::character) = 'N' 
     OR 
     (CASE COALESCE(pl.isvoided, 0) WHEN 1 THEN 'Y'::text ELSE NULL::text END::character) IS NULL)
     -- AND CONVERSION_SW IS NULL
     AND pl.alternateid 
      IN  (SELECT MAX(pl.alternateid) 
