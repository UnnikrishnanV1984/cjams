   BEGIN
    --#76
    /* SELECT RTRIM(COUNT(*)::VARCHAR)
    INTO VS_APPROVE_CURR
    FROM TB_PLACEMENT
    WHERE ENTRY_DT IS NOT NULL
    AND (VOID_SW = 'N' OR VOID_SW IS NULL)
    AND DELETE_SW = 'N'
    AND APPROVAL_STATUS_CD = '3047'
    AND CLIENT_ID = VL_CLIENT_ID
    AND CASE_ID :: VARCHAR = VL_CASE_ID
    AND ENTRY_DT >= VDT_START_DT ::DATE; */
          
          
    SELECT RTRIM(COUNT(distinct pl.alternateid)::VARCHAR) -- CIDM-4187
     INTO VS_APPROVE_CURR
    FROM PLACEMENT pl
     JOIN servicecase sc ON sc.servicecaseid = pl.servicecaseid 
      AND sc.activeflag = 1
     JOIN person pr ON pr.personid = pl.personid 
      AND pr.activeflag = 1
     join routing rt on rt.objectid::character varying = pl.placementid::character varying  
      and rt.routingstatustypeid = 16 
      AND rt.eventcode::character varying = 'PLTR'::character varying  
      AND rt.activeflag = 1
    WHERE pl.startdatetime IS NOT NULL
     AND ((CASE COALESCE(pl.isvoided, 0)  WHEN 1 THEN 'Y'::text  ELSE NULL::text END::character) = 'N'
     OR
     (CASE COALESCE(pl.isvoided, 0) WHEN 1 THEN 'Y'::text ELSE NULL::text END::character) IS NULL)
     AND pl.activeflag = 1
     AND pr.cjamspid = VL_CLIENT_ID
     AND sc.servicecasenumber::bigint = VL_CASE_ID::bigint
     AND pl.startdatetime >= VDT_START_DT::DATE;
    
    IF VS_APPROVE_CURR is null or btrim(VS_APPROVE_CURR) = '' THEN
     VS_APPROVE_CURR := LPAD('',2,'0');
    ELSE
     VS_APPROVE_CURR := LPAD(VS_APPROVE_CURR ,2,'0');
    END IF;
    
    -- RAISE NOTICE 'VS_APPROVE_CURR';
    EXCEPTION WHEN OTHERS THEN
     VS_OUTPUT_STATE := SQLSTATE;
     VL_OUTPUT_SQLCODE :=SQLERRM;
     VS_MESSAGE := 'SQLSTATE:' || VS_OUTPUT_STATE || '. SELECT  FAILED  FOR APPROVE_CURR   #76 FOR -->'|| CAST(VL_CLIENT_ID AS VARCHAR) ;
     VL_EXCEP_FLAG := 1;
     VL_EXCEP_MESSAGE := VL_EXCEP_MESSAGE || 'C76N'||CAST(VL_OUTPUT_SQLCODE AS VARCHAR)||'T'|| VS_OUTPUT_STATE ;

   END;
   
