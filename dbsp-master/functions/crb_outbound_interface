    AND APPROVAL_STATUS_CD = '3047'
    ORDER BY ENTRY_DT
    limit 1; */
     

    SELECT pl.startdatetime::VARCHAR(10) 
     INTO VDT_PLCMT_DATE
    FROM PLACEMENT pl
     JOIN servicecase sc ON sc.servicecaseid = pl.servicecaseid 
      AND sc.activeflag = 1
     JOIN person pr ON pr.personid = pl.personid 
      AND pr.activeflag = 1
     join routing rt on rt.objectid::character varying = pl.placementid::character varying 
      and rt.routingstatustypeid = 16 
      AND rt.eventcode::character varying = 'PLTR'::character varying 
      AND rt.activeflag = 1
    WHERE pl.startdatetime IS NOT NULL
     AND ((CASE COALESCE(pl.isvoided, 0)  WHEN 1 THEN 'Y'::text  ELSE NULL::text END::character) = 'N'
     OR
     (CASE COALESCE(pl.isvoided, 0) WHEN 1 THEN 'Y'::text ELSE NULL::text END::character) IS NULL)
     AND pl.activeflag = 1
     AND pr.cjamspid = VL_CLIENT_ID
     AND sc.servicecasenumber::bigint = VL_CASE_ID::bigint
     AND pl.startdatetime >= VDT_START_DT::DATE
    ORDER BY pl.startdatetime
    limit 1;


    -- RAISE NOTICE 'ABCDRUIIVDT_PLCMT_DATE%', LENGTH(VDT_PLCMT_DATE); 
    EXCEPTION WHEN OTHERS THEN
     VS_OUTPUT_STATE := SQLSTATE;
     VL_OUTPUT_SQLCODE :=SQLERRM;
     VS_MESSAGE := 'SQLSTATE:' || VS_OUTPUT_STATE || '. SELECT  FAILED  FOR PLCMT_DATE #90 FOR -->'|| VL_CLIENT_ID :: VARCHAR ;
     VL_EXCEP_FLAG := 1;
     VL_EXCEP_MESSAGE := VL_EXCEP_MESSAGE || 'C90N'|| VL_OUTPUT_SQLCODE :: VARCHAR||'T'|| VS_OUTPUT_STATE ;

   END;
   
