    AND icr.activeflag = 1) ; */
     
     
    SELECT  (pl.enddatetime::date)::varchar ,
     -- coalesce (CRBV.chessiecode , '1830')
     (case when CRBV.chessiecode = '1825' then '13' -- Adoption Disruption
      when CRBV.chessiecode = '1826' then '07' -- Custody Non-Relative
      when CRBV.chessiecode = '1827' then '15' -- Death of Child
      when CRBV.chessiecode = '1828' then '07' -- Guardianship Non-Relative
      when CRBV.chessiecode = '1829' then '05' -- Independence
      when CRBV.chessiecode = '1830' then '99' -- Other
      when CRBV.chessiecode = '1831' then '02' -- Other Relative
      when CRBV.chessiecode = '1832' then '99' -- Refused Service
      when CRBV.chessiecode = '1833' then '01' -- Reunification
      when CRBV.chessiecode = '1834' then '10' -- Runaway
      when CRBV.chessiecode = '1835' then '09' -- Transfer to Other Agency
      when CRBV.chessiecode = '12740' then '11' -- Adoption Placement
      when CRBV.chessiecode = '4529' then '03' -- Adoption Finalization
      when CRBV.chessiecode = '10480' then '16' -- Court ordered return home against DSS recommendation
      else '99' -- Other
     end)
    INTO VDT_FC_EXIT_DATE,
     VS_FC_EXIT_REASON
    FROM placement pl 
    JOIN intakeservreqchildremoval icr on pl.intakeservreqchildremovalid = icr.intakeservreqchildremovalid  
     AND icr.updatedon 
      IN ( SELECT MAX(icr.updatedon)
        FROM intakeservreqchildremoval icr, 
         person pga, 
