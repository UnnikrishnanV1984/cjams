CREATE OR REPLACE FUNCTION deleteuser(v_email character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$\r
 declare v_teamid uuid ;\r
 v_teammemberid uuid ;\r
    v_securityusersid  uuid ;\r
    v_muser_id number;\r
 v_message character varying;\r
  \r
  \r
 BEGIN\r
 v_message:= 'Success';\r
    select securityusersid into v_securityusersid from userprofile where email=v_email;\r
    Select teammemberid into v_teammemberid from teammemberassignment where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'v_teammemberid ' || v_teammemberid;\r
 Select teamid into v_teamid from teammember where teammemberid::uuid=v_teammemberid::uuid;\r
    v_message:= v_message || 'v_teamid ' || v_teamid;\r
    Select id into v_muser_id from muser where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'v_muser_id ' || v_muser_id;\r
   \r
    delete from userresource where userid=v_muser_id;\r
    v_message:= v_message || 'userresource Deleted  ';\r
   \r
     \r
    delete from teammemberassignment where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'teammemberassignment Deleted  ';\r
   \r
   \r
    delete from teammember where teammemberid::uuid=v_teammemberid::uuid;\r
     v_message:= v_message || 'teammember Deleted  ';\r
--    delete from team where teamid::uuid = v_teamid::uuid;\r
--     v_message:= v_message || 'team Deleted  ';\r
   \r
\r
    delete from rolemapping where principalid = v_muser_id;\r
    v_message:= v_message || 'rolemapping Deleted  ';\r
     \r
    delete from userprofileaddress where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'userprofileaddress Deleted  ';\r
    delete from userprofilephonenumber where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'userprofilephonenumber Deleted  ';\r
    delete from muser where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'userprofilephonenumber Deleted  ';\r
    delete from usernotificationmap where usernotificationid::uuid in (select usernotificationid::uuid from usernotification where securityusersid::uuid=v_securityusersid::uuid);\r
    v_message:= v_message || 'usernotificationmap Deleted  ';\r
    delete from usernotification where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'usernotification Deleted  ';\r
    delete from securityusers where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'securityusers Deleted  ';\r
    delete from userreference where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'userreference Deleted  ';\r
 delete from userprofile where securityusersid::uuid=v_securityusersid::uuid;\r
    v_message:= v_message || 'userprofile Deleted  ';\r
\r
    \r
\r
    return v_message;\r
END  \r
$function$

