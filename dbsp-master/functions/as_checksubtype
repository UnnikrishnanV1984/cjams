CREATE OR REPLACE FUNCTION as_checksubtype(v_intakeserviceid uuid, v_intakenumber character varying)
 RETURNS boolean
 LANGUAGE plpgsql
AS $function$

declare no_of_records integer;
declare stat character varying;
declare status boolean;

begin
 



 select count(*) into no_of_records from 
 intakeservicerequest isr join servicerequestsubtype srs ON
  srs.servicerequestsubtypeid=isr.intakeservicerequestclassid  AND  srs.activeflag=1
 where isr.intakeserviceid=v_intakeserviceid 
                 and srs.classkey in ('ICJ Sending requisition due to warrant', 'ICJ Sending Probation',  ' ICJ Sending Re-Entry/Parole');
               
    select distinct cast(jsonb_array_elements(jsondata -> 'createdCases')->>'subSeriviceTypeValue' as character varying) into stat from intakedastaging
where activeflag=1 and jsonb_typeof(jsondata->'createdCases')!='null'   and intakenumber=v_intakenumber;     
               
            
if (no_of_records >=1 or stat in ('ICJ Sending requisition due to warrant', 'ICJ Sending Probation',  'ICJ Sending Re-Entry/Parole'))
then status=true;
else status=false;
end if;
return status;
end;
$function$

