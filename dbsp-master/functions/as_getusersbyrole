CREATE OR REPLACE FUNCTION as_getusersbyrole(roletypekey character varying, countyid character varying)
 RETURNS TABLE(userid character varying, teamname character varying, username character varying, agencykey character varying, userrole text, loadnumber character varying)
 LANGUAGE plpgsql
AS $function$

declare 
 v_roletypekey character varying;
 v_countyid character varying;
 v_permissiongroup character varying;
BEGIN
 v_roletypekey:= roletypekey;
 v_countyid:= countyid;
 
 IF (v_roletypekey = 'ASMHCP') THEN
  v_permissiongroup := 'MedicalPractitioner';
 ELSE
  IF (v_roletypekey = 'ASPHCP') THEN
   v_permissiongroup := 'PsychiatricPractitioner';
  ELSE 
   IF (v_roletypekey = 'ASRNC') THEN
    v_permissiongroup := 'NurseConsultant';
   END IF;
  END IF;
 END IF;

 
 IF (v_roletypekey IN ('ASMHCP','ASPHCP','ASRNC')) THEN
  Return Query
   Select x.userid, x.teamname, x.username,x.agencykey, x.userrole, x.loadnumber
    FROM (
     Select  m.securityusersid as userid, 
       T.teamname, 
       UP.fullname as username, 
       rm.teamtypekey as agencykey,
       replace(r.description, ',' || rm.teamtypekey,'') userrole, 
       TM.loadnumber
      FROM MUSER m
       INNER JOIN rolemapping rm on rm.principalid = m.id and m.activeflag=1 and rm.activeflag=1 and rm.teamtypekey = 'AS'
       INNER JOIN userresource ur on ur.userid = rm.principalid and ur.activeflag=1
       INNER JOIN pgresource pg on pg.permissiongroupid = ur.permissiongroupid and  pg.activeflag=1 and  pg.isallowed = true
       INNER JOIN resource rs on pg.resourceid = rs.id AND rs.activeflag=1 and rs.resourceid = v_permissiongroup
       INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1
       INNER Join TeamMember TM ON TMA.teammemberId  = TM.teammemberid and TM.activeflag=1
       INNER JOIN Team T ON TM.teamid = T.teamid and T.activeflag = 1 and T.countyid = v_countyid
       INNER JOIN role r On r.id = rm.roleid and r.activeflag=1
       INNER JOIN UserProfile UP On UP.securityusersid = TMA.securityusersid and UP.activeflag = 1
     UNION
     Select  m.securityusersid as userid, 
       T.teamname, 
       UP.fullname as username, 
       rm.teamtypekey as agencykey,
       replace(r.description, ',' || rm.teamtypekey,'') userrole, 
       TM.loadnumber
      FROM MUSER m
       INNER JOIN rolemapping rm on rm.principalid = m.id and m.activeflag=1 and rm.activeflag=1 and rm.teamtypekey = 'AS'
       INNER JOIN role_resource rr on rr.roleid = rm.roleid and rr.activeflag=1
       INNER JOIN pgresource pg on pg.permissiongroupid = rr.resourceid and  pg.activeflag=1 and  pg.isallowed = true
       INNER JOIN resource rs on pg.resourceid = rs.id AND  rs.activeflag=1 and rs.resourceid = v_permissiongroup
       INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1
       INNER Join TeamMember TM ON TMA.teammemberId  = TM.teammemberid and TM.activeflag=1
       INNER JOIN Team T ON TM.teamid = T.teamid and T.activeflag = 1 and T.countyid = v_countyid
       INNER JOIN role r On r.id = rm.roleid and r.activeflag=1
       INNER JOIN UserProfile UP On UP.securityusersid = TMA.securityusersid and UP.activeflag = 1
     UNION
     Select  m.securityusersid as userid, 
       T.teamname, 
       UP.fullname as username, 
       rm.teamtypekey as agencykey,
       replace(r.description, ',' || rm.teamtypekey,'') userrole, 
       TM.loadnumber
      FROM role r 
       INNER JOIN rolemapping rm on rm.roleid = r.id and r.activeflag=1 and rm.activeflag=1 and rm.teamtypekey = 'AS'
       INNER JOIN muser m on m.id = rm.principalid AND m.activeflag = 1
       INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1
       INNER Join TeamMember TM ON TMA.teammemberId  = TM.teammemberid and TM.activeflag=1
       INNER JOIN Team T ON TM.teamid = T.teamid and T.activeflag = 1 and T.countyid = v_countyid    
       INNER JOIN UserProfile UP On UP.securityusersid = TMA.securityusersid and UP.activeflag=1
      Where r.roletypekey = v_roletypekey ) x
   ORDER BY x.teamname , x.username;
 ELSE
  
  Return Query
  Select  m.securityusersid as userid, 
    T.teamname, 
    UP.fullname as username, 
    rm.teamtypekey as agencykey,
    replace(r.description, ',' || rm.teamtypekey,'') userrole, 
    TM.loadnumber
   FROM role r 
    INNER JOIN rolemapping rm on rm.roleid = r.id and r.activeflag=1 and rm.activeflag=1 and rm.teamtypekey = 'AS'
    INNER JOIN muser m on m.id = rm.principalid AND m.activeflag = 1
    INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1
    INNER Join TeamMember TM ON TMA.teammemberId  = TM.teammemberid and TM.activeflag=1
    INNER JOIN Team T ON TM.teamid = T.teamid and T.activeflag=1 and T.countyid = v_countyid
    INNER JOIN UserProfile UP On UP.securityusersid = TMA.securityusersid and UP.activeflag=1
   Where r.roletypekey = v_roletypekey
   order by T.teamname , UP.fullname;
 END IF;
 
  end;

$function$

