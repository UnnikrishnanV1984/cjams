CREATE OR REPLACE FUNCTION as_f_prim_county(ai_entity_id bigint, as_entity_type character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare ai_entity_cd varchar(5);
    declare ai_case_cd varchar(5);
    declare v_servicecaseid uuid;
    declare v_intakeserviceid uuid;
    declare v_case_id uuid;
    declare v_adoptioncaseid uuid;
    v_case_count bigint;
    
BEGIN
 
 select count(1) into v_case_count from intakeservicerequest ins
  where ins.servicerequestnumber = ai_entity_id :: character varying;
 
 if(v_case_count > 0)
   then
 select ins.servicecaseid,ins.intakeserviceid into v_servicecaseid,v_intakeserviceid from intakeservicerequest ins
  where ins.servicerequestnumber = ai_entity_id :: character varying;
 else
 select sc.servicecaseid into v_servicecaseid from servicecase sc where sc.servicecasenumber   = ai_entity_id :: character varying;
 end if;
 
if(coalesce(v_servicecaseid,null) = null )
 then 
 v_case_id := v_intakeserviceid ;
    else
    select ad.adoptioncaseid into v_adoptioncaseid from adoptioncase ad where ad.servicecaseid = v_servicecaseid;
    if (coalesce(v_adoptioncaseid,null) = null )
    then
    v_case_id := v_adoptioncaseid ;
       else
    v_case_id := v_servicecaseid ;
    end if;
  end if; 
-- return '1427';
