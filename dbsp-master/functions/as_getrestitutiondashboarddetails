 order by rfc.paymentno asc  */
if (lower(v_pagetype) = 'payment') then searchstring := '  AND (rfc.status=''Pending'' or rfc.status=''Approved'') order by rfc.updatedon desc,rfc.paymentno,rfc.status asc ';

elsif (lower(v_pagetype) = 'refund') then searchstring := ' AND (rfc.status=''Pending'' or rfc.status=''Approved'') AND rfc.refundstatus is not null AND (rfc.refundstatus=''Refund Pending'' or rfc.refundstatus=''Refund Approved'') order by rfc.updatedon desc,rfc.paymentno,rfc.refundstatus,rfc.status asc';
end if;

return query execute 'select count(1) over() as totalcount, rfc.restitutionpaymentflatfilecontentid , rfc.restitutionpaymentflatfileid , rfc.paymentno, rfc.asofdate, 
 rfc.lockboxno, rfc.vakaccountnumber, rfc.firstname,
 rfc.lastname, rfc.addressline1,rfc.addressline2, rfc.customernumber, rfc.checkno, rfc.checkamt,coalesce(rfc.checkamt,0)-coalesce(rfc.balanceamount,0) as allocatedamount,
 rfc.balanceamount, rfc.documentpath,
(select sum(irp.paymentamount) from intakeserreqrestitutionpayment as irp 
 Join intakeserreqrestitution ir on ir.intakeserreqrestitutionid = irp.intakeserreqrestitutionid and ir.activeflag=1
 where irp.restitutionpaymentflatfilecontentid = rfc.restitutionpaymentflatfilecontentid and irp.activeflag=1 limit 1),
 
 (select json_agg(x) from (select ir.restitutionno from intakeserreqrestitution as ir 
 JOIN intakeserreqrestitutionpayment as irp on ir.intakeserreqrestitutionid = irp.intakeserreqrestitutionid and irp.activeflag=1
 where irp.restitutionpaymentflatfilecontentid = rfc.restitutionpaymentflatfilecontentid) as X ) as restitutionno,
 
  (select json_agg(x) from (select ir.intakeserreqrestitutionid,ir.restitutionno,irp.youthpersonid,pp.firstname,pp.lastname,pp.suffix,
  pp.cjamspid, pp.dob, pp.gendertypekey from person pp
  join intakeserreqrestitutionpayment as irp on pp.personid= irp.victimpersonid and irp.activeflag =1
  JOIN intakeserreqrestitution as ir on ir.intakeserreqrestitutionid = irp.intakeserreqrestitutionid and irp.activeflag=1
  where irp.restitutionpaymentflatfilecontentid = rfc.restitutionpaymentflatfilecontentid) as X ) as victimpersondetails,
  rfc.city,rfc.state,rfc.zip,
  (select irp.restitutionstatus from intakeserreqrestitutionpayment as irp 
 Join intakeserreqrestitution ir on ir.intakeserreqrestitutionid = irp.intakeserreqrestitutionid --and ir.activeflag=1
 where irp.restitutionpaymentflatfilecontentid = rfc.restitutionpaymentflatfilecontentid and irp.activeflag=1 limit 1) as status,
 rfc.refundstatus,
 (select RF.description from referencevalues as RF JOIN referencetype as RT ON RT.referencetypeid = RF.referencetypeid and RT.activeflag=1
 where RF.ref_key in (select RPFFC.overpaymentacctype from restitutionpaymentflatfilecontent as RPFFC ) and RT.referencetypeid=58)
 
 from  restitutionpaymentflatfilecontent as rfc 
 where rfc.activeflag=1 ' || searchstring || ' 
 LIMIT ' || v_liPageSize || ' OFFSET ' || v_pageoffset || '';
end;

