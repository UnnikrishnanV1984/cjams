irp.checknumber,irp.payerfirstname,irp.payerlastname,irp.payeraddress,irp.payercity,irp.payerstatekey,irp.payerzipcode,irp.depositnumber,irp.accountarea,
irp.memofirstname,irp.memolastname,irp.restitutionpaymentflatfilecontentid,json_build_object('youthpersonid',irp.youthpersonid,'youthfirstname',pp.firstname,
  'youthlastname', pp.lastname ,'youthcjamspid', pp.cjamspid, 'youthdob',pp.dob, 'youthgendertypekey',pp.gendertypekey ) as youthpersondetails,
   json_build_object('victimpersonid',irp.victimpersonid,'victimfirstname',pv.firstname,
  'victimlastname', pv.lastname ,'victimcjamspid', pv.cjamspid, 'victimdob',pv.dob, 'victimgendertypekey',pv.gendertypekey ) as victimpersondetails,ir.restitutionno,coalesce(rfc.checkamt,0)-coalesce(rfc.balanceamount,0) as allocatedamount, rfc.checkamt,rfc.balanceamount,irp.restitutionstatus,rfc.documentpath
from 
  intakeserreqrestitutionpayment irp 
