CREATE OR REPLACE FUNCTION as_getrestitutiondashboarddetails(v_pagetype character varying, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, restitutionpaymentflatfilecontentid uuid, restitutionpaymentflatfileid uuid, paymentnumber bigint, paymentdate character varying, depositnumber character varying, accountarea character varying, payerfirstname character varying, payerlastname character varying, payeraddress character varying, payeraddress1 character varying, memofirstname character varying, memolastname character varying, checkamt numeric, allocatedamount numeric, balanceamount numeric, documentpath character varying, paymentamount numeric, restitutionno json, victimpersondetails json, payercity character varying, payerstatekey character varying, payerzipcode character varying, restitutionstatus character varying, refundstatus character varying, refundaccounttype character varying)
 LANGUAGE plpgsql
AS $function$ declare v_pagenumber int;

v_pageoffset int;

declare searchstring character varying(1000);
begin
if coalesce(v_liPageSize, 0) < 1 then v_liPageSize := 10;
end if;

if coalesce(v_liPageNumber, 0) < 1 then v_liPageNumber := 1;
end if;

v_pagenumber := v_liPageNumber - 1;

v_pageoffset := v_pagenumber * v_liPageSize;

