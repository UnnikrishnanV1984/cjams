      join intakeserreqrestitution ir on ir.intakeserreqrestitutionid = irp.intakeserreqrestitutionid
          join restitutionpaymentflatfilecontent rfc on rfc.restitutionpaymentflatfilecontentid = irp.restitutionpaymentflatfilecontentid
          where irp.restitutionstatus is not null
          and (case when v_pagetype='Payment' then rfc.balanceamount=0.00 else rfc.balanceamount!=0.00 end) */
