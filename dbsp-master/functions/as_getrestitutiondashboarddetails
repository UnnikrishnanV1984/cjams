 where irp.restitutionpaymentflatfilecontentid = rfc.restitutionpaymentflatfilecontentid) as X ) as restitutionno,
 
  (select json_agg(x) from (select ir.intakeserreqrestitutionid,ir.restitutionno,irp.youthpersonid,pp.firstname,pp.lastname,
  pp.cjamspid, pp.dob, pp.gendertypekey from person pp
  join intakeserreqrestitutionpayment as irp on pp.personid= irp.victimpersonid and irp.activeflag =1
  JOIN intakeserreqrestitution as ir on ir.intakeserreqrestitutionid = irp.intakeserreqrestitutionid and irp.activeflag=1
  where irp.restitutionpaymentflatfilecontentid = rfc.restitutionpaymentflatfilecontentid) as X ) as victimpersondetails,
  rfc.city,rfc.state,rfc.zip,
