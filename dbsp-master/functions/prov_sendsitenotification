CREATE OR REPLACE FUNCTION prov_sendsitenotification(reqobj json)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

 DECLARE

 v_usernotificationid uuid;
 v_date timestamp without time zone;
 v_isexternalentity boolean;  
 v_from_userid character varying;
 v_provider_id character varying;
 v_site_id character varying;
 v_objecttype character varying;
 v_objectid character varying;
 v_subject character varying;
 v_body text;
 v_to_userid character varying;
                                                                                                                                                                                                                                                                                                                                                          
 BEGIN         

 v_from_userid = reqObj ->> 'from_userid';
 v_provider_id = reqObj ->> 'provider_id';
 v_site_id = reqObj ->> 'site_id';
 v_objecttype = reqObj ->> 'objecttype';
 v_objectid = reqObj ->> 'objectid';
 v_subject = reqObj ->> 'subject';
 v_body = reqObj ->> 'body';
                                                                                                                                                                                                                                                                                                                                                          
 v_date:= now();                                                                                                                                                                                                                                                                                                                       


select toworkeridno into v_to_userid from providerassignment pa where pa.objectid = v_site_id and
 pa.activeflag = 1 and (pa.enddate is null or pa.enddate::date >= now()::date) order by insertedon desc limit 1;

 INSERT INTO prov_usernotification (securityusersid,
        usernotificationtypekey,
        objectid,objecttype,provider_id,
        activeflag,subject,priorityleveltypekey,body,isexternalentity,updatedby,
        updatedon,insertedby,insertedon,effectivedate) 

 VALUES (v_to_userid, 'System', v_objectid, v_objecttype, v_provider_id,
        1, v_subject, 'High', v_body,false, v_from_userid,
        v_date, v_from_userid,v_date,v_date)  
            RETURNING "usernotificationid" INTO  v_usernotificationid;
                                                                                                                                                                                                                                                                                                                                                          
 INSERT INTO prov_usernotificationmap(usernotificationid,fromsecurityusersid,tosecurityusersid,isread,                                                                                                                                                                                                                                                         
 effectivedate,activeflag,updatedby,                                                                                                                                                                                                                                                                                                                      
 updatedon,insertedby,insertedon)                                                                                                                                                                                                                                                                                                                         
 VALUES (v_usernotificationid, v_from_userid,v_to_userid, false,                                                                                                                                                                                                                                                                                              
         v_date, 1, v_from_userid,                                                                                                                                                                                                                                                                                                                          
         v_date, v_from_userid,v_date);                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                          
 RETURN 'success' ;                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                          
 END;                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                          
 $function$

