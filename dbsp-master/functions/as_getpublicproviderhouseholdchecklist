CREATE OR REPLACE FUNCTION as_getpublicproviderhouseholdchecklist(v_applicationid character varying)
 RETURNS TABLE(applicant_id character varying, checklist_task character varying, comment character varying, review_date timestamp without time zone, date_type character varying, status character varying, create_ts character varying, create_user_id character varying, update_ts character varying, update_user_id character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN

RETURN Query
  
 SELECT PPHH.applicant_id, PPHH.checklist_task, PPHH."comment", PPHH.review_date, 
 PPHH.date_type, PPHH.status, PPHH.create_ts,
 PPHH.create_user_id, PPHH.update_ts, PPHH.update_user_id  
 FROM publicproviderhousehold  PPHH 
 WHERE PPHH.applicant_id = v_applicationid 
 order by PPHH.checklist_task asc;
 
    
END;

$function$

