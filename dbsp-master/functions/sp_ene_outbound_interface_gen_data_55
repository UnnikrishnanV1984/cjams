       WHEN personincome.incomesourcetypekey = '' THEN '    '
       ELSE SUBSTRING(personincome.incomesourcetypekey,1,5)
      END AS incomesourcetypekey,
      personincome.old_id,
      personincome.amount,
      (CASE WHEN personincome.incomefrequencytypekey = 'TM' THEN '1241'
       WHEN personincome.incomefrequencytypekey = 'ETW' THEN '1237'
       WHEN personincome.incomefrequencytypekey = 'MON' THEN '1238'
       WHEN personincome.incomefrequencytypekey = 'WKLY' THEN '1243'
       WHEN personincome.incomefrequencytypekey = 'DAI' THEN '1236'
       WHEN personincome.incomefrequencytypekey = 'ANN' THEN '1235'
       WHEN personincome.incomefrequencytypekey = 'OT' THEN '1239'
       WHEN personincome.incomefrequencytypekey = 'QRTY' THEN '1240'
       WHEN personincome.incomefrequencytypekey = 'TY' THEN '1242'
       WHEN personincome.incomefrequencytypekey = '' THEN '    '
       ELSE personincome.incomefrequencytypekey
      END),
      (CASE WHEN personincome.incomefrequencytypekey = 'DAI'  THEN (personincome.amount * 30.5)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'OT'    THEN (personincome.amount)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'MON'   THEN (personincome.amount)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'WKLY'  THEN (personincome.amount * 4.33)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'ETW'   THEN (personincome.amount * 2.167)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'TM'    THEN (personincome.amount * 2)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'QRTY'  THEN (personincome.amount / 4)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'TY'    THEN (personincome.amount / 6)::DECIMAL(10,2)
       WHEN personincome.incomefrequencytypekey = 'ANN'   THEN (personincome.amount / 12)::DECIMAL(10,2)
       ELSE (personincome.amount)::DECIMAL(10,2)
      END ) AS monthlyamount
