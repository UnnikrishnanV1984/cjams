CREATE OR REPLACE FUNCTION sp_ene_outbound_interface_gen_data_55(vl_client_id integer, vl_other_id bigint, vs_transaction_type_cd character varying, vl_transaction_sequence integer, vd_transaction_ts timestamp without time zone, vl_servicecasenumber character varying, vl_adoptioncasenumber character varying, OUT vs_message character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- Author: Vineet Tirodkar
-- Date Created: 11/25/2020
-- Description: To generate E&E Inbound data for Record Type 55

-- Revision(s):
-- 03/08/2021 Vineet Tirodkar - Modifications to send workphone as numeric value & person name suffix logic fix (CIDM-2203)
-- 03/11/2021 Vineet Tirodkar - Modifications to get the personaddress using personid (uuid) (CIDM-2203)
-- 06/21/2021 Vineet Tirodkar - Modifications fix personincome -> Old ID alphanumeric value error. (APS Migrated Data)
-- 12/01/2021 Vineet Tirodkar - Modifications fix duplicate Cjamspid issue for a parent record (CIDM-4097)
-- 02/18/2022 Vineet Tirodkar - Modifications to intreface person income records known to E&E only (CIDM-4272)
------------------------------------------------------------------------
DECLARE VS_RECORD_TYPE VARCHAR(2);
 VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';
 VL_RECORD_SEQUENCE INTEGER DEFAULT 000;
 VS_TRANSACTION_SEQUENCE VARCHAR(5);
 VS_RECORD_SEQUENCE VARCHAR(3);
 -- Client Variables
 VS_CIS_CLIENT_ID VARCHAR(10); -- ENE_OUT_COL6

 VL_PARENT_ID INTEGER;
 VL_NEW_PARENT_ID INTEGER;
 VL_PARENT_EMPLOYMENT_ID INTEGER;
 VD_CURR_EMPL_DATE TIMESTAMP;
 VS_SERVICE_CASEID   VARCHAR;
 VS_ADOPTION_CASEID   VARCHAR;
 ENE_OUT_PARENT_COL1 CHAR(1);
 ENE_OUT_PARENT_COL2 VARCHAR(10);
 ENE_OUT_PARENT_COL3 VARCHAR(20);
 ENE_OUT_PARENT_COL4 VARCHAR(20);
 ENE_OUT_PARENT_COL5 VARCHAR(10);
 ENE_OUT_PARENT_COL6  CHAR(10);
 ENE_OUT_PARENT_COL7  VARCHAR(20);
 ENE_OUT_PARENT_COL8  VARCHAR;
 ENE_OUT_PARENT_COL9  INTEGER;
 ENE_OUT_PARENT_COL10  CHAR(100);
 ENE_OUT_PARENT_COL11  CHAR(5);
 ENE_OUT_PARENT_COL12  CHAR(5);
 VD_CLIENT_DOB DATE;
 ENE_OUT_PARENT_COL13  INTEGER;
 ENE_OUT_PARENT_COL14  VARCHAR(50);
 ENE_OUT_PARENT_COL15  VARCHAR(20);
 ENE_OUT_PARENT_COL16  VARCHAR(20);
 ENE_OUT_PARENT_COL17  VARCHAR(10);
 ENE_OUT_PARENT_COL18  CHAR(5);
 ENE_OUT_PARENT_COL19 CHAR(3);
 ENE_OUT_PARENT_COL20 VARCHAR(9); -- INTEGER
 ENE_OUT_PARENT_COL21 VARCHAR(50);
 ENE_OUT_PARENT_COL22 CHAR(5);
 ENE_OUT_PARENT_COL23 CHAR(3);
 ENE_OUT_PARENT_COL24 CHAR(5);
 ENE_OUT_PARENT_COL25 VARCHAR(50);
 ENE_OUT_PARENT_COL26 CHAR(2);
 ENE_OUT_PARENT_COL27 INTEGER;
 ENE_OUT_PARENT_COL28 VARCHAR(10);
 ENE_OUT_PARENT_COL29 INTEGER;
 ENE_OUT_PARENT_COL30 CHAR(3);
 ENE_OUT_PARENT_COL31 VARCHAR(9); -- INTEGER
 ENE_OUT_PARENT_COL32 VARCHAR(50);
 ENE_OUT_PARENT_COL33 CHAR(5);
 ENE_OUT_PARENT_COL34 CHAR(3);
 ENE_OUT_PARENT_COL35 CHAR(5);
 ENE_OUT_PARENT_COL36 VARCHAR(50);
 ENE_OUT_PARENT_COL37 CHAR(2);
 ENE_OUT_PARENT_COL38 INTEGER;
 ENE_OUT_PARENT_COL39 VARCHAR(10);
 ENE_OUT_PARENT_COL40 INTEGER;

 ENE_OUT_PARENT_COL41 VARCHAR(50);
 ENE_OUT_PARENT_COL42 CHAR(2);

 ENE_OUT_PARENT_COL43 VARCHAR;
 ENE_OUT_PARENT_COL44 CHAR(5);
 ENE_OUT_PARENT_COL45 CHAR(5);
 ENE_OUT_PARENT_COL46 VARCHAR;

 ENE_OUT_PARENT_COL47 CHAR(5);
 ENE_OUT_PARENT_COL48 VARCHAR(20);
 ENE_OUT_PARENT_COL49 CHAR(5);
 ENE_OUT_PARENT_COL50 INTEGER;
 ENE_OUT_PARENT_COL51 INTEGER;

 ENE_OUT_PARENT_COL52 VARCHAR(50);
 ENE_OUT_PARENT_COL53 VARCHAR(50);
 ENE_OUT_PARENT_COL54 INTEGER;
 ENE_OUT_PARENT_COL55 INTEGER;

 ENE_OUT_PARENT_COL56 CHAR(3);
 ENE_OUT_PARENT_COL57 VARCHAR(9); -- INTEGER
 ENE_OUT_PARENT_COL58 VARCHAR(50);
 ENE_OUT_PARENT_COL59 CHAR(5);
 ENE_OUT_PARENT_COL60 CHAR(3);
 ENE_OUT_PARENT_COL61 CHAR(5);
 ENE_OUT_PARENT_COL62 VARCHAR(50);
 ENE_OUT_PARENT_COL63 VARCHAR(100);
 ENE_OUT_PARENT_COL64 INTEGER;

 ENE_OUT_PARENT_COL65 VARCHAR(32);

 ENE_OUT_PARENT_COL66 VARCHAR(50);
 ENE_OUT_PARENT_COL67 VARCHAR(50);
 ENE_OUT_PARENT_COL68 INTEGER;
 ENE_OUT_PARENT_COL69 INTEGER;

 ENE_OUT_PARENT_COL70 CHAR(3);
 ENE_OUT_PARENT_COL71 VARCHAR(9); -- INTEGER
 ENE_OUT_PARENT_COL72 VARCHAR(50);
 ENE_OUT_PARENT_COL73 CHAR(5);
 ENE_OUT_PARENT_COL74 CHAR(3);
 ENE_OUT_PARENT_COL75 CHAR(5);
 ENE_OUT_PARENT_COL76 VARCHAR(50);
 ENE_OUT_PARENT_COL77 CHAR(100);
 ENE_OUT_PARENT_COL78 INTEGER;

 ENE_OUT_PARENT_COL79 VARCHAR(10);

 ENE_OUT_PARENT_COL80 VARCHAR(50);
 ENE_OUT_PARENT_COL81 VARCHAR(50);
 ENE_OUT_PARENT_COL82 INTEGER;
 ENE_OUT_PARENT_COL83 INTEGER;

 ENE_OUT_PARENT_COL84 CHAR(3);
 ENE_OUT_PARENT_COL85 VARCHAR(9); -- INTEGER
 ENE_OUT_PARENT_COL86 VARCHAR(50);
 ENE_OUT_PARENT_COL87 CHAR(5);
 ENE_OUT_PARENT_COL88 CHAR(3);
 ENE_OUT_PARENT_COL89 CHAR(5);
 ENE_OUT_PARENT_COL90 VARCHAR(50);
 ENE_OUT_PARENT_COL91 CHAR(100);
 ENE_OUT_PARENT_COL92 INTEGER;

 ENE_OUT_PARENT_COL93 VARCHAR(10);

 -- PARENT_INCOME_ID_1 INTEGER;
 PARENT_INCOME_ID_1 VARCHAR(20);
 ENE_OUT_PARENT_COL94 CHAR(5);
 PARENT_AMOUNT_NO_1 DECIMAL(10,2);

 -- PARENT_INCOME_ID_2 INTEGER;
 PARENT_INCOME_ID_2 VARCHAR(20);
 ENE_OUT_PARENT_COL95 CHAR(5);
 PARENT_AMOUNT_NO_2 DECIMAL(10,2);

 -- PARENT_INCOME_ID_3 INTEGER;
 PARENT_INCOME_ID_3 VARCHAR(20);
 ENE_OUT_PARENT_COL96 CHAR(5);
 PARENT_AMOUNT_NO_3 DECIMAL(10,2);

 ENE_OUT_PARENT_COL97 INTEGER;
 ENE_OUT_PARENT_COL98 DECIMAL(10,2);

 VL_SC_CJAMSPID  BIGINT; -- NEW VARIABLE FOR MATCHING VL_PARENT_ID
 VL_PD_CJAMSPID  BIGINT; --NEW VARIABLE FOR MATCHING VL_PARENT_ID
   
  

DECLARE CURSOR_PARENT CURSOR FOR
 SELECT DISTINCT PPT.cjamspid
  FROM actorrelationship ACR, person PP, person PPT
 WHERE ACR.person1id = PP.personid
  AND PPT.personid = ACR.person2id
  AND PP.cjamspid =  VL_CLIENT_ID  --- edited cjmas to cjams 
  AND ACR.relationshiptypekey IN ('3447','3449', 'BGCHLD')
  AND ACR.activeflag = 1;

   
BEGIN 
 --  RAISE NOTICE 'GEN DATA 55 STARTS';--
 -- SET transaction sequence
 VS_TRANSACTION_SEQUENCE := LTRIM(RTRIM((VL_TRANSACTION_SEQUENCE)::VARCHAR)) ;
 
 VS_SERVICE_CASEID:= ( SELECT servicecasenumber 
        FROM SERVICECASE 
       WHERE servicecasenumber = vl_other_id::VARCHAR); -- type casted to big int #27062019 
       
 VS_ADOPTION_CASEID:= ( SELECT adoptioncasenumber 
        FROM ADOPTIONCASE 
       WHERE adoptioncasenumber = VL_ADOPTIONCASENUMBER::VARCHAR); --type casted to big int #27062019 
 
 --- IF VL_OTHER_ID IS PASSED ON AS PAYMENT_ID THEN THE CORRESPONDING VS_SERVICE_CASEID AND VS_ADOPTION_CASEID VALUES WILL BE NULL 
 
 IF  (VS_SERVICE_CASEID IS NULL AND VS_ADOPTION_CASEID IS NULL ) THEN 
 
  VS_SERVICE_CASEID:= ( SELECT servicecasenumber 
        FROM SERVICECASE 
         WHERE servicecasenumber = VL_SERVICECASENUMBER::varchar);
        
  VS_ADOPTION_CASEID:= ( SELECT adoptioncasenumber 
        FROM ADOPTIONCASE 
          WHERE adoptioncasenumber = VL_ADOPTIONCASENUMBER::varchar);
 END IF;
  

 -- Get CIS_CLIENT_ID
 BEGIN 
  SELECT person.cisclientid
   INTO VS_CIS_CLIENT_ID
  FROM person   
  WHERE person.cjamspid = VL_CLIENT_ID
   AND person.activeflag  = 1;
  
  -- RAISE NOTICE 'VS_CIS_CLIENT_ID%',VS_CIS_CLIENT_ID;--

  EXCEPTION WHEN OTHERS THEN
   VL_OUTPUT_SQLCODE  :=  SQLSTATE;
   VS_MESSAGE  := '(E&E) SELECT cisclientid FAILED FOR person ' || SQLERRM  ;
   RETURN;
 END ;

 -- Generate records for record type 55
 VS_RECORD_TYPE := '55';
 VL_RECORD_SEQUENCE := 000 ;
 VS_RECORD_SEQUENCE := '';

    IF  VS_RECORD_TYPE = '55' THEN

  IF VS_TRANSACTION_TYPE_CD IN ('10','15','20','30','40','62','64','70') THEN -- #12329
   ENE_OUT_PARENT_COL1 := 'X';
  ELSIF VS_TRANSACTION_TYPE_CD IN ('50') THEN
   ENE_OUT_PARENT_COL1 := 'N';
  ELSIF VS_TRANSACTION_TYPE_CD IN ('60')  THEN
   ENE_OUT_PARENT_COL1 := 'E';
  END IF ;

  OPEN CURSOR_PARENT;
  <<CURS_PARENT>>

  LOOP
   FETCH CURSOR_PARENT INTO VL_PARENT_ID ;
   EXIT CURS_PARENT WHEN NOT FOUND;
 
   VL_RECORD_SEQUENCE := VL_RECORD_SEQUENCE + 1 ;
   VS_RECORD_SEQUENCE := LTRIM(RTRIM((VL_RECORD_SEQUENCE::VARCHAR)));
    
   SELECT P.CJAMSPID 
    INTO VL_SC_CJAMSPID
   FROM PERSON P, 
    ACTOR A, 
    SERVICECASE SC  
   WHERE P.PERSONID = A.PERSONID 
    AND  A.SERVICECASEID = SC.SERVICECASEID 
    AND  SC.SERVICECASENUMBER = VL_SERVICECASENUMBER::varchar; --to fetch cjamspid for the corresponding  servicecase number 
      
   SELECT P.CJAMSPID  
    INTO VL_PD_CJAMSPID
   FROM PERSON P, 
    ACTOR A, 
    SERVICECASE SC, 
    TB_PAYMENT_DETAIL PD  
   WHERE P.PERSONID = A.PERSONID 
    AND A.SERVICECASEID = SC.SERVICECASEID 
    AND PD.CASE_ID = SC.SERVICECASENUMBER::BIGINT 
    AND PD.PAYMENT_ID = VL_OTHER_ID ;--- to fetch cjamspid for the corresponding payment ID 

            IF VS_TRANSACTION_TYPE_CD IN ('10','15','20','30','40','62','64','70') THEN    
    ENE_OUT_PARENT_COL1 := 'X'; -- #12329
            ELSIF VS_TRANSACTION_TYPE_CD IN ('50') THEN
    BEGIN
     SELECT PPT.cjamspid
      INTO VL_NEW_PARENT_ID
     FROM actorrelationship ACR, 
      Person PP, 
      person PPT, 
      intakeservicerequest ISR, 
      servicecase SC, 
      adoptioncase AC
     WHERE ACR.intakeserviceid = ISR.intakeserviceid
      AND ACR.person1id = PP.personid
      AND ACR.person2id = PPT.personid
      AND ISR.servicecaseid = SC.servicecaseid
      AND SC.servicecaseid = AC.servicecaseid
      AND (SC.servicecasenumber =  VS_SERVICE_CASEID OR AC.adoptioncasenumber = VS_ADOPTION_CASEID ); 
      
     -- RAISE NOTICE 'VL_NEW_PARENT_ID%',VL_NEW_PARENT_ID;--
        
     EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE := SQLSTATE;
      VS_MESSAGE  := '(E&E) SELECT FAILED FOR NEW PARENT FOR actorrelationship ' || SQLERRM  ;
      RETURN;
    END ;
    

    IF VL_NEW_PARENT_ID = VL_PARENT_ID THEN
     ENE_OUT_PARENT_COL1 := 'N';
    ELSE
     ENE_OUT_PARENT_COL1 := 'X';
    END IF;

            ELSIF VS_TRANSACTION_TYPE_CD IN ('60')  THEN
   
    IF VL_SC_CJAMSPID = VL_PARENT_ID THEN -- condition changed from vl_other_id 
     ENE_OUT_PARENT_COL1 := 'E';
    ELSIF VL_PD_CJAMSPID = VL_PARENT_ID THEN-- CONDITION ADDED 
     ENE_OUT_PARENT_COL1 := 'E';
    ELSE
     ENE_OUT_PARENT_COL1 := 'X';
    END IF;
            END IF ;  
  
   BEGIN
    -- RAISE NOTICE 'COL 2 TO 10';--
    SELECT  person.cisclientid,
     SUBSTRING(COALESCE(person.lastname,''),1,20),
     SUBSTRING(COALESCE(person.firstname,''),1,20),
     COALESCE(substring(btrim(person.middlename), 1, 10),'') as middlename,
     -- CIDM-2203
     substring((select value_text 
      from referencevalues rf  
     where rf.referencetypeid = 302
      and rf.activeflag = 1 
      and rf.value_text not in ('Ret.')
      and rf.ref_key = person.suffix ),1,5
     ) as suffix,
     /*
     CASE  WHEN person.suffix LIKE '%FIRST%' THEN 'I'
       WHEN person.suffix LIKE '%SECOND%' THEN 'II'
       WHEN person.suffix LIKE '%THIRD%' THEN 'III'
     ELSE SUBSTRING(person.suffix,1,5)
     END, -- changed from name_suffix
     */
     ( CASE WHEN (pi.personidentifiervalue ~ '^([0-9]+[.]?[0-9]*|[.][0-9]+)$') = false then 
      NULL 
       ELSE 
      pi.personidentifiervalue
       END ),
     -- (pi.personidentifiervalue),
     to_char(person.dob,'yyyymmdd')::INTEGER,
     ( CASE WHEN person.racetypekey LIKE '%WH%' THEN '1806'
      WHEN  person.racetypekey LIKE '%AI%' THEN '1803'
      WHEN  person.racetypekey LIKE '%AN%' THEN '1802'
      WHEN  person.racetypekey LIKE '%BA%' THEN '1801'
      WHEN  person.racetypekey LIKE '%AS%' THEN '6310'
      WHEN  person.racetypekey LIKE '%PI%' THEN '6311'
      ELSE '6312'
     END ) as racetypekey
    INTO ENE_OUT_PARENT_COL2,
     ENE_OUT_PARENT_COL3,
     ENE_OUT_PARENT_COL4,
     ENE_OUT_PARENT_COL5,
     ENE_OUT_PARENT_COL6,
     ENE_OUT_PARENT_COL8,
     ENE_OUT_PARENT_COL9,
     ENE_OUT_PARENT_COL10
    FROM person
     LEFT OUTER JOIN alias ON person.personid = alias.personid 
      AND alias.activeflag = 1
     join personidentifier pi on pi.personid = person.personid 
      and pi.personidentifiertypekey = 'SSN' 
      and pi.activeflag = 1
    WHERE person.cjamspid = VL_PARENT_ID
     AND person.activeflag =  1;
    
    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT FAILED FOR PARENT FOR person ' || SQLERRM  ;
     RETURN;
   END ;
    
   ---Gayathri Rajkumar Mapped Declined race to Unknown
   IF LTRIM(RTRIM(ENE_OUT_PARENT_COL10))   = '3004' THEN
    ENE_OUT_PARENT_COL10 := '2008-9' ;
    ELSIF LTRIM(RTRIM(ENE_OUT_PARENT_COL10)) = 'DC' THEN
    ENE_OUT_PARENT_COL10 := 'UN';
   END IF;
  
   BEGIN
    -- RAISE NOTICE 'COL 7';--
    SELECT  *
    INTO ENE_OUT_PARENT_COL7
    FROM ( SELECT SUBSTRING(COALESCE(alias.lastname,''),1,20)
       FROM alias, 
        person
       WHERE alias.personid = person.personid
        AND person.cjamspid =  VL_PARENT_ID
        AND alias.activeflag = 1
        AND alias.akatypetypekey = '2553'
       ORDER BY alias.insertedon DESC , alias.akaid DESC) AS A
    limit 1 ;
    
    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT PARENT AKA FAILED FOR alias ' || SQLERRM  ;
     RETURN;
   END ;
     
   BEGIN
    -- RAISE NOTICE 'COL11';--
    SELECT *
     INTO ENE_OUT_PARENT_COL11
    FROM  ( SELECT irv.cheesiecode 
       FROM actorrelationship ACR, 
        person PP, 
        person PPT,
        interfacereferencevalues irv 
       WHERE ACR.person1id = PP.personid
        AND PP.cjamspid = VL_PARENT_ID -- changed from cjamsID
        AND ACR.person2id = PPT.personid 
        AND PPT.cjamspid = VL_CLIENT_ID
        AND ACR.activeflag = 1
        AND PP.activeflag = 1
        AND PPT.activeflag = 1
        AND irv.desctypekey = ACR.relationshiptypekey
        AND irv.referencetype = 'relations'
        and (irv.desclevel2typekey = 'MFU' or PP.gendertypekey = irv.desclevel2typekey)
       ORDER BY ACR.startdate DESC) AS A
    limit 1 ;
   
    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT RELATIONSHIP TYPE CD FAILED FOR actorrelationship ' || SQLERRM  ;
     RETURN;
   END ;     
   
   
   BEGIN
    SELECT to_char(dob,'YYYYMMDD')
     INTO VD_CLIENT_DOB
    FROM person   
    WHERE person.cjamspid =  VL_CLIENT_ID
     AND person.activeflag = 1;
    
    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT DOB_DT FAILED FOR person ' || SQLERRM  ;
     RETURN;
   END ; 

 
   IF VD_CLIENT_DOB IS NULL THEN 
    ENE_OUT_PARENT_COL12 := '' ;
   ELSE
    BEGIN  
     -- RAISE NOTICE 'COL12';--
     SELECT  *
      INTO ENE_OUT_PARENT_COL12
     FROM ( SELECT  CASE  WHEN CMS.statustypekey = 'DV' THEN '1568'
            WHEN CMS.statustypekey = 'MR' THEN '1569' 
            WHEN CMS.statustypekey = 'LS' THEN '1570' 
            WHEN CMS.statustypekey = 'SG' THEN '1571' 
            WHEN CMS.statustypekey = 'WD' THEN '3673' 
            WHEN CMS.statustypekey = 'UK' THEN '7791' 
          ELSE '7791' --CMS.statustypekey
          END
        FROM personmaritalstatus CMS, 
         person p
        WHERE CMS.startdate <= VD_CLIENT_DOB
         AND (CMS.enddate IS NULL  OR CMS.enddate >=  VD_CLIENT_DOB)
         AND CMS.personid = P.personid   
         AND P.cjamspid  = VL_PARENT_ID
         AND CMS.activeflag = 1
        ORDER BY CMS.startdate DESC) AS A
     limit 1 ;
    
     EXCEPTION WHEN OTHERS THEN
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;
      VS_MESSAGE  := '(E&E) SELECT MARITAL STATUS FAILED FOR personmaritalstatus ' || SQLERRM  ;
      RETURN;
    END ;   
    
   END IF;
 
   BEGIN
    --RAISE NOTICE 'COL13 , 14';--
    SELECT  *
     INTO ENE_OUT_PARENT_COL13,
      ENE_OUT_PARENT_COL14
    FROM( SELECT  to_char(startdate,'yyyymmdd')::INTEGER,
       MARRIAGEPLACE
      FROM personmaritalstatus CMS, 
       person p
      WHERE CMS.personid = p.personid
       AND P.cjamspid = VL_PARENT_ID
       AND CMS.statustypekey IN ('1569', 'MR')
       AND CMS.activeflag = 1
      ORDER BY CMS.startdate DESC,  CMS.old_id DESC) AS A
    limit 1 ;

    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT MARRIAGE INFO FOR PARENT FAILED FOR personmaritalstatus ' || SQLERRM  ;
     RETURN;
   END ;  
    
   BEGIN
     -- RAISE NOTICE 'COL15 TO 18';--
     SELECT  *
    INTO ENE_OUT_PARENT_COL15,
     ENE_OUT_PARENT_COL16,
     ENE_OUT_PARENT_COL17,
     ENE_OUT_PARENT_COL18    
    FROM ( SELECT  SUBSTRING(alias.lastname,1,20), 
         SUBSTRING(alias.firstname,1,20), 
         COALESCE(substring(btrim(alias.middlename), 1, 10),'') as middlename,
         -- CIDM-2203
         substring((select value_text 
          from referencevalues rf  
         where rf.referencetypeid = 302
          and rf.activeflag = 1 
          and rf.value_text not in ('Ret.')
          and rf.ref_key = person.suffix ),1,5
         ) as suffix
         /*
         CASE  WHEN person.suffix LIKE '%FIRST%' THEN 'I'
           WHEN person.suffix LIKE '%SECOND%' THEN 'II'
           WHEN person.suffix LIKE '%THIRD%' THEN 'III'
          ELSE SUBSTRING(person.suffix,1,5) ---#28062019
         END
         */
       FROM alias, 
        person
       WHERE alias.personid = person.personid
        AND person.cjamspid = VL_PARENT_ID
        AND alias.activeflag = 1
       ORDER BY alias.insertedon DESC  --, alias.akaid DESC  -- check with HADI
       ) AS A
    limit 1 ;
 
    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT CLIENT AKA FOR PARENT FAILED FOR TB_CLIENT_AKA ' || SQLERRM  ;
     RETURN;
   END ; 
  
   BEGIN
     -- RAISE NOTICE 'COL19 TO 29 ';--
     SELECT  *
    INTO ENE_OUT_PARENT_COL19,
     ENE_OUT_PARENT_COL20,
     ENE_OUT_PARENT_COL21,
     ENE_OUT_PARENT_COL22,
     ENE_OUT_PARENT_COL23,
     ENE_OUT_PARENT_COL24,
     ENE_OUT_PARENT_COL25,
     ENE_OUT_PARENT_COL26,
     ENE_OUT_PARENT_COL27,
     ENE_OUT_PARENT_COL29
      FROM ( SELECT SUBSTRING(F_PLVALUE(personaddress.adrpredirtypekey,69),1,3),
        SUBSTRING(SUBSTRING(personaddress.address,'(^[0-9]+)'),1,9), -- personaddress.ADR_STREET_NO
        SUBSTRING(TRIM(SUBSTRING(personaddress.address,'([[:alpha:]\\s]+)')),1,50),
        SUBSTRING(personaddress.adrstreetsuffixtypekey,1,5),
        SUBSTRING(F_PLVALUE(personaddress.adrpostdirtypekey,69),1,3),
        SUBSTRING(personaddress.adrunitno,1,5),
        personaddress.city,
        personaddress.state,
        -- (SUBSTRING(COALESCE((personaddress.zipcode::VARCHAR),'00000'),1,5) || SUBSTRING(COALESCE((personaddress.adrzip4no::VARCHAR),'0000'),1,4))::INTEGER,
        SUBSTRING(coalesce(
          ( CASE WHEN (personaddress.zipcode ~ '^([0-9]+[.]?[0-9]*|[.][0-9]+)$') = false then 
            '00000' 
           ELSE 
            personaddress.zipcode
           END ), '00000' ), 1,5) ||
        SUBSTRING(COALESCE(
          (  CASE WHEN (personaddress.adrzip4no ~ '^([0-9]+[.]?[0-9]*|[.][0-9]+)$') = false then 
            '0000' 
           ELSE 
            personaddress.adrzip4no
           END 
          ), '0000'), 1, 4)::integer, 
        TO_CHAR(personaddress.personadrstartdate,'yyyymmdd')::INTEGER
      FROM  personaddress
      WHERE -- CIDM-2203
       -- personaddress.old_id::INTEGER = VL_PARENT_ID
       personaddress.personid = (select p.personid 
               from person p 
              where p.cjamspid = VL_PARENT_ID 
               and p.activeflag = 1
               order by (case when p.clientflag is null then 5  -- CIDM-4097
                when p.clientflag = 0 then 4
                else p.clientflag
                end ) 
               limit 1 
               )
       AND personaddress.personadrstartdate IS NOT NULL
       AND personaddress.personadrenddate IS NULL
       AND personaddress.activeflag = 1
      ORDER BY personadrstartdate DESC, old_id DESC) AS A
    limit 1 ;
 
    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT CLIENT CURRENT ADDRESS FOR PARENT FAILED FOR TB_CLIENT_ADDRESSES ' || SQLERRM  ;
     RETURN;
   END ; 

 
   BEGIN    
          -- RAISE NOTICE 'COL28';--
    SELECT *
     INTO ENE_OUT_PARENT_COL28
    FROM ( SELECT SUBSTRING(personphonenumber.personphonetypekey,1,10) 
       FROM personphonenumber, 
        person 
      WHERE personphonenumber.personid =  person.personid
       AND person.cjamspid = VL_PARENT_ID 
       AND personphonenumber.personphonetypekey IN ('1663','1664','1667','1672', 'S', 'P', 'O')
       AND personphonenumber.effectivedate IS NOT NULL
       AND personphonenumber.expirationdate IS NULL
       AND personphonenumber.activeflag = 1
       ORDER BY personphonenumber.effectivedate DESC , personphonenumber.old_id DESC
     ) AS A
    limit 1 ;

    EXCEPTION WHEN OTHERS THEN
     VL_OUTPUT_SQLCODE  :=  SQLSTATE;
     VS_MESSAGE  := '(E&E) SELECT CLIENT CURRENT CONTACT INFO FOR PARENT FAILED FOR personphonenumber ' || SQLERRM  ;
     RETURN;
   END ; 
        
   BEGIN
    -- RAISE NOTICE 'COL 30 TO 40 ';--
    SELECT *
