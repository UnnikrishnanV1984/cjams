CREATE OR REPLACE FUNCTION prov_getrolemappings(v_userid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
v_data json;
 
BEGIN 

if (v_userid IS NOT NULL) THEN 
  select array_to_json(array_agg(row_to_json(t)))
  from (
  select count(1) over() as totalcount, a.* from (
            select distinct rm.teamtypekey, r.name , r.id , r.description , (case when rm.teamtypekey = 'LDSS' then '1' when rm.teamtypekey = 'ASPROV' then '2' else '3' end) as priority  from muser m join rolemapping rm on rm.principalid = m.id and m.activeflag =1 and rm.activeflag =1 
            join role r on r.id = rm.roleid and r.activeflag =1 
            where m.securityusersid = v_userid :: character varying and rm.teamtypekey in ('LDSS','OLM','ASPROV','OLMDJS','OLMSSA','RESDJS')) a
  ) t into v_data;
END IF;

return v_data;
END;

$function$

