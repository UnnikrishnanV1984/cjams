CREATE OR REPLACE FUNCTION as_disableactivityreminder(v_intakeserviceid uuid, v_type character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$                                                                                                                                                         
                                                                                                                                                                       
 DECLARE                                                                                                                                                               
 
v_investigationid uuid;

v_activityid uuid;

 BEGIN   

    select investigationid into v_investigationid from Investigation where intakeserviceid =v_intakeserviceid limit 1;

    select activityid into v_activityid from activity where objectid=v_investigationid and activitytypekey=v_type and activeflag=1 limit 1;
                                     
    update activitytask set activeflag=0 where activityid=v_activityid and activeflag=1;
                                     
    update activity set activeflag=0 where objectid=v_investigationid and activitytypekey=v_type and activeflag=1;
                                                                                                              
                                                                                                                                                                       
     RETURN    'SUCCESS';                                                                                                                                              
 END;                                                                                                                                                                  
                                                                                                                                                                       
 $function$

