CREATE OR REPLACE FUNCTION distinctlistfocuspersoncasestatus(v_personid uuid)
 RETURNS TABLE(intakenumber character varying, intakeserviceid uuid, casenumber character varying, personid uuid)
 LANGUAGE plpgsql
AS $function$

BEGIN
  
RETURN query

select distinct on (fp.intakenumber)fp.intakenumber,fp.intakeserviceid,ir.servicerequestnumber as casenumber,fp.personid
from focuspersoncasestatus  fp
left join intakeservicerequest ir on fp.intakeserviceid = ir.intakeserviceid
where fp.personid = v_personid  and fp.intakeserviceid is not null
group by fp.focuspersonstatustypekey,fp.intakenumber,fp.intakeserviceid,ir.servicerequestnumber,fp.personid
union all
select fp.intakenumber,fp.intakeserviceid,ir.servicerequestnumber as casenumber,fp.personid
from focuspersoncasestatus  fp
left join intakeservicerequest ir on fp.intakeserviceid = ir.intakeserviceid
where fp.personid = v_personid and fp.intakeserviceid is null
group by fp.intakenumber,fp.intakeserviceid,ir.servicerequestnumber,fp.personid;

END;

$function$

