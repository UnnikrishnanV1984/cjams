CREATE OR REPLACE FUNCTION intakesdm11(sdmobj json, dispositioncode character varying, intakeserviceid uuid, securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

l_sdmid uuid;
v_sdmAP json;
v_sdmAM json;
v_sdmPR json;
v_sdmAV json;
v_securityusersid character varying;
v_date timestamp without time zone;
Status character varying;

BEGIN

v_date:= now() ;
v_sdmAV := sdmObj->>'allegedvictim'; /* from request*/
v_sdmAM :=  sdmObj->>'allegedmaltreator'; /* from request*/
v_sdmPR := sdmObj->>'provider'; /* from request*/
v_securityusersid := securityusersid; /* from request*/
  
 
  INSERT INTO intakeservicerequestsdm(
       intakeserviceid, ismaltreatment, referralname, 
       referraldob, referralid, countyid, malpa_suspeciousdeath, 
       malpa_nonaccident, malpa_injuryinconsistent, malpa_insjury, malpa_childtoxic, 
       malpa_caregiver, malsa_sexualmolestation, malsa_sexualact, malsa_sexualexploitation, 
       malsa_physicalindicators, neggn_suspiciousdeath, neggn_signsordiagnosis, 
       neggn_inadequatefood, neggn_exposuretounsafe, neggn_inadequateclothing, 
       neggn_inadequatesupervision, neggn_childdischarged, negfp_cargiverintervene, 
       negab_abandoned, neguc_leftunsupervised, neguc_leftaloneinappropriatecare, 
       neguc_leftalonewithoutsupport, negrh_priordeath, negrh_sexualperpetrator, 
       negrh_basicneedsunmet, negmn_unreasonabledelay, menab_psycologicalability, 
       menng_psycologicalability, recsc_screenout, recsc_scrrenin, recovr_no, 
       recovr_scrrenin, reccps_screenout, rec_imlist, rec_noimmediate, 
       rec_reportallegtion, officerfirstname, officermiddlename, officerlastname, 
       badgenumber, recordnumber, reportdate, worker, workerdate, supervisor, 
       supervisordate, activeflag, updatedby,  insertedby, issexualabuse ,isoutofhome ,
       isdeathorserious ,isrisk ,isreportmeets ,issignordiagonises ,ismaltreatment3yrs , ismaltreatment12yrs ,
       ismaltreatment24yrs ,isactiveinvestigation ,isreportedhistory ,ismultiple ,isdomesticvoilence ,isthread ,
       islawenforcement , iscourtiinvestigation ,isar ,isir)

      SELECT intakeserviceid,ismaltreatment,referralname,referraldob,referralid, countyid, malpa_suspeciousdeath,
    malpa_nonaccident,malpa_injuryinconsistent,malpa_insjury,malpa_childtoxic,
    malpa_caregiver,malsa_sexualmolestation,malsa_sexualact,malsa_sexualexploitation,
    malsa_physicalindicators,neggn_suspiciousdeath,neggn_signsordiagnosis,neggn_inadequatefood,
    neggn_exposuretounsafe,neggn_inadequateclothing,neggn_inadequatesupervision,neggn_childdischarged,
    negfp_cargiverintervene,negab_abandoned,neguc_leftunsupervised,neguc_leftaloneinappropriatecare,
    neguc_leftalonewithoutsupport,negrh_priordeath,negrh_sexualperpetrator,
    negrh_basicneedsunmet,negmn_unreasonabledelay,menab_psycologicalability,
    menng_psycologicalability,recsc_screenout,recsc_scrrenin,recover_no,
    recover_scrrenin,reccps_screenout,rec_imlist,rec_noimmediate
    ,rec_reportallegtion,officerfirstname ,
    officermiddlename,officerlastname,badgenumber,recordnumber,reportdate,
    worker,workerdate,supervisor,supervisordate,1,v_securityusersid,v_securityusersid,
    issexualabuse ,isoutofhome ,isdeathorserious ,isrisk ,isreportmeets ,issignordiagonises ,ismaltreatment3yrs ,          ismaltreatment12yrs ,ismaltreatment24yrs ,isactiveinvestigation ,isreportedhistory ,ismultiple ,isdomesticvoilence 
    ,isthread ,islawenforcement , iscourtiinvestigation ,isar ,isir 

    FROM json_to_recordset(sdmObj ) as x(
    "referralname" character varying,
    "referraldob" date,
    "referralid" character varying,
    "countyid" uuid,
    "ismaltreatment" bool,
    "malpa_suspeciousdeath" bool ,
    "malpa_nonaccident" bool ,
    "malpa_injuryinconsistent" bool ,
    "malpa_insjury" bool ,
    "malpa_childtoxic" bool ,
    "malpa_caregiver" bool ,
    "malsa_sexualmolestation" bool ,
    "malsa_sexualact" bool ,
    "malsa_sexualexploitation" bool ,
    "malsa_physicalindicators" bool ,
    "neggn_suspiciousdeath" bool ,
    "neggn_signsordiagnosis" bool ,
    "neggn_inadequatefood" bool ,
    "neggn_exposuretounsafe" bool ,
    "neggn_inadequateclothing" bool ,
    "neggn_inadequatesupervision" bool ,
    "neggn_childdischarged" bool ,
    "negfp_cargiverintervene" bool ,
    "negab_abandoned" bool ,
    "neguc_leftunsupervised" bool ,
    "neguc_leftaloneinappropriatecare" bool ,
    "neguc_leftalonewithoutsupport" bool ,
    "negrh_priordeath" bool ,
    "negrh_sexualperpetrator" bool ,
    "negrh_basicneedsunmet" bool ,
    "negmn_unreasonabledelay" bool ,
    "menab_psycologicalability" bool ,
    "menng_psycologicalability" bool ,
    "recsc_screenout" bool ,
    "recsc_scrrenin" bool ,
    "recovr_maltreatment" bool ,
    "reccps_maltreatment" bool ,
    "rec_imlist" bool ,
    "rec_noimmediate" bool ,
    "rec_reportallegtion" bool ,
    "officerfirstname" character varying,
    "officermiddlename" character varying,
    "officerlastname" character varying,
    "badgenumber" character varying,
    "recordnumber" character varying,
    "reportdate" date,
    "worker" character varying,
    "workerdate" date,
    "supervisor" character varying,
    "supervisordate" date,
    "recover_no"     bool,
    "recover_scrrenin" bool,
    "reccps_screenout" bool,
    "issexualabuse" bool ,
    "isoutofhome" bool ,
    "isdeathorserious" bool ,
    "isrisk" bool ,
    "isreportmeets" bool ,
    "issignordiagonises" bool ,
    "ismaltreatment3yrs" bool ,
    "ismaltreatment12yrs" bool ,
    "ismaltreatment24yrs" bool ,
    "isactiveinvestigation" bool ,
    "isreportedhistory" bool ,
    "ismultiple" bool ,
    "isdomesticvoilence" bool ,
    "isthread" bool ,
    "islawenforcement" bool ,
    "iscourtiinvestigation" bool ,
    "isar" bool ,
    "isir" bool 

)
    
                 RETURNING "intakeservicerequestsdmid" INTO l_sdmid;

 INSERT INTO intakeservrequestSDMMaltreatment( intakeservicerequestsdmid,
                                               maltreatmenttype,
                                               maltreatorsname,
                                               activeflag,
                                               updatedby,
                                               updatedon,
                                               effectivedate,
                                               insertedby,
                                               insertedon)
  SELECT l_sdmid, 'AV',maltreatorsname,1,v_securityusersid, v_date,v_date,v_securityusersid, v_date 
  FROM json_to_recordset(v_sdmAV ) as x("intakeservicerequestsdmid" uuid,
        "maltreatorsname" character varying);

        
  INSERT INTO intakeservrequestSDMMaltreatment( intakeservicerequestsdmid,
               maltreatmenttype,
               maltreatorsname,
               activeflag,
               updatedby,
               updatedon,
               effectivedate,
               insertedby,
               insertedon)
  SELECT l_sdmid, 'AM',maltreatorsname,1,v_securityusersid, v_date,v_date,v_securityusersid, v_date 
                FROM json_to_recordset(v_sdmAM ) as x("intakeservicerequestsdmid" uuid,
        "maltreatorsname" character varying );


          
                INSERT INTO intakeservrequestSDMMaltreatment( intakeservicerequestsdmid,
                                               maltreatmenttype,
                                               maltreatorsname,
                                               activeflag,
                                               updatedby,
                                               updatedon,
                                               effectivedate,
                                               insertedby,
                                               insertedon)
  SELECT l_sdmid, 'PR',maltreatorsname,1,v_securityusersid, v_date,v_date,v_securityusersid, v_date 
  FROM json_to_recordset(v_sdmAP ) as x( "intakeservicerequestsdmid" uuid,
         "maltreatorsname" character varying);



 Status := 'SUCCESS';


RETURN  Status;

END

$function$

