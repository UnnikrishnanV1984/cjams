DEALLOCATE roles_cursor;*/

Update WaiverDAData Set APRoles = GetActorRoles(PernId);
      
-- update all records with a DA Complete Date with the 1st occurance of the StatusDate where DA Status is Closed
UPDATE WaiverDAData
 SET DACompletionDate = ISRD.StatusDate 
 FROM WaiverDAData as WDAD
      JOIN IntakeServiceRequestDispositionCode AS ISRD ON ISRD.IntakeServiceId = cast(WDAD.IntakeServiceId as uuid)      
 WHERE ISRD.StatusDate in (SELECT MIN(ISRD.StatusDate)
         FROM IntakeServiceRequestDispositionCode AS ISRD 
          LEFT OUTER JOIN IntakeSerReqStatusType AS ISRS ON ISRS.IntakeSerReqStatusTypeId = ISRD.IntakeSerReqStatusTypeId
          JOIN IntakeServiceRequest AS ISR ON ISR.IntakeServiceId = ISRD.IntakeServiceId
          JOIN Investigation AS I ON I.IntakeServiceId = ISR.IntakeServiceId
          JOIN ServiceRequestSubType AS SRST ON SRST.ServiceRequestSubTypeId = ISR.IntakeServiceRequestClassId
          LEFT OUTER JOIN ServiceRequestTypeConfigDispositionCode AS SRTCD ON 
         SRTCD.ServiceRequestTypeConfigIdDispostionId = ISRD.ServiceRequestTypeConfigIdDispostionId
         WHERE ISRD.IntakeServiceId = cast(WDAD.IntakeServiceId as uuid)  
          AND ISRS.Description in ('Closed')      
          AND SRST.Description in ('Class I','Class II')
          AND ISR.insertedby <> 'S-1-5-21-508124448-3695470602-466989033-127552' -- no conversion data
          AND ISR.ActiveFlag = '1'
          AND ISRD.ActiveFlag = '1');
          
-- update all records that have a StatausDate of NULL by querying the very last disposition record
UPDATE WaiverDAData
 SET DAStatusDate = ISRD.insertedon      
 FROM WaiverDAData WDAD
 JOIN IntakeServiceRequestDispositionCode AS ISRD ON ISRD.IntakeServiceId = WDAD.IntakeServiceId::uuid
 WHERE WDAD.DAStatusDate IS NULL
 AND ISRD.insertedon = ( SELECT MIN ( insertedon) 
                         FROM IntakeServiceRequestDispositionCode a
                         WHERE a.IntakeServiceId = ISRD.IntakeServiceId );  
                  
         
-- update all records with a null seenwithin field by querying the very first disposition record
UPDATE WaiverDAData
 SET SeenWithin = ISRD.SeenWithIn,
     DateSeen = ISRD.DateSeen
 FROM WaiverDAData WDAD
 JOIN IntakeServiceRequestDispositionCode  AS ISRD ON ISRD.IntakeServiceId = WDAD.IntakeServiceId::uuid
 WHERE WDAD.SeenWithIn IS NULL
 AND ISRD.insertedon = (SELECT MAX ( insertedon) 
                         FROM IntakeServiceRequestDispositionCode a
                         WHERE a.IntakeServiceId = ISRD.IntakeServiceId );

-- check for policy task exceptions
UPDATE WaiverDAData
   SET ExceptType = TET.TypeDescription,
       ExceptRsn = TERT.TypeDescription,
       ExceptStatus = ITS.TaskExceptionStatusTypeKey,
       ReqDate = ITS.ExceptionRequestDate,
       ExceptNote = ITS.ExceptionReason,
       DecisionBy = ITS.ExceptionDecisionBy,
       DecisionDate = ITS.ExceptionDecisionDate
  FROM WaiverDAData WDAD
  LEFT JOIN Activity AS A ON A.ObjectId = WDAD.InvID::uuid AND A.AMActivityId in ('866BA3EB-B809-419C-B603-8DB55F4EE796','F142AF71-4EC7-4C25-9071-DBBB37DC0036') -- ('Interview Class I Reported Adult','Interview Class II Reported Adult')
  JOIN ActivityTask AS AT ON AT.ActivityId = A.ActivityId
  JOIN InvestigationTask ITS ON ITS.ActivityTaskId = AT.ActivityTaskId
  JOIN TaskExceptionType AS TET ON TET.TaskExceptionTypeKey = ITS.TaskExceptionTypeKey
  JOIN TaskExceptionReasonType AS TERT ON TERT.TaskExceptionReasonTypeKey = ITS.TaskExceptionReasonTypeKey;

-- get the load number
UPDATE WaiverDAData
  SET Worker = TM.LoadNumber
  FROM WaiverDAData WDAD
  JOIN AreaTeamMemberServiceRequest ARTS ON ARTS.IntakeServiceId = WDAD.IntakeServiceId::uuid AND ARTS.ActiveFlag = '1'
  JOIN TeamMember TM ON TM.TeamMemberId = ARTS.TeamMemberId;

-- get DCN, region, and county
UPDATE WaiverDAData
   SET DCN = PID.PersonIdentifierValue,
       Region = R.RegionName,
       County = CASE WHEN PA.county IS NULL
                        THEN COALESCE(C.CountyName,'')
                     ELSE
                        COALESCE(PA.county,'')
                END
  FROM WaiverDAData WDAD
  JOIN IntakeServiceRequestActor ISRA ON ISRA.IntakeServiceId = WDAD.IntakeServiceId::uuid
  JOIN Actor A ON A.ActorId = ISRA.ActorId 
  LEFT JOIN PersonIdentifier PID ON PID.PersonId = A.PersonId AND PID.PersonIdentifierTypeKey = 'DCN'
  LEFT JOIN PersonAddress PA ON PA.PersonAddressId = ISRA.RoutingAddressId
  LEFT JOIN County C ON C.zipcode::character varying = PA.zipcode OR C.CountyName = PA.county
  LEFT JOIN Region R ON R.RegionId = C.RegionId
  WHERE ISRA.IntakeServiceRequestPersonTypeKey = 'RA';

-- return all values  

RETURN QUERY    
SELECT f_WavData.DAOpenDate,
       f_WavData.DANumber,
       f_WavData.Region,
       f_WavData.County,
       f_WavData.DAClass,       
       f_WavData.SeenWithin,
       f_WavData.DateSeen,
       f_WavData.DAStatus,
       f_WavData.DADisposition,
       f_WavData.DAStatusDate,
       f_WavData.DACompletionDate,
       f_WavData.DCN,
       f_WavData.Worker,
       f_WavData.ExceptType,
       f_WavData.ExceptRsn,
       f_WavData.ReqDate,
       f_WavData.ExceptStatus,
       f_WavData.DecisionDate,
       f_WavData.DecisionBy,
       f_WavData.APFirstName,
       f_WavData.APLastName,
       f_WavData.APDOB,
       f_WavData.APGender,
       f_WavData.APRace,
       f_WavData.APRelationshipToRA,       
       f_WavData.APRoles,
       f_WavData.RAFirstName,
       f_WavData.RALastName,
       f_WavData.RADCN,
       f_WavData.AllegationName,
       f_WavData.AllegationStatus,
       f_WavData.Indicators,
       f_WavData.LinkPerson,
       f_WavData.LinkPersonRole,
       f_WavData.AllegationEDL
       --StatementOfEvidence                                         
  FROM WaiverDAData f_WavData
 ORDER BY DANumber;
 
Drop Table waiverdadata;
END;
$function$

