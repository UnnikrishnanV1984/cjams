CREATE OR REPLACE FUNCTION perpetratordemographics(p_begindate timestamp without time zone, p_enddate timestamp without time zone)
 RETURNS TABLE(daopendate timestamp without time zone, danumber character varying, region character varying, county character varying, daclass character varying, seenwithin integer, dateseen timestamp without time zone, dastatus character varying, dadisposition character varying, dastatusdate timestamp without time zone, dacompletiondate timestamp without time zone, dcn character varying, worker character varying, excepttype character varying, exceptrsn text, reqdate timestamp without time zone, exceptstatus character varying, decisiondate timestamp without time zone, decisionby character varying, apfirstname character varying, aplastname character varying, apdob character varying, apgender character varying, aprace character varying, aprelationshiptora character varying, aproles character varying, rafirstname character varying, ralastname character varying, radcn character varying, allegationname character varying, allegationstatus character varying, indicators character varying, linkperson character varying, linkpersonrole character varying, allegationedl character varying)
 LANGUAGE plpgsql
AS $function$   
    --Author: Kristy LaRose
 --Purpose: Used to run Perpetrator Demographics data set / report
 --Description: Pulls ALL DA Status (except Cancelled) for ANE Class I and II
  
 --Current columns in data set / report:
 --DAOpenDate, DANumber, Region, County, DAClass, SeenWithin, DateSeen, DAStatus, DADisposition, 
 --DAStatusDate, DACompletionDate, DCN, Worker, ExceptType, ExceptRsn, ReqDate, ExceptStatus, DecisionDate, DecisionBy, 
 --APFirstName, APLastName, APDOB, APGender, APRace, APRelationshipToRA, APRoles,  
 --RAFirstName, RALastName, RADCN 
 --Allegation, AllegationStatus, LinkPerson, AllegationEDL 

DECLARE 
AllegationEDL character varying;
v_PerId CHAR(36);      
 
BEGIN   

--;

CREATE TEMP TABLE  WaiverDAData ( IntakeServiceID CHAR(36),
      DAOpenDate TIMESTAMP,
      DANumber VARCHAR(50),
      Region VARCHAR(10),
      County VARCHAR(256),
      DCN VARCHAR(100),
      Worker VARCHAR(100),      
                                 DAClass VARCHAR(10),
                                 DAStatus VARCHAR(250),        
                                 DAStatusDate timestamp,
                                 DACompletionDate timestamp,
                                 SeenWithin INT,
                                 DateSeen TIMESTAMP,
                                 DADisposition VARCHAR(250),
                                 InvID CHAR(36),
                                 ExceptType VARCHAR(250),
                                 ExceptRsn TEXT,
                                 ExceptStatus VARCHAR(250),
                                 ReqDate TIMESTAMP,
                                 ExceptNote TEXT,
                                 DecisionBy VARCHAR(50),
                                 DecisionDate TIMESTAMP,
                                 APFirstName VARCHAR(250),
                                 APLastName VARCHAR(250),
                                 APDOB VARCHAR(25),
                                 APGender VARCHAR(1),
                                 APRace VARCHAR(50),
                                 APRelationshipToRA VARCHAR(50),
                                 PernId uuid,
                                 APRoles VARCHAR(100),
                                 RAFirstName VARCHAR(250),
                                 RALastName VARCHAR(250),
                                 RADCN VARCHAR(12),  
                                 AllegationName VARCHAR(250),
                                 AllegationStatus VARCHAR (25),
                                 Indicators VARCHAR(500),
                                 LinkPerson VARCHAR(500),
                                 LinkPersonRole VARCHAR(10),
                                 AllegationEDL VARCHAR(10)
                                 --StatementOfEvidence VARCHAR(MAX)                                 
                                 );
                                 
    INSERT INTO WaiverDAData (IntakeServiceID ,
                               DAOpenDate, 
                               DANumber, 
                               DAClass, 
                               DAStatus, 
                               DAStatusDate, 
                               SeenWithin, 
                               DateSeen, 
                               DADisposition,
                               InvID,
                               APFirstName,
                               APLastName,
                               APDOB,
                               APGender,
                               APRace,
                               APRelationshipToRA,
                               PernId,
                               APRoles,
                               RAFirstName,
                               RALastName,
                               RADCN,  
                               AllegationName,
                               AllegationStatus,
                               Indicators,
                               LinkPerson,
                               LinkPersonRole,
                               AllegationEDL
                               --StatementOfEvidence
                               )
 SELECT ISR.IntakeServiceId,
        ISR.ReportedDate AS DAReceived,
           ISR.ServiceRequestNumber AS DA,
           SRST.ClassKey AS Class,
           ISRS.Description AS Status,
           ISRD.StatusDate AS StatusDate,
           ISRD.SeenWithIn,
           ISRD.DateSeen,
           SRTCD.Description AS Disposition,
           I.InvestigationId,
           --I.InvestigationSummary,           
           PAP.FirstName AS APFirstName,
           PAP.LastName AS APLastName,
           CAST(PAP.DOB AS DATE) AS APDOB,
           PAP.GenderTypeKey AS APGender,
           RT.TypeDescription AS APRace,
           RelT.Description AS APRelationshipToRA,
           PAP.PersonId AS PernId,
           ISRA.IntakeServiceRequestPersonTypeKey AS APRoles, -- place holder, will update later in script
           PRA.FirstName AS RAFirstName,
           PRA.LastName AS RALastName,
           PID.PersonIdentifierValue AS RADCN,
           INVA.Name AS AllegationName,
           INVAST.TypeDescription AS AllegationStatus,
           INVA.Indicators,
           RTRIM(P.FirstName)||' '||RTRIM(P.MiddleName)||' '||RTRIM(P.LastName) AS LinkPerson,           
           ISRA.IntakeServiceRequestPersonTypeKey AS LinkPersonRole,
           CASE INVA.Financial WHEN '1' THEN 'YES' WHEN '0' THEN 'NO' ELSE 'NULL' END 
           --INTO AllegationEDL 
           --INVAA.StatementOfEvidence   
     FROM IntakeServiceRequestDispositionCode AS ISRD 
     LEFT OUTER JOIN IntakeSerReqStatusType AS ISRS ON ISRS.IntakeSerReqStatusTypeId = ISRD.IntakeSerReqStatusTypeId AND ISRS.ActiveFlag = '1'
     JOIN IntakeServiceRequest AS ISR ON ISR.IntakeServiceId = ISRD.IntakeServiceId AND ISR.ActiveFlag = '1'
     JOIN ServiceRequestSubType AS SRST ON SRST.ServiceRequestSubTypeId = ISR.IntakeServiceRequestClassId
     -- get AP info
     LEFT JOIN IntakeServiceRequestActor AS ISRAAP ON ISRAAP.IntakeServiceId = ISR.IntakeServiceId AND ISRAAP.IntakeServiceRequestPersonTypeKey = 'AP'
     LEFT JOIN Actor AS AAP ON AAP.ActorId = ISRAAP.ActorId AND AAP.ActiveFlag = '1'
     LEFT JOIN Person AS PAP ON PAP.PersonId = AAP.PersonId AND PAP.ActiveFlag = '1'
     LEFT JOIN PersonRaceTypeMap AS PRTM ON PRTM.PersonId = PAP.PersonId AND PRTM.ActiveFlag = '1'
     LEFT JOIN RaceType AS RT ON RT.RaceTypeKey = PRTM.RaceTypeKey AND RT.ActiveFlag = '1'
     -- get AP relationship to RA
     LEFT JOIN ActorRelationship AS AR ON AR.ActiveFlag = '1' AND AR.IntakeServiceRequestActorId = ISRAAP.IntakeServiceRequestActorId
     JOIN RelationshipType AS RelT ON RelT.ActiveFlag = '1' AND RelT.RelationshipTypeKey = AR.RelationshipTypeKey
     -- get RA info
     LEFT JOIN IntakeServiceRequestActor AS ISRARA ON ISRARA.IntakeServiceId = ISR.IntakeServiceId AND ISRARA.IntakeServiceRequestPersonTypeKey = 'RA'
     LEFT JOIN Actor AS ARA ON ARA.ActorId = ISRARA.ActorId AND ARA.ActiveFlag = '1'
     LEFT JOIN Person AS PRA ON PRA.PersonId = ARA.PersonId AND PRA.ActiveFlag = '1'
     LEFT JOIN PersonIdentifier AS PID ON PID.PersonId = PRA.PersonId AND PID.PersonIdentifierTypeKey = 'DCN' AND PID.ActiveFlag = '1'
     -- get investigation info
     LEFT JOIN Investigation AS I ON I.IntakeServiceId = ISR.IntakeServiceId AND I.ActiveFlag = '1' 
    --AND I.InvestigationID IS NOT NULL AND I.CompletionDate = (SELECT MAX(CompletionDate)
                   --FROM Investigation
                   --WHERE IntakeServiceId = I.IntakeServiceId
                   --AND ActiveFlag = '1')
  -- get allegation info
     LEFT JOIN InvestigationAllegation AS INVA ON INVA.InvestigationId = I.InvestigationID AND INVA.ActiveFlag = '1'
     -- get LinkPerson
     LEFT JOIN InvestigationAllegationActor AS INVAA ON INVAA.InvestigationAllegationId = INVA.InvestigationAllegationId AND INVAA.ActiveFlag = '1'   
     LEFT JOIN IntakeServiceRequestActor AS ISRA ON ISRA.IntakeServiceRequestActorId = INVAA.IntakeServiceRequestActorId
     LEFT JOIN Actor AS A ON A.ActorId = ISRA.ActorId AND A.ActiveFlag = '1'
     LEFT JOIN Person AS P ON P.PersonId = A.PersonId AND P.ActiveFlag = '1'
     -- get allegation status
     LEFT JOIN InvestigationAllegationStatusType AS INVAST ON INVAST.InvestigationAllegationStatusTypeKey = INVAA.InvestigationAllegationStatusTypeKey AND INVAST.ActiveFlag = '1'
     -- get disposition info
     LEFT OUTER JOIN ServiceRequestTypeConfigDispositionCode AS SRTCD ON 
             SRTCD.ServiceRequestTypeConfigIdDispostionId = ISRD.ServiceRequestTypeConfigIdDispostionId AND SRTCD.ActiveFlag = '1'
    WHERE ISRS.Description in ('Pending Supervisor Review',
                               'Pending',
                               'In Progress',
                               'Ready for First Review',
                               'Open',                               
                               'Reviewed',
                               'Closed',
                               'Pending EDL Review'
                               --'Cancelled'
                               )
      AND SRST.Description in ('Class I','Class II')
      AND ISR.insertedby <> 'S-1-5-21-508124448-3695470602-466989033-127552' -- no conversion data
      AND ISR.ActiveFlag = '1'
      AND ISRD.ActiveFlag = '1'
      AND ISRD.insertedon = (SELECT MAX(insertedon) 
                               FROM IntakeServiceRequestDispositionCode a
                              WHERE a.IntakeServiceId = ISRD.IntakeServiceId
                                AND a.ActiveFlag = '1')
      --AND ISR.ReportedDate BETWEEN '02/18/2015' AND '02/18/2015'
      AND CAST(ISR.ReportedDate AS DATE) BETWEEN p_BeginDate AND p_EndDate
      order by ISR.ServiceRequestNumber;

--Update WaiverDAData.APRoles with a LIST of ALL APRoles the AP has been associated with.
--the below only list the first occurance
--UPDATE WDAD
--SET WDAD.APRoles = ACT.ActorType
--FROM WaiverDAData WDAD
--     JOIN [Qnet].[dbo].[Actor] AS ACT ON ACT.PersonId = WDAD.PernID 
--the below updates WaiverDAData.APRoles with a LIST of all APRoles
  
/*DECLARE roles_cursor CURSOR FOR
 SELECT DISTINCT ACT.PersonId
 FROM  Actor as ACT, WaiverDAData WDAD   
 WHERE ACT.ActiveFlag = '1' AND ACT.PersonId = WDAD.PernId
 ORDER BY ACT.PersonId;

--OPEN roles_cursor;

FETCH NEXT FROM roles_cursor INTO v_PerId;
WHILE FOUND
LOOP
  UPDATE WDAD
        SET WDAD.APRoles = GetActorRoles(v_PerId)
        FROM WaiverDAData WDAD
        WHERE WDAD.PernId = v_PerId;  
