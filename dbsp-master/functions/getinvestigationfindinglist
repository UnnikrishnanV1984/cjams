CREATE OR REPLACE FUNCTION getinvestigationfindinglist(v_servicerequestid uuid)
 RETURNS TABLE(investigationfindingid uuid, intakeserviceid uuid, invsfindingjurisdiction character varying, invsfindingaddress character varying, investigationfindingdate timestamp without time zone, socialhistorydesc character varying, familyhistorydesc character varying, educationalfactors character varying, psychiatricimportinfo boolean, psychiatricdesc character varying, financialimportinfo boolean, assetdetailsdesc character varying, legalinfopoa character varying, legalinforeppayee character varying, legalinfocourtinvolved character varying, legalinfodesc character varying, clentcapacitydesc character varying, reasonclosingdesc character varying, apsworkersigndate timestamp without time zone, supervisorsigndate timestamp without time zone, investigationfindingtypeperson json, investigationfindingguardian json)
 LANGUAGE plpgsql
AS $function$

begin
 
 RETURN QUERY 
 
      SELECT inf.investigationfindingid,  inf.intakeserviceid, inf.invsfindingjurisdiction, inf.invsfindingaddress,
      inf.investigationfindingdate, inf.socialhistorydesc, inf.familyhistorydesc, inf.educationalfactors,
      inf.psychiatricimportinfo, inf.psychiatricdesc, inf.financialimportinfo, inf.assetdetailsdesc,
      inf.legalinfopoa, inf.legalinforeppayee, inf.legalinfocourtinvolved, inf.legalinfodesc, inf.clentcapacitydesc,
      inf.reasonclosingdesc, inf.apsworkersigndate, inf.supervisorsigndate,
      
      
      
  
         
       (SELECT  json_agg(typeperson) as investigationfindingtypeperson  FROM(
      SELECT  IFTP.investigationfindingid,IFTP.intakeservicerequestactorid,IFTP.invesfindingpersonname,
      IFTP.invsfindingpersonsupporttype,IFTP.invesfindingpersondesc,IFTP.investigationfindingpersontype,
      (p.firstname ||' '|| p.lastname) as personname
      from investigationfinding infi
      inner join investigationfindingtypeperson IFTP on infi.investigationfindingid=IFTP.investigationfindingid
       left join intakeservicerequestactor  ISRA on IFTP.intakeservicerequestactorid=ISRA.intakeservicerequestactorid
      left  JOIN  actor  act  ON  act.actorid  =  ISRA.actorid  AND  act.activeflag  =1
      left  join person p   on p.personid=act.personid and p.activeflag=1
      WHERE  infi.intakeserviceid=v_servicerequestid   and   IFTP.activeflag  =1    )
                                      as typeperson    )::json   ,
                                      
                                      
                                      
           (SELECT  json_agg(guardian) as investigationfindingguardian  FROM(
      SELECT  IFG.investigationfindingid,IFG.intakeservicerequestactorid,      
      (p.firstname ||' '|| p.lastname) as personname
      from investigationfinding inf
      inner join investigationfindingguardian IFG on inf.investigationfindingid=IFG.investigationfindingid
       inner join intakeservicerequestactor  ISRA on IFG.intakeservicerequestactorid=ISRA.intakeservicerequestactorid
      INNER  JOIN  actor  act  ON  act.actorid  =  ISRA.actorid  AND  act.activeflag  =1
      INNER  join person p   on p.personid=act.personid and p.activeflag=1
      WHERE  inf.intakeserviceid=v_servicerequestid  and IFG.activeflag=1   )
                                      as guardian    )::json                              
                                      
                                      
                                        
                            
      
      
FROM investigationfinding inf

where inf.intakeserviceid=v_servicerequestid  and inf.activeflag=1

order by inf.investigationfindingid desc limit 1;
                
end;

$function$

