CREATE OR REPLACE FUNCTION sp_nytd_data_population(vi_online_client_id bigint, vd_run_dt character varying, run_sw character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE

VS_STMT VARCHAR(5500) DEFAULT '';
VS_STMT1 VARCHAR(5500) DEFAULT '';
VS_STMT2 VARCHAR(5500) DEFAULT '';

VS_COMBINED_VAL1 VARCHAR(20000) DEFAULT '';
VS_COMBINED_VAL2 VARCHAR(2000) DEFAULT '';
VS_OLD_DETVAL VARCHAR DEFAULT '';
VS_CUR_DETVAL VARCHAR DEFAULT '';
VS_ELEVAL VARCHAR(250) DEFAULT '';

VL_OUTPUT_SQLCODE VARCHAR;
VD_RUN_DATE DATE;
VI_FNYEAR INTEGER;
VI_AGE INTEGER;
VD_START_DT DATE;
VD_END_DT DATE;
VD_START_DT_SRV DATE;
VD_END_DT_SRV DATE;
VD_START_DT1 DATE;
VD_END_DT1 DATE;
VD_START_DT_SRV1 DATE;
VD_END_DT_SRV1 DATE;
VD_START_DT_SRV_PREV DATE;
VD_END_DT_SRV_PREV DATE;
VI_SUMMARY_ID uuid;
VI_OLD_SUMMARY_ID uuid;
VI_REPORTING_PERIOD INTEGER;
VI_45_DAYS_CHK INTEGER;
VL_ERRCODE INTEGER DEFAULT 0;
VS_REPORT_TYPE_CD VARCHAR(6);
VS_COUNTY_CD VARCHAR(20);
VI_CLIENT_ID BIGINT;
VS_STATE VARCHAR(8) DEFAULT 'Maryland'; --element 1
VS_REPORT_DT VARCHAR(10);
VI_RECORD_NO INTEGER;
VS_DOB_DT VARCHAR(20);
VS_SEX VARCHAR(6);
VS_RACE_CD VARCHAR(5);
VS_SECONDARY_RACE_CD VARCHAR(5);
VS_RACE_TX VARCHAR(5);
VS_HISPANIC VARCHAR(8);
VS_FOSTER_CARE_STATUS VARCHAR(3) default 'No';
VS_LOCAL_AGENCY VARCHAR(3);
VS_TRIBE VARCHAR(3);
VS_DELINQUENT VARCHAR(3);
VS_EDUCATION VARCHAR(100);
VS_SPC_EDUCATION VARCHAR(10);
VS_INDEPENDENT_ASSESS VARCHAR(3);
VS_ACADEMIC_SUPPORT VARCHAR(3);
VS_POST_SECNDRY_EDU_SUPPORT VARCHAR(3);
VS_CAREER_PREPARATION VARCHAR(3);
VS_VOC_TRAINING VARCHAR(3);
VS_FIN_MANGT VARCHAR(3);
VS_HOUS_EDUCATION VARCHAR(3);
VS_HEALTH_EDU_RISK_PREVENTION VARCHAR(3);
VS_FM_SUPP_MARG_EDU VARCHAR(3);
VS_MENTORING VARCHAR(3);
VS_SUPVD_IND_LIVING VARCHAR(3);
VS_RM_BRD_FIN_ASSIST VARCHAR(3);
VS_EDU_FINANCIAL_ASSIST VARCHAR(3);
VS_OTH_FIN_ASSISTANCE VARCHAR(3);
VS_OUTCOME_REPORT_STS VARCHAR(10);
VS_OUTCOME_DATA_COLL VARCHAR(10);
VS_OUTCOME_FOSTER_CARE VARCHAR(10);
VS_TICKLER_TX VARCHAR(500);
VS_ERRMSG VARCHAR(3000) DEFAULT '';
VS_NYTD_CLIENT_CHK VARCHAR(1);
VI_PREV_REC_CLIENT_CHK INTEGER;
VI_WORKER_ID INTEGER;
VS_ENTITY_CD VARCHAR(5);
VI_ENTITY_ID INTEGER;
VI_LOOP_COUNT  INTEGER;
VI_COUNT       INTEGER;
SUMMARY_INSERTED CHAR(1);
VS_ELEMENT6 VARCHAR(3)  DEFAULT 'No';
VS_ELEMENT7 VARCHAR(3)  DEFAULT 'No';
VS_ELEMENT8 VARCHAR(3)  DEFAULT 'No';
VS_ELEMENT9 VARCHAR(3)  DEFAULT 'No';
VS_ELEMENT10 VARCHAR(3) DEFAULT 'No';
VS_ELEMENT11 VARCHAR(3) DEFAULT 'No';
VS_ELEMENT12 VARCHAR(3);
VS_ELEMENT15 VARCHAR(20);
VS_ELEMENT16 VARCHAR(10)  DEFAULT '';
VS_GRADE VARCHAR(50);
VS_ELEMENT18 VARCHAR(50);
VS_ELEMENT19 VARCHAR(10)  DEFAULT '';
VS_ELEMENT20 VARCHAR(10)  DEFAULT '';
VS_ELEMENT21 VARCHAR(10)  DEFAULT '';
VS_ELEMENT22 VARCHAR(10)  DEFAULT '';
VS_ELEMENT23 VARCHAR(10)  DEFAULT '';
VS_ELEMENT24 VARCHAR(10)  DEFAULT '';
VS_ELEMENT25 VARCHAR(10)  DEFAULT '';
VS_ELEMENT26 VARCHAR(10)  DEFAULT '';
VS_ELEMENT27 VARCHAR(10)  DEFAULT '';
VS_ELEMENT28 VARCHAR(10)  DEFAULT '';
VS_ELEMENT29 VARCHAR(10)  DEFAULT '';
VS_ELEMENT30 VARCHAR(10)  DEFAULT '';
VS_ELEMENT31 VARCHAR(10)  DEFAULT '';
VS_ELEMENT32 VARCHAR(10)  DEFAULT '';
VS_ELEMENT33 VARCHAR(10)  DEFAULT '';
VI_PERSON_ID uuid;
VS_OUTCODE integer;

VD_END_DT_SRV1_45DAY DATE;
MAIN_CUR REFCURSOR;
DET_CUR REFCURSOR;

BEGIN
 VL_OUTPUT_SQLCODE := '00000';
 if VD_RUN_DT is null then
  VD_RUN_DATE := now()::date;
 else
  VD_RUN_DATE := VD_RUN_DT::DATE;
 end if ;

 IF EXTRACT(MONTH from VD_RUN_DATE) IN (10,11,12,1,2,3) THEN
  IF EXTRACT(MONTH from VD_RUN_DATE) IN (1,2,3) THEN
   VD_START_DT_SRV := DATE('10/01/'||(EXTRACT(YEAR from VD_RUN_DATE))-1);
   VD_END_DT_SRV := DATE('03/31/'||(EXTRACT(YEAR from VD_RUN_DATE)));
   --Set Prev date
   VD_START_DT_SRV_PREV := DATE('04/01/'||(EXTRACT(YEAR from VD_RUN_DATE)) -1);
   VD_END_DT_SRV_PREV := DATE('09/30/'||(EXTRACT(YEAR from VD_RUN_DATE)));
  ELSE
   VD_START_DT_SRV := DATE('10/01/'||(EXTRACT(YEAR from VD_RUN_DATE)));
   VD_END_DT_SRV := DATE('03/31/'||(EXTRACT(YEAR from VD_RUN_DATE))+ 1);
   --Set Prev date
   VD_START_DT_SRV_PREV := DATE('04/01/'||(EXTRACT(YEAR from VD_RUN_DATE)));
   VD_END_DT_SRV_PREV := DATE('09/30/'||(EXTRACT(YEAR from VD_RUN_DATE)));

  END IF;
 ELSE
  VD_START_DT_SRV := DATE('04/01/'||(EXTRACT(YEAR from VD_RUN_DATE)));
  VD_END_DT_SRV := DATE('09/30/'||(EXTRACT(YEAR from VD_RUN_DATE)));
  --Set Prev date
  VD_START_DT_SRV_PREV := DATE('10/01/'||(EXTRACT(YEAR from VD_RUN_DATE)) -1);
  VD_END_DT_SRV_PREV := DATE('03/31/'||(EXTRACT(YEAR from VD_RUN_DATE)));

 END IF ;

 IF EXTRACT(MONTH from VD_RUN_DATE) IN (10,11,12) THEN
  VD_START_DT := DATE('10/01/'||(EXTRACT(YEAR from VD_RUN_DATE)));
  VD_END_DT := DATE('09/30/'||(EXTRACT(YEAR from VD_RUN_DATE)+1));
     VI_FNYEAR := EXTRACT(YEAR from VD_END_DT);
 ELSE IF EXTRACT(MONTH from VD_RUN_DATE) IN (1,2,3,4,5,6,7,8,9) THEN
     VD_START_DT := DATE('10/01/'||(EXTRACT(YEAR from VD_RUN_DATE)-1));
  VD_END_DT := DATE('09/30/'||EXTRACT(YEAR from VD_RUN_DATE));
     VI_FNYEAR := EXTRACT(YEAR from VD_END_DT);
     END IF;
 END IF ;

  VI_45_DAYS_CHK := 0;

  SELECT
    CASE WHEN DATE_PART('day', VD_RUN_DT::timestamp - VD_START_DT_SRV::timestamp) < 45
        THEN 1
        ELSE 0
    END
  INTO VI_45_DAYS_CHK;

  RAISE NOTICE 'VI_45_DAYS_CHK grace period check %', VI_45_DAYS_CHK ;

  IF VI_45_DAYS_CHK = 1 THEN
   SELECT sp_nytd_client_chk(VI_ONLINE_CLIENT_ID::bigint, VD_START_DT_SRV_PREV::date)
   INTO VS_NYTD_CLIENT_CHK;

   IF VS_NYTD_CLIENT_CHK = 'S' THEN
    SELECT  COUNT(*)
    INTO VI_PREV_REC_CLIENT_CHK
    FROM  personnytdsummary
    WHERE  reporttypekey IN ('13054','13055')
    AND     personid = (select personid from person where cjamspid = VI_ONLINE_CLIENT_ID)
    AND  activeflag = 1
    AND  reportingperiod::character varying = date_part('year',VD_END_DT_SRV_PREV::date)::character varying || '0' || date_part('month',VD_END_DT_SRV_PREV::date)::character varying
    AND  validationflag = 1 ;

   ELSEIF VS_NYTD_CLIENT_CHK = 'B' THEN
      SELECT  COUNT(*)
    INTO VI_PREV_REC_CLIENT_CHK
    FROM  personnytdsummary
    WHERE  reporttypekey IN ('13056')
    AND     personid = (select personid from person where cjamspid = VI_ONLINE_CLIENT_ID)
    AND  activeflag = 1
    AND  reportingperiod::character varying = date_part('year',VD_END_DT_SRV_PREV::date)::character varying || '0' || date_part('month',VD_END_DT_SRV_PREV::date)::character varying
    AND  validationflag = 1 ;

   ELSEIF VS_NYTD_CLIENT_CHK = 'F' THEN
    SELECT  COUNT(*)
    INTO VI_PREV_REC_CLIENT_CHK
    FROM  personnytdsummary
    WHERE  reporttypekey IN ('13057')
    AND     personid = (select personid from person where cjamspid = VI_ONLINE_CLIENT_ID)
    AND  activeflag = 1
    AND  reportingperiod::character varying = date_part('year',VD_END_DT_SRV_PREV::date)::character varying || '0' || date_part('month',VD_END_DT_SRV_PREV::date)::character varying
    AND  validationflag = 1 ;
   END IF ;

   IF VS_NYTD_CLIENT_CHK = 'N' THEN
      SELECT sp_nytd_client_chk(VI_ONLINE_CLIENT_ID::bigint, VD_START_DT_SRV::date)
     INTO VS_NYTD_CLIENT_CHK;
   END IF;

  ELSE
    SELECT sp_nytd_client_chk(VI_ONLINE_CLIENT_ID::bigint, VD_START_DT_SRV::date)
    INTO VS_NYTD_CLIENT_CHK;

  END IF ;

  IF VI_PREV_REC_CLIENT_CHK = 0 THEN
   VD_START_DT_SRV := VD_START_DT_SRV_PREV ;
   VD_END_DT_SRV := VD_END_DT_SRV_PREV;
   VI_FNYEAR := date_part('year',VD_END_DT_SRV_PREV::date);  --Prj#04311

  END IF ;

 CASE RUN_SW
 WHEN 'D' THEN
     VD_START_DT_SRV1 := VD_START_DT_SRV;
     VD_END_DT_SRV1 := VD_END_DT_SRV;

     VD_START_DT1 := VD_START_DT_SRV;
     VD_END_DT1 := VD_END_DT_SRV;

 WHEN 'N' THEN
         IF VD_START_DT_SRV1 = VD_RUN_DATE THEN
                 VD_START_DT_SRV1 := VD_START_DT_SRV;
                 VD_END_DT_SRV1 := VD_RUN_DATE;
         ELSE
                 VD_START_DT_SRV1 := VD_START_DT_SRV;
                 VD_END_DT_SRV1 := VD_RUN_DATE - interval '1' day;
         END IF;

         IF VD_START_DT1 = VD_RUN_DATE THEN
                 VD_START_DT1 := VD_START_DT;
                 VD_END_DT1 := VD_RUN_DATE;
         ELSE
                 VD_START_DT1 := VD_START_DT;
                 VD_END_DT1 := VD_RUN_DATE - interval '1' day;
         END IF;
 ELSE
         VD_START_DT_SRV1 := VD_START_DT_SRV;
         VD_END_DT_SRV1 := VD_END_DT_SRV;

         VD_START_DT1 := VD_START_DT;
         VD_END_DT1 := VD_END_DT;
 END CASE  ;

 IF VI_ONLINE_CLIENT_ID IS NULL then --it appears this block is never called - ???

  OPEN MAIN_CUR FOR
  SELECT  DISTINCT cjamspid,
    REPORT_TYPE
  FROM (
    select distinct pr.cjamspid, 'F' as REPORT_TYPE from person pr where pr.activeflag = 1 and
    (f_age(pr.dob::date,VD_START_DT1::date) = 19 or f_age(pr.dob::date,VD_END_DT1::date) = 19 or f_age(pr.dob::date,VD_START_DT1::date) = 21 or f_age(pr.dob::date,VD_END_DT1::date) = 21) and
    (pr.personid in (select pns.personid from personnytdsummary pns where pns.reporttypekey = '13056' ))
    and ((MOD((VI_FNYEAR - 2013),3)=0 OR MOD((VI_FNYEAR - 2015),3)=0 ) AND (VI_FNYEAR>=2013) )
    union
    select distinct pr.cjamspid, 'B' as REPORT_TYPE from person pr inner join personprogramarea ppa on ppa.personid = pr.personid
    and ppa.programkey = 'OOH'
    and ppa.startdate <= DATE(VD_END_DT1) and (ppa.enddate is null or ppa.enddate >= DATE(VD_START_DT1))
    where (ppa.startdate <= (pr.dob + interval '17' YEAR + interval '45' DAY) AND (ppa.enddate IS NULL OR ppa.enddate >= pr.dob + interval '17' YEAR) )
    and (((pr.dob + interval '17' YEAR + interval '1' DAY) >= DATE(VD_START_DT1) and (pr.dob + interval '17' YEAR + interval '1' DAY) <= DATE(VD_END_DT1))
    or ((pr.dob + interval '17' YEAR + interval '45' DAY) >=  DATE(VD_START_DT1) and (pr.dob + interval '17' YEAR + interval '45' DAY) <= DATE(VD_END_DT1)))
    and ((pr.dob + interval '17' YEAR + interval '1' DAY) between DATE(VD_START_DT1) and  DATE(VD_END_DT1)) and ppa.activeflag = 1 and pr.activeflag = 1
    AND MOD((VI_FNYEAR-2011),3)=0 AND (VI_FNYEAR >=2011)
    UNION
    SELECT DISTINCT CLIENT_ID,'S' AS REPORT_TYPE FROM (
    SELECT p.cjamspid AS CLIENT_ID
    FROM personprogramarea ppa
    INNER JOIN person p ON p.personid=ppa.personid AND p.activeflag=1
    WHERE
     ppa.programkey = 'IL' AND
     ( ppa.startdate <= VD_END_DT_SRV1::date AND (ppa.enddate IS NULL OR ppa.enddate >= VD_START_DT_SRV1::date ) )
    AND ppa.activeflag = 1
     UNION
    SELECT SL.CLIENT_ID
    FROM TB_SERVICE_LOG SL
    INNER JOIN TB_PROVIDER_SERVICES PS ON SL.PROVIDER_SERVICE_ID = PS.PROVIDER_SERVICE_ID
    INNER JOIN TB_SERVICES S ON PS.SERVICE_ID = S.SERVICE_ID  AND PS.DELETE_SW = 'N'
    WHERE
    (S.SERVICE_ID IN (select ns.old_id::int from nytdservices ns WHERE activeflag = 1) ) AND
    ( SL.START_DT <= VD_END_DT_SRV1::date AND (SL.END_DT IS NULL OR SL.END_DT >= VD_START_DT_SRV1::date ) )
    UNION
    SELECT DISTINCT CLIENT_ID
    FROM TB_PLACEMENT
    WHERE DELETE_SW = 'N'
    AND ENTRY_DT IS NOT NULL
    AND ENTRY_DT <= VD_END_DT_SRV1::date AND (EXIT_DT IS NULL OR EXIT_DT >= VD_START_DT_SRV1::date)
     --AND CLIENT_ID = CHAR(VI_ONLINE_CLIENT_ID)
    AND PLACEMENT_STRUCTURE_ID IN (1,73,75)
    UNION
    SELECT SL.CLIENT_ID
     FROM TB_SERVICE_LOG SL
    INNER JOIN TB_SERVICES S ON SL.AGENCY_SERVICE_LDSS_ID = S.SERVICE_ID  AND SL.DELETE_SW = 'N'
    WHERE
     (S.SERVICE_ID IN  (select ns.old_id::int from nytdservices ns WHERE activeflag = 1)) and
     ( SL.START_DT <= VD_END_DT_SRV1::date AND (SL.END_DT IS NULL OR SL.END_DT >= VD_START_DT_SRV1::date ) )
    ) SRV
    )TAB ;

 ELSE
 /* child eligibility years for different category -

  baseline years - 2011,2014,2017,2020 ...etc.

  follow up 19years - 2013,2016,2019 ...etc.

  follow up 21years - 2015,2018,2021 ...etc.

  NYTD started in 2011. Child who is 17years in 2011 will become 19years in 2013 & 21years in 2015.
 */

  OPEN MAIN_CUR FOR

  SELECT  DISTINCT cjamspid,
    REPORT_TYPE
  FROM  (
    Select  distinct pr.cjamspid, 'F' as REPORT_TYPE
    from  person pr
    where  pr.activeflag = 1
      and (f_age(pr.dob::date,VD_START_DT_SRV1::date) = 19 or f_age(pr.dob::date,VD_END_DT_SRV1::date) = 19 or f_age(pr.dob::date,VD_START_DT_SRV1::date) = 21 or f_age(pr.dob::date,VD_END_DT_SRV1::date) = 21)
      and pr.personid in ( select distinct pns.personid
            from  personnytdsummary pns ,
              personnytddetail pnd, nytddataelements nde
            where  pns.summaryid = pnd.summaryid
                    and nde.elementid=pnd.elementid
              and pns.reporttypekey = '13056'
              and nde.old_id = '34'
              and pnd.elementvalue = '13058')
      and pr.cjamspid = VI_ONLINE_CLIENT_ID
      and ((MOD((VI_FNYEAR - 2013),3)=0 OR MOD((VI_FNYEAR - 2015),3)=0 ) AND (VI_FNYEAR>=2013) )
    union
    select  distinct pr.cjamspid, 'B' as REPORT_TYPE
    from  person pr inner join personprogramarea ppa on ppa.personid = pr.personid
      and ppa.programkey = 'OOH'
      and ppa.startdate <= DATE(VD_END_DT_SRV1) and (ppa.enddate is null or ppa.enddate >= DATE(VD_START_DT_SRV1))
    where  (ppa.startdate <= (pr.dob + interval '17' YEAR + interval '45' DAY)
      AND (ppa.enddate IS NULL OR ppa.enddate >= pr.dob + interval '17' YEAR) )

      and (((pr.dob + interval '17' YEAR + interval '1' DAY) >= DATE(VD_START_DT_SRV1) and (pr.dob + interval '17' YEAR + interval '1' DAY) <= DATE(VD_END_DT_SRV1))
      or ((pr.dob + interval '17' YEAR + interval '45' DAY) >=  DATE(VD_START_DT_SRV1) and (pr.dob + interval '17' YEAR + interval '45' DAY) <= DATE(VD_END_DT_SRV1)))

      and ((pr.dob + interval '17' YEAR + interval '1' DAY) between DATE(VD_START_DT_SRV1) and  DATE(VD_END_DT_SRV1))

      and ppa.activeflag = 1
      and pr.activeflag = 1
      AND MOD((VI_FNYEAR-2011),3)=0 AND (VI_FNYEAR >=2011)
      and pr.cjamspid = VI_ONLINE_CLIENT_ID
    union
    SELECT  DISTINCT CLIENT_ID,'S' AS REPORT_TYPE
    FROM  (
      SELECT  p.cjamspid AS CLIENT_ID
      FROM  personprogramarea ppa INNER JOIN person p ON p.personid=ppa.personid AND p.activeflag=1
      WHERE  ppa.programkey = 'IL'
        AND ( ppa.startdate <= VD_END_DT_SRV1::date AND (ppa.enddate IS NULL OR ppa.enddate >= VD_START_DT_SRV1::date ) )
        AND ppa.activeflag = 1
        and p.cjamspid = VI_ONLINE_CLIENT_ID
      union
      SELECT DISTINCT CLIENT_ID
      FROM  TB_PLACEMENT
      WHERE  DELETE_SW = 'N'
        AND ENTRY_DT IS NOT NULL
        AND ENTRY_DT <= VD_END_DT_SRV1::date AND (EXIT_DT IS NULL OR EXIT_DT >= VD_START_DT_SRV1::date)
        AND PLACEMENT_STRUCTURE_ID IN (1,73,75)
        and client_id = VI_ONLINE_CLIENT_ID
      UNION
      SELECT SL.CLIENT_ID
      FROM  TB_SERVICE_LOG SL
        INNER JOIN TB_PROVIDER_SERVICES PS ON SL.PROVIDER_SERVICE_ID = PS.PROVIDER_SERVICE_ID
        INNER JOIN TB_SERVICES S ON PS.SERVICE_ID = S.SERVICE_ID  AND PS.DELETE_SW = 'N'
        inner join person pr on pr.cjamspid = sl.client_id and pr.activeflag = 1
      WHERE   S.SERVICE_ID IN ( select ns.old_id::int
             from  nytdservices ns
             WHERE  activeflag = 1)
        AND ( SL.START_DT <= VD_END_DT_SRV1::date )
        AND (SL.END_DT IS NULL OR SL.END_DT >= VD_START_DT_SRV1::date )
        and SL.client_id = VI_ONLINE_CLIENT_ID
      UNION
      SELECT SL.CLIENT_ID
      FROM  TB_SERVICE_LOG SL
        INNER JOIN TB_SERVICES S ON SL.AGENCY_SERVICE_LDSS_ID = S.SERVICE_ID  AND SL.DELETE_SW = 'N'
        inner join person pr on pr.cjamspid = sl.client_id and pr.activeflag = 1
      WHERE  S.SERVICE_ID IN  ( select  ns.old_id::int
             from  nytdservices ns
             WHERE activeflag = 1)
        and ( SL.START_DT <= VD_END_DT_SRV1::date AND (SL.END_DT IS NULL OR SL.END_DT >= VD_START_DT_SRV1::date ) )
        and SL.client_id = VI_ONLINE_CLIENT_ID
      ) SRV
      ) tab
      FETCH FIRST 1 ROW ONLY;

 END IF;

   << MAIN_CUR >> --WHILE VL_OUTPUT_SQLCODE = '00000'
   LOOP FETCH MAIN_CUR INTO VI_CLIENT_ID, VS_REPORT_TYPE_CD;

   EXIT WHEN NOT FOUND;--
   RAISE NOTICE 'MAIN_CUR';
            RAISE NOTICE 'VI_CLIENT_ID %', VI_CLIENT_ID;
   RAISE NOTICE 'VS_REPORT_TYPE_CD %', VS_REPORT_TYPE_CD;
    -- Element 3 is the client id which is set here in the Main Cursor.
    IF VS_REPORT_TYPE_CD <> 'N' THEN

     --element 4 DOB
     --element 5 Sex
     --element 6 - 11 is Race
     -- element 13 Hispanic or Latino Ethnicity

     SELECT to_char(dob::date, 'MM/DD/YYYY') AS VS_DOB_DT,
     (case when pp.gendertypekey = 'M' then 'Male' when pp.gendertypekey = 'F' then 'Female' else 'No' end) as gendertype,
     (CASE WHEN pp.ethnicgrouptypekey IS null or pp.ethnicgrouptypekey = 'U' THEN 'Unknown'
      WHEN pp.ethnicgrouptypekey = 'H' THEN 'Yes'
      WHEN pp.ethnicgrouptypekey = 'X' THEN 'No'
     end) as ethiniccd INTO VS_DOB_DT, VS_SEX, VS_HISPANIC
     FROM person PP WHERE  PP.cjamspid = VI_CLIENT_ID and PP.activeflag = 1;

     /*RACE Logic is changed.it also takes into consideration the secondary race code.
     so if primary race code is declined(6314) then element12 will be Yes. Else it will be No.
     all other elements 6-11 will be taken from primary race & secondary race code together.
     if primary or secondary either of them is Yes then the corresponding element will be Yes.
     Element 6 is AMERICAN INDIAN OR ALASKAN NATIVE
     Element 7 is ASIAN
     Element 8 is BLACK OR AFRICAN AMERICAN
     Element 9 is NATIVE HAWAIIAN OR OTHER PACIFIC ISLANDER
     Element 10 is WHITE
     Element 11 is UNKNOWN
     Element 12 is DECLINED*/

     SELECT ptm.racetypekey,
      CASE WHEN ptm.racetypekey IN ('AN','AI') THEN 'Yes'
        ELSE 'No' END ,
      CASE WHEN ptm.racetypekey='AS' THEN 'Yes'
        ELSE 'No' END ,
      CASE WHEN ptm.racetypekey='BA' THEN 'Yes'
        ELSE 'No' END ,
      CASE WHEN ptm.racetypekey='PI' THEN 'Yes'
        ELSE 'No' END ,
      CASE WHEN ptm.racetypekey='WH' THEN 'Yes'
        ELSE 'No' END ,
      CASE WHEN ptm.racetypekey='UN' THEN 'Yes'
        ELSE 'No' END
     INTO
      VS_RACE_CD,
        VS_ELEMENT6,
      VS_ELEMENT7,
      VS_ELEMENT8,
      VS_ELEMENT9,
      VS_ELEMENT10,
      VS_ELEMENT11
     FROM person p
     LEFT JOIN personracetypemap ptm ON p.personid=ptm.personid AND p.activeflag=1 AND ptm.activeflag=1
     WHERE p.cjamspid=VI_CLIENT_ID;

     IF VS_RACE_CD = 'DC' THEN
        VS_ELEMENT6 := null;
        VS_ELEMENT7 := null;
        VS_ELEMENT8 := NULL;
        VS_ELEMENT9 := NULL;
        VS_ELEMENT10 := NULL;
        VS_ELEMENT11 := NULL;
              VS_ELEMENT12 := 'Yes';
           END IF;

     IF  (VS_ELEMENT6 = 'No') AND (VS_ELEMENT7 = 'No') AND (VS_ELEMENT8 = 'No') AND (VS_ELEMENT9 = 'No')
     AND (VS_ELEMENT10 = 'No') AND (VS_ELEMENT11 = 'No') THEN

      VS_ELEMENT12 := 'Yes';
     ELSE
      VS_ELEMENT12 := 'No';
     END IF;
     -- checking age
     VI_AGE := (SELECT f_age(dob::date,VD_RUN_DT::date) FROM person WHERE cjamspid = VI_CLIENT_ID);
     IF VS_REPORT_TYPE_CD = 'S' THEN
      --temporarily to check base line
      VI_REPORTING_PERIOD := ((EXTRACT(YEAR from VD_END_DT_SRV))::varchar|| CASE WHEN EXTRACT(MONTH from VD_END_DT_SRV) < 10 THEN ('0'||(EXTRACT(MONTH from VD_END_DT_SRV))::varchar) ELSE (EXTRACT(MONTH from VD_END_DT_SRV)::varchar) end )::int ;
      IF VI_AGE = 17 THEN
       IF EXISTS (SELECT personid FROM personnytdsummary pns join person pr on pr.personid = pns.personid  WHERE reportingperiod = VI_REPORTING_PERIOD AND reporttypekey = '13056' AND activeflag = 1 AND pr.cjamspid = VI_CLIENT_ID)
       THEN
        VS_REPORT_TYPE_CD := 'B';
       END IF;
      END IF;
     END IF;

     IF VS_REPORT_TYPE_CD = 'S' THEN
