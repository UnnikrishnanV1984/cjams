CREATE OR REPLACE FUNCTION as_sp_ncands_insert_out(OUT vs_success_sw character varying, OUT vl_output_sqlcode character varying, OUT vs_message character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- PL/PGSQL STORED FUNCTION
-- AUTHOR : 
-- DATE CREATED :--/--/2019
-- GENERATES CHILD DATA
--------------------------------------------------------------------------

declare

--Variables for child and report data
 
    vl_subyr         varchar(4);
 vl_staterr       varchar(2);
 vl_rptid            varchar(50);
 vl_chid             varchar(20);
 vl_rptcnty          varchar(3);
 vl_rptdt         varchar(8);
 vl_invdate          varchar(8);
 vl_rptsrc        varchar(2);
 vl_rptdisp          varchar(2);
 vl_rptdisdt         varchar(8);
 vl_notifs        varchar(1);
 vl_chage         varchar(2);
 vl_chbdate          varchar(8);
 vl_chsex         varchar(1);
 vl_chracai          varchar(1);
 vl_chracas          varchar(1);
 vl_chracbl          varchar(1);
 vl_chracnh          varchar(1);
 vl_chracwh          varchar(1);
 vl_chracud          varchar(1);
 vl_chethn        varchar(1);
 vl_chcnty        varchar(3);
 vl_chlvng        varchar(2);
 vl_chmil         varchar(1);
 vl_chprior          varchar(1);
 vl_child_dt   refcursor;
 
 VS_OUTPUT_STATE  VARCHAR(5) DEFAULT '00000';--
 
 
 
 VL_EXCEP_FLAG       INTEGER DEFAULT  0;--
 VL_EXCEP_MESSAGE    VARCHAR DEFAULT  '';--
 
BEGIN


   set vl_output_sqlcode ='';

--INSERT INTO LOG TABLE 


 
-- DELETE RECORD FROM TB_NCANDS_ELEMENTS_TEMP IF EXISTS

    if (select count(*) from tb_ncands_elements_temp) > 0 
     then truncate Tb_ncands_elements_temp;
 end if ;

--CHILD DATA AND REPORT INFO
 
 
begin
 
 open vl_child_dt for 
 
 select 
   substring((extract(year from current_date) -1 )::varchar, 1) subyear,
   '24' StateRR,
   isr.servicerequestnumber RPTID,
   isra.personid CHID,
   tpv.category_tx RPTCNTY,
   to_char(isr.insertedon, 'MMDDYYYY') RPTDT,
   (select to_Char(min(pnn.contactdate),'MMDDYYYY') 
   from progressnote pnn
   where pnn.intakeserviceid = isr.intakeserviceid)INVDATE
   ,(select case
      when israa.intakeservicerequestpersontypekey = 'SSP' then 01
      when israa.intakeservicerequestpersontypekey = 'MP' then 02
      when israa.intakeservicerequestpersontypekey = 'MHP' then 03
      when israa.intakeservicerequestpersontypekey = 'LLECJP' then 04
      when israa.intakeservicerequestpersontypekey = 'EP' then 05
      when israa.intakeservicerequestpersontypekey = 'CDCP' then 06
      when israa.intakeservicerequestpersontypekey = 'SCP' then 07
      when israa.intakeservicerequestpersontypekey = 'AV' then 08
      when israa.intakeservicerequestpersontypekey = 'PAT' then 09
      when israa.intakeservicerequestpersontypekey = 'OR' then 10
      when israa.intakeservicerequestpersontypekey = 'FN' then 11
      when israa.intakeservicerequestpersontypekey = 'AP' then 12
      when israa.intakeservicerequestpersontypekey = 'OTH' then 88
      when israa.intakeservicerequestpersontypekey = 'UM' then 99
      when israa.intakeservicerequestpersontypekey = 'AR' then 13
      else 88
     end 
    from intakeservicerequestactor israa 
    where isra.intakeserviceid = isr.intakeserviceid 
    and israa.activeflag = 1   and 
    israa.intakeservicerequestpersontypekey in ('SSP','MP','MHP','LLECJP','EP','CDCP','SCP','AV','PAT','OR','FN','AP','OTH','UM','AR')  limit 1) RPTSRC
    ,(select coalesce( (case  when inf.investigationfindingtypekey = 'REM' then 01
           when inf.investigationfindingtypekey = 'ID' then 02
           when inf.investigationfindingtypekey = 'RO' then 04
           when inf.investigationfindingtypekey = 'UD' then 05
           when inf.investigationfindingtypekey is null then 99
           else 88
         end ) , null) 
     from investigationfinding inf 
     where inf.intakeserviceid = isr.intakeserviceid) RPTDISP
    ,( select case 
        when inf.investigationfindingdate < pnn.contactdate then to_char(pnn.contactdate, 'MMDDYYYY')
        else to_char(inf.investigationfindingdate, 'MMDDYYYY')
      end
     from investigationfinding inf ,progressnote pnn
     where pnn.intakeserviceid = isr.intakeserviceid and  inf.intakeserviceid = isr.intakeserviceid ) RPTDISDT
    ,( select case
        when isra2.intakeservicerequestpersontypekey = 'NORE' then 1
        when isra2.intakeservicerequestpersontypekey = 'AG'
        or isra2.intakeservicerequestpersontypekey = 'LAEN'
        or isra2.intakeservicerequestpersontypekey = 'PAOF'
        or isra2.intakeservicerequestpersontypekey = 'PRAT'
        or isra2.intakeservicerequestpersontypekey = 'TROF' then 2
        when isra2.intakeservicerequestpersontypekey = 'LIWO' then 3
        when isra2.intakeservicerequestpersontypekey = 'AG'
        and isra2.intakeservicerequestpersontypekey = 'LIWO' then 4
        when isra2.intakeservicerequestpersontypekey = 'LAEN'
        and isra2.intakeservicerequestpersontypekey = 'LIWO' then 4
        when isra2.intakeservicerequestpersontypekey = 'PAOF'
        and isra2.intakeservicerequestpersontypekey = 'LIWO' then 4
        when isra2.intakeservicerequestpersontypekey = 'PRAT'
        and isra2.intakeservicerequestpersontypekey = 'LIWO' then 4
        when isra2.intakeservicerequestpersontypekey = 'TROF'
        and isra2.intakeservicerequestpersontypekey = 'LIWO' then 4
        when isra2.intakeservicerequestpersontypekey is null then 9
        else 8
      end
     from intakeservicerequestactor isra2 
     where isr.intakeserviceid = isra2.intakeserviceid 
     and isra2.intakeservicerequestpersontypekey in ('NE','AG','LAEN','PAOF','PRAT','TROF','LIWO' ) limit 1) NOTIFS
     ,( case  when p.dob is null then 99 
        else extract(year  from age(current_date , p.dob)) :: int 
       end ) chage
     ,to_char(p.dob, 'MMDDYYYY') CHBDATE
     ,(case p.gendertypekey
       when 'M' then 1
       when 'F' then 2
       else 9      end) CHSEX
     ,coalesce(( select  case
          when prt.racetypekey = 'AI' or prt.racetypekey = 'AN' then 1
          when prt.racetypekey is null then 9
          else 2
          end 
                 from personracetypemap prt 
                 where prt.activeflag = 1 and prt.personid = p.personid limit 1),'3') CHRACAI
     ,coalesce(( select  case
          when prt.racetypekey = 'AS' then 1
          else 2
          end 
        from personracetypemap prt 
        where prt.activeflag = 1 and prt.personid = p.personid limit 1),'3') CHRACAS
      ,coalesce(( select  case
          when prt.racetypekey = 'BA' then 1
          else 2
          end 
        from personracetypemap prt 
        where prt.activeflag = 1 and prt.personid = p.personid limit 1),'3') CHRACBL
      ,coalesce(( select  case
          when prt.racetypekey = 'PI' then 1
          else 2
          end 
        from  personracetypemap prt 
        where prt.activeflag = 1 and prt.personid = p.personid limit 1),'3') CHRACNH
      ,coalesce(( select  case
          when prt.racetypekey = 'WH' then 1
          else 2
          end 
        from  personracetypemap prt 
        where  prt.activeflag = 1 and prt.personid = p.personid limit 1),'3') CHRACWH
      ,coalesce(( select  case
          when prt.racetypekey in ('OT','LA','AI','AS','BA','PI','WH','AN') then 2
          when prt.racetypekey in ('UN','DC','AB') then 1
          else 9 
          end 
        from  personracetypemap prt 
        where  prt.activeflag = 1 and prt.personid = p.personid limit 1),'3') CHRACUD
     ,( case
       when p.ethnicgrouptypekey = 'H' then 1
       when p.ethnicgrouptypekey = 'N' then 2
       else 9
      end )CHETHN
     ,( select  coalesce(tpvp.category_tx , null)  
      from  tb_picklist_values tpvp ,personaddress pa 
      where  tpvp.value_tx = pa.county 
        and pa.personid = p.personid 
        and pa.activeflag = 1 
        and  tpvp.picklist_type_id = 104 limit 1)CHCNTY
       ,null CHLVNG
       ,coalesce (( select  case
            when pms.servicestatuskey in ('PTD','RFD','ACT') then 1
            when pms.servicestatuskey is null then 2
            else 9
           end 
         from  personmilitaryservices pms, intakeservreqchildremoval isrcm 
         where  pms.personid = isrcm.primarycaregiveractorid 
           and isrcm.intakeserviceid = isr.intakeserviceid),'9') chmil
                            /*,(
                             select
                                  coalesce(count(1), 0)
                             from
                                     IntakeServiceRequest ISRr
                                     join IntakeSerReqStatusType ISRST on ISRr.IntakeSerReqStatusTypeId = ISRST.IntakeSerReqStatusTypeId
                                     left join ServiceRequestSubType SRST on SRST.ServiceRequestSubTypeId = ISRr.IntakeServiceRequestClassId
                                     join IntakeServiceRequestActor ISRAa on ISRr.IntakeServiceId = ISRAa.IntakeServiceId
                                     join Actor ACc on   ACc.ActorId = ISRA.ActorId  and ACc.ActiveFlag = 1
                                     join Person PRe on  PRe.PersonId = ACc.PersonId
                             where
                                  ISRr.ActiveFlag = 1 
                                  and PRe.PersonId = p.personid
                                  and ISRr.intakeserviceid = isr.intakeserviceid) CHPRIOR*/,null chprior
  
  from 
   intakeservicerequest isr 
   join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid 
   join userprofile up on  up.securityusersid = isr.routedusersid
   join userprofileaddress upa on  upa.securityusersid = up.securityusersid
   join tb_picklist_values tpv on  tpv.value_tx = upa.county
   join person p on p.personid = isra.personid

  where
   isr.activeflag = 1
   and tpv.picklist_type_id = 104
   and isra.intakeservicerequestpersontypekey in ('OTHERCHILD','BIOCHILD','CHILD','AV')
   and isra.activeflag = 1
   and up.activeflag = 1
   and up.teamtypekey = 'CW'
   and p.activeflag = 1 ;
--and tpv.activeflag = 1
 
  loop

  fetch vl_child_dt into  vl_subyr,  
                                vl_staterr,
                                vl_rptid,  
                                vl_chid, 
                                vl_rptcnty,
                                vl_rptdt,
                                vl_invdate,
                                vl_rptsrc,
                                vl_rptdisp,
                                vl_rptdisdt, 
                                vl_notifs,
                                vl_chage,
                                vl_chbdate, 
                                vl_chsex,
                                vl_chracai, 
                                vl_chracas, 
                                vl_chracbl,
                                vl_chracnh,
                                vl_chracwh,
                                vl_chracud,
                                vl_chethn,
                                vl_chcnty,
                                vl_chlvng,
                                vl_chmil,
                                vl_chprior ;

  exit when  not found;

  insert into tb_ncands_elements_temp (   SUBYR,
            STATERR, 
            RPTID,
            CHID,
            RPTCNTY,
            RPTDT,
            INVDATE,
            RPTSRC,
            RPTDISP,
            RPTDISDT,
            NOTIFS,
            CHAGE,
            CHBDATE,
            CHSEX,
            CHRACAI,
            CHRACAS,
            CHRACBL,
            CHRACNH,
            CHRACWH,
            CHRACUD,
            CHETHN,
            CHCNTY,
            CHLVNG,
            CHMIL,
            CHPRIOR)
           
   values        ( vl_subyr,
            vl_staterr,
            vl_rptid,
            vl_chid,
            vl_rptcnty,
            vl_rptdt,
            vl_invdate,
            vl_rptsrc,
            vl_rptdisp,
            vl_rptdisdt,
            vl_notifs,
            vl_chage,
            vl_chbdate,
            vl_chsex,
            vl_chracai,
            vl_chracas,
            vl_chracbl,
            vl_chracnh,
            vl_chracwh,
            vl_chracud,
            vl_chethn,
            vl_chcnty,
            vl_chlvng,
            vl_chmil,
            vl_chprior) ;
 
 
      end loop;
  close vl_child_dt;
  
 EXCEPTION WHEN OTHERS THEN
                VS_OUTPUT_STATE := SQLSTATE;
                VL_OUTPUT_SQLCODE :=SQLERRM;
                VS_MESSAGE := 'CHILD DATA GENERATION FAILED';--
     VL_EXCEP_FLAG := 1;--
 
  
 
  END;--

 /* IF  VL_EXCEP_FLAG != 1 THEN 
  VS_OUTPUT_STATE :='00000';--
  VS_MESSAGE := 'THE RUN WAS SUCCESSFUL';--
  VS_SUCCESS_SW := 'Y';--
  else
  VS_SUCCESS_SW :='N'; --
end if;
  */
end; 
$function$

