update adoptionagreement set ivesvsignimage = v_signText where adoptionagreementid =
(select adoptionagreementid from adoptionagreement aa
join adoptionplanning ap on ap.adoptionplanningid = aa.adoptionplanningid and aa.activeflag=1
join permanencyplan pp on pp.permanencyplanid = ap.permanencyplanid and pp.activeflag =1
where pp.permanencyplanid = v_objectid limit 1);

