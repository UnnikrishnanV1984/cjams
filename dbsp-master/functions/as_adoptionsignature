AS $function$
 
begin
 if(v_eventcode = 'IVEADOP')
 then
if(v_status = 67)
then
update adoptionagreement set cwsignimage = v_signText where adoptionagreementid =
(select adoptionagreementid from adoptionagreement aa
join adoptionplanning ap on ap.adoptionplanningid = aa.adoptionplanningid and aa.activeflag=1
join permanencyplan pp on pp.permanencyplanid = ap.permanencyplanid and pp.activeflag =1
where pp.permanencyplanid = v_objectid limit 1);

INSERT INTO iveapprovalsignature
(iveapprovalsignatureid, objectid,objecttype , servicecaseid,cwcwsigndate, cwcwsignimage, cwcwsecurityusersid, cwcwcommands, activeflag,  insertedby, updatedby, insertedon, updatedon)
