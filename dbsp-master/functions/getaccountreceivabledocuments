CREATE OR REPLACE FUNCTION getaccountreceivabledocuments(v_providerid character varying, v_page integer, v_limit integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE                    
v_offset    integer;
l_accountreceivabledocuments json ;

BEGIN
 v_offset  :=  (v_page  -  1)  *  v_limit;    

 
SELECT json_agg(f)  INTO l_accountreceivabledocuments FROM(
 select  ard.*, up.fullname 
from accountreceivabledocuments ard
join userprofile up on ard.uploadedby :: character varying = up.securityusersid
where ard.providerid = v_providerid and ard.activeflag=1
 
LIMIT  v_limit  OFFSET  v_offset
)f;

Return l_accountreceivabledocuments;
 
  END;

$function$

