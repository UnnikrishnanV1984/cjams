CREATE OR REPLACE FUNCTION as_addattachment(v_intakenumber character varying, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE v_count bigint;
v_actorrelationship character varying;
v_rec RECORD;

BEGIN  
 
 FOR  v_rec  IN 
 
  SELECT intakeserviceid FROM intakeservicerequest WHERE activeflag =1 
  AND intakenumber =v_intakenumber
 LOOP
 
  insert into documentproperties(objecttypekey,objectid,documenttypekey,documentdate,
  clientid,servicerequestid,thirdpartysourceid, filename,
  tag,title,description,mime,
  meta,encoding,numberofbytes,rootobjectid,
  rootobjecttypekey,s3bucketpathname,originalfilename,ecmsdocumentid,
  updatedby,updatedon,
  insertedby,insertedon,activeflag,intakenumber)
  
  SELECT  dtp.objecttypekey,v_rec.intakeserviceid,dtp.documenttypekey,dtp.documentdate,
    dtp.clientid,dtp.servicerequestid,dtp.thirdpartysourceid, dtp.filename,
    dtp.tag,dtp.title, dtp.description,dtp.mime,
    dtp.meta,dtp.encoding,dtp.numberofbytes,dtp.rootobjectid,
    dtp.rootobjecttypekey,dtp.s3bucketpathname,dtp.originalfilename,dtp.ecmsdocumentid,
    v_securityusersid,now(),
    v_securityusersid,now(),'1',v_intakenumber
  FROM documentproperties dtp 
  WHERE dtp.intakenumber = v_intakenumber
  AND dtp.activeflag=1;
  
  
 END LOOP;
   
UPDATE documentproperties SET activeflag =0 
WHERE intakenumber =v_intakenumber AND  activeflag =1;        
 
RETURN 'Successfull';
end;

$function$

