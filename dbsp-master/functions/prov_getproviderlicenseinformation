CREATE OR REPLACE FUNCTION prov_getproviderlicenseinformation(v_providerid character varying, filterby character varying, filter_status character varying DEFAULT NULL::character varying)
 RETURNS TABLE(provider_status_cd character varying, license_no character varying, active_sw character varying, license_agency character varying, license_level character varying, license_type character varying, children_no integer, license_status_cd character varying, site_id character varying, provider_nm character varying, picklist_value_cd character varying, adr_work_phone_tx character varying, contract_id character varying, program_status_cd character varying, license_issue_dt date, license_expiry_dt date, license_status text)
 LANGUAGE plpgsql
AS $function$
 

DECLARE
 
     
BEGIN
 
return query 
select distinct tp.provider_status_cd::character VARYING, tpl.license_no, tpl.active_sw::character varying, (select tpv.value_tx from tb_picklist_values tpv where tpv.picklist_type_id=111 and trim(tpv.picklist_value_cd)=trim(tpl.licensing_agency_cd)) as license_agency
,tpl.license_level, tpl.license_type,COALESCE (pra.children_no, tpl.licensed_beds_no, -1) AS children_no, (select tpv1.value_tx from tb_picklist_values tpv1 where tpv1.picklist_type_id=286 and trim(tpv1.picklist_value_cd)=trim(tpl.license_status_cd)) as license_status_cd, 
tpl.site_id::character varying, tp.provider_nm, plist.picklist_value_cd, tp.adr_work_phone_tx, tcp.contract_id::character varying, tcp.program_status_cd, tpl.license_issue_dt::date , tpl.license_expiry_dt::date ,
case when (tpl.license_expiry_dt is null or tpl.license_expiry_dt > now()) then 'Active' else 'Expired' end as license_status
from tb_provider_licensing tpl join tb_provider tp on tpl.site_id = tp.provider_id join tb_provider_picklist plist on plist.provider_id =  tp.provider_id join tb_picklist_values v on trim(v.picklist_value_cd) = trim(plist.picklist_value_cd) and v.picklist_type_id = 155 and trim(plist.picklist_value_cd) in ('3274','3302','3794','3795','3796') 
left join tb_prov_accomodation pra on pra.license_application_id = tpl.license_application_id and pra.delete_sw='N'
left join tb_contract_program tcp on tpl.license_no = tcp.license_no 
where case when filterby = 'All' then tpl.provider_id = v_providerid  and tpl.active_sw = 'Y'
    when filterby = 'Active' then tpl.provider_id = v_providerid and (tpl.license_expiry_dt is null or tpl.license_expiry_dt::date >= now()::date) and tpl.active_sw = 'Y'
    when filterby = 'Expired' then tpl.provider_id = v_providerid and tpl.license_expiry_dt::date < now()::date
    end
    and
    case when filter_status = 'Open' then tp.provider_status_cd = 1791
        when filter_status = 'Closed' then tp.provider_status_cd = 1792
    else true
    end;

END;
 $function$

