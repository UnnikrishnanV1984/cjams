CREATE OR REPLACE FUNCTION as_saverestitution(intakenumber character varying, restitutions json, securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
 
 v_intakenumber character varying;
 v_youthpersonid uuid;
 v_youthpersonname character varying;
 restitution json;
 v_countyid uuid;
 v_securityuserid character varying;
 v_restitutionid uuid;
BEGIN

 v_intakenumber := intakenumber;
 v_securityuserid := securityuserid;
 
 -- Fetching County Id from Team
 
 select t.countyid into v_countyid from as_teammemberassignment tma join teammember tm on tm.teammemberid = tma.teammemberid and tm.activeflag = 1
 join team t on t.teamid = tm.teamid and t.activeflag = 1
 where tma.activeflag = 1 and tma.securityusersid = v_securityuserid limit 1;
 
 -- Fetching Youth Person Id
 
 SELECT P.personid, P.firstname || ' ' || P.lastname into v_youthpersonid, v_youthpersonname FROM intakeservicerequestactor ISRA JOIN actor A ON A.actorid = ISRA.actorid AND A.activeflag = 1
 JOIN person P ON P.personid = A.personid AND P.activeflag = 1
 JOIN intakeservicerequest ISR ON ISR.intakeserviceid = ISRA.intakeserviceid AND ISR.activeflag = 1
 WHERE ISRA.intakeservicerequestpersontypekey = 'Youth' AND ISR.intakenumber = v_intakenumber AND ISRA.activeflag = 1;
 
 For  restitution  in Select * from  json_array_elements(restitutions)
 LOOP
 
  select addupdaterestitution into v_restitutionid from as_addupdaterestitution(restitution, v_securityuserid, v_intakenumber, v_youthpersonid, v_youthpersonname, v_countyid);
  
 END LOOP;

RETURN
   'Success';
END;


$function$

