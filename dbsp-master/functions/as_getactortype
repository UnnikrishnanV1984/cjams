CREATE OR REPLACE FUNCTION as_getactortype(teamtypekey character varying)
 RETURNS TABLE(totalcount bigint, actortype character varying, typedescription character varying, sequencenumber integer, effictivedate timestamp without time zone, expirationdate timestamp without time zone, tasktype integer, activeflag integer)
 LANGUAGE plpgsql
AS $function$

declare  v_teamtypekey  character  varying  =  null;
BEGIN
 v_teamtypekey:=  teamtypekey;
 
 --  Return  Query
 --  select  count(1)  OVER()  totalcount,  at.actortype,  at.typedescription,  at.sequencenumber,  at.effictivedate,
 --  at.expirationdate,  at.tasktype,  at.activeflag  from  actortype  at  join  actortypeagency  ata  on  ata.actortypekey  =  at.actortype
 --  where  ata.teamtypekey  =  v_teamtypekey  and  at.activeflag  =  1  and  ata.activeflag  =  1  order  by  at.typedescription;
 
 Return  Query
 Select  count(1)  OVER()  totalcount,  a.actortype,  a.typedescription,  a.sequencenumber,  a.effectivedate,
   a.expirationdate,  a.tasktype,  a.activeflag  from  (
  select  sat.actortype,  sat.typedescription,  sat.sequencenumber,  sat.effectivedate,
   sat.expirationdate,  sat.tasktype,  sat.activeflag  from  (
   select  at.actortype,  at.typedescription,  at.sequencenumber,  at.effectivedate,
   at.expirationdate,  at.tasktype,  at.activeflag  from  actortype  at  join  actortypeagency  ata  on  ata.actortypekey  =  at.actortype
   where  ata.teamtypekey  =  v_teamtypekey  and  at.activeflag  =  1  and  ata.activeflag  =  1  
   and  at.actortype  !=  'Others'  order  by  at.typedescription
  )  sat
       union  all
       select  at.actortype,  at.typedescription,  at.sequencenumber,  at.effectivedate,
  at.expirationdate,  at.tasktype,  at.activeflag  from  actortype  at  join  actortypeagency  ata  on  ata.actortypekey  =  at.actortype
  where  ata.teamtypekey  =  v_teamtypekey  and  at.activeflag  =  1  and  ata.activeflag  =  1  
  and  at.actortype  =  'Others'
 )  a;
    end;

$function$

