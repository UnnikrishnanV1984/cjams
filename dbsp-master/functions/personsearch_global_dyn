    LEFT JOIN PersonPhoneNumber AS pn ON pn.PersonId = p.PersonId
 LEFT JOIN PersonEmail AS pe ON pn.PersonId = p.PersonId
    LEFT JOIN   County    AS c ON  a.county = c.CountyName
 Left Join Alias As al On al.personid = p.personid
    WHERE 
 CASE WHEN v_lvFirstName is NOT NULL THEN (p.FirstName ILIKE v_lvFirstName || ''%'') ELSE TRUE END 
