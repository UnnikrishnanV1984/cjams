 + CASE WHEN v_lvOccupation is NOT NULL THEN Case When (p.occupation = v_lvOccupation) Then 1 When (p.occupation ILIKE  LEFT(v_lvOccupation, 3) || ''%'') Then 0.3 Else 0 End ELSE 0 END 
 + CASE WHEN v_lvFein is NOT NULL THEN Case When (p.fein = v_lvFein) Then 1 When (p.fein ILIKE  LEFT(v_lvFein, 3) || ''%'') Then 0.3 Else 0 End ELSE 0 END
 + CASE WHEN v_lvComplaintnumber is NOT NULL THEN Case When (p.complaintnumber = v_lvComplaintnumber) Then 1 When (p.complaintnumber ILIKE  LEFT(v_lvComplaintnumber, 3) || ''%'') Then 0.3 Else 0 End ELSE 0 END
 + CASE WHEN v_lvCjisnumber is NOT NULL THEN Case When (p.cjisnumber = v_lvCjisnumber) Then 1 When (p.cjisnumber ILIKE  LEFT(v_lvCjisnumber, 3) || ''%'') Then 0.3 Else 0 End ELSE 0 END
 + CASE WHEN v_lvPetitionid is NOT NULL THEN Case When (p.petitionid = v_lvPetitionid) Then 1 When (p.petitionid ILIKE  LEFT(v_lvPetitionid, 3) || ''%'') Then 0.3 Else 0 End ELSE 0 END
    + (CASE WHEN (v_lDLType is NOT NULL AND v_lDLValue is NOT NULL) 
