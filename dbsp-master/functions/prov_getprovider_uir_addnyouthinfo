CREATE OR REPLACE FUNCTION prov_getprovider_uir_addnyouthinfo(prov_uir_id character varying)
 RETURNS TABLE(totalcount bigint, provider_uir_id uuid, color_of_clothing character varying, youth_height character varying, youth_weight character varying, other_address character varying, parent_name character varying, parent_phone character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN
RETURN QUERY 
select count(1)  over(),
PU.provider_uir_id,puld.color_of_clothing,
puld.youth_height ,puld.youth_weight,
puld.parent_name,puld.other_address,
puld.parent_phone
FROM  provider_uir PU
join provider_uir_addnyouthinfo puld on pu.provider_uir_id = puld.provider_uir_id and puld.active_flag = 1
where PU.active_flag=1  and  puld.provider_uir_id::character varying = prov_uir_id
group by PU.provider_uir_id,puld.color_of_clothing,
puld.youth_height ,puld.youth_weight,
puld.parent_name,puld.other_address,
puld.parent_phone;
--LIMIT v_limit OFFSET v_pageoffset ;  
END;
$function$

