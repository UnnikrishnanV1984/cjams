CREATE OR REPLACE FUNCTION getadultscreentool(p_intakeserviceid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$


declare l_adultscreentool json;
begin
 
    select json_agg(ast) into l_adultscreentool from (
    
select
ISRAST.intakeservreqadultscreentoolid,ISRAST.intakeserviceid,ISRAST.astdate,
ISRAST.intakeworker,ISRAST.countyid,ISRAST.referralname,ISRAST.referralphone,
ISRAST.referraladdress1,ISRAST.referraladdress2,ISRAST.referralremainanonymous,
ISRAST.referralrelationship,ISRAST.clientinfoname,ISRAST.clientinfodob,ISRAST.clientinfoage,
egt.typedescription as ethnicgrouptype,RAT.typedescription as racetype,GT.typedescription as Gender,
ISRAST.gendertypekey,ISRAST.racetypekey,ISRAST.ethnicitytypekey,ISRAST.clientinfoaddress1,
ISRAST.clientinfoaddress2,ISRAST.clientinfophone,maritalstatuskey,ISRAST.monthlyincome,
ISRAST.monthlyincomesource,ISRAST.totalassets,ISRAST.totalassetssource,ISRAST.additionalinfo,
ISRAST.riskaggrpets,ISRAST.riskhomehazards,ISRAST.riskfireharms,ISRAST.riskpsychiatric,
ISRAST.riskcdsabuse,riskmedical,ISRAST.riskdomviolence,ISRAST.riskother,
ISRAST.riskcomments,ISRAST.detailsofreferralcomments,healthcarekey,ISRAST.transportationkey,
ISRAST.cluttertypekey,ISRAST.foodtypekey,ISRAST.housingtypekey,ISRAST.supervisiontypekey,
ISRAST.individualvulnerable,ISRAST.eatingfeedingkey,ISRAST.takingmedicationkey,
ISRAST.walkingkey,ISRAST.bathingkey,ISRAST.dressingkey,ISRAST.toiletkey,ISRAST.physicalrisksnotes,
ISRAST.dementiakey,ISRAST.thoughtdisorderskey,ISRAST.substanceabusekey,ISRAST.mooddisorderskey,
ISRAST.behavioralissueskey,ISRAST.mentalchallengesnotes,supportnetworkkey,ISRAST.supportnetworknotes,
ISRAST.riskscore,ISRAST.risklevel,ISRAST.intakerecommendation,

 (SELECT  json_agg(household)  as householdconfig FROM(
 
 
    SELECT intakeservreqadultscreentoolhouseholdconfigid, intakeservreqadultscreentoolid, 
    "name", relationship, phoneno  
               FROM intakeservreqadultscreentoolhouseholdconfig ASTHLLC                       
               where ASTHLLC.intakeservreqadultscreentoolid=ISRAST.intakeservreqadultscreentoolid
               and ASTHLLC.activeflag=1)    
      
                    household  )::json  



FROM intakeservreqadultscreentool ISRAST
left join ethnicgrouptype egt on egt.ethnicgrouptypekey=ISRAST.ethnicitytypekey and egt.activeflag=1
left join racetype RAT on RAT.racetypekey=ISRAST.racetypekey and RAT.activeflag=1
Left JOIN gendertype GT on GT.gendertypekey = ISRAST.gendertypekey

where ISRAST.intakeserviceid=p_intakeserviceid and ISRAST.activeflag=1

        
        ) as ast;
        
return l_adultscreentool;        
end;


$function$

