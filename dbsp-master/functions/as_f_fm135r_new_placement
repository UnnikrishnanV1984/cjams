CREATE OR REPLACE FUNCTION as_f_fm135r_new_placement(start_date date, end_date date)
 RETURNS TABLE(child_id bigint, child_last_name character varying, child_first_name character varying, child_worker text, child_supervisor text, child_worker_jurisdiction character varying, family_worker text, family_supervisor text, family_worker_jurisdiction character varying, provider_name text, service_name character varying, start_dt date, end_dt date, validation_status character varying, entry_dt timestamp without time zone, exit_dt timestamp without time zone)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY 
( 
SELECT DISTINCT 
 TAB1.CHILD_ID
 , TAB1.CHILD_LAST_NAME
 , TAB1.CHILD_FIRST_NAME
 ,TAB1.CHILD_WORKER
 , TAB1.CHILD_SUPERVISOR
    , TAB1.CHILD_WORKER_JURISDICTION
 , TAB1.FAMILY_WORKER
    , TAB1.FAMILY_SUPERVISOR
 , TAB1.FAMILY_WORKER_JURISDICTION
 , TAB1.PROVIDER_NAME
 , TAB1.SERVICE_NAME
 , TAB1.START_DT
 , TAB1.END_DT
 , TAB1.VALIDATION_STATUS
 , TAB1.ENTRY_DT
 , TAB1.EXIT_DT
 FROM
 (SELECT 
  (SELECT countyname
   FROM county 
   WHERE countyid in       
       (SELECT c.countyid 
       FROM caseassignment ca, team t, county c
       WHERE ca.toteamid = t.teamid AND 
        c.countyid = t.countyid::uuid AND
        ca.responsibilitytypekey = 'child' AND
        ca.activeflag = 1 AND
        ca.objectid IN ( SELECT SC.servicecaseid 
            FROM SERVICECASE SC, TB_PLACEMENT PL 
            WHERE SC.servicecasenumber = PL.case_id::VARCHAR ) AND 
        (ca.enddate IS NULL OR ca.enddate > now())
       ORDER BY
       coalesce(ca.enddate, now()) DESC, ca.startdate DESC
        FETCH FIRST 1 ROWS ONLY) AND 
     activeflag = 1) AS CHILD_WORKER_JURISDICTION 
  , F_SERVICENAME(PL.PLACEMENT_STRUCTURE_ID) AS SERVICE_NAME
  , PL.CLIENT_ID  AS CHILD_ID
  , CL.lastname    AS CHILD_LAST_NAME
  , CL.firstname   AS CHILD_FIRST_NAME
  , (CASE WHEN LENGTH(RTRIM(PROVIDER_NM)) > 0 THEN 
    PROVIDER_NM
   ELSE
       (PROVIDER_LAST_NM || ', '  ||  PROVIDER_FIRST_NM)
      END )  AS PROVIDER_NAME
  , F_PLVALUE(PV.VALIDATION_STATUS_CD, 146) AS VALIDATION_STATUS
  , PV.VALIDATION_START_DT AS START_DT
  , PV.VALIDATION_END_DT AS END_DT
  , (SELECT (lastname || ' ' || firstname || COALESCE(',' || CASE WHEN middlename = ' ' THEN NULL ELSE middlename END,''))
                            FROM userprofile WHERE securityusersid in (SELECT caseassignment.toworkeridno 
   FROM caseassignment
   WHERE caseassignment.activeflag = 1
   AND caseassignment.objectid IN ( SELECT SC.servicecaseid 
                 FROM SERVICECASE SC, TB_PLACEMENT PL 
                 WHERE SC.servicecasenumber = PL.case_id::VARCHAR )
   AND caseassignment.responsibilitytypekey::text = 'child'::text
   AND (caseassignment.enddate IS NULL OR caseassignment.enddate > now())
   ORDER BY
   coalesce(caseassignment.enddate, now()) DESC, caseassignment.startdate DESC
                     FETCH FIRST 1 ROWS ONLY
                 ) AND activeflag = 1) AS CHILD_WORKER
  , (SELECT (lastname || ' ' || firstname || COALESCE(',' || CASE WHEN middlename = ' ' THEN NULL ELSE middlename END,''))
                            FROM userprofile WHERE securityusersid in (SELECT caseassignment.fromworkeridno 
   FROM caseassignment
   WHERE caseassignment.activeflag = 1
   AND caseassignment.objectid IN ( SELECT SC.servicecaseid 
                 FROM SERVICECASE SC, TB_PLACEMENT PL 
                 WHERE SC.servicecasenumber = PL.case_id::VARCHAR )
   AND caseassignment.responsibilitytypekey::text = 'child'::text
   AND (caseassignment.enddate IS NULL OR caseassignment.enddate > now())
   ORDER BY
   coalesce(caseassignment.enddate, now()) DESC, caseassignment.startdate DESC
                     FETCH FIRST 1 ROWS ONLY
                 ) AND activeflag = 1) AS CHILD_SUPERVISOR               
  , (SELECT (lastname || ' ' || firstname || COALESCE(',' || CASE WHEN middlename = ' ' THEN NULL ELSE middlename END,''))
                            FROM userprofile WHERE securityusersid in (SELECT caseassignment.toworkeridno 
   FROM caseassignment
   WHERE caseassignment.activeflag = 1
   AND caseassignment.objectid IN ( SELECT SC.servicecaseid 
                 FROM SERVICECASE SC, TB_PLACEMENT PL 
                 WHERE SC.servicecasenumber = PL.case_id::VARCHAR )
   AND caseassignment.responsibilitytypekey::text = 'family'::text
   AND (caseassignment.enddate IS NULL OR caseassignment.enddate > now())
   ORDER BY
   coalesce(caseassignment.enddate, now()) DESC, caseassignment.startdate DESC
                     FETCH FIRST 1 ROWS ONLY
                 ) AND activeflag = 1) AS FAMILY_WORKER
  , (SELECT (lastname || ' ' || firstname || COALESCE(',' || CASE WHEN middlename = ' ' THEN NULL ELSE middlename END,''))
                            FROM userprofile WHERE securityusersid in (SELECT caseassignment.fromworkeridno 
   FROM caseassignment
   WHERE caseassignment.activeflag = 1
   AND caseassignment.objectid IN ( SELECT SC.servicecaseid 
                 FROM SERVICECASE SC, TB_PLACEMENT PL 
                 WHERE SC.servicecasenumber = PL.case_id::VARCHAR )
   AND caseassignment.responsibilitytypekey::text = 'family'::text
   AND (caseassignment.enddate IS NULL OR caseassignment.enddate > now())
   ORDER BY
   coalesce(caseassignment.enddate, now()) DESC, caseassignment.startdate DESC
                     FETCH FIRST 1 ROWS ONLY
                 ) AND activeflag = 1) AS FAMILY_SUPERVISOR
  , (SELECT countyname
   FROM county 
   WHERE countyid in       
       (SELECT c.countyid 
       FROM caseassignment ca, team t, county c
       WHERE ca.toteamid = t.teamid AND 
        c.countyid = t.countyid::uuid AND
        ca.responsibilitytypekey = 'family' AND
        ca.activeflag = 1 AND
        ca.objectid IN ( SELECT SC.servicecaseid 
            FROM SERVICECASE SC, TB_PLACEMENT PL 
            WHERE SC.servicecasenumber = PL.case_id::VARCHAR ) AND 
        (ca.enddate IS NULL OR ca.enddate > now())
       ORDER BY
       coalesce(ca.enddate, now()) DESC, ca.startdate DESC
        FETCH FIRST 1 ROWS ONLY) AND 
     activeflag = 1) AS FAMILY_WORKER_JURISDICTION                
  , PL.exit_dt
  , PL.ENTRY_DT
 FROM
  caseassignment ASGN 
  , servicecase SC
  , tb_placement PL
  , person CL
  , tb_placement_validation PV
  , tb_provider PR
 WHERE 
  ASGN.objectid = SC.servicecaseid AND ASGN.activeflag = 1 AND 
  SC.servicecasenumber = PL.case_id::varchar AND SC.activeflag = 1 AND PL.delete_sw = 'N' AND 
  CL.cjamspid = PL.client_id AND CL.activeflag = 1 AND PL.VOID_SW IS NULL AND
  PV.placement_id = PL.placement_id AND PV.delete_sw = 'N' AND 
  ((PV.VALIDATION_STATUS_CD IS NULL) OR (PV.VALIDATION_STATUS_CD <> '1750')) AND 
  PR.provider_id = PL.provider_id AND PR.delete_sw = 'N' 
 AND ((--(PL.exit_reason_cd IS NULL OR PL.EXIT_REASON_CD <> '4529')      AND 
              (PL.EXIT_DT IS NULL OR PL.EXIT_DT >= CAST (Start_date AS DATE)) 
AND F_SERVICENAME(PL.PLACEMENT_STRUCTURE_ID) NOT LIKE 'ADOPTIVE HOME')
             OR (--PL.EXIT_REASON_CD = '4529' AND 
     PL.EXIT_DT > DATE (CAST (End_date  AS DATE))+ interval '60 DAYS'))
 ) AS TAB1  );
end;
$function$

