CREATE OR REPLACE FUNCTION as_getdocdetails_cnt(v_datype character varying, v_dasubtype character varying, v_entityroletypekey character varying)
 RETURNS SETOF bigint
 LANGUAGE plpgsql
AS $function$
DECLARE 
      _datype character varying;
      _dasubtype character varying;
      _entityroletypekey character varying;     
BEGIN 

   IF v_datype = 'undefined' THEN 
           _datype = null; 
      ELSE 
           _datype = v_datype; 
      END IF;

       IF v_dasubtype = 'undefined' THEN 
           _dasubtype = null; 
      ELSE 
           _dasubtype = v_dasubtype; 
      END IF;

       IF v_entityroletypekey = 'undefined' THEN 
           _entityroletypekey = null; 
      ELSE 
           _entityroletypekey = v_entityroletypekey; 
      END IF;

      IF _datype is not null OR _dasubtype is not null OR _entityroletypekey is not null  THEN  

RETURN QUERY   
SELECT count(*) 
FROM ( SELECT 
 A.ServiceRequestTypeConfigId AS ServiceRequestTypeConfigId, 
 A.ActiveFlag AS ActiveFlag, 
 A.WorkLoad AS WorkLoad, 
 A.InternalFile AS InternalFile, 
 A.DueDateOffset AS DueDateOffset, 
 A.LimitedRouting AS LimitedRouting, 
 A.insertedby AS insertedby, 
 A.insertedon AS insertedon, 
 A.updatedby AS updatedby, 
 A.updatedon AS updatedon, 
 A.EffectiveDate AS EffectiveDate, 
 A.ExpirationDate AS ExpirationDate, 
 A.Category AS Category, 
 B.IntakeServReqTypeId AS IntakeServReqTypeId, 
 B.IntakeServReqTypeKey AS IntakeServReqTypeKey, 
 B.Description AS Description, 
 B.insertedby AS insertedby1, 
 B.insertedon AS insertedon1, 
 B.updatedby AS updatedby1, 
 B.updatedon AS updatedon1, 
 B.WorkLoadWeight AS WorkLoadWeight, 
 B.Investigatable AS Investigatable, 
 C.ServiceRequestSubTypeId AS ServiceRequestSubTypeId, 
 C.IntakeServReqTypeId AS IntakeServReqTypeId1, 
 C.ClassKey AS ClassKey, 
 C.Description AS Description1, 
 C.insertedby AS insertedby2, 
 C.insertedon AS insertedon2, 
 C.updatedby AS updatedby2, 
 C.updatedon AS updatedon2, 
 C.timestamp AS timestamp1, 
 C.WorkLoadWeight AS WorkLoadWeight1, 
 C.Investigatable AS Investigatable1, 
 D.IntakeSerReqStatusTypeId AS IntakeSerReqStatusTypeId, 
 D.IntakeSerReqStatusTypeKey AS IntakeSerReqStatusTypeKey, 
 D.Description AS Description2, 
 D.insertedby AS insertedby3, 
 D.insertedon AS insertedon3, 
 D.updatedby AS updatedby3, 
 D.updatedon AS updatedon3, 
 D.ActiveFlag AS ActiveFlag1, 
 D.EffectiveDate AS EffectiveDate1, 
 D.ExpirationDate AS ExpirationDate1, 
 D.timestamp AS Timestamp2, 
 E.SequenceNumber AS SequenceNumber, 
 E.IntakeServiceRequestPlanTypeKey AS IntakeServiceRequestPlanTypeKey, 
 E.ActiveFlag AS ActiveFlag2, 
 E.TypeDescription AS TypeDescription, 
 E.DataValue AS DataValue, 
 E.editable AS editable, 
 E.EffectiveDate AS EffectiveDate2, 
 E.ExpirationDate AS ExpirationDate2, 
 E.old_id AS old_id, 
 E.timestamp AS Timestamp3, 
 1 AS C1, 
 1 AS C2, 
 F.ServiceRequestTypeConfigRoleId AS ServiceRequestTypeConfigRoleId, 
 F.ServiceRequestTypeConfigId AS ServiceRequestTypeConfigId1, 
 F.EntityRoleType AS EntityRoleType, 
 F.EntityRoleTypeKey AS EntityRoleTypeKey, 
 F.ActiveFlag AS ActiveFlag3, 
 F.EffectiveDate AS EffectiveDate3, 
 F.ExpirationDate AS ExpirationDate3, 
 F.insertedby AS insertedby4, 
 F.insertedon AS insertedon4, 
 F.updatedby AS updatedby4, 
 F.updatedon AS updatedon4, 
 F.timestamp AS timestamp4, 
 CASE WHEN (F.ServiceRequestTypeConfigRoleId IS NULL) THEN CAST(NULL AS int) ELSE 1 END AS C3, 
 CASE WHEN (F.ServiceRequestTypeConfigRoleId IS NULL) THEN CAST(NULL AS int) ELSE 1 END AS C4
 FROM      ServiceRequestTypeConfig AS A
 LEFT OUTER JOIN IntakeServiceRequestType AS B ON A.IntakeServReqTypeId = B.IntakeServReqTypeId
 LEFT OUTER JOIN ServiceRequestSubType AS C ON A.ServiceRequestSubTypeId = C.ServiceRequestSubTypeId
 LEFT OUTER JOIN IntakeSerReqStatusType AS D ON A.IntakeSerReqStatusTypeId = D.IntakeSerReqStatusTypeId
 LEFT OUTER JOIN IntakeServiceRequestPlanType AS E ON A.IntakeServiceRequestPlanTypeKey = E.IntakeServiceRequestPlanTypeKey
 LEFT OUTER JOIN ServiceRequestTypeConfigRole AS F ON A.ServiceRequestTypeConfigId = F.ServiceRequestTypeConfigId
 WHERE  EXISTS (SELECT 
  cast(1 as bit) AS C1
  FROM ServiceRequestTypeConfigRole AS Extent7
  WHERE (A.ServiceRequestTypeConfigId = Extent7.ServiceRequestTypeConfigId) and Extent7.activeflag=1 and Extent7.EntityRoleType= 'DocumentType'
 )and 
 CASE WHEN _datype is not null THEN lower(B.Description) ILIKE  _datype || '%' ELSE TRUE END AND 
 CASE WHEN  _dasubtype is not null THEN lower(C.Description) ILIKE  _dasubtype || '%' ELSE TRUE END AND 
 CASE WHEN _entityroletypekey is not null THEN lower(F.EntityRoleTypeKey) ILIKE  _entityroletypekey || '%' ELSE TRUE END
)  AS G;

ELSE 


RETURN QUERY   
SELECT count(*) as cnt
FROM ( SELECT 
 A.ServiceRequestTypeConfigId AS ServiceRequestTypeConfigId, 
 A.ActiveFlag AS ActiveFlag, 
 A.WorkLoad AS WorkLoad, 
 A.InternalFile AS InternalFile, 
 A.DueDateOffset AS DueDateOffset, 
 A.LimitedRouting AS LimitedRouting, 
 A.insertedby AS insertedby, 
 A.insertedon AS insertedon, 
 A.updatedby AS updatedby, 
 A.updatedon AS updatedon, 
 A.EffectiveDate AS EffectiveDate, 
 A.ExpirationDate AS ExpirationDate, 
 A.Category AS Category, 
 B.IntakeServReqTypeId AS IntakeServReqTypeId, 
 B.IntakeServReqTypeKey AS IntakeServReqTypeKey, 
 B.Description AS Description, 
 B.insertedby AS insertedby1, 
 B.insertedon AS insertedon1, 
 B.updatedby AS updatedby1, 
 B.updatedon AS updatedon1, 
 B.WorkLoadWeight AS WorkLoadWeight, 
 B.Investigatable AS Investigatable, 
 C.ServiceRequestSubTypeId AS ServiceRequestSubTypeId, 
 C.IntakeServReqTypeId AS IntakeServReqTypeId1, 
 C.ClassKey AS ClassKey, 
 C.Description AS Description1, 
 C.insertedby AS insertedby2, 
 C.insertedon AS insertedon2, 
 C.updatedby AS updatedby2, 
 C.updatedon AS updatedon2, 
 C.timestamp AS timestamp1, 
 C.WorkLoadWeight AS WorkLoadWeight1, 
 C.Investigatable AS Investigatable1, 
 D.IntakeSerReqStatusTypeId AS IntakeSerReqStatusTypeId, 
 D.IntakeSerReqStatusTypeKey AS IntakeSerReqStatusTypeKey, 
 D.Description AS Description2, 
 D.insertedby AS insertedby3, 
 D.insertedon AS insertedon3, 
 D.updatedby AS updatedby3, 
 D.updatedon AS updatedon3, 
 D.ActiveFlag AS ActiveFlag1, 
 D.EffectiveDate AS EffectiveDate1, 
 D.ExpirationDate AS ExpirationDate1, 
 D.timestamp AS Timestamp2, 
 E.SequenceNumber AS SequenceNumber, 
 E.IntakeServiceRequestPlanTypeKey AS IntakeServiceRequestPlanTypeKey, 
 E.ActiveFlag AS ActiveFlag2, 
 E.TypeDescription AS TypeDescription, 
 E.DataValue AS DataValue, 
 E.editable AS editable, 
 E.EffectiveDate AS EffectiveDate2, 
 E.ExpirationDate AS ExpirationDate2, 
 E.old_id AS old_id, 
 E.timestamp AS Timestamp3, 
 1 AS C1, 
 1 AS C2, 
 F.ServiceRequestTypeConfigRoleId AS ServiceRequestTypeConfigRoleId, 
 F.ServiceRequestTypeConfigId AS ServiceRequestTypeConfigId1, 
 F.EntityRoleType AS EntityRoleType, 
 F.EntityRoleTypeKey AS EntityRoleTypeKey, 
 F.ActiveFlag AS ActiveFlag3, 
 F.EffectiveDate AS EffectiveDate3, 
 F.ExpirationDate AS ExpirationDate3, 
 F.insertedby AS insertedby4, 
 F.insertedon AS insertedon4, 
 F.updatedby AS updatedby4, 
 F.updatedon AS updatedon4, 
 F.timestamp AS timestamp4, 
 CASE WHEN (F.ServiceRequestTypeConfigRoleId IS NULL) THEN CAST(NULL AS int) ELSE 1 END AS C3, 
 CASE WHEN (F.ServiceRequestTypeConfigRoleId IS NULL) THEN CAST(NULL AS int) ELSE 1 END AS C4
 FROM      ServiceRequestTypeConfig AS A
 LEFT OUTER JOIN IntakeServiceRequestType AS B ON A.IntakeServReqTypeId = B.IntakeServReqTypeId
 LEFT OUTER JOIN ServiceRequestSubType AS C ON A.ServiceRequestSubTypeId = C.ServiceRequestSubTypeId
 LEFT OUTER JOIN IntakeSerReqStatusType AS D ON A.IntakeSerReqStatusTypeId = D.IntakeSerReqStatusTypeId
 LEFT OUTER JOIN IntakeServiceRequestPlanType AS E ON A.IntakeServiceRequestPlanTypeKey = E.IntakeServiceRequestPlanTypeKey
 LEFT OUTER JOIN ServiceRequestTypeConfigRole AS F ON A.ServiceRequestTypeConfigId = F.ServiceRequestTypeConfigId
 WHERE  EXISTS (SELECT 
  cast(1 as bit) AS C1
  FROM ServiceRequestTypeConfigRole AS Extent7
  WHERE (A.ServiceRequestTypeConfigId = Extent7.ServiceRequestTypeConfigId) and Extent7.activeflag=1 and Extent7.EntityRoleType= 'DocumentType'
 )
)  AS G;

END IF;
  END;
$function$

