CREATE OR REPLACE FUNCTION f_fm145r(start_date date, end_date date)
 RETURNS TABLE(provider_id integer, payment_id integer, child_id bigint, amount numeric, mail_code character varying, tax_id numeric, final_service_start_dt date, final_service_end_dt date, offset_amount_no numeric, under_over_reason character varying, placement_structure_service text, program_nm character varying, case_worker character varying, case_worker_phone text, case_worker_county character varying, county_cd character varying)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY 
(SELECT      
TB_PAYMENT_HEADER.PROVIDER_ID AS PROVIDER_ID, 
TB_PAYMENT_DETAIL.PAYMENT_ID AS PAYMENT_ID,
F_ENAME('2955',CAST(TB_PAYMENT_DETAIL.CLIENT_ID AS VARCHAR)) AS CHILD_NAME,
TB_PAYMENT_DETAIL.CLIENT_ID AS CHILD_ID,
TB_PAYMENT_DETAIL.FINAL_AMOUNT_NO AS AMOUNT, 
TB_PROVIDER.MAIL_CODE_TX AS MAIL_CODE,
TB_PROVIDER.TAX_ID_NO AS TAX_ID,
TB_PAYMENT_DETAIL.FINAL_SERVICE_START_DT,
TB_PAYMENT_DETAIL.FINAL_SERVICE_END_DT,
TB_PAYMENT_HEADER.OFFSET_AMOUNT_NO,
F_GET_UNDER_OVER_REASON (TB_PAYMENT_DETAIL.PAYMENT_DETAIL_ID,'1008') AS UNDER_OVER_REASON,
F_SERVICENAME(TB_PAYMENT_DETAIL.FINAL_SERVICE_ID) ||' '|| COALESCE('-'|| F_PLVALUE(TB_PAYMENT_DETAIL.FINAL_RATE_TYPE_CD,82),'') AS PLACEMENT_STRUCTURE_SERVICE ,
(SELECT PROGRAMNAME FROM PROGRAM WHERE CAST(OLD_ID AS INTEGER) IN (SELECT CONTRACT_PROGRAM_ID FROM TB_PLACEMENT WHERE
PLACEMENT_ID=TB_PAYMENT_DETAIL.PLACEMENT_ID) ) PROGRAM_NM,
COALESCE
(  
(SELECT F_SNAME(STAFF_ID)
  FROM TB_STAFF WHERE STAFF_ID IN
  (SELECT
TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID FROM TB_ASSIGNMENT, ASSIGNMENTCLIENTS
WHERE TB_ASSIGNMENT.ASSIGNMENT_ID=ASSIGNMENTCLIENTS.ASSIGNMENTID
AND TB_ASSIGNMENT.ENTITY_KEY_ID=TB_PAYMENT_DETAIL.CASE_ID
AND (SELECT PI.PERSONIDENTIFIERVALUE FROM PERSONIDENTIFIER PI, PERSON P
 WHERE PI.PERSONID = P.PERSONID 
 AND P.PERSONID = ASSIGNMENTCLIENTS.PERSONID)= TB_PAYMENT_DETAIL.CLIENT_ID :: VARCHAR  --ADDED THE LOGIC FOR IDENFYING CLIENT'S SECONDARY WORKER
AND TB_ASSIGNMENT.RESPONSIBILITY_CD='S'
AND TB_ASSIGNMENT.DELETE_SW='N'
AND ASSIGNMENTCLIENTS.ACTIVEFLAG=1
AND (TB_ASSIGNMENT.END_DT IS
NULL OR TB_ASSIGNMENT.END_DT > CAST(END_DATE AS DATE))
ORDER BY
COALESCE(TB_ASSIGNMENT.END_DT,CURRENT_DATE) DESC,TB_ASSIGNMENT.START_DT DESC
                  FETCH FIRST 1 ROWS ONLY
              )
AND DELETE_SW='N') ,
--IN CORRECT LOGIC FOR CHLD WORKER USED INITALLY--

F_SNAME( (SELECT TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID
                          FROM TB_ASSIGNMENT
                         WHERE TB_ASSIGNMENT.ENTITY_KEY_ID=TB_PAYMENT_DETAIL.CASE_ID
            AND (TB_ASSIGNMENT.END_DT IS NULL OR TB_ASSIGNMENT.END_DT > CAST(END_DATE AS DATE))
                          AND TB_ASSIGNMENT.RESPONSIBILITY_CD = 'P'
     ORDER BY COALESCE(TB_ASSIGNMENT.END_DT,CURRENT_DATE) DESC,TB_ASSIGNMENT.START_DT DESC
            FETCH FIRST 1 ROWS ONLY
       )
       )
 ) AS CASE_WORKER,

 COALESCE 
 (
  (SELECT SADR_WORK_PHONE_TX ||' '|| COALESCE('-'||SADR_WORK_XTN_TX,'')
  FROM TB_STAFF
  WHERE STAFF_ID IN  (SELECT TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID FROM TB_ASSIGNMENT,ASSIGNMENTCLIENTS
WHERE TB_ASSIGNMENT.ASSIGNMENT_ID=ASSIGNMENTCLIENTS.ASSIGNMENTID
AND TB_ASSIGNMENT.ENTITY_KEY_ID=TB_PAYMENT_DETAIL.CASE_ID
AND (SELECT PI.PERSONIDENTIFIERVALUE FROM PERSONIDENTIFIER PI, PERSON P
 WHERE PI.PERSONID = P.PERSONID 
 AND P.PERSONID = ASSIGNMENTCLIENTS.PERSONID)=TB_PAYMENT_DETAIL.CLIENT_ID :: VARCHAR   --ADDED THE LOGIC FOR IDENFYING CLIENT'S SECONDARY WORKER
AND TB_ASSIGNMENT.RESPONSIBILITY_CD='S'
AND TB_ASSIGNMENT.DELETE_SW='N'
AND ASSIGNMENTCLIENTS.ACTIVEFLAG=1
ORDER BY
COALESCE(TB_ASSIGNMENT.END_DT,CURRENT_DATE) DESC,TB_ASSIGNMENT.START_DT DESC
FETCH FIRST 1 ROWS ONLY
)
) ,  --IN CORRECT LOGIC--BUT NOT CHANGED AS COL NOT USED IN THE STATEMENT

  (SELECT SADR_WORK_PHONE_TX ||' '||COALESCE('-'||SADR_WORK_XTN_TX,'')
  FROM TB_STAFF
  WHERE STAFF_ID IN  ( 
     (SELECT TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID
                 FROM TB_ASSIGNMENT
             WHERE TB_ASSIGNMENT.ENTITY_KEY_ID=TB_PAYMENT_DETAIL.CASE_ID
     AND TB_ASSIGNMENT.END_DT IS NULL
              AND TB_ASSIGNMENT.RESPONSIBILITY_CD = 'P'
     ORDER BY TB_ASSIGNMENT.END_DT DESC
            FETCH FIRST 1 ROWS ONLY
     )
           )
  )
  ) AS CASE_WORKER_PHONE,

COALESCE
(
(SELECT F_PLVALUE (TB_STAFF.PRIMARY_COUNTY_CD, 104)
  FROM TB_STAFF WHERE STAFF_ID IN
(SELECT
TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID FROM TB_ASSIGNMENT,ASSIGNMENTCLIENTS
WHERE TB_ASSIGNMENT.ASSIGNMENT_ID=ASSIGNMENTCLIENTS.ASSIGNMENTID
AND TB_ASSIGNMENT.ENTITY_KEY_ID=TB_PAYMENT_DETAIL.CASE_ID
AND (SELECT PI.PERSONIDENTIFIERVALUE FROM PERSONIDENTIFIER PI, PERSON P
 WHERE PI.PERSONID = P.PERSONID 
 AND P.PERSONID = ASSIGNMENTCLIENTS.PERSONID)=TB_PAYMENT_DETAIL.CLIENT_ID :: VARCHAR
AND TB_ASSIGNMENT.RESPONSIBILITY_CD='S'
AND TB_ASSIGNMENT.DELETE_SW='N'
AND ASSIGNMENTCLIENTS.ACTIVEFLAG=1
AND (TB_ASSIGNMENT.END_DT IS
NULL OR TB_ASSIGNMENT.END_DT > CAST(END_DATE AS DATE))
ORDER BY
COALESCE(TB_ASSIGNMENT.END_DT,CURRENT_DATE) DESC,TB_ASSIGNMENT.START_DT DESC
FETCH FIRST 1 ROWS ONLY
)
AND DELETE_SW='N') ,
(SELECT F_PLVALUE (TB_STAFF.PRIMARY_COUNTY_CD, 104)
  FROM TB_STAFF WHERE STAFF_ID IN
(SELECT TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID
                          FROM TB_ASSIGNMENT
                         WHERE TB_ASSIGNMENT.ENTITY_KEY_ID=TB_PAYMENT_DETAIL.CASE_ID
            AND (TB_ASSIGNMENT.END_DT IS NULL OR TB_ASSIGNMENT.END_DT > CAST(END_DATE  AS DATE))
                          AND TB_ASSIGNMENT.RESPONSIBILITY_CD = 'P'
     ORDER BY COALESCE(TB_ASSIGNMENT.END_DT,CURRENT_DATE) DESC,TB_ASSIGNMENT.START_DT DESC
            FETCH FIRST 1 ROWS ONLY
       )
 )) AS CASE_WORKER_COUNTY,
F_ENAME('2953',CAST(TB_PAYMENT_HEADER.PROVIDER_ID AS VARCHAR)) AS PROVIDER_NAME,
F_ADDRESS('TB_PROVIDER_ADDRESSES',TB_PAYMENT_HEADER.PROVIDER_ID, '3356') AS PROVIDER_ADDRESS,
F_ADDRESS('LDSSLOCATIONS',11, TB_PAYMENT_DETAIL.COUNTY_CD) AS LOCATION_ADDRESS,
F_LDSS_PHONE(TB_PAYMENT_DETAIL.COUNTY_CD,'1',1) AS LOCATION_PHONE_TX,
F_PLDESC (TB_PAYMENT_DETAIL.COUNTY_CD, 104)  AS LDSS_NAME,
TB_PAYMENT_DETAIL.COUNTY_CD AS COUNTY_CD

FROM TB_PAYMENT_HEADER,
 TB_PAYMENT_DETAIL,
 TB_PAYMENT_STATUS,
 TB_PROVIDER
WHERE  TB_PAYMENT_HEADER.PAYMENT_ID = TB_PAYMENT_DETAIL.PAYMENT_ID AND
    TB_PAYMENT_HEADER.PAYMENT_ID = TB_PAYMENT_STATUS.PAYMENT_ID AND
    TB_PAYMENT_STATUS.PAYMENT_STATUS_CD = '1636' AND
    TB_PAYMENT_DETAIL.DELETE_SW = 'N' AND
    TB_PAYMENT_HEADER.PAYMENT_TYPE_CD = '3294' AND
    TB_PAYMENT_HEADER.DELETE_SW = 'N' AND
       TB_PAYMENT_STATUS.DELETE_SW = 'N' AND
    TB_PAYMENT_HEADER.PROVIDER_ID=TB_PROVIDER.PROVIDER_ID AND
    TB_PAYMENT_HEADER.MANUAL_SW='N' AND
    (SELECT DISTINCT PICKLIST_VALUE_CD FROM TB_PROVIDER_PICKLIST
                                            WHERE PICKLIST_VALUE_CD IN ('1782','1783','3049','3274','3302')
                                            AND TB_PROVIDER_PICKLIST.PROVIDER_ID = TB_PROVIDER.PROVIDER_ID
                                            AND DELETE_SW = 'N') IN ('1782','3302','3049','3274','1783') AND
    TB_PAYMENT_STATUS.PAYMENT_STATUS_DT = DATE(CAST(END_DATE AS DATE)) - INTERVAL '1' DAY AND
       COALESCE(TB_PAYMENT_DETAIL.LINKED_PYMNT_HDR_ID,0) NOT IN
  (SELECT TB_PAYMENT_HEADER.PAYMENT_ID
   FROM TB_PAYMENT_STATUS
   JOIN TB_PAYMENT_HEADER
      ON   TB_PAYMENT_STATUS.PAYMENT_ID=TB_PAYMENT_HEADER.PAYMENT_ID
   WHERE PAYMENT_STATUS_CD='1639'
   AND TB_PAYMENT_HEADER.DELETE_SW='N'  
   AND TB_PAYMENT_STATUS.DELETE_SW='N'
   AND TB_PAYMENT_HEADER.PAYMENT_TYPE_CD NOT IN ('6')
  ));
END;
$function$

