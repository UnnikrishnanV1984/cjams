CREATE OR REPLACE FUNCTION as_pg_get_db_space()
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
declare
v_status varchar(20) default 'SUCCESS';
v_var record;
begin
 delete from tb_get_db_space;
 for v_var in( SELECT  pg_database.datname as db_name, 
       pg_size_pretty(pg_database_size(pg_database.datname)) AS db_size      
     FROM    pg_database 
        )
 loop
  insert into tb_get_db_space(db_name,db_size) values(v_var.db_name,v_var.db_size);
 end loop;
 return v_status;

 exception 
        when others then  
     v_status:='FAILED';
    return v_status;
 

end;$function$

