CREATE OR REPLACE FUNCTION prov_getallsunsetreports(v_providerid integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE 

sunset_reports json;

BEGIN 

select json_agg(a) into sunset_reports from (
    select  sunset_reports_id,sunset_number,provider_id,
            sunset_report_dt,program_concerns,license_agency,
            status,create_ts,create_user_id,update_ts,update_user_id,delete_sw ,
            (select json_agg(t) from (
                select  psp.sunset_program_id, psp.sunset_number, psp.site_id, psp.compliance_status, psp.visit_frequency,
                        psp.create_ts, psp.create_user_id, psp.update_ts, psp.update_user_id, psp.delete_sw
                from prov_sunset_programs psp
                where psp.sunset_number = psr.sunset_number 
                and psp.delete_sw = 'N'  
            )t ) as programs
    from prov_sunset_reports psr
    where psr.provider_id = v_providerid 
    order by update_ts desc
)a;


return sunset_reports;

end;

$function$

