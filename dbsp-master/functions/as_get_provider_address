CREATE OR REPLACE FUNCTION as_get_provider_address(v_providerid integer, v_addresstype character varying)
 RETURNS TABLE(provider_adr character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_adrformat character varying;

BEGIN 
 
select tpaa.adr_format_cd into v_adrformat from prov.tb_provider_addresses tpaa 
where tpaa.parent_key_id = v_providerid:: character varying and tpaa.adr_type_cd = ANY (v_addresstype:: text[])
and adr_default_sw='Y'
and delete_sw='N'
order by adr_type_cd asc;

if(v_adrformat = 'S')
then
return query

select (concat_ws(' ',
coalesce(provadd.adr_street_tx,''),
(select coalesce(value_tx,'') from tb_picklist_values where trim(picklist_value_cd) in (trim(provadd.adr_pre_dir_cd)) and picklist_type_id='69')
,coalesce(provadd.adr_street_nm,'')
,(select coalesce(value_tx,'') from tb_picklist_values where trim(picklist_value_cd) in ( trim(provadd.adr_street_suffix_cd) ) and picklist_type_id='212')
,(select coalesce(value_tx,'') from tb_picklist_values where trim(picklist_value_cd) in (trim(provadd.adr_post_dir_cd)) and picklist_type_id='69')
,(select value_tx from tb_picklist_values where trim(picklist_value_cd) in (trim(provadd.adr_unit_type_cd) ) and picklist_type_id='250')
,coalesce(provadd.adr_unit_no_tx,''),
coalesce(provadd.adr_city_nm,'')) 
|| ', ' || 
concat_ws(' ', (select coalesce(cnty.countyname,'') from county cnty where cnty.statecountycode = provadd.adr_county_cd and activeflag = 1)
) || ', ' || 
concat_ws(' ',coalesce((select value_tx from tb_picklist_values where trim(picklist_value_cd) in (trim(provadd.adr_state_cd) ) and picklist_type_id='211'),''),coalesce(provadd.adr_zip5_no :: character varying,''))):: character varying
from prov.tb_provider_addresses provadd 
where provadd.adr_default_sw = 'Y' 
and provadd.parent_key_id = v_providerid::character varying 
and provadd.adr_type_cd =  ANY (v_addresstype:: text[])
and provadd.delete_sw='N' order by provadd.adr_type_cd  nulls last limit 1 ;

elsif(v_adrformat = 'R')
then 
return query
select (concat_ws(' ',
coalesce('Rural Rte',''),
coalesce(provadd.adr_street_tx,''),
coalesce(provadd.adr_box_no :: character varying,''),
coalesce(provadd.adr_city_nm,'')
) || ', ' || 
concat_ws(' ', (select coalesce(cnty.countyname,'') from county cnty where cnty.statecountycode = provadd.adr_county_cd and activeflag = 1)
) || ', ' || 
concat_ws(' ',
coalesce((select value_tx from tb_picklist_values where trim(picklist_value_cd) in (trim(provadd.adr_state_cd) ) and picklist_type_id='211'),''),
coalesce(provadd.adr_zip5_no :: character varying,''))):: character varying
from tb_provider_addresses provadd 
where provadd.adr_default_sw = 'Y' 
and provadd.parent_key_id = v_providerid::character varying 
and provadd.adr_type_cd = ANY (v_addresstype:: text[])
and provadd.delete_sw='N' order by  provadd.adr_type_cd  nulls last limit 1 ;

elsif(v_adrformat = 'F')
then 
return query
select (concat_ws(' ',
coalesce(provadd.adr_foreign_tx,null)
) || ', ' || 
concat_ws(' ',
coalesce(provadd.adr_city_nm,null),
coalesce((select cnty.countyname from county cnty where cnty.statecountycode = provadd.adr_county_cd and cnty.activeflag = 1),null),
coalesce(provadd.adr_state_cd,null),
coalesce(provadd.adr_country_tx :: character varying,null):: character varying,
coalesce(provadd. adr_postal_code_tx :: character varying,null))):: character varying
from tb_provider_addresses provadd 
where provadd.adr_default_sw = 'Y' 
and provadd.parent_key_id = v_providerid::character varying 
and provadd.adr_type_cd = ANY (v_addresstype:: text[])
and provadd.delete_sw='N'  order by  provadd.adr_type_cd  nulls last limit 1 ;

elsif(v_adrformat = 'P')
then 
return query
select (concat_ws(' ',
coalesce('PO Box',''),
coalesce(provadd.adr_box_no :: character varying,null)
) || ', ' || 
concat_ws(',',
coalesce(provadd.adr_city_nm,null),
coalesce((select cnty.countyname from county cnty where cnty.statecountycode = provadd.adr_county_cd and cnty.activeflag = 1),null),
coalesce((select value_tx from tb_picklist_values where trim(picklist_value_cd) in (trim(provadd.adr_state_cd) ) and picklist_type_id='211'),null),
coalesce(provadd.adr_country_tx :: character varying,null):: character varying,
coalesce(provadd.adr_zip5_no :: character varying,null))):: character varying
from tb_provider_addresses provadd 
where provadd.adr_default_sw = 'Y' 
and provadd.parent_key_id = v_providerid::character varying 
and provadd.adr_type_cd = ANY (v_addresstype:: text[])
and provadd.delete_sw='N'  order by  provadd.adr_type_cd  nulls last limit 1 ;

end if;
end;

$function$

