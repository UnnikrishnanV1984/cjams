CREATE OR REPLACE FUNCTION personrepresentativeworkersearch(searchobj json)
 RETURNS TABLE(securityusersid character varying, firstname character varying, lastname character varying, fullname character varying, countyname character varying)
 LANGUAGE plpgsql
AS $function$


DECLARE 
        
    v_liCounty uuid;
 
    v_liPageNumber INT;                              
    v_liPageSize INT;
    v_pagenumber int;
 v_pageoffset int;
 
 
 
BEGIN 

v_liCounty := searchobj ->> 'county';
v_liPageNumber := searchobj ->> 'pagenumber';
v_liPageSize := searchobj ->> 'pagesize'; 
raise notice 'test %',v_liCounty; 




return query
 
SELECT 
mu.securityusersid,up.firstname,up.lastname,up.fullname,c.countyname from intakeservicerequest t 
join team te on t.teamtypekey=te.teamtypekey and te.activeflag=1
join teammember tm on tm.teamid=te.teamid and tm.activeflag=1 
join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
join userprofile up on up.securityusersid=mu.securityusersid and up.activeflag=1
left join userprofileaddress upa on upa.securityusersid=up.securityusersid and upa.activeflag=1 and upa.countyid=t.countyid
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag=1
left join county c on c.countyid=t.countyid::uuid and c.activeflag=1
where t.activeflag=1 
AND (v_liCounty IS NULL OR t.countyid = v_liCounty)  and up.teamtypekey='AS'
group by mu.securityusersid,up.firstname,up.lastname,up.fullname,c.countyname

ORDER by up.fullname asc;


              
                 



END;

$function$

