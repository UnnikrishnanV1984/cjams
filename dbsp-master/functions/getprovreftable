CREATE OR REPLACE FUNCTION getprovreftable(updatedtlsobj json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 

DECLARE 
v_referralid text;
v_referraldata json;
v_referraldecision text;
v_address json;

begin
v_referralid := updatedtlsobj->>'referralnumber';
v_referraldecision:= updatedtlsobj->>'status';

select array_to_json(array_agg(row_to_json(t)))
from (
SELECT pr.provider_referral_id, pr.provider_referral_nm,pr.provider_referral_first_nm,pr.provider_referral_last_nm,pr.narrative,pr.is_son, pr.is_rfp, pr.referral_status, pr.referral_decision, up.displayname,pr.provider_referral_med, pr.comments_tx,
 pr.dob_dt, pr.tax_id_no, pr.adr_home_phone_tx, pr.adr_email_tx, pr.adr_cell_phone_tx, pr.parent_entity, pr.parent_entity_taxid, pr.corporation_entity, pr.corporation_entity_taxid, pr.provider_referral_program,pr.adr_fax_tx,pr.provider_category,pra.adr_city_nm,
 pra.adr_street_nm,(pra.adr_street_no)::int,(pra.adr_zip5_no)::int,pra.adr_state_cd,pra.adr_county_cd,pra.adr_country_tx,pr.provider_program_name,pr.agency,pra.adr_county_cd_tx,
    (
      select array_to_json(array_agg(row_to_json(d)))
      from (
        select pt.program_type, pt.program_type_id from tb_prov_ref_program_type pt
        where pt.referral_id = v_referralid 
      ) d
    ) as provider_program_type
  from tb_provider_referral pr join tb_provider_referral_addresses pra on pr.provider_referral_id = pra.parent_key_id join userprofile up on up.securityusersid = pr.create_user_id
  where  pr.provider_referral_id like '%' || v_referralid || '%' and (v_referraldecision IS NULL OR  v_referraldecision = '' OR pr.referral_decision = v_referraldecision) order by pr.create_ts desc
) t into v_address;

return v_address;

end;

$function$

