CREATE OR REPLACE FUNCTION as_createcasetranferdocumentadd(v_oldintakeserviceid uuid, v_newintakeserviceid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_document RECORD;
v_documentpropertiesid uuid;

BEGIN
for v_document in

SELECT * FROM documentproperties WHERE activeflag =1 
   AND servicerequestid = v_oldintakeserviceid
   
loop
v_documentpropertiesid :=gen_random_uuid();
insert into documentproperties
( documentpropertiesid,objecttypekey, objectid, documenttypekey, documentdate, clientid, servicerequestid,
thirdpartysourceid, filename, tag, title, description, mime, meta, encoding, numberofbytes, updatedby, updatedon,
insertedby, insertedon, activeflag, expirationdate, old_id, timestamp, voidedby, voidedon, voidreasonid,
rootobjectid, rootobjecttypekey, s3bucketpathname, intakenumber, originalfilename, ecmsdocumentid, servicecaseid)


select  v_documentpropertiesid,v_document.objecttypekey, v_newintakeserviceid, v_document.documenttypekey, v_document.documentdate, v_document.clientid, v_newintakeserviceid,
v_document.thirdpartysourceid, v_document.filename, v_document.tag, v_document.title, v_document.description, v_document.mime, v_document.meta, v_document.encoding, v_document.numberofbytes, v_securityusersid, now(),
v_securityusersid, now(), 1, v_document.expirationdate, v_document.old_id, v_document.timestamp, v_document.voidedby, v_document.voidedon, v_document.voidreasonid,
v_newintakeserviceid, v_document.rootobjecttypekey, v_document.s3bucketpathname, v_document.intakenumber, v_document.originalfilename, v_document.ecmsdocumentid, v_document.servicecaseid;




insert into documentattachment
(documentpropertiesid, attachmenttypekey, attachmentclassificationtypekey, attachmentid, 
attachmentdate, sourceauthor, sourceposition, sourcephonenumber, sourceaddress, attachmentsubject, attachmentpurpose, 
acquisitionmethod, locationoforiginal, note, updatedby, updatedon, insertedby, insertedon, activeflag, expirationdate, 
old_id, timestamp, assessmenttemplateid, attachmentclassificationsubtypekey)

select v_documentpropertiesid, da.attachmenttypekey, da.attachmentclassificationtypekey, da.attachmentid,
da.attachmentdate, da.sourceauthor, da.sourceposition, da.sourcephonenumber, da.sourceaddress, da.attachmentsubject, da.attachmentpurpose,
da.acquisitionmethod, da.locationoforiginal, da.note, v_securityusersid, now(), v_securityusersid, now(), 1, da.expirationdate,
da.old_id, da.timestamp, da.assessmenttemplateid, da.attachmentclassificationsubtypekey 
from documentattachment da where da.documentpropertiesid=v_document.documentpropertiesid;


end loop;   


Return 'Success';
   
end;

$function$

