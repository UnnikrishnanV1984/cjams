CREATE OR REPLACE FUNCTION as_sendrestitutionnotification(v_placementadmissionclassificationkey character varying, v_intakeserviceid uuid, v_providername character varying, v_releasedate timestamp without time zone)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

---------sending notification when a residential placement is added-----------------

declare 

v_personid uuid;
v_countyid uuid;
v_activity record;
v_subactivity record;
v_subject character varying;
v_body text;
v_send_notification character varying;

begin

  select distinct personid,irs.countyid into v_personid,v_countyid from intakeservicerequestactor ira 
    join intakeserreqrestitution irs on irs.youthpersonid = ira.personid
 where ira.intakeserviceid=v_intakeserviceid and intakeservicerequestpersontypekey='Youth';

 RAISE NOTICE 'v_personid  %', v_personid ;
FOR  v_activity  in

  select  mu.securityusersid,restitutionno,CONCAT(p.firstname,' ',p.lastname) as name,irt.intakenumber from intakeserreqrestitution irt,person p,team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
    join as_teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 
    join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
    join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
    where t.countyid::uuid=v_countyid::uuid and r.roletypekey='JSRTC'
    and irt.youthpersonid=v_personid and p.personid=v_personid
 
 loop 
RAISE NOTICE 'v_activity.securityusersid %', v_activity.securityusersid ;
  v_subject = v_activity.name || ' has been placed in a residential facility';
  v_body = 'Restitution Account#'||v_activity.restitutionno ||' has been deferred for '||v_activity.name||' due to Residential admission in '
 ||v_providername||' (Case#'||v_activity.intakenumber||') and projected release date is '||v_releasedate;
 
 select send_notification into v_send_notification from as_send_notification(v_activity.securityusersid,'System'::character varying,v_activity.securityusersid::character varying,'System'::character varying,'High'::character varying,v_subject::character varying,v_body::character varying,v_intakeserviceid::character varying,false);
   
 update intakeserreqrestitution set status='Inactive',inactivereasontype='Residplacement' where restitutionno=v_activity.restitutionno and youthpersonid=v_personid and status != 'Closed';

 END  LOOP;


return 'Success';

 
end;
 

$function$

