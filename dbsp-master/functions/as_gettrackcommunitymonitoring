CREATE OR REPLACE FUNCTION as_gettrackcommunitymonitoring(intakeserviceidval uuid)
 RETURNS TABLE(trackcommunitymonitoring json)
 LANGUAGE plpgsql
AS $function$

declare v_intakeserviceid uuid;
BEGIN


 v_intakeserviceid:=intakeserviceidval;

 
 Return Query
 SELECT json_agg(A) FROM 
  (
       select count(1) OVER() totalcount,trc.trackcommunitymonitoringid,trc.placementid,trc.placementprimaryapprovedalttypeid,trc.intakeserviceid,
        trc.placementprimaryapprovedalttypekey,trc.startdate,trc.region,trc.countycode,c.countyname,trc.courtorderspecific,trc.photos,
        trc.isoutcomesuccessful,trc.outcomereasonkey,trc.outcomereasondesc,trc.enddate, ppaa.description as placementprimaryapprovedalttypedesc,pr.providername,cmv.violations 
        from trackcommunitymonitoring as trc
        left join placement as pl on trc.placementid=pl.placementid
        left join provider pr on pl.providerid = pr.providerid and pr.activeflag=1
        left join county as c on trc.countycode = c.countycode 
        left join (select json_agg(p) as violations,p.intakeserviceid,p.trackcommunitymonitoringid from
trackcommunitymonitoringviolations as p group by p.intakeserviceid,p.trackcommunitymonitoringid) as cmv on trc.intakeserviceid= cmv.intakeserviceid
and trc.trackcommunitymonitoringid=cmv.trackcommunitymonitoringid
left join placementprimaryapprovedalttype ppaa
    on ppaa.placementprimaryapprovedalttypekey = trc.placementprimaryapprovedalttypekey
        where trc.intakeserviceid=v_intakeserviceid
        ) A;
 
  end;

$function$

