CREATE OR REPLACE FUNCTION as_getserviceactivity(v_status character varying, v_securityusersid character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(casenumber character varying, goaltypedesc character varying, statustypedesc character varying, serviceplanactivityid uuid, activity character varying, servicetypekey character varying, servicesubtypekey character varying, personinvolved character varying, responsibleperson character varying, reevaluationdate timestamp without time zone, completiondate timestamp without time zone, serviceplangoalid uuid, serviceplanactivitystatustypekey character varying, activeflag integer, effectivedate timestamp without time zone, insertedby character varying, updatedby character varying, insertedon timestamp without time zone, updatedon timestamp without time zone, old_id character varying, objecttypekey character varying, objectid character varying, serviceplanid integer, personid uuid, staffid integer, taskideatypekey character varying, datavalidflag integer, clientmergeid uuid, fk_id character varying, activitysubtypekey character varying, need character varying, otherservicetypedescription character varying, othersubtypedescription character varying, otherreason character varying, reasontypekey character varying, serviceunavailable character varying, initialcondition character varying, personsinvolvedid uuid, responsiblepersonid character varying, plannedstartdate timestamp without time zone, plannedenddate timestamp without time zone, progressnote character varying, responsiblepersontype character varying, otherresponsibleperson character varying, suspendstartdate timestamp without time zone, change_reason text, suspendenddate timestamp without time zone, providerid uuid, providercontracttypekey character varying, providercontractrateid uuid, startdate timestamp without time zone, enddate timestamp without time zone, isrepeats integer, noofoccurence integer, rate numeric, reason text, serviceplanlogstatustypekey character varying, noofweeks integer, noofhours integer, providertypekey character varying, familyworkername character varying, servicecategorytypekey character varying, categorysubtypekey character varying, serviceplanvendorid uuid, securityusersid character varying, countyid uuid, careworkername character varying, services json)
 LANGUAGE plpgsql
AS $function$
 

DECLARE
    v_pageoffset int;
 v_pagenumber int;
 v_inputstatus character varying;
   
     
BEGIN
    v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
   
   if(v_status='Approval') then
   v_inputstatus = v_status;
   v_status='Review';
   end if;
   
 return query 
 
select isr.servicerequestnumber ,rv.description as goaltypedesc, srt.description as statustypedesc, spa.serviceplanactivityid, spa.activity, spa.servicetypekey, spa.servicesubtypekey, spa.personinvolved, spa.responsibleperson, 
spa.reevaluationdate, spa.completiondate, spa.serviceplangoalid, spa.serviceplanactivitystatustypekey, spa.activeflag, 
spa.effectivedate, spa.insertedby, spa.updatedby, spa.insertedon, spa.updatedon, spa.old_id, spa.objecttypekey, spa.objectid, 
spa.serviceplanid, spa.personid, spa.staffid, spa.taskideatypekey, spa.datavalidflag, spa.clientmergeid, spa.fk_id, 
spa.activitysubtypekey, spa.need, spa.otherservicetypedescription, spa.othersubtypedescription, spa.otherreason, spa.reasontypekey, 
spa.serviceunavailable, spa.initialcondition, spa.personsinvolvedid, spa.responsiblepersonid, spa.plannedstartdate, 
spa.plannedenddate, spa.progressnote, spa.responsiblepersontype, spa.otherresponsibleperson, spa.suspendstartdate, spa.change_reason, 
spa.suspendenddate, spl.providerid, spl.providercontracttypekey, spl.providercontractrateid, spl.startdate, spl.enddate, 
spl.isrepeats, spl.noofoccurence, spl.rate, spl.reason, spl.serviceplanlogstatustypekey, spl.noofweeks, spl.noofhours, 
spl.providertypekey, spl.familyworkername, spl.servicecategorytypekey, spl.categorysubtypekey, spl.serviceplanvendorid, spl.securityusersid, spl.countyid, 
spl.careworkername,(SELECT json_agg(item)
FROM (select distinct s.serviceplanlogid, s.objecttypekey, s.objectid, s.serviceplanactivityid, s.providerid, 
  s.providercontracttypekey, s.providercontractrateid, s.startdate, s.enddate, s.isrepeats, s.noofoccurence, 
  s.reason, s.serviceplanlogstatustypekey, 
  p.providerid, p.providercategorytypekey, p.providername, p.providercode,
  p.prefix, p.firstname, p.middlename, p.lastname,
  paddr.provideraddresstypekey, paddr.buildingno, paddr.addressline1, paddr.addressline2,
  paddr.city, paddr.countyid, coun.countyname, paddr.state, coun.zipcode,
  pcont.contracttypekey as providercontracttypekey, pconttype.providercontracttypename,
  s.rate,s.providertypekey,s.familyworkername,(CASE WHEN (TBP.provider_nm = null OR TBP.provider_nm in ('','DATA IS REPLACED')) 
  THEN CONCAT(TBP.provider_first_nm,' ',TBP.provider_last_nm)::character varying ELSE TBP.provider_nm END) as vendorname,up.fullname,s.careworkername,s.countyid,
  sr.servicename, stype.servicetypedescription,s.rate,
  ''::character varying as servicesubtypedescription
  -- ssubtype.servicesubtypedescription
  -- json_agg(ssubtype.servicesubtypedescription)::json
  FROM serviceplanlog s
  left join prov.tb_provider tbp on tbp.provider_id = s.altproviderid
  left join provider p on s.providerid = p.providerid and p.activeflag = 1
  left join serviceplanvendor sp on sp.serviceplanvendorid=s.serviceplanvendorid and sp.activeflag=1
  left join userprofile up on up.securityusersid=s.securityusersid and up.activeflag=1
  left join provideraddress paddr on p.providerid = paddr.providerid and paddr.activeflag = 1
  left join providercontactinfo pcinfo on p.providerid = pcinfo.providerid and pcinfo.activeflag = 1
  left join providercontactinfotype pcinfotype on pcinfo.providercontactinfotypekey = pcinfotype.providercontactinfotypekey and pcinfotype.activeflag = 1
  left join providercontract pcont on p.providerid = pcont.providerid and pcont.activeflag = 1
  left join providercontracttype pconttype on pcont.programstatuskey = pconttype.providercontracttypekey and pconttype.activeflag = 1
  left join providercontractrate pcontrate on pcontrate.providercontractid = pcont.providercontractid and pcontrate.activeflag = 1
  left join providerservice pserv on p.providerid = pserv.providerid and pserv.activeflag = 1
  left join service sr on sr.serviceid = pserv.serviceid and sr.activeflag = 1
  left join servicetype stype on sr.servicetypekey = stype.servicetypekey and stype.activeflag = 1
  --left join servicesubtype ssubtype on sr.serviceid = ssubtype.serviceid and ssubtype.activeflag = 1
  left join county coun on paddr.countyid = coun.countyid and coun.activeflag = 1
  where --p.activeflag = 1 and 
  s.serviceplanactivityid = spa.serviceplanactivityid) item
) as services from serviceplanactivity  spa 
inner join routing r on spa.serviceplanactivityid::text = r.objectid 
inner join intakeservicerequest isr on isr.intakeserviceid= spa.objectid::uuid
left join serviceplanactivitystatustype srt on srt.serviceplanactivitystatustypekey= spa.serviceplanactivitystatustypekey
left join serviceplanlog spl on spl.serviceplanactivityid = spa.serviceplanactivityid
left join serviceplangoal spg on spg.serviceplangoalid = spa.serviceplangoalid
left join referencevalues rv on rv.ref_key=spg.goaltypekey and rv.referencetypeid=40
where spa.activeflag = 1 and r.activeflag = 1 and r.eventcode = 'ASSPAC' and r.tosecurityusersid = v_securityusersid--r.routingstatustypeid=100
and (v_status is null or spa.approvalstatus=v_status)
/*AND case when v_inputstatus = 'Approved' then r.tosecurityusersid = v_securityusersid else true end
AND case when v_inputstatus = 'Approval' then r.tosecurityusersid = v_securityusersid else true end*/
order by spa.insertedon desc
LIMIT pagesize OFFSET v_pageoffset;

END;   

 
$function$

