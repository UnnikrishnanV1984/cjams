CREATE OR REPLACE FUNCTION prov_getcapacityupdate(v_applicationid character varying)
 RETURNS TABLE(iscapacityallowed boolean, placementcount character varying, applicantcapacity character varying)
 LANGUAGE plpgsql
AS $function$
declare
v_placementcount int4;
v_applicantcapacity int4;
v_providerId character varying;
v_isCapacityAllowed boolean;
v_recon boolean;
begin
 
select case when lower(application_typecode) ='initial' then false else true end into v_recon from tb_public_provider_applicant tppa where applicant_id=v_applicationid;
raise notice 'v_recon%',v_recon;
if (v_recon=true) then 
 raise notice '%','testing';
 select providerid into v_providerId from providerapprovetypeconfig where  applicantid=v_applicationid;
 raise notice '%','prov_getcapacityupdate';
 select count(*) into v_placementcount from tb_placement      
  where provider_id = v_providerId
  and delete_sw = 'N' and entry_dt is not null and exit_dt is null  
  and coalesce(void_sw, 'N') <> 'Y' ;

 select capacity into  v_applicantcapacity from publicproviderhomeplacementspecification where object_id=v_applicationid and delete_sw='N' and active_flag=1 order by update_ts desc limit 1;

    if ((v_applicantcapacity!=0) and  (v_applicantcapacity >=v_placementcount) )then
   v_isCapacityAllowed =true;
 else
   v_isCapacityAllowed =false;
 end if;    
else
 
 select capacity into  v_applicantcapacity from publicproviderhomeplacementspecification where object_id=v_applicationid and delete_sw='N' and active_flag=1 order by update_ts desc limit 1;
 raise notice 'v_applicantcapacity%',v_applicantcapacity;
 if v_applicantcapacity is null then
  v_isCapacityAllowed =false;
  v_applicantcapacity=0;
 else
   if (v_applicantcapacity=0) then
    v_isCapacityAllowed =false;
   else
    v_isCapacityAllowed:=true; 
   end if;  
 end if;
 v_placementcount:=0;
end if;

RETURN Query
select v_isCapacityAllowed, v_placementcount::character varying,v_applicantcapacity:: character varying; 
    
END;

$function$

