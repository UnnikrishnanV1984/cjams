CREATE OR REPLACE FUNCTION getproviderclassincident(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

select PUCI.provider_uir_id, PUCI.class1_typekey,PUCI.class2_typekey,PUCI.class3_typekey,PUCI.other_class3,
RV.description as calss1desc,RVI.description as calss2desc,RVII.description as calss3desc

FROM provider_uir_classincident PUCI 

left join referencevalues RV on RV.ref_key=PUCI.class1_typekey

left join referencevalues RVI on RVI.ref_key=PUCI.class2_typekey

left join referencevalues RVII on RVII.ref_key=PUCI.class3_typekey


where PUCI.provider_uir_id=v_provider_uir_id and PUCI.activeflag=1



 
   )  a;

RETURN  jsondata; 


END;

$function$

