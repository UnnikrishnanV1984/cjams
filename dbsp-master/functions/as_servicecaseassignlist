CREATE OR REPLACE FUNCTION as_servicecaseassignlist(v_usersid character varying, v_status character varying, v_page integer, v_limit integer)
 RETURNS TABLE(servicecaseid uuid, servicecasenumber character varying, caseheadname character varying, startdate timestamp without time zone, statustypekey character varying, enddate timestamp without time zone, assignedusername text)
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_offset    integer;
v_routingstatustypeid integer;
 err_context text;
BEGIN
v_offset  :=  (v_page  -  1)  *  v_limit;


  IF lower(v_status) = 'open' THEN
  v_routingstatustypeid = 2;
  ELSE
  v_routingstatustypeid = 4;
  END IF;
  

 RETURN  query
 
          SELECT sc.servicecaseid, sc.servicecasenumber, sc.caseheadname, sc.startdate, sc.statustypekey, sc.enddate ,
    (SELECT up.firstname || ' ' || up.lastname   assignedusername
     FROM userprofile up 
      WHERE up.securityusersid = r.tosecurityusersid AND  up.activeflag =1 limit 1)
          FROM servicecase sc
    INNER JOIN routing r ON r.objectid = sc.servicecaseid ::character varying AND r.activeflag =1  
    AND r.routingstatustypeid = v_routingstatustypeid AND  r.eventcode = 'SRVC' 
    AND (CASE v_routingstatustypeid WHEN  2 THEN
     r.tosecurityusersid = v_usersid  
     ELSE r.fromsecurityusersid = v_usersid END)
    INNER JOIN routingstatustype rst ON rst.sequencenumber = r.routingstatustypeid AND rst.activeflag =1
    WHERE 
     lower(sc.statustypekey) = lower(v_status)       
    AND sc.activeflag = 1
            LIMIT v_limit OFFSET v_offset;
   
   EXCEPTION 
      WHEN OTHERS THEN
     GET STACKED DIAGNOSTICS err_context = PG_EXCEPTION_CONTEXT;
        RAISE EXCEPTION 'Error:%',SQLERRM ;
  RAISE EXCEPTION 'Error State:%', SQLSTATE;
  RAISE EXCEPTION 'Error Context:%', err_context;
 
END;

$function$

