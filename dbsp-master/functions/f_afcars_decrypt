CREATE OR REPLACE FUNCTION f_afcars_decrypt(vs_entity_id character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure

-- To Decrypt the Case/Client/User IDs 
-- This Procedure is calling Sub SP based on the Entity IDs values

-- Revision(s):
------------------------------------------------------------------------
DECLARE vl_decrypt_entity_id VARCHAR(12);
 
BEGIN
    IF substring(vs_entity_id, 1, 3) = '100' THEN
  RAISE NOTICE 'Call f_afcars_decrypt_chessie - INPUT %', vs_entity_id;
  
  select *
   from f_afcars_decrypt_chessie(vs_entity_id) 
  into vl_decrypt_entity_id ;
 ELSE
  RAISE NOTICE 'Call f_afcars_decrypt_cjams - INPUT %', vs_entity_id;
  
  select *
   from f_afcars_decrypt_cjams(vs_entity_id) 
  into vl_decrypt_entity_id ;
 END IF;
 
 RAISE NOTICE 'OUTPUT %', vl_decrypt_entity_id;
 
 RETURN vl_decrypt_entity_id;
END;

$function$

