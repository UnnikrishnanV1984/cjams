CREATE OR REPLACE FUNCTION as_sp_ive_spv_approval_status(approval_id uuid, approval_status character varying, v_placementtype character varying, pagenumber bigint, pagesize bigint)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare 
v_approval_id uuid;
v_approval_status character varying;

begin
v_approval_id = approval_id;
v_approval_status = approval_status;
if(v_placementtype = 'Fostercare') then
UPDATE tb_ive_fostercare_audit
SET  approvalstatus = v_approval_status
where approvalid = v_approval_id;
  
elseif(v_placementtype = 'Gap') then
 update tb_ive_gapaudit
 set approvalstatus = v_approval_status
 where approvalid = v_approval_id::character varying;

elseif(v_placementtype = 'Adoption') then
 update tb_ive_adoption_audit
 set approvalstatus = v_approval_status
 where approvalid = v_approval_id;
end if; 
return 'success';
end
 $function$

