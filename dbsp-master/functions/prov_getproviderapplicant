CREATE OR REPLACE FUNCTION prov_getproviderapplicant(v_securityusersid uuid, v_provider_id integer, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, license_agency character varying, agency character varying, provider_id integer, applicant_id character varying, program_type character varying, program_name character varying, application_type character varying, mailing_address character varying, prgram character varying, contact_phonenumber character varying, contact_fax character varying, site_id bigint, applicantion_status character varying)
 LANGUAGE plpgsql
AS $function$
DECLARE 

                           
 v_pagenumber int;
 v_pageoffset int;
 
BEGIN 


v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;
 
 return query
  
 select distinct count(1) over() as totalcount, pa.license_agency,pa.agency,p.provider_id,pa.applicant_id,pa.program_type,pa.program_name,pa.application_type,
 pa.mailing_address,pa.prgram,pa.contact_phonenumber,pa.contact_fax, pa.site_id, pa.application_status  from tb_provider p
    join tb_provider_applicant pa on pa.provider_id::int=p.provider_id 
    where p.provider_id = v_provider_id
 and p.provider_status_cd <> '1792'
 --and pa.application_status='Pending'
 LIMIT v_liPageSize OFFSET v_pageoffset;      


END;
$function$

