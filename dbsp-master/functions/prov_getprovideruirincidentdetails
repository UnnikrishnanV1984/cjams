CREATE OR REPLACE FUNCTION prov_getprovideruirincidentdetails(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT 
PUID.provider_uir_incident_detail_id ,PUID.uir_no ,PUID.provider_uir_id ,PUID.incident_type ,PUID.incident_precipitating_event ,PUID.other_class3
,PUID.incident_level_of_supervision,PUID.incident_location ,PUID.incident_area ,PUID.inserted_by ,PUID.inserted_on ,PUID.updated_by ,PUID.updated_on
,PUID.activeflag ,PUID.incident_date ,PUID.incident_time ,PUID.discovered_date ,PUID.discovered_time ,PUID.precipitating_event, RV.value_text, RV.description
FROM Provider_uir_incident_detail PUID
left join referencevalues RV on PUID.incident_area = RV.ref_key
where PUID.provider_uir_id=v_provider_uir_id and PUID.activeflag=1

group by PUID.provider_uir_incident_detail_id ,PUID.uir_no ,PUID.provider_uir_id ,PUID.incident_type ,PUID.incident_precipitating_event ,PUID.other_class3
,PUID.incident_level_of_supervision,PUID.incident_location ,PUID.incident_area ,PUID.inserted_by ,PUID.inserted_on ,PUID.updated_by ,PUID.updated_on
,PUID.activeflag ,PUID.incident_date ,PUID.incident_time ,PUID.discovered_date ,PUID.discovered_time ,PUID.precipitating_event, RV.value_text, RV.description
   )  a;
RETURN  jsondata;
END;

$function$

