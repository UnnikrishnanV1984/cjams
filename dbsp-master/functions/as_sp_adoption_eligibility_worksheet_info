CREATE OR REPLACE FUNCTION as_sp_adoption_eligibility_worksheet_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, childjurisdiction character varying, childagency character varying, removalage integer, servicecaseid uuid, casenumber character varying, childremovaldate timestamp without time zone, removalid bigint, removalcourtorderdate timestamp without time zone, dateofbirth timestamp without time zone, gender character varying, childname character varying, childraceethnicity character varying, uscitizen character varying, qualifiedalien character varying, nameofsecondaryeducationorequivalentprogram character varying, startdateofsecondaryeducationorequivalentprogram timestamp without time zone, nameofpostsecondaryorvocationaleducation character varying, startdateofpostsecondaryorvocationaleducation timestamp without time zone, nameofemployer character varying, startdateofemployment timestamp without time zone, hourspermonthemployed integer, promoteemploymentprogram character varying, promoteemploymentprogramstartdate timestamp without time zone, childdisabilitystartdate timestamp without time zone, childdisabilityevaluationdocumentiondate timestamp without time zone, childdisabilitytype character varying, adoptionapplicable timestamp without time zone, adoptionassistancestartdate timestamp without time zone, effortstoplacechildweremade character varying, finalizationdate timestamp without time zone, adoptionnonapplicable character varying, adoptionpetitiondate timestamp without time zone, childdeprivedofparentalsupport character varying, childhasemotionaldisturbance character varying, childphysicaladdress character varying, childexpectedadoptiveproviderid bigint, issingleparent integer, subsidypaymentstartdate timestamp without time zone, dateoflatestpaymentofminorparent timestamp without time zone, tprdetails json, isafdceligibilitymet character varying, wasthechildremovedfromspecifiedrelative character varying, isincomeassetsmet character varying, parent1providerid integer, parent1providername character varying, effortdate timestamp without time zone, isnoeffort character varying, isexceptiongranted character varying, dateofexceptiongranted timestamp without time zone, removaltypekey character varying, remarks text)
 LANGUAGE plpgsql
AS $function$ declare vs_Procedure_nm varchar(100) default 'sp_adoption_eligibility_worksheet_info';

vn_srv_req_id UUID;

vs_srv_req_no varchar(50);

vd_child_rmvl_dt timestamp;

vd_child_rmvl_crt_ord_dt timestamp;

vd_birth_dt timestamp;

vs_gender varchar(20);

vs_nm varchar(50);

vs_race varchar(50);

vs_us_ctzn varchar(50);

vs_qlfd_alien varchar(50);

vs_scndry_edu_eqlnt_prgm varchar(50);

vd_scndry_edu_eqlnt_prgm_strt_dt timestamp;

vs_post_scndry_vctl_edu varchar(50);

vd_post_scndry_vctl_edu_strt_dt timestamp;

vs_empl_nm varchar(50);

vd_empl_strt_dt timestamp;

vn_empl_hrs_mnth integer;

vs_prmt_empl_nm varchar(50);

vd_prmt_empl_strt_dt timestamp;

vd_chd_disablty_strt_dt timestamp;

vd_chd_disablty_evltn_docmntn_dt timestamp;

vs_chd_disablty_tp varchar(50);

vd_adp_applcble_dt timestamp;

vd_adp_asst_st_dt timestamp;

vs_efrts_to_place_chld varchar(50);

vd_fnlztn_dt timestamp;

vs_adptn_non_applcble varchar(20);

vd_adptn_pitn_dt timestamp;

vs_child_dprvd_prntl_sprt varchar(20);

vs_chld_has_emtnl_distrbnce varchar(20);

vs_child_physical_add varchar(500);

vn_chld_expctd_adptv_prvdr bigint;

vs_jrsdctn varchar(50);

vs_chd_agcy varchar(50);

vn_child_age_rmvl integer;

vd_removal_id bigint;

v_isSingleParent integer;

v_subsidypaymentstartdate timestamp without time zone;

v_parent_details record;

v_aagrecord record;

v_date_of_latest_payment_of_minor_parent timestamp without time zone;

v_tpr_details json;

v_is_afdc_eligibility_met varchar(20);

v_wasthechildremovedfromspecifiedrelative varchar(20);

v_is_income_assets_met varchar(20);

v_parent_provider_id integer;

v_parent_provider_name varchar(100);

v_effort_date timestamp without time zone;

v_isno_effort varchar(50);

v_is_exception_granted varchar(50);

v_date_of_exception_granted timestamp without time zone;

v_removal_type_key varchar(50);

v_remarks text;
begin
create temp table
 if not exists Temp_adoption_eligibility_worksheet_info ( client_id bigint,
 childjurisdiction varchar(50),
 childagency varchar(50),
 removalage integer,
 servicecaseid UUID,
 casenumber varchar(50),
 childremovaldate timestamp,
 removalid bigint,
 removalcourtorderdate timestamp,
 dateofbirth timestamp,
 gender varchar(20),
 childname varchar(50),
 childraceethnicity varchar(50),
 uscitizen varchar(50),
 qualifiedalien varchar(50),
 nameofsecondaryeducationorequivalentprogram varchar(50),
 startdateofsecondaryeducationorequivalentprogram timestamp,
 nameofpostsecondaryorvocationaleducation varchar(50),
 startdateofpostsecondaryorvocationaleducation timestamp,
 nameofemployer varchar(50),
 startdateofemployment timestamp,
 hourspermonthemployed integer,
 promoteemploymentprogram varchar(50),
 promoteemploymentprogramstartdate timestamp,
 childdisabilitystartdate timestamp,
 childdisabilityevaluationdocumentiondate timestamp,
 childdisabilitytype varchar(50),
 adoptionapplicable timestamp,
 adoptionassistancestartdate timestamp,
 effortstoplacechildweremade varchar(50),
 finalizationdate timestamp,
 adoptionnonapplicable varchar(20),
 adoptionpetitiondate timestamp,
 childdeprivedofparentalsupport varchar(20),
 childhasemotionaldisturbance varchar(20),
 childphysicaladdress varchar(500),
 childexpectedadoptiveproviderid bigint,
 isSingleParent integer,
 subsidypaymentstartdate timestamp without time zone,
 dateoflatestpaymentofminorparent timestamp without time zone,
 tprdetails json null,
 isafdceligibilitymet varchar(20),
 wasthechildremovedfromspecifiedrelative varchar(10),
 isincomeassetsmet varchar(20),
 parent1providerid integer,
 parent1providername varchar(100),
 effortdate timestamp without time zone,
 isnoeffort varchar(50),
 isexceptiongranted varchar(50),
 dateofexceptiongranted timestamp without time zone,
 removaltypekey varchar(50),
 remarks text );
-- Child Jurisdiction  
 select
 peradr.county into
  vs_jrsdctn
 from
  person per,
  personaddress peradr
 where
  per.personid = peradr.personid
  and peradr.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Child Agency
 select
 (case
  when teamtypekey = 'CW' then 'DHS'::varchar
  when teamtypekey = 'DJS' then 'DJS'::varchar
  else null
 end) into
  vs_chd_agcy
 from
  intakeservicerequest isr,
  permanencyplan pp,
  intakeservicerequestactor isra,
  person per
 where
  pp.servicecaseid = isr.servicecaseid
  and pp.activeflag = 1
  and isra.intakeservicerequestactorid = pp.intakeservicerequestactorid
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Child Age At Removal
 select
 extract('years'
from
 isrcr.removaldate)::int - extract('years'
from
 per.dob)::int into
  vn_child_age_rmvl
 from
  intakeservreqchildremoval isrcr,
  intakeservicerequestactor isra,
  person per
 where
  isrcr.intakeservicerequestactorid = isra.intakeservicerequestactorid
  and isrcr.activeflag = 1
  and isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  isrcr.updatedon desc
 limit 1;
-- Service Case ID  
 select
 sc.servicecaseid into
  vn_srv_req_id
 from
  servicecase sc
 inner join intakeservicerequestactor isra on
  isra.servicecaseid = sc.servicecaseid
 inner join person per on
  per.personid = isra.personid
 where
  isra.intakeservicerequestpersontypekey = 'CHILD'
  and per.cjamspid::bigint = al_client_id
  and isra.activeflag = 1
  and per.activeflag = 1
 order by
  sc.updatedon
 limit 1;
-- Case Number  
 select
 sc.servicecasenumber into
  vs_srv_req_no
 from
  servicecase sc,
  placement pl,
  intakeservicerequestactor isra,
  person per
 where
  sc.servicecaseid = pl.servicecaseid
  and sc.activeflag = 1
  and pl.activeflag = 1
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  sc.updatedon
 limit 1;
-- Child Removal Date
 select
 isrcr.removaldate ,
 isrcr.removalid,
 isrcr.removaltypekey into
  vd_child_rmvl_dt ,
  vd_removal_id,
  v_removal_type_key
 from
  intakeservreqchildremoval isrcr,
  person per,
  intakeservicerequestactor isra
 where
  isra.servicecaseid = isrcr.servicecaseid
  and isrcr.activeflag = 1
  and isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  isrcr.updatedon desc
 limit 1;
-- Child Removal Date
--SELECT ( CASE WHEN (rtrim(isrcr.removaltypekey) = 'TLV' 
--    OR rtrim(isrcr.removaltypekey) = 'CDVP' 
--    OR rtrim(isrcr.removaltypekey) = 'EHA' ) 
--    THEN isrcr.removaldate::timestamp ELSE NULL END )
-- INTO vd_child_rmvl_dt
--   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per 
--WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL'
-- AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
-- AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1; 
-- SELECT ( CASE WHEN (isrcr.removaltypekey = 'JD') 
--     THEN (select MAX(isrco.courtorderdate)::timestamp from intakeservreqcourtorder isrco
--     WHERE isrco.servicecaseid =  isrcr.servicecaseid AND isrco.activeflag = 1) ELSE NULL END )  
--  INTO vd_child_rmvl_crt_ord_dt   
--    FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra     
-- WHERE isra.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
--  AND isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid 
--  AND isra.activeflag = 1
--  AND per.personid = isra.personid 
--  AND per.cjamspid::BIGINT = al_client_id 
--  AND per.activeflag = 1 ORDER BY isrcr.updatedon DESC LIMIT 1;
-- Removal Court Order Date
 select
 isrco.courtorderdate into
  vd_child_rmvl_crt_ord_dt
 from
  intakeservreqcourtorder isrco,
  intakeservreqcourtorderdetails iscod,
  intakeservreqchildremoval isrcr,
  person per,
  intakeservicerequestactor isra
 where
  isrco.intakeservreqcourtorderid = iscod.intakeservreqcourtorderid
  and isrco.servicecaseid = isrcr.servicecaseid
  and isrco.activeflag = 1
  and isrco.courtorderdate >= vd_child_rmvl_dt
  and (iscod.checklisttypekey = 'COLANG'
  and iscod.checklistid = '838f07f5-0c94-4f13-b5c0-658c4b9ad5bc'
  and iscod.isselected = 1)
  -- Contrary to Welfare    
  and isra.intakeserviceid = isrcr.intakeserviceid
  and isrcr.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
  and isrcr.removaltypekey = 'JD'
 order by
  isrco.courtorderdate
 limit 1;
-- Date of Birth   
 select
 per.dob into
  vd_birth_dt
 from
  person as per
 where
  per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Gender  
 select
 per.gendertypekey into
  vs_gender
 from
  person as per
 where
  per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Name  
 select
 concat(per.firstname, ' ', per.middlename, ' ', per.lastname) into
  vs_nm
 from
  person as per
 where
  per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Child Race
 select
 rt.typedescription::varchar into
  vs_race
 from
  racetype rt,
  person per
 where
  rt.activeflag = 1
  and trim(rt.racetypekey)= trim(per.racetypekey)
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- US Citizen   
 select
 (case
  when (trim(per.primarycitizenshiptypekey) = 'US'
  or trim(per.primarycitizenshiptypekey) = 'USA') then 'YES'::varchar
  else 'NO'::varchar
 end) into
  vs_us_ctzn
 from
  person as per
 where
  per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Qualified Alien   
 select
 (case
  when (per.alienstatustypekey is not null
  and per.alienregistrationtext is not null
  and trim(per.alienregistrationtext) != '' ) then 'YES'::varchar
  else 'NO'::varchar
 end) into
  vs_qlfd_alien
 from
  person as per
 where
  per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Name Of Secondary Education/Equivalent Program   
 select
 (
 case
  when (rtrim(pedu.educationtypekey) = 'SECY' ) then (
  select
   typedescription
  from
   educationtype
  where
   trim(educationtypekey)= trim(pedu.educationtypekey) )
  else null
 end ) into
  vs_scndry_edu_eqlnt_prgm
 from
  personeducation pedu,
  person per
 where
  per.personid = pedu.personid
  and pedu.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Secondary Education/Equivalent Program Start Date   
 select
 (
 case
  when (rtrim(pedu.educationtypekey) = 'SECY' ) then (
  select
   pedu.startdate )
  else null
 end ) into
  vd_scndry_edu_eqlnt_prgm_strt_dt
 from
  personeducation pedu,
  person per
 where
  per.personid = pedu.personid
  and pedu.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Name Of Post-Secondary/Vocational Education   
 select
 (
 case
  when (rtrim(pedu.educationtypekey) = 'PTSECY' ) then (
  select
   typedescription
  from
   educationtype
  where
   trim(educationtypekey)= trim(pedu.educationtypekey) )
  else null
 end ) into
  vs_post_scndry_vctl_edu
 from
  personeducation pedu,
  person per
 where
  per.personid = pedu.personid
  and pedu.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Post-Secondary/Vocational Education Start Date   
 select
 (
 case
  when (rtrim(pedu.educationtypekey) = 'PTSECY' ) then (
  select
   pedu.startdate )
  else null
 end ) into
  vd_post_scndry_vctl_edu_strt_dt
 from
  personeducation pedu,
  person per
 where
  per.personid = pedu.personid
  and pedu.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Employer Name
 select
 pemp.employername into
  vs_empl_nm
 from
  personemployerdetail pemp,
  person per
 where
  per.personid = pemp.personid
  and pemp.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Employment Start Date
 select
 pemp.startdate into
  vd_empl_strt_dt
 from
  personemployerdetail pemp,
  person per
 where
  per.personid = pemp.personid
  and pemp.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Employed Hours/Month
 select
 pemp.noofhours into
  vn_empl_hrs_mnth
 from
  personemployerdetail pemp,
  person per
 where
  per.personid = pemp.personid
  and pemp.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Promote to Employment Program  
 select
 grd.empprogramname into
  vs_prmt_empl_nm
 from
  guardianship grd,
  intakeservicerequestactor isra,
  person per
 where
  grd.servicecaseid = isra.servicecaseid
  and grd.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 limit 1;
-- Promote to Employment Program Start Date  
 select
 grd.empprogramstartdate into
  vd_prmt_empl_strt_dt
 from
  guardianship grd,
  intakeservicerequestactor isra,
  person per
 where
  grd.servicecaseid = isra.servicecaseid
  and grd.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 limit 1;
-- Child Disability Start Date
 select
 pdis.startdate into
  vd_chd_disablty_strt_dt
 from
  persondisability pdis,
  person per
 where
  per.personid = pdis.personid
  and pdis.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Child Disability Evaluation Documentation Date
 select
 pdis.evaluationdate into
  vd_chd_disablty_evltn_docmntn_dt
 from
  persondisability pdis,
  person per
 where
  per.personid = pdis.personid
  and pdis.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Child Disability Type
 select
 (
 case
  when (pdis.disabilityflag = 1) then 'Permanent'::varchar
  else 'Temporary'::varchar
 end ) into
  vs_chd_disablty_tp
 from
  persondisability pdis,
  person per
 where
  per.personid = pdis.personid
  and pdis.activeflag = 1
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;
-- Parent provider name
 select
 aa.parent1providerid,
 aa.parent1providername into
  v_parent_provider_id,
  v_parent_provider_name
 from
  adoptionagreementrate aar,
  adoptionagreement aa,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  aar.adoptionagreementid = aa.adoptionagreementid
  and ap.adoptionplanningid = aa.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  aar.updatedon asc
 limit 1;

select
 ae.effortdate into
  vd_adp_applcble_dt
 from
  adoptionefforts ae,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  ap.adoptionplanningid = ae.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  ae.updatedon desc
 limit 1;

select
 ae.effectivedate into
  vd_adp_asst_st_dt
 from
  adoptionefforts ae,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  ap.adoptionplanningid = ae.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  ae.updatedon desc
 limit 1;

select
 (case
  when (ae.activeflag = 1) then 'YES'::varchar
  else 'NO'::varchar
 end) ,
 ae.effortdate ,
 (case
  when (ap.isnoeffort = 1) then 'YES'::varchar
  else 'NO'::varchar
 end) ,
 (case
  when (ap.isexceptiongranted = 1) then 'YES'::varchar
  else 'NO'::varchar
 end) ,
 ap.dateofexceptiongranted ,
 ap.remarks into
  vs_efrts_to_place_chld ,
  v_effort_date ,
  v_isno_effort,
  v_is_exception_granted,
  v_date_of_exception_granted,
  v_remarks
 from
  adoptionefforts ae,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  ap.adoptionplanningid = ae.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  ae.updatedon desc
 limit 1;

select
 abtl.finalizationdate into
  vd_fnlztn_dt
 from
  adoptionbreakthelink abtl,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  ap.adoptionplanningid = abtl.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  abtl.updatedon desc
 limit 1;

select
 (case
  when (ae.expirationdate is not null) then 'YES'::varchar
  else 'NO'::varchar
 end) into
  vs_adptn_non_applcble
 from
  adoptionefforts ae,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  ap.adoptionplanningid = ae.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  ae.updatedon desc
 limit 1;

select
 isrp.petitiondate into
  vd_adptn_pitn_dt
 from
  intakeservicerequestpetition isrp,
  intakeservicerequestactor isra,
  person per
 where
  isrp.servicecaseid = isra.servicecaseid
  and isrp.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.activeflag = 1
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  isrp.updatedon desc
 limit 1;
-- Child Deprived Of Parental Support
-- If any one parent is deprived, then set as YES
 vs_child_dprvd_prntl_sprt = 'NO';
-- set default as 'NO'
 select
 (
 case
  when (ipd.childdeprivedofparentalsupport = 'YES') then 'YES'::varchar
 end ) into
  vs_child_dprvd_prntl_sprt
 from
  ivepersondeprivation ipd
 where
  ipd.activeflag = 1
  and ipd.childdeprivedofparentalsupport = 'YES'
 limit 1;

select
 (case
  when (aed.adoptionemotionalid = ae.adoptionemotionalid) then 'YES'::varchar
  else 'NO'::varchar
 end) into
  vs_chld_has_emtnl_distrbnce
 from
  adoptionemotionaldetails aed,
  adoptionemotional ae,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  aed.adoptionemotionalid = ae.adoptionemotionalid
  and ae.adoptionplanningid = ap.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  aed.updatedon desc
 limit 1;

select
 ( cast ( trim(coalesce(pa.address::varchar, ''))|| ' ' || trim(coalesce(pa.county, '')) || ' ' || trim(coalesce(pa.city, '')) || ' ' || trim(coalesce(pa.zipcode::varchar, '')) || ' ' || trim(coalesce(pa.state, '')) || ' ' || trim(coalesce(pa.country::varchar, '')) as character varying )) into
  vs_child_physical_add
 from
  personaddress pa,
  person per
 where
  pa.personid = per.personid
  and personaddresstypekey = 'C'
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1;

select
 aar.provider_id into
  vn_chld_expctd_adptv_prvdr
 from
  adoptionagreementrate aar,
  adoptionagreement aa,
  adoptionplanning ap,
  intakeservreqchildremoval isrcr,
  placement pl,
  intakeservicerequestactor isra,
  person per,
  permanencyplan pp
 where
  aar.adoptionagreementid = aa.adoptionagreementid
  and ap.adoptionplanningid = aa.adoptionplanningid
  and ap.activeflag = 1
  and ap.servicecaseid = pl.servicecaseid
  and pp.permanencyplanid = ap.permanencyplanid
  and pp.activeflag = 1
  and pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid
  and pl.activeflag = 1
  and pl.placementtypekey = 'PRPL'
  and isra.servicecaseid = pl.servicecaseid
  and isra.activeflag = 1
  and isra.intakeservicerequestpersontypekey = 'CHILD'
  and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
  and per.personid = isra.personid
  and per.cjamspid::bigint = al_client_id
  and per.activeflag = 1
 order by
  aar.updatedon desc
 limit 1;

select
 aa.startdate,
 aa.issingleparent,
 isrq.intakeserviceid into
  v_aagrecord
 from
  intakeservreqchildremoval isrq
 inner join permanencyplan pp on
  pp.intakeservicerequestactorid = isrq.intakeservicerequestactorid
  --and pp.primarypermanencytype ='ADOPTNR' 
 inner join adoptionplanning ap on
  ap.permanencyplanid = pp.permanencyplanid
 inner join adoptionagreement aa on
  aa.adoptionplanningid = ap.adoptionplanningid
 inner join intakeservicerequestactor isra on
  isra.servicecaseid = pp.servicecaseid
  and isra.intakeservicerequestpersontypekey = 'CHILD'
 inner join person per on
  per.personid = isra.personid
 where
  per.cjamspid::bigint = al_client_id
 order by
  pp.updatedon desc
 limit 1;

select
 extract(year
from
 age(now(), p.dob)) as parentage,
 p.dob,
 p.cjamspid into
  v_parent_details
 from
  intakeservicerequestactor isrq1
 inner join person p on
  p.personid = isrq1.personid
 where
  isrq1.intakeservicerequestpersontypekey = 'LG'
  and isrq1.intakeserviceid = v_aagrecord.intakeserviceid;
-- TPR Details
 select
 json_agg(to_json(r)) into
  v_tpr_details
 from
  (
   select td.tprdetailsid,
   case
    when td.isgranted = true then 'YES'
    when td.isdenied = false then 'NO'
    else null
   end isgranted,
   td.tprdecisiondate,
   td.reason
  from
   intakeservicerequestactor isra,
   person p,
   tprdetails td
  where
   isra.intakeservicerequestactorid = td.intakeservicerequestactorid
   and p.personid = isra.personid
   and td.activeflag = 1
   and p.activeflag = 1
   and isra.servicecaseid = (
    select isra.servicecaseid
   from
    placement pl,
    intakeservicerequestactor isra,
    person per,
    permanencyplan pp
   where
    isra.servicecaseid = pl.servicecaseid
    and isra.activeflag = 1
    and isra.intakeservicerequestpersontypekey = 'CHILD'
    and isra.intakeservicerequestactorid = pl.intakeservicerequestactorid
    and per.personid = isra.personid
    and per.cjamspid::bigint = al_client_id
    and per.activeflag = 1
   limit 1) ) r;
-- AFDC Details
 select
 case
  when (fca.deprivation = 'CRITERIA_PASSED'
  and fca.assets = 'CRITERIA_PASSED'
  and fca.income = 'CRITERIA_PASSED') then 'YES'
  else 'NO'
 end,
 case
  when (fca.assets = 'CRITERIA_PASSED'
  and fca.income = 'CRITERIA_PASSED') then 'YES'
  else 'NO'
 end,
 fca.wasthechildremovedfromspecifiedrelative into
  v_is_afdc_eligibility_met,
  v_is_income_assets_met,
  v_wasthechildremovedfromspecifiedrelative
 from
  tb_ive_fostercare_audit fca
 where
  fca.sqnm_sw = 'I'
  and fca.approvalstatus = 'APPROVED'
  and fca.cjamspid = al_client_id
 order by
  fca.insertedon desc
 limit 1;

if(v_parent_details.parentage<21) then select
 max(create_ts) into
  v_date_of_latest_payment_of_minor_parent
 from
  tb_payment_detail pd
 where
  client_id like '10000%'
  and pd.final_fiscal_category_cd like '21%';
end if;

