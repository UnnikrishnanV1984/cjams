CREATE OR REPLACE FUNCTION fn_clnt_elig_ins()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- Revision(s)
-- 11/25/2020 Vineet Tirodkar - Modification for CJAMS - E&E Interface
------------------------------------------------------------------------
BEGIN
 
 IF NEW.eligibility_status_cd::VARCHAR IS NOT NULL  THEN
    
  INSERT INTO caresoutboundtrigger
   (  old_id,
    fk_id,
    transactionon,
    transactiontypekey,
    statusflag,
    activeflag
   )
  SELECT
   case_id,
   client_id,
   CURRENT_TIMESTAMP,
   '20',
   'N',
   1
  from tb_client_eligibility cl  
  where cl.eligibility_id = new.eligibility_id;
      
  INSERT INTO eneoutboundtrigger
   (  old_id,
    fk_id,
    transactionon,
    transactiontypekey,
    statusflag,
    activeflag
   )
  SELECT
   case_id,
   client_id,
   CURRENT_TIMESTAMP,
   '20',
   'N',
   1
  from tb_client_eligibility cl  
  where cl.eligibility_id = new.eligibility_id;
      
  INSERT INTO csesoutboundtrigger
   (  old_id,
    fk_id,
    transactionon,
    transactiontypekey,
    statusflag,
    activeflag
   )
  SELECT
   case_id,
   client_id,
   CURRENT_TIMESTAMP,
   '20',
   'N',
   1
  from tb_client_eligibility cl  
  where cl.eligibility_id = new.eligibility_id;

 end if;

RETURN NEW;
END;


$function$

