CREATE OR REPLACE FUNCTION prov_provuirrouting(v_objectid character varying, v_securityuserid character varying, v_appeventcode character varying, v_status integer, commenttext text, v_notifymsg character varying DEFAULT ''::character varying, v_routeddescription character varying DEFAULT ''::character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
declare
v_agency character varying;
v_tosecurityusersid character varying;
v_servicerequestno character varying;
v_site_id character varying;
v_provider_id character varying;
v_uirno character varying;
v_fromroleid character varying;
v_toroleid character varying;  
v_msg character varying;
v_username character varying;
v_date timestamp without time zone;
v_alertstatus character varying;
prov_securityusersid character varying;
worker_securityusersid character varying;
v_provroleid character varying;
v_workerroleid character varying;
v_sitename CHARACTER VARYING;
v_prov_nm CHARACTER VARYING;
currentRow record;
v_tousers json;

BEGIN
v_date = now();


    update provider_uir set uir_status=v_status, uir_statusdesc = v_routeddescription where provider_uir_id = v_objectid::uuid and active_flag=1;

return (json_build_object(
    'Decision','Success'));

END;
$function$

