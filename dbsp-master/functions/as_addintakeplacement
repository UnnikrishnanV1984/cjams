CREATE OR REPLACE FUNCTION as_addintakeplacement(vr_intakenumber character varying, vr_placement json, vr_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
 
 l_status character varying;

BEGIN
 
 insert into placement (providerid, intakenumber,personid,remarks,
 addate,adtime,releasedate,startdatetime, insertedby,updatedby,insertedon,updatedon) 
 values ((vr_placement ->> 'providerid')::UUID, vr_placement ->> 'intakenumber', (vr_placement ->> 'personid')::UUID, vr_placement ->> 'remarks'
 ,date(vr_placement ->> 'addate'),TO_TIMESTAMP(vr_placement ->> 'adtime', 'HH24:MI')::TIME,
 date(vr_placement ->> 'releasedate'), now(), vr_securityusersid, vr_securityusersid, now(), now());
  
 select routingintake into l_status from routingintake (vr_intakenumber, vr_securityusersid, 'DWAN', 55, null);
        
RETURN 'Success';

END;

$function$

