CREATE OR REPLACE FUNCTION getsdmdetails(v_intakeserviceid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

declare l_sdmdetails json;
begin
 
    select json_agg( sdm) into l_sdmdetails from (select *,(SELECT json_agg(e) as sdmmaltreatment from ( select irsmt.sdmmaltreatmentid,irsmt.intakeservicerequestsdmid,irsmt.maltreatmenttype,irsmt.maltreatorsname,irsmt.activeflag from intakeservrequestsdmmaltreatment irsmt group by irsmt.sdmmaltreatmentid,irsmt.intakeservicerequestsdmid,irsmt.maltreatmenttype )e)
from intakeservicerequestsdm where intakeserviceid =v_intakeserviceid) as sdm;
        
return l_sdmdetails; 
       
end;

$function$

