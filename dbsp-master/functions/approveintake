   /*IF (v_peaceorder  = 'PORA' or v_peaceorder = 'FPTSAO') THEN 
    SELECT focuspersonid,raname FROM intakedastaging INTO v_Pid,v_focuspersonname WHERE intakenumber = v_intakeNumber AND activeflag=1 LIMIT 1;
  
 IF (v_suppeaceorderdesc  = 'Request Not Authorized') THEN
 v_alertnotes = 'Peace Order – Request Not Authorized is set for '||v_focuspersonname ||' in Intake '||  v_intakeNumber;
 SELECT savepersonalert INTO v_savepersonalert FROM savepersonalert('PONA'::character varying,'Active'::character varying,now()::timestamp without time zone,v_alertnotes::text,v_Pid::uuid,v_securityuserid::character varying,null::uuid,(now()+ interval '90 day')::date);
 END IF;
 IF (v_suppeaceorderdesc  = 'Request Authorized') THEN
 v_alertnotes = 'Peace Order – Request Authorized is set for '||v_focuspersonname ||' in Intake '||  v_intakeNumber;
 SELECT savepersonalert INTO v_savepersonalert FROM savepersonalert('POAU'::character varying,'Active'::character varying,now()::timestamp without time zone,v_alertnotes::text,v_Pid::uuid,v_securityuserid::character varying);
 END IF;
 END IF; */ -- Gavaskar 28032019
            
  /*Config    taken    based    on    DA    Subtype    and    DAtype    */
 IF (CAST(v_datype AS character varying) <> CAST( coalesce(v_dasubtype1 :: character varying, '')AS character varying) AND CAST( coalesce(v_dasubtype1 ::character varying, '')AS character varying)<>'') THEN 
        v_Servicereqno:=        j->>'ServiceRequestNumber';
        v_issubtypekey:=    j->>'issubtypekey'; 
        IF (v_issubtypekey = true) THEN
        /*SELECT servicerequestsubtypeid into v_dasubtype FROM servicerequestsubtype where lower(classkey) = lower(v_dasubtype1); */
        SELECT getnextdanumber into v_Servicereqno FROM getnextdanumber('servicerequestauthorizationnumber');  
        END IF; 

        /*Assign dattype and configid to local variable based on subtype*/
        SELECT servicerequestsubtypeid,servicerequesttypeconfigid INTO  v_dasubtype,   v_configid    
        FROM  servicerequesttypeconfig    
        WHERE intakeservreqtypeid    =(j->>    'DaTypeKey')::uuid 
        AND    servicerequestsubtypeid    =(CASE WHEN v_Agencycode='CW' THEN v_dasubtype::uuid else (j->> 'DasubtypeKey')::uuid  end)
        AND activeflag    =1    limit    1;    
 ELSE
        SELECT    servicerequestsubtypeid,servicerequesttypeconfigid    into    v_dasubtype,    v_configid    
        FROM  servicerequesttypeconfig 
        WHERE intakeservreqtypeid    =(j->>    'DaTypeKey')::uuid
