    vs_identity_column := 'Provider ID';--
    vs_identity_val := TO_CHAR(vl_payment_to_provider_id);--
   --SIGNAL p_sp_error  ;--
  END IF ; --

  IF vl_checklist_cnt is NULL THEN
    vl_checklist_cnt := 0;--
  END IF;--
  -- 06/02/2008 New Logic for missing info (Provider Checklist) - END
    
  IF vs_withhold_payment = 'Y' OR vl_checklist_cnt = 0 THEN
    vs_payment_status := '1635'; -- Hold
  ELSE
    vs_payment_status := '1634'; -- Approved
  END IF;--

  UPDATE tb_PAYMENT_STATUS
   SET PAYMENT_STATUS_CD = vs_payment_status,
    PAYMENT_STATUS_DT = CURRENT_DATE
  WHERE PAYMENT_ID = vl_pay_header_id
     AND DELETE_SW = 'N';--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode <> 0 THEN
    as_error := 'Error in Updating tb_PAYMENT_STATUS. (SQL-3)'  ;--
    vs_identity_column := 'Payment ID';--
    vs_identity_val := TO_CHAR(vl_pay_header_id);--
   --SIGNAL p_sp_error  ;--
  END IF ;--

  -- getting the sum of all the payment needed
  SELECT SUM(FINAL_AMOUNT_NO)
   INTO vdc_total_draft_amount
  FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = vl_pay_header_id 
   AND DELETE_SW = 'N' ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0 THEN
    as_error := 'Error in getting Total Draft Amount. (SQL-4)'  ;--
    vs_identity_column := 'Payment ID';--
    vs_identity_val := TO_CHAR(vl_pay_header_id);--
   --SIGNAL p_sp_error  ;--
  END IF ;--
  -- updating header table

  -- Commented and taken out of Loop with new procedure SP_RECEIVABLE_OFFSET_PROVIDERS 
   -- check any offset amount for this provider
