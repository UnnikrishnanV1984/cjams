  --  end if;--
  --  CALL  SP_RECEIVABLE_OFFSET_AMOUNT ( vdc_offset_amount,vl_offset_provider_id, vl_pay_header_id, vl_sqlcode);--
  --  IF vl_sqlcode <> 0 THEN
  --      SET vs_Procedure_nm  =  'SP_RECEIVABLE_OFFSET_AMOUNT'; --
  --      SET vs_identity_column = 'Provider ID/ Payment ID';--
  --      SET vs_identity_val = CHAR(vl_offset_provider_id) || '/ ' || CHAR(vl_pay_header_id) ;--
  --      SET as_error = as_error  ;--
  --      IF as_error is NULL OR as_error = '' THEN
  --         SET as_error = 'SP_RECEIVABLE_OFFSET_AMOUNT failed'  ;--
  --      END IF;--
  --      SIGNAL p_sp_error  ;--
  --  END IF ;--
  -- else
  --  set vdc_offset_amount = null;--
  -- end if;--

  UPDATE tb_PAYMENT_HEADER
  SET GROSS_AMOUNT_NO = vdc_total_draft_amount,
   PAYMENT_DT = current_date
  WHERE ( PAYMENT_ID = vl_pay_header_id );--

  -- offset_amount_no = vdc_offset_amount

   al_sqlcode := SQLCODE;--
  IF al_sqlcode <> 0 THEN
    as_error := 'Error in Updating tb_PAYMENT_HEADER. (SQL-5)'  ;--
    vs_identity_column := 'Payment ID';--
    vs_identity_val := TO_CHAR(vl_pay_header_id);--
   --SIGNAL p_sp_error  ;--
  END IF ;--
     
     -- CHECK IF THERE IS ANY PAYMENT HEADER CREATED WITHOUT DETAIL THEN DELETE
  SELECT COUNT(*)
   INTO vl_payment_detail_count
  FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = vl_pay_header_id;--
 
  IF vl_payment_detail_count = 0  THEN
   DELETE FROM tb_PAYMENT_STATUS WHERE PAYMENT_ID = vl_pay_header_id;--
   DELETE FROM tb_PAYMENT_HEADER WHERE PAYMENT_ID = vl_pay_header_id;--
  END IF;--
 END IF;--
