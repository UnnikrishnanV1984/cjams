CREATE OR REPLACE FUNCTION as_fn_caseworker_upd()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN

 if old.toworkeridno <> new.toworkeridno  then  

 INSERT INTO  csesoutboundtrigger (   old_id,
                           transactionon,
                           transactiontypekey,
                           statusflag,
             activeflag)
             
     select  distinct servicecase.servicecasenumber,
                       CURRENT_TIMESTAMP,
                        '45',
                        'N',
          1
        
     from  caseassignment , assessment , servicecase 
     where  --caseassignment.objectid = new.objectid
        caseassignment.objectid = assessment.objectid
       --and caseassignment.objectid = new.objectid
       and assessment.servicecaseid = servicecase.servicecaseid
     order by servicecase.servicecasenumber limit 1 ;
         
  end if;
 
 return new;

END;

$function$

