CREATE OR REPLACE FUNCTION as_addpersonrelation(v_focuspersonid uuid, v_intakenumber character varying, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_rec record;


BEGIN  
   
 FOR  v_rec  IN 
 
  SELECT intakeserviceid FROM intakeservicerequest WHERE activeflag =1 
  AND intakenumber =v_intakenumber
 LOOP
 
  INSERT  INTO  personrelation(
       personrelationid,
       personid,    
       personrelativeid,    
       actorrelationshipkey,
       insertedby,    
       insertedon,    
       updatedby,    
       updatedon)
    SELECT  gen_random_uuid(),
      v_focuspersonid,
      isr.personid,
      fp.relationshiptypekey,
      v_securityuserid,
      now(),
      v_securityuserid,
      now()
    FROM actorrelationship fp
    INNER JOIN intakeservicerequestactor isr ON isr.intakeservicerequestactorid = fp.intakeservicerequestactorid and isr.activeflag=1
    WHERE lower(isr.intakeservicerequestpersontypekey) NOT   IN  ('ra',    'rc',    'youth')
     AND v_focuspersonid :: character varying||','|| isr.personid ::character varying || ','||fp.relationshiptypekey :: character varying
     NOT in (SELECT   pr.personid::character varying||    ','    || pr.personrelativeid :: character varying||  ','  || pr.actorrelationshipkey    
     FROM    personrelation  pr 
     WHERE    activeflag    =    1)
     AND isr.intakeserviceid = v_rec.intakeserviceid
     AND fp.activeflag =1 ;
  
  
 END LOOP;
 
RETURN 'Successfull';
end;

$function$

