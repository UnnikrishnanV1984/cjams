CREATE OR REPLACE FUNCTION send_notification_for_cpsros(from_userid character varying, servicecasenumber character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
v_usernotificationid character varying;
v_date timestamp without time zone;
v_isexternalentity boolean;
v_usernotificationtypekey character varying;
v_notifystatusclw character varying;
v_msg character varying;
v_username character varying;
v_objectid character varying;
begin
v_notifystatusclw := 'not call';
if servicecasenumber is not null then 
 v_date:= now() ;
 select intakeserviceid into v_objectid from intakeservicerequest where servicerequestnumber::character varying=servicecasenumber::character varying;
 select userid::character varying into v_usernotificationid from  f_caseworker(v_objectid,null);
 v_msg = 'CPA ROS request for review ' || servicecasenumber;
 SELECT send_notification   
 INTO   
 v_notifystatusclw    
 FROM   
 send_notification(v_usernotificationid,from_userid,v_usernotificationid,'System',    'High',        v_msg   ,    v_msg  ,    v_objectid,false);
 
end if;
RETURN v_notifystatusclw ;
END;
$function$

