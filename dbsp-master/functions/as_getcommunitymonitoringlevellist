CREATE OR REPLACE FUNCTION as_getcommunitymonitoringlevellist(placementprimappralttypekey character varying, isoutcome boolean)
 RETURNS TABLE(result json)
 LANGUAGE plpgsql
AS $function$

DECLARE

BEGIN

RETURN QUERY

SELECT json_agg(a) as result FROM (select outcomereasonsdesc, outcomereasonskey  from outcomereasonsconfig where 
placementprimaryapprovedalttypekey = placementprimappralttypekey and isoutcomesuccessful = isoutcome
)as a;

 
 END;

$function$

