CREATE OR REPLACE FUNCTION offencehistory(i_evalutionid uuid)
 RETURNS TABLE(youthname character varying, youthid character varying, folderid character varying, dob character varying, race character varying, gender character varying, provider_name character varying, admission_type character varying, admission_classification character varying, status character varying, admission_date character varying, release_date character varying, appeal_date character varying, appeal_status character varying, appeal_comments character varying, oomplaint_id character varying, complaint_date character varying, arrest_date character varying, county character varying, zipcode character varying, decision character varying, complaintsource character varying, complaintsname character varying, complaintaddress character varying, appdate character varying, appnotes character varying, petition_id character varying, petition_date character varying, petition_type character varying, petition_notes character varying, court_date character varying, court_action character varying, dispositions character varying, legal_council character varying, judge character varying, termination_date character varying, conditions character varying, offensename character varying[], offense_date character varying, adjudication_date character varying, adjudication_decision character varying, adjudicated_offence character varying, victim_name character varying, victim_address character varying, victim_phone character varying)
 LANGUAGE plpgsql
AS $function$
   BEGIN    
 RETURN QUERY    
 (         select distinct
             CAST(p.firstname||' '||p.lastname as character varying)  as youthname,
             CAST(p.cjamspid as character varying) as youthid,
             INTSR.intakenumber as folderid,
             cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as DOB,
             (select distinct typedescription from racetype where racetypekey=p.racetypekey) as race,
             (select distinct typedescription from gendertype where gendertypekey=p.gendertypekey) as gender,
              cast(pr.providername as character varying)  as provider_name,
             cast((select distinct description from placementadmissiontype where placementadmissiontypekey=pl.placementadmissiontypekey)as character varying)  as admission_type,
             cast((select distinct description from placementadmissionclassification where placementadmissionclassificationkey=pl.placementadmissionclassificationkey) as character varying) as admission_classification,
             cast(pl.statustypekey as character varying)  as status,
             cast(pl.addate as character varying)  as admission_date,
             cast(pl.releasedate as character varying)  as release_date,
             cast(ia.appealdate as character varying)  as appeal_date,
             cast(ia.appealstatus as character varying)  as appeal_status,
             cast(ia.remarks as character varying)  as appeal_comments,
             cast(inve.complaintid as character varying)  as oomplaint_id,
             cast(inve.complaintreceiveddate as character varying)  as complaint_date,
             cast(inve.arrestdate as character varying)  as arrest_date,
             cast((select distinct countyname from county where countyid=inve.countyid) as character varying)  as county,
             cast(inve.zipcode as character varying)  as zipcode,
             cast((select distinct description from dispositioncode where dispositioncode =srtcdc.dispositioncode) as character varying) as decision,
             cast((select distinct description from evaluationsourceagency where evaluationsourcetypekey=es.evaluationsourcekey) as character varying)  as complaintsource,
             cast(es.lastname ||' '|| es.firstname as character varying) as complaintsname,
             cast(es.streetno ||' '||es.street1||' '||es.street2 as character varying) as complaintaddress,
             CAST(to_char(sap.appointmentdate,'MM/DD/YYYY') as character varying) as appdate,
             CAST(sap.notes as character varying) as appnotes,
             cast(pe.petitionid as character varying) as petition_id,
             cast(pe.petitiondate as character varying) as petition_date,
             cast((select distinct description from petitiontype where petitiontypekey=pe.petitiontypekey) as character varying) as petition_type,
              cast(pe.hearingnotes as character varying) as petition_notes,
              cast(ca.hearingdatetime as character varying) as court_date,
     cast((select distinct description from courtactiontype where courtactiontypekey=ca.courtactiontypekey) as character varying) as court_action ,
              cast((select distinct description from courtordertype where courtordertypekey=ca.courtordertypekey) as character varying) as dispositions ,
              cast(ca.legalcounselname as character varying) as legal_council,
              cast(ca.magistratename as character varying) as judge,
              cast(ca.terminationdatetime as character varying) as termination_date,
              cast((select distinct description from conditiontype where conditiontypekey=ca.conditiontypekey) as character varying) as conditions,
             (select array_agg(AG.name)  from  allegation AG
      join intakeservicerequestevaluationconfig ITSEC  on ITSEC.allegationid=AG.allegationid and AG.activeflag=1
      where  ITSEC.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid and ITSEC.activeflag=1 )as offensename,
             cast(case 
          when inve.unknownrange=0 then to_char(inve.offensedate,'MM/DD/YYYY') 
           when inve.unknownrange=1 then to_char(inve.offensedate,'MM/DD/YYYY')
            when inve.unknownrange=2 then to_char(inve.begindate,'MM/DD/YYYY')|| ' - ' || to_char(inve.enddate,'MM/DD/YYYY')
             end as character varying) as offense_date,
             cast(ca.adjudicationdatetime as character varying) as adjudication_date,
             cast(ca.adjudicationdecision as character varying) as adjudication_decision,
    cast(case when ca.adjudicationdecision='Sustained' then AG.name
    else NULL end  as character varying) as adjudicated_offence,
    CAST(victim_details.victimname as character varying) as victim_name,
             CAST(victim_details.victimaddress as character varying) as victim_address,
             CAST(victim_details.victimphonenumber as character varying) victim_phone
             from intakeservicerequestevaluation inve
             join intakeservicerequest INTSR on INTSR.intakenumber=inve.intakenumber and INTSR.activeflag=1
             join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1
             join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype='Youth'
             join person p on ACC.personid=p.personid and p.activeflag=1
             left join evaluationsource es on es.evaluationsourceid=inve.evaluationsourceid and es.activeflag=1
             left join  intakeservicerequestdispositioncode isrdc ON INTSR.intakeserviceid = isrdc.intakeserviceid AND isrdc.activeflag = 1
             left join  servicerequesttypeconfigdispositioncode srtcdc ON isrdc.servicerequesttypeconfigiddispostionid = srtcdc.servicerequesttypeconfigiddispostionid AND srtcdc.activeflag = 1 
             left join servicerequestappointment sap on sap.intakeserviceid=INTSR.intakeserviceid and sap.activeflag=1
    join intakeservicerequestevaluationconfig ITSEC on ITSEC.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid and ITSEC.activeflag=1
             join allegation AG on ITSEC.allegationid=AG.allegationid and AG.activeflag=1
             left join placement pl on INTSR.intakeserviceid =pl.intakeserviceid and pl.activeflag=1
             left JOIN provider pr ON pl.providerid = pr.providerid AND pr.activeflag=1
    left join intakeappeal ia on INTSR.intakenumber=ia.intakenumber and ia.activeflag=1
    left join intakeservicerequestpetition pe on INTSR.intakeserviceid =pe.intakeservicerequestid and pe.activeflag=1
    left join intakeservicerequestcourtaction ca on INTSR.intakeserviceid=ca.intakeservicerequestid and ca.activeflag=1
             left join
            (select INTSR.intakenumber as intakenumber,p.lastname ||' '|| p.firstname as victimname,pa.address victimaddress,pp.phonenumber victimphonenumber from 
              intakeservicerequest INTSR 
              left join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1 and INSRA.intakeservicerequestpersontypekey='Victim'
              left join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype='Victim'
              left join person p on ACC.personid=p.personid and p.activeflag=1
              left join personaddress pa on p.personid=pa.personid and pa.activeflag=1
            left join personphonenumber pp on p.personid=pp.personid and pp.activeflag=1) victim_details
              on INTSR.intakenumber=victim_details.intakenumber
              where  inve.intakeservicerequestevaluationid = i_evalutionid  limit 1) ;   
   end;
  $function$

