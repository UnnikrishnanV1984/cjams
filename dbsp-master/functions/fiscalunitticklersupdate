CREATE OR REPLACE FUNCTION fiscalunitticklersupdate(v_searchobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
v_tickler_id bigint;

BEGIN

v_tickler_id := v_searchobj ->> 'tickler_id';

IF (COALESCE(v_searchobj ->> 'action_sw', '') = 'Y' ) THEN
UPDATE tb_ticklers
 SET
  action_sw = v_searchobj ->> 'action_sw',
  action_dt = now(),
  data_valid_sw = v_searchobj ->> 'data_valid_sw',
  update_ts = now(),
        delete_sw = v_searchobj ->> 'delete_sw'
 WHERE tickler_id = v_tickler_id;

ELSE 
 UPDATE tb_ticklers
 SET
  action_sw = v_searchobj ->> 'action_sw',
  action_dt = (v_searchobj ->> 'action_dt') ::DATE,
  data_valid_sw = v_searchobj ->> 'data_valid_sw',
  update_ts = now(),
        delete_sw = v_searchobj ->> 'delete_sw'
 WHERE tickler_id = v_tickler_id;
end if;

RETURN 'success';

END;

$function$

