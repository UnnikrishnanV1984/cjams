CREATE OR REPLACE FUNCTION as_addupdateaddress(personaddressjson json, v_securityusersid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                           

 DECLARE                                                                                                                                                                                                                                                                 
  v_date timestamp without time zone;                                        
                                                                                                                                                                                                                                                                         
 BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
  v_date:= now() ;                                                                                                                                                                                                                                                        
  IF (personaddressjson ->> 'personaddressid' IS NOT NULL) THEN
   
   UPDATE personaddress
    SET address     = personaddressjson ->> 'address', 
     address2    = personaddressjson ->> 'address2',
     zipcode     = personaddressjson ->> 'zipcode', 
     city     = personaddressjson ->> 'city', 
     state     = personaddressjson ->> 'state', 
     county     = (personaddressjson ->> 'county')::uuid, 
     personaddresstypekey  = personaddressjson ->> 'personaddresstypekey', 
     personadrstartdate  = (personaddressjson ->> 'startdate')::timestamp without time zone, 
     personadrenddate  = (personaddressjson ->> 'personadrenddate')::timestamp without time zone, 
     ishouseholdmember  = (personaddressjson ->> 'ishouseholdmember')::boolean,  
     durationday    = personaddressjson ->> 'durationDay',
     danger     = (personaddressjson ->> 'danger')::boolean, 
     dangerreason   = personaddressjson ->> 'dangerreason',
     updatedby    = v_securityusersid, 
     updatedon    = v_date 
    WHERE personaddressid = (personaddressjson ->> 'personaddressid')::uuid;
   
  ELSE
  
   INSERT INTO personaddress( personaddressid, 
            personid, 
            activeflag, 
            address,    
            address2,   
            zipcode,   
            city,    
            state,    
            county,    
            personaddresstypekey,
            personadrstartdate, 
            personadrenddate, 
            ishouseholdmember, 
            durationday,   
            danger,    
            dangerreason,  
            insertedby,   
            insertedon)   
         VALUES ( gen_random_uuid(),
            (personaddressjson ->> 'personid')::uuid, 
            1,
            personaddressjson ->> 'address', 
            personaddressjson ->> 'address2',
            personaddressjson ->> 'zipcode', 
            personaddressjson ->> 'city', 
            personaddressjson ->> 'state', 
            (personaddressjson ->> 'county')::uuid, 
            personaddressjson ->> 'personaddresstypekey', 
            (personaddressjson ->> 'startdate')::timestamp without time zone, 
            (personaddressjson ->> 'personadrenddate')::timestamp without time zone, 
            (personaddressjson ->> 'ishouseholdmember')::boolean, 
            personaddressjson ->> 'durationDay',
            (personaddressjson ->> 'danger')::boolean, 
            personaddressjson ->> 'dangerreason',
            v_securityusersid, 
            v_date);
 
  END IF; 
                                                                                                                                                                                                                                                           
  RETURN 'Success';                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                         
 END;                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                         
 $function$

