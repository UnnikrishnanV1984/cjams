CREATE OR REPLACE FUNCTION getpublicproviderinquiries(v_referralstatus character varying, v_jurisdiction character varying, v_referralid character varying, v_applicant_nm character varying)
 RETURNS TABLE(referral_id character varying, referral_status character varying, referral_decision character varying, individual_applicant_first_nm character varying, individual_applicant_middle_nm character varying, individual_applicant_last_nm character varying, co_applicant_first_nm character varying, co_applicant_middle_nm character varying, co_applicant_last_nm character varying, prgram character varying, provider_program_type character varying, jurisdiction character varying, insertedby character varying, decisiondate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                      
                                                                                                                                                                                                                    
BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                    
RETURN QUERY                                                                                                                                                                                                       
                                                                                                                                                                                                                    
select tppr.referral_id, tppr.referral_status, tppr.referral_decision, tppr.individual_applicant_first_nm, tppr.individual_applicant_middle_nm, tppr.individual_applicant_last_nm, tppr.co_applicant_first_nm, 
tppr.co_applicant_middle_nm, tppr.co_applicant_last_nm, tppr.prgram, tppr.provider_program_type, tppr.jurisdiction, tppr.create_user_id ,
case when v_referralstatus = 'rejected' then tppr.update_ts::timestamp else (select ptr.decisiondate FROM tb_provider_decision ptr where ptr.eventcode='INQ' and ptr.objectid=tppr.referral_id order by ptr.insertedon desc limit 1) end
from tb_public_provider_referral tppr where tppr.referral_status = v_referralstatus and tppr.delete_sw != 'Y' and tppr.jurisdiction = v_jurisdiction
and case when tppr.referral_id != '' then tppr.referral_id like '%' || v_referralid || '%' else true end  
and case when v_applicant_nm != '' then tppr.individual_applicant_first_nm ilike '%' || v_applicant_nm || '%' or tppr.individual_applicant_last_nm ilike '%' || v_applicant_nm || '%' else true end 
order by tppr.referral_id desc;                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                    
END;
$function$

