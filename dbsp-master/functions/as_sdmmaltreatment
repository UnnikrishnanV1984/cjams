CREATE OR REPLACE FUNCTION as_sdmmaltreatment(sdmid uuid, securityuserid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
                                                    
DECLARE 
v_sdmmaltreatment json;
v_date timestamp without time zone;
 
BEGIN      
 v_date:= now() ;
 
 

INSERT INTO intakeservrequestSDMMaltreatment( intakeservicerequestsdmid,
                                               maltreatmenttype,
                                               maltreatorsname,
                                               activeflag,
                                               updatedby,
                                               updatedon,
                                                effectivedate,
            insertedby,
            insertedon)
SELECT sdmid, 'AP',maltreatorsname,1,securityuserid, v_date,v_date,securityuserid, v_date 
       FROM json_to_recordset(v_sdmmaltreatment ) as x(  
           "intakeservicerequestsdmid" uuid,
           "maltreatorsname" character varying
                      );  
 

RETURN
  'Success';
END;

$function$

