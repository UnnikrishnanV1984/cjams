CREATE OR REPLACE FUNCTION as_fn_assmnt_ins()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$ 

BEGIN
IF  NEW.ACTIVITY_SW = 'T' THEN

         IF NEW.ENTITY_TYPE_CD IN ('2952','5590') THEN

             IF  NEW.RESPONSIBILITY_CD = 'P' THEN

  IF COALESCE(NEW.FROM_COUNTY_CD,'00000') <> COALESCE(NEW.TO_COUNTY_CD,'00000') THEN
 
   INSERT INTO caresoutboundtrigger
   ( old_id,
     transactionon,
  transactiontypekey,
  statusflag,
  activeflag)
   VALUES
   (NEW.ENTITY_KEY_ID,
   CURRENT_TIMESTAMP,
   '64',
   'N',
   1);--
 
  END IF;--
       
             END IF;  --
    
         END IF;--

END IF;--


 IF NEW.ENTITY_TYPE_CD IN ('2952','5590') THEN

             IF  NEW.RESPONSIBILITY_CD = 'P' THEN

   
   INSERT INTO csesoutboundtrigger
   ( old_id,
     transactionon,
     transactiontypekey,
     statusflag,
   activeflag)
   VALUES
   (NEW.ENTITY_KEY_ID,
   CURRENT_TIMESTAMP,
   '45',
   'N',
   1);--
 
       
             END IF;  --
    
END IF;--


return new;
END;

$function$

