CREATE OR REPLACE FUNCTION as_listpersonhealth(v_personid uuid, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(personid uuid, "personBehaviour" json, "personAbuse" json, "personProviderHistory" json)
 LANGUAGE plpgsql
AS $function$


DECLARE
 v_pageoffset int;
        v_pagenumber int;

 
BEGIN

 v_pagenumber := pagenumber-1;
        v_pageoffset = v_pagenumber * pagesize;
 

RETURN QUERY
            -- count(1) over(),
  select p.personid,
(SELECT json_agg(pbh) FROM (select pbh.personbehavioralhealthid, pbh.isbehavioralhealth as "isbehaviouraldiagnosis", pbh.clinicianname as "clinicianname", pbh.address1 as "addressline1", pbh.address2 as "addressline2", pbh.city, pbh.state, pbh.zip as "zipcode", pbh.phone as "phonenumber", pbh.currentdiagnoses as "currentdiagnosis", pbh.reportname from personbehavioralhealth pbh where pbh.personid = p.personid and pbh.activeflag = 1) pbh )::json as "personBehaviour",
--(SELECT json_agg(bhi) FROM (select bhi.birthhealthinfoid,bhi.mothersusepregnant,bhi.mothersusepregnantspecify,bhi.mentalcondition,bhi.mentalconditionspecify,bhi.diseasescondition,bhi.diseasesconditionspecify,bhi.birthdefects,bhi.comments from birthhealthinfo bhi where bhi.personid=p.personid and bhi.activeflag=1) bhi )::json as "personBirth",
--(SELECT json_agg(cci) FROM (select (CASE WHEN chronicinfoflag = 1 then true ELSE false END) as "noknownchronic" , (CASE WHEN chronichighriskflag = 1 then true ELSE false END) as "highriskmentaldisease", physicalproblem as "physicalkey", physicalproblemtx as "physicalcomments", mentalproblem as "mentalkey", mentalproblemtx as "mentalcomments", chroniccommentstx as "comments" from clientchronicinfo cci where cci.personid=p.personid and cci.activeflag=1) cci )::json as "personChronic",
--(SELECT json_agg(pd) FROM (select * from persondisability pd where pd.personid=p.personid and pd.activeflag=1) pd )::json as "personDisability",
---(SELECT json_agg(pe) FROM (select pe.providerinfoflag,(SELECT json_agg(json_build_object('apptDate',ep.appoinmentdate,
--'nextApptDate',ep.nextappointmentdate, 
--'natureofexamkey',ep.examinationtypekey, 
--'labtestkey',ep.labtesttypekey, 
--'specialityexamkey',ep.specialityexamtypekey,
--'nextappointmentreason',ep.nextappointmentreason,
--'hivtestreceived',ep.hivconsentflag,
--'notkeptreason',ep.notkeptreason,
--'apptkept',ep.appointkeptflag
--))  as appointment from personexamination ep),json_build_object('speciality',pe.physicianspeciality,'affilication',pe.affiliateorg,'physicianname',pe.physicianname,'recommendations',pe.recommendations,'comments',pe.comments,'address1',pe.address1,'address2',pe.address2,'city',pe.cityname,'state',pe.statetypekey,'county',pe.countytypekey,'zip',pe.zip5no,'phone',pe.workphone,'email',pe.email) as physician from personexamination pe where pe.personid=p.personid and pe.activeflag=1
--) pe )::json as "personExamination",
