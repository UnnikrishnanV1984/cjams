--(SELECT json_agg(ph) FROM (select ph.hospitalizationid,ph.hospitalization_type,ph.hospitalization_reason,ph.startdt,ph.enddt,ph.diagnosistx,ph.hospitalnm,ph.hospital_address1,ph.hospital_address2,ph.hospital_phone,ph.Hospital_city,ph.Hospital_state,ph.Hospital_zipcode,ph.updatedby,ph.updatedon from personhospitalization ph where ph.personid=p.personid and ph.activeflag=1) ph )::json as "personHospitalization",
--(SELECT json_agg(pim) FROM (select * from personimmunization pim where pim.personid=p.personid and pim.activeflag=1) pim )::json as "personImmunization",
--(SELECT json_agg(phi) FROM (select phi.personhealthinsuranceid,phi.insurancetype,phi.policyholdername,phi.medicalinsuranceprovider,phi.patientpolicyholderrelation,phi.providertype,phi.providerphone,phi.policynumber,phi.groupnumber,phi.effectivedate,phi.expirationdate,phi.address1,phi.address2,phi.city,phi.state,phi.countyid,phi.zip,phi.ismedicaidmedicare from personhealthinsurance phi where phi.personid=p.personid and phi.activeflag=1) phi )::json as "personInsurance",
(SELECT json_agg(pas) FROM (select * from personabusesubstance pas where pas.personid=p.personid and pas.activeflag=1) pas )::json as "personAbuse",
--(SELECT json_agg(pmp) FROM (select * from personmedicalinfo pmp where pmp.personid=p.personid and pmp.activeflag=1) pmp )::json as "personmedicalPsychotropic",
