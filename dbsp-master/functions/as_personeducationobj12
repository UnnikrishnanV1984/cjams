CREATE OR REPLACE FUNCTION as_personeducationobj12(personjson json, personid uuid, securityuserid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

persondata json;
p_Personid uuid;
v_securityuserid uuid;
s_SchoolObj json;
t_TestingObj json;
v_VocationObj json;
a_AccomplishmentObj json;
l_Status character varying;
i json; 

v_date timestamp without time zone;


BEGIN

persondata := personjson;
p_Personid := personid;
v_date:= now() ;
v_securityuserid := securityuserid;


    CREATE TEMP TABLE temp_sp_create_personeducation  ( 
    personeducationid character varying,
      personid character varying,
      educationname character varying,
      educationtypekey character varying,
      countyid uuid,
      statecode character varying,
      startdate date,
      enddate date,
      lastgradetypekey character varying,
      currentgradetypekey character varying,
      isspecialeducation bool,
      specialeducationtypekey character varying,
      absentdate date,
      isreceived bool,
      isverified bool,
      isexcuesed bool,
      effectivedate date,
      expirationdate date,
      isNew int default 0);   
    
 CREATE TEMP TABLE temp_sp_create_PersonEducationTesting  ( 
    personeducationtestingid character varying,
      personid character varying,
      testingtypekey character varying,
      readinglevel int,
      readingtestdate date,
      mathlevel int,
      mathtestdate date,
      testingprovider character varying,
      effectivedate date,
      expirationdate date,
      isNew int default 0);   
     
 CREATE TEMP TABLE temp_sp_create_Temp_PersonEducationVocation(
    personeducationvocationid character varying,
      personid character varying,
      vocationinterest character varying,
      vocationaptitude character varying,
      isvocationaltest bool,
      certificatename character varying,
      certificatepath character varying,
     -- effectivedate date,
      --expirationdate date,
      isNew int default 0
      );

      
 CREATE TEMP TABLE temp_sp_create_PersonAccomplishment(
    personaccomplishmentid character varying,
      personid character varying,
      highestgradetypekey character varying,
      accomplishmentdate date,
      isrecordreceived bool,
      receiveddate date,
      effectivedate date,
      expirationdate date,
      isNew int default 0
      );

      
FOR i IN SELECT * FROM json_array_elements(personjson)
LOOP
   
   s_SchoolObj:= i->>'schoool';
   
           insert into temp_sp_create_personeducation
   select   * from json_to_recordset(s_SchoolObj ) as x("personeducationid" character varying,
      "personid" character varying,
      "educationname" character varying,
      "educationtypekey" character varying,
      "countyid" uuid,
      "statecode" character varying,
      "startdate" date,
      "enddate" date,
      "lastgradetypekey" character varying,
      "currentgradetypekey" character varying,
      "isspecialeducation" bool,
      "specialeducationtypekey" character varying,
      "absentdate" date,
      "isreceived" bool,
      "isverified" bool,
      "isexcuesed" bool,
      "effectivedate" date,
      "expirationdate" date);
   
   t_TestingObj:= i->>'testing';
   
    insert into temp_sp_create_PersonEducationTesting
   select   * from json_to_recordset(t_TestingObj ) as x("personeducationtestingid" character varying,
      "personid" character varying,
      "testingtypekey" character varying,
      "readinglevel" int,
      "readingtestdate" date,
      "mathlevel" int,
      "mathtestdate" date,
      "testingprovider" character varying,
      "effectivedate" date,
      "expirationdate" date);
     
   v_VocationObj := i ->>'vocation';

   -- insert into temp_sp_create_Temp_PersonEducationVocation
--    select   * from json_to_recordset(t_TestingObj ) as x("personeducationvocationid" uuid,
--       "personid" uuid,
--       "vocationinterest" character varying,
--       "vocationaptitude" character varying,
--       "isvocationaltest" bool,
--       "lastgradetypekey" character varying,
--       "certificatename" character varying,
--       "certificatepath" character varying);
      
      a_AccomplishmentObj := i ->>'accomplishment';

   insert into temp_sp_create_PersonAccomplishment
   select   * from json_to_recordset(t_TestingObj ) as x("personaccomplishmentid" character varying,
      "personid" character varying,
      "highestgradetypekey" character varying,
      "accomplishmentdate" date,
      "isrecordreceived" bool,
      "receiveddate" date,
      "effectivedate" date,
      "expirationdate" date);

      
  update temp_sp_create_personeducation set  isNew =1 where coalesce(personeducationid,'') ='';
        update temp_sp_create_PersonEducationTesting set  isNew =1 where coalesce(personeducationtestingid,'') ='';
      --  update temp_sp_create_Temp_PersonEducationVocation set  isNew =1 where coalesce(personeducationvocationid,'') ='';
  update temp_sp_create_PersonAccomplishment set  isNew =1 where coalesce(personaccomplishmentid,'') ='';
 
 
   UPDATE personeducation SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE personeducationid  in (select personeducationid::uuid from temp_sp_create_personeducation where isnew=0);
 
 
   UPDATE personeducationtesting SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE personeducationtestingid  in (select personeducationtestingid::uuid from temp_sp_create_PersonEducationTesting where isnew=0);
       
       
    --    UPDATE personeducationvocation SET activeflag=0,
--          updatedby = v_securityuserid,
--          updatedon = v_date
--        WHERE personeducationvocationid  in (select personeducationvocationid::uuid from temp_sp_create_Temp_PersonEducationVocation where isnew=0);
--        
       
       UPDATE personaccomplishment SET activeflag=0,
         updatedby = v_securityuserid,
         updatedon = v_date
       WHERE personaccomplishmentid  in (select personaccomplishmentid::uuid from temp_sp_create_PersonAccomplishment where isnew=0);

   RAISE NOTICE ' before %',p_Personid;      
       
   INSERT INTO personeducation( personid, educationname, educationtypekey, 
    countyid, statecode, startdate, enddate, lastgradetypekey, currentgradetypekey, 
    isspecialeducation, specialeducationtypekey, absentdate, isreceived, 
    isverified, isexcuesed, activeflag, effectivedate, expirationdate, 
    insertedby, updatedby, insertedon, updatedon)
   SELECT p_Personid,educationname, educationtypekey, 
    countyid,statecode, startdate,enddate, lastgradetypekey,currentgradetypekey, 
    isspecialeducation,specialeducationtypekey, absentdate, isreceived, 
    isverified, isexcuesed,1, effectivedate, expirationdate, 
    v_securityuserid,v_securityuserid, v_date, v_date 
    FROM   temp_sp_create_personeducation WHERE isnew=1;
   
   RAISE NOTICE ' after %',p_Personid;      
   
   INSERT INTO personeducationtesting( personid, testingtypekey, readinglevel, 
    readingtestdate, mathlevel, mathtestdate, testingprovider, activeflag, 
    effectivedate, expirationdate, insertedby, updatedby, insertedon, 
    updatedon)
   SELECT p_Personid, testingtypekey, readinglevel, readingtestdate, 
    mathlevel, mathtestdate, testingprovider, 1, effectivedate, 
    expirationdate, v_securityuserid,v_securityuserid, v_date, v_date 
   FROM   temp_sp_create_PersonEducationTesting WHERE isnew=1;

  
  -- 
--    INSERT INTO personeducationvocation(personid, vocationinterest, vocationaptitude, 
--             isvocationaltest, certificatename, certificatepath, activeflag, 
--             effectivedate, expirationdate, insertedby, updatedby, insertedon, 
--             updatedon)
--    SELECT s_Personid, vocationinterest,vocationaptitude, isvocationaltest, 
--             certificatename, certificatepath, 1, effectivedate::date, 
--             expirationdate::date, v_securityuserid,v_securityuserid, v_date, v_date 
--    FROM temp_sp_create_Temp_PersonEducationVocation WHERE isnew=1;

   
   INSERT INTO personaccomplishment(personid, highestgradetypekey, accomplishmentdate, 
            isrecordreceived, receiveddate, activeflag, effectivedate, expirationdate, 
            insertedby, updatedby, insertedon, updatedon)
   SELECT p_Personid, highestgradetypekey, accomplishmentdate, isrecordreceived, 
            receiveddate,1, effectivedate, expirationdate, 
            v_securityuserid,v_securityuserid, v_date, v_date 
   FROM temp_sp_create_PersonAccomplishment WHERE isnew=1;
   
   

END LOOP;

l_Status := 'SUCCESS';

return l_Status;


DROP TABLE temp_sp_create_personeducation;
DROP TABLE temp_sp_create_PersonEducationTesting;
DROP TABLE temp_sp_create_Temp_PersonEducationVocation;
DROP TABLE temp_sp_create_PersonAccomplishment;

END

$function$

