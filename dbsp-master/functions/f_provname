CREATE OR REPLACE FUNCTION f_provname(ai_prov_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
retval character varying;
f_retval character varying;

BEGIN

  retval = (select provider_nm from tb_provider where provider_id = ai_prov_id);
  if retval = '' then
  f_retval = 
      (SELECT 
   COALESCE( TB_PROVIDER.PROVIDER_FIRST_NM || ' ','') || ' '||
   COALESCE( TB_PROVIDER.PROVIDER_MIDDLE_NM || ' ', '') || ' '||
   COALESCE( TB_PROVIDER.PROVIDER_LAST_NM || ' ','') || ' '||
   COALESCE(( SELECT TB_PICKLIST_VALUES.VALUE_TX  
            FROM  TB_PICKLIST_VALUES  
      WHERE TB_PICKLIST_VALUES.PICKLIST_TYPE_ID = 214  AND  
      TB_PICKLIST_VALUES.PICKLIST_VALUE_CD =  TB_PROVIDER.PROVIDER_SUFFIX_CD), '' ) AS PROVIDER_NM
     FROM TB_PROVIDER WHERE PROVIDER_ID = ai_prov_id);
      
  else

   f_retval =  
      (SELECT 
   COALESCE( TB_PROVIDER.PROVIDER_NM,
   COALESCE( TB_PROVIDER.PROVIDER_FIRST_NM,'') || ' '||
   COALESCE( TB_PROVIDER.PROVIDER_MIDDLE_NM,'') || ' '||
   COALESCE( TB_PROVIDER.PROVIDER_LAST_NM,'') || ' '||
   COALESCE(( SELECT TB_PICKLIST_VALUES.VALUE_TX  
        FROM TB_PICKLIST_VALUES  
        WHERE TB_PICKLIST_VALUES.PICKLIST_TYPE_ID = 214  AND  
       TB_PICKLIST_VALUES.PICKLIST_VALUE_CD =  TB_PROVIDER.PROVIDER_SUFFIX_CD), '' ))
      FROM TB_PROVIDER WHERE PROVIDER_ID = ai_prov_id);
   end if;
 
return f_retval;

END

$function$

