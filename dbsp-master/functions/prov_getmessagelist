CREATE OR REPLACE FUNCTION prov_getmessagelist(reqobj json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
  DECLARE 
  jsondata json;
        v_object_id character varying;
        v_object_type character varying;
  
  BEGIN
   v_object_id  = reqobj->> 'object_id';
            v_object_type  = reqobj->> 'object_type';
            
  SELECT JSON_AGG(pla) INTO jsondata FROM (
            select * from prov.provider_communication pc 
            where  pc.object_id = v_object_id and pc.object_type = v_object_type 
            order by pc.create_ts desc
  ) AS pla;
  RETURN jsondata;
  END;
$function$

