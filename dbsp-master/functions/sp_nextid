CREATE OR REPLACE FUNCTION sp_nextid(as_seq_name character varying, OUT al_next_value bigint)
 RETURNS bigint
 LANGUAGE plpgsql
AS $function$


   DECLARE
    vs_sql_text Varchar(1000) DEFAULT '';--
    BEGIN

    EXECUTE format('SELECT NEXTVAL(''%I'')',as_seq_name) into al_next_value;
  
   
END;
$function$

