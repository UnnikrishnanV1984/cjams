CREATE OR REPLACE FUNCTION as_f_psname(ai_prov_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN
RETURN

        ( SELECT CASE WHEN length(rtrim(ltrim(provider_nm))) > 0  THEN provider_nm 
          ELSE provider_last_nm||', '||provider_first_nm              
       END
 FROM tb_provider
 WHERE provider_id = ai_prov_id )
;
 
END

$function$

