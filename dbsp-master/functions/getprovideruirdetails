CREATE OR REPLACE FUNCTION getprovideruirdetails(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT PU.provider_uir_id, PU.uir_no, PU.provider_id, PU.licence_type, PU.level_supervision, PU.location_incident,
PU.location_area, PU.location_area_other, PU.incident_datetime, PU.discovered_datetime,
 PU.narrative_before_incident, PU.narrative_incident_occur, PU.narrative_during_incident, PU.narrative_after_incident,
 PU.role_incident, PU.restraint_typekey, PU.duration_restraint, PU.duration_restraint_other,
 PU.is_de_escalation, PU.is_seen_medical, PU.is_injury_sustained,
 PU.injury_severity_rating, PU.is_injury_result, PU.is_seclusion, PU.duration_seclusion, PU.is_staff_assaulted,
 uir_status, notifiy_is_attach, notifiy_attach_other, notification_comments, 
 PU.notifiy_staff_member, PU.notifiy_signdatetime,PU.precipitate_event,PU.gang_related_explain,PU.gang_incident_videotapped,
 PU.gang_support_evidence,PB.formatted_provider_nm,rv.description as precipitate_event_name

FROM provider_uir PU 
left join tb_provider PB on PB.provider_id=Pu.provider_id

left join referencevalues rv on rv.ref_key=PU.precipitate_event


where PU.provider_uir_id=v_provider_uir_id 


   )  a;

RETURN  jsondata;
END;

$function$

