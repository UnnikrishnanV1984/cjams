CREATE OR REPLACE FUNCTION as_sendplacementnotification(v_providerid character varying, v_fromsecurityuserid character varying, v_programtypeold character varying, v_programtypenew character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

declare

v_returnstatus character varying;
v_insertedby uuid;
v_placementrecord record;
v_msg character varying;



BEGIN

if v_providerid is not null then


for v_placementrecord in 
select pl.insertedby,p.cjamspid,sc.servicecasenumber from placement pl 
inner join person p on p.personid=pl.personid
inner join servicecase sc on sc.servicecaseid = pl.servicecaseid
where altproviderid=v_providerid::integer and pl.activeflag=1 and pl.enddatetime is null
loop 
v_msg := 'Home Approval Type for the provider '||v_providerid||' with the child '|| v_placementrecord.cjamspid ||' has been changed from '||v_programtypeold||' to '||v_programtypenew||' for the servicecase '||v_placementrecord.servicecasenumber;

SELECT send_notIFication INTO v_returnstatus FROM send_notIFication(v_placementrecord.insertedby
                                                                        ,v_fromsecurityuserid, v_placementrecord.insertedby,
      'System', 'High', v_msg,
       v_msg , v_providerid);
end loop;

v_returnstatus := 'Success';
else 
v_returnstatus := 'Failure';
end if;

RETURN v_returnstatus;
                                                      
END;

$function$

