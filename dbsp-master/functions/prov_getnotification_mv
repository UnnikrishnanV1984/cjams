CREATE OR REPLACE FUNCTION prov_getnotification_mv(v_monitoring_id character varying)
 RETURNS TABLE(provider_nms character varying, adr_email_tx character varying, adr_fax_tx character varying, adr_cell_phone_tx character varying, monitoring_dt timestamp without time zone, monitoring_id character varying, deadline_dt timestamp without time zone, mon_yr text, provider_address text, la_details jsonb)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                      

BEGIN                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                  
RETURN QUERY                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
 select 
(case when (tp.provider_nm is null or tp.provider_nm = '') then  concat_ws(' ',tp.provider_first_nm, tp.provider_last_nm)
else tp.provider_nm end ) as provider_nms,tp.adr_email_tx,tp.adr_fax_tx,tp.adr_cell_phone_tx, pm.monitoring_dt,pm.monitoring_id ,
pm.monitoring_dt + interval '10 day' as deadline_dt,
concat_ws('/',date_part('month',  pm.monitoring_dt::timestamp),date_part('year',  pm.monitoring_dt::timestamp)) as mon_yr,
concat_ws(',' ,tpa.adr_street_no,tpa.adr_street_nm, tpa.adr_city_nm,tpa.adr_state_cd,tpa.adr_zip5_no) as provider_address,
(select jsonb_agg(x) from (
select mu.username as lic_cor ,mu.email as lic_mail,upn.phonenumber as lic_cor_no from muser mu join userprofilephonenumber upn on mu.securityusersid = upn.securityusersid
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
where  r.roletypekey in ('OLMLA') limit 1)x) as la_details

from prov_monitoring pm
join tb_provider tp on pm.provider_id = tp.provider_id
join tb_provider_addresses tpa on pm.provider_id ::character varying = tpa.parent_key_id
where (pm.monitoring_id = v_monitoring_id) 

group by   tp.provider_nm,tp.provider_first_nm, tp.provider_last_nm,
tp.adr_email_tx,tp.adr_fax_tx,tp.adr_cell_phone_tx, pm.monitoring_dt,pm.monitoring_id,
tpa.adr_street_no, tpa.adr_street_nm, tpa.adr_city_nm,tpa.adr_state_cd,tpa.adr_zip5_no;
                                                                                                                                                                                                                                                                                                                   
 end;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 $function$

