CREATE OR REPLACE FUNCTION as_frcrouting(v_objectid character varying, v_securityuserid character varying, appeventcode character varying, v_status integer, commenttext text)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare 

v_newstatus character varying;
v_name text;
v_assessmenttemplateid uuid;




begin

 select att.assessmenttemplateid   into v_assessmenttemplateid
 from assessmenttemplate att 
 where att.external_templateid =v_objectid 
 and att.activeflag =1;
 
 
    SELECT routingintake  INTO v_newstatus FROM as_routingintake(
     v_assessmenttemplateid:: character varying,
     v_securityuserid :: character varying,
     appeventcode:: character varying,
     v_status,
     commenttext );
  

  
  RETURN 'Success';
  
END;

$function$

