CREATE OR REPLACE FUNCTION as_fn_clnt_elig_upd()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
-- IF OLD.ELIGIBILITY_STATUS_CD <> NEW.ELIGIBILITY_STATUS_CD THEN

  IF  OLD.eligibilitystatuskey <> NEW.eligibilitystatuskey THEN
 
    --IF NEW.ELIGIBILITY_STATUS_CD IS NOT NULL THEN

 INSERT INTO caresoutboundtrigger
 ( old_id,
                     fk_id,
                    transactionon,
                    transactiontypekey,
                    statusflag,
  activeflag)
 select 
                    sc.servicecasenumber,
                     p.cjamspid,
                     CURRENT_TIMESTAMP,
                     '20',
                     'N',
                     1--
 from person p,
   intakeservicerequestactor isr,
   servicecase sc,
   personeligibility pe
 where 
    isr.personid=p.personid
 and   isr.intakeservicerequestactorid=pe.inatakservicerequestactorid
    --and   pe.inatakservicerequestactorid=new.inatakeservicerequestactorid
 and   sc.servicecaseid=isr.servicecaseid;


    --END IF;--

  END IF;--

 IF OLD.eligibilitystatuskey <> NEW.eligibilitystatuskey THEN

    --IF NEW.ELIGIBILITY_STATUS_CD IS NOT NULL THEN

 INSERT INTO csesoutboundtrigger
 ( old_id,
                     fk_id,
                    transactionon,
                    transactiontypekey,
                    statusflag,
  activeflag)
 select 
                    sc.servicecasenumber,
                     p.cjamspid,
                     CURRENT_TIMESTAMP,
                     '20',
                     'N',
                     1--
 from person p,
   intakeservicerequestactor isr,
   servicecase sc,
   personeligibility pe
 where isr.personid=p.personid
 and   isr.intakeservicerequestactorid=pe.inatakservicerequestactorid
 --and   pe.inatakservicerequestactorid=new.inatakeservicerequestactorid
 and   sc.servicecaseid=isr.servicecaseid;


    --END IF;--

  END IF;-- */
/*
-- END IF; --OLD.ELIGIBILITY_STATUS_CD <> NEW.ELIGIBILITY_STATUS_CD 
/
IF (OLD.STARTDATE <> NEW.STARTDATE OR OLD.ENDDATE <> NEW.ENDDATE) AND 
   ( ( OLD.ELIGIBILITYSTATUSTYPEKEY in ('2931', '2934', '2935') AND ( NEW.STARTDATE <> OLD.STARTDATE OR COALESCE(NEW.ENDDATE::VARCHAR,'0000-00-00') <> COALESCE((OLD.ENDDATE::VARCHAR),'0000-00-00'))  ) ) THEN
  UPDATE  TB_ELIGIBILITY_PERIOD 
   SET START_DT = NEW.START_DT ,
       END_DT = NEW.END_DT
  WHERE  ELIGIBILITY_ID = NEW.ELIGIBILITY_ID ;--
END IF;--*/
return new;
END;
$function$

