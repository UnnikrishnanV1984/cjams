CREATE OR REPLACE FUNCTION searchschoollist(searchkey character varying)
 RETURNS TABLE(totalcount bigint, schoolid uuid, schooltypekey character varying, schooltypedescription character varying, schoolcode character varying, schoolname character varying, address character varying, city character varying, statekey character varying, statename character varying, countyid uuid, countyname character varying, zipcode character varying, phonenumber character varying)
 LANGUAGE plpgsql
AS $function$


declare v_searchkey character varying = null;

BEGIN
 v_searchkey:= searchkey;
  
 -- Search for schoolname / schoolcode / educationtypekey
 
 Return Query
 select count(1) OVER() totalcount,S.schoolid,S.educationtypekey,ET.typedescription,S.schoolcode,S.schoolname,S.address,S.city,S.statekey,ST.statename,S.countyid,
 C.countyname,S.zipcode,S.phonenumber
 from school as S 
        LEFT JOIN state as ST
             on ST.stateabbr = S.statekey and ST.activeflag = 1
        LEFT JOIN county as C
             on C.countyid = S.countyid and C.activeflag = 1 
        LEFT JOIN educationtype as ET
             on ET.educationtypekey = S.educationtypekey and ET.activeflag = 1         
 where 
 (CASE WHEN v_searchkey is NOT NULL THEN (S.schoolname ILIKE '%' || v_searchkey || '%') ELSE TRUE END
 --OR CASE WHEN v_searchkey is NOT NULL THEN (S.schoolcode = v_searchkey ) ELSE TRUE END
 OR CASE WHEN v_searchkey is NOT NULL THEN (S.educationtypekey = v_searchkey ) ELSE TRUE END)
 And  S.activeflag = 1
 order by S.schoolname asc;
 
  end;


$function$

