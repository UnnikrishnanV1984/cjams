CREATE OR REPLACE FUNCTION as_getteamslist(v_countyid character varying, v_teamid uuid, v_parentteamid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE v_result json;

BEGIN
 SELECT json_agg(s1) into v_result FROM 
        (SELECT  distinct t.activeflag, t.countyid, t.description, t.effectivedate, t.teamid as id,t.teamname as name, 
    t.officetimingfrom, t.officetimingto, t.region, t.regionid, t.teamnumber, t.teamtypekey 
  FROM muser m
   INNER JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
   INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1  
   INNER JOIN teammember tm  ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
   INNER JOIN team t on t.teamid = tm.teamid  and t.activeflag =1
  WHERE (CASE WHEN v_countyid IS NOT NULL THEN t.countyid = v_countyid ELSE TRUE END)
   AND (CASE WHEN v_teamid IS NOT NULL THEN t.teamid = v_teamid ELSE TRUE END)
   AND (CASE WHEN v_parentteamid IS NOT NULL THEN t.parentteamid = v_parentteamid ELSE TRUE END)
   AND m.activeflag =1 ) s1;
   
  
 RETURN v_result;


END;
 
$function$

