CREATE OR REPLACE FUNCTION getpaymentdetails(paymentid integer, v_lipagesize bigint, v_lipagenumber bigint, sortorder character varying, sortcolumn character varying, clientid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE 
paymentdetail json;
v_pagenumber int;
v_pageoffset int;

begin

IF COALESCE(v_liPageSize, 0) < 1 THEN                     
 v_liPageSize := 10;
END IF;

IF COALESCE(v_liPageNumber, 0) < 1 
THEN
 v_liPageNumber := 1; 
end if;

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

select json_agg(x) into  paymentdetail from (
select count(1) over() as totalcount, sum(y.gross_amount_no), *
from (
select  paydet.client_id,client.firstname,client.lastname,paydet.final_fiscal_category_cd,
paydet.final_service_start_dt,
/*case when payhead.payment_type_cd='3294' then (select pd.final_service_start_dt from tb_payment_detail pd where pd.payment_detail_id =
(select phd.reference_payment_detail_id from tb_payment_detail phd where phd.payment_detail_id=paydet.payment_detail_id limit 1) limit 1) else 
paydet.final_service_end_dt end AS final_service_end_dt*/
paydet.final_service_end_dt AS final_service_end_dt
,paydet.county_cd,(select value_tx from tb_picklist_values where 
TRIM(PICKLIST_VALUE_CD)=paydet.county_cd
AND PICKLIST_TYPE_ID='104') as localdepartment,paydet.final_amount_no as gross_amount_no,
paydet.payment_id,
paydet.payment_detail_id,paydet.payment_amount_no,ts.service_nm,
(select trd.receivable_balance_no from tb_receivable_detail trd where trd.payment_detail_id = paydet.payment_detail_id limit 1) as receivable_balance_no
 from tb_payment_detail paydet
INNER JOIN person as client ON paydet.client_id = client.cjamspid
join tb_payment_header tphh on tphh.payment_id = paydet.payment_id
left join tb_services ts on ts.service_id = paydet.final_service_id
left join tb_payment_header payhead on paydet.payment_id = payhead.payment_id
where paydet.payment_id = paymentid and paydet.client_id ::character varying= clientid
) as y group by  y.client_id,y.firstname,y.lastname,y.final_fiscal_category_cd,y.final_service_start_dt,
 y.localdepartment, y.gross_amount_no,
y.payment_id,y.service_nm,
y.payment_detail_id,y.payment_amount_no,receivable_balance_no,y.final_service_end_dt,y.county_cd
order by (
 CASE sortorder
  WHEN 'asc'
  THEN
    CASE sortcolumn
    WHEN 'categorycode' THEN  cast(y.final_fiscal_category_cd  as character varying)
    WHEN 'servicename' THEN cast(y.service_nm  as character varying)
    WHEN 'startdate' THEN cast(y.final_service_start_dt  as character varying)
    WHEN 'enddate' THEN cast(y.final_service_end_dt  as character varying)
    WHEN 'grossamount' THEN cast(y.gross_amount_no  as character varying)
    WHEN 'receivablebal' THEN cast(y.receivable_balance_no  as character varying)
    WHEN 'netammount' THEN cast(y.gross_amount_no  as character varying)
  ELSE
    cast(y.payment_detail_id  as character varying)
  END
 END) ASC NULLS LAST,
 (CASE sortorder
  WHEN 'desc'
  THEN
   CASE sortcolumn
    WHEN 'categorycode' THEN  cast(y.final_fiscal_category_cd  as character varying)
    WHEN 'servicename' THEN cast(y.service_nm  as character varying)
    WHEN 'startdate' THEN cast(y.final_service_start_dt  as character varying)
    WHEN 'enddate' THEN cast(y.final_service_end_dt  as character varying)
    WHEN 'grossamount' THEN cast(y.gross_amount_no  as character varying)
    WHEN 'receivablebal' THEN cast(y.receivable_balance_no  as character varying)
    WHEN 'netammount' THEN cast(y.gross_amount_no  as character varying)
  ELSE
    cast(y.payment_detail_id as character varying)
  END
    END) DESC NULLS LAST
LIMIT v_liPageSize OFFSET v_pageoffset
) as x
; 
return paymentdetail;
end;
$function$

