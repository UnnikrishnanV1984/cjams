CREATE OR REPLACE FUNCTION as_getintakeprior(v_intakenumber character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

 DECLARE
  jsondata json;

 BEGIN
  SELECT Json_agg(a) INTO jsondata FROM (
   SELECT p.personid, p.firstname, p.lastname, p.dob, p.gendertypekey, p.dateofdeath, p.cjamspid, 
    (SELECT typedescription FROM actortype WHERE actortype = act.actortype) AS ROLE, 
    (SELECT Json_agg(a) FROM ( SELECT * FROM as_getpersonpriorcase(p.personid)) a) AS servicecases,
    NULL::json AS  cpsfindings
  FROM actor act 
  INNER JOIN person p ON p.personid = act.personid AND p.activeflag = 1
  WHERE act.intakenumber = v_intakenumber AND act.activeflag = 1 )  a;

  RETURN  jsondata;
 END;

$function$

