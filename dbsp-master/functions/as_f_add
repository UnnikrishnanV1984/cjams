CREATE OR REPLACE FUNCTION as_f_add(vartabname character varying, varcolname character varying, varkey_id integer, varadr_type_cd character varying, tofrom character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN
   return (SELECT as_sp_address(vartabname,
                          varcolname,
                          varkey_id,
                          varadr_type_cd,
                          tofrom));
END;

$function$

