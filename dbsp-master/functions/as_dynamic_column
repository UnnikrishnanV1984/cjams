CREATE OR REPLACE FUNCTION as_dynamic_column(v_input1 character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

 DECLARE    
  v_result json;
    v_result1 json;
    
 BEGIN


 SELECT
  a.attname as "Column"
  
 FROM
  pg_catalog.pg_attribute a
 WHERE
  a.attnum > 0
  AND NOT a.attisdropped
  AND a.attrelid = (
   SELECT c.oid
   FROM pg_catalog.pg_class c
    LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
   WHERE c.relname ~ '^(test_table)$'
    AND pg_catalog.pg_table_is_visible(c.oid)
  )
 into v_input1;


 if 
 v_input1 = 'col2'
 then

 Select json_agg(row) as Output from 
          (select distinct ref_key as Key, value_text as Value 
            from referencevalues 
            where ref_key in
               (select
    regexp_split_to_table(translate('col2', '!@#$%^`-&*()', ''), ',')     /*Multiple Delimeter, Based on the column we can replace the Delimeter instead of Comma*/
   from
    TEST_TABLE)) row into
   v_result;
  
  RETURN v_result;
  
  elsif
  v_input1 = 'col1'
  Then
  Select json_agg(row) as Output from 
          (select distinct ref_key as Key, value_text as Value 
            from referencevalues 
            where ref_key in
               (select
    regexp_split_to_table(translate('col1', '!@#$%^`-&*()', ''), ',')     /*Multiple Delimeter, Based on the column we can replace the Delimeter instead of Comma*/
   from
    TEST_TABLE)) row into
   v_result1;
  return v_result1;
 else
 return 0;
  --raise notice 'RN %',v_result;
  
  end if;
  END;  

 $function$

