CREATE OR REPLACE FUNCTION as_listuseraddress(pagenumber bigint, pagesize bigint, v_regionid uuid, v_nolimit boolean DEFAULT false)
 RETURNS TABLE(address character varying)
 LANGUAGE plpgsql
AS $function$

 

DECLARE
 v_pageoffset int;
 v_pagenumber int;

BEGIN

IF COALESCE(pagesize, 0) < 1 THEN                     
 pagesize := 10;
END IF;

IF COALESCE(pagenumber, 0) < 1 THEN
 pagenumber := 1; 
END IF;

    v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
  
RETURN query

SELECT upa.address
FROM userprofileaddress upa
INNER JOIN county ct  ON upa.countyid = ct.countyid AND ct.activeflag =1
INNER JOIN region ra ON ra.regionid = ct.regionid AND ra.activeflag =1
WHERE ra.regionid = v_regionid AND upa.activeflag =1 
and upa.userprofileaddresstypekey ='O'

LIMIT CASE WHEN v_nolimit = false  THEN pagesize END offset 
      CASE WHEN v_nolimit = false  THEN v_pageoffset END; 
END;

$function$

