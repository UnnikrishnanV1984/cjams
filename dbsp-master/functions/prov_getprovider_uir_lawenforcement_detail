CREATE OR REPLACE FUNCTION prov_getprovider_uir_lawenforcement_detail(prov_uir_id character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

declare 
v_jsondata json;

BEGIN
 select json_agg(id) into v_jsondata from (
select count(1)  over(),
PU.provider_uir_id,puld.*
FROM  provider_uir PU
join provider_uir_lawenforcement_detail puld on pu.provider_uir_id = puld.provider_uir_id and puld.active_flag = 1
where PU.active_flag=1  and  puld.provider_uir_id::character varying = prov_uir_id) id 
;

return v_jsondata;
--LIMIT v_limit OFFSET v_pageoffset ;  
END;
$function$

