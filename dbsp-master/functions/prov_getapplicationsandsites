CREATE OR REPLACE FUNCTION prov_getapplicationsandsites(reqobj json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
v_provider_id integer;
v_relic CHARACTER VARYING;
v_pending CHARACTER VARYING;

jsondata  json;


BEGIN


v_provider_id := reqobj->>'provider_id';


SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

select count(1) over() as totalcount,t.* from (
 select  tpa.provider_id,tpa.program_type,tpa.program_name,tpa.prgram, tpa.application_status,
                tpa.applicant_id as object_id
                from  tb_provider_applicant tpa 
                where tpa.provider_id=v_provider_id and tpa.application_status not in ('Approved')
union
 select distinct on(tpl.site_id) tpa.provider_id,tpa.program_type,tpa.program_name,tpa.prgram, tpa.application_status,
  tpl.site_id::character varying as object_id
  from tb_provider_licensing tpl
  left join tb_provider_applicant tpa on tpa.site_id= tpl.site_id and tpl.active_sw='Y'
  inner join tb_provider tp on tp.provider_id= tpl.site_id and tp.delete_sw='N' and tp.provider_status_cd = 1791
  where tpa.provider_id=v_provider_id
    ) t
 order by t.object_id desc
)  a;

RETURN  jsondata;
END;

$function$

