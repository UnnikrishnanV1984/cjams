CREATE OR REPLACE FUNCTION prov_updatecfeplacements(v_providerid bigint, v_iscfe character varying, v_tosecurityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE
returnStatus text;
providerId numeric;
programId numeric;
serviceCategory numeric;
serviceCost numeric;
serviceDescription text;
serviceId numeric;
servicePaidBy text;
stdate date;
v_enddate date;
serviceClassification text;
providerServiceId character VARYING;
serviceUnit text;
v_service_status CHARACTER VARYING;
v_provider_service_id numeric;
createdBy CHARACTER VARYING;
createdTs timestamp;


BEGIN

providerId=v_providerid;
programId = null;
serviceCategory =null;
serviceCost =null;
serviceDescription =null;
serviceId= 525;
stdate=now();
v_enddate= null;
servicePaidBy= null;
serviceUnit= null;
serviceClassification=null;
v_service_status = 'Active';
createdBy = v_tosecurityuserid;
createdTs = now();

if (v_iscfe = 'true') then
    insert into tb_provider_services (provider_id, program_id,service_category,service_cost, service_description, 
    service_id,service_paid_by,service_unit, service_classification,start_dt, end_dt, service_status,
    create_ts,create_user_id,update_ts,update_user_id,delete_sw)
    values
    (providerId,programId,serviceCategory,serviceCost,serviceDescription,serviceId,servicePaidBy,serviceUnit, serviceClassification,stdate ,v_enddate, v_service_status,
    createdTs, createdBy, createdTs, createdBy,'N');
else
    update tb_provider_services set end_dt = now(),update_ts = createdTs ,update_user_id=createdBy where provider_id=v_providerid and service_id = serviceId and end_dt is null;
end if;

returnStatus:= 'Success';

RETURN returnStatus;
                                                      
END;

$function$

