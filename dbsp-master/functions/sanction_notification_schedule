CREATE OR REPLACE FUNCTION sanction_notification_schedule()
 RETURNS TABLE(status text, msgdata json)
 LANGUAGE plpgsql
AS $function$
DECLARE

v_msgdata json;
i json;
v_notifystatus text;
BEGIN  
-- Subject and Body for Email


select json_agg(x) into v_msgdata from (

select tpcs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id, cpa_sanction_no as sanction_no, 'Sanction [' || cpa_sanction_no|| '-' || license_sanction_type || '-' ||
' Population End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-governingenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_cpa_sanctions tpcs join tb_provider tp on tpcs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tpcs.provider_id
WHERE governingenddate <= NOW() - INTERVAL '7 DAY'

union all 

select tpcs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id, cpa_sanction_no as sanction_no, 'Sanction [' || cpa_sanction_no|| '-' || license_sanction_type || '-' ||
' Program Service End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-staffenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_cpa_sanctions tpcs join tb_provider tp on tpcs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tpcs.provider_id
WHERE staffenddate <= NOW() - INTERVAL '7 DAY'

union all

select tpcs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id, cpa_sanction_no as sanction_no, 'Sanction [' || cpa_sanction_no|| '-' || license_sanction_type || '-' ||
' Youth Serve End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-publicityenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_cpa_sanctions tpcs join tb_provider tp on tpcs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tpcs.provider_id
WHERE publicityenddate <= NOW() - INTERVAL '7 DAY'

union all 

select tpcs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id , cpa_sanction_no as sanction_no, 'Sanction [' || cpa_sanction_no|| '-' || license_sanction_type || '-' ||
' Population End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-adminenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_cpa_sanctions tpcs join tb_provider tp on tpcs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tpcs.provider_id
WHERE adminenddate <= NOW() - INTERVAL '7 DAY'

union all 

select tpcs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id , cpa_sanction_no as sanction_no, 'Sanction [' || cpa_sanction_no|| '-' || license_sanction_type || '-' ||
' Program Service End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-agelimitenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_cpa_sanctions tpcs join tb_provider tp on tpcs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tpcs.provider_id
WHERE agelimitenddate <= NOW() - INTERVAL '7 DAY'

union all

select tpcs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id , cpa_sanction_no as sanction_no, 'Sanction [' || cpa_sanction_no|| '-' || license_sanction_type || '-' ||
' Youth Serve End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-placementlimitenddt::timestamp )) ||' Days' as msg
 FROM tb_provider_cpa_sanctions tpcs join tb_provider tp on tpcs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tpcs.provider_id
WHERE placementlimitenddt <= NOW() - INTERVAL '7 DAY'

union all 

select tprs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id, rcc_sanction_no as sanction_no, 'Sanction [' || rcc_sanction_no|| '-' || license_sanction_type || '-' ||
' Population End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-populationenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_rcc_sanctions tprs join tb_provider tp on tprs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tprs.provider_id
WHERE populationenddate <= NOW() - INTERVAL '7 DAY'

union all 

select tprs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id , rcc_sanction_no as sanction_no, 'Sanction [' || rcc_sanction_no|| '-' || license_sanction_type || '-' ||
' Program Service End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-programserviceenddate::timestamp )) ||' Days' as msg
 FROM tb_provider_rcc_sanctions tprs join tb_provider tp on tprs.provider_id = tp.provider_id
 join tb_provider_userconfig tpu on  tpu.provider_id = tprs.provider_id
WHERE programserviceenddate <= NOW() - INTERVAL '7 DAY'

union all

select tprs.create_user_id as workuser_id,tpu.securityusers_id as provideruser_id, rcc_sanction_no as sanction_no, 'Sanction [' || rcc_sanction_no|| '-' || license_sanction_type || '-' ||
' Youth Serve End ] for Provider'|| (CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) ||
' will be expired within  ' || trunc(DATE_PART('day',  now()::timestamp-youthserveenddate::timestamp )) ||' Days' as msg

FROM tb_provider_rcc_sanctions tprs join tb_provider tp on tprs.provider_id = tp.provider_id
join tb_provider_userconfig tpu on  tpu.provider_id = tprs.provider_id
WHERE youthserveenddate <= NOW() - INTERVAL '7 DAY')x;

FOR i in select json_array_elements(v_msgdata)
loop

raise notice '-----%', i ->> 'msg';
SELECT prov_send_notification INTO v_notifystatus 
FROM prov_send_notification(i->>'workuser_id',i->>'workuser_id',i->>'workuser_id',
'System', 'High',  i ->> 'msg',   i ->> 'msg' , i ->> 'sanction_no',false , false);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   

SELECT prov_send_notification INTO v_notifystatus 
FROM prov_send_notification(i->>'provideruser_id',i->>'provideruser_id',i->>'provideruser_id',
'System', 'High',  i ->> 'msg',   i ->> 'msg' , i ->> 'sanction_no',false , false);      

end loop;

v_notifystatus:='SUCCESS';  
return query

select v_notifystatus,v_msgdata ;

END;
$function$

