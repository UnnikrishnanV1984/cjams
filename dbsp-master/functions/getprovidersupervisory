CREATE OR REPLACE FUNCTION getprovidersupervisory(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT PUS.provider_uir_supervisory_id, PUS.provider_uir_id, PUS.supervisor_comments, PUS.supervisor_name,
 PUS.supervisor_signdate,  PUS.is_section_filledout,  PUS.is_supervisor_comments,  PUS.is_youth_witness,
  PUS.is_notification,  PUS.is_nurses_reports,  PUS.is_signed_dates,  PUS.is_check_spelling,  PUS.is_comments_location,
   PUS.is_addition_support,  PUS.is_incident_report,  PUS.other_section_filledout,  PUS.other_supervisor_comments, 
   PUS.other_youth_witness,  PUS.other_notification,  PUS.other_nurses_reports,  PUS.other_signed_dates, 
   PUS.other_check_spelling,  PUS.other_comments_location,  PUS.other_addition_support,  PUS.other_incident_report, 
   PUS.completed_by_name,  PUS.completed_by_date
FROM provider_uir_supervisory PUS

where PUS.provider_uir_id=v_provider_uir_id and PUS.active_flag=1

   )  a;

RETURN  jsondata;
END;

$function$

