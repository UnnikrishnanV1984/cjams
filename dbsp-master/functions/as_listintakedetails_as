 dispositiondescription,
 COALESCE(statusdescription,IDAS.status),
 cast( case r.insertedon when null then '' else case when age( now() at time zone 'utc') - age(r.insertedon + time '02:00' ) > '0:00' then cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) else 'Overdue' end end as character varying),
 IDAS.jsondata,
 IDAS.updatedon ,
 ITDS.teamtypekey ,
 case
  when ITDS.teamtypekey = 'DJS'
  and lower(rts.typedescription)= 'closed' then
  case
   coalesce(0)
   when 0 then
   case
    when now()::date - (r.updatedon :: date + 30 ):: date >0 then 0
    else 1
   end
   else 2
  end
  else 0
 end,
 IDAS.ispreintake,
 0,
 null:: json,
 (
 select
  cast(concat(initcap(persons ->> 'Lastname'), coalesce(' ' ||(persons ->> 'suffix'), ''), ', ', initcap(persons ->> 'Firstname'))as character varying)
 from
  jsonb_array_elements( IDAS.jsondata -> 'persons') persons ,
  jsonb_array_elements(persons -> 'personRole') persl
 where
  persl ->>'rolekey' = 'Youth' limit 1) as youthname,
  (
 select
  cast(concat(initcap(persons ->> 'Lastname'), coalesce(' ' ||(persons ->> 'suffix'), ''), ', ', initcap(persons ->> 'Firstname'))as character varying)
 from
  jsonb_array_elements( IDAS.jsondata -> 'persons') persons ,
  jsonb_array_elements(persons -> 'personRole') persl
 where
  persl ->>'rolekey' = 'Victim' limit 1 ) as victimname,
 (
 select
  cast(initcap(trim(coalesce(PN.lastname, ''))|| ' ' || trim(coalesce(PN.suffix, '')) || ', ' || trim(coalesce(PN.firstname, ''))) as character varying)
 from
  Person as PN
 where
  --PN.personid = IDAS.focuspersonid
 trim(PN.firstname) = trim(split_part(IDAS.raname, ' ', 1))
  and trim(PN.lastname) = trim(split_part(IDAS.raname, ' ', 2))
 limit 1 ) as DJSyouthname,
 (
 select
  PN.firstname
 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as youthfirstname,
 (
 select
  PN.lastname
 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as youthlastname,
 (
 select
  PN.suffix
 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as youth_suffix,
 (
 select
  PN.cjamspid
 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as cjamspid,
  (select count(*) from personalert as p where  p.personid = IDAS.focuspersonid and p.activeflag = 1 and lower(p.status) ='active') as alertcount,
  (select count(*) from personalert as p where  p.personid = IDAS.focuspersonid and lower(p.status) ='inactive') as inactivepersonalertcount,
  coalesce(IDAS.focuspersonid,null) as focuspersonid
from
 IntakeDAStaging IDAS
inner join intakeDAStatus ITDS on
 ITDS.intakenumber = IDAS.intakenumber
left join routing r on
 r.objectid = IDAS.intakenumber
 and (r.activeflag = 1
 or r.activeflag = v_activeflag)
 and r.eventcode = 'INTR'
left join routingstatustype RTs on
 RTs.sequencenumber = r.routingstatustypeid
 and rts.activeflag = 1
left join teammemberroletype rt on
 rt.roletypekey = r.toroleid
 and rt.activeflag = 1
inner join userprofile up on
 up.securityusersid = IDAS.CRUWorkerName
inner join intakeservicerequest as ISR on
 ISR.intakenumber = ITDS.intakenumber
 and ISR.activeflag = 1
inner join intakeserreqstatustype as ISRST on
 ISRST.intakeserreqstatustypeid = ISR.intakeserreqstatustypeid
 and ISRST.activeflag = 1
where
 IDAS.IntakeNumber like intakeno || '%'
 and IDAS.teamtypekey = 'AS' 
 and IDAS.Activeflag = 1
 and lower(ISRST.intakeserreqstatustypekey) in('rejected')
 -- in('rejected','closed')
 and ( coalesce(r.fromsecurityusersid, IDAS.intakeuser) = v_UserSID
 or
 (case
  right(fromroleid, 2)
  when 'IW' then IDAS.InsertedBy = v_UserSID
  when 'KW' then IDAS.InsertedBy = v_UserSID
  else r.fromsecurityusersid = v_UserSID
 end ) )
 AND (ISR.intakeservicerequestclassid IN ('29640685-40d0-46aa-a066-84bd893b9603','624c6ecd-c6ea-47c0-8d5d-bfdf87ef4e3f','38253f34-ab82-4941-95db-1dd90e943d01','b32016e0-97a4-430a-a9e0-43aea651a44d','4ff00291-ac73-4bc2-9b9e-327bf27dbc7f','1f26128c-3758-4bdf-aa00-6769f0d7cb09')
    OR ISR.intakeservreqtypeid = '475bdb44-c347-41bc-91d1-af15979e0e27')
order by
 (
 case
  sortorder
  when 'asc' then
  case
   sortcolumn
   when 'receiveddate' then cast( IDAS.TimeRecieved as character varying)
   when 'updateddate' then cast( IDAS.updatedon as character varying)
   when 'submittedworker' then cast(up.lastname || ',  ' || up.firstname as character varying)
   else IDAS.intakenumber
  end
  else cast( IDAS.EntityName as character varying)
 end) asc,
 (
 case
  sortorder
  when 'desc' then
  case
   sortcolumn
   when 'receiveddate' then cast( IDAS.TimeRecieved as character varying)
   when 'updateddate' then cast( IDAS.updatedon as character varying)
   when 'submittedworker' then cast(up.lastname || ',  ' || up.firstname as character varying)
   else IDAS.intakenumber
  end
  else cast( IDAS.EntityName as character varying)
 end ) desc
limit pagesize offset v_pageoffset ;
else raise notice 'else %',
sortcolumn;

return QUERY select
 count(1) over(),
 *
from
 ((
 select
  IDAS.id,
  IDAS.IntakeNumber ,
  cast(case ITDS.iscps when true then 'CPS' when false then 'Non  CPS' else '' end as character varying),
  IDAS.DateRecieved,
  IDAS.TimeRecieved ::timestamp without time zone,
  (IDAS.jsondata->>'General')::json->>'Narrative',
/*  focusp.fullname :: character varying, */
  cast(p.firstname || ' ' || p.lastname as character varying) as fullname,
  IDAS.EntityName,
  cast(up.lastname || ',  ' || up.firstname as character varying) ,
  coalesce(r.isreviewrequest, false),
  coalesce(rt.isupervisor, false) ,
  r.insertedon,
  r.updatedon ,
  r.remarks,
  cast(case lower(coalesce(rts.typedescription, 'Pending')) when 'pending' then case ITDS.status when 10 then 'Assigned' else 'Draft' end else case when tosecurityusersid = IDAS.intakeuser and r.routingstatustypeid = 1 then 'Reopen' else CASE WHEN r.routingstatustypeid = ITDS.status THEN rts.typedescription ELSE 'Draft' END end end as character varying) ,
  dispositiondescription,
  COALESCE(statusdescription,IDAS.status),
  cast( case r.insertedon when null then '' else case when age( now() at time zone 'utc') - age(r.insertedon + time '02:00' ) > '0:00' then cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) else cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) end end as character varying),
  IDAS.jsondata::jsonb,
  IDAS.updatedon ,
  ITDS.teamtypekey ,
  0,
  IDAS.ispreintake,
/*  case
   coalesce(priors.casecount, 0)
   when 0 then 0
   else 1
  end as isprior, */
  
  (SELECT CASE WHEN count(*) > 0 THEN 1 ELSE 0 END FROM actor apr1 
  INNER JOIN intakeservicerequest isrtmp ON isrtmp.intakeserviceid = apr1.intakeserviceid AND isrtmp.activeflag = 1 AND isrtmp.teamtypekey = 'AS'
  WHERE apr1.personid IN (
          SELECT personid FROM actor apr2 INNER JOIN intakedastaging IDSpr ON idspr.intakenumber = apr2.intakenumber 
          WHERE IDSpr.intakenumber = ITDS.intakenumber AND IDSpr.activeflag= 1 and IDSpr.teamtypekey = 'AS' AND apr2.activeflag = 1)
         AND apr1.intakeserviceid IS NOT NULL AND apr1.activeflag = 1) as isprior,
  (
  select
   as_getcasepersonname
  from
   as_getcasepersonname ('intake',
   IDAS.IntakeNumber:: character varying)),
  ''::character varying as youthname,
 ''::character varying as victimname,
  cast(initcap(trim(coalesce(p.lastname, ''))|| ' ' || trim(coalesce(p.suffix, '')) || ', ' || trim(coalesce(p.firstname, ''))) as character varying) as DJSyouthname,
  p.firstname as youthfirstname,
  p.lastname as youthlastname,
  p.suffix as youth_suffix,
  p.cjamspid as cjamspid,
 /*  (select count(*) from personalert as p where  p.personid = IDAS.focuspersonid and p.activeflag = 1 and lower(p.status) ='active') as alertcount,
   (select count(*) from personalert as p where  p.personid = IDAS.focuspersonid and lower(p.status) ='inactive') as inactivepersonalertcount,  */
   0::bigint as alertcount,
   0::bigint as inactivepersonalertcount,
   coalesce(IDAS.focuspersonid,null) as focuspersonid
 from
  IntakeDAStaging IDAS 
  inner join intakeDAStatus ITDS on   ITDS.intakenumber = IDAS.intakenumber
  left join  intakeservicerequest ISR ON ITDS.intakenumber = ISR.intakenumber and ISR.activeflag = 1
  left join person p      on p.personid = IDAS.focuspersonid
  left join routing r on r.objectid = IDAS.intakenumber and (r.activeflag = 1 or r.activeflag = v_activeflag) and r.eventcode in ('INTR', 'KINR')
  left join routingstatustype RTs on RTs.sequencenumber = r.routingstatustypeid and rts.activeflag = 1
  left join teammemberroletype rt on rt.roletypekey = r.toroleid and rt.activeflag = 1
  left join userprofile up on up.securityusersid = IDAS.CRUWorkerName left join intakereqforservconfig irsc on irsc.intakenumber = IDAS.intakenumber
 where
  IDAS.IntakeNumber like intakeno || '%'
  and IDAS.teamtypekey = 'AS'
  and
  (case
   v_roletypekey
   when 'ASIW' then (r.routingstatustypeid = 1 and (r.fromroleid = 'ASIW' and ITDS.status =1) or (r.toroleid = 'ASIW'  and ITDS.status =7))
   or (ITDS.status  is null)
   when 'ASSP' then  (r.routingstatustypeid = 2) or 
   (r.routingstatustypeid = 1 and r.toroleid = 'ASSP' and ITDS.status =1 and r.tosecurityusersid = v_UserSID)
   else true
  end)
  and
  (case
   v_status
   when 1 then lower(IDAS.Status) = 'pending'
   else r.routingstatustypeid = v_status
  end
  or
  case
   IDAS.intakeuser
   when v_UserSID then r.routingstatustypeid = 6
   else r.routingstatustypeid = v_status OR (r.routingstatustypeid = 24 AND v_statustext = 'pending')
  end )
  and IDAS.Activeflag = 1
  and coalesce(IDAS.ispreintake, false) = false
  AND (CASE v_statustext 
    WHEN 'pending'  THEN ((ITDS.InsertedBy = v_UserSID OR ITDS.intakeuser = v_UserSID) AND (r.routingstatustypeid IS NULL OR r.routingstatustypeid NOT IN (24))) OR (ITDS.intakeuser = v_UserSID AND r.routingstatustypeid IN (24))
    ELSE r.tosecurityusersid = v_UserSID AND r.routingstatustypeid NOT IN (24) 
    END)
  and (irsc.intakenumber is null
  or irsc.reqforservstatus != 'Pending' )
  AND CASE
   WHEN  coalesce(lower(v_statustext),'') = 'pendingreview'  THEN  (coalesce(rts.typedescription,'') != '')
   ELSE  TRUE
   END
 order by
  (
  case
   sortorder
   when 'asc' then
   case
    sortcolumn
    when 'receiveddate' then cast( IDAS.TimeRecieved as character varying)
    when 'updateddate' then cast( IDAS.updatedon as character varying)
    when 'submittedworker' then cast(up.lastname || ',  ' || up.firstname as character varying)
    when 'intakenumber' then IDAS.intakenumber
    else cast(IDAS.id as character varying)
   end
   else cast( IDAS.EntityName as character varying)
  end) asc,
  (
  case
   sortorder
   when 'desc' then
   case
    sortcolumn
    when 'receiveddate' then cast( IDAS.TimeRecieved as character varying)
    when 'updateddate' then cast( IDAS.updatedon as character varying)
    when 'submittedworker' then cast(up.lastname || ',  ' || up.firstname as character varying)
    when 'intakenumber' then IDAS.intakenumber
    else cast(IDAS.id as character varying)
   end
   else cast( IDAS.EntityName as character varying)
  end ) desc )
union all (
select
 1,
 IDAS.IntakeNumber ,
 cast(case ITDS.iscps when true then 'CPS' when false then 'Non  CPS' else '' end as character varying),
 IDAS.reporteddate,
 (to_char( IDAS.reportedtime::timestamp without time zone, 'YYYYMMDD"T"HH24MISS"Z"' )::timestamptz)::timestamp without time zone,
 IDAS.Narrative,
 coalesce('') :: character varying RAName,
 cast('' as character varying) EntityName,
 cast(up.lastname || ',  ' || up.firstname as character varying) ,
 coalesce(r.isreviewrequest, false),
 coalesce(rt.isupervisor, false) ,
 r.insertedon,
 r.updatedon ,
 r.remarks,
 cast(case lower(coalesce(rts.typedescription, 'Pending')) when 'pending' then case ITDS.status when 10 then 'Assigned' else 'Draft' end else case when tosecurityusersid = intakeuser and r.routingstatustypeid = 1 then 'Reopen' else rts.typedescription end end as character varying) ,
 cast('' as character varying) dispositiondescription,
 cast('Complete' as character varying) statusdescription,
 cast( case r.insertedon when null then '' else case when age( now() at time zone 'utc') - age(r.insertedon + time '02:00' ) > '0:00' then cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) else cast( age( now() at time zone 'utc') - age( r.insertedon + time '02:00' ) as character varying(5)) end end as character varying),
 -- null::jsonb ,
    ITDS.jsondata::jsonb,
 IDAS.updatedon ,
 ITDS.teamtypekey ,
 0,
 ITDS.ispreintake,

 ( SELECT CASE WHEN count(*) > 0 THEN 1 ELSE 0 END FROM actor apr1 
  INNER JOIN intakeservicerequest isrtmp ON isrtmp.intakeserviceid = apr1.intakeserviceid AND isrtmp.activeflag = 1 AND isrtmp.teamtypekey = 'AS'
  WHERE apr1.personid IN (
   SELECT personid FROM actor apr2 INNER JOIN intakedastaging IDSpr ON idspr.intakenumber = apr2.intakenumber 
   WHERE IDSpr.intakenumber = ITDS.intakenumber AND IDSpr.activeflag= 1 and IDSpr.teamtypekey = 'AS' AND apr2.activeflag = 1)
  AND apr1.intakeserviceid IS NOT NULL AND apr1.activeflag = 1) as isprior,
 (
 select
  as_getcasepersonname
 from
  as_getcasepersonname ('intake',
  IDAS.IntakeNumber:: character varying)),
 (
 select
  as_getreportername
 from
  as_getreportername('servicerequest',
  IDAS.intakeserviceid::character varying,
  'reporter')) as youthname,
 ''::character varying as victimname, 
 ''::character varying as DJSyouthname, 
 (
 select
  youthfn
 from
  as_getreporternamefull('servicerequest',
  IDAS.intakeserviceid::character varying,
  'reporter')) as youthfirstname,
 (
 select
  youthln
 from
  as_getreporternamefull('servicerequest',
  IDAS.intakeserviceid::character varying,
  'reporter')) as youthlastname,
 (
 select
  youthsuffix
 from
  as_getreporternamefull('servicerequest',
  IDAS.intakeserviceid::character varying,
  'reporter')) as youth_suffix,
 (
 select
  as_getreportercjamspid
 from
  as_getreportercjamspid('servicerequest',
  IDAS.intakeserviceid::character varying,
  'reporter')) as cjamspid,
 0::bigint as alertcount,
 0::bigint as inactivepersonalertcount,
  (select coalesce(IDS.focuspersonid,null) as focuspersonid from intakedastaging as IDS where IDS.intakenumber = ITDS.intakenumber and 
         IDS.activeflag= 1 and IDS.teamtypekey = 'AS' order by IDS.insertedon desc limit 1)   
from
 intakeservicerequest IDAS
  inner join intakeDAStatus ITDS   on ITDS.intakenumber = IDAS.intakenumber and ITDS.teamtypekey = 'AS'
  INNER join routing r     on r.objectid = IDAS.intakenumber and (r.activeflag = 1 or r.activeflag = v_activeflag) and r.eventcode in ('INTR', 'KINR')
   and (left(r.fromroleid, 2) = 'AS' OR left(r.toroleid, 2) = 'AS')
  INNER join routingstatustype RTs  on RTs.sequencenumber = r.routingstatustypeid and rts.activeflag = 1
  INNER join teammemberroletype rt  on  rt.roletypekey = r.toroleid and rt.activeflag = 1
  inner join userprofile up    on up.securityusersid = ITDS.intakeuser 
  left join intakereqforservconfig irsc on irsc.intakenumber = IDAS.intakenumber
where
 IDAS.IntakeNumber like intakeno || '%'
 and IDAS.teamtypekey = 'AS'
 and (case v_status when 1 then coalesce (ITDS.Status, 0)in (0,1 ) else r.routingstatustypeid = v_status end
    or
  case ITDS.intakeuser when v_UserSID then r.routingstatustypeid = 6 else r.routingstatustypeid = v_status end )
 and IDAS.Activeflag = 1
 and coalesce(ITDS.ispreintake, false) = false
 and ( coalesce(r.tosecurityusersid, ITDS.intakeuser) = v_UserSID
    or
   case right(fromroleid, 2) when 'IW' then ITDS.InsertedBy = v_UserSID else r.tosecurityusersid = v_UserSID end )
 and (irsc.intakenumber is null or irsc.reqforservstatus != 'Pending' )
 AND NOT EXISTS( SELECT IDS.intakenumber FROM intakedastaging IDS WHERE IDS.intakenumber = IDAS.IntakeNumber)
order by
 (
 case
  sortorder
  when 'asc' then
  case
   sortcolumn
   when 'receiveddate' then cast( IDAS.reportedtime as character varying)
   when 'updateddate' then cast( IDAS.updatedon as character varying)
   when 'submittedworker' then cast(up.lastname || ',  ' || up.firstname as character varying)
   when 'intakenumber' then IDAS.intakenumber
   else cast(IDAS.servicerequestnumber as character varying)
  end
  else cast( IDAS.reportedarea as character varying)
 end) asc,
 (
 case
  sortorder
  when 'desc' then
  case
   sortcolumn
   when 'receiveddate' then cast( IDAS.reportedtime as character varying)
   when 'updateddate' then cast( IDAS.updatedon as character varying)
   when 'submittedworker' then cast(up.lastname || ',  ' || up.firstname as character varying)
   when 'intakenumber' then IDAS.intakenumber
   else cast(IDAS.servicerequestnumber as character varying)
  end
  else cast( IDAS.reportedarea as character varying)
 end ) desc) ) t
limit pagesize offset v_pageoffset ;
end if;
end if;
end;

