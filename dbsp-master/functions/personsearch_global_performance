CREATE OR REPLACE FUNCTION personsearch_global_performance(searchobj json)
 RETURNS TABLE(source character varying, personid uuid, personroleid uuid, personroletype character varying, personrolesubtype character varying, firstname character varying, middlename character varying, lastname character varying, dob timestamp without time zone, dangerlevel integer, ssn character varying, dcn character varying, primaryaddress character varying, homephone character varying, gendertypekey character varying, loadnumber character varying, teamname character varying, priors bigint)
 LANGUAGE plpgsql
AS $function$

DECLARE 
v_lFirstNameSoundEx VARCHAR(50);
v_lLastNameSoundEx VARCHAR(50);
v_ldNow    TIMESTAMP(3);
v_liPageNumber  INT;
v_liPageSize   INT;
v_lvFirstName  VARCHAR(50);
v_lvLastName   VARCHAR(50);
v_liAge    INT;
v_lvRace    VARCHAR(15);
v_lvGender   VARCHAR(15);
v_lvCity    VARCHAR(32);
v_lvAddress   VARCHAR(100);
v_lvZip    VARCHAR(32);
v_lvState   VARCHAR(32);
v_lvCounty   VARCHAR(32);
v_lvPhone   VARCHAR(32);
v_ldDOB    TIMESTAMP(3);
v_liActiveFlag  INT;
v_lvRoleType   VARCHAR(10);
v_lvRoleSubType  TEXT;
v_liCount   INT;
v_lvSortCol   VARCHAR(50);
v_lvSortDir   VARCHAR(10);
v_lvInterfaceType VARCHAR(20);
v_liCommaPos   INT;
v_liPersonFlag    CHAR(1);
v_liDangerous     INT;
v_liRegion   INT;
v_ldDOBFrom   TIMESTAMP(3);
v_ldDOBTo   TIMESTAMP(3);
v_lSSNType VARCHAR(50);
v_lSSNValue VARCHAR(50);
v_lDCNType VARCHAR(50);
v_lDCNValue VARCHAR(50);

v_pageoffset int;
v_pagenumber int;

BEGIN
CREATE TEMP TABLE sp_temp_searchParms(parmKeyword VARCHAR(50),parmValue VARCHAR(1000));
CREATE TEMP TABLE sp_temp_RoleSubTypes (RoleSubType VARCHAR(100) );
CREATE TEMP TABLE sp_temp_PersonIdentityTypes (parmValue VARCHAR(50));
CREATE TEMP TABLE sp_temp_PersonIdentityValues (paramtype varchar(50),parmValue VARCHAR(50));

v_liPageNumber := searchObj ->> 'pagenumber' ;
v_liPageSize := searchObj ->> 'pagesize' ;
v_lvFirstName := searchObj ->> 'firstname';
v_lvLastName := searchObj ->> 'lastname'; 
v_liAge := searchObj ->> 'age'; 
v_lvRace := searchObj ->> 'race'; 
v_lvGender := searchObj ->> 'gender'; 
v_lvCity := searchObj ->> 'city'; 
v_lvAddress := searchObj ->> 'address'; 
v_lvZip := searchObj ->> 'zip'; 
v_lvState := searchObj ->> 'state'; 
v_lvCounty := searchObj ->> 'county'; 
v_lvPhone := searchObj ->> 'phone'; 
v_ldDOB := searchObj ->> 'dob' ;
v_liActiveFlag := searchObj ->> 'activeflag';
v_lvRoleType := searchObj ->> 'roletype'; 
v_lvRoleSubType := searchObj ->> 'rolesubtype'; 
v_lvSortCol := searchObj ->> 'sortcol'; 
v_lvSortDir := searchObj ->> 'sortdir';
v_lvInterfaceType := searchObj ->> 'interfacetype'; 
v_liPersonFlag := searchObj ->> 'personflag';
v_liDangerous := searchObj ->> 'dangerous';
v_liRegion := searchObj ->> 'region'; 
v_ldDOBFrom := searchObj ->> 'dobfrom'; 
v_ldDOBTo := searchObj ->> 'dobto';

v_pagenumber := v_liPageNumber-1;
v_pageoffset = v_pagenumber * v_liPageSize;

--RAISE NOTICE 'v_liPageNumber %', v_liPageNumber ;
--RAISE NOTICE 'v_liPageSize %', v_liPageSize ;
--RAISE NOTICE 'v_lvFirstName %', v_lvFirstName ;
--RAISE NOTICE 'v_lvLastName %', v_lvLastName ;
--RAISE NOTICE 'v_liAge %', v_liAge ;
--RAISE NOTICE 'v_lvRace %', v_lvRace ;
--RAISE NOTICE 'v_lvGender %', v_lvGender ;
--RAISE NOTICE 'v_lvCity %', v_lvCity ;
--RAISE NOTICE 'v_lvAddress %', v_lvAddress ;
--RAISE NOTICE 'v_lvZip %', v_lvZip ;
--RAISE NOTICE 'v_lvState %', v_lvState ;
--RAISE NOTICE 'v_lvCounty %', v_lvCounty ;
--RAISE NOTICE 'v_lvPhone %', v_lvPhone ;
--RAISE NOTICE 'v_ldDOB %', v_ldDOB ;
--RAISE NOTICE 'v_liActiveFlag %', v_liActiveFlag ;
--RAISE NOTICE 'v_lvRoleType %', v_lvRoleType ;
--RAISE NOTICE 'v_lvRoleSubType %', v_lvRoleSubType ;
--RAISE NOTICE 'v_lvSortDir %', v_lvSortDir ;
--RAISE NOTICE 'v_lvSortCol %', v_lvSortCol ;
--RAISE NOTICE 'v_lvInterfaceType %', v_lvInterfaceType ;
--RAISE NOTICE 'v_liPersonFlag %', v_liPersonFlag ;
--RAISE NOTICE 'v_liDangerous %', v_liDangerous ;
--RAISE NOTICE 'v_liRegion %', v_liRegion ;
--RAISE NOTICE 'v_ldDOBFrom %', v_ldDOBFrom ;
--RAISE NOTICE 'v_ldDOBTo %', v_ldDOBTo;

RAISE NOTICE '%','aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
INSERT INTO sp_temp_searchParms( parmKeyword, parmValue) 
  values 
  ('pagenumber',searchObj ->> 'pagenumber'),
  ('pagesize',searchObj ->> 'pagesize '),
  ('firstname',searchObj ->> 'firstname'),
  ('lastname',searchObj ->> 'lastname'),
  ('age',searchObj ->> 'age'),
  ('race',searchObj ->> 'race'),
  ('gender',searchObj ->> 'gender'),
  ('city',searchObj ->> 'city'),
  ('address',searchObj ->> 'address'),
  ('zip',searchObj ->> 'zip'),
  ('state',searchObj ->> 'state'),
  ('county',searchObj ->> 'county'),
  ('phone',searchObj ->> 'phone'),
  ('dob',searchObj ->> 'dob'),
  ('activeflag',searchObj ->> 'activeflag'),
  ('roletype',searchObj ->> 'roletype'),
  ('rolesubtype',searchObj ->> 'rolesubtype'),
  ('count',searchObj ->> 'count'),
  ('sortcol',searchObj ->> 'sortcol'),
  ('sortdir',searchObj ->> 'sortdir'),
  ('interfacetype',searchObj ->> 'interfacetype'),
  ('commapos',searchObj ->> 'commapos'),
  ('personflag',searchObj ->> 'personflag'),
  ('dangerous',searchObj ->> 'dangerous'),
  ('region',searchObj ->> 'region'),
  ('dobfrom',searchObj ->> 'dobfrom'),
  ('dobto',searchObj ->> 'dobto'),
  ('DCN',searchObj ->> 'dcn'),
  ('SSN',searchObj ->> 'ssn');

  RAISE NOTICE '%','bbbbbbbbbbbbbbbbbbbb';
  
IF (LENGTH(v_lvState) > 2)
    THEN
        SELECT   ST.StateAbbr INTO v_lvState
        FROM State  ST
        WHERE ST.StateName =  v_lvState;
    END IF;

IF v_lvFirstName IS NULL THEN
     v_lvFirstName := '';
    END IF;
 
IF v_lvLastName IS NULL THEN
     v_lvLastName := '';
    END IF;
 
IF (v_liActiveFlag = -1 OR v_liActiveFlag is null) THEN
 v_liActiveFlag := NULL;
    END IF;

/*v_lFirstNameSoundEx  := COALESCE(MoSoundEx(v_lvFirstName ),'');
v_lLastNameSoundEx  :=  COALESCE(MoSoundEx(v_lvLastName),'');*/

v_lFirstNameSoundEx  := '';
v_lLastNameSoundEx   := '';

IF COALESCE(v_lvSortCol, 'x') NOT IN ('lastName', 'firstName', 'dob', 'dangerlevel') THEN
     v_lvSortCol := 'LastName';
    END IF;
 
IF COALESCE(v_lvSortDir, 'x') NOT IN ('asc', 'desc') THEN
 v_lvSortDir := 'Asc';
END IF;



RAISE NOTICE 'v_lvSortDir %', v_lvSortDir;
RAISE NOTICE 'v_lvSortCol %', v_lvSortCol;

IF v_lvRoleSubType IS NOT NULL
 THEN
     v_liCommaPos := POSITION(',' IN  v_lvRoleSubType);
     WHILE v_liCommaPos IS NOT NULL AND v_liCommaPos <> 0
     LOOP
      INSERT INTO sp_temp_RoleSubTypes (RoleSubType) VALUES (LTRIM(SUBSTRING(v_lvRoleSubType, 0, v_liCommaPos)));
      v_lvRoleSubType := SUBSTRING(v_lvRoleSubType, v_liCommaPos + 1, len(v_lvRoleSubType));
      v_liCommaPos := POSITION(',' IN  v_lvRoleSubType);
     END LOOP;
     INSERT INTO sp_temp_RoleSubTypes (RoleSubtype) VALUES (LTRIM(v_lvRoleSubType));
    END IF;

IF v_lvInterfaceType IS NULL THEN
     v_lvInterfaceType := 'Normal';
END IF;

  RAISE NOTICE '%','ccccccccccccccccccccccc';
INSERT INTO sp_temp_PersonIdentityTypes 
SELECT parmKeyword
FROM sp_temp_searchParms
WHERE parmKeyword = 'DCN' and parmValue is not null;

INSERT INTO sp_temp_PersonIdentityTypes 
SELECT parmKeyword
FROM sp_temp_searchParms
WHERE parmKeyword = 'SSN' and parmValue is not null;


INSERT INTO sp_temp_PersonIdentityValues
SELECT parmKeyword,parmValue
FROM sp_temp_searchParms
WHERE parmKeyword = 'SSN';
 
INSERT INTO sp_temp_PersonIdentityValues
SELECT parmKeyword,parmValue
FROM sp_temp_searchParms
WHERE parmKeyword = 'DCN';




SELECT PIT.parmValue INTO v_lSSNType
    FROM sp_temp_PersonIdentityTypes  PIT
    WHERE PIT.parmValue = 'SSN';

SELECT PIT.parmValue INTO v_lDCNType
    FROM sp_temp_PersonIdentityTypes  PIT
    WHERE PIT.parmValue = 'DCN';
 
 

 SELECT PIV.parmValue INTO v_lDCNValue
    FROM sp_temp_PersonIdentityValues PIV where PIV.paramtype = 'DCN';
    --WHERE PIV.parmValue = 'SSN'
  RAISE NOTICE '%','dddddddddddddddddddddddddddddddddddddddddddd';

SELECT PIV.parmValue INTO v_lSSNValue
FROM sp_temp_PersonIdentityValues PIV where PIV.paramtype = 'SSN';

--RAISE NOTICE 'v_lSSNType %', v_lSSNType ;
--RAISE NOTICE 'v_lSSNValue %', v_lSSNValue;
--RAISE NOTICE 'v_lDCNType %', v_lDCNType ;
--RAISE NOTICE 'v_lDCNValue %', v_lDCNValue;
  RAISE NOTICE 'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-->%',now();

CREATE TEMP TABLE KeyResults(PersonId uuid , PersonAddressId uuid);
INSERT INTO KeyResults (PersonId)
    SELECT DISTINCT p.PersonId
    FROM  Person AS p
    LEFT JOIN PersonIdentifier AS i ON i.PersonId = p.PersonId
    LEFT JOIN PersonAddress  AS a ON a.PersonId = p.PersonId   AND a.PersonAddressTypeKey = 'C' and a.ActiveFlag = 1
    LEFT JOIN PersonPhoneNumber AS pn ON pn.PersonId = p.PersonId
    LEFT JOIN   County    AS c ON  a.county = c.CountyName
    WHERE 
 CASE WHEN v_lvLastName is NOT NULL THEN (p.LastName LIKE  v_lvLastName || '%') ELSE TRUE END
 AND CASE WHEN v_lvFirstName is NOT NULL THEN (p.FirstName LIKE  v_lvFirstName || '%') ELSE TRUE END
    /*( p.LastName LIKE  v_lvLastName || '%' OR COALESCE(p.LastNameSoundex,'') = v_lLastNameSoundEx)
    AND  (p.FirstName LIKE  v_lvFirstName || '%' OR COALESCE(p.FirstNameSoundex,'') = v_lFirstNameSoundEx)
    AND  (v_liAge  IS NULL OR DATEDIFF(YEAR, p.DOB, v_ldNow) = v_liAge)*/
 AND CASE WHEN v_lvRace is NOT NULL THEN (p.RaceTypeKey = v_lvRace) ELSE TRUE END
 AND CASE WHEN v_lvGender is NOT NULL THEN (p.GenderTypeKey = v_lvGender) ELSE TRUE END
 AND CASE WHEN v_ldDOB is NOT NULL THEN (p.DOB = v_ldDOB) ELSE TRUE END
 AND CASE WHEN v_ldDOBFrom is NOT NULL THEN (p.DOB BETWEEN v_ldDOBFrom AND v_ldDOBTo) ELSE TRUE END
    AND  p.ActiveFlag = COALESCE(v_liActiveFlag, p.ActiveFlag)
 AND CASE WHEN v_lvCity is NOT NULL THEN (a.city = v_lvCity) ELSE TRUE END
 AND CASE WHEN v_lvAddress is NOT NULL THEN (a.address = v_lvAddress) ELSE TRUE END    
    AND CASE WHEN v_lvZip is NOT NULL THEN (a.zipcode = v_lvZip) ELSE TRUE END    
    AND CASE WHEN v_lvState is NOT NULL THEN (a.state = v_lvState) ELSE TRUE END 
    AND CASE WHEN v_lvCounty is NOT NULL THEN (a.county = v_lvCounty) ELSE TRUE END
    AND CASE WHEN v_lvPhone is NOT NULL THEN (pn.phoneNumber = v_lvPhone) ELSE TRUE END
    AND CASE WHEN v_lDCNValue is NOT NULL THEN (i.PersonIdentifierValue = v_lDCNValue) ELSE TRUE END
    AND CASE WHEN v_lDCNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lDCNType) ELSE TRUE END
    AND CASE WHEN v_lSSNValue is NOT NULL THEN (i.PersonIdentifierValue = v_lSSNValue) ELSE TRUE END
 AND CASE WHEN v_lSSNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lSSNType) ELSE TRUE END
    AND CASE WHEN v_liDangerous is NOT NULL THEN (p.DangerLevel = v_liDangerous) ELSE TRUE END
    AND CASE WHEN v_liRegion is NOT NULL THEN (c.APSRegion = v_liRegion) ELSE TRUE END;
    --LIMIT 1;
 
 RAISE NOTICE 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-->%',now();
 UPDATE KeyResults as KR SET PersonAddressId  = (SELECT  PRA.PersonAddressId   
                                        FROM PersonAddress PRA   
                                        WHERE PRA.PersonId = KR.PersonId   
                                        AND PRA.PersonAddressTypeKey = 'C' AND PRA.ActiveFlag = 1  
                                        ORDER BY PRA.insertedon DESC  LIMIT 1
                                        );
          
           
  RAISE NOTICE 'ffffffffffffffffffffffffffffffffffffffffffff-->%',now();
    CREATE TEMP TABLE FullResults(
     PersonId   uuid,
     PersonRoleId  uuid,
     PersonRoleType  VARCHAR(10),
     PersonRoleSubType text,
     FirstName   VARCHAR(50),
     MiddleName   VARCHAR(32),
     LastName   VARCHAR(50),
     DOB     TIMESTAMP(3) NULL,
     DangerLevel   INT  NULL,
     GenderTypeKey  VARCHAR(15) NULL  ,
     PersonAddressId uuid
    );
    RAISE NOTICE 'gggggggggggggggggggggggggggggggggggggggggg-->%',now();
    IF v_liPersonFlag = 'T'
    THEN
    INSERT INTO FullResults (
      PersonId,
      PersonRoleId,
      PersonRoleType,
      PersonRoleSubType,
      FirstName,
      MiddleName,
      LastName,
      DOB,
      DangerLevel,
      GenderTypeKey,
      PersonAddressId )
    SELECT k.PersonId,
      CAST('00000000-0000-0000-0000-000000000000' as uuid ) AS PersonRoleId,
      CAST ('None' as character varying)  AS PersonRoleType,
      CAST ('' as character varying)   AS PersonRoleSubtype,
      p.FirstName,
      p.MiddleName,
      p.LastName,
      p.DOB,
      p.DangerLevel  AS DangerLevel,
      p.GenderTypeKey ,
      k.PersonAddressId
    FROM KeyResults AS k
    JOIN Person  AS p ON p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'None') = 'None'
    AND v_lvRoleSubType IS NULL;
    ELSE
    INSERT INTO FullResults (
      PersonId,
      PersonRoleId,
      PersonRoleType,
      PersonRoleSubType,
      FirstName,
      MiddleName,
      LastName,
      DOB,
      DangerLevel,
      GenderTypeKey,
      PersonAddressId)
    SELECT k.PersonId,
      CAST('00000000-0000-0000-0000-000000000000' as uuid) AS PersonRoleId,
      CAST ('None' as character varying)  AS PersonRoleType,
      CAST ('' as character varying)   AS PersonRoleSubtype,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel  AS DangerLevel,
      p.GenderTypeKey,
      k.PersonAddressId
    FROM KeyResults AS k
    JOIN Person  AS p ON p.PersonId = k.PersonId
    WHERE NOT EXISTS (
     SELECT 1 FROM Actor AS a WHERE a.PersonId = k.PersonId )
    AND NOT EXISTS (
     SELECT 1 FROM CareGiver AS cg WHERE cg.PersonId = k.PersonId )
    AND NOT EXISTS (
     SELECT 1 FROM ProviderEmployee AS e WHERE e.PersonId = k.PersonId )
    AND COALESCE(v_lvRoleType, 'None') = 'None'
    AND v_lvRoleSubType IS NULL
     UNION ALL
    SELECT k.PersonId,
      a.ActorId,
      'A',
      a.ActorType,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel,
      p.GenderTypeKey,
      k.PersonAddressId
    FROM KeyResults AS k
    JOIN Actor  AS a ON a.PersonId = k.PersonId
    JOIN Person  AS p ON p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'A') = 'A'
    AND  (v_lvRoleSubType IS NULL OR EXISTS (SELECT * FROM sp_temp_RoleSubTypes as rst WHERE rst.RoleSubType = a.ActorType limit 1))
    AND  a.ActiveFlag = COALESCE(v_liActiveFlag, a.ActiveFlag)
    AND  ((v_lvInterfaceType = 'Normal'
    AND a.Actortype NOT IN ('EDLC','SOR','DMH','EDLI'))
    OR     (v_lvInterfaceType = 'Interface'
    AND a.ActorType IN ('EDLC','SOR','DMH','EDLI')))
     UNION ALL
    SELECT k.PersonId,
      cg.CareGiverId,
      'CG',
      cg.CareGiverTypeKey,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel ,
      p.GenderTypeKey ,
      k.PersonAddressId
    FROM KeyResults AS k
    JOIN CareGiver AS cg ON cg.PersonId = k.PersonId
    JOIN Person  AS p On p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'CG') = 'CG'
    AND  (v_lvRoleSubType IS NULL OR EXISTS (SELECT * FROM sp_temp_RoleSubTypes as rst WHERE rst.RoleSubType = cg.CareGiverTypeKey limit 1))
    AND  cg.ActiveFlag = COALESCE(v_liActiveFlag, cg.ActiveFlag)
    AND  COALESCE(v_lvInterfaceType, '') != 'Interface'
     UNION ALL
    SELECT k.PersonId,
      e.ProviderEmployeeId,
      'PE',
      e.ProviderEmployeeTypeKey,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel ,
      p.GenderTypeKey,
      k.PersonAddressId
    FROM KeyResults AS k
    JOIN ProviderEmployee AS e ON e.PersonId = k.PersonId
    JOIN Person    AS p ON p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'PE') = 'PE'
    AND  (v_lvRoleSubType IS NULL OR EXISTS (SELECT * FROM sp_temp_RoleSubTypes as rst WHERE rst.RoleSubType = e.ProviderEmployeeTypeKey limit 1))
    AND  e.ActiveFlag = COALESCE(v_liActiveFlag, e.ActiveFlag)
    AND  COALESCE(v_lvInterfaceType, '') != 'Interface';
    END IF;
      RAISE NOTICE 'hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh-->%',now();
    IF ((v_lvLastName <> '') OR (v_lvFirstName <> ''))
      THEN
     RAISE NOTICE 'iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii-->%',now();
     INSERT INTO FullResults (
      PersonId,
      PersonRoleId,
      PersonRoleType,
      PersonRoleSubType,
      FirstName,
      MiddleName,
      LastName,
      DOB,
      DangerLevel,
      GenderTypeKey)
     SELECT
      CAST('00000000-0000-0000-0000-000000000000' as uuid) AS PersonId,
      CAST('00000000-0000-0000-0000-000000000000' as uuid)AS PersonRoleId,
      'DSDSEMP',
      NULL,
      up.FirstName,
      NULL,
      up.LastName,
      NULL,
      NULL,
      NULL
    FROM UserProfile  up
    WHERE
     ( up.LastName LIKE  v_lvLastName || '%')
    AND
    ( up.FirstName  LIKE  v_lvFirstName || '%' );
   END IF;
     RAISE NOTICE 'jjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjj-->%',now();
   SELECT COUNT(1) INTO v_liCount
    FROM FullResults;
    IF v_liCount IS NULL THEN
     v_liCount := 0;
    END IF;
    IF COALESCE(v_liPageNumber, 0) < 1 THEN
     v_liPageNumber := 1;
    END IF;
    IF COALESCE(v_liPageSize, 0) < 1 THEN
     v_liPageSize := v_liCount;
    END IF;
  RAISE NOTICE 'kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk-->%',now();
    CREATE TEMP TABLE SortedResults (
     PersonId   uuid,
     PersonRoleId  uuid,
     PersonRoleType  VARCHAR(10),
     PersonRoleSubType VARCHAR(50) NULL,
     FirstName   VARCHAR(50),
     MiddleName   VARCHAR(32),
     LastName   VARCHAR(50),
     DOB     TIMESTAMP(3) NULL,
     DangerLevel   INT  NULL,
     GenderTypeKey  VARCHAR(15) NULL,
     PersonAddressId uuid );

RAISE NOTICE 'llllllllllllllllllllllllllllllllllll-->%',now();
     INSERT INTO SortedResults (
   PersonId,
     PersonRoleId,
     PersonRoleType,
     PersonRoleSubType,
     FirstName,
     MiddleName,
     LastName,
     DOB,
     DangerLevel,
     GenderTypeKey,
     PersonAddressId  )
    SELECT FR.PersonId,
      FR.PersonRoleId,
      FR.PersonRoleType,
      FR.PersonRoleSubType,
      FR.FirstName,
      FR.MiddleName,
      FR.LastName,
      FR.DOB,
      FR.DangerLevel,
      FR.GenderTypeKey ,
      FR.PersonAddressId
    FROM FullResults FR
    ORDER BY
     CASE -- Default
      WHEN v_lvSortDir is null AND v_lvSortCol is null THEN FR.LastName 
     END ASC,
     CASE -- Numeric ascending
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'dangerlevel' THEN FR.DangerLevel
     END ASC,
     CASE -- Character ascending     
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'lastname' THEN FR.LastName
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'firstname' THEN FR.FirstName
     END ASC,
     CASE -- Date ascending
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'dob' THEN FR.DOB
     END ASC,
     CASE -- Numeric descending
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'dangerlevel' THEN FR.DangerLevel
     END DESC,
     CASE -- Character descending
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'lastname' THEN FR.LastName
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'firstname' THEN FR.FirstName
     END DESC,
     CASE -- Date descending
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'dob' THEN FR.DOB
     END DESC;
     
    RAISE NOTICE 'mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm-->%',now();


     -- Return the final result subset.
     RETURN QUERY
    SELECT 
    'hcue'::character varying,
    sr.PersonId,
      sr.PersonRoleId,
      sr.PersonRoleType,
     CASE WHEN (sr.PersonRoleSubType IS NULL OR sr.PersonRoleSubType = '')   THEN
      (
       SELECT string_agg(AC.ActorType, ',')
       FROM Actor AC
       WHERE AC.PersonId = sr.PersonId
       )
       ELSE sr.PersonRoleSubType END AS PersonRoleSubType,
 sr.FirstName,
 sr.MiddleName,
 sr.LastName,
 sr.DOB,
 sr.DangerLevel,
 --v_liCount as Count,

  (SELECT i.PersonIdentifierValue
   FROM PersonIdentifier AS i
   WHERE i.PersonId = sr.PersonId
     AND i.ActiveFlag = 1
     AND i.PersonIdentifierTypeKey = 'SSN' limit 1) AS SSN,

  (SELECT j.PersonIdentifierValue
   FROM PersonIdentifier AS j
   WHERE j.PersonId = sr.PersonId
     AND j.ActiveFlag = 1
     AND j.PersonIdentifierTypeKey = 'DCN' limit 1) AS DCN,

  /*(SELECT PA.county
   FROM PersonAddress AS PA
   WHERE PA.PersonId = sr.PersonId
     AND PA.PersonAddressId = sr.PersonAddressId limit 1) AS County,*/

 (SELECT CAST(substring(COALESCE(TRIM(PA.address),'NULL'),1,20)||'~'|| substring(COALESCE(TRIM(PA.address2),'NULL'),1,20) ||'~'|| COALESCE(TRIM(PA.city),'NULL') ||'~'|| COALESCE(TRIM(PA.zipcode),'NULL')||'~'|| COALESCE(TRIM(PA.county),'NULL') ||'~'|| COALESCE(PA.state,'NULL')as character varying) 
   FROM PersonAddress AS PA
   WHERE PA.PersonId = sr.PersonId
     AND PA.PersonAddressId = sr.PersonAddressId limit 1) AS PrimaryAddress,

  (SELECT PP.phoneNumber
   FROM PersonPhoneNumber AS PP
   WHERE PP.PersonId = sr.PersonId
     AND PP.PersonPhoneTypeKey = 'H' limit 1) AS HomePhone,

  /*(SELECT PA.city
   FROM PersonAddress AS PA
   WHERE PA.PersonId = sr.PersonId
     AND PA.PersonAddressId = sr.PersonAddressId limit 1 ) AS City,

  (SELECT PA.zipcode
   FROM PersonAddress AS PA
   WHERE PA.PersonId = sr.PersonId
     AND PA.PersonAddressId = sr.PersonAddressId limit 1) AS ZipCode,*/
          sr.GenderTypeKey,

  --(SELECT string_agg(
                 -- (SELECT '/' || RT.TypeDescription
                  -- FROM RaceType AS RT
                  -- JOIN PersonRaceTypeMap AS PRTM ON PRTM.RaceTypeKey = RT.RaceTypeKey
  --                  --AND PRTM.PersonId = sr.PersonId),',')) AS Race,
-- 
  /*(SELECT TM.LoadNumber
   FROM UserProfile UP
   JOIN TeamMemberAssignment TMA ON TMA.SecurityUsersId = UP.SecurityUsersId
   JOIN TeamMember TM ON TM.TeamMemberId = TMA.TeamMemberId
   WHERE sr.FirstName = UP.FirstName
     AND sr.LastName = UP.LastName
     AND sr.PersonRoleType ='DSDSEMP') AS LoadNumber,*/
  'LoadNumber'::character varying,

  (SELECT TE.TeamName
   FROM UserProfile UP
   JOIN TeamMemberAssignment TMA ON TMA.SecurityUsersId = UP.SecurityUsersId
   JOIN TeamMember TM ON TM.TeamMemberId = TMA.TeamMemberId
   JOIN Team TE ON TE.TeamId = TM.TeamId
   WHERE sr.FirstName = UP.FirstName
     AND sr.LastName = UP.LastName
     AND sr.PersonRoleType ='DSDSEMP' ) AS TeamName,

  (SELECT COALESCE(COUNT(1),0)
   FROM IntakeServiceRequest ISR
   JOIN IntakeServiceRequestActor ISRA ON ISR.IntakeServiceId = ISRA.IntakeServiceId
   JOIN Actor AC ON AC.ActorId = ISRA.ActorId
   AND AC.ActiveFlag = 1
   JOIN Person PR ON PR.PersonId = AC.PersonId
   WHERE ISR.ActiveFlag = 1
     AND PR.PersonId = sr.PersonId) AS Priors

     
FROM SortedResults AS sr
GROUP BY sr.PersonId,
sr.PersonRoleId,
sr.PersonRoleType,
sr.personrolesubtype,
sr.firstname,
 sr.MiddleName,
 sr.LastName,
 sr.DOB,
 sr.DangerLevel,
 sr.personaddressid,
 sr.gendertypekey LIMIT v_liPageSize OFFSET v_pageoffset;
--ORDER BY ordinal;
    RAISE NOTICE 'nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn-->%',now();
DROP TABLE sp_temp_searchParms;
DROP TABLE sp_temp_RoleSubTypes;
DROP TABLE sp_temp_PersonIdentityTypes;
DROP TABLE sp_temp_PersonIdentityValues;
DROP TABLE KeyResults;
DROP TABLE FullResults;
DROP TABLE SortedResults;
END;

