CREATE OR REPLACE FUNCTION getfullroleprofile(userid character varying)
 RETURNS TABLE(roleid integer, rolename character varying, description character varying, id uuid, module character varying, task character varying, operation text, field text, resourcetype integer, resourcetypedesc character varying)
 LANGUAGE plpgsql
AS $function$
   
BEGIN

    RETURN QUERY
 SELECT r.id roleid, r.name as rolename, r.description as "role", res.id, res.resourcename module, '' as task, '' as operation, '' as field
 , rt.id as resourcetype, rt.resourcetypedesc as resourcetypedesc 
 FROM rolemapping rm 
 INNER JOIN role_resource rr ON rr.roleid = rm.roleid AND rm.principaltype = 'USER'
 INNER JOIN role r ON rr.roleid = r.id
 INNER JOIN resource res ON rr.resourceid = res.id
 INNER JOIN resourcetype rt ON res.resourcetype = rt.id
 WHERE res.resourcetype = 1 AND rm.principalid = userid
 Union All
 SELECT r.id roleid, r.name as rolename, r.description as "role", res.id, res1.resourcename as module, res.resourcename as task, '' as operation, '' as field
 , rt.id as resourcetype, rt.resourcetypedesc as resourcetypedesc 
 FROM rolemapping rm 
 INNER JOIN role_resource rr ON rr.roleid = rm.roleid AND rm.principaltype = 'USER'
 INNER JOIN role r ON rr.roleid = r.id
 INNER JOIN resource res ON rr.resourceid = res.id
 INNER JOIN resourcetype rt ON res.resourcetype = rt.id
 LEFT JOIN resource res1 ON res1.id = res.parentid AND res1.resourcetype = 1
 WHERE res.resourcetype = 2 AND rm.principalid = userid
 Union All
 SELECT r.id roleid, r.name as rolename, r.description as "role", res.id, res1.resourcename as module, res2.resourcename as task, res.resourcename as operation, '' as field
 , rt.id as resourcetype, rt.resourcetypedesc as resourcetypedesc 
 FROM rolemapping rm 
 INNER JOIN role_resource rr ON rr.roleid = rm.roleid AND rm.principaltype = 'USER'
 INNER JOIN role r ON rr.roleid = r.id
 INNER JOIN resource res ON rr.resourceid = res.id
 INNER JOIN resourcetype rt ON res.resourcetype = rt.id
 LEFT JOIN resource res2 ON res2.id = res.parentid AND res2.resourcetype = 2
 LEFT JOIN resource res1 ON res1.id = res2.parentid AND res1.resourcetype = 1
 WHERE res.resourcetype = 3 AND rm.principalid = userid
 Union All
 SELECT r.id roleid, r.name as rolename, r.description as "role", res.id, res1.resourcename as module, res2.resourcename as task, '' as operation, res.resourcename as field
 , rt.id as resourcetype, rt.resourcetypedesc as resourcetypedesc 
 FROM rolemapping rm 
 INNER JOIN role_resource rr ON rr.roleid = rm.roleid AND rm.principaltype = 'USER'
 INNER JOIN role r ON rr.roleid = r.id
 INNER JOIN resource res ON rr.resourceid = res.id
 INNER JOIN resourcetype rt ON res.resourcetype = rt.id
 LEFT JOIN resource res2 ON res2.id = res.parentid AND res2.resourcetype = 2
 LEFT JOIN resource res1 ON res1.id = res2.parentid AND res1.resourcetype = 1
 WHERE res.resourcetype = 4 AND rm.principalid = userid;
  END;
$function$

