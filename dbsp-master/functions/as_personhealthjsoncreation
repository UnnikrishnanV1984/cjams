CREATE OR REPLACE FUNCTION as_personhealthjsoncreation(id uuid, p_column_name character varying, p_table_name character varying, p_pk_column_name character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ declare

mv record;

v_array_length integer;

v_ref_key varchar;

v1 varchar;
v2 jsonb;

v_list varchar;

v_list_final jsonb;

ic integer = 0;

v_col_name varchar:= p_column_name;

v_tbl_name varchar := p_table_name;

v_pk_col_name varchar := p_pk_column_name;

begin

for mv in (
 select v_col_name
from
 v_tbl_name
where
 p_pk_column_name = id
    and activeflag = 1
 --and famhistclient = famhist_client :: varchar
 ) loop

foreach v1 in array  string_to_array(mv.v_col_name, ',')  loop

select
 ref_key, description into 
   v_ref_key , v_list
 from
  referencevalues
 where
    teamtypekey = 'CW' and
  ref_key = trim(v1);
--raise notice '%' ,json_build_object(v_ref_key,v_list);

if(ic = 0) then

   v_list_final := jsonb_agg(jsonb_build_object('ref_key',v_ref_key) || jsonb_build_object('description',v_list));
  --v_list_final := jsonb_build_object('key',v_ref_key) || jsonb_build_object('value',v_list);
  -- raise notice '%' , v_list_final;
else
--v_list_final := v_list_final  || jsonb_build_object('key',v_ref_key) || jsonb_build_object('value',v_list);
v2 := jsonb_build_object('ref_key',v_ref_key) || jsonb_build_object('description',v_list);
v_list_final :=  v_list_final || v2;
end if;
 --v_list_final := v_list_final || v1 ||',';
--v_list_final := v_list_final + " ";
ic := ic + 1;
end loop;
end loop;
--raise notice '%' , v_list_final;
return  v_list_final /*select a[1] ,a[2] from ( select string_to_array(majorhistoryproblem,',') from personfmlymdclhstry ) as dt(a)

select max(array_length(regexp_split_to_array(majorhistoryproblem, ','), 1)) into v_array_length
from personfmlymdclhstry*/;
end;

$function$

