CREATE OR REPLACE FUNCTION prov_addproviderapplicant(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                       
 declare
  v_applicant_id character varying;
  v_siteid bigint;
  v_securityuserid character varying;
  v_license_no character varying;

 
 BEGIN
  v_siteid := (insertobj->>'site_id')::bigint;
  v_applicant_id := insertobj->>'applicant_id';
  v_securityuserid:=insertobj->>'securityuserid';
  v_license_no:=insertobj->>'license_no';

  /*INSERT INTO tb_provider_applicant
  (applicant_id, application_status, application_type, site_id,create_user_id,update_user_id)
  VALUES (v_applicant_id, 'Pending', 'LICENSEUPDATE', v_siteid,v_securityuserid,v_securityuserid); */

  INSERT INTO tb_provider_applicant
  (applicant_id, application_status, application_type, prgram, program_name, contact_first_nm, mailing_address, contact_phonenumber,
  contact_email, contact_fax, program_type, program_type_other, prgram_size, current_license, licenced_by_dda,
  facesheet_dev_by_consultant, create_ts, create_user_id, update_ts, update_user_id, delete_sw, license_no, provider_id, 
  applicant_profile_id, program_tax_id_no, contact_last_nm, contact_middle_nm, contact_suffix_cd, contact_prefix_cd, 
  requested_license_effective_date, requested_license_end_date, site_id, application_decision, corporation_name, uploadsignature, 
  agency, accreditation, profit, execsignature, license_agency)
  (SELECT v_applicant_id, 'Pending', 'LICENSEUPDATE', prgram, program_name, contact_first_nm, mailing_address, contact_phonenumber, 
  contact_email, contact_fax, program_type, program_type_other, prgram_size, current_license, licenced_by_dda, 
  facesheet_dev_by_consultant, now(), v_securityuserid, now(), v_securityuserid, delete_sw, v_license_no, provider_id, 
  applicant_profile_id, program_tax_id_no, contact_last_nm, contact_middle_nm, contact_suffix_cd, contact_prefix_cd, 
  requested_license_effective_date, requested_license_end_date, v_siteid, application_decision, corporation_name, uploadsignature,
  agency, accreditation, profit, null, 
  license_agency
  FROM tb_provider_applicant where site_id = v_siteid order by create_ts desc limit 1); 
  
  RETURN v_applicant_id; 
 END;
 $function$

