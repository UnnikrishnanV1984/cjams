CREATE OR REPLACE FUNCTION add_prov_license(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                                                                               
declare                                                                                                                                                                                                                                                                                                                                                                                                                                                 
v_provider_id character varying;                                                                                                                                                                                                                                                                                                                                                                                                                        
v_license_no character varying;                                                                                                                                                                                                                                                                                                                                                                                                                         
v_securityuserid character varying;                                                                                                                                                                                                                                                                                                                                                                                                                     
v_applicant_id character varying;                                                                                                                                                                                                                                                                                                                                                                                                                       
v_minageno int;                                                                                                                                                                                                                                                                                                                                                                                                                                         
v_maxageno int;                                                                                                                                                                                                                                                                                                                                                                                                                                         
v_gender_cd character varying;                                                                                                                                                                                                                                                                                                                                                                                                                          
v_childrenno int;                                                                                                                                                                                                                                                                                                                                                                                                                                       
v_minagemonthno int;                                                                                                                                                                                                                                                                                                                                                                                                                                    
v_maxagemonthno int;                                                                                                                                                                                                                                                                                                                                                                                                                                    
v_effectivedate date;                                                                                                                                                                                                                                                                                                                                                                                                                                   
v_enddate date;                                                                                                                                                                                                                                                                                                                                                                                                                                         
v_parentproviderid int;                                                                                                                                                                                                                                                                                                                                                                                                                                 
v_prgram text;                                                                                                                                                                                                                                                                                                                                                                                                                                          
v_programtype text;                                                                                                                                                                                                                                                                                                                                                                                                                                     
v_licencetypecd text;                                                                                                                                                                                                                                                                                                                                                                                                                                   
v_licappid int;                                                                                                                                                                                                                                                                                                                                                                                                                                         
v_licno text;                                                                                                                                                                                                                                                                                                                                                                                                                                           
v_license_no_new text;                                                                                                                                                                                                                                                                                                                                                                                                                                   
v_execsignature json;                                                                                                                                                                                                                                                                                                                                                                                                                                   
i record;                                                                                                                                                                                                                                                                                                                                                                                                                                               
v_program_type_id character varying;
v_license_agency character varying;                                                                                                                                                                                                                                                                                                                                                                                                                    
v_license_agency_cd text;
v_text_program_type CHARACTER VARYING;            
v_is_max_capacity boolean;
v_max_male_capacity character varying;
v_max_female_capacity character varying;         
v_male_capacity character varying;
v_female_capacity character varying;                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
begin                                                                                                                                                                                                                                                                                                                                                                                                                                                   
v_license_no := insertobj->>'license_no';                                                                                                                                                                                                                                                                                                                                                                                                               
v_license_no_new := insertobj->>'license_no_new';                                                                                                                                                                                                                                                                                                                                                                                                        
v_provider_id := insertobj->>'provider_id';                                                                                                                                                                                                                                                                                                                                                                                                             
v_securityuserid := insertobj->>'securityuserid';                                                                                                                                                                                                                                                                                                                                                                                                       
v_applicant_id := insertobj->>'applicant_id';                                                                                                                                                                                                                                                                                                                                                                                                           
v_execsignature:= (insertobj->>'execsignature')::json;                                                                                                                                                                                                                                                                                                                                                                                                  
v_text_program_type := '';                                                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
SELECT provider_id, prgram, program_type, license_agency, execsignature                                                                                                                                                                                                                                                                                                                                                                                                 
INTO  v_parentproviderid , v_prgram, v_programtype, v_license_agency, v_execsignature                                                                                                                                                                                                                                                                                                                                                                                     
FROM tb_provider_applicant WHERE applicant_id = v_applicant_id;                                                                                                                                                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
select picklist_value_cd into v_licencetypecd from tb_picklist_values where picklist_type_id = 284 and concat('"',value_tx,'"') ilike '%'||v_programtype||'%' ;
select picklist_value_cd into v_license_agency_cd from tb_picklist_values where picklist_type_id = 111 and value_tx = v_license_agency;
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
FOR i IN select tprp.program_type_id,tprp.program_type from tb_prov_ref_program_type tprp where tprp.applicant_id = v_applicant_id and tprp.activeflag= 1                                                                                                                                                                                                                                                                                               
LOOP                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
SELECT requested_license_effective_date, requested_license_end_date, paa.minimum_age_no ,paa.maximum_age_no, paa.gender_cd, paa.children_no, paa.min_age_months_no , paa.max_age_months_no , paa.program_type_id::character varying,is_max_capacity,male_capacity,female_capacity,max_female_capacity,max_male_capacity                                                                                                                                                                                                                     
into v_effectivedate, v_enddate, v_minageno, v_maxageno, v_gender_cd, v_childrenno, v_minagemonthno, v_maxagemonthno, v_program_type_id,v_is_max_capacity,v_male_capacity,v_female_capacity,v_max_female_capacity,v_max_male_capacity                                                                                                                                                                                                                                                                                                                
FROM tb_prov_applicant_accomodation paa where provider_applicant_id = v_applicant_id and program_type_id = i.program_type_id;                                                                                                                                                                                                                                                                                                                           
-- v_licappid := ;                                                                                                                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
select license_no into v_license_no from tb_prov_applicant_accomodation where provider_applicant_id = v_applicant_id;                                                                                                                                                                                                                                                                                                                                   
IF (v_license_no is not null) then                                                                                                                                                                                                                                                                                                                                                                                                          
  v_licno := v_license_no;                                                                                                                                                                                                                                                                                                                                                                                                                              
ELSE                                                                                                                                                                                                                                                                                                                                                                                                                                                    
  v_licno := v_license_no_new;                                                                                                                                                                                                                                                                                                                                                               
END IF;                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 RAISE NOTICE '%', i;                                                                                                                                                                                                                                                                                                                                                                                                                                   
INSERT INTO tb_provider_licensing                                                                                                                                                                                                                                                                                                                                                                                                                       
(site_id, provider_id, license_type_cd, license_status_cd, application_type_cd, license_decision_cd,                                                                                                                                                                                                                                                                                                                                                    
license_issue_dt, license_expiry_dt, license_modification_dt, license_no, licensing_agency_cd, licensing_corodinator_id, licensed_beds_no, requirement_sw, midterm_issue_dt, active_sw, comments_tx, program_id,                                                                                                                                                                                                                                        
revoke_dt, revoke_approval_status_cd, midterm_rqrmnt_sw, create_ts, create_user_id, update_ts, update_user_id, delete_sw, ref_license_application_id, lic_entry_dt, request_revoke_sw, pre_revoke_status_cd ,
 license_type ,license_level,is_max_capacity,male_capacity,female_capacity,max_female_capacity,max_male_capacity)                                                                                                                                                                                                              
VALUES((v_provider_id)::int, v_parentproviderid, v_licencetypecd , '3263', '3068', '3263',v_effectivedate, v_enddate, NULL,                                                                                                                                                                                                                                                                                                                             
v_licno, v_license_agency_cd, 0, 0, '', NULL, 'Y', '', 0, NULL, '', '', now(), v_securityuserid, now(),                                                                                                                                                                                                                                                                                                                                                                   
v_securityuserid, 'N'::bpchar, 0, NULL, '', '',i.program_type,v_prgram,v_is_max_capacity,v_male_capacity::int,v_female_capacity::int,v_max_female_capacity::int,v_max_male_capacity::int) returning license_application_id into v_licappid;                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
v_text_program_type := v_text_program_type||''||i.program_type||',';                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
INSERT INTO tb_prov_accomodation                                                                                                                                                                                                                                                                                                                                                                                                                        
(prov_accomodation_id, license_application_id, minimum_age_no, maximum_age_no, gender_cd, children_no, license_no, program_type_id,                                                                                                                                                                                                                                                                                                                     
create_ts, create_user_id, update_ts, update_user_id, delete_sw, min_age_months_no, max_age_months_no,                                                                                                                                                                                                                                                                                                                                                  
execsignature,male_capacity ,female_capacity ,is_max_capacity ,max_male_capacity ,max_female_capacity)                                                                                                                                                                                                                                                                                                                                                                                                                                          
VALUES(gen_random_uuid(), v_licappid, v_minageno, v_maxageno, v_gender_cd, v_childrenno, v_licno, v_program_type_id::uuid,                                                                                                                                                                                                                                                                                                                              
now(), v_securityuserid, now(), v_securityuserid, 'N'::bpchar, v_minagemonthno, v_maxagemonthno,                                                                                                                                                                                                                                                                                                                                                        
v_execsignature,v_male_capacity::int,v_female_capacity::int,v_is_max_capacity,v_max_male_capacity::int,v_max_female_capacity::int);                                                                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
UPDATE tb_prov_applicant_accomodation                                                                                                                                                                                                                                                                                                                                                                                                                   
SET license_no = v_licno                                                                                                                                                                                                                                                                                                                                                                                                                                
WHERE provider_applicant_id = v_applicant_id and program_type_id = v_program_type_id::uuid;       


INSERT INTO providerstaffconfig 
( object_id, provider_staff_id, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
select v_provider_id, provider_staff_id, now(), v_securityuserid, now(), v_securityuserid, 'N' from providerstaffconfig where object_id = v_applicant_id and delete_sw = 'N';

UPDATE providerstaffconfig
SET delete_sw = 'Y',
update_ts = now(),
update_user_id = v_securityuserid
where object_id = v_applicant_id and delete_sw = 'N';
                                                                                                                                                                                                                                                                                                                                                                                     
-- UPDATE tb_provider_applicant                                                                                                                                                                                                                                                                                                                                                                                                                            
-- SET program_type = v_text_program_type                                                                                                                                                                                                                                                                                                                                                                                                                  
-- WHERE applicant_id = v_applicant_id;                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
END LOOP;                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
return 'success';                                                                                                                                                                                                                                                                                                                                                                                                                                       
end                                                                                                                                                                                                                                                                                                                                                                                                                                                     
$function$

