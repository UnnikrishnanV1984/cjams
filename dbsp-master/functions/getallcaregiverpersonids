CREATE OR REPLACE FUNCTION getallcaregiverpersonids(v_objectid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$\r
  \r
  DECLARE                    \r
 v_caregiverpersonids json ;\r
    v_uuidornot character varying(50);\r
 BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    \r
  SELECT * into v_uuidornot from uuid_or_null(v_objectid);   \r
  RAISE INFO '%',v_uuidornot;\r
  SELECT json_agg(a) INTO v_caregiverpersonids FROM (\r
 SELECT\r
 DISTINCT\r
 p.personid,\r
 concat_ws(' ',coalesce(p.prefx,null),coalesce(p.firstname,null),coalesce(p.middlename,null),coalesce(p.lastname,null),coalesce(p.suffix,null) ):: character varying as fullname,\r
 ar.caregiverflag\r
 FROM  actor a\r
 INNER JOIN intakeservicerequestactor isa ON isa.actorid = a.actorid\r
 INNER JOIN person p ON p.personid = a.personid\r
 LEFT JOIN actorrelationship ar ON ar.person1id = p.personid\r
 WHERE a.activeflag=1 and isa.activeflag=1 AND ar.caregiverflag = 1\r
 AND ( CASE WHEN v_uuidornot IS NULL THEN NULL ELSE(\r
         (isa.intakeserviceid = v_objectid::uuid) OR \r
   (isa.servicecaseid = v_objectid::uuid)) END OR \r
   isa.intakenumber = v_objectid \r
  )\r
 ) a;\r
    \r
 RETURN v_caregiverpersonids;\r
 END;\r
\r
 $function$

