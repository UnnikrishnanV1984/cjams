CREATE OR REPLACE FUNCTION as_getpersonimmunizationlist(v_personid uuid, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, personimmunizationid uuid, personid uuid, immunizationtypekey character varying, personimmunizationconfigid uuid, immunizationdate date, comments character varying, dose character varying, vaccinemanutype character varying, vaccinemanutypedesc character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE  

 v_client_id bigint;
 v_pagenumber int;
 v_pageoffset int;
 v_securityuserid character varying;
 
BEGIN 

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

 return query
  
 select count(1) over() as totalcount,pip.personimmunizationid,pip.personid,pip.immunizationtypekey,pip.personimmunizationconfigid,pip.immunizationdate::date,pip."comments",pip.dose, rv.ref_key, rv.description from personimmunization pip 
 LEFT JOIN referencevalues rv ON rv.ref_key = pip.vaccinemanufacturer
 where   pip.personid=v_personid AND pip.activeflag = 1
 LIMIT v_liPageSize OFFSET v_pageoffset; 
END;

$function$

