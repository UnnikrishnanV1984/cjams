CREATE OR REPLACE FUNCTION prov_getallplacementsdownload(v_providerid bigint, v_sortcol character varying, v_sortorder character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE l_placements json;
BEGIN 
SELECT json_agg(placements) INTO l_placements FROM(
 select count(1) over() as totalcount, pl.* ,p.firstname,p.lastname,p.dob,p.gendertypekey,p.cjamspid
 from tb_placement pl 
    left join person p on  pl.personid = p.personid
    where 
    (pl.provider_id=v_providerid::character varying or pl.contract_program_id::character varying = v_providerid::character varying)
    and pl.delete_sw='N' order by 
    (
 case
  v_sortorder
  when 'asc' then
  case v_sortcol
  when 'entry_dt' then COALESCE(pl.entry_dt:: character varying,'')
  when 'exit_dt' then COALESCE(pl.exit_dt:: character varying ,'')
  end
  else  NULL 
 end) ASC,
 (
 case
  v_sortorder
  when 'desc' then
  case v_sortcol
  when 'entry_dt' then COALESCE(pl.entry_dt:: character varying  ,'')
  when 'exit_dt' then COALESCE(pl.exit_dt:: character varying ,'')
  end
  else  NULL
 end ) DESC
) AS placements;

RETURN l_placements; 
 
END;

$function$

