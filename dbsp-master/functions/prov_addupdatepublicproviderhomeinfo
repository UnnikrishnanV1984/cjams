CREATE OR REPLACE FUNCTION prov_addupdatepublicproviderhomeinfo(homeinfoobj json)
 RETURNS TABLE(status text, home_info_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying;
v_response  character varying;
v_homeinfoid character varying;
 begin                                                                                                                                                                                                                                                                                                                                                                                                 
v_homeinfoid:=null;
v_securityuserid := homeinfoobj->>'securityuserid';
if (homeinfoobj->>'home_info_id' is not null) then
 v_homeinfoid := homeinfoobj->>'home_info_id';
end if;
--v_homeinfoid='38df4661-1bdb-4c14-8e6c-b5fb3819781c';
 raise notice '%s',v_homeinfoid;
raise notice '%s',v_securityuserid;


  if (v_homeinfoid) is null  then
   raise notice '%s',v_homeinfoid;
    INSERT INTO publicproviderhomeinfo (home_info_id, home_info_children_no, home_info_bedroom_no, is_home_water, is_home_swimming_pool, 
      home_info_pool_location, home_is_other_agency, home_info_agency_nm, is_child_care_provider, home_info_child_care_details, home_phone, interested_in, 
      explanatory_text, is_previously_applied, previous_state, previous_source, create_ts, create_user_id, update_ts, update_user_id, delete_sw, active_flag, object_id, 
      ownerorrenter, propertybuiltyear)
      VALUES( gen_random_uuid(),
      (homeinfoobj->>'home_info_children_no'),  
      (homeinfoobj->>'home_info_bedroom_no'),
      (homeinfoobj->>'is_home_water')::boolean , 
      (homeinfoobj->>'is_home_swimming_pool')::boolean, 
      (homeinfoobj->>'home_info_pool_location'), 
      (homeinfoobj->>'home_is_other_agency')::boolean, 
      (homeinfoobj->>'home_info_agency_nm'),
      (homeinfoobj->>'is_child_care_provider')::boolean,
      (homeinfoobj->>'home_info_child_care_details'),
      (homeinfoobj->>'home_phone') , 
      (homeinfoobj->>'interested_in'), 
      (homeinfoobj->>'explanatory_text'), 
      (homeinfoobj->>'is_previously_applied')::boolean,
      (homeinfoobj->>'previous_state'),
      (homeinfoobj->>'previous_source') , 
      now(), v_securityuserid, now(), v_securityuserid, 'N'::bpchar, 1,(homeinfoobj->>'object_id'),
      (homeinfoobj->>'ownerorrenter'), (homeinfoobj->>'propertybuiltyear')) ;


    
  else
   raise notice '%s',v_homeinfoid;
   --v_homeinfoid=(homeinfoobj->>'home_info_id');
   update  publicproviderhomeinfo ppinf set                                                                                                                                  
     home_info_children_no=(homeinfoobj->>'home_info_children_no'),  
     home_info_bedroom_no=(homeinfoobj->>'home_info_bedroom_no'),
     is_home_water=(homeinfoobj->>'is_home_water')::boolean , 
     is_home_swimming_pool=(homeinfoobj->>'is_home_swimming_pool')::boolean, 
     home_info_pool_location=(homeinfoobj->>'home_info_pool_location'), 
     home_is_other_agency=(homeinfoobj->>'home_is_other_agency')::boolean, 
     home_info_agency_nm=(homeinfoobj->>'home_info_agency_nm'),
     is_child_care_provider=(homeinfoobj->>'is_child_care_provider')::boolean,
     home_info_child_care_details=(homeinfoobj->>'home_info_child_care_details'),
     home_phone=(homeinfoobj->>'home_phone') , 
     interested_in=(homeinfoobj->>'interested_in'), 
     explanatory_text=(homeinfoobj->>'explanatory_text'), 
     is_previously_applied=(homeinfoobj->>'is_previously_applied')::boolean,
     previous_state= (homeinfoobj->>'previous_state'),
     previous_source=(homeinfoobj->>'previous_source') , 
     update_ts= now(), update_user_id=v_securityuserid, delete_sw= 'N'::bpchar, active_flag= 1,
     ownerorrenter=(homeinfoobj->>'ownerorrenter'),propertybuiltyear= (homeinfoobj->>'propertybuiltyear')
    where ppinf.home_info_id=v_homeinfoid::uuid;
  end if;
v_response:='Success';
   return query
select v_response::text,v_homeinfoid::CHARACTER VARYING;                                              
                                                                                                                                                                                                                                                                                                                                                                                           
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

