CREATE OR REPLACE FUNCTION sp_susbsidy_receivables(as_type_flag character, ad_run_dt date, OUT al_sqlcode integer, OUT as_error character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$\r
\r
      \r
------------------------------------------------------------------------\r
-- SQL Stored Procedure\r
-- Author      :  Vineet Tirodkar\r
-- Date        :  09/17/2015\r
-- Description :  PRJ-05327 - MD CHESSIE Fiscal Phases 2 \r
--      To create Adoption Subsidy and GAP A/Rs beyond max rate end date\r
\r
-- Arguments   : 1) IN as_type_flag CHAR(1) - 'A' for Adoption Subsidy and 'G' for GAP \r
--     2) IN ad_run_dt DATE \r
-- Revision(s)\r
-- 11/10/2020 - Vineet Tirodkar - Modifications to create ARs for prior to GAP start date period\r
------------------------------------------------------------------------\r
\r
-- Log Error\r
DECLARE SQLCODE INT DEFAULT 0;\r
DECLARE SQLSTATE CHAR(5) DEFAULT '00000';\r
--DECLARE p_sp_error CONDITION FOR SQLSTATE '99999' ;--\r
p_sp_error CHAR(5);\r
DECLARE vs_message_text VARCHAR(3000) DEFAULT '';\r
DECLARE vl_ret_status INTEGER DEFAULT 0;\r
DECLARE vs_Procedure_nm VARCHAR(100) DEFAULT 'SP_SUSBSIDY_RECEIVABLES';\r
DECLARE vs_identity_column VARCHAR(100);\r
DECLARE vs_identity_val VARCHAR(100);\r
\r
DECLARE  vs_change_type   VARCHAR(5);\r
\r
DECLARE vdc_old_receivable_no DECIMAL(10,2) DEFAULT 0.00;\r
DECLARE vdc_receivable_amount DECIMAL(10,2) DEFAULT 0.00;\r
\r
DECLARE vl_provider_id    BIGINT;\r
DECLARE vl_payment_detail_id BIGINT;\r
DECLARE vl_client_id   BIGINT;\r
DECLARE vl_adoption_id   BIGINT;\r
\r
DECLARE vl_cjams_county   INTEGER DEFAULT 0;\r
\r
DECLARE vd_service_start_dt  DATE;\r
DECLARE vd_service_end_dt  DATE;\r
\r
CUR_OVER_ADOPTION record;\r
CUR_OVER_ADOPTION_refcur REFCURSOR; \r
CUR_OVER_GAP record;\r
CUR_OVER_GAP_refcur REFCURSOR;\r
 \r
--DECLARE CONTINUE HANDLER FOR SQLEXCEPTION\r
BEGIN\r
begin\r
 EXCEPTION WHEN OTHERS THEN\r
   -- GET DIAGNOSTICS EXCEPTION 1 vs_message_text =  MESSAGE_TEXT;--\r
    GET STACKED DIAGNOSTICS vs_message_text :=  MESSAGE_TEXT;\r
\r
    --GET DIAGNOSTICS EXCEPTION 1 vs_message_text =  MESSAGE_TEXT;--\r
     as_error = COALESCE(as_error ,'') || (CURRENT_TIMESTAMP::text) ||'::' || vs_Procedure_nm || '.' ;\r
     as_error = COALESCE(as_error ,'') || '::RO ' || COALESCE(vs_identity_column ,'N/A') || ' :: ' || COALESCE(vs_identity_val ,'');\r
     as_error = as_error || COALESCE(vs_message_text ,'');\r
 \r
 SELECT SP_BATCH_ERROR_LOG ( vs_Procedure_nm,\r
                                NULL::bigint,\r
        NULL::bigint,\r
        NULL::character varying,\r
        NULL::INTEGER,\r
        NULL::character varying,\r
        SQLSTATE::character varying,\r
        as_error::character varying,\r
        'finance'::character varying) \r
 INTO\r
  vl_ret_status;\r
          \r
     as_error := '';\r
END;\r
-- Log error\r
\r
-- INITILA VALUE\r
 al_sqlcode := 0;\r
\r
IF as_type_flag = 'A' THEN\r
 -- Adoption Subsidy Payments beyond Subsidy Dates - main cursor - START\r
 -- FOR CUR_OVER_ADOPTION AS\r
 OPEN CUR_OVER_ADOPTION_refcur FOR\r
  SELECT PH.PROVIDER_ID,\r
      PD.PAYMENT_DETAIL_ID,\r
      PD.FINAL_AMOUNT_NO,\r
      PD.CLIENT_ID,\r
      PD.FINAL_SERVICE_START_DT,\r
      PD.FINAL_SERVICE_END_DT,\r
      tb_SUB.ADOPTION_ID,\r
      '1013' AS CHANGE_TYPE  -- Adoption Subsidy Rate Changes\r
  FROM ( SELECT TA.ADOPTION_ID,\r
       MAX(TAS.AGREEMENT_END_DT) AS MAX_RATE_END_DT\r
      FROM tb_ADOPTION TA,\r
     tb_ADOPTION_SUBSIDY_AGREEMENT TAS\r
      WHERE TA.ADOPTION_ID = TAS.ADOPTION_ID\r
    AND TA.DELETE_SW = 'N'\r
    AND TAS.DELETE_SW = 'N'\r
    AND TAS.PROVIDER_ID IS NOT NULL\r
    AND TAS.APPROVAL_STATUS_CD = '3047'\r
    AND DATE(TAS.UPDATE_TS) = ad_run_dt\r
   GROUP BY TA.ADOPTION_ID\r
    ) AS tb_SUB,\r
    tb_PAYMENT_DETAIL PD,\r
    tb_PAYMENT_HEADER PH,\r
    tb_PAYMENT_STATUS PS\r
  WHERE tb_SUB.ADOPTION_ID = PD.SUBSIDY_AGREEMENT_ID\r
     AND PH.PAYMENT_ID = PD.PAYMENT_ID\r
     AND PH.PAYMENT_ID = PS.PAYMENT_ID \r
     AND PD.DELETE_SW = 'N'\r
     AND PH.DELETE_SW = 'N'\r
     AND PS.DELETE_SW = 'N'   \r
     AND PH.PAYMENT_TYPE_CD IN ('5689', '3294')\r
     AND PD.FINAL_SERVICE_ID = 501\r
     AND PD.FINAL_AMOUNT_NO <> 0\r
     AND PD.FINAL_SERVICE_START_DT > tb_SUB.MAX_RATE_END_DT\r
     AND tb_SUB.MAX_RATE_END_DT NOT BETWEEN PH.PAYMENT_START_DT AND PH.PAYMENT_END_DT \r
     AND tb_SUB.MAX_RATE_END_DT IS NOT NULL\r
     AND PS.PAYMENT_STATUS_CD = '1636'  \r
  UNION ALL\r
  SELECT PH.PROVIDER_ID,\r
      PD.PAYMENT_DETAIL_ID,\r
      PD.FINAL_AMOUNT_NO,\r
      PD.CLIENT_ID,\r
      PD.FINAL_SERVICE_START_DT,\r
      PD.FINAL_SERVICE_END_DT,\r
      tb_SUB.ADOPTION_ID,\r
      '1013' AS CHANGE_TYPE  -- Adoption Subsidy Rate Changes\r
  FROM (  SELECT TA.ADOPTION_ID,\r
       TA.SUBSIDY_START_DT\r
    FROM tb_ADOPTION TA,\r
     tb_ADOPTION_SUBSIDY_AGREEMENT TAS\r
    WHERE TA.ADOPTION_ID = TAS.ADOPTION_ID\r
     AND TA.DELETE_SW = 'N'\r
     AND TAS.DELETE_SW = 'N'\r
     AND TAS.PROVIDER_ID IS NOT NULL\r
     AND TAS.APPROVAL_STATUS_CD = '3047'\r
     AND DATE(TAS.UPDATE_TS) = ad_run_dt ) AS tb_SUB,\r
    tb_PAYMENT_DETAIL PD,\r
    tb_PAYMENT_HEADER PH,\r
    tb_PAYMENT_STATUS PS\r
  WHERE tb_SUB.ADOPTION_ID = PD.SUBSIDY_AGREEMENT_ID\r
     AND PH.PAYMENT_ID = PD.PAYMENT_ID\r
     AND PH.PAYMENT_ID = PS.PAYMENT_ID \r
     AND PD.DELETE_SW = 'N'\r
     AND PH.DELETE_SW = 'N'\r
     AND PS.DELETE_SW = 'N'   \r
     AND PH.PAYMENT_TYPE_CD IN ('5689', '3294')\r
     AND PD.FINAL_SERVICE_ID = 501\r
     AND PD.FINAL_AMOUNT_NO <> 0\r
     AND PD.FINAL_SERVICE_START_DT < tb_SUB.SUBSIDY_START_DT\r
     AND tb_SUB.SUBSIDY_START_DT NOT BETWEEN PH.PAYMENT_START_DT AND PH.PAYMENT_END_DT \r
     AND tb_SUB.SUBSIDY_START_DT IS NOT NULL\r
     AND PS.PAYMENT_STATUS_CD = '1636'  ;\r
 --DO\r
 loop\r
 fetch CUR_OVER_ADOPTION_refcur into CUR_OVER_ADOPTION;\r
 exit when not found;\r
  -- INITIAL VALUES\r
   vl_provider_id := NULL;\r
   vl_payment_detail_id := NULL;\r
   vdc_receivable_amount := NULL;\r
   vl_client_id := NULL;\r
   vd_service_start_dt := NULL;\r
   vd_service_end_dt := NULL;\r
   vl_adoption_id := NULL;\r
   vs_change_type := NULL;\r
\r
   vl_provider_id := CUR_OVER_ADOPTION.PROVIDER_ID;\r
   vl_payment_detail_id := CUR_OVER_ADOPTION.PAYMENT_DETAIL_ID;\r
   vdc_receivable_amount := CUR_OVER_ADOPTION.FINAL_AMOUNT_NO;\r
   vl_client_id := CUR_OVER_ADOPTION.CLIENT_ID;\r
   vd_service_start_dt := CUR_OVER_ADOPTION.FINAL_SERVICE_START_DT;\r
   vd_service_end_dt := CUR_OVER_ADOPTION.FINAL_SERVICE_END_DT;\r
   vl_adoption_id := CUR_OVER_ADOPTION.ADOPTION_ID;\r
   vs_change_type := CUR_OVER_ADOPTION.CHANGE_TYPE;\r
   \r
  vdc_old_receivable_no  := 0;\r
  SELECT SUM(AMOUNT_NO)\r
   INTO vdc_old_receivable_no\r
  FROM tb_RECEIVABLE_DETAIL\r
  WHERE PAYMENT_DETAIL_ID = vl_payment_detail_id\r
   AND DELETE_SW = 'N';\r
\r
  IF vdc_old_receivable_no is NULL THEN\r
   vdc_old_receivable_no  := 0;\r
  END IF;\r
\r
  vdc_receivable_amount := vdc_receivable_amount - vdc_old_receivable_no;\r
\r
  -- Check Case County\r
  -- SELECT COUNT(*)\r
  --  INTO vl_cjams_county\r
  -- FROM TB_ADOPTION\r
  -- WHERE ADOPTION_ID = vl_adoption_id\r
  --  AND DELETE_SW = 'N'\r
  --  AND (\r
  --   F_PRIM_COUNTY(CASE_ID,'NULL') IN \r
  --   ( select statecountycode from county where golivedate <= CURRENT_DATE ) OR\r
  --   F_CHECK_CASE_TRANSFER(CASE_ID) = 1\r
  --   )\r
  -- ;\r
\r
  -- IF vl_cjams_county is NULL THEN \r
  --  SET vl_cjams_county = 0;\r
  -- END IF;\r
\r
  -- IF vdc_receivable_amount > 0 AND vl_cjams_county > 0 THEN -- GENERATE THE RECEIVABLE\r
  IF vdc_receivable_amount > 0 THEN -- GENERATE THE RECEIVABLE\r
\r
   SELECT a.al_sqlcode,a.as_error from SP_OVER_PAYMENT ( vl_payment_detail_id,\r
           vl_client_id,\r
           vl_provider_id,\r
           vd_service_start_dt,\r
           vd_service_end_dt,\r
           vdc_receivable_amount,\r
           vs_change_type) a into\r
           al_sqlcode,\r
           as_error;\r
\r
   IF al_sqlcode < 0 THEN\r
     as_error := 'ADOPTION SUSBSIDY - SP_OVER_PAYMENT failed'  ;\r
     vs_identity_column := 'Payment Detail ID';\r
     vs_identity_val := TO_CHAR(vl_payment_detail_id);\r
    --SIGNAL p_sp_error  ;--\r
   END IF ;\r
  END IF;\r
  \r
 --END FOR;  --\r
 END LOOP;\r
 -- Adoption Subsidy Payments beyond Subsidy Dates - main cursor - END\r
\r
ELSE\r
 -- GAP Payments beyond Subsidy Dates - main cursor - START\r
 -- FOR CUR_OVER_GAP AS\r
 \r
 OPEN CUR_OVER_GAP_refcur FOR\r
  SELECT PH.PROVIDER_ID,\r
      PD.PAYMENT_DETAIL_ID,\r
      PD.FINAL_AMOUNT_NO,\r
      PD.CLIENT_ID,\r
      PD.FINAL_SERVICE_START_DT,\r
      PD.FINAL_SERVICE_END_DT,\r
      tb_SUB.GUARDIAN_SUBSIDY_ID,\r
      '1011' AS CHANGE_TYPE  -- GAP Rate Changes\r
  FROM ( SELECT GS.GUARDIAN_SUBSIDY_ID,\r
     MAX(CASE WHEN GR.OVERRIDE_STATUS_CD IN ('3045','3046')   \r
       AND GR.RATE_OVERRIDE_SW = 'Y' THEN \r
       GR.RATE2_END_DT \r
      ELSE  \r
       GR.RATE_END_DT \r
      END) AS MAX_RATE_END_DT\r
    FROM tb_GUARDIAN_SUBSIDY GS,\r
     tb_GAP_RATES GR\r
    WHERE GS.GUARDIAN_SUBSIDY_ID = GR.ASSISTANCE_ID\r
     AND GS.DELETE_SW = 'N'\r
     AND GR.DELETE_SW = 'N'\r
     AND GS.PROVIDER_ID IS NOT NULL\r
     AND GS.SUSBSIDY_APPROVAL_STATUS_CD = '3047'\r
     AND GR.APPROVAL_STATUS_CD = '3047'\r
     AND GR.UPDATE_TS::DATE = ad_run_dt\r
    GROUP BY GS.GUARDIAN_SUBSIDY_ID\r
    ) AS tb_SUB,\r
    tb_PAYMENT_DETAIL PD,\r
    tb_PAYMENT_HEADER PH,\r
    tb_PAYMENT_STATUS PS\r
  WHERE tb_SUB.GUARDIAN_SUBSIDY_ID = PD.SUBSIDY_AGREEMENT_ID\r
     AND PH.PAYMENT_ID = PD.PAYMENT_ID\r
     AND PH.PAYMENT_ID = PS.PAYMENT_ID \r
     AND PD.DELETE_SW = 'N'\r
     AND PH.DELETE_SW = 'N'\r
     AND PS.DELETE_SW = 'N'   \r
     AND PH.PAYMENT_TYPE_CD IN ( '7', '3294') \r
     AND PD.FINAL_SERVICE_ID = 503\r
     AND PD.FINAL_AMOUNT_NO <> 0\r
     AND PD.FINAL_SERVICE_START_DT > tb_SUB.MAX_RATE_END_DT\r
     AND tb_SUB.MAX_RATE_END_DT NOT BETWEEN PH.PAYMENT_START_DT AND PH.PAYMENT_END_DT \r
     AND tb_SUB.MAX_RATE_END_DT IS NOT NULL\r
     AND PS.PAYMENT_STATUS_CD = '1636'  \r
  UNION ALL\r
  SELECT PH.PROVIDER_ID,\r
      PD.PAYMENT_DETAIL_ID,\r
      PD.FINAL_AMOUNT_NO,\r
      PD.CLIENT_ID,\r
      PD.FINAL_SERVICE_START_DT,\r
      PD.FINAL_SERVICE_END_DT,\r
      tb_SUB.GUARDIAN_SUBSIDY_ID,\r
      '1011' AS CHANGE_TYPE  -- GAP Rate Changes\r
  FROM ( select GS.GUARDIAN_SUBSIDY_ID, \r
        GS.SUBSIDY_START_DT\r
    FROM tb_GUARDIAN_SUBSIDY GS,\r
     tb_GAP_RATES GR\r
    WHERE GS.GUARDIAN_SUBSIDY_ID = GR.ASSISTANCE_ID\r
     AND GS.DELETE_SW = 'N'\r
     AND GR.DELETE_SW = 'N'\r
     AND GS.PROVIDER_ID IS NOT NULL\r
     AND GS.SUSBSIDY_APPROVAL_STATUS_CD = '3047'\r
     AND GR.APPROVAL_STATUS_CD = '3047'\r
     AND GR.UPDATE_TS::DATE = ad_run_dt  \r
    ) AS tb_SUB,\r
    tb_PAYMENT_DETAIL PD,\r
    tb_PAYMENT_HEADER PH,\r
    tb_PAYMENT_STATUS PS\r
  WHERE tb_SUB.GUARDIAN_SUBSIDY_ID = PD.SUBSIDY_AGREEMENT_ID\r
     AND PH.PAYMENT_ID = PD.PAYMENT_ID\r
     AND PH.PAYMENT_ID = PS.PAYMENT_ID \r
     AND PD.DELETE_SW = 'N'\r
     AND PH.DELETE_SW = 'N'\r
     AND PS.DELETE_SW = 'N'   \r
     AND PH.PAYMENT_TYPE_CD IN ( '7', '3294') \r
     AND PD.FINAL_SERVICE_ID = 503\r
     AND PD.FINAL_AMOUNT_NO <> 0\r
     AND PD.FINAL_SERVICE_START_DT < tb_SUB.SUBSIDY_START_DT\r
     AND tb_SUB.SUBSIDY_START_DT NOT BETWEEN PH.PAYMENT_START_DT AND PH.PAYMENT_END_DT \r
     AND tb_SUB.SUBSIDY_START_DT IS NOT null\r
     AND PS.PAYMENT_STATUS_CD = '1636'  ;\r
  --DO\r
 loop\r
 fetch CUR_OVER_GAP_refcur into CUR_OVER_GAP;\r
 exit when not found;\r
  -- INITIAL VALUES\r
   vl_provider_id := NULL;\r
   vl_payment_detail_id := NULL;\r
   vdc_receivable_amount := NULL;\r
   vl_client_id := NULL;\r
   vd_service_start_dt := NULL;\r
   vd_service_end_dt := NULL;\r
   vl_adoption_id := NULL;\r
   vs_change_type := NULL;\r
\r
   vl_provider_id := CUR_OVER_GAP.PROVIDER_ID;\r
   vl_payment_detail_id := CUR_OVER_GAP.PAYMENT_DETAIL_ID;\r
   vdc_receivable_amount := CUR_OVER_GAP.FINAL_AMOUNT_NO;\r
   vl_client_id := CUR_OVER_GAP.CLIENT_ID;\r
   vd_service_start_dt := CUR_OVER_GAP.FINAL_SERVICE_START_DT;\r
   vd_service_end_dt := CUR_OVER_GAP.FINAL_SERVICE_END_DT;\r
   vl_adoption_id := CUR_OVER_GAP.GUARDIAN_SUBSIDY_ID;\r
   vs_change_type := CUR_OVER_GAP.CHANGE_TYPE;\r
   \r
  vdc_old_receivable_no  := 0;\r
  SELECT SUM(AMOUNT_NO)\r
   INTO vdc_old_receivable_no\r
  FROM tb_RECEIVABLE_DETAIL\r
  WHERE PAYMENT_DETAIL_ID = vl_payment_detail_id\r
   AND DELETE_SW = 'N';\r
\r
  IF vdc_old_receivable_no is NULL THEN\r
   vdc_old_receivable_no  := 0;\r
  END IF;\r
\r
  vdc_receivable_amount := vdc_receivable_amount - vdc_old_receivable_no;\r
\r
  -- Check Case County\r
  -- SELECT COUNT(*)\r
  --  INTO vl_cjams_county\r
  -- FROM tb_GUARDIAN_SUBSIDY\r
  -- WHERE GUARDIAN_SUBSIDY_ID = vl_adoption_id\r
  --  AND DELETE_SW = 'N'\r
  --  AND (\r
  --   F_PRIM_COUNTY(CASE_ID,'NULL') IN \r
  --   ( select statecountycode from county where golivedate <= CURRENT_DATE ) OR\r
  --   F_CHECK_CASE_TRANSFER(CASE_ID) = 1\r
  --   )\r
  -- ;\r
\r
  -- IF vl_cjams_county is NULL THEN \r
  --  SET vl_cjams_county = 0;\r
  -- END IF;\r
\r
  -- IF vdc_receivable_amount > 0 AND vl_cjams_county > 0 THEN -- GENERATE THE RECEIVABLE\r
\r
  IF vdc_receivable_amount > 0 THEN -- GENERATE THE RECEIVABLE\r
\r
   SELECT a.al_sqlcode,a.as_error from SP_OVER_PAYMENT ( vl_payment_detail_id,\r
           vl_client_id,\r
           vl_provider_id,\r
           vd_service_start_dt,\r
           vd_service_end_dt,\r
           vdc_receivable_amount,\r
           vs_change_type) a into\r
           al_sqlcode,\r
           as_error;\r
\r
   IF al_sqlcode < 0 THEN\r
     as_error := 'GAP - SP_OVER_PAYMENT failed'  ;\r
     vs_identity_column := 'Payment Detail ID';\r
     vs_identity_val := TO_CHAR(vl_payment_detail_id);\r
    --SIGNAL p_sp_error  ;--\r
   END IF ;\r
  END IF;\r
 --END FOR;--\r
 END LOOP;\r
 -- GAP Payments beyond Subsidy Dates - main cursor - END\r
END IF;\r
   \r
END\r
;\r
\r
$function$

