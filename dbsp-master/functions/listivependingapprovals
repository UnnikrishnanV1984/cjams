CREATE OR REPLACE FUNCTION listivependingapprovals(userid character varying, v_status text[], v_roleid character varying, v_placementtype character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(approvalid character varying, updatedon timestamp without time zone, status integer, gapagreementid uuid, permanencyplanid uuid, fromsecurityusersid character varying, clientid bigint, lastname character varying, firstname character varying, removaldate timestamp without time zone, removalid bigint, childname character varying, casenumber bigint, childagency character varying, childjurisdiction character varying, dateofbirth date, removalage integer, caseid uuid)
 LANGUAGE plpgsql
AS $function$ 

DECLARE
 v_pageoffset int;
 v_pagenumber int;
DECLARE 
 totalcount integer;
BEGIN
    v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
 
 if(v_placementtype = 'Fostercare')
 then
 if(v_roleid = 'IVESV' and v_status:: character varying = '{71}' :: character varying) --return resp for non-assigned user 
 then
 raise notice 'test %',v_status;
RETURN QUERY 
select distinct tfa.approvalid:: character varying,tfa.updatedon, r.routingstatustypeid,null :: uuid,null :: uuid,r.fromsecurityusersid,
tfa.cjamspid,p.lastname,p.firstname,isrcr.removaldate, isrcr.removalid ,
 CONCAT(p.firstname, ' ', p.middlename, ' ', p.lastname)::VARCHAR as childname,
 --p.cjamspid as client_id, 
 sc.servicecasenumber::BIGINT as casenumber,
 'DHS'::character varying  as childagency,
 'MD'::character varying as childjurisdiction,
-- pl.startdatetime::date as placementdate,
 p.dob::date as dateofbirth,
 extract('years' FROM isrcr.removaldate)::int -  extract('years' FROM p.dob)::int as removalage,
 sc.servicecaseid as caseid
FROM tb_ive_fostercare_audit tfa
--INNER JOIN intakeservicerequestactor isra ON isra.intakeservicerequestactorid=pl.intakeservicerequestactorid AND isra.activeflag=1
INNER JOIN person p ON p.cjamspid=tfa.cjamspid AND p.activeflag=1
--inner join placement pl on pl.personid = p.personid
--join placement pla on pla.intakeservicerequestactorid = isra.intakeservicerequestactorid and pla.activeflag=1
INNER JOIN routing r ON r.objectid=tfa.approvalid :: character varying AND r.activeflag=1 AND r.eventcode='PLTR' AND r.routingstatustypeid::text = any (v_status)
INNER JOIN intakeservreqchildremoval isrcr ON isrcr.removalid=tfa.removalid AND isrcr.activeflag=1
INNER JOIN servicecase sc ON sc.servicecaseid = isrcr.servicecaseid AND sc.activeflag = 1
WHERE r.tosecurityusersid=userid --AND 
--pl.activeflag=1
order by tfa.updatedon desc;
--LIMIT pagesize OFFSET v_pageoffset;
end if;
elseif(v_placementtype = 'Gap')
 then
if(v_roleid = 'IVESV' and v_status:: character varying = '{74}' :: character varying) --return resp for non-assigned user 
 then
 raise notice 'test %',v_status;
RETURN QUERY 
select  distinct tga.approvalid,tga.updatedon, r.routingstatustypeid,null :: uuid,null :: uuid,r.fromsecurityusersid,
tga.cjamspid,p.lastname,p.firstname,isrcr.removaldate, isrcr.removalid ,
 CONCAT(p.firstname, ' ', p.middlename, ' ', p.lastname)::VARCHAR as childname,
 --p.cjamspid as client_id, 
 sc.servicecasenumber::BIGINT as casenumber,
 'DHS'::character varying  as childagency,
 'MD'::character varying as childjurisdiction,
-- pl.startdatetime::date as placementdate,
 p.dob::date as dateofbirth,
 extract('years' FROM isrcr.removaldate)::int -  extract('years' FROM p.dob)::int as removalage,
 sc.servicecaseid as caseid
FROM tb_ive_gapaudit tga
--INNER JOIN intakeservicerequestactor isra ON isra.intakeservicerequestactorid=pl.intakeservicerequestactorid AND isra.activeflag=1
INNER JOIN person p ON p.cjamspid=tga.cjamspid AND p.activeflag=1
--inner join placement pl on pl.personid = p.personid
--join placement pla on pla.intakeservicerequestactorid = isra.intakeservicerequestactorid and pla.activeflag=1
INNER JOIN routing r ON r.objectid=tga.approvalid :: character varying AND r.activeflag=1 AND r.eventcode='GAAR' AND r.routingstatustypeid::text = any (v_status)
INNER JOIN intakeservreqchildremoval isrcr ON isrcr.removalid=tga.removalid AND isrcr.activeflag=1
INNER JOIN servicecase sc ON sc.servicecaseid = isrcr.servicecaseid AND sc.activeflag = 1
WHERE r.tosecurityusersid=userid --AND 
--pl.activeflag=1
order by tga.updatedon desc;
--LIMIT pagesize OFFSET v_pageoffset;
end if;
elseif(v_placementtype = 'Adoption')
 then
if(v_roleid = 'IVESV' and v_status:: character varying = '{68}' :: character varying) --return resp for non-assigned user 
 then
 raise notice 'test %',v_status;
RETURN QUERY 
select  distinct tadp.approvalid:: character varying,tadp.updatedon, r.routingstatustypeid,null :: uuid,null :: uuid,r.fromsecurityusersid,
tadp.cjamspid,p.lastname,p.firstname,isrcr.removaldate, isrcr.removalid ,
 CONCAT(p.firstname, ' ', p.middlename, ' ', p.lastname)::VARCHAR as childname,
 --p.cjamspid as client_id, 
 sc.servicecasenumber::BIGINT as casenumber,
 'DHS'::character varying  as childagency,
 'MD'::character varying as childjurisdiction,
-- pl.startdatetime::date as placementdate,
 p.dob::date as dateofbirth,
 extract('years' FROM isrcr.removaldate)::int -  extract('years' FROM p.dob)::int as removalage,
 sc.servicecaseid as caseid
FROM tb_ive_adoption_audit tadp
--INNER JOIN intakeservicerequestactor isra ON isra.intakeservicerequestactorid=pl.intakeservicerequestactorid AND isra.activeflag=1
INNER JOIN person p ON p.cjamspid=tadp.cjamspid AND p.activeflag=1
--inner join placement pl on pl.personid = p.personid
--join placement pla on pla.intakeservicerequestactorid = isra.intakeservicerequestactorid and pla.activeflag=1
INNER JOIN routing r ON r.objectid=tadp.approvalid :: character varying AND r.activeflag=1 AND r.eventcode='ABLR' AND r.routingstatustypeid::text = any (v_status)
INNER JOIN intakeservreqchildremoval isrcr ON isrcr.removalid=tadp.removalid AND isrcr.activeflag=1
INNER JOIN servicecase sc ON sc.servicecaseid = isrcr.servicecaseid AND sc.activeflag = 1
WHERE r.tosecurityusersid=userid --AND 
--pl.activeflag=1
order by tadp.updatedon desc;
--LIMIT pagesize OFFSET v_pageoffset;
end if;

end if;

END;

$function$

