 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as youthfirstname,
 (
 select
  PN.lastname
 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as youthlastname,
 (
 select
  PN.suffix
 from
  Person as PN
 where
  PN.personid = IDAS.focuspersonid) as youth_suffix,
