CREATE OR REPLACE FUNCTION as_update_payment_check(v_securityuserid character varying, v_objectid integer, v_notes character varying, v_key character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
                                
Begin

update tb_payment_header set check_status_cd = v_key,check_status_dt =now()::date ,notes_tx = v_notes where payment_id = v_objectid;

if(v_key in ('4849','581','4850'))
then
update tb_provider set withhold_payment_sw = 'Y' where provider_id = (select provider_id from tb_payment_header where payment_id = v_objectid);
end if;
update tb_payment_history set delete_sw = 'Y' where payment_id = v_objectid and delete_sw = 'N';
INSERT INTO tb_payment_history
(payment_id, object_id, object_key, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
VALUES(v_objectid, v_key, 'check',now(), v_securityuserid, now(), v_securityuserid,  'N');

RETURN  'Success';

END;
 
$function$

