CREATE OR REPLACE FUNCTION prov_addupdatetraininginfo(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
 declare                                                                                                                                                                                                                                                                                                                                                                                               

    v_trainingnumber character varying; 

 begin                                                                                                                                                                                                                                                                                                                                                                                                 

v_trainingnumber:=insertobj->>'orientation_training_id';

update providerorientationtraining set delete_sw='Y', active_flag=0 where orientation_training_id =v_trainingnumber::uuid;
return 'Success' ;                                                                                                                                                                                                                                                                                                                                                                                       
 end;                                                                                                                                                                                                                                                                                                                                                                                                  
 $function$

