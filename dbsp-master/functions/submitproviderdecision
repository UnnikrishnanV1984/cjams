CREATE OR REPLACE FUNCTION submitproviderdecision(objectls json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

declare
v_fromsecurityuserid character varying;
v_appstatus character varying;
v_appdecision character varying;
v_objectid character varying;
v_subject character VARYING;
v_remarks character VARYING;
v_success character VARYING;
v_tosecurityusersid CHARACTER VARYING;
v_eventcode character varying;
v_phase character varying;
v_provider_referral_nm character varying;
v_provider_name character varying;
begin
v_tosecurityusersid := objectls->>'tosecurityusersid';
v_fromsecurityuserid := objectls->>'fromsecurityuserid';
v_appstatus := objectls->>'status';
v_appdecision := objectls->>'decision';
v_objectid := objectls->>'objectid';
v_remarks := objectls->>'remarks';
v_eventcode := objectls->>'eventcode';
v_phase := objectls->>'phase';



update tb_provider_applicant set application_status = v_appstatus, update_ts = now(), update_user_id = v_fromsecurityuserid where applicant_id = v_objectid;



RETURN 'success';
end;
$function$

