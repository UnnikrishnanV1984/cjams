CREATE OR REPLACE FUNCTION f_sname(ai_staff_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN
 return
 (select
               coalesce(first_nm ,'')||' '||
               coalesce(middle_nm,'')||' '||
               coalesce(last_nm,'')||' '||
               coalesce(F_PDESC(TB_STAFF.SUFFIX_CD, 214),'')
               from tb_staff where staff_id = ai_staff_id
);
END;

$function$

