CREATE OR REPLACE FUNCTION as_getintakereferralcomplaintreport(fromdate date, todate date)
 RETURNS TABLE(complaintid character varying, raname character varying, firstname character varying, lastname character varying, suffix character varying, dob timestamp without time zone, offensedate timestamp without time zone, datereceived timestamp without time zone, intakenumber character varying, allegation json, servicerequestnumber character varying, cjamspid bigint)
 LANGUAGE plpgsql
AS $function$     
    
DECLARE
BEGIN
RETURN QUERY
select  isr.complaintid,ids.raname,p.firstname,p.lastname, p.suffix, p.dob,  isr.offensedate,  ids.daterecieved, isr.intakenumber,  (SELECT  json_agg(e)    as  allegation  from
(select  name  from  allegation  ca  
where activeflag  =1 and ca.allegationid = isre.allegationid  )  as  e)  ::json , insr.servicerequestnumber, p.cjamspid from intakedastaging ids 
join intakeservicerequestevaluation isr on ids.intakenumber = isr.intakenumber 
join intakeservicerequestevaluationconfig isre on isre.intakeservicerequestevaluationid = isr.intakeservicerequestevaluationid
join person p on p.personid =  ids.focuspersonid 
join intakeservicerequest insr on insr.intakenumber = isr.intakenumber
where ids.focuspersonid is not null and daterecieved >= fromdate and daterecieved <= todate and ids.activeflag = 1 and 
isr.activeflag =1 and isr.activeflag = 1 and isre.activeflag =1 and insr.activeflag = 1 and p.activeflag = 1;
    
END;
$function$

