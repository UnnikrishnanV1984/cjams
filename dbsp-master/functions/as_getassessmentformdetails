CREATE OR REPLACE FUNCTION as_getassessmentformdetails(intakeservid uuid)
 RETURNS TABLE(charges json)
 LANGUAGE plpgsql
AS $function$     
    
DECLARE
BEGIN
RETURN QUERY
select json_agg(distinct al.name) from intakeservicerequest isr join intakeservicerequestevaluation isre 
on isr.intakenumber = isre.intakenumber
join intakeservicerequestevaluationconfig irt on irt.intakeservicerequestevaluationid = isre.intakeservicerequestevaluationid
join allegation al on irt.allegationid = al.allegationid 
where isr.intakeserviceid = intakeservid and isr.activeflag = 1 and al.activeflag = 1 and isre.activeflag = 1 and irt.activeflag = 1;

    
END;
$function$

