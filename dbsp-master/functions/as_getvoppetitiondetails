CREATE OR REPLACE FUNCTION as_getvoppetitiondetails(i_intakeservicerequestpetitionid uuid)
 RETURNS TABLE(allegation character varying[], caseworker character varying, supervisor character varying, voppetitionwithversion text, conditiontype json, vopversion bigint, vopviolationdate timestamp without time zone, vopnotes text, vopviolationoffencetype character varying, initiatedby character varying)
 LANGUAGE plpgsql
AS $function$

begin
 
  return query

select (select array_agg( distinct AG.name)  from  allegation ag 
join intakeservicerequestevaluationconfig ITSEC  on ITSEC.allegationid=ag.allegationid and ITSEC.activeflag=1
join intakeservreqevalpetitionconfig inpe on inpe.intakeservicerequestevaluationid=ITSEC.intakeservicerequestevaluationid and inpe.activeflag=1
where inpe.intakeservicerequestpetitionid=inp.intakeservicerequestpetitionid
and (
select count(1) from intakeservicerequestcourtordertypeconfig incoc 
join courtactionallegationconfig cac on cac.courtactionallegationconfigid=incoc.courtactionallegationconfigid and cac.activeflag=1
join intakeservicerequestevaluationconfig itc on cac.intakeservicerequestevaluationconfigid=itc.intakeservicerequestevaluationconfigid and itc.activeflag=1
where incoc.courtordertypekey='PB' and itc.intakeservicerequestevaluationconfigid=ITSEC.intakeservicerequestevaluationconfigid)>0
) as allegationname
      ,(select m.fullname from userprofile m join  routing r on r.tosecurityusersid =m.securityusersid where 
r.objectid=ins.intakeserviceid ::character varying and r.toroleid='JSCW' and r.activeflag=1 limit 1 ) as caseworker,
(select m.fullname from userprofile m join  routing r on r.tosecurityusersid =m.securityusersid where 
r.objectid=ins.intakenumber ::character varying and r.toroleid='JSSP' and r.activeflag=1 limit 1 ) as supervisor ,
inp.petitionid ||'-VOP-'|| inp.vopversion + 1 as vopversionpet
 ,(select json_agg(x) from (
 select distinct  objtypes.objdescription as description,inpcc.objecttype from intakeservreqpetitionvopconditionconfig  inpcc
    join 
((select conditiontypekey as objtype,description as objdescription from conditiontype where activeflag=1)
 union all
    (select  value_text as objtype ,rv.description as objdescription  from referencevalues rv
 join referencetype rt on rt.referencetypeid=rv.referencetypeid and rt.activeflag=1
 where rt.tablename='vop Technical Conditions')) as objtypes on objtypes.objtype=inpcc.objectkey 
 where inpcc.intakeservicerequestpetitionid= inp.intakeservicerequestpetitionid) as  x) as conditiontype,inp.vopversion ,inp.vopviolationdate,inp.vopnotes,inp.vopviolationoffencetype
,inp.vopinitiatedby
from intakeservicerequestpetition inp 
--join petitiontype pt on pt.petitiontypekey=inp.petitiontypekey
--join Intakeservreqpetitionhearingconfig inph on inph.intakeservicerequestpetitionid=inp.intakeservicerequestpetitionid and inph.activeflag=1
--join intakeservicerequestcourthearing inch on inch.intakeservicerequestcourthearingid=inph.intakeservicerequestcourthearingid and inch.hearingtypekey='Disp' and inch.activeflag=1
--join intakeservicerequestcourtaction inac on inac.intakeservicerequestcourthearingid=inch.intakeservicerequestcourthearingid and inac.activeflag=1
--join courtactionallegationconfig cac on cac.intakeservicerequestcourtactionid=inac.intakeservicerequestcourtactionid and cac.activeflag=1
--join intakeservicerequestcourtordertypeconfig incoc on incoc.courtactionallegationconfigid=cac.courtactionallegationconfigid and incoc.activeflag=1 and  incoc.courtordertypekey='PB'
join intakeservicerequest ins on ins.intakenumber=inp.intakenumber and ins.activeflag=1
where inp.intakeservicerequestpetitionid=i_intakeservicerequestpetitionid   ;--'306b06a1-6fb1-4bbe-b5b2-dca40d8cdcaf'

end;


$function$

