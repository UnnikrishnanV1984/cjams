CREATE OR REPLACE FUNCTION updateteamassignment(v_email character varying, v_teamnumber character varying, v_statecountycode character varying, v_teamname character varying, v_roletypekey character varying, v_supervisoremail character varying, v_assupervisoremail character varying, v_agencycode character varying, v_isaddorremove character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_teamid uuid;
 v_countyid uuid;
 v_positioncode character varying;
 v_securityusersid character varying;
 v_teammemberid uuid;
 v_loadnumber character varying;
 v_teammemberassignmentid uuid;
 v_principalid bigint;
 v_roleid integer;
 v_rolelevel integer;
 v_finalroletypekey character varying;
 v_existingrolelevel integer;
 v_nextroleid integer;
 v_supervisorid uuid;
 v_assupervisorid uuid;
 v_message character varying(100);
    rec RECORD;
   l_SPCount bigint;   
BEGIN
 v_teamid := null;
 v_positioncode := v_statecountycode;
 v_securityusersid := null;
 v_teammemberid := null;
 v_teammemberassignmentid := null;
 v_principalid := null;
 v_roleid := null;
 v_rolelevel := null;
 v_finalroletypekey := v_roletypekey;
 v_existingrolelevel := null;
 v_nextroleid := null;
 v_supervisorid := null;
 v_assupervisorid := null;
 rec := null;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           

 SELECT securityusersid, 
        lower(firstname) || lower(lastname)::character varying
     INTO v_securityusersid, v_loadnumber
   FROM userprofile 
   WHERE email = v_email
   AND activeflag = 1
   LIMIT 1;
   
 IF (v_securityusersid IS NULL) THEN
  v_message:= 'New user, please set isaddorremove flag as add';
 ELSE   
    SELECT id INTO v_principalid FROM muser where securityusersid = v_securityusersid and activeflag=1 LIMIT 1;
 --   SELECT id INTO v_roleid FROM role where roletypekey = v_roletypekey and activeflag=1 LIMIT 1;
    SELECT r.id, tmrt.rolelevel  INTO  v_roleid, v_rolelevel FROM role r, teammemberroletype tmrt WHERE r.roletypekey = tmrt.roletypekey AND r.roletypekey = v_roletypekey AND r.activeflag=1 
       AND tmrt.activeflag=1 LIMIT 1;
    IF (v_supervisoremail IS NOT NULL AND v_supervisoremail != '')  THEN
    SELECT securityusersid INTO v_supervisorid FROM userprofile where lower(email) = lower(v_supervisoremail) and activeflag = 1 LIMIT 1;
    END IF;
    IF (v_assupervisoremail IS NOT NULL AND v_assupervisoremail != '')  THEN
    SELECT securityusersid INTO v_assupervisorid FROM userprofile where lower(email) = lower(v_assupervisoremail) and activeflag = 1 LIMIT 1;
    END IF;
    
    IF (v_roleid IS NOT NULL) THEN      
        
    --added Finance Director above 1K approval role
    if(v_roleid = 5983 or v_roleid = 5984) then
        
  SELECT count(*) INTO l_SPCount FROM rolemapping rm, role r 
  WHERE rm.roleid = r.id AND rm.activeflag=1  AND rm.principalid = v_principalid
  --and r.roletypekey='ASSP'  
  AND CASE  WHEN v_agencycode= 'AS' then r.roletypekey='ASSP'  WHEN v_agencycode in  ('IV-E', 'FNS', 'CW') then r.roletypekey='CWSP' ELSE false END      
  AND r.activeflag = 1;
  
  IF(l_SPCount > 0) THEN       
  
        INSERT INTO userresource
  ( userid, permissiongroupid, roleid, resourceid, activeflag, isallowed, isvisible, isenabled, old_id,  insertedby, insertedon, updatedby, updatedon)
  VALUES( v_principalid, '57a390b8-3387-428a-97a8-0b8559fd1f1e'::uuid, v_roleid, NULL, 1, true, true, true, NULL, 'ADMIN', now(), 'ADMIN', now());
        v_message:= 'Role added Sucessfully.';
  
  else 
  
  v_message:= 'Please add Supervisor role prior to assigning this role.';
  END IF;     
  
  
        else
-- changes end here
    
    
   IF (v_agencycode = 'IV-E' OR v_agencycode = 'FNS') THEN
     
          BEGIN
      FOR rec IN (SELECT * FROM role_resource WHERE activeflag=1 AND roleid = v_roleid)
      
        LOOP
       --  IF rec IS NOT NULL THEN
           UPDATE userresource 
           SET activeflag =0, isallowed = false, isvisible = false, isenabled = false, updatedon = now(), updatedby = 'ADMIN'
           WHERE userid = v_principalid AND permissiongroupid = rec.resourceid AND activeflag = 1;
           
           IF (v_isaddorremove = 'add') THEN
          
            INSERT INTO userresource
            ( userid, permissiongroupid, roleid, resourceid, activeflag, isallowed, isvisible, isenabled, old_id,  insertedby, insertedon, updatedby, updatedon)
            VALUES( v_principalid, rec.resourceid, v_roleid, NULL, 1, true, true, true, NULL, 'ADMIN', now(), 'ADMIN', now());
            
           END IF;
       --  END IF;   
        END LOOP;
      
     END;
      
         SELECT tr.rolelevel INTO v_existingrolelevel FROM rolemapping rm, role r, teammemberroletype tr    
      WHERE rm.roleid = r.id and r.roletypekey = tr.roletypekey and rm.principalid = v_principalid AND rm.teamtypekey = 'CW' and rm.activeflag = 1 and r.activeflag=1 and tr.activeflag=1 limit 1;
     
         IF (v_existingrolelevel IS NULL OR v_existingrolelevel >= v_rolelevel) THEN
       UPDATE rolemapping 
       SET activeflag=0, updatedon = now(), updatedby = 'ADMIN'
       WHERE principalid = v_principalid AND teamtypekey = 'CW' and activeflag = 1;
       
       IF (v_isaddorremove = 'add') THEN
       
        INSERT INTO rolemapping (principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id, teamtypekey) 
        values ('USER', v_principalid, v_roleid, 1, 'ADMIN','ADMIN', now(), now(),'','CW'); 
        v_message:= 'Role added Sucessfully';

       ELSE IF (v_isaddorremove = 'remove') THEN
       
          SELECT DISTINCT ur.roleid INTO v_nextroleid FROM userresource ur, role r, teammemberroletype tr 
       WHERE ur.userid = v_principalid AND ur.activeflag=1 AND ur.isallowed = true AND ur.isvisible = true AND ur.isenabled = true
       AND ur.roleid = r.id AND r.roletypekey = tr.roletypekey AND r.activeflag=1 AND tr.activeflag=1 and tr.teamtypekey IN ('CW','IV-E','FNS')
       ORDER BY tr.rolelevel LIMIT 1;                      
          
       IF v_nextroleid IS NOT NULL THEN
       
         INSERT INTO rolemapping (principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id, teamtypekey) 
         values ('USER', v_principalid, v_nextroleid, 1, 'ADMIN','ADMIN', now(), now(),'','CW'); 
         v_message:= 'Role Removed Sucessfully';
        
        END IF;
        
       END IF;
      END IF; 
      END IF;
      
       SELECT r.roletypekey INTO v_finalroletypekey FROM rolemapping rm, role r 
       WHERE rm.roleid = r.id AND rm.activeflag=1 AND rm.teamtypekey = 'CW' AND rm.principalid = v_principalid AND r.activeflag = 1;
      
     ELSE IF (v_agencycode = 'PROV' OR v_agencycode = 'PVPROV') THEN
     
          BEGIN
      FOR rec IN (SELECT * FROM role_resource WHERE activeflag=1 AND roleid = v_roleid)
      
        LOOP
      --   IF rec IS NOT NULL THEN
          UPDATE userresource 
          SET activeflag =0, isallowed = false, isvisible = false, isenabled = false, updatedon = now(), updatedby = 'ADMIN'
          WHERE userid = v_principalid AND permissiongroupid = rec.resourceid AND activeflag = 1;
          
          IF (v_isaddorremove = 'add') THEN
         
           INSERT INTO userresource
           ( userid, permissiongroupid, roleid, resourceid, activeflag, isallowed, isvisible, isenabled, old_id,  insertedby, insertedon, updatedby, updatedon)
           VALUES( v_principalid, rec.resourceid, v_roleid, NULL, 1, true, true, true, NULL, 'ADMIN', now(), 'ADMIN', now());
          
          END IF;
       --  END IF;
       END LOOP;
     
     END;
      
         SELECT tr.rolelevel INTO v_existingrolelevel FROM rolemapping rm, role r, teammemberroletype tr    
      WHERE rm.roleid = r.id and r.roletypekey = tr.roletypekey and rm.principalid = v_principalid AND rm.teamtypekey = 'LDSS' and rm.activeflag = 1 and r.activeflag=1 and tr.activeflag=1 limit 1;
      
      IF (v_existingrolelevel IS NULL OR v_existingrolelevel >= v_rolelevel) THEN
       UPDATE rolemapping 
       SET activeflag=0, updatedon = now(), updatedby = 'ADMIN'
       WHERE principalid = v_principalid AND teamtypekey = 'LDSS' and activeflag = 1;
       
       IF (v_isaddorremove = 'add') THEN
       
        INSERT INTO rolemapping (principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id, teamtypekey) 
        values ('USER', v_principalid, v_roleid, 1, 'ADMIN','ADMIN', now(), now(),'','LDSS'); 
        v_message:= 'Role added Sucessfully';

       ELSE IF (v_isaddorremove = 'remove') THEN
       
          SELECT DISTINCT ur.roleid INTO v_nextroleid FROM userresource ur, role r, teammemberroletype tr 
       WHERE ur.userid = v_principalid AND ur.activeflag=1 AND ur.isallowed = true AND ur.isvisible = true AND ur.isenabled = true
       AND ur.roleid = r.id AND r.roletypekey = tr.roletypekey AND r.activeflag=1 AND tr.activeflag=1 and tr.teamtypekey = 'LDSS'
       ORDER BY tr.rolelevel LIMIT 1;                      
          
       IF v_nextroleid IS NOT NULL THEN
       
         INSERT INTO rolemapping (principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id, teamtypekey) 
         values ('USER', v_principalid, v_nextroleid, 1, 'ADMIN','ADMIN', now(), now(),'','LDSS'); 
         v_message:= 'Role Removed Sucessfully';
        
        END IF;
        
       END IF;
      END IF; 
      END IF;
      
       SELECT r.roletypekey INTO v_finalroletypekey FROM rolemapping rm, role r 
       WHERE rm.roleid = r.id AND rm.activeflag=1 AND rm.teamtypekey = 'LDSS' AND rm.principalid = v_principalid AND r.activeflag = 1;
      
     ELSE

     BEGIN
      FOR rec IN (SELECT * FROM role_resource WHERE activeflag=1 AND roleid = v_roleid)
      
       LOOP
      --   IF rec IS NOT NULL THEN
          UPDATE userresource 
          SET activeflag =0, isallowed = false, isvisible = false, isenabled = false, updatedon = now(), updatedby = 'ADMIN'
          WHERE userid = v_principalid AND permissiongroupid = rec.resourceid AND activeflag = 1;
          
           IF (v_isaddorremove = 'add') THEN

           INSERT INTO userresource
           ( userid, permissiongroupid, roleid, resourceid, activeflag, isallowed, isvisible, isenabled, old_id,  insertedby, insertedon, updatedby, updatedon)
           VALUES( v_principalid, rec.resourceid, v_roleid, NULL, 1, true, true, true, NULL, 'ADMIN', now(), 'ADMIN', now());
          
          END IF;
       --  END IF;
       END LOOP;
     
     END;
      
         SELECT tr.rolelevel INTO v_existingrolelevel FROM rolemapping rm, role r, teammemberroletype tr    
      WHERE rm.roleid = r.id and r.roletypekey = tr.roletypekey and rm.principalid = v_principalid AND rm.teamtypekey = v_agencycode and rm.activeflag = 1 and r.activeflag=1 and tr.activeflag=1 limit 1;
      
      IF (v_existingrolelevel IS NULL OR v_existingrolelevel >= v_rolelevel) THEN
       UPDATE rolemapping 
       SET activeflag=0, updatedon = now(), updatedby = 'ADMIN'
       WHERE principalid = v_principalid AND teamtypekey = v_agencycode and activeflag = 1;
       
        
       IF (v_isaddorremove = 'add') THEN
       
        INSERT INTO rolemapping (principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id, teamtypekey) 
        values ('USER', v_principalid, v_roleid, 1, 'ADMIN','ADMIN', now(), now(),'',v_agencycode); 
        v_message:= 'Role added Sucessfully';

       ELSE IF (v_isaddorremove = 'remove') THEN
       
          SELECT DISTINCT ur.roleid INTO v_nextroleid FROM userresource ur, role r, teammemberroletype tr 
       WHERE ur.userid = v_principalid AND ur.activeflag=1 AND ur.isallowed = true AND ur.isvisible = true AND ur.isenabled = true
       AND ur.roleid = r.id AND r.roletypekey = tr.roletypekey AND r.activeflag=1 AND tr.activeflag=1 and tr.teamtypekey = v_agencycode
       ORDER BY tr.rolelevel LIMIT 1;                      
          
       IF v_nextroleid IS NOT NULL THEN
       
         INSERT INTO rolemapping (principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon, old_id, teamtypekey) 
         values ('USER', v_principalid, v_nextroleid, 1, 'ADMIN','ADMIN', now(), now(),'',v_agencycode); 
         v_message:= 'Role Removed Sucessfully';
        
        END IF;
        
       END IF;
      END IF; 
     END IF;
     
      SELECT r.roletypekey INTO v_finalroletypekey FROM rolemapping rm, role r 
      WHERE rm.roleid = r.id AND rm.activeflag=1 AND rm.teamtypekey = v_agencycode AND rm.principalid = v_principalid AND r.activeflag = 1;
      
     END IF; 
      END IF;  
    
     end if;
     
    END IF;
  
  IF (v_supervisorid IS NOT NULL) THEN
     UPDATE userprofile
     SET supervisorid = v_supervisorid, primarycountycd = v_statecountycode, updatedon = now(), updatedby = 'ADMIN'
     WHERE securityusersid = v_securityusersid and activeflag=1;
     v_message:= 'Supervisor Updated Sucessfully';
        END IF;
    
  IF (v_agencycode = 'AS' AND v_assupervisorid IS NOT NULL) THEN
     UPDATE userprofile
     SET assupervisorid = v_assupervisorid, primarycountycd = v_statecountycode, updatedon = now(), updatedby = 'ADMIN'
     WHERE securityusersid = v_securityusersid and activeflag=1;
     v_message:= 'AS Supervisor Updated Sucessfully';
        END IF;
    
  
  IF (v_finalroletypekey IS NOT NULL AND v_finalroletypekey != '' AND v_agencycode IS NOT NULL AND v_agencycode IN ('CW','AS','FNS','IV-E')) THEN 
    
    SELECT teamid  INTO v_teamid FROM team WHERE teamnumber = v_teamnumber AND activeflag = 1 LIMIT 1;
    
  
  IF (v_teamid IS NULL) THEN
   
   SELECT countyid INTO v_countyid 
    FROM county  WHERE statecountycode = v_statecountycode and activeflag = 1;
    
   INSERT INTO team(teamid,
     activeflag, teamname, teamnumber, teamtypekey, description, 
     officetimingfrom, officetimingto, parentteamid, insertedby, insertedon, updatedby, 
     updatedon, effectivedate,  region, regionid, countyid, supervisorid)
    VALUES (gen_random_uuid(),
     1, v_teamname, v_teamnumber, v_agencycode, v_teamname, 
     '08:00:00'::time without time zone, '16:00:00'::time without time zone, v_countyid::character varying, 'ADMIN', now(), 'ADMIN', 
     now(), now(), 0, null, v_countyid::character varying, null) returning teamid into v_teamid;
     
  END IF;
   
  INSERT INTO teammember (teammemberid, activeflag, teamid, loadnumber, roletypekey, 
    positioncode, description, isoncall, insertedby, insertedon, 
    updatedby, updatedon, effectivedate, rtfdate, coadate, isdefaultroute)
   VALUES (gen_random_uuid(), 1, v_teamid, v_loadnumber, v_finalroletypekey ,
    v_positioncode, '', true, '', now(), 
    'ADMIN',  now(),  now(), now(), now(), 1)  returning teammemberid into v_teammemberid; 
    
  IF (v_agencycode = 'AS') THEN   
      SELECT teammemberassignmentid INTO v_teammemberassignmentid FROM as_teammemberassignment where securityusersid = v_securityusersid and activeflag=1;
   
   IF (v_teammemberassignmentid IS NOT NULL) THEN
  
    UPDATE as_teammemberassignment 
    SET teammemberid = v_teammemberid, activeflag = 1, updatedon=now(), updatedby='ADMIN'
    WHERE teammemberassignmentid = v_teammemberassignmentid;
    
      ELSE 
  
    INSERT INTO as_teammemberassignment(teammemberassignmentid, activeflag, teammemberid, securityusersid, insertedby, insertedon, updatedby, updatedon, effectivedate) 
    VALUES (gen_random_uuid(), 1, v_teammemberid, v_securityusersid, 'ADMIN', now(), 'ADMIN', now(), now());

          END IF; 
  ELSE 
            SELECT teammemberassignmentid INTO v_teammemberassignmentid FROM teammemberassignment where securityusersid = v_securityusersid and activeflag=1;
   
   IF (v_teammemberassignmentid IS NOT NULL) THEN
   
    UPDATE teammemberassignment 
    SET teammemberid = v_teammemberid, activeflag = 1, updatedon=now(), updatedby='ADMIN'
    WHERE teammemberassignmentid = v_teammemberassignmentid;
    
     ELSE 
  
    INSERT INTO teammemberassignment(teammemberassignmentid, activeflag, teammemberid, securityusersid, insertedby, insertedon, updatedby, updatedon, effectivedate) 
    VALUES (gen_random_uuid(), 1, v_teammemberid, v_securityusersid, 'ADMIN', now(), 'ADMIN', now(), now());

          END IF; 
     END IF;
             
  v_message:= 'Team updated successfully';
 
    
 END IF;
 END IF;
  return v_message;
END;

$function$

