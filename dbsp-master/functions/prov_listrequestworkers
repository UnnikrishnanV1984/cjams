CREATE OR REPLACE FUNCTION prov_listrequestworkers(v_request_id character varying)
 RETURNS TABLE(workerdetails jsonb)
 LANGUAGE plpgsql
AS $function$
declare

begin 

return query 

select (select jsonb_agg(a) from (select distinct mu.username,split_part(r.description,',',1) as userrole,split_part(r.description,',',2) as agencykey,mu.email,u.phonenumber as staffcell,mcfs.objectid as userid
 from muser mu
 left join userprofilephonenumber u  on u.securityusersid = mu.securityusersid
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
join prov_monitoring_entrance_conf_staff mcfs on  mu.securityusersid::character varying = mcfs.objectid::character varying  and mcfs.delete_sw = 'N'
where mcfs.request_id = v_request_id )a) as workerdetails;

        
END;
$function$

