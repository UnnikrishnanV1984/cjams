CREATE OR REPLACE FUNCTION prov_getprovideruirdetails(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT PU.provider_uir_id, PU.uir_no, PU.provider_id, PU.site_id as licence_type, PU.site_id, tpl.licensing_agency_cd, PU.level_supervision, PU.location_incident,
PU.location_area, PU.location_area_other, PU.incident_datetime, PU.discovered_datetime,
 PU.narrative_before_incident, PU.narrative_incident_occur, PU.narrative_during_incident, PU.narrative_after_incident,
 PU.role_incident, PU.restraint_typekey, PU.duration_restraint, PU.duration_restraint_other,
 PU.is_de_escalation, PU.is_seen_medical, PU.is_injury_sustained,tpp.value_tx as license_agency,
 PU.injury_severity_rating, PU.is_injury_result, PU.is_seclusion, PU.duration_seclusion, PU.is_staff_assaulted,
 uir_status, notifiy_is_attach, notifiy_attach_other, notification_comments, 
 PU.notifiy_staff_member, PU.notifiy_signdatetime,PU.precipitate_event,PU.gang_related_explain,PU.gang_incident_videotapped,
 pu.gang_contraband_found,pu.gang_contraband_found_other,pu.gang_related_other,pu.gang_incident_videotapped_other,
 PU.gang_support_evidence,PB.formatted_provider_nm,rv.description as precipitate_event_name,PU.inserted_on,
 (select lastname ||', '||firstname from userprofile where securityusersid=PU.inserted_by) as displayname

FROM provider_uir PU 
left join tb_provider PB on PB.provider_id=Pu.provider_id
left join tb_provider_licensing tpl on Pu.site_id = tpl.site_id and tpl.active_sw = 'Y'
left join tb_picklist_values tpp  on trim(tpl.licensing_agency_cd) = trim(tpp.picklist_value_cd) and tpp.picklist_type_id = 111
left join referencevalues rv on rv.ref_key=PU.precipitate_event


where PU.provider_uir_id=v_provider_uir_id 


   )  a;

RETURN  jsondata;
END;

$function$

