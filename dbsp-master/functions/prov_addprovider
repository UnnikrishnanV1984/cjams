CREATE OR REPLACE FUNCTION prov_addprovider(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
 declare                                                                                                                                                                                                                                                                                                                                                                                               
 v_providerId character varying;                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying;                                                                                                                                                                                                                                                                                                                                                                   
 v_statuscode text;                                                                                                                                                                                                                                                                                                                                                                                    
 v_categorycd text;                                                                                                                                                                                                                                                                                                                                                                                    
 i json;                                                                                                                                                                                                                                                                                                                                                                                               
 v_prgram text;                                                                                                                                                                                                                                                                                                                                                                                        
 v_rcc text;                                                                                                                                                                                                                                                                                                                                                                                           
 v_cpa text;                                                                                                                                                                                                                                                                                                                                                                                          
 v_mdh text;                                                                                                                                                                                                                                                                                                                                                                                        
 v_oos text;     
 v_rtc text;  
 v_ysb text;                                                                                                                                                                                                                                                                                                                                                                                   
 v_cop text;                                                                                                                                                                                                                                                                                                                                                                                   
 v_appid character varying;                                                                                                                                                                                                                                                                                                                                                                            
 v_affiliatedproviderid int;                                                                                                                                                                                                                                                                                                                                                                           
 v_addressarr json;                                                                                                                                                                                                                                                                                                                                                                                    
 v_adrtype text;                                                                                                                                                                                                                                                                                                                                                                                       
 v_adrid uuid;                                                                                                                                                                                                                                                                                                                                                                                         
 v_adrtypecd text;
 --Finance values                                                                                                                                                                                                                                                                                                                                                                                  
 v_payToAffiliateCd TEXT;
 v_affiliate_provider_id TEXT;
 v_tax_id TEXT;
 v_pvtcounty TEXT;

 begin                                                                                                                                                                                                                                                                                                                                                                                                 
 v_providerId := insertobj->>'provider_id';                                                                                                                                                                                                                                                                                                                                                            
 v_appid := insertobj->>'applicant_id';                                                                                                                                                                                                                                                                                                                                                                
 v_securityuserid := insertobj->>'securityuserid';                                                                                                                                                                                                                                                                                                                                                     
 v_statuscode :='1791';                                                                                                                                                                                                                                                                                                                                                                                
 v_rcc := 'RCC';                                                                                                                                                                                                                                                                                                                                                                                       
 v_cpa := 'CPA';                                                                                                                                                                                                                                                                                                                                                                                        
 v_mdh := 'MDH';                                                                                                                                                                                                                                                                                                                                                                                        
 v_oos := 'OOS';
 v_rtc := 'RTC';
 v_ysb := 'YSB';
 v_cop := 'COP';
 --Finance values
 v_payToAffiliateCd := '3368';
 v_pvtcounty := '3824';
                                                                                                                                                                                                                                                                                                                                                                                                       
 Select prgram, provider_id into v_prgram , v_affiliatedproviderid from tb_provider_applicant where applicant_id = v_appid;  
 IF(v_prgram = v_rcc) then
 v_categorycd := '3274';
 END IF;                                                                                                                                                                                                                                                                                                                                                                                              
 IF(v_prgram = v_cpa) THEN                                                                                                                                                                                                                                                                                                                                                                                                  
    v_categorycd := '3302';
 END IF;                                                                                                                                                                                                                                                                                                                                                                            
 IF(v_prgram = v_mdh) THEN                                                                                                                                                                                                                                                                                                                                                                                                  
    v_categorycd := '3311';
 END IF;                                                                                                                                                                                                                                                                                                                                                                              
 IF(v_prgram = v_oos) THEN                                                                                                                                                                                                                                                                                                                                                                                                  
    v_categorycd := '3312';
 END IF;                                                                                                                                                                                                                                                                                                                                                                         
 IF(v_prgram = v_rtc) THEN                                                                                                                                                                                                                                                                                                                                                                                                  
    v_categorycd := '3794';
 END IF;                                                                                                                                                                                                                                                                                                                                                                   
 IF(v_prgram = v_ysb) THEN                                                                                                                                                                                                                                                                                                                                                                                                  
    v_categorycd := '3795';
 END IF;                                                                                                                                                                                                                                                                                                                                                            
 IF(v_prgram = v_cop) THEN                                                                                                                                                                                                                                                                                                                                                                                                  
    v_categorycd := '3796';
 END IF;
 
 IF LENGTH(v_providerId) > 1                                                                                                                                                                                                                                                                                                                                                                           
 then                                                                                                                                                                                                                                                                                                                                                                                                  

 SELECT provider_id INTO v_affiliate_provider_id FROM tb_provider_applicant tpa WHERE applicant_id = v_appid;
 
 SELECT tax_id_no INTO v_tax_id FROM tb_provider WHERE provider_id = v_affiliate_provider_id;

                                                                                                                                                                                                                                                                                                                                                                                                   
 INSERT INTO tb_provider(provider_id, provider_category_cd, provider_status_cd, affiliate_provider_id, 
 create_ts, create_user_id, update_ts, update_user_id, adr_email_tx , adr_cell_phone_tx, adr_fax_tx, 
 provider_first_nm , provider_last_nm , provider_nm, 
 PROV_TAX_TYPE_CD, MAIL_CODE_TX, INDICATOR_1099_SW, PAY_TO_AFFILIATE_CD, tax_id_no, county_cd)                                                                                                                                         
 select (v_providerId)::int, v_categorycd, v_statuscode , (pr.provider_id)::int, 
 now(),v_securityuserid, now(), v_securityuserid , pr.contact_email, pr.contact_phonenumber , pr.contact_fax ,
 LEFT(pr.contact_first_nm,20) , LEFT(pr.contact_last_nm,20) , pr.program_name,
 '2517', '000', 'N', v_payToAffiliateCd, v_tax_id::int, v_pvtcounty
 from tb_provider_applicant pr where pr.applicant_id = v_appid;                                                                               


 INSERT INTO providerassignment(
             fromworkeridno, fromsupervisoridno, toworkeridno, 
            tosupervisoridno, objecttypekey, objectid, activeflag, startdate, 
            enddate, fromteamid, toteamid, remarks, statustypekey, fromldssid, 
            toldssid, assigndate, isrestricted, assigndescription, summary, 
            insertedby, updatedby, insertedon, updatedon)
    SELECT fromworkeridno, fromsupervisoridno, toworkeridno, 
       tosupervisoridno, 'Provider', v_providerId::character varying, activeflag, startdate, 
       enddate, fromteamid, toteamid, remarks, statustypekey, fromldssid, 
       toldssid, assigndate, isrestricted, assigndescription, summary, 
       insertedby, updatedby, insertedon, updatedon
  FROM providerassignment where objectid = v_appid::character varying order by insertedon desc limit 1;



INSERT INTO tb_provider_picklist
( provider_id, program_id, picklist_type_id, picklist_value_cd, create_user_id, update_user_id, delete_sw, value_desc, create_ts, update_ts)
VALUES( (v_providerId)::int, NULL, 155, v_categorycd, v_securityuserid, v_securityuserid, 'N', NULL, now(), now());

 update tb_provider set provider_status_cd = v_statuscode where provider_id = v_affiliatedproviderid;                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                                                       
 update tb_provider_applicant set site_id = (v_providerId)::int where applicant_id = v_appid;                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                                       
 INSERT INTO tb_provider_addresses                                                                                                                                                                                                                                                                                                                                                                     
 (parent_key_id, adr_type_cd, adr_format_cd, adr_street_no, adr_box_no, adr_pre_dir_cd, adr_street_nm, adr_street_suffix_cd, adr_post_dir_cd, adr_unit_type_cd, adr_unit_no_tx, adr_city_nm, adr_county_cd, adr_state_cd, adr_zip5_no, adr_country_tx, adr_start_dt, adr_end_dt,adr_default_sw,create_ts, create_user_id, update_ts, update_user_id, delete_sw, adr_street_tx)                                                 
 select v_providerId, adr_type_cd, adr_format_cd, adr_street_no, adr_box_no, adr_pre_dir_cd, adr_street_nm, adr_street_suffix_cd, adr_post_dir_cd, adr_unit_type_cd, adr_unit_no_tx, adr_city_nm, adr_county_cd, adr_state_cd, adr_zip5_no, adr_country_tx, adr_start_dt, adr_end_dt,adr_default_sw,now(), v_securityuserid, now(), v_securityuserid, 'N', adr_street_tx
 FROM tb_provider_applicant_addresses pra                                                                                                                                                                                                                                                                                                                                                              
 WHERE pra.parent_key_id = v_appid;                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                                       
 return 'success';                                                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                                                                       
 else                                                                                                                                                                                                                                                                                                                                                                                                  
 return 'failure';                                                                                                                                                                                                                                                                                                                                                                                     
 end if;                                                                                                                                                                                                                                                                                                                                                                                               
 end;                                                                                                                                                                                                                                                                                                                                                                                                  
 $function$

