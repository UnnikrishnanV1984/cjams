CREATE OR REPLACE FUNCTION as_sp_county_specific_unov_fss(ad_run_dt timestamp without time zone, OUT al_sqlcode integer, OUT as_error character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$

 
------------------------------------------------------------------------
-- Vineet Tirodkar 02/09/2010 - CIS-18884 County-specific Rm_Bd Rates
-- SQL Stored Procedure
-- This procedure is for Financial Snapshot table
-- To move the data from tb_COUNTY_SPECIFIC_UNOV table to tb_COUNTY_SPECIFIC_UNOV_FSS table
-- and delete the data from tb_COUNTY_SPECIFIC_UNOV table.
-- Parameter: Run Date (To Update in FSS Table)
------------------------------------------------------------------------

DECLARE vl_sqlcode int default 0;--
DECLARE SQLCODE INT DEFAULT 0;--
DECLARE SQLSTATE CHAR(5) DEFAULT '00000';--
DECLARE vs_message_text VARCHAR(3000) DEFAULT '';--
DECLARE vs_Procedure_nm VARCHAR(100) DEFAULT 'SP_COUNTY_SPECIFIC_UNOV_FSS';--

--DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
BEGIN
    --GET DIAGNOSTICS EXCEPTION 1 vs_message_text = MESSAGE_TEXT;--
     vl_sqlcode := -1 ;--
    /* as_error := COALESCE(as_error ,'') || TO_CHAR(CURRENT_TIMESTAMP) ||'::' || vs_Procedure_nm || '.' ;--
     as_error := COALESCE(as_error ,'') || '::RO ' || 'Run Date' || ' :: ' || COALESCE(to_char(ad_run_dt),'');--
     as_error := as_error || COALESCE(vs_message_text ,'');--*/
 as_error := '';--
-- To Copy Data from tb_COUNTY_SPECIFIC_UNOV to tb_COUNTY_SPECIFIC_UNOV_FSS - START

  INSERT INTO tb_COUNTY_SPECIFIC_UNOV_FSS  
         ( COUNTY_SPECIFIC_UNOV_FSS_ID,   
           PROVIDER_ID,   
           MIN_ADR_START_DT,   
           MAX_ADR_START_DT,   
           RUN_DT,   
           CREATE_TS,   
           CREATE_USER_ID,   
           UPDATE_TS,   
           UPDATE_USER_ID,   
           DELETE_SW )  
    (    
     SELECT NEXTVAL('SQ_COUNTY_SPECIFIC_UNOV_FSS'),
   PROVIDER_ID,   
   MIN_ADR_START_DT,   
   MAX_ADR_START_DT,   
   ad_run_dt,
   CREATE_TS,   
   CREATE_USER_ID,   
   UPDATE_TS,   
   UPDATE_USER_ID,   
   DELETE_SW  
     FROM tb_COUNTY_SPECIFIC_UNOV  
     WHERE DELETE_SW = 'N' )   ;--
   
    al_sqlcode := SQLCODE;--
   IF al_sqlcode < 0 THEN
      as_error := 'Error in Transferring Data from tb_COUNTY_SPECIFIC_UNOV to tb_COUNTY_SPECIFIC_UNOV_FSS.';--
   END IF ;--
-- To Copy Data from tb_COUNTY_SPECIFIC_UNOV to tb_COUNTY_SPECIFIC_UNOV_FSS - END

-- Delete Data from tb_COUNTY_SPECIFIC_UNOV - START

   DELETE FROM tb_COUNTY_SPECIFIC_UNOV   
     WHERE DELETE_SW = 'N';--
     
    al_sqlcode := SQLCODE;--
   IF al_sqlcode < 0 THEN
       as_error := 'Error in Deleteing the Data from tb_COUNTY_SPECIFIC_UNOV.';--
   END IF ;--

-- Delete Data from tb_COUNTY_SPECIFIC_UNOV - END

END;

$function$

