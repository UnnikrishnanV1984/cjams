CREATE OR REPLACE FUNCTION as_addupdatecaseaddress(v_caseaddress json, v_securityusersid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE

 v_date     timestamp without time zone;
-- v_count    integer;
 

BEGIN
 v_date:= now();
-- v_count := 0;
 

/* SELECT COUNT(*) INTO v_count
  FROM ascaseaddress
  WHERE ascaseaddressid = (v_caseaddress ->> 'ascaseaddressid')::uuid
  AND activeflag = 1; 
 
 IF (v_count = 0) THEN */
 IF (v_caseaddress ->> 'ascaseaddressid' = '' OR v_caseaddress ->> 'ascaseaddressid' IS NULL) THEN
 
   INSERT INTO ascaseaddress(
   entitytype, 
   entitytypeid, 
   startdate, 
   enddate, 
   activeflag, 
   personaddresstypekey, 
   address, 
   address2, 
   zipcode, 
   city, 
   state, 
   country, 
   county, 
   insertedby, 
   insertedon)
  VALUES (
   'intakeservicerequest':: character varying,
   (v_caseaddress ->> 'intakeserviceid')::uuid,
   (v_caseaddress ->> 'startdate')::TIMESTAMP WITHOUT TIME ZONE,
   (v_caseaddress ->> 'enddate')::TIMESTAMP WITHOUT TIME ZONE,
   1,
   v_caseaddress ->> 'personaddresstypekey',
   v_caseaddress ->> 'address',
   v_caseaddress ->> 'address2',
   v_caseaddress ->> 'zipcode',
   v_caseaddress ->> 'city',
   v_caseaddress ->> 'state',
   COALESCE(v_caseaddress ->> 'country','USA'::character varying),
   v_caseaddress ->> 'county',
   v_securityusersid,
   v_date);
   
 ELSE
   
  UPDATE ascaseaddress SET
   startdate=(v_caseaddress ->> 'startdate')::TIMESTAMP WITHOUT TIME ZONE,
   enddate=(v_caseaddress ->> 'enddate')::TIMESTAMP WITHOUT TIME ZONE,
   personaddresstypekey = v_caseaddress ->> 'personaddresstypekey', 
   address = v_caseaddress ->> 'address', 
   address2 = v_caseaddress ->> 'address2', 
   zipcode = v_caseaddress ->> 'zipcode',  
   city = v_caseaddress ->> 'city',  
   state  = v_caseaddress ->> 'state',  
   county = v_caseaddress ->> 'county',  
      activeflag = (v_caseaddress ->> 'activeflag') :: integer, 
   updatedby=v_securityusersid,
   updatedon=v_date   
  WHERE ascaseaddressid=(v_caseaddress ->> 'ascaseaddressid')::uuid and activeflag = 1;
 END IF;
 
 RETURN 'Success';
 END;

$function$

