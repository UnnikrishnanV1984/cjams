CREATE OR REPLACE FUNCTION prov_getsitenamehistory(v_siteid character varying)
 RETURNS TABLE(site_id integer, old_site_name character varying, new_site_name character varying, create_ts character varying, createdby text)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                             
                                                                                                                                                                                           
 declare                                                                                                                                                                                   
                                                                                                                                                            
                                                                                                                                                                                           
 begin                                                                                                                                                                                     
                                                                                                                                                             
                                                                                                                                                                                           
    RETURN QUERY select sh.site_id, sh.old_site_name, sh.new_site_name,sh.create_ts,(upf.firstname||' '||upf.lastname) as createdby from sitename_history sh 
    left join userprofile upf on upf.securityusersid = sh.create_user_id 
    where sh.site_id=v_siteid and sh.delete_sw = 'N' order by create_ts desc;    

 end;                                                                                                                                                        
                                                                                                                                                                                           
 $function$

