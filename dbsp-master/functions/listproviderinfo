CREATE OR REPLACE FUNCTION listproviderinfo(p_providerid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE

v_providerdata json;

BEGIN   

select json_agg(a) from ( 

SELECT *, pp.ssnno FROM tb_provider p
 LEFT JOIN providerinfoconfig pc on p.provider_id ::character varying=pc.providerid AND pc.activeflag =1
 LEFT JOIN intakeservicerequestactor isra ON isra.intakenumber = p.provider_id ::character varying AND isra.activeflag =1
 LEFT JOIN person pp ON PP.personid = isra.personid AND pp.activeflag =1
where p.provider_id =p_providerid
) a INTO v_providerdata;



RETURN v_providerdata; 

END;

$function$

