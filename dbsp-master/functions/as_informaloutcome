CREATE OR REPLACE FUNCTION as_informaloutcome(v_intakeserviceid uuid, servicerequesttypeconfigdispositioncodeid uuid, servicerequestdispositionsubtypeconfigid uuid, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


DECLARE
lstatus character varying;
v_intakenumber character varying;
v_personid uuid;

BEGIN

select  isra.personid ,isr.intakenumber into v_personid,v_intakenumber
from intakeservicerequest isr
inner join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid and isra.activeflag =1
where isra.intakeservicerequestpersontypekey = 'Youth'  and isr.intakeserviceid = v_intakeserviceid
and isr.activeflag =1;

update focuspersoncasestatus set status = 'Closed'
Where status = 'Open' and activeflag =1 
and  intakenumber = v_intakenumber ;


Insert into focuspersoncasestatus
(personid,intakeserviceid,intakenumber,focuspersonstatustypekey,status,
startdate,enddate,activeflag,insertedon,updatedon,insertedby,updatedby)
values(v_personid,v_intakeserviceid,v_intakenumber,'CAS','Open',
    now(),null,1,now(),now(),v_securityuserid,v_securityuserid),
    (v_personid,v_intakeserviceid,v_intakenumber,'INTK','Open',
    now(),null,1,now(),now(),v_securityuserid,v_securityuserid);


select getfocuspersoncasestatusconfig into lstatus
 from as_getfocuspersoncasestatusconfig(v_personid,v_intakeserviceid,v_intakenumber, null :: character varying,servicerequesttypeconfigdispositioncodeid,servicerequestdispositionsubtypeconfigid,v_securityuserid);
 
 RETURN 'SUCCESSFUL';
 END;
 $function$

