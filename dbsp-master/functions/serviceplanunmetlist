CREATE OR REPLACE FUNCTION serviceplanunmetlist(v_objectid character varying, _page integer, _limit integer)
 RETURNS TABLE(totalcount bigint, serviceplanactivityid uuid, objecttypekey character varying, objectid character varying, activity character varying, servicetypekey character varying, need character varying, otherservicetypedescription character varying, othersubtypedescription character varying, otherreason character varying, reasontypekey character varying, servicetypedescription character varying, servicesubtypekey character varying, servicesubtypedescription character varying, serviceplanactivitystatustypekey character varying, activitysubtypekey character varying, activitysubtypedescription character varying, reasondescription character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
    _offset  integer;

begin
   
_offset := (_page - 1) * _limit; 


return query

SELECT count(1) OVER() totalcount,
a.serviceplanactivityid,  
a.objecttypekey, a.objectid,
a.activity, a.servicetypekey, a.need,a.otherservicetypedescription,a.othersubtypedescription,
a.otherreason,a.reasontypekey,
d.servicetypedescription, a.servicesubtypekey, e.servicesubtypedescription,

 a.serviceplanactivitystatustypekey,a.activitysubtypekey,rv.description as activitysubtypedescription,rv2.description as reasondescription

FROM serviceplanactivity a 

left join servicetype d on d.servicetypekey = a.servicetypekey and d.activeflag = 1
left join servicesubtype e on e.servicesubtypekey = a.servicesubtypekey and e.activeflag = 1
left join referencevalues rv on rv.ref_key=a.activitysubtypekey and rv.activeflag=1
left join referencevalues rv2 on rv2.ref_key=a.reasontypekey and rv2.activeflag=1
where a.activeflag = 1 

and a.objectid = v_objectid and a.serviceunavailable='UN'
group by a.serviceplanactivityid,  
a.objecttypekey, a.objectid,
a.activity, a.servicetypekey, a.need,a.otherservicetypedescription,a.othersubtypedescription,
a.otherreason,a.reasontypekey,
d.servicetypedescription, a.servicesubtypekey, e.servicesubtypedescription,
 a.serviceplanactivitystatustypekey,a.activitysubtypekey, activitysubtypedescription,reasondescription
order by a.insertedon desc
LIMIT _limit OFFSET _offset;

end;

$function$

