 WHERE (TTB_FMIS_MAIN.VL_OVER_18 > 5 OR TTB_FMIS_MAIN.VL_UNDER_19 > 10) AND TTB_FMIS_MAIN.VS_TEMP_PAYMENT_TYPE_CD = '6' AND TTB_FMIS_MAIN.VS_PROV_PLMT_TYPE = '1783';

