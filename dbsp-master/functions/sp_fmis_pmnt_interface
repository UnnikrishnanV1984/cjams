   DROP TABLE IF EXISTS TTB_FMIS_MAIN CASCADE;
--Temporary table for the distinct fields to be populated in 'TB_FMIS_PAYMENT_DETAIL_INTERFACE'    
CREATE TABLE TTB_FMIS_MAIN(   VN_TEMP_PROVIDER_ID INTEGER
                                                ,VS_TEMP_PAYMENT_TYPE_CD VARCHAR(4)
                                                ,VN_TEMP_PAYMENT_ID INTEGER
                                                ,VS_TEMP_MAIL_CODE_TX VARCHAR(3)
                                                ,VS_EFT_SW VARCHAR(1)
                                                ,VS_TRANSACTION_AMT VARCHAR(500)
                                                ,VS_COLLECTED_AMT VARCHAR(500)
                                                ,VS_AGENCY_OBJECT_CD VARCHAR(4)
                                                ,VN_TAX_ID INTEGER
                                                ,VS_OFFSET_FLAG CHAR(1)
                                                ,VS_TEMP_REVERSE_IND CHAR(1)
                                                ,VL_UNDER_19 INTEGER
                                                ,VL_OVER_18 INTEGER
                                                ,VS_PROV_PLMT_TYPE VARCHAR(5)
                                                ,VS_PROV_AFF  VARCHAR(5)
                                                ,VS_DIST_TYPE VARCHAR(2)
                                                ,VN_PRV_ADR_56_CNT INTEGER
                                                ,VN_PRV_ADR_57_CNT INTEGER
                                                ,VN_CURR_DOC_NBR INTEGER
                                                ,VN_CURR_DOC_SUFFIX INTEGER
                                            )  ;

if adt_rundate is null or adt_rundate = '01-01-1900' then
        adt_rundate := current_date;
else
        vd_run_date := adt_rundate;
end if;

--there is no f_daymonth/f_daymonth function to build that function waht is the logic bussiness need
/* DRVR
 prev_month_first_day  := f_daymonth(vd_run_date,' ','');--
 prev_month_last_day  :=  f_daymonth(vd_run_date,'L','');--
 */

        prev_month_first_day  := (SELECT (date_trunc('month', now()) - interval '1 month')::date);
        prev_month_last_day  :=  (SELECT (date_trunc('month', now())::date - 1));

IF DATE_PART('MONTH',(vd_run_date)) IN (1,2,3,4,5,6) THEN
         VN_APPROPRIATION_YEAR := (SELECT DATE_PART('YEAR',(vd_run_date))) ;
ELSE
         VN_APPROPRIATION_YEAR := (SELECT DATE_PART('YEAR',(vd_run_date)) + 1);
END IF;

-- no data exist in TB_FMIS_PAYMENT_DETAIL_INTERFACE
            
-- Delete the records from the parent tables if exists.
 
SELECT COUNT(*) INTO VN_DETAIL_CNT
FROM  TB_FMIS_PAYMENT_DETAIL_INTERFACE;
RAISE NOTICE 'VN_DETAIL_CNT (%)', VN_DETAIL_CNT;

IF VN_DETAIL_CNT > 0 THEN
     DELETE FROM  TB_FMIS_PAYMENT_DETAIL_INTERFACE;
