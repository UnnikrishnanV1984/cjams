 OR (TTB_FMIS_MAIN.VS_EFT_SW = 'N' AND TTB_FMIS_MAIN.VN_PRV_ADR_57_CNT > 0 AND TTB_FMIS_MAIN.VS_PROV_AFF = '3356');

