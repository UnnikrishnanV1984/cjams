        OPEN C1 FOR
        SELECT FMIS_PAYMENT_DETAIL_Record_ID
         FROM  TB_FMIS_PAYMENT_DETAIL_INTERFACE
        ORDER BY FMIS_PAYMENT_DETAIL_Record_ID;

        --OPEN C1 for execute sqlquery;
        LOOP
        FETCH C1 INTO VN_TEMP_Record_ID;
        EXIT WHEN NOT FOUND;
        WHILE (SQLCODE > 100) LOOP
        SELECT NEXTVAL('SQ_FMIS_BATCH_SEQ_N0') INTO VN_TEMP_BATCH_SEQ_NO ;-- FROM SYSIBM.SYSDUMMY1; 
            
SQLCODE := SQLCODE+1;
        al_sqlcode := SQLCODE;
        
