---------------------------Splitting logic for every 200 records ------------------------------------------
        SELECT COUNT(*) INTO VN_DTL_CNT FROM  TB_FMIS_PAYMENT_DETAIL_INTERFACE;
        al_sqlcode := SQLCODE;
        IF al_sqlcode < 0 THEN
         as_error := 'ERROR in getting record count from  TB_FMIS_PAYMENT_DETAIL_INTERFACE ';
         --GOTO ERROR_SECTION;
