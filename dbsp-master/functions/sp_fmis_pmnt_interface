INSERT INTO TTB_FMIS_MAIN(  SELECT  TBP.PROVIDER_ID
                                                   ,PH.PAYMENT_TYPE_CD
                                                   ,PH.PAYMENT_ID
                                                   ,TBP.MAIL_CODE_TX
                                                   ,TBP.EFT_SW
                                                   ,NULL
                                                   ,NULL
                                                   ,NULL
                                                   ,(SELECT COALESCE(TP.TAX_ID_NO,(select TAX_ID_NO from tb_provider
                                                                                      where provider_id = (select affiliate_provider_id from tb_provider
                                                                                                               where provider_id = TBP.PROVIDER_ID)
                                                                                   )
                                                                    ) as TAX_ID_NO  FROM TB_PROVIDER TP
                                                        WHERE TP.provider_id = TBP.PROVIDER_ID AND TP.Delete_sw = 'N'
                                                     )
                                                   ,NULL
                                                   ,NULL
                                                   ,(SELECT COUNT(CLIENT_ID) FROM  TB_PAYMENT_DETAIL
                                                      WHERE PAYMENT_ID = ph.payment_id
                                                      AND CLIENT_ID IN (SELECT CLIENT_ID FROM TB_CLIENT WHERE  F_AGE(DOB_DT) < 19 AND DELETE_SW = 'N')
                                                      AND DELETE_SW = 'N'  )
                                                   ,(SELECT COUNT(CLIENT_ID) FROM  TB_PAYMENT_DETAIL
                                                      WHERE PAYMENT_ID = ph.payment_id
                                                      AND CLIENT_ID IN (SELECT CLIENT_ID FROM TB_CLIENT WHERE  F_AGE(DOB_DT) >= 19 AND DELETE_SW = 'N')
                                                      AND DELETE_SW = 'N'  )
                                                   , F_PRVPCKLST_CAT(TBP.PROVIDER_ID,'PLACEMENT')
                                                   ,(SELECT LTRIM(RTRIM(PAY_TO_AFFILIATE_CD)) FROM TB_PROVIDER
                                                      WHERE DELETE_SW = 'N' AND PROVIDER_ID =  TBP.PROVIDER_ID)
                                          ,NULL
                                          ,(SELECT  COUNT(*) FROM TB_PROVIDER_ADDRESSES
                                                 WHERE PARENT_KEY_ID::INTEGER = TBP.PROVIDER_ID
                                    AND  ADR_DEFAULT_SW = 'Y'
                                    AND ADR_TYPE_CD = '3356' AND ADR_FORMAT_CD  = 'F'
                                    AND DELETE_SW = 'N')
                                                   ,(SELECT  COUNT(*) FROM TB_PROVIDER_ADDRESSES
                                           WHERE PARENT_KEY_ID::INTEGER = TBP.PROVIDER_ID
                                    AND  ADR_DEFAULT_SW = 'Y'
                                    AND ADR_TYPE_CD = '3357' AND ADR_FORMAT_CD  = 'F'
                                    AND DELETE_SW = 'N')
                                       ,NEXTVAL('SQ_FMIS_CURR_DOC_NBR')
                                                   ,1

                                        FROM TB_PROVIDER TBP, TB_PAYMENT_STATUS PS,  TB_PAYMENT_HEADER PH
                                        WHERE TBP.PROVIDER_ID = PH.PROVIDER_ID 
           AND PH.PAYMENT_ID = PS.PAYMENT_ID
                                          AND PH.DELETE_SW = 'N' AND PS.DELETE_SW = 'N' AND TBP.DELETE_SW = 'N'
                                          AND PS.PAYMENT_STATUS_CD = '1636' AND PH.PAYMENT_TYPE_CD  IN ('6','5689', '7') --  By DRVR this condition is changed from IN to NOT IN to just populate the data into the common table or the base tables should be populated with mock up data
                                          AND (PH.PAYMENT_START_DT <= prev_month_last_day OR PH.PAYMENT_START_DT BETWEEN prev_month_first_day AND prev_month_last_day)
                                     --DRVR AND (PH.PAYMENT_END_DT >= prev_month_first_day OR PH.PAYMENT_END_DT BETWEEN prev_month_first_day AND prev_month_last_day) -- By DRVRconditon is breaking here need to be fixed by changing the date logic or by populating the mockup data into the base tables whic can pull the data for this condition.
                                        GROUP BY TBP.PROVIDER_ID , PH.PAYMENT_TYPE_CD, PH.PAYMENT_ID, TBP.MAIL_CODE_TX, TBP.EFT_SW             
                                        ORDER BY TBP.PROVIDER_ID ,PH.PAYMENT_ID ,PH.PAYMENT_TYPE_CD);
RAISE NOTICE 'INSERTING INTO TTB_FMIS_MAIN %', (SELECT COUNT (*) FROM TTB_FMIS_MAIN) ;
-----------------------------------Transaction Amount and Collected Amount --------------------------------------
UPDATE TTB_FMIS_MAIN
   SET VS_TRANSACTION_AMT = ( SELECT SUM(FINAL_AMOUNT_NO) FROM  TB_PAYMENT_DETAIL TPD WHERE TPD.PAYMENT_ID = TTB_FMIS_MAIN.VN_TEMP_PAYMENT_ID);

-- Collected Amount if Offset is present
UPDATE TTB_FMIS_MAIN
  SET VS_COLLECTED_AMT = ( SELECT sum(rl.collected_amount_no) 
        FROM tb_receivable_offset ro , tb_receivable_liquidation rl, tb_receivable_detail rd, tb_payment_detail pd
                       WHERE ro.offset_id = rl.offset_id
                             AND rd.receivable_detail_id = rl.receivable_detail_id
            AND pd.payment_detail_id = rd.payment_detail_id
           AND ro.payment_id = TTB_FMIS_MAIN.VN_TEMP_PAYMENT_ID
           AND rl.delete_sw = 'N'
            AND pd.delete_sw = 'N'
            AND rd.delete_sw = 'N'
            AND ro.delete_sw = 'N'
            AND rl.collected_amount_no is not null )
  WHERE VS_TEMP_PAYMENT_TYPE_CD = '6';
