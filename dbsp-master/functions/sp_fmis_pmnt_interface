         as_error := 'ERROR in Updating  TB_FMIS_PAYMENT_DETAIL_INTERFACE for Constant Columns for VN_TEMP_BATCH_SEQ_NO';
         --GOTO ERROR_SECTION;
        END IF;

        FETCH C1 INTO VN_TEMP_Record_ID;

        END LOOP;

