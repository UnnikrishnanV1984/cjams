CREATE OR REPLACE FUNCTION as_sp_ive_fc_getauditperiodsinfo(al_client_id bigint, al_removal_id bigint)
 RETURNS TABLE(period character varying, period_start_dt date, period_end_dt date, period_statusjson json, period_reasonjson json, forstercareeligibilitystatus character varying, fostercareredeterminationeligibilitystatus character varying, hashkey character varying, inserttedon timestamp without time zone, transactionid uuid, initialize character varying, courtorderedremovals character varying, finalresult character varying, childbeeninfostercare12monthormorereason character varying, judicialdeterminationofrefppfirstredetermination character varying, receiptofotherbenefitsmet character varying, courtstatus character varying, removalhome character varying, removaltype character varying, demographic character varying, citizenship character varying, age character varying, deprivation character varying, assets character varying, income character varying, placement character varying, approvalstatus character varying, approvalid uuid, period_householddetails json, period_fostercareevents json, period_messages json, inputjson json)
 LANGUAGE plpgsql
AS $function$ begin return query
select
  tfa.sqnm_sw,
  tfa.start_dt,
  tfa.end_dt,
  tfa.statusjsondata,
  tfa.reasonjsondata,
  tfa.fostercareeligibilitystatus,
  tfa.fostercareredeterminationeligibilitystatus,
  tfa.hashkey,
  tfa.insertedon,
  tfa.transactionid,
  tfa.initialize,
  tfa.courtorderedremovals,
  tfa.finalresult,
  tfa.childbeeninfostercare12monthormorereason,
  tfa.judicialdeterminationofrefppfirstredetermination,
  tfa.receiptofotherbenefitsmet,
  tfa.courtstatus,
  tfa.removalhome,
  tfa.removaltype,
  tfa.demographic,
  tfa.citizenship,
  tfa.age,
  tfa.deprivation,
  tfa.assets,
  tfa.income,
  tfa.placement,
  tfa.approvalstatus,
  tfa.approvalid :: uuid,
  (
        select array_to_json(array_agg(row_to_json(d)))
        from (
        select * from tb_audit_householdmember thm where thm.auditperiodid = tfa.auditperiodid
        ) d
    ) as householdmembersdetails,
    (
        select array_to_json(array_agg(row_to_json(d)))
        from (
        select * from tb_audit_fostercareevent tafc where tafc.auditperiodid = tfa.auditperiodid
        ) d
    ) as fostercareeventsdetails,
    (
        select array_to_json(array_agg(row_to_json(d)))
        from (
        select * from fcauditperiodmessages tapm where tapm.auditperiodid = tfa.auditperiodid
        ) d
    ) as messages,
  tfa.inputjson
from
  tb_ive_fostercare_audit tfa
where
  tfa.cjamspid :: bigint = al_client_id
  and tfa.removalid :: bigint = al_removal_id
ORDER BY
  tfa.sqnm_sw desc,
  tfa.insertedon desc;
end;
$function$

