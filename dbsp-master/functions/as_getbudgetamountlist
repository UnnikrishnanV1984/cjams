CREATE OR REPLACE FUNCTION as_getbudgetamountlist(searchobj json, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

 v_countyid uuid;
 v_pagenumber int;
 v_pageoffset int;
 sortorder varchar ;
 sortcolumn varchar ;
 ls_budgetlist json;
 v_fiscalyear varchar(10);
 v_programtyperefkey varchar(10);
 v_subprogramtyperefkey varchar(10);
BEGIN 
v_countyid := searchobj ->> 'countyid';
v_fiscalyear := searchobj ->> 'fiscalyear'; 
sortorder := lower(searchobj ->> 'sortorder');
sortcolumn := lower(searchobj ->> 'sortcolumn');
v_programtyperefkey := searchobj ->> 'programtyperefkey'; 
v_subprogramtyperefkey := searchobj ->> 'subprogramtyperefkey'; 

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

   
  SELECT json_agg(e) INTO ls_budgetlist FROM(
  SELECT count(1)  over() as totalcount,
  apb.annualprogrambudgetid,
  apb.countyid, 
  apb.programtyperefkey,
  apb.subprogramtyperefkey,
  (select value_text from referencevalues where referencetypeid=3000 and trim(ref_key)=trim(apb.subprogramtyperefkey) and activeflag=1 limit 1 ) as subprogramname,
  apb.fiscalyear,
  apb.annualbudgetamount,
  apb.availableamount,
  apb.obligatedamount,
  apb.additionalbudgetamount,
  apb.creditdebitsw
from annualprogrambudget apb
join county c on c.countyid = apb.countyid
and apb.countyid=v_countyid 
AND apb.fiscalyear =v_fiscalyear
AND apb.programtyperefkey =v_programtyperefkey
and apb.subprogramtyperefkey = v_subprogramtyperefkey
order by apb.programtyperefkey)e ;
RETURN ls_budgetlist; 
 

 
END;

$function$

