CREATE OR REPLACE FUNCTION sp_ive_eligibility_worksheet_living_arrngmnt_info(reqobj json)
 RETURNS void
 LANGUAGE plpgsql
AS $function$ 

DECLARE
 v_islapsesinplacement  varchar(10);
   v_typeoflapses varchar(50);
 v_livingid uuid;
 v_living json;
BEGIN

  FOR v_living IN SELECT * FROM json_array_elements(reqobj)
  loop
   v_islapsesinplacement := v_living ->> 'islapsesinplacement'; 
   v_typeoflapses := v_living ->> 'typeoflapses'; 
   v_livingid := v_living ->> 'livingid'; 
  update livingarrangement 
  set islapsesinplacement = v_islapsesinplacement , typeoflapses = v_typeoflapses  
  where livingid = v_livingid;

  END loop;

END;
 
$function$

