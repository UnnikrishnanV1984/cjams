CREATE OR REPLACE FUNCTION as_createdynamicproviderapplicant(userdada json)
 RETURNS TABLE(d_securityusersid text)
 LANGUAGE plpgsql
AS $function$


DECLARE
v_userdata json;
v_firstname character varying;
v_lastname character varying;
v_email character varying;
D_teamid uuid;
D_teammemberid uuid;
D_Prinicpalid character varying;
D_roletypekey character varying;
D_id  int;
D_roletype character varying;
D_email int;
--memail character varying;


begin

 v_userdata:=userdada;
 v_firstname:=v_userdata ->>'firstname';
 v_lastname:=v_userdata ->>'lastname';
 v_email:=v_userdata->>'email';
 

 
 
 
 raise notice 'v_firstname --%>',v_firstname;
  
 select  roletypecode into D_roletype from roletype where roletypecode='PA';
 
 
 select  id,roletypekey into D_id,D_roletypekey from "role" where roletypekey='ASPA';
 
 
 
 select  teamid into D_teamid from team where  teamname='Provider Applicant Team';

 select count (*) into D_email from muser where email=v_email;
 
 raise notice 'D_email --%>',D_email;
 
 
 
 if(D_teamid is not null and D_email = 0 ) then
    
   

 
   INSERT INTO teammember
   (teammemberid, activeflag, teamid, loadnumber, roletypekey, positioncode, insertedby, insertedon,
   updatedby, updatedon, effectivedate, linenumber)
   values 
   (gen_random_uuid(),1,D_teamid,'222001',D_roletypekey,'222001','admin',now(),
   'admin',now(), now(),'222001') 
   RETURNING "teammemberid" into D_teammemberid;
   

   INSERT INTO userprofile(
   securityusersid, firstname, lastname, displayname, fullname, 
   activeflag,   email,    insertedby, insertedon, updatedby, updatedon,
   teamtypekey,usertypekey,autonotification,old_id,title)
   values
   (gen_random_uuid(),v_firstname,v_lastname,v_firstname||' '|| v_lastname,v_firstname||' '|| v_lastname,
   1,v_email,'admin' , now(),'admin',now(),
   'AS','DSDS',false,'man',v_firstname)
   RETURNING "securityusersid" into d_securityusersid;
  
   INSERT INTO securityusers(securityusersid, username , activeflag, insertedby, updatedby,
   
   insertedon, updatedon,old_id) 
   
   select securityusersid, displayname,  1,'admin','admin',now(),now(),'man' from userprofile 
   
   where securityusersid =d_securityusersid;
  

   INSERT INTO muser( username, password, email,  id, securityusersid,
   
   insertedby, updatedby, insertedon, updatedon, activeflag ,old_id)
   
   SELECT  displayname,'$2a$10$fwlp0MMCDZHj9wk7mNdQ6uf1hQkZXcDYiqlLZZVWK0Ic4PCcm0lyW',
   
   v_email,nextval('muser_id_seq'),d_securityusersid, 'admin' ,'admin',now(),now(),1,title from userprofile 
   where securityusersid=d_securityusersid
          RETURNING "id" into D_Prinicpalid;
   
   
   INSERT INTO as_teammemberassignment
   (teammemberassignmentid, activeflag, teammemberid, securityusersid, insertedby,
   insertedon, updatedby, updatedon, effectivedate)
   VALUES 
   (gen_random_uuid(), 1,D_teammemberid,d_securityusersid, 'admin', now(), 'admin', now(), now());
  
  
    INSERT INTO rolemapping 
   
   (id, principaltype,principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon)
   values
   ( nextval('rolemapping_id_seq'),'USER',D_Prinicpalid,D_id,1, 'admin', 'admin', now(), now());
  
   
    --select m.email into memail from muser m  where securityusersid=d_securityusersid;
  


else

 select securityusersid into d_securityusersid from muser where email=v_email;

 end if;
 
  return query select d_securityusersid;
  
  
 end ;




$function$

