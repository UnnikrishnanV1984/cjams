CREATE OR REPLACE FUNCTION as_getplacementaddress(placementadmissiontyp character varying, personidval uuid)
 RETURNS TABLE(placementid uuid, placementadmissiontypekey character varying, providerid uuid, provideraddressid uuid, provideraddresstypekey character varying, buildingno character varying, addressline1 character varying, addressline2 character varying, city character varying, state character varying, latitude character varying, longitude character varying, personid uuid)
 LANGUAGE plpgsql
AS $function$

BEGIN

  
RETURN query

select PL.placementid , PL.placementadmissiontypekey,   PL.providerid , PA.provideraddressid, 
PA.provideraddresstypekey, PA.buildingno, PA.addressline1, PA.addressline2, PA.city, PA.state, 
PA.latitude, PA.longitude, PL.personid from placement as  PL inner join provideraddress as PA ON PL.providerid = PA.providerid 
where PL.personid = personidval and PL.providerid is not null and PA.activeflag = 1 and PL.placementadmissiontypekey = placementadmissiontyp and PL.activeflag = 1;


END;

$function$

