CREATE OR REPLACE FUNCTION as_ref_val_json_temp(v_input1 character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE    
    v_result json;
   
BEGIN
  
 Select json_agg(row) as Output from 
         (select distinct ref_key as Key, value_text as Value 
           from referencevalues 
           where referencetypeid = 189 
           and ref_key in
              (select regexp_split_to_table(v_input1, ',')
                        from TEST_TABLE))row 
        into v_result;
 
 RETURN v_result;

END;  

$function$

