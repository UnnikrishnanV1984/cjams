CREATE OR REPLACE FUNCTION as_peaceorderyouthstatus()
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare 
v_intakeservice RECORD;
v_savefocuspersoncasestatus character varying;
begin
 FOR v_intakeservice IN 
  SELECT isra.personid,isr.intakeserviceid,isr.intakenumber
  FROM intakeservicerequest isr
  INNER JOIN  intakeservicerequestactor isra ON isr.intakeserviceid = isra.intakeserviceid 
  INNER JOIN intakeservicerequesttype  isrt on isr.intakeservreqtypeid = isrt.intakeservreqtypeid AND Isrt.activeflag =1  
  INNER JOIN intakeserreqstatustype iss on iss.intakeserreqstatustypeid=isr.intakeserreqstatustypeid and iss.activeflag =1
  INNER JOIN servicerequesttypeconfig SRC on SRC.intakeservreqtypeid =ISR.intakeservreqtypeid and src.activeflag=1 and src.servicerequestsubtypeid =isr.intakeservicerequestclassid
  INNER JOIN intakeservicerequestdispositioncode srdc on srdc.intakeserviceid = isr.intakeserviceid  and srdc.activeflag =1
  INNER JOIN servicerequesttypeconfigdispositioncode sdc on sdc.servicerequesttypeconfigiddispostionid = srdc.servicerequesttypeconfigiddispostionid
   and sdc.activeflag =1and sdc.dispositioncode='PORA' AND isrt.intakeservreqtypekey = 'PO' AND  lower(isra.intakeservicerequestpersontypekey) ='youth'
  WHERE  isr.activeflag=1  and iss.intakeserreqstatustypekey = 'Approved'
  and ISR.insertedon::date = now()::date - '4 day'::interval
 LOOP
 
    SELECT savefocuspersoncasestatus into v_savefocuspersoncasestatus
    FROM as_savefocuspersoncasestatus(v_intakeservice.personid,v_intakeservice.intakeserviceid,v_intakeservice.intakenumber,'PO',
    'Closed','admin', null, null);
 
 END LOOP;
        
Return 'Success'        ;

End;
$function$

