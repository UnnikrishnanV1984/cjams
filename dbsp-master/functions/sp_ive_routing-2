CREATE OR REPLACE FUNCTION sp_ive_routing(clientid character varying)
 RETURNS TABLE(childname text, client_id bigint, casenumber bigint, childagency character varying, childjurisdiction character varying, placementdate timestamp without time zone, dateofbirth timestamp without time zone, removalage text)
 LANGUAGE plpgsql
AS $function$ 
declare
v_clientid text;

begin
 v_clientid:= clientid;
 return query 
 select  concat(p.firstname, p.middlename, p.lastname) as childname , pl.client_id as client_id, pl.case_id as casenumber , 'FOSTER CARE'::character varying  as childagency, 'MD'::character varying as childjurisdiction,
to_date(pl.create_ts, 'YYYY-MM-DD') as placementdate , p.dob::date as dateofbirth , Extract('years' from  AGE(to_date(pl.create_ts, 'YYYY-MM-DD'), p.dob::date))::integer || ' Yrs' as removalage
from  (select tp.client_id, max(tp.case_id) case_id, max(tp.create_ts) create_ts from tb_placement tp where tp.approval_status_cd = '3047' and tp.client_id::text like '%' || v_clientid || '%' group by tp.client_id) pl 
  inner join person p on p.cjamspid = pl.client_id order by to_date(pl.create_ts, 'YYYY-MM-DD') desc ;


end
 $function$

