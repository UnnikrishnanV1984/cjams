CREATE OR REPLACE FUNCTION prov_deleteinvolvedperson(v_personid uuid, v_objectid character varying, v_objecttype character varying, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare _offset integer;

begin

    update actor set activeflag = 0, updatedby = v_securityusersid, updatedon = now() where personid = v_personid and objectid = v_objectid and objecttype = v_objecttype;

    update intakeservicerequestactor set activeflag = 0, updatedby = v_securityusersid, updatedon = now() where personid = v_personid and objectid = v_objectid and objecttype = v_objecttype;



    return 'SUCCESS';
end;


$function$

