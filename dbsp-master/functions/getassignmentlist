CREATE OR REPLACE FUNCTION getassignmentlist(equipment_id uuid, _limit integer, _page integer)
 RETURNS TABLE(positioncode character varying, teamname character varying, region integer, fullname character varying, effectivedate timestamp without time zone, expirationdate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$
   
BEGIN

    RETURN QUERY
 
select   tm.positioncode,t.teamname,t.region ,up.fullname,tme.effectivedate,tme.expirationdate from  TeamMemberEquipment as tme  join TeamMember  as tm on tme.teammemberid = tm.teammemberid
join team as t on t.teamid = tm.teamid and tm.activeflag = 1
join teammemberassignment as tma on  tm.teammemberid = tma.teammemberid and tma.activeflag = 1
join userprofile as up on up.securityusersid = tma.securityusersid and up.activeflag = 1
 where tme.teammemberid = tm.teammemberid
  and  tm.teamid = t.teamid 
  and  tm.teammemberid = tma.teammemberid
  and up.securityusersid = tma.securityusersid
  and equipmentid = equipment_id
group by   tm.positioncode,t.teamname,t.region ,up.fullname,tme.effectivedate,tme.expirationdate

LIMIT _limit OFFSET  (_page - 1) * _limit;

  END;
$function$

