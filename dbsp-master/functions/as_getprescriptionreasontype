CREATE OR REPLACE FUNCTION as_getprescriptionreasontype(v_teamtypekey character varying, v_prescriptionreasontypekey character varying, v_description character varying, pagenumber bigint, pagesize bigint, v_nolimit boolean DEFAULT false)
 RETURNS TABLE(ref_key character varying, description character varying, activeflag integer)
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_pageoffset int;
    v_pagenumber int;

BEGIN

 IF COALESCE(pagesize, 0) < 1 THEN                     
 pagesize := 10;
END IF;

IF COALESCE(pagenumber, 0) < 1 THEN
 pagenumber := 1; 
END IF;


 v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
   
RETURN Query
  
 SELECT  
    rv.ref_key,rv.description,rv.activeflag
 FROM referencevalues rv
 INNER JOIN referencetype rta ON rta.referencetypeid = rv.referencetypeid AND rta.activeflag =1
 WHERE rv.teamtypekey = v_teamtypekey AND rta.tablename ilike 'Medicationcodes' and rv.activeflag =1

 AND CASE WHEN v_prescriptionreasontypekey is null THEN TRUE ELSE rv.ref_key LIKE v_prescriptionreasontypekey|| '%' END
  AND CASE WHEN v_description is null THEN TRUE ELSE rv.description LIKE v_description || '%' END
 ORDER BY rv.ref_key 

LIMIT CASE WHEN v_nolimit = false  THEN pagesize END offset 
   CASE WHEN v_nolimit = false  THEN v_pageoffset END; 
    
END;

$function$

