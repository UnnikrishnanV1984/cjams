CREATE OR REPLACE FUNCTION getintakejsondata(v_intakeserviceid uuid)
 RETURNS TABLE(jsondata jsonb)
 LANGUAGE plpgsql
AS $function$

begin

 return query  
 
select IDS.jsondata
from intakeservicerequest ISR 
inner join intakedastaging IDS on IDS.intakenumber=ISR.intakenumber
where isr.activeflag=1 and IDS.activeflag=1 and ISR.intakeserviceid=v_intakeserviceid;
end;

$function$

