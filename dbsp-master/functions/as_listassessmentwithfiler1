 left join (select distinct a.assessmenttemplateid,a.persontypekey from assessment a where a.activeflag = 1) asst on asst.assessmenttemplateid = at.assessmenttemplateid
  where  atcm.intakeservicerequesttypeid = '00000000-0000-0000-0000-000000000000' 
