 RETURNS TABLE(totalcount bigint, assessmenttemplateid uuid, external_templateid character varying, isvisible boolean, duedays character varying, description text, target character varying, targetroletypekey character varying, assignedto text, intakassessment json, routinginfo json)
 LANGUAGE plpgsql
AS $function$

declare categoryid uuid;
 subcategoryid uuid;
 targetid uuid;
 agencycode character varying;
 v_intakenumber character varying;
 v_accpecteddate timestamp without time zone;
BEGIN

   if (assessmentstatus ='null'   ) then
  assessmentstatus:=null;
 end if;
   
  SELECT intakeservreqtypeid, intakeservicerequestclassid,teamtypekey,accepteddate,intakenumber into categoryid,
 subcategoryid,agencycode,v_accpecteddate,v_intakenumber  FROM intakeservicerequest where intakeserviceid=servicerequestid;

   if subcategoryid is null then
  subcategoryid:='00000000-0000-0000-0000-000000000000';
 end if;

  -- SELECT    assessmenttemplatetargetid into   targetid from assessmenttemplatetarget   where lower(target )='investigation' and activeflag =1;
RAISE NOTICE '%',categoryid ;   
IF (v_nolimit = true) THEN
RETURN QUERY  

select count(1) OVER() totalcount,* from 
   ( select  at.AssessmentTemplateId,  at.external_templateid , at.isvisible,
   case when (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate)))< 0 then 0 else (coalesce(at.duedays,0)- (extract (day from now() -  v_accpecteddate))) end :: character varying,
  cast(at.titleheadertext as text)    as description
,ATT.target ,at.targetroletypekey,(select up.firstname||' '|| up.lastname as fullname from assignedassessment aas
 join userprofile up on up.securityusersid = aas.securityusersid and up.activeflag=1
 where aas.assessmenttemplateid=at.AssessmentTemplateId  and aas.intakeserviceid =servicerequestid and aas.activeflag=1 limit 1
 ) as assignedto,(select * from as_getassessmentdetails(servicerequestid :: character varying,At.assessmenttemplateid,true,v_roletypecode,v_persontypekey)) as intakassessment,

 (SELECT json_agg(e) as routinginfo 
    from (select  UP.lastname ||','|| up.firstname as fromusername,  
  upto.lastname ||','|| upto.firstname as tousername,
   RT.roletypename as fromrole,  RT1.roletypename as torole,case R.routingstatustypeid when 4 then 'Assigned' 
   else  RST.routingstatustypekey  end routingstatustypekey,R.insertedon as routedon,upa.address,usp.phonenumber,up.title,
