  inner join roletype rtt on rtt.shortname = rt.name ) RT on R.fromroleid = RT.roletypekey
  inner join (select rt.*, rtt.roletypename from role  RT
  inner join roletype rtt on rtt.shortname = rt.name ) RT1 on R.toroleid = RT1.roletypekey
  
  where R.objectid in (v_intakenumber,servicerequestid::character varying)
  order by r.updatedon asc  )e) 
      from AssessmentTemplate at inner join  AssessmentTemplateCategoryFilterMap  atcm on at.AssessmentTemplateId =atcm.AssessmentTemplateId   
