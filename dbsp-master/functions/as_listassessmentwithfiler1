   on isr.intakeservreqtypeid=isrt.intakeservreqtypeid where isr.intakeserviceid=servicerequestid
   and isr.activeflag=1 limit 1)
   from  routing R 
  inner join routingstatustype RST on RST.sequencenumber = R.routingstatustypeid
  inner join  userprofile UP on UP.securityusersid = R.fromsecurityusersid 
  inner join userprofile upto on upto.securityusersid = r.tosecurityusersid
  left join userprofileaddress upa on upa.securityusersid=up.securityusersid
  left join userprofilephonenumber usp on usp.securityusersid=up.securityusersid
