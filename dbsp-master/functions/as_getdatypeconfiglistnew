CREATE OR REPLACE FUNCTION as_getdatypeconfiglistnew(page integer, size integer, searchcol character varying, searchval character varying, sortcol character varying, sortby character varying)
 RETURNS TABLE(totalcount bigint, category character varying, limitedrouting boolean, effectivedate timestamp without time zone, subtype character varying, expirationdate timestamp without time zone, focusroletype character varying, workload_basis integer, internalfile boolean, datype character varying, duedateoffset integer, activeflag integer, intakeservreqtypekey character varying, plantype character varying, insertedon timestamp without time zone, servicerequesttypeconfigid uuid)
 LANGUAGE plpgsql
AS $function$

 
 
DECLARE searchstring character varying;
DECLARE totalcount integer;
v_pagenumber int;
BEGIN
v_pagenumber := (page-1)*   size;
 searchstring:='';
 if(searchcol!='' and  searchval !='' ) then
        if (searchcol='datype') then searchcol:= ' B.description '; end if;
          if (searchcol='subtype') then searchcol:= ' C.classkey  '; end if;
          if (searchcol='workload_basis') then searchcol:= ' A.workLoad  '; end if;
          if (searchcol='plantype') then searchcol:= '  A.intakeservicerequestplantypekey  '; end if;
         
   searchstring:='  lower( cast('|| searchcol   || ' as character varying)) like ''' || lower(searchval) || '%'' AND'; 
    END IF;
 
 RAISE NOTICE 'order_by % ', searchstring;
 

RETURN QUERY
 execute 'SELECT 
   count(1) over(),
        A.category,
        A.limitedrouting,
        A.effectivedate,
        C.classkey AS subtype,
        A.expirationdate,
        COALESCE(A.workLoad,0) AS workload_basis,
        A.internalfile,
          B.description AS datype,
        A.duedateoffset,
        A.activeFlag,
        B.intakeservreqtypekey ,
        A.intakeservicerequestplantypekey as plantype,
          A.insertedon,
        A.servicerequesttypeconfigid
     
  
FROM servicerequesttypeconfig A 
INNER JOIN intakeservicerequesttype B on B.intakeservreqtypeid = A.IntakeServReqTypeId
Inner Join servicerequestsubtype C on C.servicerequestsubtypeid = A.servicerequestsubtypeid
left outer JOIN servicerequesttypeconfigrole G on G.servicerequesttypeconfigid = A.servicerequesttypeconfigid
where ' || searchstring || ' A.ActiveFlag=1 ' 
'group by A.servicerequesttypeconfigid,
      
          B.intakeservreqtypekey,
 C.classkey,
         A.intakeservicerequestplantypekey,
         A.workLoad,
         A.internalfile,
         A.duedateoffset,
         A.limitedrouting,
         A.effectivedate,
         A.expirationdate,
         A.category,
         A.activeFlag,
         B.description
         ORDER BY  ' || sortcol || ' ' ||  sortby
        ||' LIMIT ' || size ||'  OFFSET ' || v_pagenumber ;
         
 

END; 

$function$

