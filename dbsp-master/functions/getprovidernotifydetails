CREATE OR REPLACE FUNCTION getprovidernotifydetails(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT PU.provider_uir_id,PU.notifiy_is_attach,PU.notifiy_attach_other,PU.notification_comments,
PU.notifiy_staff_member,PU.notifiy_signdatetime,
 
      
       (SELECT  json_agg(notification) as notification  FROM(
      SELECT PUN.* 
FROM provider_uir_notification PUN where PUN.provider_uir_id= PU.provider_uir_id and PUN.active_flag=1
    )
                                      as notification    )::json   


FROM provider_uir PU
where PU.provider_uir_id=v_provider_uir_id and PU.active_flag=1

   )  a;

RETURN  jsondata;
END;

$function$

