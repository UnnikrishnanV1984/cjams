CREATE OR REPLACE FUNCTION prov_addupdatetraininginstructor(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
 declare                                                                                                                                                                                                                                                                                                                                                                                               
   
    v_instructorid character varying; 

 begin                                                                                                                                                                                                                                                                                                                                                                                                 

v_instructorid:=insertobj->>'instructor_id';

update providertraininginstructor set delete_sw='Y', active_flag=0 where instructor_id =v_instructorid::uuid;
return 'Success' ;                                                                                                                                                                                                                                                                                                                                                                                       
 end;                                                                                                                                                                                                                                                                                                                                                                                                  
 $function$

