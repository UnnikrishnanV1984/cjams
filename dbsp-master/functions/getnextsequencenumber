CREATE OR REPLACE FUNCTION getnextsequencenumber(v_seqid character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                         
DECLARE                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                          
v_nextval integer; 
v_seqname character varying;                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                          
BEGIN        
    
    select nextval(''||v_seqid||'') into v_nextval;
    raise notice '%', v_nextval;
    return v_nextval;

end;
$function$

