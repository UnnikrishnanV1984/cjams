CREATE OR REPLACE FUNCTION sp_adoption_aca_info(al_client_id bigint, al_removal_id bigint)
 RETURNS TABLE(client_id bigint, childjurisdiction character varying, childagency character varying, childname character varying, servicecaseid uuid, casenumber character varying, childbirthdate timestamp without time zone, ivestatus character varying, ivecomment character varying, expectedadoptiondate timestamp without time zone, hasthechildbeenincare60monthsormore character varying, issiblingtochildwhoqualifiesasapplchildbyage character varying, acourtorder character varying, removalcourtorderdate timestamp without time zone, dateoffirstcourtorderwithctw timestamp without time zone, bavoluntaryplacementagreement character varying, childremovaldate timestamp without time zone, dtof1stcowithbiorctwfindingifconvtocina timestamp without time zone, voluntaryrelinquishment character varying, dateofrelinquishment timestamp without time zone, childmeetsssimedicaldisabledeligliblerequirements character varying, childreceivingssiatremoval character varying, startdateofreceivingssi timestamp without time zone, isthechildresidinginafosterfamilyhome character varying, physicaladdressofchild character varying, canchildreturntohome character varying, descriptionofreturnhome text, childmeetallmedicaldisabilityrequirementsforssi character varying, child617yearsofage boolean, physicalmentalemotionaldisability boolean, emotionaldisturbance boolean, siblinginformationcheck boolean, recognizedhighriskofphysicaldisability boolean, raceethnicityofchild boolean, unsuccessfulreasonableeffortsstatusrecords character varying, unsuccessfulreasonableeffortsstatusrecordsdescription character varying, fosterparentemotionalbonding character varying, fosterparentemotionalbondingdescription character varying, childspreviouslyadopted character varying, childsivestatusofpreviousadoption character varying, previousadoptiveparentstpr character varying, adoptiveparentstprdate timestamp without time zone, childscurrentivefostercareeligibilitystatus character varying, childsssieligibilitystatus character varying, caseworkername character varying, submissiondate timestamp without time zone, resubmissioncaseworkername character varying, resubmissiondate timestamp without time zone, childagetable1618 boolean, childagetable418 boolean, childagetable1418 boolean, childagetable218 boolean, childagetable1218 boolean, childagetable018 boolean, childagetable1018 boolean, childagetable218dublicate boolean, childagetable818 boolean, childagetable018dublicate boolean, childagetable618 boolean, resubmissioncount integer, childagetablechildagenoneoftheagesapply boolean, siblingsinfo json, decisionresubmissionspecalistname character varying, raceorethnicitywithoneofthesabove character varying, minorparentinfo json, adoptionapplicabilitystartdt timestamp without time zone, eligiblesiblingsinfo json, childagetable character varying, caseworkersignature character varying, resubmissioncaseworkersignature character varying)
 LANGUAGE plpgsql
AS $function$
--------------------------------------------------------------------------------------------------------------
--- CDM-20318 - 03-21 - changed type VARCHAR to TEXT IN adoptioninitialeligibilityinfo  Table

--------------------------------------------------------------------------------------------------------------
DECLARE 
  vs_Procedure_nm             VARCHAR(100) DEFAULT 'sp_adoption_eligibility_worksheet_info';  
  vn_srv_req_id             UUID;
  vs_srv_req_no             VARCHAR(50);
  vd_birth_dt              TIMESTAMP;
  vs_jrsdctn              VARCHAR(50);
  vs_chd_agcy              VARCHAR(50);
        vs_chd_nm                                                       VARCHAR(50);
  vd_exp_adp_dt             TIMESTAMP;
  vd_childagetable            VARCHAR;
  vd_childagetable1618           BOOLEAN;
  vd_childagetable418            BOOLEAN;
  vd_childagetable1418           BOOLEAN;
  vd_childagetable218            BOOLEAN;
  vd_childagetable1218           BOOLEAN;
  vd_childagetable018            BOOLEAN;
  vd_childagetable1018           BOOLEAN;
  vd_childagetable218dublicate         BOOLEAN;
  vd_childagetable818            BOOLEAN;
  vd_childagetable018dublicate         BOOLEAN;
  vd_childagetable618            BOOLEAN;
  vd_childagetablechildagenoneoftheagesapply      BOOLEAN;
  vd_issiblingtochildwhoqualifiesasapplchildbyage     VARCHAR;
  vd_acourtorder             VARCHAR;
  vd_bavoluntaryplacementagreement        VARCHAR;
  vd_voluntaryrelinquishment                       VARCHAR;
  vd_isthechildresidinginafosterfamilyhome       VARCHAR;
  vd_canchildreturntohome           VARCHAR;
  vd_descriptionofreturnhome           TEXT;
  vd_childmeetallmedicaldisabilityrequirementsforssi     VARCHAR;
  vd_child617yearsofage            boolean;
  vd_physicalmentalemotionaldisability        boolean;
  vd_emotionaldisturbance           boolean;
  vd_siblinginformationcheck           boolean;
  vd_recognizedhighriskofphysicaldisability       boolean;
  vd_raceethnicityofchild            boolean;
  vd_unsuccessfulreasonableeffortsstatusrecords      varchar;
  vd_fosterparentemotionalbonding         varchar;
  vd_childspreviouslyadopted           varchar;
  vd_previousadoptiveparentstpr          varchar;
  vd_adoptiveparentstprdate           timestamp;
  vd_childscurrentivefostercareeligibilitystatus      varchar;
  vd_childsssieligibilitystatus          varchar;
  vd_childhasemotionaldisturbance         varchar;
  vd_removalcourtorderdate           timestamp;
  vd_dateoffirstcourtorderwithctw         timestamp;
  vd_childremovaldate            timestamp;
  vd_dtof1stcowithbiorctwfindingifconvtocina       timestamp;
  vd_dateofrelinquishment           timestamp;
  vd_startdateofreceivingssi           timestamp;
  vd_physicaladdressofchild           varchar;
  vd_unsuccessfulrestatusrecordsdesc         varchar;
  vd_fosterparentemotionalbondingdesc        varchar;
  vd_childsivestatusofprevadpt          varchar;
  vd_columns2save             boolean;
  vd_caseworkername             varchar;
  vd_submissiondate             timestamp;
  vd_caseworkersignature            varchar;
  vd_resubmissioncaseworkername          varchar;
  vd_resubmissiondate            timestamp;
  vd_resubmissioncaseworkersignature         varchar;
  vd_resubmissioncount            integer;
  vd_ivestatus              varchar;
  vd_ivecomment              varchar;
  vd_childbeenincare_60monthsormore        VARCHAR(5);
  vd_childmeetsssimedicaldisabledeligliblerequirements            VARCHAR(5);
        vd_childreceivingssiatremoval                                   VARCHAR(5);
  plc                record;
  vd_enddate              TIMESTAMP;
  vd_adp_ainfo_count            INTEGER;
  vd_no_of_days_fc            INTEGER DEFAULT 0;
  vd_siblingsinfo             json;
  vd_decisionresubmissionspecalistname       VARCHAR;
  vd_raceorethnicitywithoneofthesabove        text;
  vd_minorparentinfo             json;
  vd_adoptionapplicabilitystartdt         timestamp;
  vd_eligiblesiblingsinfo           json;
  
 BEGIN  
CREATE TEMP TABLE IF NOT EXISTS
Temp_adoption_eligibility_worksheet_info ( 
  client_id               BIGINT,
  childjurisdiction            VARCHAR(50),
  childagency              VARCHAR(50),
        childname                                                       VARCHAR(50),
  servicecaseid             UUID,
  casenumber              VARCHAR(50),
  childbirthdate             timestamp,
       ivestatus                varchar,
        ivecomment               varchar,
       expectedadoptiondate            TIMESTAMP,
       hasthechildbeenincare60monthsormore        varchar,
       issiblingtochildwhoqualifiesasapplchildbyage      varchar,
       acourtorder              varchar,
       removalcourtorderdate            TIMESTAMP,
  dateoffirstcourtorderwithctw           TIMESTAMP,
  bavoluntaryplacementagreement          VARCHAR,
  childremovaldate                                                TIMESTAMP,
  dtof1stcowithbiorctwfindingifconvtocina       TIMESTAMP,
  voluntaryrelinquishment           VARCHAR,
  dateofrelinquishment             TIMESTAMP,
  childmeetsssimedicaldisabledeligliblerequirements        VARCHAR,
  childreceivingssiatremoval           VARCHAR,
  startdateofreceivingssi           TIMESTAMP,
  isthechildresidinginafosterfamilyhome        VARCHAR,
  physicaladdressofchild            VARCHAR,
  canchildreturntohome            VARCHAR,
  descriptionofreturnhome           TEXT,
  childmeetallmedicaldisabilityrequirementsforssi     VARCHAR,
  child617yearsofage                                              BOOLEAN,
  physicalmentalemotionaldisability          BOOLEAN,
  emotionaldisturbance            BOOLEAN,
  siblinginformationcheck           BOOLEAN,
  recognizedhighriskofphysicaldisability       BOOLEAN,
  raceethnicityofchild           BOOLEAN,
  unsuccessfulreasonableeffortsstatusrecords       VARCHAR,
  unsuccessfulreasonableeffortsstatusrecordsdescription    VARCHAR,
  fosterparentemotionalbonding          VARCHAR,
  fosterparentemotionalbondingdescription       VARCHAR,
  childspreviouslyadopted           VARCHAR,
  childsivestatusofpreviousadoption        VARCHAR,
  previousadoptiveparentstpr          VARCHAR,
  adoptiveparentstprdate            TIMESTAMP,
  childscurrentivefostercareeligibilitystatus      VARCHAR,
  childsssieligibilitystatus           VARCHAR,
  caseworkername              VARCHAR,
  submissiondate              TIMESTAMP,
  resubmissioncaseworkername           VARCHAR,
  resubmissiondate            TIMESTAMP,
  childagetable1618             BOOLEAN,
  childagetable418            BOOLEAN,
  childagetable1418            BOOLEAN,
  childagetable218            BOOLEAN,
  childagetable1218            BOOLEAN,
  childagetable018            BOOLEAN,
  childagetable1018            BOOLEAN,
  childagetable218dublicate          BOOLEAN,
  childagetable818            BOOLEAN,
  childagetable018dublicate          BOOLEAN,
  childagetable618            BOOLEAN,
  resubmissioncount            INTEGER,
  childagetablechildagenoneoftheagesapply       BOOLEAN,
  siblingsinfo             json,
  decisionresubmissionspecalistname                               VARCHAR,
  raceorethnicitywithoneofthesabove        VARCHAR,
  minorparentinfo             json,
  adoptionapplicabilitystartdt         timestamp,
  eligiblesiblingsinfo           json,
  childagetable             VARCHAR
 ); 

select count(*) into vd_adp_ainfo_count from adoptionapplicabilityinfo where clientid = al_client_id and removalid = al_removal_id and activeflag = 1;

-- Service Case ID  , Case Number , person dob
SELECT sc.servicecaseid, sc.servicecasenumber, per.dob , concat(per.firstname, ' ', per.middlename, ' ', per.lastname)
 INTO vn_srv_req_id, vs_srv_req_no, vd_birth_dt, vs_chd_nm
 FROM servicecase sc
 inner join intakeservicerequestactor isra on isra.servicecaseid = sc.servicecaseid
 inner join person per on per.personid = isra.personid
 inner join placement plt on plt.servicecaseid = sc.servicecaseid
 inner join intakeservreqchildremoval isrcr on isrcr.intakeservreqchildremovalid = plt.intakeservreqchildremovalid
WHERE 
 isra.intakeservicerequestpersontypekey = 'CHILD' 
 AND per.cjamspid::BIGINT =  al_client_id and isrcr.removalid = al_removal_id and per.activeflag = 1 order by sc.updatedon limit 1;

select c.countyname INTO vs_jrsdctn 
 from caseassignment ca 
 join servicecase sc on ca.objectid = sc.servicecaseid 
 join intakeservreqchildremoval isrcr on isrcr.servicecaseid = sc.servicecaseid  
 join county c on c.countyid = ca.toldssid and c.activeflag =1
 where isrcr.removalid::bigint = al_removal_id and ca.enddate is null order by ca.insertedon desc
 limit 1;

-- Child Agency
SELECT (CASE WHEN teamtypekey = 'CW' THEN
    'DHS'::VARCHAR 
   WHEN teamtypekey = 'DJS' THEN
    'DJS'::VARCHAR
   ELSE NULL END)
 INTO vs_chd_agcy  
 FROM intakeservicerequest isr, permanencyplan pp, intakeservicerequestactor isra, person per 
WHERE pp.servicecaseid = isr.servicecaseid AND pp.activeflag = 1
 AND isra.intakeservicerequestactorid = pp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 limit 1;

IF vd_adp_ainfo_count > 0 THEN

 SELECT  adpi.childbirthdate, adpi.expectedadoptiondate, adpi.childagetable1618, adpi.childagetable418, adpi.childagetable1418, adpi.childagetable218, adpi.childagetable1218, adpi.childagetable018, adpi.childagetable1018, adpi.childagetable218dublicate, adpi.childagetable818, adpi.childagetable018dublicate, adpi.childagetable618, 
   adpi.childagetablechildagenoneoftheagesapply, adpi.hasthechildbeenincare60monthsormore::varchar, adpi.issiblingtochildwhoqualifiesasapplchildbyage::varchar, adpi.acourtorder::varchar, adpi.bavoluntaryplacementagreement::varchar, adpi.voluntaryrelinquishment::varchar, adpi.childmeetsssimedicaldisabledeligliblerequirements::varchar, adpi.isthechildresidinginafosterfamilyhome::varchar, adpi.canchildreturntohome::varchar, 
   adpi.descriptionofreturnhome:: text, adpi.childmeetallmedicaldisabilityrequirementsforssi::varchar, adpi.child617yearsofage, adpi.physicalmentalemotionaldisability, adpi.emotionaldisturbance, adpi.siblinginformationcheck, adpi.recognizedhighriskofphysicaldisability, adpi.raceethnicityofchild, adpi.unsuccessfulreasonableeffortsstatusrecords::varchar, adpi.fosterparentemotionalbonding::varchar, adpi.childspreviouslyadopted::varchar,
   adpi.previousadoptiveparentstpr::varchar, adpi.adoptiveparentstprdate, adpi.childscurrentivefostercareeligibilitystatus::varchar, adpi.childsssieligibilitystatus::varchar, adpi.childreceivingssiatremoval::varchar, adpi.childhasemotionaldisturbance::varchar, adpi.removalcourtorderdate, adpi.dateoffirstcourtorderwithctw, adpi.childremovaldate, adpi.dtof1stcowithbiorctwfindingifconvtocina, adpi.dateofrelinquishment, 
   adpi.startdateofreceivingssi, adpi.physicaladdressofchild::varchar, adpi.unsuccessfulreasonableeffortsstatusrecordsdescription::varchar, adpi.fosterparentemotionalbondingdescription::varchar, adpi.childsivestatusofpreviousadoption::varchar, adpi.columns2save, adpi.caseworkername::varchar, adpi.submissiondate, adpi.caseworkersignature::varchar, adpi.resubmissioncaseworkername::varchar, adpi.resubmissiondate,
   adpi.resubmissioncaseworkersignature::varchar, adpi.resubmissioncount, adpi.ivestatus::varchar, adpi.ivecomment::varchar, adpi.raceorethnicitywithoneofthesabove::varchar, adpi.adoptionapplicabilitystartdt, adpi.eligiblesiblingsinfo, adpi.childagetable
 into  vd_birth_dt, vd_exp_adp_dt, vd_childagetable1618, vd_childagetable418, vd_childagetable1418, vd_childagetable218, vd_childagetable1218, vd_childagetable018, vd_childagetable1018, vd_childagetable218dublicate, vd_childagetable818, vd_childagetable018dublicate, vd_childagetable618, vd_childagetablechildagenoneoftheagesapply, vd_childbeenincare_60monthsormore, 
   vd_issiblingtochildwhoqualifiesasapplchildbyage, vd_acourtorder, vd_bavoluntaryplacementagreement, vd_voluntaryrelinquishment, vd_childmeetsssimedicaldisabledeligliblerequirements, vd_isthechildresidinginafosterfamilyhome, vd_canchildreturntohome, vd_descriptionofreturnhome, vd_childmeetallmedicaldisabilityrequirementsforssi, vd_child617yearsofage, 
   vd_physicalmentalemotionaldisability, vd_emotionaldisturbance, vd_siblinginformationcheck, vd_recognizedhighriskofphysicaldisability, vd_raceethnicityofchild, vd_unsuccessfulreasonableeffortsstatusrecords, vd_fosterparentemotionalbonding, vd_childspreviouslyadopted, vd_previousadoptiveparentstpr, vd_adoptiveparentstprdate, vd_childscurrentivefostercareeligibilitystatus, 
   vd_childsssieligibilitystatus, vd_childreceivingssiatremoval, vd_childhasemotionaldisturbance, vd_removalcourtorderdate, vd_dateoffirstcourtorderwithctw, vd_childremovaldate, vd_dtof1stcowithbiorctwfindingifconvtocina, vd_dateofrelinquishment, vd_startdateofreceivingssi, vd_physicaladdressofchild, vd_unsuccessfulrestatusrecordsdesc, vd_fosterparentemotionalbondingdesc, 
   vd_childsivestatusofprevadpt, vd_columns2save, vd_caseworkername, vd_submissiondate, vd_caseworkersignature, vd_resubmissioncaseworkername, vd_resubmissiondate, vd_resubmissioncaseworkersignature, vd_resubmissioncount, vd_ivestatus, vd_ivecomment, vd_raceorethnicitywithoneofthesabove, vd_adoptionapplicabilitystartdt, vd_eligiblesiblingsinfo, vd_childagetable
  
 from adoptionapplicabilityinfo adpi where adpi.clientid = al_client_id and adpi.removalid = al_removal_id and adpi.activeflag = 1;

 select  tiaa.decisionresubmissionspecalistname::varchar into vd_decisionresubmissionspecalistname from tb_ive_adoption_audit tiaa where tiaa.category = 'A' and tiaa.cjamspid = al_client_id order by  tiaa.insertedon desc limit 1;
 
 IF vd_eligiblesiblingsinfo::jsonb = '[]'::jsonb THEN

 SELECT 
 Json_agg(e) into vd_eligiblesiblingsinfo
 FROM 
 (select distinct(tiaa2.cjamspid), concat(p.firstname, ' ', p.lastname) as nameofsiblingchild, tiaa2.childexpectedadoptiveproviderid as siblingproviderid, 
        (case when tiaa2.adoptionfinalizationdate is not null then tiaa2.adoptionfinalizationdate else (select tiaa3.adoptionfinalizationdate from tb_ive_adoption_audit tiaa3 where tiaa3.cjamspid = p.cjamspid and tiaa3.adoptionfinalizationdate is not null order by tiaa3.insertedon limit 1) end) as dateofsiblingsadoptiondecree ,
        (select tiaa4.decisionsubmissiondate from tb_ive_adoption_audit tiaa4 where tiaa4.cjamspid = p.cjamspid and tiaa4.decisionsubmissiondate is not null order by tiaa4.updatedon desc limit 1) as dateofsiblingsapplicablechildassessment,
        (select a2.dateofadoptionfinalization from adoptioninitialeligibilityinfo a2 
  inner join tb_ive_adoption_audit tvia on tvia.clientid = a2.clientid 
  where a2.bioclientid = p.cjamspid and tvia.adoptionassistance not in ('Incomplete') order by tvia.updatedon desc limit 1) as dtofsiblingsadoptiondecree,
  (select a2.nameofadoptiveparent1 from adoptioninitialeligibilityinfo a2 
  inner join tb_ive_adoption_audit tvia on tvia.clientid = a2.clientid 
  where a2.bioclientid = p.cjamspid and tvia.adoptionassistance not in ('Incomplete') order by tvia.updatedon desc limit 1) as adpsiblingname,
        (select tvia.adoptionassistance from adoptioninitialeligibilityinfo a2 
  inner join tb_ive_adoption_audit tvia on tvia.clientid = a2.clientid 
  where a2.bioclientid = p.cjamspid and tvia.adoptionassistance not in ('Incomplete') order by tvia.updatedon desc limit 1) as siblingadoptionstatus
  FROM 
  (select max(tiaa.adoptionauditid) as adoptionauditid , tiaa.cjamspid from tb_ive_adoption_audit tiaa
    --join tb_client_eligibility tce on tce.client_id = tiaa.cjamspid and tce.eligibility_type_cd = '2934' and trim(tce.eligibility_status_cd) in ('2913')
    join person p2 on tiaa.cjamspid = p2.cjamspid 
    join actorrelationship ar on p2.personid = ar.person1id and ar.activeflag = 1 and ar.relationshiptypekey in ('BGSISTR','BIOBR','HLFSISTR','HLFBR')
    join person p on ar.person2id = p.personid 
    join intakeservicerequestactor isra1 on isra1.personid = p.personid
    join permanencyplan pp1 on pp1.intakeservicerequestactorid = isra1.intakeservicerequestactorid and pp1.activeflag = 1
    where p.cjamspid  = al_client_id group by tiaa.cjamspid ) as TIAA 
  INNER JOIN tb_ive_adoption_audit tiaa2 on TIAA.adoptionauditid = tiaa2.adoptionauditid
  INNER JOIN person p on p.cjamspid = tiaa2.cjamspid 
 ) AS e; 

 END IF;

 SELECT 
 Json_agg(e) into vd_siblingsinfo
 FROM 
 (
  select asi.* from adoptionapplicabilitysiblinginfo asi 
  join adoptionapplicabilityinfo aai on asi.adoptionapplicabilityid = aai.adoptionapplicabilityid where aai.clientid = al_client_id and aai.removalid = al_removal_id  
 ) AS e; 
  
    IF vd_siblingsinfo is null THEN
 
 SELECT 
 Json_agg(e) into vd_siblingsinfo
 FROM 
 ( 
  select  distinct(tiaa2.cjamspid), concat(p.firstname, ' ', p.lastname) as nameofsiblingchild,
   (case when TIAA.relationshiptypekey = 'BIOBR' then 'Biological Brother'
   when TIAA.relationshiptypekey = 'HLFSISTR' then 'Half Sister'
   when TIAA.relationshiptypekey = 'HLFBR' then 'Half Brother'
   else 'Biological Sister' end) as siblingsrelationshipwithchild, 
   tiaa2.finalresult as childssiblingsapplicabilitystatus, 
   (case when tiaa2.adoptionfinalizationdate is not null then tiaa2.adoptionfinalizationdate else (select tiaa3.adoptionfinalizationdate from tb_ive_adoption_audit tiaa3 where tiaa3.cjamspid = p.cjamspid and tiaa3.adoptionfinalizationdate is not null order by tiaa3.insertedon limit 1) end) as dateofsiblingsadoptiondecree ,
            (select tiaa4.decisionsubmissiondate from tb_ive_adoption_audit tiaa4 where tiaa4.cjamspid = p.cjamspid and tiaa4.decisionsubmissiondate is not null order by tiaa4.updatedon desc limit 1) as dateofsiblingsapplicablechildassessment,
            tiaa2.childexpectedadoptiveproviderid as expectedchildadoptiveplacement,
      (select concat(tbpr.provider_first_nm , ' ', tbpr.provider_last_nm) from tb_provider tbpr where tbpr.provider_id = tiaa2.childexpectedadoptiveproviderid) as nameofsiblingchildsadoptiveplacement
  FROM 
  (select max(tiaa.adoptionauditid) as adoptionauditid , tiaa.cjamspid, ar.relationshiptypekey from tb_ive_adoption_audit tiaa
    join person p2 on tiaa.cjamspid = p2.cjamspid 
    join adoptionapplicabilityinfo aai on aai.clientid = tiaa.cjamspid and aai.removalid = tiaa.removalid 
    join actorrelationship ar on p2.personid = ar.person1id and ar.activeflag = 1 and ar.relationshiptypekey in ('BGSISTR','BIOBR','HLFSISTR','HLFBR')
    join person p on ar.person2id = p.personid 
    join intakeservicerequestactor isra1 on isra1.personid = p.personid
    join permanencyplan pp1 on pp1.intakeservicerequestactorid = isra1.intakeservicerequestactorid and pp1.activeflag = 1
    where tiaa.category = 'A' and p.cjamspid  = al_client_id group by tiaa.cjamspid, ar.relationshiptypekey) as TIAA 
  INNER JOIN tb_ive_adoption_audit tiaa2 on TIAA.adoptionauditid = tiaa2.adoptionauditid
  INNER JOIN person p on p.cjamspid = tiaa2.cjamspid 
 ) AS e; 

 END IF;

    -- issiblingtochildwhoqualifiesasapplchildbyage value needs to be populated from adoptionapplicabilityinfo table
 -- IF vd_siblingsinfo is not null THEN
 --  vd_issiblingtochildwhoqualifiesasapplchildbyage = 'YES';
 -- ELSE 
 --  vd_issiblingtochildwhoqualifiesasapplchildbyage = 'NO';
 -- END IF;

 SELECT 
 Json_agg(e) into vd_minorparentinfo
 FROM 
 (
  select asi.* from adoptionapplicabilityminorparentinfo asi 
  join adoptionapplicabilityinfo aai on asi.adoptionapplicabilityid = aai.adoptionapplicabilityid where aai.clientid = al_client_id and aai.removalid = al_removal_id  
 ) AS e; 

ELSE
 vd_adoptionapplicabilitystartdt = now();

 for plc in
  select 
  tp.startdatetime::date , tp.enddatetime::date 
  from placement tp 
  join intakeservreqchildremoval isrcr on isrcr.intakeservreqchildremovalid = tp.intakeservreqchildremovalid 
  where isrcr.removalid::bigint = al_removal_id
 loop
 if (plc.enddatetime is null) then
 vd_enddate = now();
 else 
 vd_enddate = plc.enddatetime;
 END if;

 vd_no_of_days_fc = vd_no_of_days_fc + EXTRACT(year FROM age(vd_enddate,plc.startdatetime)) * 12  + EXTRACT(month FROM age(vd_enddate,plc.startdatetime));

 end loop;

 IF(vd_no_of_days_fc > 60) 
 then
 vd_childbeenincare_60monthsormore = 'YES';
 ELSE
 vd_childbeenincare_60monthsormore = 'NO';
 END IF;

-- Child Removal Date, Removal Court Order Date
 SELECT  dateoffindingctwdecision, case when typeofremoval = 'Court_Order' then childphysicalremovaldate else null end , vparemovaldate,
 case when typeofremoval = 'Court_Order' then 'YES' else 'NO' end, 
 case when typeofremoval = 'Voluntary_Placement_Agreement' then 'YES' else 'NO' end  INTO vd_dateoffirstcourtorderwithctw, vd_removalcourtorderdate, vd_childremovaldate, vd_acourtorder, vd_bavoluntaryplacementagreement
 FROM  tb_ive_fostercare_audit tifa
 WHERE  tifa.cjamspid = al_client_id and tifa.removalid = al_removal_id and tifa.sqnm_sw = 'I' and (dateoffindingctwdecision is not null or vparemovaldate  is not null) order by tifa.insertedon desc limit 1;

 SELECT case when dateofbestinterestfinding is not null then dateofbestinterestfinding else dateoffindingctwdecision end 
 INTO vd_dtof1stcowithbiorctwfindingifconvtocina
 FROM  tb_ive_fostercare_audit tifa
 WHERE  tifa.cjamspid = al_client_id and tifa.removalid = al_removal_id and tifa.sqnm_sw = 'R1' and tifa.typeofremoval = 'Voluntary_Placement_Agreement' order by tifa.insertedon desc limit 1;

-- relinquishment
 select (case when volrelinquishment = 1 then 'YES' else 'NO' end)    
 into vd_voluntaryrelinquishment
 from intakeservreqchildremoval isrcr join intakeservicerequestactor isra on isrcr.intakeservicerequestactorid = isra.intakeservicerequestactorid
 join person per on per.personid = isra.personid
 where isrcr.removalid = al_removal_id AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;  
 
 -- childreceivingssiorssa
 -- SSI eligibility from IVE
 vd_childreceivingssiatremoval = NULL; 
 SELECT ( CASE WHEN (isd.childreceivingssiorssa = 1) THEN 'YES'::VARCHAR WHEN (isd.childreceivingssiorssa = 0) THEN 'NO'::VARCHAR ELSE NULL END)
  INTO vd_childreceivingssiatremoval
  FROM ivessissadata isd    
 WHERE isd.clientid::BIGINT = al_client_id AND isd.removalid::BIGINT = al_removal_id order by isd.detperiodtype desc;

 IF(vd_childreceivingssiatremoval = 'YES') THEN
  select peri.startdate into vd_startdateofreceivingssi from personincome peri 
   join person p on p.personid = peri.personid 
  where peri.incomesourcetypekey = '26' and p.cjamspid = al_client_id and peri.activeflag = 1 order by peri.startdate asc limit 1;
 END IF;

 --canchildreturnhome --description
 select 'NO' , concat('TPR Granted on Court Ordered Date – ', to_char(isrco.courtorderdate,'MM/dd/yyyy'))::text into vd_canchildreturntohome, vd_descriptionofreturnhome
 from  intakeservreqcourtorder isrco 
  join intakeservreqcohearingoutcome isrho on isrho.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid and isrho.hearingoutcometypekey = 'TPRGRA' and isrho.activeflag = 1
  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid
  join person p on p.personid = isra.personid 
 WHERE isrco.servicecaseid = vn_srv_req_id and p.cjamspid = al_client_id;

 select (CASE WHEN ap.isnoeffort = 1 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END) , regexp_replace(ap.remarks, '<[^>]*>', '', 'g'),
   (CASE WHEN ae.isfosterparents = 1 THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END), regexp_replace(ae.notes, '<[^>]*>', '', 'g')
   into vd_unsuccessfulreasonableeffortsstatusrecords, vd_unsuccessfulrestatusrecordsdesc, vd_fosterparentemotionalbonding, vd_fosterparentemotionalbondingdesc
 FROM adoptionplanning ap 
  inner join adoptionemotional ae on ae.adoptionplanningid = ap.adoptionplanningid and ae.activeflag = 1
  INNER JOIN intakeservicerequestactor isra ON isra.intakeservicerequestactorid = ap.intakeservicerequestactorid 
  inner join person p on p.personid = isra.personid 
 WHERE p.cjamspid = al_client_id and ap.servicecaseid = vn_srv_req_id and ap.activeflag =1;

 select (case when eligibility_status_cd in (2913) then 'YES' else 'NO' end) into vd_childspreviouslyadopted
 from tb_client_eligibility tce where tce.eligibility_type_cd = '2934' and tce.client_id = al_client_id;

 select (case when trim(tce.eligibility_status_cd) in ('2912', '2913') then 'YES' else 'NO' end) into vd_childscurrentivefostercareeligibilitystatus  
 from tb_client_eligibility tce
 where tce.client_id = al_client_id and tce.eligibility_type_cd = '2931' limit 1;

 SELECT 
 Json_agg(e) into vd_siblingsinfo
 FROM 
 (
  select  distinct(tiaa2.cjamspid), concat(p.firstname, ' ', p.lastname) as nameofsiblingchild,
   (case when TIAA.relationshiptypekey = 'BIOBR' then 'Biological Brother'
   when TIAA.relationshiptypekey = 'HLFSISTR' then 'Half Sister'
   when TIAA.relationshiptypekey = 'HLFBR' then 'Half Brother'
   else 'Biological Sister' end) as siblingsrelationshipwithchild, 
   tiaa2.finalresult as childssiblingsapplicabilitystatus, 
   (case when tiaa2.adoptionfinalizationdate is not null then tiaa2.adoptionfinalizationdate else (select tiaa3.adoptionfinalizationdate from tb_ive_adoption_audit tiaa3 where tiaa3.cjamspid = p.cjamspid and tiaa3.adoptionfinalizationdate is not null order by tiaa3.insertedon limit 1) end) as dateofsiblingsadoptiondecree ,
            (select tiaa4.decisionsubmissiondate from tb_ive_adoption_audit tiaa4 where tiaa4.cjamspid = p.cjamspid and tiaa4.decisionsubmissiondate is not null order by tiaa4.updatedon desc limit 1) as dateofsiblingsapplicablechildassessment,
            tiaa2.childexpectedadoptiveproviderid as expectedchildadoptiveplacement,
      (select concat(tbpr.provider_first_nm , ' ', tbpr.provider_last_nm) from tb_provider tbpr where tbpr.provider_id = tiaa2.childexpectedadoptiveproviderid) as nameofsiblingchildsadoptiveplacement 
  FROM 
  (select max(tiaa.adoptionauditid) as adoptionauditid , tiaa.cjamspid, ar.relationshiptypekey from tb_ive_adoption_audit tiaa
    join person p2 on tiaa.cjamspid = p2.cjamspid 
    join adoptionapplicabilityinfo aai on aai.clientid = tiaa.cjamspid and aai.removalid = tiaa.removalid 
    join actorrelationship ar on p2.personid = ar.person1id and ar.activeflag = 1 and ar.relationshiptypekey in ('BGSISTR','BIOBR','HLFSISTR','HLFBR')
    join person p on ar.person2id = p.personid 
    join intakeservicerequestactor isra1 on isra1.personid = p.personid
    join permanencyplan pp1 on pp1.intakeservicerequestactorid = isra1.intakeservicerequestactorid and pp1.activeflag = 1
    where tiaa.category = 'A' and p.cjamspid  = al_client_id group by tiaa.cjamspid, ar.relationshiptypekey) as TIAA 
  INNER JOIN tb_ive_adoption_audit tiaa2 on TIAA.adoptionauditid = tiaa2.adoptionauditid
  INNER JOIN person p on p.cjamspid = tiaa2.cjamspid 
 ) AS e; 

 IF vd_siblingsinfo is not null THEN
  vd_issiblingtochildwhoqualifiesasapplchildbyage = 'YES';
 ELSE 
  vd_issiblingtochildwhoqualifiesasapplchildbyage = 'NO';
 END IF;

 SELECT 
 Json_agg(e) into vd_minorparentinfo
 FROM 
 (
 select  concat(p.firstname, ' ', p.lastname) as minorparentname, p.dob as birthdateofparent, (case when isrcr.removaltypekey in ('JD') then 'Court' when isrcr.removaltypekey in ( 'TLV', 'CDVP', 'EHA') then 'VPA' else null end) as removaltypeofminorparent, 
   (case when isrcr.removaltypekey in ('JD') then isrcr.removaldate else null end) as removalcourtorderdateofminorparent, (case when isrcr.removaltypekey in ('TLV', 'CDVP', 'EHA') then isrcr.removaldate else null end) as removaldateofminorparent,
   (case when plt.providerorganizationid is null then 'FosterFamilyHome' when plt.service_id in (11405, 11406,11407,11408, 12, 76, 78) then 'RTC' else 'GroupHome' end) as minorparentscurrentplacementtype, 
   (case when plt2.providerorganizationid is null then 'FosterFamilyHome' when plt2.service_id in (11405, 11406,11407,11408, 12, 76, 78) then 'RTC' else 'GroupHome' end) as childscurrentplacementtype, 
   (case when plt.placementtypekey = 'LA' then 
    (select concat(TRIM(lva.streettext), ' ' , lva.streetname, ' ' , INITCAP(lva.streetsuffixtypekey), ',' , lva.cityname, ',' , lva.statetypekey, '-' ,lva.zip5no)::character varying 
    from livingarrangement lva where lva.placementid = plt.placementid limit 1)
   when plt.placementtypekey = 'PRPL' then 
    (select ( CAST
    (TRIM(COALESCE(tpa.adr_street_tx::VARCHAR,''))||' '|| TRIM(COALESCE(tpa.adr_street_nm,'')) ||' '||TRIM(COALESCE(tpa.adr_city_nm,'')) ||' '||
    TRIM(COALESCE(tpa.adr_state_cd,'')) ||' '||TRIM(COALESCE(tpa.adr_zip5_no::VARCHAR,'')) 
    AS CHARACTER VARYING )) from tb_provider tp inner join tb_provider_addresses tpa on tpa.delete_sw = 'N' AND tpa.adr_default_sw = 'Y'  AND tp.provider_id = tpa.parent_key_id::int4
    where plt.altproviderid = tp.provider_id AND tp.delete_sw = 'N' limit 1)
   else null End) as physicaladdressofminorparent,
   p.cjamspid as minorparentclientid, (case when tpv.description_tx is not null then 'YES' else 'NO' end) as istheminorparentreceivingivefc, 
   tpv.description_tx as minorparentivefostercarestatus, tce.start_dt as minorparentivefostercarestartdate,
   (select tpd.final_service_start_dt  from tb_payment_detail tpd where tpd.placement_id is not null and left(tpd.final_fiscal_category_cd, 2) = 21 and tpd.draft_fiscal_category_cd is null 
   and tpd.client_id = p.cjamspid order by tpd.final_service_start_dt desc limit 1) as dateoflatestpaymentofminorparentivefostercare,
   (case when plt2.placementtypekey = 'LA' then 
    (select concat(TRIM(lva.streettext), ' ' , lva.streetname, ' ' , INITCAP(lva.streetsuffixtypekey), ',' , lva.cityname, ',' , lva.statetypekey, '-' ,lva.zip5no)::character varying 
    from livingarrangement lva where lva.placementid = plt2.placementid limit 1)
   when plt2.placementtypekey = 'PRPL' then 
    (select ( CAST
    (TRIM(COALESCE(tpa.adr_street_tx::VARCHAR,''))||' '|| TRIM(COALESCE(tpa.adr_street_nm,'')) ||' '||TRIM(COALESCE(tpa.adr_city_nm,'')) ||' '||
    TRIM(COALESCE(tpa.adr_state_cd,'')) ||' '||TRIM(COALESCE(tpa.adr_zip5_no::VARCHAR,'')) 
    AS CHARACTER VARYING )) from tb_provider tp inner join tb_provider_addresses tpa on tpa.delete_sw = 'N' AND tpa.adr_default_sw = 'Y'  AND tp.provider_id = tpa.parent_key_id::int4
    where plt2.altproviderid = tp.provider_id AND tp.delete_sw = 'N' limit 1)
   else null End) as physicaladdressofchild
 from person p2 
  JOIN actorrelationship ar on p2.personid = ar.person2id and ar.activeflag = 1 and ar.relationshiptypekey = 'BGMTHR'
  JOIN person p on ar.person1id = p.personid 
  JOIN intakeservicerequestactor isra on isra.personid = p.personid
  JOIN intakeservreqchildremoval isrcr on isrcr.intakeservicerequestactorid = isra.intakeservicerequestactorid 
  join placement plt on plt.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid and plt.activeflag = 1 and plt.enddatetime is null
  JOIN intakeservicerequestactor isra2 on isra2.personid = p2.personid
  JOIN intakeservreqchildremoval isrcr2 on isrcr2.intakeservicerequestactorid = isra2.intakeservicerequestactorid 
  join placement plt2 on plt2.intakeservreqchildremovalid = isrcr2.intakeservreqchildremovalid and plt2.activeflag = 1 and plt2.enddatetime is null
  left join tb_client_eligibility tce on tce.client_id = p.cjamspid and tce.eligibility_type_cd = '2931' and trim(tce.eligibility_status_cd) != '2909'
  left join tb_picklist_values tpv on trim(tpv.picklist_value_cd) = trim(tce.eligibility_status_cd) and tpv.picklist_type_id = 262
  where f_age(vd_adoptionapplicabilitystartdt,p.dob) < 18 and p2.cjamspid = al_client_id and isrcr.removaltypekey in ('JD', 'TLV', 'CDVP', 'EHA') and plt2.altproviderid = plt.altproviderid
   order by isrcr.removaldate Desc limit 1 
 ) AS e; 

 IF vd_minorparentinfo is not null THEN
  vd_isthechildresidinginafosterfamilyhome = 'YES';
 ELSE 
  vd_isthechildresidinginafosterfamilyhome = 'NO';
 END IF;

 SELECT 
 Json_agg(e) into vd_eligiblesiblingsinfo
 FROM 
 (
      select distinct(tiaa2.cjamspid), concat(p.firstname, ' ', p.lastname) as nameofsiblingchild, tiaa2.childexpectedadoptiveproviderid as siblingproviderid, 
        (case when tiaa2.adoptionfinalizationdate is not null then tiaa2.adoptionfinalizationdate else (select tiaa3.adoptionfinalizationdate from tb_ive_adoption_audit tiaa3 where tiaa3.cjamspid = p.cjamspid and tiaa3.adoptionfinalizationdate is not null order by tiaa3.insertedon limit 1) end) as dateofsiblingsadoptiondecree ,
        (select tiaa4.decisionsubmissiondate from tb_ive_adoption_audit tiaa4 where tiaa4.cjamspid = p.cjamspid and tiaa4.decisionsubmissiondate is not null order by tiaa4.updatedon desc limit 1) as dateofsiblingsapplicablechildassessment,
        (select a2.dateofadoptionfinalization from adoptioninitialeligibilityinfo a2 
  inner join tb_ive_adoption_audit tvia on tvia.clientid = a2.clientid 
  where a2.bioclientid = p.cjamspid and tvia.adoptionassistance not in ('Incomplete') order by tvia.updatedon desc limit 1) as dtofsiblingsadoptiondecree,
  (select a2.nameofadoptiveparent1 from adoptioninitialeligibilityinfo a2 
  inner join tb_ive_adoption_audit tvia on tvia.clientid = a2.clientid 
  where a2.bioclientid = p.cjamspid and tvia.adoptionassistance not in ('Incomplete') order by tvia.updatedon desc limit 1) as adpsiblingname,
        (select tvia.adoptionassistance from adoptioninitialeligibilityinfo a2 
  inner join tb_ive_adoption_audit tvia on tvia.clientid = a2.clientid 
  where a2.bioclientid = p.cjamspid and tvia.adoptionassistance not in ('Incomplete') order by tvia.updatedon desc limit 1) as siblingadoptionstatus
  FROM 
  (select max(tiaa.adoptionauditid) as adoptionauditid , tiaa.cjamspid from tb_ive_adoption_audit tiaa
    --join tb_client_eligibility tce on tce.client_id = tiaa.cjamspid and tce.eligibility_type_cd = '2934' and trim(tce.eligibility_status_cd) in ('2913')
    join person p2 on tiaa.cjamspid = p2.cjamspid 
    join actorrelationship ar on p2.personid = ar.person1id and ar.activeflag = 1 and ar.relationshiptypekey in ('BGSISTR','BIOBR','HLFSISTR','HLFBR')
    join person p on ar.person2id = p.personid 
    join intakeservicerequestactor isra1 on isra1.personid = p.personid
    join permanencyplan pp1 on pp1.intakeservicerequestactorid = isra1.intakeservicerequestactorid and pp1.activeflag = 1
    where p.cjamspid  = al_client_id group by tiaa.cjamspid ) as TIAA 
  INNER JOIN tb_ive_adoption_audit tiaa2 on TIAA.adoptionauditid = tiaa2.adoptionauditid
  INNER JOIN person p on p.cjamspid = tiaa2.cjamspid 
 ) AS e; 

 IF vd_eligiblesiblingsinfo is not null THEN
  vd_siblinginformationcheck = true;
 ELSE 
  vd_siblinginformationcheck = false;
 END IF; 

END IF;   

