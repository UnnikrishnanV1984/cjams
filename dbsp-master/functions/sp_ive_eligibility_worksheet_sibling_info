CREATE OR REPLACE FUNCTION sp_ive_eligibility_worksheet_sibling_info(reqobj json)
 RETURNS TABLE(v_clientid bigint, v_specifiedrelativeclientid bigint, v_specifiedrelativedatechildlastlivedwith timestamp without time zone, v_specifiedrelativename character varying, v_specifiedrelativephysicaladdress character varying, v_specifiedrelativerelationshipid integer, v_specifiedrelativeid uuid)
 LANGUAGE plpgsql
AS $function$ 

DECLARE
 v_clientid  BIGINT;
 returnStatus text;
 v_num INT;
 v_siblingclientid BIGINT;
    v_siblingguardianid BIGINT;
    v_siblingclientname varchar(100);
    v_siblingguardianname varchar(100);   
    v_siblinggapeligibility VARCHAR(100);
    v_ivesiblinginfoid UUID;
   
BEGIN

 v_clientid := reqObj ->> 'clientId';
 v_siblingclientid := reqObj ->> 'siblingclientid';
 v_siblingguardianid := reqObj ->> 'siblingguardianid';
 v_siblingclientname := reqObj ->> 'siblingclientname';
 v_siblingguardianname := reqObj ->> 'siblingguardianname';
 v_siblinggapeligibility := reqObj ->> 'siblinggapeligibility';
 returnStatus := 'Success';
 
 SELECT count(*) into v_num FROM ivesiblinginfo WHERE toclientid = v_clientid;

 IF (v_num) >= 1
 THEN
   UPDATE ivesiblinginfo 
 SET  
  siblingclientid = v_siblingclientid,
        siblingguardianid = v_siblingguardianid,
        siblingclientname = v_siblingclientname,
        siblingguardianname = v_siblingguardianname,
        siblinggapeligibility = v_siblinggapeligibility
 WHERE toclientid = v_clientid;
  
 else
  
  Insert into ivesiblinginfo(ivesiblinginfoid, toclientid, activeflag, siblingclientid, siblingguardianid, siblingclientname, siblingguardianname, siblinggapeligibility, insertedby, insertedon, updatedby, updatedon) 
        VALUES(gen_random_uuid() , v_clientid, 1, v_siblingclientid, v_siblingguardianid, v_siblingclientname, v_siblingguardianname, v_siblinggapeligibility, 'Admin', now(), 'Admin', now());
                      
 end if;

RETURN QUERY
select

isi.toclientid             as v_clientid,
isi.siblingclientid           as v_siblingclientid,
isi.siblingguardianid          as v_siblingguardianid,
isi.siblingclientname          as v_siblingclientname,
isi.siblingguardianname          as v_siblingguardianname,
isi.siblinggapeligibility         as v_siblinggapeligibility,
isi.ivesiblinginfoid          as v_ivesiblinginfoid

from ivesiblinginfo isi
where isi.toclientid = v_clientid;
--RETURN format('%s', returnStatus);

end;
 
$function$

