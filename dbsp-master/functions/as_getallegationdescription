CREATE OR REPLACE FUNCTION as_getallegationdescription(jsondata json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
returnstatus text;
j json;
j_evaluation json;
j_allegedoffense json;
intval int;
allegationname text;
begin

intval:=0;



  j_allegedoffense := jsondata;
            
  For j in Select * from json_array_elements(j_allegedoffense)
      LOOP

                    select name INTO allegationname from allegation where allegationid= cast(j ->> 'allegationid' as uuid);

                     IF (intval = 0) then 
                     returnstatus:=allegationname;
                     ELSE
                     returnstatus:=concat(returnstatus,',',allegationname);
       END IF;
        intval:=intval+1;   
     
      END LOOP;
      

return returnstatus;
end;
$function$

