CREATE OR REPLACE FUNCTION as_addnotes(v_intakenumber character varying, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE  

v_intakeservice record;
v_contractrole record;

 
BEGIN

FOR  v_intakeservice IN SELECT * FROM intakeservicerequest 
      WHERE intakenumber = v_intakenumber and activeflag =1
LOOP   
   
     
     INSERT INTO progressnote (progressnotetypeid, title, description, entitytype, 
         entitytypeid, insertedby, updatedby, progressnotesubtypeid,
         contactdate, contactname, progressnotetypekey, activeflag, 
            stafftypekey, instantresults, contactstatus, drugscreen, 
         progressnotepurposetypekey,notesid )
   SELECT  progressnotetypeid,description,description, 'intakeservicerequest',
     v_intakeservice.intakeserviceid :: character varying,v_securityuserid,v_securityuserid,progressnotesubtypeid,
     contactdate, contactname,progressnotetypekey,1 ,
     stafftypekey, instantresults,contactstatus,  drugscreen,
     progressnotepurposetypekey,notesid
   FROM progressnote WHERE entitytypeid = v_intakenumber ;
   
   
   
FOR  v_contractrole IN 
      SELECT  pnr.contactroletypekey,pnr.activeflag
         FROM progressnote pn 
      INNER JOIN progressnoteroletype pnr on pn.progressnoteid = pnr.progressnoteid 
         WHERE pn.entitytypeid = v_intakenumber 
LOOP   
       
     
      INSERT INTO progressnoteroletype (progressnoteid, contactroletypekey, activeflag, 
            insertedby,updatedby)
      SELECT pn1.progressnoteid,  v_contractrole.contactroletypekey, v_contractrole.activeflag,
         v_securityuserid,v_securityuserid
      FROM progressnote pn1
                     WHERE entitytypeid=v_intakeservice.intakeserviceid:: character varying; 
END LOOP; 


END LOOP;  


  
   UPDATE progressnoteroletype SET activeflag =0
   WHERE progressnoteid IN (SELECT progressnoteid FROM progressnote 
         WHERE activeflag =1 and entitytypeid = v_intakenumber);
         
         
  UPDATE progressnote SET activeflag =0 
  WHERE  entitytypeid = v_intakenumber and activeflag =1;
  
 Return 'Success';
 
END;

$function$

