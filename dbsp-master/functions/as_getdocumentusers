CREATE OR REPLACE FUNCTION as_getdocumentusers(v_intakeserviceid uuid, v_intakenumber character varying)
 RETURNS TABLE(updatedby character varying, displayname character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN 
 if(v_intakeserviceid is not null) then
 RETURN Query

select * from ((select  DMP.insertedby as updatedby,UP.displayname from Documentproperties as DMP
join userprofile as UP on UP.securityusersid = DMP.insertedby and UP.activeflag =1 
where DMP.objectid=v_intakeserviceid)
) as Z group by Z.updatedby, Z.displayname order by Z.displayname asc;

else
 RETURN Query
select * from ((select  DMP.insertedby as updatedby,UP.displayname from Documentproperties as DMP
join userprofile as UP on UP.securityusersid = DMP.insertedby and UP.activeflag =1 
where DMP.intakenumber=v_intakenumber)
) as Z group by Z.updatedby, Z.displayname order by Z.displayname asc;

end if;

END;

$function$

