CREATE OR REPLACE FUNCTION getpersonimmunizationlist(v_personid uuid, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, personimmunizationid uuid, personid uuid, immunizationtypekey character varying, personimmunizationconfigid uuid, immunizationdate date, comments character varying, dose character varying, insertedon timestamp without time zone, insertedby character varying, vaccinemanutype character varying, vaccinemanutypedesc character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE
   v_client_id        BIGINT;
   v_pagenumber       INT;
   v_pageoffset       INT;
   v_securityuserid   CHARACTER VARYING;
BEGIN
   v_pagenumber := v_liPageNumber - 1;
   v_pageoffset := v_pagenumber * v_liPageSize;

   RETURN QUERY
        SELECT count (1) OVER () AS totalcount,
               pip.personimmunizationid,
               pip.personid,
               pip.immunizationtypekey,
               pip.personimmunizationconfigid,
               pip.immunizationdate::date,
               pip."comments",
               pip.dose,
               pip.insertedon,
               pip.insertedby, 
               rv.ref_key, 
               rv.description
         FROM personimmunization pip 
       LEFT JOIN referencevalues rv ON rv.ref_key = pip.vaccinemanufacturer
         WHERE pip.personid = v_personid AND pip.activeflag = 1
      ORDER BY insertedon DESC
         LIMIT v_liPageSize
        OFFSET v_pageoffset;
END;
$function$

