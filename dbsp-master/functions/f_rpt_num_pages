CREATE OR REPLACE FUNCTION f_rpt_num_pages(ai_num_children bigint)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE
DECLARE v_num_pages         INTEGER DEFAULT 0;
DECLARE v_num_row_counter   INTEGER DEFAULT 0;
BEGIN
   IF AI_NUM_CHILDREN = 0 OR AI_NUM_CHILDREN IS NULL
   THEN
      v_num_pages = v_num_pages;
   ELSIF AI_NUM_CHILDREN <= 12
   THEN
      v_num_pages = v_num_pages + 1;
   ELSIF AI_NUM_CHILDREN > 12
   THEN
      v_num_row_counter = (AI_NUM_CHILDREN - 16);

      IF v_num_row_counter <= 16
      THEN
         v_num_pages = v_num_pages + 2;
      ELSE
         v_num_pages =
            v_num_pages + 2 + round (((v_num_row_counter + 5) / 21), 0);
      END IF;
   END IF;

   RETURN v_num_pages;
END;

$function$

