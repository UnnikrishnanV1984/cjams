CREATE OR REPLACE FUNCTION prov_getproviderfirdetails(v_provider_fir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN
SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT 
pu.*, pb.*,
 (select lastname ||', '||firstname from userprofile where securityusersid=PU.inserted_by) as displayname

FROM provider_fir PU 
left join tb_provider PB on PB.provider_id=Pu.provider_id
where PU.provider_fir_id=v_provider_fir_id 


   )  a;

RETURN  jsondata;
END;
$function$

