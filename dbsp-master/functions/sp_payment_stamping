CREATE OR REPLACE FUNCTION sp_payment_stamping(ad_run_dt date)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$\r
\r
------------------------------------------------------------------------\r
-- SQL Stored Procedure\r
-- This process will take all the payment generated from the previous month\r
-- and allocate the money for each payment depand upon availability from each\r
-- funds and then interface to FMIS / AFS\r
\r
-- 586 SSA\r
-- 587 SSI\r
-- 585 Other [COC]\r
-- 583 CHILD SUPPORT - (Commented CIS-17739)\r
\r
-- Created by: Amit Rastogi\r
-- Date created: 05/20/2004\r
-- added code to check transaction only for the previous month for the child account 12/28/2005\r
-- 04/02/2007 added the logic for system adjustement for under payments\r
-- 05/10/2007 Vineet Tirodkar - Added CONTINUE HANDLER to trap the Errors/Warnings in TB_BATCH_ERROR_LOG # 14088\r
-- 05/31/2007 Amit Rastogi - changed the logic to verify eligibility status for the client\r
-- 05/31/2007 Amit Rastogi - check the client accounts\r
-- 05/31/2007 Amit Rastogi - Initializing variables\r
-- 10/24/2008 Vineet Tirodkar - # 18838\r
--            1) Commented PAYMENT_DT update in table TB_PAYMENT_HEADER\r
--            2) Commented logic of child support, for new requirement of CIS-17739, \r
--               i.e. 'Child Support funds will always be used for ancillary goods/services'.\r
-- 03/03/2009 Vineet Tirodkar - CIS-17739\r
--       1) To add New Parameter as Run Date : \r
--               Payment Stamping for the prior month based on the parameter run date.\r
--               e.g. Pass any date from Feb 2009 to run payment stamping for the month of Jan 2009.\r
--            2) Changes in Logic of Payment Stamping  \r
--            3) To pass new parameter for SP_ACCOUNT_TRANSACTION_INSERT as Run Date \r
--            4) To call SP_CHILD_ACCOUNT_RELEASE_COC\r
-- 03/23/2009 Vineet Tirodkar - Change in logic to get already Stamped Payments.\r
-- 03/24/2009 Vineet Tirodkar - 1) To consider Receivables for Payment Stamping. \r
--            2) For Payment Stamping consider for Adjustments for Maintenance Payments Only.\r
--            3) For Payment Stamping ignore payments against Voided Placements.\r
-- 03/31/2009 Vineet Tirodkar - To Reset vl_child_account_id before in a loop\r
-- 05/11/2009 Vineet Tirodkar - Change in logic to get already stamped amounts based on new table TB_FUND_ALLOCATION_MASTER - CIS-18372 \r
-- 05/04/2010 Vineet Tirodkar - To add cur1 CURSOR WITH HOLD FOR and COMMIT in main CURSOR \r
-- 09/01/2010 Vinodh Magimaidas - PRJ00917 - Re-calculate fiscal category code while stamping CALL SP_RS_FISCAL_CAT_CD.\r
-- 09/23/2010 Vinodh Magimaidas - PRJ00917 - Introduce Update_user_id while updating, update_ts needs to be researched for impact\r
-- 02/27/2012 Vineet Tirodkar - PRJ-02312\r
-- To pass new argument to SP_ACCOUNT_TRANSACTION_INSERT -  Eligibility Status Code\r
-- 05/15/2012 Vineet Tirodkar - PRJ-02515 - To move the Get Fiscal category code logic at the beginning of SP. (Defect 8515 )\r
-- 09/04/2012 Vineet Tirodkar - Payment stamping batch production issue fix (Sept 2012)\r
-- New condition ORDER BY ELIGIBILITY_ID DESC FETCH FIRST ROW ONLY in the SQL to get client's Eligibility Status.\r
-- Added RETURN -1 for execptions & RETURN 0 for success\r
-- 09/25/2020 Vineet Tirodkar - Changes to trim and compare Eligibility Status Code - CDM-4684\r
------------------------------------------------------------------------\r
\r
DECLARE vl_child_account_id BIGINT DEFAULT 0;--\r
DECLARE vl_client_id BIGINT DEFAULT 0;--\r
DECLARE vl_case_id BIGINT DEFAULT 0;--\r
\r
DECLARE vd_previous_month_start_dt  DATE DEFAULT NULL;--\r
DECLARE vd_previous_month_end_dt  DATE DEFAULT NULL;--\r
DECLARE vd_current_month_end_dt  DATE DEFAULT NULL;--\r
DECLARE vdc_child_support_amount  decimal(10,2);--\r
DECLARE vdc_final_payment_amount  decimal(10,2);--\r
DECLARE vdc_child_ssi_amount   decimal(10,2);--\r
DECLARE vdc_child_ssa_amount   decimal(10,2);--\r
DECLARE vdc_child_other_amount   decimal(10,2);--\r
DECLARE vdc_child_iv_e_amount   decimal(10,2);--\r
DECLARE vdc_child_state_amount   decimal(10,2);--\r
DECLARE vdc_remaining_support_amount decimal(10,2);--\r
DECLARE vdc_amount_needed    decimal(10,2);--\r
DECLARE vs_transaction_source   varchar(5);--\r
DECLARE vs_funding_source    varchar(5);--\r
DECLARE vs_flag      char(1);--\r
\r
DECLARE vdc_ssi_amt_adj_credit   decimal(10,2);--\r
DECLARE vdc_ssi_amt_adj_debit   decimal(10,2);--\r
DECLARE vdc_ssi_stamped_amt   decimal(10,2);--\r
\r
DECLARE vdc_ssa_amt_adj_credit   decimal(10,2);--\r
DECLARE vdc_ssa_amt_adj_debit   decimal(10,2);--\r
DECLARE vdc_ssa_stamped_amt   decimal(10,2);--\r
\r
DECLARE vdc_othcoc_amt_adj_credit  decimal(10,2);--\r
DECLARE vdc_othcoc_amt_adj_debit  decimal(10,2);--\r
DECLARE vdc_othcoc_stamped_amt   decimal(10,2);--\r
\r
DECLARE vs_final_fiscal_category_cd varchar(5);--\r
DECLARE vs_eligiblity_status_cd varchar(5);--\r
\r
--PRJ-00917\r
DECLARE VS_ELIG_SW        CHAR(1) DEFAULT NULL;--\r
\r
--Log Error\r
DECLARE SQLCODE     INT DEFAULT 0;--\r
DECLARE al_sqlcode     INT DEFAULT 0;--\r
DECLARE as_error     VARCHAR(3000);--\r
DECLARE SQLSTATE     CHAR(5) DEFAULT '00000';--\r
--DECLARE p_sp_error CONDITION  FOR SQLSTATE '99999' ;--\r
p_sp_error CHAR(5);--\r
DECLARE vs_message_text   VARCHAR(3000) DEFAULT '';--\r
DECLARE vl_ret_status    INTEGER DEFAULT 0;--\r
DECLARE vs_Procedure_nm   VARCHAR(100) DEFAULT 'SP_PAYMENT_STAMPING';--\r
DECLARE vs_identity_column   VARCHAR(100);--\r
DECLARE vs_identity_val   VARCHAR(100);--\r
DECLARE vl_count     INTEGER;--\r
 cur_payment_detail record;\r
 cur_payment_detail_refcur REFCURSOR;\r
--DECLARE CONTINUE HANDLER FOR SQLWARNING\r
BEGIN\r
begin\r
 EXCEPTION WHEN OTHERS THEN\r
   -- GET DIAGNOSTICS EXCEPTION 1 vs_message_text =  MESSAGE_TEXT;--\r
    GET STACKED DIAGNOSTICS vs_message_text :=  MESSAGE_TEXT;    -- SET al_sqlcode = -1 ;--\r
  al_sqlcode := SQLCODE;\r
     as_error := COALESCE(as_error ,'') || (CURRENT_TIMESTAMP::text) ||'::' || vs_Procedure_nm || '.' ;--\r
     as_error := COALESCE(as_error ,'') || '::RO ' || COALESCE(vs_identity_column ,'N/A') || ' :: ' || COALESCE(vs_identity_val ,'');--\r
     as_error := as_error || COALESCE(vs_message_text ,'');--\r
\r
    SELECT SP_BATCH_ERROR_LOG ( vs_Procedure_nm ,\r
             NULL::bigint,\r
            NULL::bigint,\r
                  NULL::character varying,\r
            NULL::INTEGER,\r
      NULL::character varying,\r
            SQLSTATE::character varying,\r
                  as_error::character varying,\r
            'finance'::character varying) INTO\r
                  vl_ret_status;\r
\r
     as_error := '';--\r
     al_sqlcode := 0;--\r
END;\r
/*\r
\r
DECLARE EXIT HANDLER FOR SQLEXCEPTION\r
BEGIN\r
 GET DIAGNOSTICS EXCEPTION 1 vs_message_text =  MESSAGE_TEXT;--\r
  al_sqlcode := SQLCODE;\r
  as_error := COALESCE(as_error ,'') || TO_CHAR(CURRENT_TIMESTAMP) ||'::' || vs_Procedure_nm || '.' ;--\r
  as_error := COALESCE(as_error ,'') || '::RO ' || COALESCE(vs_identity_column ,'N/A') || ' :: ' || COALESCE(vs_identity_val ,'');--\r
  as_error := as_error || vs_message_text;--\r
\r
 SELECT SP_BATCH_ERROR_LOG  ( vs_Procedure_nm\r
          , NULL\r
          , NULL\r
          , NULL\r
          , NULL\r
          , as_error\r
          , 'STAMPING'\r
          , vl_ret_status );--\r
 RETURN -1;         \r
END;--\r
*/\r
--Log error\r
\r
--  Get the last month start date and end date based on parameter date - CIS-17739\r
/*SELECT ( DATE(SUBSTR(CHAR(ad_run_dt  -  DAY(ad_run_dt) DAYS,ISO),1,8)||'01'))\r
  , ( ad_run_dt  -  DAY(ad_run_dt) DAYS )\r
  , ( ad_run_dt + 1 month - DAY(ad_run_dt) DAYS)\r
  INTO vd_previous_month_start_dt\r
  , vd_previous_month_end_dt\r
  , vd_current_month_end_dt\r
  FROM sysibm.sysdummy1;--*/\r
SELECT (date_trunc('month', ad_run_dt::date) - interval '1 month')::date,\r
       (date_trunc('month', ad_run_dt::date)::date - 1),\r
       ((date_trunc('month', ad_run_dt::date) + interval '1 month')- interval '1 Day')::date\r
INTO    vd_previous_month_start_dt,\r
        vd_previous_month_end_dt,\r
        vd_current_month_end_dt;\r
\r
-- Update payment header table with code interface to FMIS\r
\r
-- 5585 FMIS\r
UPDATE TB_PAYMENT_HEADER\r
   SET INTERFACE_TO_CD = '5585'\r
     , UPDATE_USER_ID = 'STAMPING'\r
 WHERE DELETE_SW = 'N' \r
   AND PAYMENT_TYPE_CD = '6'\r
   AND MANUAL_SW= 'N' \r
   AND PAYMENT_START_DT = vd_previous_month_start_dt \r
   AND PAYMENT_END_DT = vd_previous_month_end_dt \r
   AND PAYMENT_ID IN (SELECT PAYMENT_ID \r
                  FROM TB_PAYMENT_DETAIL \r
                  WHERE DELETE_SW = 'N'\r
                AND FINAL_SERVICE_ID IS NOT NULL\r
       AND county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) \r
       );--\r
\r
 al_sqlcode := SQLCODE;--\r
IF al_sqlcode < 0 THEN\r
     as_error := 'Error in Updating Payment Header with code interface to FMIS'  ;--\r
     vs_identity_column := 'Payment ID';--\r
     vs_identity_val := 'Multiple';--\r
    --SIGNAL p_sp_error  ;--\r
END IF ;--\r
\r
-- 5583 AFS\r
UPDATE TB_PAYMENT_HEADER\r
   SET INTERFACE_TO_CD = '5583' \r
     , UPDATE_USER_ID = 'STAMPING'\r
 WHERE DELETE_SW = 'N' \r
   AND PAYMENT_TYPE_CD = '3294' \r
   AND MANUAL_SW= 'N' \r
   AND PAYMENT_START_DT = vd_previous_month_start_dt \r
   AND PAYMENT_END_DT = vd_previous_month_end_dt \r
   AND PAYMENT_ID IN (SELECT PAYMENT_ID \r
                 FROM TB_PAYMENT_DETAIL \r
                  WHERE DELETE_SW = 'N'\r
                AND FINAL_SERVICE_ID IS NOT NULL\r
                AND PLACEMENT_ID IS NOT NULL \r
       AND county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) \r
      ) ;--\r
\r
 al_sqlcode := SQLCODE;--\r
IF al_sqlcode < 0 THEN\r
     as_error := 'Error in Updating Payment Header with code interface to AFS'  ;--\r
     vs_identity_column := 'Payment ID';--\r
     vs_identity_val := 'Multiple';--\r
   -- SIGNAL p_sp_error  ;--\r
END IF ;--\r
\r
-- Allocation of money from different sources\r
-- Changes in SQL to exclude Payments with Status as 'Hold and 'Released' - CIS-17739 \r
--FOR cur_payment_detail AS\r
--cur1 CURSOR WITH HOLD FOR\r
OPEN cur_payment_detail_refcur FOR\r
SELECT PD.CLIENT_ID\r
  , ( PD.FINAL_AMOUNT_NO - COALESCE(( SELECT SUM(COALESCE(RD.AMOUNT_NO,0))\r
             FROM TB_RECEIVABLE_DETAIL RD\r
            WHERE RD.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
           AND RD.DELETE_SW = 'N' ),0) \r
    ) AS FINAL_AMOUNT_NO\r
  , PD.PAYMENT_DETAIL_ID\r
  , PD.CASE_ID\r
  , PD.FINAL_FISCAL_CATEGORY_CD\r
  FROM TB_PAYMENT_HEADER PH\r
  , TB_PAYMENT_DETAIL PD\r
  , TB_PAYMENT_STATUS PS\r
  , TB_PLACEMENT PL\r
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID \r
   AND PH.PAYMENT_ID = PS.PAYMENT_ID \r
   AND PL.PLACEMENT_ID = PD.PLACEMENT_ID      \r
   AND PH.PAYMENT_START_DT = vd_previous_month_start_dt \r
   AND PH.PAYMENT_END_DT = vd_previous_month_end_dt \r
   AND PH.DELETE_SW = 'N' \r
   AND PD.DELETE_SW = 'N' \r
   AND PS.DELETE_SW = 'N' \r
   AND PL.DELETE_SW = 'N' \r
   AND PH.PAYMENT_TYPE_CD IN ('6','3294') \r
   AND ( PH.MANUAL_SW = 'N' OR PH.MANUAL_SW IS NULL )\r
   AND PD.FINAL_SERVICE_ID IS NOT NULL\r
   AND PS.PAYMENT_STATUS_CD NOT IN ('1635','1639') \r
   AND PD.PLACEMENT_ID IS NOT NULL\r
   AND ( PL.VOID_SW = 'N' OR PL.VOID_SW is null OR RTRIM(LTRIM(PL.VOID_SW)) = '')\r
   AND PD.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) ; \r
      \r
--DO\r
loop\r
 fetch cur_payment_detail_refcur into cur_payment_detail;\r
 exit when not found;\r
     vdc_final_payment_amount := 0.00;--\r
     vdc_final_payment_amount := cur_payment_detail.FINAL_AMOUNT_NO;--\r
     vl_client_id := cur_payment_detail.CLIENT_ID;--\r
     vdc_remaining_support_amount := 0.00;--\r
     vdc_amount_needed := 0.00;--\r
     vdc_child_iv_e_amount := 0.00;--\r
     vdc_child_state_amount := 0.00;--\r
     vl_case_id := NULL; --INITIAL VALUE \r
     vl_case_id := cur_payment_detail.CASE_ID;--\r
     vs_final_fiscal_category_cd := NULL; --INITIAL VALUE \r
     vs_final_fiscal_category_cd := cur_payment_detail.FINAL_FISCAL_CATEGORY_CD;--\r
    \r
    --  PRJ-02312 To get client's Eligibility Status\r
  VS_ELIG_SW := NULL;\r
  vs_eligiblity_status_cd :=  NULL;\r
    \r
 SELECT btrim(ELIGIBILITY_STATUS_CD)\r
     INTO vs_eligiblity_status_cd\r
   FROM TB_CLIENT_ELIGIBILITY\r
 WHERE CLIENT_ID = vl_client_id \r
  AND CASE_ID = vl_case_id \r
  AND btrim(ELIGIBILITY_TYPE_CD) = '2931' -- IV-E Foster Care  \r
  AND DELETE_SW = 'N' \r
  AND START_DT <= vd_previous_month_end_dt \r
  AND (END_DT >= vd_previous_month_start_dt or END_DT is null)\r
    ORDER BY ELIGIBILITY_ID DESC\r
    FETCH FIRST ROW ONLY;  \r
\r
 IF vs_eligiblity_status_cd is NOT NULL AND vs_eligiblity_status_cd = '2913' THEN -- Eligibility Reimb\r
   VS_ELIG_SW := 'Y'; \r
 ELSE\r
   VS_ELIG_SW := 'N'; \r
 END IF;\r
RAISE NOTICE 'sp_payment_stamping>>>> before call SP_RS_FISCAL_CAT_CD';\r
 -- PRJ-02515 - START    \r
 -- PRJ-00917 Start - re-calculate fiscal category code\r
 SELECT a.as_fiscalcat,a.al_sqlcode,a.as_error from SP_RS_FISCAL_CAT_CD ( vl_CLIENT_ID\r
          , cur_payment_detail.PAYMENT_DETAIL_ID \r
          , VS_ELIG_SW\r
          , vd_previous_month_start_dt\r
          , vd_previous_month_end_dt) a INTO\r
          vs_final_fiscal_category_cd\r
          , al_sqlcode\r
          , as_error;--\r
 RAISE NOTICE 'sp_payment_stamping>>>> call SP_RS_FISCAL_CAT_CD Output  %',vs_final_fiscal_category_cd;\r
\r
 IF al_sqlcode <> 0 THEN\r
   as_error := as_error  ;--\r
  IF as_error is NULL OR as_error = '' THEN\r
    as_error := 'SP_RS_FISCAL_CAT_CD failed'  ;--\r
  END IF;--\r
  --SIGNAL p_sp_error  ;         --\r
 END IF;  --\r
 -- PRJ-00917 End\r
 -- PRJ-02515 - END\r
 \r
     vl_count := 0; --INITIAL VALUE \r
\r
    SELECT COUNT(*) \r
      INTO vl_count\r
      FROM TB_FUND_ALLOCATION_MASTER\r
     WHERE PAYMENT_DETAIL_ID = cur_payment_detail.PAYMENT_DETAIL_ID\r
       AND DELETE_SW = 'N' ;--\r
\r
    IF vl_count = 0 THEN -- PAYMENT NOT STAMPED\r
       -- Get Active Conserved Account ID of the client  \r
        vl_child_account_id := NULL; --INITIAL VALUE\r
       \r
       IF vl_client_id is not null then\r
          SELECT TA.CLIENT_ACCOUNT_ID\r
          INTO vl_child_account_id\r
            FROM TB_CLIENT_ACCOUNT TA\r
           WHERE TA.DELETE_SW = 'N' \r
             AND TA.ACCOUNT_TYPE_CD = '590' \r
             AND TA.CLIENT_ID = vl_client_id \r
             AND TA.STATUS_CD = '592';--\r
       END IF;   --\r
\r
       IF vl_child_account_id is NULL THEN\r
           vl_child_account_id := 0;  --\r
       END IF;--\r
       \r
       IF vdc_final_payment_amount <> 0 THEN -- FINAL AMOUNT NOT ZERO \r
   -- Set entire Final payment amount as remaining support amt, as child support logic has been commented.\r
    vdc_remaining_support_amount := vdc_final_payment_amount;--\r
  \r
   -- START - SSI --\r
   IF vl_child_account_id > 0 THEN -- CLIENT ACC EXIST (SSI) -- Start \r
    -- if amount still remain then look for SSI\r
     vdc_child_ssi_amount := 0.00; -- INITIAL VALUE\r
     vdc_ssi_amt_adj_credit := 0.00; -- INITIAL VALUE\r
     vdc_ssi_amt_adj_debit := 0.00; -- INITIAL VALUE\r
     vdc_ssi_stamped_amt := 0.00; -- INITIAL VALUE\r
       \r
    IF vdc_remaining_support_amount > 0 THEN\r
     -- SSI Receipts \r
     SELECT SUM(TB.TRANSACTION_AMOUNT_NO)\r
       INTO vdc_child_ssi_amount\r
       FROM TB_ACCOUNT_TRANSACTION TB\r
      WHERE TB.CLIENT_ACCOUNT_ID = vl_child_account_id \r
        AND TB.DELETE_SW = 'N' \r
        AND TB.TRANSACTION_SOURCE_CD = '587'  \r
        AND TB.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt;  --\r
\r
     IF vdc_child_ssi_amount is NULL THEN\r
        vdc_child_ssi_amount := 0.00; --\r
     END IF;--\r
   \r
     -- Credit Adjustments Against Ref Transaction with source SSI\r
     SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))     \r
       INTO vdc_ssi_amt_adj_credit\r
       FROM TB_ACCOUNT_TRANSACTION TR1\r
      WHERE TR1.TRANSACTION_TYPE_CD = '588'\r
        AND TR1.CREDIT_DEBIT_SW = 'C'\r
        AND TR1.TRANSACTION_SOURCE_CD = '5473' \r
        AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'\r
        AND TR1.REFERENCE_TRANSACTION_ID in \r
         (SELECT TR.TRANSACTION_ID\r
         FROM TB_ACCOUNT_TRANSACTION TR\r
        WHERE TR.CLIENT_ACCOUNT_ID = vl_child_account_id\r
          AND TR.DELETE_SW = 'N' \r
          AND TR.CREDIT_DEBIT_SW = 'C'\r
          AND TR.TRANSACTION_SOURCE_CD = '587'\r
          AND TR.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt \r
       );--\r
\r
     IF vdc_ssi_amt_adj_credit is NULL THEN\r
       vdc_ssi_amt_adj_credit := 0.00;--\r
     END IF;   --\r
   \r
     -- Debit Adjustments Against Ref Transaction with source SSI\r
     SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))     \r
       INTO vdc_ssi_amt_adj_debit\r
       FROM TB_ACCOUNT_TRANSACTION TR1\r
      WHERE TR1.TRANSACTION_TYPE_CD = '588'\r
        AND TR1.CREDIT_DEBIT_SW = 'D'\r
        AND TR1.TRANSACTION_SOURCE_CD = '5473' \r
        AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'\r
        AND TR1.REFERENCE_TRANSACTION_ID in \r
         (SELECT TR.TRANSACTION_ID\r
         FROM TB_ACCOUNT_TRANSACTION TR\r
        WHERE TR.CLIENT_ACCOUNT_ID = vl_child_account_id\r
          AND TR.DELETE_SW = 'N' \r
          AND TR.CREDIT_DEBIT_SW = 'C'\r
          AND TR.TRANSACTION_SOURCE_CD = '587'\r
          AND TR.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt \r
         );--\r
       \r
     IF vdc_ssi_amt_adj_debit is NULL THEN\r
       vdc_ssi_amt_adj_debit := 0.00;--\r
     END IF;   --\r
   \r
     -- Stamped COC Payments Against Transaction with source SSI\r
     SELECT SUM(SSI_FUNDING_AMT)\r
       INTO vdc_ssi_stamped_amt\r
       FROM TB_FUND_ALLOCATION_MASTER  TF\r
       , TB_PAYMENT_DETAIL PD\r
       , TB_PAYMENT_HEADER PH\r
      WHERE TF.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
        AND PH.PAYMENT_ID = PD.PAYMENT_ID  \r
        AND PH.PAYMENT_TYPE_CD IN ('6','3294')\r
        AND ( PH.MANUAL_SW = 'N' OR PH.MANUAL_SW IS NULL )\r
        AND PD.FINAL_SERVICE_ID IS NOT NULL\r
        AND TF.DELETE_SW = 'N'\r
        AND PD.DELETE_SW = 'N'\r
        AND PH.DELETE_SW = 'N'\r
        AND PH.PAYMENT_START_DT = vd_previous_month_start_dt\r
        AND PH.PAYMENT_END_DT = vd_previous_month_end_dt\r
        AND PD.CLIENT_ID = vl_client_id \r
        AND PD.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE )\r
        ;   --\r
\r
      -- Commented CIS-18372\r
\r
     IF vdc_ssi_stamped_amt is NULL THEN\r
       vdc_ssi_stamped_amt := 0.00; --\r
     END IF;--\r
   \r
      vdc_child_ssi_amount := ( vdc_child_ssi_amount + vdc_ssi_amt_adj_credit ) - ( vdc_ssi_amt_adj_debit + vdc_ssi_stamped_amt ) ; --\r
  \r
     IF vdc_child_ssi_amount > 0 THEN  -- SSI have some money\r
      IF vdc_remaining_support_amount > vdc_child_ssi_amount THEN\r
        vdc_remaining_support_amount := vdc_remaining_support_amount - vdc_child_ssi_amount;--\r
        vdc_amount_needed := vdc_child_ssi_amount;--\r
      ELSE\r
       --SET vdc_amount_needed = vdc_child_ssi_amount - vdc_remaining_support_amount;--\r
        vdc_amount_needed := vdc_remaining_support_amount;--\r
        vdc_remaining_support_amount := 0;--\r
      END IF ;--\r
      -- inserting in child account table with transaction type automatic charge and transaction source\r
      -- SSI\r
\r
       vs_transaction_source := '587';--\r
       vs_funding_source := '587';--\r
       vs_flag := 'Y';--\r
\r
      SELECT a.al_sqlcode,a.as_error from SP_ACCOUNT_TRANSACTION_INSERT  ( vl_child_account_id\r
                 , cur_payment_detail.PAYMENT_DETAIL_ID\r
                 , vs_transaction_source\r
                 , vs_funding_source\r
                 , vdc_amount_needed\r
                 , vs_flag\r
                 , ad_run_dt\r
                 , vdc_final_payment_amount\r
                 , vs_final_fiscal_category_cd\r
                 , vs_eligiblity_status_cd) a INTO\r
                  al_sqlcode\r
                 , as_error;--\r
\r
      IF al_sqlcode <> 0 THEN\r
        as_error := as_error  ;--\r
       IF as_error is NULL OR as_error = '' THEN\r
         as_error := 'SP_ACCOUNT_TRANSACTION_INSERT failed - SSI'  ;--\r
       END IF;--\r
       --SIGNAL p_sp_error  ;--\r
      END IF;--\r
     END IF;--\r
    END IF;--\r
   END IF;  -- CLIENT ACC EXIST (SSI) -- End\r
   -- END - SSI --\r
\r
   -- START - SSA --\r
   IF vl_child_account_id > 0 THEN -- CLIENT ACC EXIST (SSA) -- Start\r
    -- if amount still remain then look for SSA\r
     vdc_child_ssa_amount := 0.00; -- INITIAL VALUE\r
     vdc_ssa_amt_adj_credit := 0.00; -- INITIAL VALUE\r
     vdc_ssa_amt_adj_debit := 0.00; -- INITIAL VALUE\r
     vdc_ssa_stamped_amt := 0.00; -- INITIAL VALUE\r
       \r
    IF vdc_remaining_support_amount > 0 THEN\r
     -- SSA Receipts \r
     SELECT SUM(TB.TRANSACTION_AMOUNT_NO)\r
       INTO vdc_child_ssa_amount\r
       FROM TB_ACCOUNT_TRANSACTION TB\r
      WHERE TB.CLIENT_ACCOUNT_ID = vl_child_account_id \r
        AND TB.DELETE_SW = 'N' \r
        AND TB.TRANSACTION_SOURCE_CD = '586'  \r
        AND TB.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt; --\r
\r
     IF vdc_child_ssa_amount is NULL THEN\r
       vdc_child_ssa_amount := 0.00;--\r
     END IF;--\r
        \r
     -- Credit Adjustments Against Ref Transaction with source SSA\r
     SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))     \r
       INTO vdc_ssa_amt_adj_credit\r
       FROM TB_ACCOUNT_TRANSACTION TR1\r
      WHERE TR1.TRANSACTION_TYPE_CD = '588'\r
        AND TR1.CREDIT_DEBIT_SW = 'C'\r
        AND TR1.TRANSACTION_SOURCE_CD = '5473' \r
        AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'\r
        AND TR1.REFERENCE_TRANSACTION_ID in \r
         (SELECT TR.TRANSACTION_ID\r
         FROM TB_ACCOUNT_TRANSACTION TR\r
        WHERE TR.CLIENT_ACCOUNT_ID = vl_child_account_id\r
          AND TR.DELETE_SW = 'N' \r
          AND TR.CREDIT_DEBIT_SW = 'C'\r
          AND TR.TRANSACTION_SOURCE_CD = '586'\r
          AND TR.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt \r
         );--\r
\r
     IF vdc_ssa_amt_adj_credit is NULL THEN\r
        vdc_ssa_amt_adj_credit := 0.00;--\r
     END IF;   --\r
        \r
     -- Debit Adjustments Against Ref Transaction with source SSA\r
     SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))     \r
       INTO vdc_ssa_amt_adj_debit\r
       FROM TB_ACCOUNT_TRANSACTION TR1\r
      WHERE TR1.TRANSACTION_TYPE_CD = '588'\r
        AND TR1.CREDIT_DEBIT_SW = 'D'\r
        AND TR1.TRANSACTION_SOURCE_CD = '5473' \r
        AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'\r
        AND TR1.REFERENCE_TRANSACTION_ID in \r
         (SELECT TR.TRANSACTION_ID\r
         FROM TB_ACCOUNT_TRANSACTION TR\r
        WHERE TR.CLIENT_ACCOUNT_ID = vl_child_account_id\r
          AND TR.DELETE_SW = 'N' \r
          AND TR.CREDIT_DEBIT_SW = 'C'\r
          AND TR.TRANSACTION_SOURCE_CD = '586'\r
          AND TR.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt \r
         );--\r
         \r
     IF vdc_ssa_amt_adj_debit is NULL THEN\r
       vdc_ssa_amt_adj_debit := 0.00;--\r
     END IF;   --\r
   \r
     -- Stamped COC Payments Against Transaction with source SSA\r
     SELECT SUM(SSA_FUNDING_AMT)\r
       INTO vdc_ssa_stamped_amt\r
       FROM TB_FUND_ALLOCATION_MASTER  TF\r
       , TB_PAYMENT_DETAIL PD\r
       , TB_PAYMENT_HEADER PH\r
      WHERE TF.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
        AND PH.PAYMENT_ID = PD.PAYMENT_ID  \r
        AND PH.PAYMENT_TYPE_CD IN ('6','3294')\r
        AND ( PH.MANUAL_SW = 'N' OR PH.MANUAL_SW IS NULL )\r
        AND PD.FINAL_SERVICE_ID IS NOT NULL\r
        AND TF.DELETE_SW = 'N'\r
        AND PD.DELETE_SW = 'N'\r
        AND PH.DELETE_SW = 'N'\r
        AND PH.PAYMENT_START_DT = vd_previous_month_start_dt\r
        AND PH.PAYMENT_END_DT = vd_previous_month_end_dt\r
        AND PD.CLIENT_ID = vl_client_id \r
        AND PD.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE )\r
        ;   --\r
  \r
     -- Commented CIS-18372    \r
      \r
     IF vdc_ssa_stamped_amt is NULL THEN\r
       vdc_ssa_stamped_amt := 0.00; --\r
     END IF;--\r
       \r
      vdc_child_ssa_amount := ( vdc_child_ssa_amount + vdc_ssa_amt_adj_credit ) - ( vdc_ssa_amt_adj_debit + vdc_ssa_stamped_amt );--\r
\r
     IF vdc_child_ssa_amount > 0 THEN  -- SSA have some money\r
      IF vdc_remaining_support_amount > vdc_child_ssa_amount THEN\r
        vdc_remaining_support_amount := vdc_remaining_support_amount - vdc_child_ssa_amount;--\r
        vdc_amount_needed := vdc_child_ssa_amount;--\r
      ELSE\r
       --SET vdc_amount_needed = vdc_child_ssa_amount - vdc_remaining_support_amount;--\r
        vdc_amount_needed := vdc_remaining_support_amount;--\r
        vdc_remaining_support_amount := 0;--\r
      END IF ;--\r
      -- inserting in child account table with transaction type automatic charge and transaction source\r
      -- SSA\r
\r
       vs_transaction_source := '586';--\r
       vs_funding_source := '586';--\r
       vs_flag := 'Y';--\r
      SELECT a.al_sqlcode,a.as_error from SP_ACCOUNT_TRANSACTION_INSERT ( vl_child_account_id\r
                 , cur_payment_detail.PAYMENT_DETAIL_ID\r
                 , vs_transaction_source\r
                 , vs_funding_source\r
                 , vdc_amount_needed\r
                 , vs_flag\r
                 , ad_run_dt\r
                 , vdc_final_payment_amount\r
                 , vs_final_fiscal_category_cd\r
                 , vs_eligiblity_status_cd) a into\r
                  al_sqlcode\r
                 , as_error;--\r
\r
      IF al_sqlcode <> 0 THEN\r
        as_error := as_error  ;--\r
       IF as_error is NULL OR as_error = '' THEN\r
         as_error := 'SP_ACCOUNT_TRANSACTION_INSERT failed - SSA'  ;--\r
       END IF;--\r
       --SIGNAL p_sp_error  ;--\r
      END IF ;--\r
     END IF;--\r
    END IF;--\r
   END IF; -- CLIENT ACC EXIST (SSA) -- End \r
   -- END - SSA --\r
\r
   -- START -- other [COC]\r
   IF vl_child_account_id > 0 THEN -- CLIENT ACC EXIST (Other[COC]) -- Start\r
    -- if amount still remain then look for other money in child account\r
     vdc_child_other_amount := 0.00; -- INITIAL VALUE\r
     vdc_othcoc_amt_adj_credit := 0.00; -- INITIAL VALUE\r
     vdc_othcoc_amt_adj_debit := 0.00; -- INITIAL VALUE\r
     vdc_othcoc_stamped_amt := 0.00; -- INITIAL VALUE\r
  \r
    IF vdc_remaining_support_amount > 0 THEN\r
     SELECT SUM(TB.TRANSACTION_AMOUNT_NO)\r
       INTO vdc_child_other_amount\r
       FROM TB_ACCOUNT_TRANSACTION TB\r
      WHERE TB.CLIENT_ACCOUNT_ID = vl_child_account_id \r
        AND TB.DELETE_SW = 'N' \r
        AND TB.TRANSACTION_SOURCE_CD = '585'  \r
        AND TB.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt;  --\r
      \r
     IF vdc_child_other_amount is NULL THEN\r
       vdc_child_other_amount := 0.00 ; --\r
     END IF;--\r
     \r
     -- Credit Adjustments Against Ref Transaction with source OTHER [COC]\r
     SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))     \r
       INTO vdc_othcoc_amt_adj_credit\r
       FROM TB_ACCOUNT_TRANSACTION TR1\r
      WHERE TR1.TRANSACTION_TYPE_CD = '588'\r
        AND TR1.CREDIT_DEBIT_SW = 'C'\r
        AND TR1.TRANSACTION_SOURCE_CD = '5473' \r
        AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'\r
        AND TR1.REFERENCE_TRANSACTION_ID in \r
         ( SELECT TR.TRANSACTION_ID\r
          FROM TB_ACCOUNT_TRANSACTION TR\r
         WHERE TR.CLIENT_ACCOUNT_ID = vl_child_account_id\r
        AND TR.DELETE_SW = 'N' \r
        AND TR.CREDIT_DEBIT_SW = 'C'\r
        AND TR.TRANSACTION_SOURCE_CD = '585'\r
        AND TR.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt \r
         );--\r
\r
     IF vdc_othcoc_amt_adj_credit is NULL THEN\r
       vdc_othcoc_amt_adj_credit := 0.00;--\r
     END IF;   --\r
        \r
     -- Debit Adjustments Against Ref Transaction with source OTHER [COC]\r
     SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))     \r
       INTO vdc_othcoc_amt_adj_debit\r
       FROM TB_ACCOUNT_TRANSACTION TR1\r
      WHERE TR1.TRANSACTION_TYPE_CD = '588'\r
        AND TR1.CREDIT_DEBIT_SW = 'D'\r
        AND TR1.TRANSACTION_SOURCE_CD = '5473' \r
        AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'\r
        AND TR1.REFERENCE_TRANSACTION_ID in \r
         ( SELECT TR.TRANSACTION_ID\r
          FROM TB_ACCOUNT_TRANSACTION TR\r
         WHERE TR.CLIENT_ACCOUNT_ID = vl_child_account_id\r
        AND TR.DELETE_SW = 'N' \r
        AND TR.CREDIT_DEBIT_SW = 'C'\r
        AND TR.TRANSACTION_SOURCE_CD = '585'\r
        AND TR.BENEFIT_START_DT BETWEEN vd_previous_month_start_dt and vd_previous_month_end_dt \r
         );--\r
        \r
     IF vdc_othcoc_amt_adj_debit is NULL THEN\r
       vdc_othcoc_amt_adj_debit := 0.00;--\r
     END IF;   --\r
    \r
     -- Stamped COC Payments Against Transaction with source OTHER [COC]\r
     SELECT SUM(COC_FUNDING_AMT)\r
       INTO vdc_othcoc_stamped_amt\r
       FROM TB_FUND_ALLOCATION_MASTER  TF\r
          , TB_PAYMENT_DETAIL PD\r
       , TB_PAYMENT_HEADER PH\r
      WHERE TF.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
        AND PH.PAYMENT_ID = PD.PAYMENT_ID  \r
        AND PH.PAYMENT_TYPE_CD IN ('6','3294')\r
        AND ( PH.MANUAL_SW = 'N' OR PH.MANUAL_SW IS NULL )\r
        AND PD.FINAL_SERVICE_ID IS NOT NULL\r
        AND TF.DELETE_SW = 'N'\r
        AND PD.DELETE_SW = 'N'\r
        AND PH.DELETE_SW = 'N'\r
        AND PH.PAYMENT_START_DT = vd_previous_month_start_dt\r
        AND PH.PAYMENT_END_DT = vd_previous_month_end_dt\r
        AND PD.CLIENT_ID = vl_client_id \r
        AND PD.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE )\r
        ;   --\r
  \r
        -- Commented CIS-18372        \r
\r
     IF vdc_othcoc_stamped_amt is NULL THEN\r
       vdc_othcoc_stamped_amt := 0.00; --\r
     END IF;     --\r
     \r
      vdc_child_other_amount := ( vdc_child_other_amount + vdc_othcoc_amt_adj_credit ) - ( vdc_othcoc_amt_adj_debit + vdc_othcoc_stamped_amt );--\r
     \r
     IF vdc_child_other_amount > 0 THEN  -- OTHER [COC] have some money\r
      IF vdc_remaining_support_amount > vdc_child_other_amount THEN\r
        vdc_remaining_support_amount := vdc_remaining_support_amount - vdc_child_other_amount;--\r
        vdc_amount_needed := vdc_child_other_amount;--\r
      ELSE\r
       --SET vdc_amount_needed = vdc_child_other_amount - vdc_remaining_support_amount;--\r
        vdc_amount_needed := vdc_remaining_support_amount;--\r
        vdc_remaining_support_amount := 0;--\r
      END IF ;--\r
        -- inserting in child account table with transaction type automatic charge and transaction source\r
        -- OTHER [COC]\r
\r
       vs_transaction_source := '585';--\r
       vs_funding_source := '4893';--\r
       vs_flag := 'Y';--\r
      SELECT a.al_sqlcode,a.as_error from SP_ACCOUNT_TRANSACTION_INSERT ( vl_child_account_id\r
                 , cur_payment_detail.PAYMENT_DETAIL_ID\r
                 , vs_transaction_source\r
                 , vs_funding_source\r
                 , vdc_amount_needed\r
                 , vs_flag\r
                 , ad_run_dt\r
                 , vdc_final_payment_amount\r
                 , vs_final_fiscal_category_cd\r
                 , vs_eligiblity_status_cd) a into\r
                  al_sqlcode\r
                 , as_error;--\r
\r
      IF al_sqlcode <> 0 THEN\r
        as_error := as_error  ;--\r
       IF as_error is NULL OR as_error = '' THEN\r
         as_error := 'SP_ACCOUNT_TRANSACTION_INSERT failed - Other [COC]'  ;--\r
       END IF;--\r
       --SIGNAL p_sp_error  ;--\r
      END IF ;--\r
     END IF;--\r
    END IF;--\r
   END IF; -- CLIENT ACC EXIST (Other[COC]) -- End   \r
   -- END -- other [COC]\r
\r
   -- STATE AND IV-E MONEY START HERE\r
   -- once child support, ssi and ssa is looked into, if money is still required then\r
   -- look if child is IV-E eligible\r
   IF vdc_remaining_support_amount > 0 THEN\r
    -- PRJ-02312 moved the logic to get client's Eligibility Status on top\r
\r
    IF VS_ELIG_SW = 'Y' THEN -- client is IV-E eligible\r
      vdc_child_iv_e_amount := vdc_remaining_support_amount/2;--\r
      vdc_child_state_amount := vdc_remaining_support_amount/2;--\r
    ELSE\r
      vdc_child_iv_e_amount := 0;--\r
      vdc_child_state_amount := vdc_remaining_support_amount;--\r
    END IF;\r
    \r
    -- PRJ-02515 - Moved the Get Fiscal category code logic at the beginning of SP.\r
   END IF;--\r
   -- STATE AND IV-E MONEY END HERE\r
\r
   -- inserting state money record\r
   IF vdc_child_state_amount > 0 THEN \r
     vs_transaction_source := '';--\r
     vs_funding_source := '4895';--\r
     vs_flag := 'N';--\r
    SELECT a.al_sqlcode,a.as_error from SP_ACCOUNT_TRANSACTION_INSERT ( vl_child_account_id\r
                 , cur_payment_detail.PAYMENT_DETAIL_ID\r
                 , vs_transaction_source\r
                 , vs_funding_source\r
                 , vdc_child_state_amount\r
                 , vs_flag\r
                 , ad_run_dt\r
                 , vdc_final_payment_amount\r
                 , vs_final_fiscal_category_cd\r
                 , vs_eligiblity_status_cd) a into\r
                  al_sqlcode\r
                 , as_error;--\r
\r
    IF al_sqlcode <> 0 THEN\r
      as_error := as_error  ;--\r
     IF as_error is NULL OR as_error = '' THEN\r
       as_error := 'SP_ACCOUNT_TRANSACTION_INSERT failed - STATE Money'  ;--\r
     END IF;--\r
     --SIGNAL p_sp_error  ;--\r
    END IF ;--\r
\r
    -- inserting iv-e money record\r
    IF vdc_child_iv_e_amount > 0 THEN\r
      vs_transaction_source := '';--\r
      vs_funding_source := '4894';--\r
      vs_flag := 'N';--\r
     SELECT a.al_sqlcode,a.as_error from SP_ACCOUNT_TRANSACTION_INSERT ( vl_child_account_id\r
                  , cur_payment_detail.PAYMENT_DETAIL_ID\r
                  , vs_transaction_source\r
                  , vs_funding_source\r
                  , vdc_child_iv_e_amount\r
                  , vs_flag\r
                  , ad_run_dt\r
                  , vdc_final_payment_amount\r
                  , vs_final_fiscal_category_cd\r
                  , vs_eligiblity_status_cd) a into\r
                   al_sqlcode\r
                  , as_error;--\r
\r
     IF al_sqlcode <> 0 THEN\r
       as_error = as_error  ;--\r
      IF as_error is NULL OR as_error = '' THEN\r
        as_error := 'SP_ACCOUNT_TRANSACTION_INSERT failed - IV-E Money'  ;--\r
      END IF;--\r
      --SIGNAL p_sp_error  ;--\r
     END IF ;--\r
    END IF;--\r
   END IF;    --\r
  END IF; -- FINAL AMOUNT NOT ZERO\r
  --COMMIT;--\r
 END IF; -- PAYMENT NOT STAMPED \r
--END FOR;--\r
END Loop;\r
\r
--COMMIT;--\r
\r
PERFORM SP_CHILD_ACCOUNT_RELEASE_COC(ad_run_dt);--\r
RETURN 0;\r
--END P1\r
END;\r
\r
$function$

