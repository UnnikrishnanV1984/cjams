CREATE OR REPLACE FUNCTION prov_addupdatecpaclearnceinfo(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                               
 v_providerId bigint;                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying; 
 v_applicantId character varying;   
 i json;               
 v_cpa_provider_id bigint;
 v_provider_cpa_adop_person_id bigint;
 v_cpa_request_date timestamp ;
 v_cpa_result_date timestamp ;
 v_isclearnce_family_record bool ;
 v_isclearnce_comar bool ;
    v_isdraft bool ;
 v_clearnce_type character varying;
    clearnce json;
   v_check int;

 begin                                                                                                                                                                                                                                                                                                                                                                                                 
   v_providerId := insertobj->>'provider_id';                                                                                                                                                                                                                                                                                                                                                            
   v_securityuserid := insertobj->>'securityuserid';  
   v_provider_cpa_adop_person_id := insertobj->>'provider_cpa_adop_person_id';
   v_cpa_provider_id := insertobj->>'cpa_provider_id';
   clearnce := insertobj->>'clearanceData';
  v_isdraft := insertobj->>'is_draft';
 
 select count(*) into v_check from tb_prov_cpa_clearnce where provider_cpa_adop_person_id=v_provider_cpa_adop_person_id;

if v_check > 0 then 

update tb_prov_cpa_clearnce set active_flag=0 where provider_cpa_adop_person_id=v_provider_cpa_adop_person_id;

end if;
                                                                                                                                                                                                                                                                                                                                                                                                        
FOR i IN SELECT * FROM json_array_elements(clearnce)

loop



                                                                                                                                                                                                                                                                                                                                                                                              
INSERT INTO tb_prov_cpa_clearnce 
(provider_id,is_draft,cpa_request_date,cpa_result_date,isclearnce_family_record,isclearnce_comar,clearnce_type,provider_cpa_adop_person_id,cpa_provider_id,
create_ts,create_user_id,update_ts,update_user_id,active_flag,outcomeclearance)                                                                                                                                         
values( v_providerId::int4, v_isdraft,(i->>'cpa_request_date')::timestamp,(i->>'cpa_result_date')::timestamp,
(i->>'isclearnce_family_record')::bool,(i->>'isclearnce_comar')::bool,(i->>'clearnce_type')::character varying,v_provider_cpa_adop_person_id,v_cpa_provider_id,
now(),v_securityuserid,now(),v_securityuserid,1,(i->>'outcomeclearance')::character varying);          
    

end loop;

return 'success';  
                                                                                                                                                                                                                                                                                                                                                                                              
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

