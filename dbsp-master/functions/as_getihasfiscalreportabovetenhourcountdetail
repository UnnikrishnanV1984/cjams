a_day30 bool;
a_day31 bool;

begin
 v_date := now() :: date;
    v_year := to_char(v_date,'YYYY');
 v_month := to_char(v_date,'MM');
 nextyear := (v_year :: integer) + 1;
 beforeyear := (v_year :: integer) - 1;
 if (v_month :: integer) > 6 then
  v_startdate := CONCAT('07-01-', v_year);
  v_enddate :=  CONCAT('06-30-', nextyear);
 end if;
 if (v_month :: integer) < 6 then
  v_startdate := CONCAT('07-01-', beforeyear);
  v_enddate :=  CONCAT('06-30-', v_year);
 end if;
 RAISE NOTICE 'else(%)', v_startdate;
 RAISE NOTICE 'else(%)', v_enddate;
 RAISE NOTICE 'else(%)', to_char(v_date,'YYYY');


