CREATE OR REPLACE FUNCTION as_sendicpcnotification(v_securityusersid character varying, v_msg character varying, v_objectid character varying, v_intakeserviceid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$




declare 

v_record record;
v_recordnew record;
v_youthname text;
v_cjamspid character varying;
v_send_notification character varying;
v_username text;
v_msgs text;
v_servicerequestnumber character varying;

begin
 
FOR  v_record  in

select distinct fromsecurityusersid from routing
where objectid=v_objectid  and fromroleid in ('JSCW','JSCSP','JSRS')
  
 loop 

 select send_notification into v_send_notification from as_send_notification(v_record.fromsecurityusersid,v_securityusersid,
 v_record.fromsecurityusersid::character varying,'System'::character varying,'High'::character varying,v_msg::character varying,v_msg::character varying,v_intakeserviceid::character varying,false);
  

 END  LOOP;
 
 FOR  v_recordnew  in

select tma.securityusersid 
   
        FROM    as_teammemberassignment tma 
        INNER JOIN  teammember tm 
         ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
       
   where tm.roletypekey in ('JSRD','JSARD')  
  
 loop 

 select send_notification into v_send_notification from as_send_notification(v_recordnew.securityusersid,v_securityusersid,
 v_recordnew.securityusersid::character varying,'System'::character varying,'High'::character varying,v_msg::character varying,v_msg::character varying,v_intakeserviceid::character varying,false);
  

 END  LOOP;

return 'Success';

 
end;


 


$function$

