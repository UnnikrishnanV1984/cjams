CREATE OR REPLACE FUNCTION as_sp_manual_receivable_dashboard(v_routingstatustypeid integer, v_securityuserid character varying, pagenumber bigint, pagesize bigint, v_statusval character varying)
 RETURNS TABLE(totalcount bigint, provider_id integer, provider_nm character varying, receivable_detail_id integer, payment_detail_id integer, receivable_id integer, amount_no numeric, receivable_balance_no numeric, comments_tx text, start_dt date, end_dt date, manual_sw character, notes_tx text, approval_status_cd character varying, action_dt date, approve_staff_id integer, requested_by character varying, assigned_to character varying, routingstatustypeid integer)
 LANGUAGE plpgsql
AS $function$



DECLARE

 v_pageoffset int;

    v_pagenumber int;

   v_routing int[];

 

BEGIN



 v_pagenumber := pagenumber-1;

    v_pageoffset = v_pagenumber * pagesize;

   

    if(v_statusval = 'P')

 then

 v_routing := '{73}';

 else if(v_statusval = 'A')

 then

 v_routing := '{74}' ;

 else if(v_statusval = 'R')

 then

 v_routing :='{75}' ;

 else if(v_statusval = 'All')

 then

 v_routing := '{73,74,75}';

 end if;

 end if;

 end if;

 end if;

   

   if(v_routingstatustypeid = 73)

 then
 return query 

select count(1) over(),tp.provider_id
,CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') 
THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END AS provider_nm
, trd.receivable_detail_id, trd.payment_detail_id, trd.receivable_id, trd.amount_no, trd.receivable_balance_no,
trd.comments_tx:: TEXT, trd.start_dt, trd.end_dt,
trd.manual_sw,  trd.notes_tx:: TEXT, trd.approval_status_cd, trd.action_dt, trd.approve_staff_id, 
up.fullname as requested_by,up1.fullname as assigned_to,r.routingstatustypeid
from as_tb_receivable_detail trd
join as_tb_receivable_header trh on trh.receivable_id = trd.receivable_id 
join prov.tb_provider tp on tp.provider_id = trh.provider_id
join routing r on trd.receivable_detail_id :: character varying = r.objectid 
join userprofile up on up.securityusersid = r.fromsecurityusersid
join userprofile up1 on up1.securityusersid = r.tosecurityusersid
where r.eventcode = 'MANREC' and r.routingstatustypeid =any (v_routing)
and r.fromsecurityusersid = v_securityuserid order by trd.receivable_detail_id desc
LIMIT pagesize OFFSET v_pageoffset;


else if(v_routingstatustypeid = 74)

then



 return query 

select count(1) over(),tp.provider_id
,CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') 
THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END AS provider_nm
, trd.receivable_detail_id, trd.payment_detail_id, trd.receivable_id, trd.amount_no, trd.receivable_balance_no,
trd.comments_tx:: TEXT, trd.start_dt, trd.end_dt,
trd.manual_sw,  trd.notes_tx:: TEXT, trd.approval_status_cd, trd.action_dt, trd.approve_staff_id, 
up.fullname as requested_by,up1.fullname as assigned_to,r.routingstatustypeid
from as_tb_receivable_detail trd
join as_tb_receivable_header trh on trh.receivable_id = trd.receivable_id 
join prov.tb_provider tp on tp.provider_id = trh.provider_id
join routing r on trd.receivable_detail_id :: character varying = r.objectid 
join userprofile up on up.securityusersid = r.fromsecurityusersid
join userprofile up1 on up1.securityusersid = r.tosecurityusersid
where r.eventcode = 'MANREC' and r.routingstatustypeid =any (v_routing)
and r.tosecurityusersid = v_securityuserid order by trd.receivable_detail_id desc
LIMIT pagesize OFFSET v_pageoffset;



end if;

end if;

END;



$function$

