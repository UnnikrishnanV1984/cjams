CREATE OR REPLACE FUNCTION prov_getrelicensingapplications(v_object json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$         
         
declare
         
v_listdata json;
 
BEGIN
    select json_agg(x) into v_listdata from (
        select ta.*,up.fullname as created_by,ta.application_status as application_decision_status,
        (select up2.fullname 
            from tb_provider_decision tpd 
            left join userprofile up2 on tpd.fromsecurityusersid = up2.securityusersid
            where tpd.objectid = ta.applicant_id and tpd.status = 'Approved' order by tpd.insertedon desc limit 1)  as approved_by,
        (select tpd.insertedon 
            from tb_provider_decision tpd 
            left join userprofile up2 on tpd.fromsecurityusersid = up2.securityusersid
            where tpd.objectid = ta.applicant_id and tpd.status = 'Approved' order by tpd.insertedon desc limit 1)  as approval_date
        from tb_provider_applicant ta
        left join userprofile up on ta.create_user_id = up.securityusersid
        where   ta.site_id=(v_object->>'site_id')::int4 
            and ta.application_type=(v_object->>'applicationtype')
    )x;
    return v_listdata;
END; 

$function$

