CREATE OR REPLACE FUNCTION fn_program_upd()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN


-----primary program area CPS/AR

 insert into programupdatetrigger ( sourcesystem,
          statusflag ,
          cjamspid ,
          cisclientid ,
          casenumber ,
          programcasestatus,
          programcode ,
          effectivestartdate,
          effectiveenddate,
          headofhousehold,
          errorcode ,
          insertedon  ,
          insertedby ,
          updatedon ,
          updatedby)
   select  distinct
          'CJ',
          'READY',
          p.cjamspid,
          p.cisclientid,
          isr.servicerequestnumber,
          st.Description,
          isr.actiontype,
          (select max(insertedon) from routing
                                        where eventcode='INVT' and fromroleid='CWSP' and toroleid='CWCW' and objectid=isr.intakeserviceid::varchar and activeflag=1),
          max(sd.insertedon),
           case when isra.isheadofhousehold =true then 'Y' end,
           0000,
           now(),
           'system',
           now(),
            'system'     
           from 
                  intakeservicerequest isr 
                   join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid 
                   join investigation inve on inve.intakeserviceid=isr.intakeserviceid
                   join person p on p.personid = isra.personid
                   join IntakeServiceRequestDispositionCode sd  on sd.IntakeServiceId=isr.IntakeServiceId and sd.activeflag=1
                   join IntakeSerReqStatusType st on st.IntakeSerReqStatusTypeid = sd.IntakeSerReqStatusTypeid  and st.activeflag=1
                   join personprogramarea ppa on ppa.personid=p.personid and ppa.activeflag=1 
                  
                    where ppa.objectid=isr.intakeserviceid::varchar and
                   inve.activeflag=1 and isra.activeflag=1 and p.activeflag=1 and 
                     st.Description in ('Completed')
      and isr.intakeserviceid=NEW.intakeserviceid
                     and isra.intakeservicerequestpersontypekey in ('OTHERCHILD','BIOCHILD','CHILD','AV') and isr.actiontype='AR'
                  group by 
          p.cjamspid,
          p.cisclientid,
          isr.servicerequestnumber,
          st.Description,
          isr.actiontype,
          (select max(insertedon) from routing
                                        where eventcode='INVT' and fromroleid='CWSP' and toroleid='CWCW' and objectid=isr.intakeserviceid::varchar and activeflag=1), 
                                        case when isra.isheadofhousehold =true then 'Y' end;
                                         
                     
-------primary program area CPS-IR 

       insert into programupdatetrigger ( sourcesystem,
          statusflag ,
          cjamspid ,
          cisclientid ,
          casenumber ,
          programcasestatus,
          programcode ,
          effectivestartdate,
          effectiveenddate,
          headofhousehold,
          errorcode ,
          insertedon  ,
          insertedby ,
          updatedon ,
          updatedby)
   select  distinct
          'CJ',
          'READY',
          p.cjamspid,
          p.cisclientid,
          isr.servicerequestnumber,
          st.Description,
          isr.actiontype,
          (select max(insertedon) from routing
                                        where eventcode='INVT' and fromroleid='CWSP' and toroleid='CWCW' and objectid=isr.intakeserviceid::varchar and activeflag=1),
          max(sd.insertedon),
           case when isra.isheadofhousehold =true then 'Y' end,
           0000,
           now(),
           'system',
           now(),
            'system'     
           from 
                  intakeservicerequest isr 
                   join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid 
                   join investigation inve on inve.intakeserviceid=isr.intakeserviceid
                   join person p on p.personid = isra.personid
                   join IntakeServiceRequestDispositionCode sd  on sd.IntakeServiceId=isr.IntakeServiceId and sd.activeflag=1
                   join IntakeSerReqStatusType st on st.IntakeSerReqStatusTypeid = sd.IntakeSerReqStatusTypeid  and st.activeflag=1
                   join personprogramarea ppa on ppa.personid=p.personid and ppa.activeflag=1 
                  
                    where ppa.objectid=isr.intakeserviceid::varchar and
                   inve.activeflag=1 and isra.activeflag=1 and p.activeflag=1 and 
                     st.Description in ('Completed')
       and isr.intakeserviceid=NEW.intakeserviceid
                     and isra.intakeservicerequestpersontypekey in ('OTHERCHILD','BIOCHILD','CHILD','AV') and isr.actiontype='IR'
                  group by 
          p.cjamspid,
          p.cisclientid,
          isr.servicerequestnumber,
          st.Description,
          isr.actiontype,
          (select max(insertedon) from routing
                                        where eventcode='INVT' and fromroleid='CWSP' and toroleid='CWCW' and objectid=isr.intakeserviceid::varchar and activeflag=1), 
                                        case when isra.isheadofhousehold =true then 'Y' end;
                                         
  
 



return new;
END;

$function$

