CREATE OR REPLACE FUNCTION as_test2(id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ declare

mv record;

v_array_length integer;

v_ref_key varchar;

v1 varchar;

v_list varchar;

v_list_final jsonb;

ic integer = 0;
begin

for mv in (
 select personid,
 majorhistoryproblem
from
 personfmlymdclhstry
where
 personfmlymdclhstryid = id
    and activeflag = 1
 --and famhistclient = famhist_client :: varchar
 ) loop

foreach v1 in array  string_to_array(mv.majorhistoryproblem, ',')  loop

select
 ref_key, value_text into 
   v_ref_key , v_list
 from
  referencevalues
 where
  ref_key = v1 ;
--raise notice '%' ,json_build_object(v_ref_key,v_list);

if(ic = 0) then

   v_list_final := jsonb_build_object(v_ref_key,v_list);
   raise notice '%' , v_list_final;
else
v_list_final := v_list_final  || jsonb_build_object(v_ref_key,v_list);
end if;
 --v_list_final := v_list_final || v1 ||',';
--v_list_final := v_list_final + " ";
ic := ic + 1;
end loop;
end loop;
raise notice '%' , v_list_final;
return v_list_final  /*select a[1] ,a[2] from ( select string_to_array(majorhistoryproblem,',') from personfmlymdclhstry ) as dt(a)

select max(array_length(regexp_split_to_array(majorhistoryproblem, ','), 1)) into v_array_length
from personfmlymdclhstry*/;
end;

$function$

