CREATE OR REPLACE FUNCTION as_getserviceplangoaldetails(v_objectid character varying, fromdate character varying, todate character varying)
 RETURNS TABLE(serviceplangoaldetailsid uuid, goal character varying, goaldescription character varying, goalstartdate timestamp without time zone, goalenddate timestamp without time zone, goaldisposition character varying, involvedpersons character varying, unabletocompletereason character varying, serviceplangoalid uuid, other text, json_agg json)
 LANGUAGE plpgsql
AS $function$


begin
 
RETURN  QUERY

 select spg.serviceplangoaldetailsid, spg.goal, rv.description as goaldescription, spg.goalstartdate , spg.goalenddate , spg.goaldisposition ,spg.involvedpersons, spg.unabletocompletereason , spg.serviceplangoalid , spg.other,
(select json_agg(object1) from (select distinct g.goalobjectiveid,g.unabletocompletereason,g.involvedpersons,g.serviceplangoaldetailsid,g.objective,g.startdate,g.enddate,g.disposition,r.description,
g.activeflag, g.other
from goalobjectives g 
left join referencevalues r on r.ref_key=g.objective
where spg.serviceplangoaldetailsid=g.serviceplangoaldetailsid) object1)
from serviceplangoaldetails spg
left join referencevalues rv on rv.ref_key=spg.goal and rv.activeflag=1 and rv.teamtypekey = 'AS'
where spg.activeflag=1 and spg.serviceplangoalid :: character varying=v_objectid
 and
case when fromDate is not null then spg.goalstartdate >= TO_DATE(fromDate, 'MM/DD/YYYY')  else true end
and
case when toDate is not null then spg.goalstartdate <= TO_DATE(toDate, 'MM/DD/YYYY')  else true end
group by spg.serviceplangoaldetailsid, spg.goal, rv.description, spg.goalstartdate ,
spg.goalenddate , spg.goaldisposition , spg.unabletocompletereason , spg.serviceplangoalid,
spg.other,spg.involvedpersons   
 order by spg.goalstartdate desc
; 

End;


$function$

