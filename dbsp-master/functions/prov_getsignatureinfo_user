CREATE OR REPLACE FUNCTION prov_getsignatureinfo_user(v_userid character varying)
 RETURNS TABLE(user_id character varying, signature json, signature_id character varying, create_ts character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                             
                                                                                                                                                                                           
 declare                                                                                                                                                                                   
                                                                                                                                                                                           
                                                                                                                                                        
                                                                                                                                                                                           
 begin                                                                                                                                                                                     
                                                                                                                                                                      
                                                                                                                                                                                           
         RETURN QUERY SELECT ptr.user_id, ptr.signature , ptr.signature_id,ptr.create_ts
         FROM prov_user_signature ptr where ptr.user_id = v_userid  and ptr.delete_sw='N'                                                                                                                
         order by ptr.create_ts desc;                                                                                                                                                     
 end;                                                                                                                                                        
                                                                                                                                                                                           
 $function$

