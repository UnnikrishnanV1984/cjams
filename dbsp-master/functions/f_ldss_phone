CREATE OR REPLACE FUNCTION f_ldss_phone(as_staffid integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
BEGIN 
RETURN (
select '('||
substr(coalesce(workphone ,''),1,3)||
')'||
substr(coalesce(workphone ,''),4,3)||
'-'||
substr(coalesce(workphone ,''),7,4)||
' '||
'Ext:'||
(coalesce(workextn ,''))
    FROM LDSSLOCATIONS,
     TB_STAFF
WHERE 
TB_STAFF.LDSS_LOCATION_ID = cast(LDSSLOCATIONS.old_id as integer) AND
TB_STAFF.STAFF_ID = as_staffID AND  
ldssLOCATIONS.activeflag = 0 AND
TB_STAFF.DELETE_SW = 'N' );

END ;
$function$

