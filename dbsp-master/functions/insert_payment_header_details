CREATE OR REPLACE FUNCTION insert_payment_header_details(id_providerid uuid)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_pageoffset int;
 v_pagenumber int;
 v_state int;
 v_payment_id bigint;
 v_payment_detail_id bigint;
BEGIN
 Select (max(payment_id)+1) INTO v_payment_id from tb_payment_header;
 Select (max(payment_detail_id)+1) INTO v_payment_detail_id from tb_payment_detail;

INSERT INTO tb_payment_header (payment_id, provider_id,-- payment_type_cd, 
           gross_amount_no,payment_dt,
 create_user_id, update_user_id,delete_sw,payment_start_dt, payment_end_dt)
select v_payment_id,CAST (p.providercode AS INTEGER),--p.providercategorytypekey,
  --p.providername,
  --p.providerstatustypekey,
  pcontrate.rate,pcontrate.insertedon,
  'admin',
  --pcontrate.insertedby,
  'admin',
  'n',
  now(),now()
 from provider AS p 
left join providercontract pcont on p.providerid = pcont.providerid and pcont.activeflag = 1
left join providercontractrate pcontrate on pcontrate.providercontractid = pcont.providercontractid and pcontrate.activeflag = 1
where p.providerid=id_providerid::uuid; 

INSERT INTO tb_payment_detail (payment_detail_id, payment_id,-- payment_type_cd, 
           
 create_user_id, update_user_id,delete_sw)
select v_payment_detail_id,v_payment_id,--p.providercategorytypekey,
  --p.providername,
  --p.providerstatustypekey,
  
  'admin',
  --pcontrate.insertedby,
  'admin',
  'n'
 from provider AS p 
left join providercontract pcont on p.providerid = pcont.providerid and pcont.activeflag = 1
left join providercontractrate pcontrate on pcontrate.providercontractid = pcont.providercontractid and pcontrate.activeflag = 1
where p.providerid=id_providerid::uuid;
 v_state := 1;
Return v_state;
 END;

$function$

