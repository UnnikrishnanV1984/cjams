CREATE OR REPLACE FUNCTION getcourtorder(v_intakeserviceid uuid)
 RETURNS TABLE(intakeservreqcourtorderid uuid, intakeservicerequestactorid uuid, intakeservicerequestpetitionid uuid, intakeservicerequesthearingid uuid, courtorderdate timestamp without time zone, remarks character varying, removalepisode bigint, hearingoutcometypekey character varying, hearingoutcomedesc character varying, childpermanencyplankey character varying, childpermanencyplantype character varying, hearingoutcome json, attachments json, courtdetails json, personid uuid)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                                                                       
 BEGIN                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                       
 RETURN query                                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                       
 SELECT                                                                                                                                                                                                                                                                                                                                                                                
         isrco.intakeservreqcourtorderid,isrco.intakeservicerequestactorid,isrco.intakeservicerequestpetitionid,isrco.intakeservicerequesthearingid , isrco.courtorderdate,isrco.remarks,isrco.removalid as removalepisode, ppt.ref_key AS hearingoutcometypekey,                                                                                                                                                                                                                                 
         ppt.description AS hearingoutcomedesc,isrco.childpermanencyplankey,rtd.description as childpermanencyplantype,                                                                                                                                                                                                                                                                
         (                                                                                                                                                                                                                                                                                                                                                                             
                                         SELECT                                                                                                                                                                                                                                                                                                                                        
                                                 json_agg(outcome) AS hearingoutcome                                                                                                                                                                                                                                                                                                   
                                         FROM                                                                                                                                                                                                                                                                                                                                          
                                         (                                                                                                                                                                                                                                                                                                                                             
                                                 SELECT                                                                                                                                                                                                                                                                                                                                
                                                         isrhoc.hearingoutcometypekey,rvs.description AS hearingoutcomedesc                                                                                                                                                                                                                                                            
                                                 FROM Intakeservreqcohearingoutcome isrhoc                                                                                                                                                                                                                                                                                             
                                                 INNER JOIN referencevalues rvs ON rvs.ref_key=isrhoc.hearingoutcometypekey AND rvs.activeflag=1                                                                                                                                                                                                                                       
                                                 WHERE isrhoc.intakeservreqcourtorderid=isrco.intakeservreqcourtorderid AND isrhoc.activeflag=1                                                                                                                                                                                                                                        
                                         ) outcome                                                                                                                                                                                                                                                                                                                                     
                                 ),                                                                                                                                                                                                                                                                                                                                                    
         (                                                                                                                                                                                                                                                                                                                                                                             
                                         SELECT                                                                                                                                                                                                                                                                                                                                        
                                                 json_agg(doc) AS attachments                                                                                                                                                                                                                                                                                                          
                                         FROM                                                                                                                                                                                                                                                                                                                                          
                                         (                                                                                                                                                                                                                                                                                                                                             
                                                 SELECT  dp.filename,  dp.title,  dp.mime,  dp.numberofbytes, dp.s3bucketpathname,  dp.originalfilename                                                                                                                                                                                                                                
                                                          from documentproperties dp where dp.objectid = isrco.intakeservreqcourtorderid                                                                                                                                                                                                                                               
                                         ) doc                                                                                                                                                                                                                                                                                                                                         
                                 ),                                                                                                                                                                                                                                                                                                                                                    
         (                                                                                                                                                                                                                                                                                                                                                                             
                 SELECT                                                                                                                                                                                                                                                                                                                                                                
                         json_agg(e) AS courtdetails FROM                                                                                                                                                                                                                                                                                                                              
                 (                                                                                                                                                                                                                                                                                                                                                                     
                         SELECT                                                                                                                                                                                                                                                                                                                                                        
                                 isrcod.intakeservreqcourtorderdetailsid,isrcod.checklistid,isrcod.checklisttypekey,isrcod.isselected,isrcod.remarks,                                                                                                                                                                                                                                  
                                 (                                                                                                                                                                                                                                                                                                                                                     
                                         SELECT                                                                                                                                                                                                                                                                                                                                        
                                                 json_agg(x) AS courtlanguage                                                                                                                                                                                                                                                                                                          
                                         FROM                                                                                                                                                                                                                                                                                                                                          
                                         (                                                                                                                                                                                                                                                                                                                                             
                                                 SELECT                                                                                                                                                                                                                                                                                                                                
                                                         cl.checklistname,cl.description AS checklistdesc                                                                                                                                                                                                                                                                              
                                                 FROM checklist cl                                                                                                                                                                                                                                                                                                                     
                                                 INNER JOIN referencevalues rvs ON rvs.ref_key=isrcod.checklisttypekey AND rvs.activeflag=1                                                                                                                                                                                                                                            
                                                 WHERE isrcod.intakeservreqcourtorderid=isrco.intakeservreqcourtorderid AND isrcod.activeflag=1 AND rvs.ref_key='COLANG'                                                                                                                                                                                                               
                                         )  x                                                                                                                                                                                                                                                                                                                                          
                                 ),                                                                                                                                                                                                                                                                                                                                                    
                                 (                                                                                                                                                                                                                                                                                                                                                     
                                         SELECT                                                                                                                                                                                                                                                                                                                                        
                                                 json_agg(y) AS courtpermanencyplan                                                                                                                                                                                                                                                                                                    
                                         FROM                                                                                                                                                                                                                                                                                                                                          
                                         (                                                                                                                                                                                                                                                                                                                                             
                                                 SELECT                                                                                                                                                                                                                                                                                                                                
                                                         cl.checklistname,cl.description AS checklistdesc                                                                                                                                                                                                                                                                              
                                                 FROM checklist cl                                                                                                                                                                                                                                                                                                                     
                                                 INNER JOIN referencevalues rvs ON rvs.ref_key=isrcod.checklisttypekey AND rvs.activeflag=1                                                                                                                                                                                                                                            
                                                 WHERE isrcod.intakeservreqcourtorderid=isrco.intakeservreqcourtorderid AND isrcod.activeflag=1 AND rvs.ref_key='COPP'                                                                                                                                                                                                                 
                                         ) y                                                                                                                                                                                                                                                                                                                                           
                                 ),                                                                                                                                                                                                                                                                                                                                                    
                                 (                                                                                                                                                                                                                                                                                                                                                     
                                         SELECT                                                                                                                                                                                                                                                                                                                                        
                                                 json_agg(z) AS courthearingoutcome                                                                                                                                                                                                                                                                                                    
                                         FROM                                                                                                                                                                                                                                                                                                                                          
                                         (                                                                                                                                                                                                                                                                                                                                             
                                                 SELECT                                                                                                                                                                                                                                                                                                                                
                                                         cl.checklistname,cl.description AS checklistdesc                                                                                                                                                                                                                                                                              
                                                 FROM checklist cl                                                                                                                                                                                                                                                                                                                     
                                                 INNER JOIN referencevalues rvs ON rvs.ref_key=isrcod.checklisttypekey AND rvs.activeflag=1                                                                                                                                                                                                                                            
                                                 WHERE isrcod.intakeservreqcourtorderid=isrco.intakeservreqcourtorderid AND isrcod.activeflag=1 AND rvs.ref_key='COHO'                                                                                                                                                                                                                 
                                         ) z                                                                                                                                                                                                                                                                                                                                           
                                 )                                                                                                                                                                                                                                                                                                                                                     
                         FROM intakeservreqcourtorderdetails isrcod                                                                                                                                                                                                                                                                                                                    
                         WHERE isrcod.intakeservreqcourtorderid=isrco.intakeservreqcourtorderid AND isrcod.activeflag=1                                                                                                                                                                                                                                                                
                 )  e                                                                                                                                                                                                                                                                                                                                                                  
         ),
         (select ac.personid from intakeservicerequestactor isra join actor ac on ac.actorid = isra.actorid where isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid)                                                                                                                                                                                                                                                                                                                                                                      
 FROM intakeservreqcourtorder isrco                                                                                                                                                                                                                                                                                                                                                    
 LEFT JOIN referencevalues ppt ON ppt.ref_key=isrco.hearingoutcometypekey AND ppt.activeflag=1                                                                                                                                                                                                                                                                                         
 left join referencevalues rtd on rtd.ref_key=isrco.childpermanencyplankey and rtd.referencetypeid=137 and rtd.activeflag=1                                                                                                                                                                                                                                                            
 WHERE isrco.activeflag=1 AND isrco.intakeserviceid=v_intakeserviceid;                                                                                                                                                                                                                                                                                                                 
 END;                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                                       
 $function$

