CREATE OR REPLACE FUNCTION as_createpersonworkcarrer(personjson json, v_personid uuid, securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

persondata json;
p_Personid uuid;
v_securityuserid character varying;
s_CarrerWorkObj json;
s_EmployerDetails json;
v_personworkcarrergoalid uuid;
l_Status character varying;
i json; 
j json;
v_date timestamp without time zone;


BEGIN

persondata := personjson;
p_Personid := v_personid;
v_date:= now() ;
v_securityuserid := securityuserid;

 CREATE TEMP TABLE temp_sp_Create_Temp_personworkcarrergoal1  ( 
      personworkcarrergoalid character varying,
      personid character varying,
      careergoals character varying,      
      isNew int default 0);  
      
     

CREATE TEMP TABLE temp_sp_Create_Temp_personemployerdetail1  ( 
      personemployerdetailid character varying,
      personid character varying,
      employernmae character varying,
      currentemployer boolean,
      noofhours  character varying,
      duties character varying,
      startdate date,
      enddate date, 
      reasonforleaving character varying,
      careergoals character varying,
      isNew int default 0);  
      
      

     
FOR i IN SELECT * FROM json_array_elements(personjson)
LOOP

   s_CarrerWorkObj:= i->>'personworkcarrergoal';

   insert into temp_sp_Create_Temp_personworkcarrergoal1
   select   * from json_to_recordset(s_CarrerWorkObj ) as x("personworkcarrergoalid" character varying,
   "personid" character varying,
   "careergoals" character varying );  
   
  
 update temp_sp_Create_Temp_personworkcarrergoal1 set  isNew =1 where coalesce(personworkcarrergoalid,'') =''; 

 UPDATE personworkcarrergoal SET activeflag=0, updatedby = v_securityuserid, updatedon = v_date
 WHERE personworkcarrergoalid  in (select personworkcarrergoalid::uuid from temp_sp_Create_Temp_personworkcarrergoal1 where isnew=0); 

    INSERT INTO personworkcarrergoal( personid, careergoals,             
    activeflag,insertedby, updatedby, insertedon, updatedon)

    SELECT p_Personid::uuid,careergoals,
    1,v_securityuserid,v_securityuserid, v_date, v_date
    FROM   temp_sp_Create_Temp_personworkcarrergoal1 WHERE isNew=1; 
   
   
 
  
  For j in Select * from json_array_elements(personjson)
     loop
     
      s_EmployerDetails:= j->>'employerdetails';
     
     RAISE NOTICE ' test %',s_EmployerDetails; 
 
   insert into temp_sp_Create_Temp_personemployerdetail1
 select   * from json_to_recordset(s_EmployerDetails ) 
 as x("personemployerdetailid" character varying,
    "personid" character varying,
    "employernmae" character varying,
    "currentemployer" boolean,
    "noofhours"  character varying,
    "duties" character varying,
    "startdate" date,
    "enddate" date, 
    "reasonforleaving" character varying,
    "careergoals" character varying); 
   
   
   
 update temp_sp_Create_Temp_personemployerdetail1 set  isNew =1 where coalesce(personemployerdetailid,'') ='';

 UPDATE personemployerdetail SET activeflag=0, updatedby = v_securityuserid, updatedon = v_date
 WHERE personemployerdetailid  in
 (select personemployerdetailid::uuid from temp_sp_Create_Temp_personemployerdetail1 where isnew=0); 
 
  
 select pws.personworkcarrergoalid  into v_personworkcarrergoalid from personworkcarrergoal AS pws 
   order by personworkcarrergoalid  desc  limit 1;
  

    INSERT INTO personemployerdetail( personid, employernmae, currentemployer,
    noofhours, duties, startdate, enddate, reasonforleaving, careergoals, personworkcarrergoalid,            
    activeflag,insertedby, updatedby, insertedon, updatedon)

    SELECT p_Personid::uuid,employernmae,currentemployer, 
    noofhours, duties, startdate, enddate, reasonforleaving, careergoals,v_personworkcarrergoalid::uuid,
    1,v_securityuserid,v_securityuserid, v_date, v_date FROM  
    temp_sp_Create_Temp_personemployerdetail1 WHERE isNew=1; 
   
   
  
   
 END LOOP;

END LOOP;      


    

l_Status := 'SUCCESS';

DROP TABLE temp_sp_Create_Temp_personworkcarrergoal1;
DROP TABLE temp_sp_Create_Temp_personemployerdetail1;


return l_Status;


END

$function$

