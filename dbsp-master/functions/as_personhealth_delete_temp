CREATE OR REPLACE FUNCTION as_personhealth_delete_temp(personphycisianinfoid uuid, person_id uuid, health json, insertedby character varying, isnew integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
declare
  --v_result varchar(250);
     response varchar;
  v_insertedby varchar;
     v_person_id uuid;
        v_personphycisianinfoid uuid;
  v_health json; 
  v_isnew integer; 
  v_providerinfojson json;
  v_providerinfo json;
  v_providerinfophysician json;
  v_providerinfodentist json;

  --p_insertedby varchar;
  --p_isnew integer;
  v_is_primary_care_physician  boolean;
  v_physician_name varchar;
  v_physician_speciality varchar;
  v_hysician_facility varchar;
  v_physician_address1 varchar;
  v_physician_address2 varchar;
  v_physician_phone varchar;
  v_hysician_email varchar;
  v_physician_city varchar;
  v_physician_state varchar;
  v_physician_county varchar;
  v_physician_zipcode varchar;
  v_physician_child_lang_check varchar;
  v_translation_service_available varchar;
  v_start_Date timestamp ;
  v_End_Date timestamp  ;
 
begin
  v_person_id := person_id;
        v_personphycisianinfoid:=personphycisianinfoid;
  v_health := health;
  v_providerinfojson := v_health ->> 'personProviderHistory';
  v_providerinfophysician:=json_array_elements((v_health -> 'personProviderHistory') :: json) -> 'provider_info' ;
  v_insertedby := insertedby;
  v_isnew := isnew;
  response := 'sucess';
  
 if isnew = 1 then
 
 for v_providerinfo in (select * from json_array_elements(v_providerinfophysician) )
  loop
  
   
    --v_insertedby :=insertedby;
    v_is_primary_care_physician:=(v_providerinfo  ->>'is_primary_care_physician'):: boolean;
   v_physician_name:=v_providerinfo  ->>'physician_name';
         /*v_physician_speciality:=v_providerinfo  ->>'physician_speciality';
   v_hysician_facility:=v_providerinfo  ->>'physician_facility';
   v_physician_address1:=v_providerinfo  ->>'physician_address1';
   v_physician_address2:=v_providerinfo  ->>'physician_address2';
   v_physician_phone:=v_providerinfo  ->>'physician_phone';
   v_hysician_email:=v_providerinfo  ->>'physician_email';
   v_physician_city:=v_providerinfo  ->>'physician_city';
   v_physician_state:=v_providerinfo  ->>'physician_state';
   v_physician_county:=v_providerinfo  ->>'physician_county';
   v_physician_zipcode:=v_providerinfo  ->>'physician_zipcode';
   v_physician_child_lang_check:=v_providerinfo  ->>'physician_child_lang_check';
   v_translation_service_available:=v_providerinfo  ->>'translation_service_available';*/
   v_start_Date:=v_providerinfo  ->>'start_Date';
   v_End_Date:=v_providerinfo  ->>'End_Date'; 
 
   DELETE FROM personphycisianinfo_temp t
   WHERE (t.personid = v_person_id
   and t.personphycisianinfoid= v_personphycisianinfoid
   and t.insertedby=v_insertedby
   and t.activeflag=v_isnew)
   and(t.isprimaryphycisian=v_is_primary_care_physician
      or t.name=v_physician_name
      or t.startdate = v_start_Date
      or t.enddate =v_End_Date);      
           
  end loop;
 end if;
 /*exception when others then
  begin
  v_result:='DBA ERROR';
  return v_result;
  end;*/
return response;
end;
$function$

