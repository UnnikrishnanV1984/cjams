CREATE OR REPLACE FUNCTION as_getdraftapmt(v_intakeserviceid uuid)
 RETURNS TABLE(s1 json)
 LANGUAGE plpgsql
AS $function$
   
BEGIN
    
     RETURN QUERY 
  select   json_agg(apmt) from ( select 
 null as history,
(select 
json_agg(e) from (
select p.personid as actorid,p.firstname,p.lastname,sraa.isoptional
from servicerequestappointmentactor sraa 
left join intakeservicerequestactor isra on isra.intakeservicerequestactorid = sraa.intakeservicerequestactorid
left join actor a on a.actorid = isra.actorid
left join person p on p.personid = a.personid
where sraa.servreqaptmtid = sra.servreqaptmtid
and sraa.activeflag = 1
) as e) as actors,
sra.appointmentdate as "appointmentDate",
extract(hour from sra.appointmentdate)||':'||extract(minute from sra.appointmentdate)||':'||extract(second from sra.appointmentdate) as appointmentTime,
sra.appointmentworkerid as "intakeWorkerId",sra.notes,sra.appointmentstatus as "status",sra.title,sra.appointmentworkerid ,sra.insertedby as "scheduledBy"
from servicerequestappointment sra 
where sra.intakeserviceid = v_intakeserviceid and activeflag =1) as apmt;
                          
END;

$function$

