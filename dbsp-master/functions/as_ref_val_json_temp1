CREATE OR REPLACE FUNCTION as_ref_val_json_temp1(v_input1 character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE    
    v_result json;
   
BEGIN
  
 Select json_agg(row) as output from 
         (select distinct ref_key as Key, value_text as V 
           from referencevalues 
           where ref_key in
              ( 
  
  select regexp_split_to_table(TRANSLATE('a!b#c^', '!@#$%^&*()', ''), ',') from 
  TEST_TABLE)) row
   
               
               into v_result;
              
              RETURN v_result;
             
             END;  
             
             $function$

