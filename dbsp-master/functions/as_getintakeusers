CREATE OR REPLACE FUNCTION as_getintakeusers(roletypekey character varying, skipno integer, pagesize integer)
 RETURNS TABLE(totalcount bigint, userid character varying, teamname character varying, username character varying, agencykey character varying, userrole text, loadnumber character varying, homelocationcode character varying, worklocationcode character varying, cjamspid bigint)
 LANGUAGE plpgsql
AS $function$ 
 
 DECLARE 
 v_roletypekey character varying = null;
 
BEGIN
v_roletypekey := roletypekey;                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
RETURN Query 
                SELECT
  count(1) over() totalcount,
  UP.securityusersid AS userid,
  T.teamname,
  --UP.fullname as username,
  CAST(UP.lastname||', '||UP.firstname AS character varying) as username,
  TMRT.teamtypekey AS agencykey ,
  replace(TMRT.description, ',' || TMRT.teamtypekey, '') userrole,
  TM.loadnumber ,
  upa.zipcode AS homelocationcode,
  upa.zipcodeplus AS worklocationcode,
  up.cjamspid
  FROM
   Team T
  INNER JOIN TeamMember TM ON
   TM.teamid = T.teamid
  INNER JOIN as_teammemberassignment TMA ON
   TMA.teammemberId = TM.teammemberid
  INNER JOIN TeamMemberRoleType TMRT ON
   TMRT.roletypekey = TM.roletypekey
  INNER JOIN TeamType TTY ON
   TTY.teamtypekey = TMRT.teamtypekey
  INNER JOIN UserProfile UP ON
   UP.securityusersid = TMA.securityusersid
  LEFT JOIN  UserProfileAddress UPA ON
   UPA.securityusersid = UP.securityusersid
   AND lower(UPA.userprofileaddresstypekey)= 'p' AND UPA.activeflag = 1
  WHERE
   TM.roletypekey = v_roletypekey
   AND T.activeflag = 1
   AND TM.activeflag = 1
   AND TMA.activeflag = 1
   AND TMRT.activeflag = 1
   AND UP.activeflag = 1
   --AND UPA.activeflag = 1
  ORDER BY
   T.teamname,
   CAST(UP.lastname||', '||UP.firstname AS character varying) 
  LIMIT pagesize offset skipno;                                                                                                                                                                                                                                   
END;                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                    
 $function$

