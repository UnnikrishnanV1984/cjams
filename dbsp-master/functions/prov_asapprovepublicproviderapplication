  service_paid_by, service_unit) 
  VALUES((v_providerId::int), 0, serviceId::int, null, null, '', '', '', now(),v_securityuserid, now(), v_securityuserid, 'N'::bpchar, 'Active', '', '', 0, serviceDescription, '', '');

 end if;
