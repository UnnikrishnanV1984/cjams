CREATE OR REPLACE FUNCTION as_updateinvsfindingpersonguardian(v_investigationfindingid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

Begin

     UPDATE investigationfindingtypeperson set activeflag = 0 where 
     investigationfindingid = v_investigationfindingid;
     UPDATE investigationfindingguardian set activeflag = 0 where 
     investigationfindingid = v_investigationfindingid;
    
  
  Return 'Success';
  
End;

$function$

