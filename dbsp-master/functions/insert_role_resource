CREATE OR REPLACE FUNCTION insert_role_resource(roleid integer, presourcename character varying, parentresourid uuid, resourcetype integer, l_count integer)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE
 l_roleid int;
 l_resourceid uuid;
 l_parentresourid uuid;

begin
select gen_random_uuid() into l_resourceid; 
if l_count = 0 then 
INSERT INTO resource
(id, parentid, resourcename, resourcetype, activeflag, insertedby, insertedon, updatedby, updatedon, resourceid, tooltip, old_id)
VALUES(l_resourceid, parentresourid, presourcename, resourcetype, 1, 'system', now(), 'system',  now(), NULL, NULL, NULL);
end if;
--role_resource
INSERT INTO role_resource
(roleid, resourceid, activeflag, insertedby, insertedon, updatedby, updatedon, isallowed, isvisible, isenabled, permissiontype, old_id)
VALUES(roleid, l_resourceid, 1, 'admin', now(), 'admin', now(), true, true, true, 2, NULL);


return 'Success';
END;
$function$

