CREATE OR REPLACE FUNCTION as_update_obligate_budget(authorization_id integer)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
/* This proc is for updating othe obligated amount when funding or payment is getting denied.
 * 
 * */
DECLARE  

 v_annualprogrambudgetid uuid; 
 v_sprvsr_approval_status_cd varchar(10);
 v_authorization_id integer;
 v_costno numeric;
BEGIN 
 v_authorization_id:= authorization_id;

    select spa.annualprogrambudgetid,trim(spa.sprvsr_approval_status_cd),spa.cost_no into v_annualprogrambudgetid,v_sprvsr_approval_status_cd,v_costno from tb_service_purchase_authorization spa where spa.authorization_id=v_authorization_id;

    IF(v_sprvsr_approval_status_cd is not null and v_sprvsr_approval_status_cd = '3047') then 
    update annualprogrambudget set obligatedamount=coalesce(obligatedamount,0) - v_costno,
 availableamount=coalesce(availableamount,0) + v_costno, updatedon=now() where annualprogrambudgetid::character varying = v_annualprogrambudgetid::character varying;
 end if;
 return 1;
END;

$function$

