CREATE OR REPLACE FUNCTION as_ref_val_json_tmp(p_input character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

declare 
v_result text;
test character varying;
v_input text;
i text;
val integer;
v_exp text:='!@#$%^`{}"-&*()';

begin

 for i in (SELECT attname  AS col
        FROM   pg_attribute
        WHERE  attrelid = p_input::regclass  -- table name, optionally schema-qualified
        AND    attnum > 0
        AND    NOT attisdropped
        ORDER  BY attnum)
            
            loop 
             v_input:=i;    
            raise notice 'Testing===fsdfdfdadf: %',v_input ;
           
           select id into v_exp from  p_input ;
   
           
             raise notice 'exp:%',v_exp;
            --raise notice 'exp:%',v_exp2;
          select regexp_split_to_table(translate(p_input,'|| v_exp ||',''), ',')     
          from test_table into val;
    raise notice 'result: %',val ;
            /*select json_agg(row) as output 
            from (select distinct ref_key,value_text
     from referencevalues             
     where ref_key in (select regexp_split_to_table(translate(test, '!@#$%^`{}"-&*()',''\\\\), ',')    
           from p_input)) row into v_result;*/
            end loop;          
   
           v_result:='success';

return v_result;
end;

$function$

