CREATE OR REPLACE FUNCTION as_importytptoserviceplan(v_ytp_id character varying DEFAULT ''::character varying, v_serviceplanid character varying DEFAULT ''::character varying, v_securityuserid character varying DEFAULT ''::character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE 
 v_date timestamp without time zone; 
 v_msg character varying;
 v_username character varying;
 v_person_rec record;
 v_splangoalid uuid;
 v_splanobjectiveid uuid;
 v_action_id uuid;
 v_data json;
 v_action_data json;
BEGIN   
       
 v_date:= now();
 FOR v_person_rec IN SELECT ytp.*,p.*,
  date_part('year',age(now()::date-30, cast(p.dob as date))) as age,
  date_part('month',age(now()::date-30, cast(p.dob as date))),
  date_part('day',age(now()::date-30, cast(p.dob as date)))   
  FROM youthtransitionplan ytp
  INNER JOIN person p ON ytp.clientid=p.personid
  WHERE youthtransitionplanid=v_ytp_id::uuid
 LOOP
 --Create a Service Plan Goal for each goal in YTP and Import Corresponding Objectives, Actions into them
 ----- Education Start
  FOR    v_data    in    SELECT    *    FROM    json_array_elements((v_person_rec.education_json::json->>'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');   --setting it to approved since YTP is already approved before import
   
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Education');
 
   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP;
  END LOOP; 
    ----- Education End
 ----- Employment Start
  FOR    v_data    in    SELECT    *    FROM    json_array_elements((v_person_rec.employment_json::json->>'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');
    
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Employment');
   
   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP;      
  END LOOP; 
 ----- Employment End
 ----- Money Management Start
  FOR   v_data    in    SELECT    *    FROM    json_array_elements((v_person_rec.moneymanagement_json::json->'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');
    
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Money Management');
   
   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP;
  END LOOP; 
 ---- Money Management End
 ---- Housing Start
  FOR   v_data    in    SELECT    *    FROM    json_array_elements((v_person_rec.housing_json::json->'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');
    
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Housing'); 
 
   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP; 
  END LOOP; 
 ---- Housing End
 ---- Supportive Relationships 
  FOR   v_data    in    SELECT    *    FROM    json_array_elements(( v_person_rec.sracc_json::json->'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');
    
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Supportive Relationships');  

   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP;
  END LOOP; 
 ---- Supportive Relationships End
 ---- Health Start
  FOR   v_data    in    SELECT    *    FROM    json_array_elements((v_person_rec.health_json::json->'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');
    
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Health');

   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP; 
  END LOOP; 
 ---- Health End
 ---- Documentation Start
  FOR   v_data    in    SELECT    *    FROM    json_array_elements((v_person_rec.documentation_json::json->'goals')::json)
  LOOP
   SELECT gen_random_uuid() INTO v_splangoalid;
   INSERT INTO splangoal
    (splangoalid, serviceplanid, 
    goalname, insertedby, insertedon, updatedby, updatedon, activeflag, approvalstatustypekey)
    VALUES(v_splangoalid, v_serviceplanid::uuid,  v_data->>'goal', v_securityuserid::uuid, 
    v_date, v_securityuserid::uuid, v_date, 1, 'approved');
    
   SELECT gen_random_uuid() INTO v_splanobjectiveid;
   INSERT INTO splanobjective
   (splanobjectiveid, splangoalid, serviceplanid, insertedby, insertedon, updatedby, updatedon, activeflag, objectivename)
   VALUES(v_splanobjectiveid, v_splangoalid::uuid, v_serviceplanid::uuid, v_securityuserid::uuid, v_date, v_securityuserid::uuid, v_date, 1, 'Documentation');  

   FOR    v_action_data    in    SELECT    *    FROM    json_array_elements((v_data::json->>'actions')::json)
   LOOP
    SELECT gen_random_uuid() INTO v_action_id;
    INSERT INTO serviceplanaction
    (serviceplanactionid, splanobjectiveid, serviceplanactionname, personinvolved, personresponsible, 
    insertedby, insertedon, updatedby, updatedon, activeflag)
    VALUES(v_action_id
    ,v_splanobjectiveid, v_action_data->>'action_plan',
    v_person_rec.personid, (v_data->>'responsible_parties')::json->>'firstname',  v_securityuserid::uuid , v_date, v_securityuserid::uuid, v_date, 1);
   END LOOP;
  END LOOP;
 ---- Documentation End
 END LOOP;
RETURN 'Success'::text;
END;                 
$function$

