CREATE OR REPLACE FUNCTION as_pg_get_tb_space()
 RETURNS TABLE(p_database_name character varying, p_size_in_mb integer)
 LANGUAGE plpgsql
AS $function$

begin
 
     SELECT  pg_database.datname as db_name, 
       pg_database_size(pg_database.datname)/1024/1024 AS size_in_mb 
     into    p_database_name,p_size_in_mb
     FROM    pg_database 
        ORDER by size_in_mb desc limit 1;
 
 end;
   
$function$

