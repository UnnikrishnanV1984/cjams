CREATE OR REPLACE FUNCTION sp_list_funding_src_history(v_fund_alloc_id integer, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, payment_detail_id integer, total_ammount numeric, payment_dt date, final_service_start_dt date, final_service_end_dt date, final_service_id integer, service_nm character varying, final_fiscal_category_cd character varying, fiscal_category_desc character varying, fund_allocation_date date, payment_amount numeric, ssi_funding_amt numeric, ssa_funding_amt numeric, coc_funding_amt numeric, state_funding_amt numeric, ivd_funding_amt numeric, ive_funding_amt numeric, local_funding_amt numeric, initial_stamping_sw character, eligibility_status_cd character varying, eligibility_status text)
 LANGUAGE plpgsql
AS $function$

declare
 v_pagenumber int;
 v_pageoffset int;
 
BEGIN 
 v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

return query select count(1) over(),x.* from (select distinct tpd.payment_detail_id::int,
coalesce(fam.ssi_funding_amt,0)+coalesce(fam.ssa_funding_amt,0)+coalesce(fam.coc_funding_amt,0)+coalesce(fam.state_funding_amt,0)+
coalesce(fam.ivd_funding_amt,0)+coalesce(fam.ive_funding_amt,0)+coalesce(fam.local_funding_amt,0),
tph.payment_dt,tpd.final_service_start_dt,
tpd.final_service_end_dt,tpd.final_service_id,ts.service_nm,fam.fiscal_category_cd,tfd.fiscal_category_desc,
fam.fund_allocation_date,fam.payment_amount,fam.ssi_funding_amt,fam.ssa_funding_amt,fam.coc_funding_amt,fam.state_funding_amt,
fam.ivd_funding_amt,fam.ive_funding_amt,fam.local_funding_amt,fam.initial_stamping_sw,
fam.eligibility_status_cd,(select trim(value_tx) from tb_picklist_values where TRIM(lower(picklist_value_cd)) = TRIM(lower(fam.eligibility_status_cd)) AND PICKLIST_type_id=262 AND delete_sw='N' AND active_sw='Y') as  eligibility_status
--P.cjamspid as client_ids, 
-- CAST(INITCAP(TRIM(P.firstname)||' '||TRIM(P.lastname) ||
-- CASE WHEN P.middlename IS NOT NULL AND TRIM(P.middlename) != '' THEN ', ' || TRIM(P.middlename) ELSE '' END)as character varying) as client_names
--(select json_agg(x) from (select event_id, tsse.start_dt, tsse.end_dt, event_type_cd, status_cd, notes_tx, status_change_sw, tsse.eligibility_id from tb_ssi_eligibility_events tsse  where tsse.eligibility_id=tce.eligibility_id and tsse.delete_sw='N')as x)
from tb_fund_allocation_detail fam
join tb_payment_detail tpd on tpd.payment_detail_id= fam.payment_detail_id and tpd.delete_sw ='N'
join tb_payment_header tph on tph.payment_id= tpd.payment_id and tph.delete_sw='N'
 join person P on p.cjamspid=tpd.client_id
   JOIN tb_placement pl ON P.cjamspid=pl.client_id and pl.delete_sw='N'
   JOIN gendertype as GT ON GT.gendertypekey = p.gendertypekey and GT.activeflag =1
--   JOIN actor as actor ON actor.personid=P.personid and actor.activeflag =1
--   JOIN intakeservicerequestactor as inseract ON inseract.actorid=actor.actorid and inseract.activeflag =1 and lower(inseract.intakeservicerequestpersontypekey)='rc'
  join servicecase sc on sc.servicecasenumber = pl.case_id :: character varying and sc.activeflag=1
  left JOIN intakeservicerequest as ISR ON ISR.servicecaseid = sc.servicecaseid and ISR.activeflag =1
   left JOIN IntakeServiceRequestType ISRT ON ISRT.intakeservreqtypeid=ISR.intakeservreqtypeid and ISRT.activeflag =1
        -- JOIN routing rr on rr.objectid=isr.intakeserviceid :: character varying and rr.toroleid='CWCW' and rr.activeflag =1
         JOIN userprofile up on up.securityusersid=sc.insertedby and up.activeflag =1
        LEFT join userprofilephonenumber uppn on up.securityusersid=uppn.securityusersid and uppn.userprofiletypekey='office' and uppn.activeflag =1
        LEFT join userprofileaddress upa on up.securityusersid=upa.securityusersid  and upa.activeflag =1 
        LEFT JOIN personidentifier as PIDE ON PIDE.personid=P.personid and PIDE.activeflag =1
        left join tb_services ts on ts.service_id = tpd.final_service_id and ts.delete_sw ='N'
        left join tb_fiscal_category_master tfd on tfd.fiscal_category_cd=fam.fiscal_category_cd 
  where fam.fund_alloc_id= v_fund_alloc_id and fam.delete_sw='N' AND pl.placement_id=(SELECT MAX(PLA.placement_id) from tb_placement PLA where PLA.client_id=P.cjamspid)
-- AND ISR.servicerequestnumber=pl.case_id::character varying
 AND p.activeflag =1) as x
-- group by tpd.payment_detail_id,tph.payment_dt,tpd.final_service_start_dt,
--tpd.final_service_end_dt,tpd.final_service_id,ts.service_nm,tpd.final_fiscal_category_cd,tfd.fiscal_category_desc,
--fam.funding_amount_no,fam.payment_amount,fam.ssi_funding_amt,fam.ssa_funding_amt,fam.coc_funding_amt,fam.state_funding_amt,
--fam.ivd_funding_amt,fam.ive_funding_amt,fam.local_funding_amt,fam.initial_stamping_sw,
-- client_ids,client_names, 
--        P.dob 
-- ,PIDE.personidentifiervalue 
-- ,GT.typedescription   
-- ,ISR.servicerequestnumber 
-- ,ISRT.description
-- ,up.cjamspid 
-- ,up.displayname 
-- ,uppn.phonenumber
-- ,upa.county 
-- ,county_cds  
LIMIT v_liPageSize OFFSET v_pageoffset; 

END;

$function$

