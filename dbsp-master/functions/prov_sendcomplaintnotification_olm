select json_agg(a) into v_tousers from ( 
    SELECT distinct mu.securityusersid as toworkeridno 
    , mu.email 
        from muser mu 
        join rolemapping rm on rm.principalid = mu.id and rm.activeflag = 1
        join role r on r.id = rm.roleid and r.activeflag = 1
        where r.name in  ('Program Manager', 
                        'Executive Director',
                        'Deputy Director')  
        and mu.activeflag =1
        and mu.securityusersid not in (v_fromsecurityuserid)
        and rm.teamtypekey='OLM'
)a;

select json_agg(a) into v_selected_users from ( 
    select mu.email, mu.securityusersid 
    from muser mu 
    where securityusersid in (
    select ltrim(rtrim( x.a::character varying, '"'), '"') as users from (SELECT json_array_elements(v_assignsecurityuserid) a)  x
    )
)a;





