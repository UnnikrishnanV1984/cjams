CREATE OR REPLACE FUNCTION prov_getassignmentdecisions(reqob json)
 RETURNS TABLE(fromsecurityusersid character varying, tosecurityusersid character varying, fromuser character varying, fromroleid character varying, objectid character varying, isreviewrequest boolean, remarks text, status text, created_on timestamp without time zone, rolename character varying, touser character varying, toroleid character varying, signature json, decisiondate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                             
                                                                                                                                                                                           
 declare                                                                                                                                                                                   
                                                                                                                                                                                           
 v_eventcode character varying;                                                                                                                                                            
 v_objectid character varying;                                                                                                                                                             
                                                                                                                                                                                           
 begin                                                                                                                                                                                     
         v_eventcode:= reqOb->>'eventcode';
         v_objectid:= reqOb->>'objectid';
                                                                                                                                                                                           
         RETURN QUERY SELECT ptr.fromsecurityusersid, ptr.tosecurityusersid, cast(upf.firstname || ' ' || upf.lastname as character varying), ptr.fromroleid, ptr.objectid, ptr.isreviewrequest::bool, ptr.remarks::text, ptr.status::text ,
         ptr.insertedon,rt.description,cast(upt.firstname || ' ' || upt.lastname as character varying), ptr.toroleid, ptr.signature, ptr.decisiondate 
         FROM tb_provider_decision ptr 
         left join userprofile upf on upf.securityusersid = ptr.fromsecurityusersid
         left join userprofile upt on upt.securityusersid = ptr.tosecurityusersid
         inner join providerassignment pa on pa.providerassignmentid::character varying = ptr.objectid and ptr.eventcode = pa.objecttypekey
         left  join role rt on rt.roletypekey = ptr.fromroleid
         where pa.objecttypekey=v_eventcode and pa.objectid=v_objectid                                                                                                                       
         order by ptr.insertedon desc;                                                                                                                                                     
 end;                                                                                                                                                        
                                                                                                                                                                                           
 $function$

