  CREATE TEMP TABLE KeyResults(PersonId uuid, PersonAddressId uuid, RankNo int, RankSound int);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
  INSERT INTO KeyResults
 (PersonId, RankNo, RankSound)

 SELECT 
  distinct
  p.PersonId,
  CASE WHEN coalesce(v_firstname_clean,' ') = trim(lower(p.FirstName)) THEN 1 ELSE 0 end
  + CASE WHEN coalesce(v_lastname_clean,' ') = trim(lower(p.LastName)) THEN 1 ELSE 0 end
  + CASE WHEN coalesce(v_middlename_clean,' ') = trim(lower(p.MiddleName)) THEN 1 ELSE 0 end
  ::int as match_rank,
  COALESCE(difference(v_firstname_clean, trim(lower(p.FirstName))),0)
  + COALESCE(difference(v_lastname_clean, trim(lower(p.LastName))),0)
  + COALESCE(difference(v_middlename_clean, trim(lower(p.MiddleName))),0)
  ::int as sound_rank
 FROM    Person  AS  p                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
    LEFT  JOIN  PersonIdentifier  AS  i  ON  i.PersonId  =  p.PersonId
 LEFT  JOIN  PersonAddress    AS  a  ON  a.PersonId  =  p.PersonId  and  a.ActiveFlag  =  1  --AND  a.PersonAddressTypeKey  =  'C'
 LEFT  JOIN  PersonPhoneNumber  AS  pn  ON  pn.PersonId  =  p.PersonId
 LEFT  JOIN  PersonEmail  AS  pe  ON  pe.PersonId  =  p.PersonId
 LEFT  JOIN  County        AS  c  ON    a.county :: character varying  =  c.countyid :: character varying
 Left  Join  Alias  As  al  On  al.personid  =  p.personid
 WHERE
  CASE WHEN v_lvFirstName is NOT NULL THEN (trim(lower(p.FirstName)) like v_firstname_clean||'%') or (difference(trim(lower(p.FirstName)), v_firstname_clean) >= soundslikeindex) ELSE TRUE END
  AND CASE WHEN v_lvLastName is NOT NULL THEN (trim(lower(p.LastName)) like  v_lastname_clean||'%') or (difference(trim(lower(p.LastName)), v_lastname_clean) >= soundslikeindex) ELSE TRUE END
  AND CASE WHEN v_lvMiddleName is NOT NULL THEN (trim(lower(p.MiddleName)) like  v_middlename_clean||'%') or (difference(trim(lower(p.MiddleName)), v_middlename_clean) >= soundslikeindex) ELSE TRUE end
 
  AND CASE WHEN v_lvRace is NOT NULL THEN (p.RaceTypeKey = v_lvRace) ELSE TRUE END
  AND CASE WHEN v_lvGender is NOT NULL THEN (p.GenderTypeKey = v_lvGender) ELSE TRUE END
  AND CASE WHEN v_lDCNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lDCNType) ELSE TRUE END
  AND CASE WHEN v_lSSNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lSSNType) ELSE TRUE END
  AND CASE WHEN v_liDangerous is NOT NULL THEN (p.DangerLevel = v_liDangerous) ELSE TRUE END
  AND CASE WHEN v_liRegion is NOT NULL THEN (c.APSRegion = v_liRegion) ELSE TRUE END
  AND (CASE WHEN (v_lDLType is NOT NULL AND v_lDLValue is NOT NULL)
           THEN (i.PersonIdentifierTypeKey = v_lDLType AND i.PersonIdentifierValue ILIKE v_lDLValue)
          ELSE TRUE END)
  and CASE WHEN v_lvStateId is NOT NULL THEN a.state ILIKE v_lvStateId ELSE TRUE end
  AND  CASE  WHEN  v_lvAddress  is  NOT  NULL  THEN  (lower(a.address)  ILIKE  lower(v_lvAddress)||'%' )  ELSE  TRUE  end
         AND  CASE  WHEN  v_lvAddress2  is  NOT  NULL  THEN  (lower(a.address2) ILIKE  lower(v_lvAddress2)||'%' )  ELSE  TRUE  END
--  AND CASE WHEN v_lvAddress is NOT NULL THEN (lower(a.address) = lower(v_lvAddress)) ELSE TRUE END
--  AND CASE WHEN v_lvAddress2 is NOT NULL THEN (lower(a.address2) = lower(v_lvAddress2)) ELSE TRUE END
  AND CASE WHEN v_lvSocialMediaSrc is NOT NULL THEN (lower(p.socialmediasource) = lower(v_lvSocialMediaSrc)) ELSE TRUE END
  AND CASE WHEN v_lvFein is NOT NULL THEN (p.fein = v_lvFein) ELSE TRUE END
  AND CASE WHEN v_lvComplaintnumber is NOT NULL THEN (p.complaintnumber = v_lvComplaintnumber) ELSE TRUE end
  -- AND  CASE  WHEN  v_lvCjisnumber  is  NOT  NULL  THEN  (p.cjisnumber  =  v_lvCjisnumber  or  p.old_id  =  v_lvCjisnumber  or  p.cjamspid  =  v_lvCjisnumber::bigint)  ELSE  TRUE  END
  AND CASE WHEN v_lvCjisnumber is NOT NULL THEN (p.cjamspid = v_lvCjisnumber::bigint or trim(p.cisclientid) = v_lvCjisnumber::character varying) ELSE TRUE END
  AND CASE WHEN v_lvcjamspid is NOT NULL THEN ( p.cjamspid = v_lvcjamspid::bigint) ELSE TRUE END
  AND CASE WHEN v_lvPetitionid is NOT NULL THEN (p.petitionid = v_lvPetitionid) ELSE TRUE END

  AND 
   CASE 
    WHEN v_lvAlias is NOT NULL 
    THEN ((concat(trim(lower(al.firstname)), case when al.lastname is not null then '' else ' '|| trim(lower(al.lastname)) end ) = v_alias_clean) and al.akatypetypekey='AN' and al.activeflag=1)
     --or ((soundex(concat(trim(lower(al.firstname)), case when al.lastname is not null then '' else ' '|| trim(lower(al.lastname)) end )) = v_AliasSoundEx) and al.akatypetypekey='AN' and al.activeflag=1)
    ELSE true
   END
   AND CASE 
     WHEN v_lvMaidenName is NOT NULL 
     THEN ((concat(lower(al.firstname), case when al.lastname is not null then '' else ' '|| lower(al.lastname) end ) = v_maidenname_clean) and al.akatypetypekey='MN' and al.activeflag=1)
      --or ((soundex(concat(trim(lower(al.firstname)), case when al.lastname is not null then '' else ' '|| trim(lower(al.lastname)) end )) = v_MaidenNameSoundEx) and al.akatypetypekey='MN' and al.activeflag=1)
     ELSE true
    END
  AND CASE WHEN v_lvZip is NOT NULL THEN (lower(a.zipcode) = lower(v_lvZip)) ELSE TRUE END
  AND CASE WHEN v_lvState is NOT NULL THEN (a.state ILIKE v_lvState) ELSE TRUE END
  AND CASE WHEN v_lvCounty is NOT NULL THEN (a.county ILIKE v_lvCounty) ELSE TRUE END
  AND CASE WHEN v_lvCity is NOT NULL THEN (lower(a.city) = lower(v_lvCity)) ELSE TRUE END
  AND CASE WHEN v_lDCNValue is NOT NULL THEN (i.PersonIdentifierValue ILIKE v_lDCNValue) ELSE TRUE END
  AND CASE WHEN v_lSSNValue is NOT NULL THEN (i.PersonIdentifierValue ILIKE v_lSSNValue) ELSE TRUE END
  AND CASE WHEN v_lvPhone is NOT NULL THEN (pn.phoneNumber ILIKE v_lvPhone) ELSE TRUE END
  AND CASE WHEN v_lvEmail is NOT NULL THEN (pe.email ILIKE v_lvEmail) ELSE TRUE END
  AND CASE WHEN v_lvOccupation is NOT NULL THEN (p.occupation ILIKE v_lvOccupation) ELSE TRUE END
  AND (v_liAge IS NULL OR date_part('year', age(now(), p.DOB)) = v_liAge)
  AND CASE WHEN v_lmdmType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lmdmType) ELSE TRUE end
  AND CASE WHEN v_lmdmValue is NOT NULL THEN (i.PersonIdentifierValue ilike '%'  || v_lmdmValue ||  '%' ) ELSE TRUE END
  --and (v_mdm IS NULL OR  i.personidentifiervalue ILIKE '%'  || v_mdm ||  '%' )
  AND CASE WHEN v_ldDOB is NOT NULL THEN
            CASE WHEN length(v_ldDOB) > 4 THEN (p.DOB = cast(v_ldDOB as timestamp)) ELSE TRUE END
           ELSE TRUE END
  AND p.ActiveFlag  =  1;



