           JOIN  relationshiptype  PRT  ON  PRT.relationshiptypekey  =  PerRel.actorrelationshipkey AND prt.activeflag = 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
       WHERE  PR.ActiveFlag  =  1  AND  PerRel.ActiveFlag  =  1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
           AND  PerRel.PersonId  =  FR.PersonId  limit  1)  AS  Relations,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     */                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     (select json_agg(v)
       from (                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
             SELECT  
               PR.firstname  ||  '  '  ||  PR.lastname as personname,
               PRT.description  as  relationtype,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
               CASE 
                 WHEN PerRel.relationcategory = 'P' THEN 'Primary'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                 WHEN PerRel.relationcategory = 'S' THEN 'Secondary'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                 WHEN PerRel.relationcategory = 'O' THEN 'Other'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
               END AS relationcategory                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
             FROM  PersonRelation  PerRel
             JOIN  Person  PR  ON  PR.PersonId  =  PerRel.PersonRelativeId
             Join  relationshiptype  PRT  On  PRT.relationshiptypekey  =  PerRel.actorrelationshipkey and prt.activeflag = 1
             WHERE  PR.ActiveFlag  =  1  AND  PerRel.ActiveFlag  =  1
             AND  PerRel.PersonId  =  FR.PersonId                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
       ) as v
     )  AS  Relations,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     (Select  
       al.firstname  ||  '  '  || ( case when al.lastname is not null then al.lastname else '' end ) 
       FROM  Alias  al                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
       WHERE  al.personid  =  FR.personid
         and al.activeflag=1
         and CASE  WHEN  v_lvAlias  is  NOT  NULL  THEN  (lower(al.firstname)  ilike  left(lower(v_lvAlias),  3) ||  '%' or lower(al.lastname)   ilike  left(lower(v_lvAlias),  12)  ||  '%')  ELSE  TRUE  END  
          limit 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     ) AS  Alias,
      p.fk_id as assistpid,
      p.cjamspid,
      p.primarylanguageid,
      p.secondarylanguageid,
      rv.description as primarylanguage,
      rvs.description as secondarylanguage,
      p.safehavenbabyflag,
     (select json_agg(v)
       from     
       (Select  
       rv.value_text
       FROM  personracetypemap  prtm join referencevalues rv on  rv.ref_key = prtm.racetypekey and rv.referencetypeid = 171 and rv.activeflag = 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
       WHERE  prtm.personid  =  p.personid
         and prtm.activeflag=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     )as v
     ) AS  racetypekey,
--      p.racetypekey,
      p.ethnicgrouptypekey,
      p.cisclientid

