CREATE OR REPLACE FUNCTION fn_childremoval_exit()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- To update returntransts column on removal exit 
-- (Column used fro Federal Reporting)

-- Revision(s)
------------------------------------------------------------------------
BEGIN
 IF new.exitdate is not null and old.exitdate is null THEN
  update intakeservreqchildremoval
   set returntransts = now()
  where intakeservreqchildremovalid = new.intakeservreqchildremovalid ; 
 END IF;

 RETURN NEW;
END;

$function$

