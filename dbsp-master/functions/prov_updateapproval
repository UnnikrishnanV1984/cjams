CREATE OR REPLACE FUNCTION prov_updateapproval(approvalobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                              
--v_approvaltypecode character varying;                                                                                                                                                                                                                                                                                                                                                             ;
v_approvalstatuscode character varying;
v_providerid character varying;
v_approvalids json;
 begin    
--v_approvaltypecode := approvalobj->>'approval_type_cd';
v_approvalstatuscode=approvalobj->>'approval_status_cd';
v_providerid=approvalobj->>'provider_id';
v_approvalids=approvalobj->>'approvalids';
raise notice '%v_approvalids',v_approvalids;
raise notice '%v_approvalids',v_providerid;
raise notice '%v_approvalids',v_approvalstatuscode;
if (v_approvalstatuscode='3585') then
raise notice '%if',v_approvalids;
update tb_provider_approval tpa set approval_status_cd=v_approvalstatuscode,
ha_revoke_approval_status_cd='3047',
            ha_revoke_approval_dt =now()::date
where tpa.provider_id=v_providerid and tpa.delete_sw='N' and tpa.approval_dt is not null and active_sw='Y' and
CASE WHEN v_approvalids IS NOT NULL THEN provider_approval_id= any(ARRAY(SELECT json_array_elements_text(v_approvalids)))ELSE TRUE END  ;
--provider_approval_id= any(string_to_array(v_approvalids, ','));
else
raise notice '%else',v_approvalids;
update tb_provider_approval tpa set approval_status_cd=v_approvalstatuscode
where tpa.provider_id=v_providerid and tpa.delete_sw='N' and tpa.approval_dt is not null and active_sw='Y' and
CASE WHEN v_approvalids IS NOT NULL THEN provider_approval_id= any(ARRAY(SELECT json_array_elements_text(v_approvalids)))ELSE TRUE END  ;
--provider_approval_id= any(string_to_array(v_approvalids, ','));
end if;
                                                                                                                                                                                                                                                                                                                                                                           
return 'success';  
                                                                                                                                                                                                                                                                                                                                                                                             
end;
$function$

