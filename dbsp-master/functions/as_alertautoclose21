CREATE OR REPLACE FUNCTION as_alertautoclose21()
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE  
v_personalertid uuid;
v_personid uuid;
v_status character varying;
v_dob character varying;
v_activity  record;


BEGIN     

 
 --youth 21 years and case is closed
FOR  v_activity  IN
select pa.personalertid as v_personalertid,
       pa.status as v_status,
    cast(p.dob as character varying) as v_dob
from 
 intakeservicerequest INTSR 
join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid  and INSRA.intakeservicerequestpersontypekey='Youth'
join actor ACC on ACC.actorid=INSRA.actorid 
join person p on ACC.personid=p.personid 
join personalert pa on pa.personid=p.personid
join intakeserreqstatustype on INTSR.intakeserreqstatustypeid =intakeserreqstatustype.intakeserreqstatustypeid
where p.dob::date+ interval '21 year'<=now()::date and 
      pa.activeflag=1  and pa.status='Active' and pa.alerttype!='DOD' and intakeserreqstatustype.intakeserreqstatustypekey='Closed'
--  and pa.alerttype in ('ADSO','FRST','CRAN','DIAB','ENCP','ENUR','GANC','HPLM','HRTC','SUIC','PVHD','ALGE','ALGF','ALGI','ALGL','ALGM','SEIZ','SEXR','SEXP','SPCH','SSAI','VNFR','VICA','DMST','VSNI','DIER','POBC','POAU','PONA','REST')

LOOP

UPDATE personalert set status='Inactive',enddatetime=now() where personalertid=v_activity.v_personalertid;

END  LOOP;


---youth 21 years

FOR  v_activity  IN
select pa.personalertid as v_personalertid,
       pa.status as v_status,
    cast(p.dob as character varying) as v_dob
from 
 intakeservicerequest INTSR 
join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid  and INSRA.intakeservicerequestpersontypekey='Youth'
join actor ACC on ACC.actorid=INSRA.actorid 
join person p on ACC.personid=p.personid 
join personalert pa on pa.personid=p.personid
where p.dob::date+ interval '21 year'<=now()::date and 
      pa.activeflag=1  and pa.status='Active' and pa.alerttype!='DOD' 
  and pa.alerttype not in ('ADSO','FRST','CRAN','DIAB','ENCP','ENUR','GANC','HPLM','HRTC','SUIC','PVHD','ALGE','ALGF','ALGI','ALGL','ALGM','SEIZ','SEXR','SEXP','SPCH','SSAI','VNFR','VICA','DMST','VSNI','DIER','POBC','POAU','PONA','REST')

LOOP

UPDATE personalert set status='Inactive',enddatetime=now() where personalertid=v_activity.v_personalertid;

END  LOOP;


RETURN
'Success';
END;
$function$

