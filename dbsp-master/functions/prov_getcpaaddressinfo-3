CREATE OR REPLACE FUNCTION prov_getcpaaddressinfo(cpa_siteid bigint, v_providerid bigint, applicant_name character varying, sort_order character varying, address_type character varying, cpa_status character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$        
         
declare

v_siteid bigint;      
v_listdata json;
v_sortdirection character varying;
v_address_type character varying;
v_cpa_status character varying;

BEGIN
v_siteid := cpa_siteid;
v_sortdirection := sort_order;
v_address_type := address_type;
v_cpa_status := cpa_status;

raise notice '%',lower(applicant_name);

select json_agg(x) into v_listdata from (
select 
addr.provider_id,addr.cpa_siteid,(case when (addr.adr_type is null or addr.adr_type = '' or addr.adr_type = 'CPA_HOME') then  'CPA_HOME' else 'ILP_SITE' end) adr_type,
tpa.adr_start_dt as adr_start_date,tpa.adr_end_dt as adr_end_date,

(select * from prov_get_formatted_addresses(tp.provider_id)) as formatted_address,

cpa_initial_date,cpa_certificate_type,cpa_homeins_date,cpa_fireins_date,isinspection_home_family_record,
isinspection_fire_family_record,ismeets_comar_requiremnt,status,suspensionstartdate,suspension_letter_sent_date,suspensionenddate,tp.provider_id as cpa_provider_id,tp.provider_status_cd,
suspensioncomments,addr.provider_cpa_address_id,dateappeal_meeting,appeal_provider_decision,isrevocationremidied,emergencySuspend,cert_upload_url,cpa_recert_date,
datenotificationdelivered,dateyouthremoved,nochildaddcpa,provider_last_nm || ' ,' || provider_first_nm  applicantname,
 COALESCE (NULLIF (concat_ws(' ', trim(provider_first_nm),trim(provider_last_nm)), ' '), provider_nm)  as applicant_person_name,
 tp.provider_first_nm , tp.provider_last_nm , tp.provider_nm,
(select count(*) noofpersons from tb_prov_cpa_homes x
where provider_cpa_address_id=addr.provider_cpa_address_id ) noofpersons
from tb_provider tp
left join tb_provider_addresses tpa on tpa.parent_key_id = tp.provider_id and tpa.delete_sw='N' and tpa.adr_type_cd=3357 and tpa.adr_default_sw = 'Y'
left join tb_provider_picklist pp on pp.provider_id = tp.provider_id
left join tb_prov_cpa_address addr on tp.provider_id = addr.cpa_provider_id
where (v_siteid is null or addr.cpa_siteid=v_siteid)
and (case when v_address_type = 'ILP_SITE' then addr.adr_type = 'ILP_SITE'
   else addr.adr_type is null or addr.adr_type !='ILP_SITE' end)
and (v_cpa_status = '' or v_cpa_status = null or v_cpa_status = 'Active' or tp.provider_status_cd=v_cpa_status)
and tp.affiliate_provider_id=v_providerid
and (tp.provider_category_cd=1782 or (pp.picklist_value_cd = 1782 and pp.picklist_type_id=155))
and (applicant_name is null or LOWER(tp.provider_last_nm) like '%'||lower(applicant_name)||'%' 
       or lower(tp.provider_first_nm) like '%'||lower(applicant_name)||'%'
       or lower(tp.provider_nm) like '%'||lower(applicant_name)||'%')  

  order by (
    CASE v_sortdirection
     WHEN 'asc'
     THEN                    
                      LOWER(trim(tp.provider_first_nm||' '||tp.provider_last_nm||' '||tp.provider_nm))
              END) ASC NULLS LAST,
                (CASE v_sortdirection
     WHEN 'desc'
     THEN                    
                      LOWER(trim(tp.provider_first_nm||' '||tp.provider_last_nm||' '||tp.provider_nm))
              END) DESC NULLS last 
)x;

return v_listdata;
END;

$function$

