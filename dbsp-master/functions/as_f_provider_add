CREATE OR REPLACE FUNCTION as_f_provider_add(as_tabname character varying, ai_key_id bigint, as_adr_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
DECLARE payaffcd             CHARACTER VARYING;                             --
DECLARE affid                VARCHAR;
DECLARE n_ADR_TYPE_CD        CHARACTER VARYING;                             --
DECLARE outtxt               CHARACTER VARYING;                             --
DECLARE t_ADDRESS_ID         INTEGER;                                       --
DECLARE t_ADR_FORMAT_CD      CHARACTER VARYING;                             --
DECLARE t_EMP_SCHOOL_NM      CHARACTER VARYING;                             --
DECLARE t_ADR_STREET_NO      CHARACTER VARYING;                             --
DECLARE t_ADR_BOX_NO         CHARACTER VARYING;                             --
DECLARE t_ADR_PRE_DIR_CD     CHARACTER VARYING;                             --
DECLARE t_ADR_STREET_NM      CHARACTER VARYING;                             --
DECLARE t_ADR_STREET_SX_CD   CHARACTER VARYING;                             --
DECLARE t_ADR_POST_DIR_CD    CHARACTER VARYING;                             --
DECLARE t_ADR_UNIT_TYPE_CD   CHARACTER VARYING;                             --
DECLARE t_ADR_UNIT_NO_TX     CHARACTER VARYING;                             --
DECLARE t_ADR_CITY_NM        CHARACTER VARYING;                             --
DECLARE t_ADR_COUNTY_CD      CHARACTER VARYING;                             --
DECLARE t_ADR_STATE_CD       CHARACTER VARYING;                             --
DECLARE t_ADR_ZIP5_NO        CHARACTER VARYING;                             --
DECLARE t_ADR_ZIP4_NO        CHARACTER VARYING;                             --
DECLARE t_ADR_DIRECTION_TX   CHARACTER VARYING;                             --
DECLARE t_ADR_FOREIGN_TX     CHARACTER VARYING;                             --
DECLARE t_ADR_FOREIGN_STTX   CHARACTER VARYING;                             --
DECLARE t_ADR_COUNTRY_TX     CHARACTER VARYING;                             --
DECLARE t_ADR_POSTAL_CD_TX   CHARACTER VARYING;                             --
DECLARE vl_address_id        INT;                                           --
BEGIN
   affid = cast (ai_key_id AS VARCHAR);                                     --

   IF as_ADR_TYPE_CD IS NOT NULL AND as_ADR_TYPE_CD <> ''
   THEN
      IF as_ADR_TYPE_CD = '3356'
      THEN                                                 -- Provider Payment
         n_ADR_TYPE_CD = as_ADR_TYPE_CD;                                    --

         payaffcd =
            (SELECT pay_to_affiliate_cd
               FROM tb_provider
              WHERE provider_id = ai_key_id);                               --

         IF payaffcd = '3366'
         THEN
            n_ADR_TYPE_CD = '3357';                                         --
         ELSIF payaffcd = '3367'
         THEN
            n_ADR_TYPE_CD = '3356';                                         --
         ELSIF payaffcd = '3368'
         THEN
            affid =
               (SELECT affiliate_provider_id
                  FROM tb_provider
                 WHERE provider_id = ai_key_id);                            --
            payaffcd =
               (SELECT pay_to_affiliate_cd
                  FROM tb_provider
                 WHERE provider_id = affid);                                --

            IF payaffcd = '3366'
            THEN
               n_ADR_TYPE_CD = '3357';                                      --
            ELSE
               n_ADR_TYPE_CD = '3356';                                      --
            END IF;                                                         --
         END IF;                                                            --
      ELSE
         n_ADR_TYPE_CD = as_ADR_TYPE_CD;                                    --
      END IF;                                                               --
   ELSE
      n_ADR_TYPE_CD = '';                                                   --
   END IF;                                                                  --

   IF n_ADR_TYPE_CD IS NULL OR n_ADR_TYPE_CD = ''
   THEN                                              -- Return Default Address
      t_ADR_FORMAT_CD =
         (SELECT cast (
                    COALESCE (CAST (ADR_FORMAT_CD AS VARCHAR), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_STREET_NO =
         (SELECT cast (
                    COALESCE (CAST (ADR_STREET_TX AS VARCHAR), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_BOX_NO =
         (SELECT cast (
                    COALESCE (CAST (ADR_BOX_NO AS VARCHAR), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_PRE_DIR_CD =
         (SELECT cast (
                    COALESCE (F_PDESC (ADR_PRE_DIR_CD, 69), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_STREET_NM =
         (SELECT cast (COALESCE (ADR_STREET_NM, '') AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_STREET_SX_CD =
         (SELECT cast (
                    COALESCE (F_PDESC (ADR_STREET_SUFFIX_CD, 212), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_POST_DIR_CD =
         (SELECT cast (
                    COALESCE (F_PDESC (ADR_POST_DIR_CD, 69), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_UNIT_TYPE_CD =
         (SELECT cast (
                    COALESCE (F_PDESC (ADR_UNIT_TYPE_CD, 250), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_UNIT_NO_TX =
         (SELECT cast (COALESCE (ADR_UNIT_NO_TX, '') AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_CITY_NM =
         (SELECT cast (COALESCE (ADR_CITY_NM, '') AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_COUNTY_CD =
         (SELECT cast (COALESCE (ADR_COUNTY_CD, '') AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_STATE_CD =
         (SELECT cast (
                    COALESCE (F_PDESC (ADR_STATE_CD, 211), '')
                       AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_ZIP5_NO =
         (SELECT cast (
                    COALESCE (CAST (cast (ADR_ZIP5_NO AS INT) AS VARCHAR),
                              '') AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_ZIP4_NO =
         (SELECT cast (
                    COALESCE (CAST (cast (ADR_ZIP4_NO AS INT) AS VARCHAR),
                              '') AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);

      t_ADR_DIRECTION_TX =
         (SELECT ''
              FROM TB_PROVIDER_ADDRESSES
             WHERE     PARENT_KEY_ID = affid
                   AND ADR_DEFAULT_SW = 'Y'
                   AND DELETE_SW = 'N'
          ORDER BY ADDRESS_ID DESC
             FETCH FIRST ROW ONLY);
   ELSE                   -- Return default and Address as of perticulare Type
      vl_address_id = 0;                                       -- INTIAL VALUE

      vl_address_id =
         (SELECT MAX (ADDRESS_ID)
           FROM TB_PROVIDER_ADDRESSES
          WHERE     PARENT_KEY_ID = cast (affid AS VARCHAR)
                AND ADR_TYPE_CD = n_ADR_TYPE_CD
                AND ADR_DEFAULT_SW = 'Y'
                AND DELETE_SW = 'N');                                       --

      IF vl_address_id IS NULL
      THEN
         vl_address_id = 0;                                                 --
      END IF;                                                               --

      IF vl_address_id > 0
      THEN
         t_ADR_FORMAT_CD =
            (SELECT cast (
                       COALESCE (CAST (ADR_FORMAT_CD AS VARCHAR), '')
                          AS CHARACTER VARYING)
              FROM TB_PROVIDER_ADDRESSES
             WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N');

         t_ADR_STREET_NO =
            (SELECT cast (
                       COALESCE (CAST (ADR_STREET_TX AS VARCHAR), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_BOX_NO =
            (SELECT cast (
                       COALESCE (CAST (ADR_BOX_NO AS VARCHAR), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_PRE_DIR_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_PRE_DIR_CD, 69), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STREET_NM =
            (  SELECT cast (COALESCE (ADR_STREET_NM, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STREET_SX_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_STREET_SUFFIX_CD, 212), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_POST_DIR_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_POST_DIR_CD, 69), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_UNIT_TYPE_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_UNIT_TYPE_CD, 250), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_UNIT_NO_TX =
            (  SELECT cast (COALESCE (ADR_UNIT_NO_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_CITY_NM =
            (  SELECT cast (COALESCE (ADR_CITY_NM, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_COUNTY_CD =
            (  SELECT cast (COALESCE (ADR_COUNTY_CD, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STATE_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_STATE_CD, 211), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_ZIP5_NO =
            (SELECT cast (
                       COALESCE (CAST (cast (ADR_ZIP4_NO AS INT) AS VARCHAR),
                                 '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_ZIP4_NO =
            (SELECT cast (
                       COALESCE (CAST (cast (ADR_ZIP5_NO AS INT) AS VARCHAR),
                                 '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_DIRECTION_TX =
            (  SELECT ''
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_FOREIGN_TX =
            (  SELECT cast (COALESCE (ADR_FOREIGN_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_FOREIGN_STTX =
            (SELECT cast (
                       COALESCE (ADR_FOREIGN_STATE_TX, '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_COUNTRY_TX =
            (  SELECT cast (COALESCE (ADR_COUNTRY_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_POSTAL_CD_TX =
            (SELECT cast (
                       COALESCE (ADR_POSTAL_CODE_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE ADDRESS_ID = vl_address_id AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);
      ELSE
         t_ADR_FORMAT_CD =
            (SELECT cast (
                       COALESCE (CAST (ADR_FORMAT_CD AS VARCHAR), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STREET_NO =
            (SELECT cast (
                       COALESCE (CAST (ADR_STREET_TX AS VARCHAR), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_BOX_NO =
            (SELECT cast (
                       COALESCE (CAST (ADR_BOX_NO AS VARCHAR), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_PRE_DIR_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_PRE_DIR_CD, 69), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STREET_NM =
            (SELECT cast (COALESCE (ADR_STREET_NM, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STREET_SX_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_STREET_SUFFIX_CD, 212), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_POST_DIR_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_POST_DIR_CD, 69), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_UNIT_TYPE_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_UNIT_TYPE_CD, 250), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_UNIT_NO_TX =
            (SELECT cast (COALESCE (ADR_UNIT_NO_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_CITY_NM =
            (SELECT cast (COALESCE (ADR_CITY_NM, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_COUNTY_CD =
            (SELECT cast (COALESCE (ADR_COUNTY_CD, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_STATE_CD =
            (SELECT cast (
                       COALESCE (F_PDESC (ADR_STATE_CD, 211), '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_ZIP5_NO =
            (SELECT cast (
                       COALESCE (CAST (cast (ADR_ZIP5_NO AS INT) AS VARCHAR),
                                 '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_ZIP4_NO =
            (SELECT cast (
                       COALESCE (CAST (cast (ADR_ZIP4_NO AS INT) AS VARCHAR),
                                 '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_DIRECTION_TX =
            (SELECT ''
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_FOREIGN_TX =
            (SELECT cast (COALESCE (ADR_FOREIGN_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_FOREIGN_STTX =
            (SELECT cast (
                       COALESCE (ADR_FOREIGN_STATE_TX, '')
                          AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_COUNTRY_TX =
            (SELECT cast (COALESCE (ADR_COUNTRY_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);

         t_ADR_POSTAL_CD_TX =
            (SELECT cast (
                       COALESCE (ADR_POSTAL_CODE_TX, '') AS CHARACTER VARYING)
                 FROM TB_PROVIDER_ADDRESSES
                WHERE     PARENT_KEY_ID = affid
                      AND ADR_TYPE_CD = n_ADR_TYPE_CD
                      AND DELETE_SW = 'N'
             ORDER BY ADDRESS_ID DESC
                FETCH FIRST ROW ONLY);
      END IF;                                                               --
   END IF;                                                                  --

   outtxt =
      SP_AD_FORMAT (t_ADDRESS_ID,
                    t_ADR_FORMAT_CD,
                    t_EMP_SCHOOL_NM,
                    t_ADR_STREET_NO,
                    t_ADR_BOX_NO,
                    t_ADR_PRE_DIR_CD,
                    t_ADR_STREET_NM,
                    t_ADR_STREET_SX_CD,
                    t_ADR_POST_DIR_CD,
                    t_ADR_UNIT_TYPE_CD,
                    t_ADR_UNIT_NO_TX,
                    t_ADR_CITY_NM,
                    t_ADR_COUNTY_CD,
                    t_ADR_STATE_CD,
                    t_ADR_ZIP5_NO,
                    t_ADR_ZIP4_NO,
                    t_ADR_DIRECTION_TX,
                    t_ADR_FOREIGN_TX,
                    t_ADR_FOREIGN_STTX,
                    t_ADR_COUNTRY_TX,
                    t_ADR_POSTAL_CD_TX);                                    --

   RETURN outtxt;                                                           --
END;
$function$

