CREATE OR REPLACE FUNCTION prov_listfilteredexitconfprov(searchparams json)
 RETURNS TABLE(monitoring_id character varying, exit_conf_id integer, summary character varying, exit_dt timestamp without time zone, program_changes character varying, exit_conf_number character varying, ec_status character varying, cap_number_djs character varying, staffdetails jsonb, workerdetails jsonb)
 LANGUAGE plpgsql
AS $function$

declare
DECLARE
v_provider_id character varying;
v_exit_conf_number character varying;
v_cap_number character varying;
v_ec_status  character varying;
v_exit_from_dt  character varying; 
v_exit_to_dt  character varying;

begin 
v_provider_id = searchParams->>'provider_id';
v_exit_conf_number = searchParams->>'exit_conf_number';
v_cap_number = searchParams->>'cap_number';
v_ec_status = searchParams->>'status';
v_exit_from_dt = searchParams->>'appcreateddate_from';
v_exit_to_dt = searchParams->>'appcreateddate_to';


return query 

select distinct mcf.monitoring_id,mcf.exit_conf_id,mcf.summary,mcf.exit_dt,mcf.program_changes,mcf.exit_conf_number,mcf.ec_status,mcf.cap_number_djs,

(select jsonb_agg(a) from (
select distinct ps.first_nm as first_nm,ps.last_nm as last_nm, ps.affiliation_type, ps.job_title, ps.employee_type, ps.staff_phone_no 
from providerstaff ps 
join prov_monitoring_exit_conf_staff mcfs on  ps.provider_staff_id::character varying  = mcfs.objectid::character varying and  mcfs.delete_sw = 'N'
where mcfs.exit_conf_id = mcf.exit_conf_id and ps.delete_sw = 'N')a) as staffdetails,

(select jsonb_agg(a) from (select distinct mu.username,
mu.email 
,r.name as userrole ,r2.teamtypekey as agencykey
from muser mu
join rolemapping r2 on r2.principalid = mu.id and r2.activeflag = '1'
join role r on r.id = r2.roleid
join prov_monitoring_exit_conf_staff mcfs on  mu.securityusersid = mcfs.objectid  and mcfs.delete_sw = 'N'
where mcf.exit_conf_id = mcfs.exit_conf_id )a) as workerdetail
--,(select jsonb_agg(prv) from (select * from prov_getproviderviolationdetails(null, v_provider_id, 'Monitoring', null, null,null,1,10,null,null,null)prv) as violationdetails)


from prov_monitoring_exit_conf mcf 
inner join prov_monitoring m on m.monitoring_id = mcf.monitoring_id and m.delete_sw = 'N'
inner join prov_violation pv on pv.reference_value_id = m.monitoring_id and pv.delete_sw = 'N'
where m.provider_id =v_provider_id and
case when v_exit_conf_number ::character varying is not null then mcf.exit_conf_number LIKE '%'||v_exit_conf_number::character varying||'%' else true end and  
case when v_ec_status ::character varying is not null then mcf.ec_status ILIKE '%'||v_ec_status ::character varying||'%' else true end and  
case when v_exit_conf_number ::character varying is not null then mcf.exit_conf_number LIKE '%'||v_exit_conf_number ::character varying||'%' else true end and  
case when v_cap_number ::character varying is not null then mcf.cap_number_djs LIKE  '%'||v_cap_number ::character varying||'%' else true end and 
case when v_exit_from_dt ::character varying is not null then mcf.exit_dt>=v_exit_from_dt::date else true end and
case when v_exit_to_dt ::character varying is not null then mcf.exit_dt<=v_exit_to_dt::date else true end 
and mcf.delete_sw = 'N';         
END;
$function$

