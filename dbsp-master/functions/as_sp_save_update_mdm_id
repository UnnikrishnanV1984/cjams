CREATE OR REPLACE FUNCTION as_sp_save_update_mdm_id(person_id uuid, mdm_id character varying, insertedby character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
        vs_person_id                                                            uuid;
  vs_mdm_id                   VARCHAR(100);
        vs_insertedby                                                           VARCHAR(100);
        mdm_id_count                                                             INT;
        response                                                                VARCHAR(50);
 BEGIN
    vs_person_id            := person_id;
    vs_mdm_id               := mdm_id;
    vs_insertedby           := insertedby;
    response                := 'sucess';
    mdm_id_count            := 0;

-- checking to see if mdm id exists --
select COUNT(pi.personidentifiervalue) into mdm_id_count  from  personidentifier  pi  where  pi.personid  =  vs_person_id    and  activeflag  =  1  and pi.personidentifiertypekey  =  'MDM_ID';

IF mdm_id_count > 0 THEN

UPDATE personidentifier SET personidentifiervalue = vs_mdm_id WHERE personid = vs_person_id AND personidentifiertypekey='MDM_ID';

ELSE

insert into personidentifier(personid,personidentifiertypekey,personidentifiervalue,insertedby) values (vs_person_id,'MDM_ID',vs_mdm_id,vs_insertedby);

END IF;
    
RETURN response;

   END
    

$function$

