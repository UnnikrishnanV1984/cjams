CREATE OR REPLACE FUNCTION as_f_ldss_phone(as_staffid uuid)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
BEGIN 
RETURN (
SELECT '('||
  substr(coalesce(workphone ,''),1,3)||
  ')'||' '||
  substr(coalesce(workphone ,''),4,3)||
  '-'||
  substr(coalesce(workphone ,''),7,4)||
  ' '||
  'Ext:'||
  (coalesce(workextn ,'')) 
FROM ldsslocations, tb_picklist_values tpv, userprofileaddress upa
WHERE countytypekey = LTRIM(RTRIM(tpv.picklist_value_cd))
 AND tpv.picklist_type_id = 104 AND tpv.active_sw = 'Y'
 AND tpv.value_tx = upa.county
 AND upa.securityusersid = as_staffid AND upa.activeflag = 1 FETCH FIRST 1 ROWS ONLY);

END ;
$function$

