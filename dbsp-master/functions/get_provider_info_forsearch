CREATE OR REPLACE FUNCTION get_provider_info_forsearch(request json)
 RETURNS TABLE(provider_id integer, tax_id_no numeric, provider_nm character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_provider_id INT;
v_provider_nm CHARACTER varying; 
v_taxid CHARACTER varying; 

BEGIN  
 
 v_provider_id  := request ->> 'providerid';
 v_taxid := request ->> 'taxid';
 v_provider_nm:= request ->> 'providername'; 
 
RETURN QUERY 

SELECT 
prov.provider_id AS provider_id
,prov.tax_id_no AS  tax_id_no,
(CASE WHEN (prov.provider_nm is null OR prov.provider_nm='') THEN 
CONCAT(prov.provider_first_nm,' ',prov.provider_last_nm) ELSE prov.provider_nm END) AS provider_nms
from  tb_provider prov
where
(v_provider_id is null or prov.provider_id = v_provider_id)
 and (case when (trim(v_provider_nm) !=''  or v_provider_nm is not null)  then (COALESCE(lower(prov.provider_nm) ,'') LIKE '%'||COALESCE(lower(v_provider_nm) ,'')||'%' 
or (COALESCE(lower(concat (prov.provider_first_nm,' ',prov.provider_last_nm)) ,'') LIKE '%'||COALESCE(lower(v_provider_nm) ,'')||'%')) else true end) 
AND (v_taxid is null or prov.tax_id_no :: character varying LIKE '%'|| v_taxid ||'%')
and prov.delete_sw = 'N';

END;

$function$

