CREATE OR REPLACE FUNCTION as_ref_val_json_temp2(v_input1 character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 

declare v_result json;
begin
select
 json_agg(row) as output
from
 (
  select distinct ref_key as Input,   /*Instead of Key & Value-Input and Output*/
  value_text as Output
 from
  referencevalues                /*Without Restriction*/
 where
  ref_key in (
  select
   regexp_split_to_table(translate(v_input1, '!@#$%<>":{}[]\\/?.+=^`-&*()', ''), ',')     /*Multiple Delimeter, Based on the column we can replace the Delimeter instead of Comma*/
  from
   TEST_TABLE)) row into
  v_result;

return v_result;
end;

$function$

