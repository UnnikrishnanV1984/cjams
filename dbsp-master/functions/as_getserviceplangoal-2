CREATE OR REPLACE FUNCTION as_getserviceplangoal(v_objectid character varying, fromdate character varying, todate character varying)
 RETURNS TABLE(serviceplangoalid uuid, goaldate timestamp without time zone, goal character varying, strategy character varying, objectid character varying, objecttypekey character varying, goaltypekey character varying, goaldescription character varying, isprojecthome boolean, initialcondition character varying, goalscategorytype character varying, plannedstartdate timestamp without time zone, plandate timestamp without time zone, plannedenddate timestamp without time zone, challenges character varying, strengths character varying, other text, asservicesoncaseid uuid, didclientsign boolean, didprovidersign boolean, clientsigndate timestamp without time zone, provsigndate timestamp without time zone, workersigndate timestamp without time zone, reasonfornoclientsign text, reasonfornoprovsign text, clientsignature text, workersignature text, provsignature text, spcomments text, involvedpersons character varying, iscontinue bigint)
 LANGUAGE plpgsql
AS $function$


begin
 
RETURN  QUERY

select DISTINCT spg.serviceplangoalid,spg.goaldate,spg.goal,spg.strategy,spg.objectid,spg.objecttypekey,spg.goaltypekey,rv.description as goaldescription,spg.isprojecthome,
spg.initialcondition ,spg.goalscategorytype,spg.plannedstartdate,spg.plandate,spg.plannedenddate,spg.challenges,spg.strengths,spg.other, spg.asservicesoncaseid, spg.didclientsign, spg.didprovidersign, spg.clientsigndate, spg.provsigndate, spg.workersigndate,
spg.reasonfornoclientsign, spg.reasonfornoprovsign, spg.clientsignature, spg.workersignature, spg.provsignature, spg.spcomments, spg.involvedpersons, 
(select count(*) from serviceplangoaldetails sd where sd.serviceplangoalid = spg.serviceplangoalid and sd.goaldisposition='Continued') as iscontinue
from serviceplangoal spg
left join referencevalues rv on rv.ref_key=spg.goaltypekey and rv.activeflag=1 and rv.teamtypekey = 'AS'
--left join referencevalues rv1 on rv1.ref_key=spg.goalscategorytype and rv1.activeflag=1
where spg.activeflag=1 and spg.objectid=v_objectid and 
case when fromDate is not null then spg.goaldate >= TO_DATE(fromDate, 'MM/DD/YYYY')  else true end   
and
case when toDate is not null then spg.goaldate <= TO_DATE(toDate, 'MM/DD/YYYY')  else true end    
 order by spg.goaldate desc
; 

End;


$function$

