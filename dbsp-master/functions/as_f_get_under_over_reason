CREATE OR REPLACE FUNCTION as_f_get_under_over_reason(al_entity_id integer, as_entity_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN
RETURN

        ( SELECT F_PDESC(ATD.EVENT_TYPE_CD, 10041) AS REASON
 FROM TB_FISCAL_AUDIT_TRAIL_ENTITY_LINK ATL,
  TB_FISCAL_AUDIT_TRAIL ATD 
 WHERE ATL.FISCAL_AUDIT_TRAIL_ID = ATD.FISCAL_AUDIT_TRAIL_ID
  AND ATL.ENTITY_TYPE_CD = as_entity_type_cd
  AND ATL.ENTITY_ID = al_entity_id 
  AND ATL.DELETE_SW = 'N' 
  AND ATD.DELETE_SW = 'N'
)  ;
 
END

$function$

