CREATE OR REPLACE FUNCTION as_getregulationlibrary(searchobj json)
 RETURNS TABLE(statesstatueid uuid, statestatuteskey character varying, activeflag integer, description character varying, effectivedate timestamp without time zone, expirationdate timestamp without time zone, possiblesanction boolean, possiblereferral character varying, possiblesanctionflag boolean, possiblereferralflag boolean, statestatutetext text, librarytype character varying)
 LANGUAGE plpgsql
AS $function$     
            
DECLARE 
                                                          
v_liPageNumber      INT;                                                          
v_liPageSize       INT;
v_searchText      varchar;       
v_type     varchar;   
v_status integer;                                                       
v_lvServiceRequestNumber    VARCHAR(50);                                                          

v_pageoffset int;
v_pagenumber int;

BEGIN 

v_liPageNumber := searchObj ->> 'page'; 
v_liPageSize := searchObj ->> 'limit'; 
v_searchText := searchObj ->> 'searchtext'; 
v_type := searchObj ->> 'type';
v_status := searchObj ->> 'status';


v_pagenumber := v_liPageNumber-1;
v_pageoffset = v_pagenumber * v_liPageSize;


RAISE NOTICE '%' , v_searchText;
RAISE NOTICE '%' , v_type;
RAISE NOTICE '%' ,v_status;
RAISE NOTICE '%' , v_liPageNumber;
RAISE NOTICE '%' , v_liPageSize;
RAISE NOTICE '%' , v_pagenumber;
RAISE NOTICE '%' , v_pageoffset;


RETURN QUERY


SELECT  
ss.statestatutesid,ss.statestatuteskey, ss.activeflag, ss.description ,ss.effectivedate , ss.expirationdate ,
ss.possiblesanction , ss.possiblereferral , ss.possiblesanctionflag , ss.possiblereferralflag ,ss.statestatutetext ,ss.librarytype 
FROM statestatutes ss 
WHERE CASE WHEN v_searchText is not null THEN lower(ss.statestatuteskey) like '%'||lower(v_searchText)||'%' ELSE TRUE END
AND  CASE WHEN v_type is not null THEN lower(ss.librarytype) = lower(v_type)  ELSE TRUE END
AND CASE WHEN v_status is not null THEN ss.activeflag = v_status ELSE TRUE END
LIMIT v_liPageSize OFFSET v_pageoffset;

END;
$function$

