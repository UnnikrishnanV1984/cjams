CREATE OR REPLACE FUNCTION documentsearch(searchobj json)
 RETURNS TABLE(servicerequestnumber character varying, servicerequesttype character varying, servicerequestsubtype character varying, title character varying, documentidentifier character varying, doctype character varying, receiveddate timestamp without time zone, documentpropertyid uuid)
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_lvDocTypeCount INT;
v_lvDocType varchar(50);
v_ldReceivedFrom TIMESTAMP(3);
v_ldReceivedTo TIMESTAMP(3);
v_luSId INT;
v_lAssigned INT;
v_temp character varying;
v_liPageNumber      INT;                                                          
v_liPageSize       INT; 
v_pageoffset int;
v_pagenumber int;
v_doctidentifier character varying;
v_UserSID character varying;

BEGIN

CREATE TEMP TABLE documentsearch_temp_searchParms(parmKeyword VARCHAR(50),parmValue VARCHAR(1000));
CREATE TEMP TABLE documentsearch_temp_doctypes(parmValue VARCHAR(1000));
CREATE TEMP TABLE documentsearch_temp_daassigned(parmValue VARCHAR(1000));


v_ldReceivedFrom := searchObj ->> 'receivedfrom';
v_ldReceivedTo := searchObj ->> 'receivedto';
v_luSId := searchObj ->> 'userid';
v_liPageNumber := searchObj ->> 'pagenumber';
v_liPageSize := searchObj ->> 'pagesize';
v_doctidentifier := searchObj ->> 'documentidentifer';

v_pagenumber := v_liPageNumber-1;
v_pageoffset = v_pagenumber * v_liPageSize;    

IF LENGTH(searchObj ->> 'assigned_1') > 0 or LENGTH(searchObj ->> 'assigned_2') > 0
THEN
SELECT securityusersid into v_UserSID FROM muser where id = v_luSId;
RAISE NOTICE '%','111111111111111111111111111111111';
END IF;

 INSERT INTO documentsearch_temp_searchParms(parmKeyword, parmValue) VALUES 
 ('doctype_1',searchObj ->> 'doctype_1'),
 ('doctype_2',searchObj ->> 'doctype_2'),
 ('doctype_3',searchObj ->> 'doctype_3'),
 ('doctype_4',searchObj ->> 'doctype_4'),
 ('doctype_5',searchObj ->> 'doctype_5'),
 ('receivedfrom',searchObj ->> 'receivedfrom'),
 ('receivedto',searchObj ->> 'receivedto'),
 ('assigned',searchObj ->> 'assigned_1'),
 ('assigned',searchObj ->> 'assigned_2'),
 ('documentidentifer',searchObj ->> 'documentidentifer');
 RAISE NOTICE '%','22222222222222222222222222';
 SELECT COUNT(*) INTO v_lvDocTypeCount FROM documentsearch_temp_searchParms WHERE parmKeyword in ('doctype_1','doctype_2','doctype_3','doctype_4','doctype_5') and parmValue is not null;
 RAISE NOTICE 'v_lvDocTypeCount  %',v_lvDocTypeCount;
 IF v_lvDocTypeCount > 0 THEN 
 v_lvDocType = 'YES';
 ELSE 
 v_lvDocType = null;
 END IF;
 RAISE NOTICE '%','333333333333333333333333333333';
 /*INSERT INTO documentsearch_temp_daassigned
 SELECT parmValue
 FROM documentsearch_temp_searchParms
 WHERE parmKeyword = 'assigned';*/
 
 INSERT INTO documentsearch_temp_doctypes
 SELECT parmValue
 FROM documentsearch_temp_searchParms
 WHERE parmKeyword in('doctype_1','doctype_2','doctype_3','doctype_4','doctype_5');
 

 SELECT COUNT(1) INTO v_lAssigned FROM documentsearch_temp_searchParms
        WHERE parmValue = 'myteam';
 RAISE NOTICE '%','444444444444444444444444444444444444';       
 IF v_lAssigned > 0
 THEN
  INSERT INTO documentsearch_temp_daassigned
  SELECT "TMA".SecurityUsersId as  "SecurityUsersId"
  FROM TeamMemberAssignment  as "TMA"
  JOIN  TeamMember as "TM" ON "TM".TeamMemberId  = "TMA".TeamMemberId 
  WHERE "TMA".TeamMemberId = "TM".TeamMemberId
  AND "TM".TeamId IN (  SELECT "TM".TeamId
       FROM TeamMember as  "TM"
       JOIN TeamMemberAssignment  as "TMA" ON "TMA".TeamMemberId = "TM".TeamMemberId 
       WHERE "TMA".SecurityUsersId  = v_UserSID 
       );
 END IF;
 RAISE NOTICE '%','5555555555555555555555555555555555';       
 SELECT COUNT(1) INTO v_lAssigned FROM documentsearch_temp_searchParms
        WHERE parmValue = 'mine';
RAISE NOTICE '%','66666666666666666666666666666';       
 IF v_lAssigned > 0 THEN
  INSERT INTO documentsearch_temp_daassigned VALUES(v_UserSID);
 END IF;
  RAISE NOTICE '%','7777777777777777777';   
RAISE NOTICE 'v_lvDocType  %',v_lvDocType;
RAISE NOTICE 'v_luSId  %',v_luSId;
SELECT parmValue into v_temp FROM documentsearch_temp_doctypes where parmValue is not null;
RAISE NOTICE 'parmValue  %', v_temp;
RETURN QUERY
 SELECT DISTINCT ISR.ServiceRequestNumber,
    ISRT.IntakeServReqTypeKey AS ServiceRequestType,
    CAST(SRST.ClassKey as character varying) AS ServiceRequestSubType,
    DP.Title AS Title,
    DP.Tag AS DocumentIdentifier,
    DT.TypeDescription AS DocType,
    DP.insertedon AS ReceivedDate,
    DP.DocumentPropertiesId
 FROM IntakeServiceRequest ISR
  JOIN  DocumentProperties AS DP ON  DP.ObjectId = ISR.IntakeServiceId
  LEFT JOIN  IntakeServiceRequestType AS ISRT ON  ISR.IntakeServReqTypeId = ISRT.IntakeServReqTypeId
  LEFT JOIN  ServiceRequestSubType AS SRST ON  ISR.IntakeServiceRequestClassId = SRST.ServiceRequestSubTypeId
  LEFT JOIN  DocumentType AS DT ON  DT.DocumentTypeKey = DP.DocumentTypeKey
 WHERE  (v_lvDocType IS NULL OR DT.DocumentTypeKey IN (SELECT parmValue FROM documentsearch_temp_doctypes where parmValue is not null))
 AND  (v_ldReceivedFrom IS NULL OR DP.insertedon BETWEEN v_ldReceivedFrom AND v_ldReceivedTo)
 AND  (v_UserSID IS NULL OR DP.insertedby  IN (SELECT parmValue FROM documentsearch_temp_daassigned where parmValue is not null))
 AND  (v_doctidentifier iS NULL OR DP.Tag = v_doctidentifier)
 LIMIT v_liPageSize OFFSET v_pageoffset;
 

DROP TABLE documentsearch_temp_searchParms;
DROP TABLE documentsearch_temp_doctypes;
DROP TABLE documentsearch_temp_daassigned; 
   
END;
$function$

