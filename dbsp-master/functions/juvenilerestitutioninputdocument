CREATE OR REPLACE FUNCTION juvenilerestitutioninputdocument(i_evalutionid uuid)
 RETURNS TABLE(restitution_no character varying, victim_id character varying, youthid character varying, youthfname character varying, youthlname character varying, youthmname character varying, phone character varying, dob character varying, address character varying, pcity character varying, pzipcode character varying, pstate character varying, pcounty character varying, social_security_no character varying, license_no character varying, m_fname character varying, m_lname character varying, m_mname character varying, m_phone character varying, m_dob character varying, m_address character varying, m_city character varying, m_zipcode character varying, m_state character varying, m_social_security_no character varying, m_license_no character varying, f_fname character varying, f_lname character varying, f_mname character varying, f_phone character varying, f_dob character varying, f_address character varying, f_city character varying, f_zipcode character varying, f_state character varying, f_social_security_no character varying, f_license_no character varying, o_fname character varying, o_lname character varying, o_mname character varying, o_phone character varying, o_dob character varying, o_address character varying, o_city character varying, o_zipcode character varying, o_state character varying, o_social_security_no character varying, o_license_no character varying, v_fname character varying, v_lname character varying, v_mname character varying, v_phone character varying, v_address character varying, v_city character varying, v_zipcode character varying, v_state character varying, total_restitution numeric, youth_share numeric, petition_id character varying, court_county character varying, date_ordered timestamp without time zone, payment_plan character varying, police_complaint_id character varying)
 LANGUAGE plpgsql
AS $function$ declare P_ID UUID;

declare I_NUM character varying;
begin
select
 inve.intakenumber into
  I_NUM
 from
  intakeservicerequestevaluation inve
 join intakeservicerequest INTSR on
  INTSR.intakenumber = inve.intakenumber
  and INTSR.activeflag = 1
 join intakeservicerequestactor INSRA on
  INSRA.intakeserviceid = INTSR.intakeserviceid
  and INSRA.activeflag = 1
 join actor ACC on
  ACC.actorid = INSRA.actorid
  and ACC.activeflag = 1
  and ACC.actortype = 'Youth'
 join person p on
  ACC.personid = p.personid
  and p.activeflag = 1
 where
  inve.intakeservicerequestevaluationid = i_evalutionid ;

select
 p.personid into
  P_ID
 from
  intakeservicerequestevaluation inve
 join intakeservicerequest INTSR on
  INTSR.intakenumber = inve.intakenumber
  and INTSR.activeflag = 1
 join intakeservicerequestactor INSRA on
  INSRA.intakeserviceid = INTSR.intakeserviceid
  and INSRA.activeflag = 1
 join actor ACC on
  ACC.actorid = INSRA.actorid
  and ACC.activeflag = 1
  and ACC.actortype = 'Youth'
 join person p on
  ACC.personid = p.personid
  and p.activeflag = 1
 where
  inve.intakeservicerequestevaluationid = i_evalutionid ;

return QUERY (
select
 distinct cast(ir.restitutionno as character varying) as restitution_no,
 cast((select p.cjamspid from intakeservicerequest INTSR join intakeservicerequestactor INSRA on INSRA.intakeserviceid = INTSR.intakeserviceid and INSRA.activeflag = 1 and INSRA.intakeservicerequestpersontypekey = 'Victim' join actor ACC on ACC.actorid = INSRA.actorid and ACC.activeflag = 1 and ACC.actortype = 'Victim' join person p on ACC.personid = p.personid and p.activeflag = 1 and p.personid = P_ID) as character varying) as victim_id,
 cast(p.cjamspid as character varying) as youthid,
 cast(p.firstname as character varying) as youthfname,
 cast(p.lastname as character varying) as youthlname,
 cast(p.middlename as character varying) as youthmname,
 cast(ppn.phonenumber as character varying) as phone,
 cast(to_char(p.dob, 'MM/DD/YYYY') as character varying) as DOB,
 cast(pa.address as character varying) as address,
 cast(pa.city as character varying) as pcity,
 cast(pa.zipcode as character varying) as pzipcode,
 cast(pa.state as character varying) as pstate,
 cast(pa.county as character varying) as pcounty,
 cast(al.ssn as character varying) as social_security_no,
 cast(al.licenseno as character varying) as license_no,
 cast(mother.first_name as character varying) as m_fname,
 cast(mother.last_name as character varying) as m_lname,
 cast(mother.middle_name as character varying) as m_mname,
 cast(mother.pphone as character varying) as m_phone,
 cast(mother.pdob as character varying) as m_DOB,
 cast(mother.p_address as character varying) as m_address,
 cast(mother.pcity as character varying) as m_city,
 cast(mother.pzipcode as character varying) as m_zipcode,
 cast(mother.pstate as character varying) as m_state,
 cast(mother.social_security_no as character varying) as m_social_security_no,
 cast(mother.license_no as character varying) as m_license_no,
 cast(father.first_name as character varying ) as f_fname,
 cast(father.last_name as character varying) as f_lname,
 cast(father.middle_name as character varying) as f_mname,
 cast(father.pphone as character varying) as f_phone,
 cast(father.pdob as character varying) as f_DOB,
 cast(father.p_address as character varying) as f_address,
 cast(father.pcity as character varying) as f_city,
 cast(father.pzipcode as character varying) as f_zipcode,
 cast(father.pstate as character varying) as f_state,
 cast(father.social_security_no as character varying) as f_social_security_no,
 cast(father.license_no as character varying) as f_license_no,
 cast(other.first_name as character varying) as o_fname,
 cast(other.last_name as character varying) as o_lname,
 cast(other.middle_name as character varying) as o_mname,
 cast(other.pphone as character varying) as o_phone,
 cast(other.pdob as character varying) as o_DOB,
 cast(other.p_address as character varying) as o_address,
 cast(other.pcity as character varying) as o_city,
 cast(other.pzipcode as character varying) as o_zipcode,
 cast(other.pstate as character varying) as o_state,
 cast(other.social_security_no as character varying) as o_social_security_no,
 cast(other.license_no as character varying) as o_license_no,
 cast(victim_details.vfirstname as character varying) as v_fname,
 cast(victim_details.vlastname as character varying) as v_lname,
 cast(victim_details.vmiddlename as character varying) as v_mname,
 cast(victim_details.pphone as character varying) as v_phone,
 cast(victim_details.p_address as character varying) as v_address,
 cast(victim_details.pcity as character varying) as v_city,
 cast(victim_details.pzipcode as character varying) as v_zipcode,
 cast(victim_details.pstate as character varying) as v_state,
 ir.payment as total_restitution,
 ir.payment-ir.allocatedamount-ir.paidamount-ir.waivedamount + ir.additionalamount as youth_share,
 isrp.petitionid as petition_id,
 (
  select countyname
 from
  county
 where
  county.countyid = ir.countyid) as court_county,
 isrco.courtorderdatetime as date_ordered,
 ir.frequency as payment_plan,
 inve.complaintid as police_complaint_id
from
 intakeservicerequestevaluation inve
join intakeservicerequest INTSR on
 INTSR.intakenumber = inve.intakenumber
 and INTSR.activeflag = 1
join intakeservicerequestactor INSRA on
 INSRA.intakeserviceid = INTSR.intakeserviceid
 and INSRA.activeflag = 1
join actor ACC on
 ACC.actorid = INSRA.actorid
 and ACC.activeflag = 1
 and ACC.actortype = 'Youth'
join person p on
 ACC.personid = p.personid
 and p.activeflag = 1
join intakeserreqrestitution ir on
 p.personid = ir.youthpersonid
 and p.activeflag = 1
left join personaddress pa on
 pa.personid = p.personid
 and pa.activeflag = 1
left join personphonenumber ppn on
 ppn.personid = p.personid
 and ppn.activeflag = 1
left join alias al on
 al.personid = p.personid
 and al.activeflag = 1
left join intakeservicerequestpetition isrp on
 isrp.intakenumber = ir.intakenumber
left join intakeservicerequestcourtaction isrco on
 isrco.intakeservicerequestpetitionid = isrp.intakeservicerequestpetitionid
left join (
 select
  distinct m.intake_number as intknum,
  person.firstname as first_name,
  person.lastname as last_name,
  person.middlename as middle_name,
  personaddress.address as p_address,
  personaddress.zipcode as pzipcode,
  personaddress.city as pcity,
  personaddress.state as pstate,
  personphonenumber.phonenumber as pphone,
  to_char(person.dob, 'MM/DD/YYYY') as pdob,
  al.ssn as social_security_no,
  al.licenseno as license_no
 from
  person
 left join personaddress on
  person.personid = personaddress.personid
  and personaddress.activeflag = 1
 left join personphonenumber on
  person.personid = personphonenumber.personid
  and personphonenumber.activeflag = 1
 left join actor a on
  a.personid = person.personid
  and a.activeflag = 1
 left join alias al on
  al.personid = person.personid
  and al.activeflag = 1
 join (
  select
   distinct liablepersonid as pid,
   intakenumber as intake_number
  from
   intakeserreqrestitution
  where
   liablepersonrelationtypekey = 'mother'
   and activeflag = 1
   and intakenumber = I_NUM) m on
  person.personid = m.pid ) mother on
  mother.intknum = I_NUM
left join (
 select
  distinct f.intake_number as intknum,
  person.firstname as first_name,
  person.lastname as last_name,
  person.middlename as middle_name,
  personaddress.address as p_address,
  personaddress.zipcode as pzipcode,
  personaddress.city as pcity,
  personaddress.state as pstate,
  personphonenumber.phonenumber as pphone,
  to_char(person.dob, 'MM/DD/YYYY') as pdob,
  al.ssn as social_security_no,
  al.licenseno as license_no
 from
  person
 left join personaddress on
  person.personid = personaddress.personid
  and personaddress.activeflag = 1
 left join personphonenumber on
  person.personid = personphonenumber.personid
  and personphonenumber.activeflag = 1
 left join actor a on
  a.personid = person.personid
  and a.activeflag = 1
 left join alias al on
  al.personid = person.personid
  and al.activeflag = 1
 join (
  select
   distinct liablepersonid as pid,
   intakenumber as intake_number
  from
   intakeserreqrestitution
  where
   liablepersonrelationtypekey = 'father'
   and activeflag = 1
   and intakenumber = I_NUM) f on
  person.personid = f.pid ) father on
  father.intknum = I_NUM
left join (
 select
  distinct o.intake_number as intknum,
  person.firstname as first_name,
  person.lastname as last_name,
  person.middlename as middle_name,
  personaddress.address as p_address,
  personaddress.zipcode as pzipcode,
  personaddress.city as pcity,
  personaddress.state as pstate,
  personphonenumber.phonenumber as pphone,
  to_char(person.dob, 'MM/DD/YYYY') as pdob,
  al.ssn as social_security_no,
  al.licenseno as license_no
 from
  person
 left join personaddress on
  person.personid = personaddress.personid
  and personaddress.activeflag = 1
 left join personphonenumber on
  person.personid = personphonenumber.personid
  and personphonenumber.activeflag = 1
 left join actor a on
  a.personid = person.personid
  and a.activeflag = 1
 left join alias al on
  al.personid = person.personid
  and al.activeflag = 1
 join (
  select
   distinct liablepersonid as pid,
   intakenumber as intake_number
  from
   intakeserreqrestitution
  where
   liablepersonrelationtypekey not in ('father',
   'mother')
   and activeflag = 1
   and intakenumber = I_NUM) o on
  person.personid = o.pid ) other on
 other.intknum = I_NUM
left join (
 select
  INTSR.intakenumber as intakenumber,
  p.lastname as vlastname,
  p.firstname as vfirstname,
  p.middlename as vmiddlename,
  pa.address as p_address,
  pa.zipcode as pzipcode,
  pa.city as pcity,
  pa.state as pstate,
  pp.phonenumber as pphone
 from
  intakeservicerequest INTSR
 left join intakeservicerequestactor INSRA on
  INSRA.intakeserviceid = INTSR.intakeserviceid
  and INSRA.activeflag = 1
  and INSRA.intakeservicerequestpersontypekey = 'Victim'
 left join actor ACC on
  ACC.actorid = INSRA.actorid
  and ACC.activeflag = 1
  and ACC.actortype = 'Victim'
 left join person p on
  ACC.personid = p.personid
  and p.activeflag = 1
 left join personaddress pa on
  p.personid = pa.personid
  and pa.activeflag = 1
 left join personphonenumber pp on
  p.personid = pp.personid
  and pp.activeflag = 1) victim_details on
 ir.intakenumber = victim_details.intakenumber
  
 
limit 1) ;
end;

$function$

