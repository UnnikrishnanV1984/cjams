CREATE OR REPLACE FUNCTION cses_f_prim_worker(ai_entity_id integer, as_entity_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

 
BEGIN  
 RETURN
    CASE
      when as_entity_type_cd = 'client' then
        (select securityusersid from (
SELECT  row_number() over() as num , userprofile.securityusersid
     FROM servicecase sc,   
            intakeservicerequestactor isra,  
            person,
     caseassignment,
     userprofile  

     WHERE ( isra.servicecaseid = sc.servicecaseid ) and  
            ( person.personid  = isra.personid )  and
     ( caseassignment.objecttypekey = 'servicecase') and
     ( caseassignment.objectid = isra.servicecaseid) and 
     ( caseassignment.responsibilitytypekey = 'family') and 
     ( caseassignment.enddate IS  NULL) and 
     ( userprofile.securityusersid = caseassignment.toworkeridno) and 
      ( person.cjamspid = AI_ENTITY_ID) and
     ( sc.activeflag = 1) and
     ( person.activeflag = 1) and
     ( caseassignment.activeflag = 1) and
     ( userprofile.activeflag = 1))as er where num=1 )
        
 
    else
  (select securityusersid from (
SELECT  row_number() over() as num,userprofile.securityusersid
     FROM  caseassignment,
           userprofile,
     intakeservicerequestactor isra,
     person
     WHERE ( caseassignment.objecttypekey = AS_ENTITY_TYPE_CD) and
            ( caseassignment.objectid = isra.servicecaseid) and
   ( person.personid  = isra.personid ) and 
    ( person.cjamspid = AI_ENTITY_ID) and 
            ( caseassignment.responsibilitytypekey = 'family') and
            ( caseassignment.enddate IS NULL) and
            ( userprofile.securityusersid = caseassignment.toworkeridno)  and
            ( caseassignment.activeflag = 1) and
            ( userprofile.activeflag = 1) ) as ty where num=1)

    END;
END;

$function$

