CREATE OR REPLACE FUNCTION prov_searchcaseworkerattachments(v_servicecaseid character varying, v_servicerequestid character varying, v_adoptioncaseid character varying, v_objecttypekey character varying, pageno integer, pagesize integer, v_category character varying, v_subcategory character varying, v_sortcol character varying, v_sortorder character varying, v_displayname character varying, v_intakenumber character varying, v_personid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE
 jsondata json;

BEGIN
 
 
 
 SELECT JSON_AGG(pla) INTO jsondata FROM (
select COUNT(1) over(),dp.documentpropertiesid, dp.objecttypekey,dp.title,   dp.documenttypekey, dp.insertedon, dp.updatedon, 
 dp.insertedby,  dp.updatedby,  dp.documentdate,  dp.mime,  dp.insertedby,  dp.s3bucketpathname,
 dp.description,  dp.filename,  dp.numberofbytes,  dp.originalfilename,  dp.servicecaseid,up.displayname,
 
(SELECT json_agg (e) FROM( select da.documentpropertiesid, da.attachmenttypekey,da.attachmentclassificationtypekey ,da.assessmenttemplateid,
da.attachmentclassificationsubtypekey from documentattachment da where da.documentpropertiesid = dp.documentpropertiesid and da.activeflag=1
)as  e ) as documentattachment,
(SELECT json_agg (e) FROM( select securityusersid, firstname, lastname, displayname from userprofile up where up.securityusersid = dp.updatedby and up.activeflag=1 
)as  e ) as userprofile ,
(SELECT json_agg (e) FROM( select securityusersid, firstname, lastname, displayname from userprofile up where up.securityusersid = dp.updatedby and up.activeflag=1 
)as  e ) as updateduserprofile 
from documentproperties dp 
left join documentattachment da on da.documentpropertiesid = dp.documentpropertiesid and dp.activeflag=1
left join userprofile up on up.securityusersid = da.updatedby and up.activeflag=1
where --dp.objectid=v_servicecaseid :: uuid    
--AND CASE WHEN v_objecttypekey IS NOT NULL  
-- THEN 
-- case dp.objecttypekey  when 'Servicecase'
-- (dp.objecttypekey = 'Servicecase') ---or (dp.objecttypekey = 'Adoptioncase') or (dp.objecttypekey = 'ServiceRequest')  
-- --ELSE true end
da.activeflag=1 and --dp.objecttypekey = v_objecttypekey and 
CASE WHEN v_servicecaseid IS NOT NULL  then dp.servicecaseid=v_servicecaseid :: uuid and (dp.objecttypekey = v_objecttypekey or dp.objecttypekey in('CasePerson'))
  WHEN v_adoptioncaseid IS NOT NULL  then dp.objectid=v_adoptioncaseid :: uuid and dp.objecttypekey = v_objecttypekey
  WHEN v_servicerequestid IS NOT NULL  then dp.servicerequestid=v_servicerequestid :: uuid 
  and (dp.objecttypekey = v_objecttypekey or dp.objecttypekey in('CasePerson'))
  WHEN v_intakenumber IS NOT NULL and v_objecttypekey='ServiceRequest' then dp.intakenumber=v_intakenumber   
  WHEN v_personid IS NOT NULL  then 
  (  dp.objecttypekey = 'Person'and dp.objectid = v_personid :: uuid ) or  
  (  dp.objecttypekey = 'CasePerson' and dp.objectid = v_personid :: uuid )--and dp.intakenumber = v_intakenumber )
   
   
  else true end 
AND CASE WHEN v_category IS NOT NULL and v_category!='' THEN 
 (da.attachmentclassificationtypekey = any (v_category :: text[])) ELSE true end
AND CASE WHEN v_subcategory IS NOT NULL and v_subcategory!='' THEN 
 (da.attachmentclassificationsubtypekey  = any (v_subcategory :: text[])) ELSE true END
and case when v_displayname is not null and v_displayname!='' then 
 up.displayname ilike '%' || v_displayname || '%' else true end 
 group by  
  dp.documentpropertiesid, dp.title, dp.documenttypekey, dp.insertedon, dp.updatedon, 
 dp.insertedby,  dp.updatedby,  dp.documentdate,  dp.mime,  dp.insertedby,  dp.s3bucketpathname,
 dp.description,  dp.filename,  dp.numberofbytes,  dp.originalfilename,  dp.servicecaseid,up.displayname
 
 
 ORDER BY 
    (
 case
  v_sortorder
  when 'asc' then
  case v_sortcol
  when 'title' then COALESCE(dp.title  ,'')
  when 'documenttypekey' then COALESCE(dp.documenttypekey ,'')
  when 'insertedon' then dp.insertedon :: character varying
  when 'updatedon' then dp.updatedon :: character varying
  when 'insertedby' then COALESCE(dp.insertedby  ,'')
  when 'updatedby' then COALESCE(dp.updatedby ,'')
  when 'documentdate' then dp.documentdate :: character varying
  when 'mime' then COALESCE(dp.mime ,'')
  when 'description' then COALESCE(dp.description ,'')
  when 'filename' then COALESCE(dp.filename ,'')
  when 'originalfilename' then COALESCE(dp.originalfilename ,'')
   else dp.updatedon  :: character varying
  end
  else  NULL 
 end) ASC,
 (
 case
  v_sortorder
  when 'desc' then
  case
   v_sortcol
  when 'title' then COALESCE(dp.title  ,'')
  when 'documenttypekey' then COALESCE(dp.documenttypekey ,'')
  when 'insertedon' then dp.insertedon :: character varying
  when 'updatedon' then dp.updatedon :: character varying
  when 'insertedby' then COALESCE(dp.insertedby ,'')
  when 'updatedby' then COALESCE(dp.updatedby ,'')
  when 'documentdate' then dp.documentdate :: character varying
  when 'mime' then COALESCE(dp.mime ,'')
  when 'description' then COALESCE(dp.description ,'')
  when 'filename' then COALESCE(dp.filename ,'')
  when 'originalfilename' then COALESCE(dp.originalfilename ,'')
   else dp.updatedon  :: character varying
  end
  else NULL
 end ) DESC


 LIMIT pagesize OFFSET (pageno - 1) * pagesize ) AS pla;

RETURN jsondata ;

END;

$function$

