CREATE OR REPLACE FUNCTION f_getmaltreatorperson(v_investigationallegationid uuid)
 RETURNS uuid
 LANGUAGE plpgsql
AS $function$

DECLARE
   
    v_case_count bigint;
    
BEGIN

return
    (
        select distinct personid from intakeservicerequestactor i 
  inner join investigationallegationmaltreators m 
  on m.intakeservicerequestactorid = i.intakeservicerequestactorid and m.activeflag = 1
  where m.investigationallegationid= v_investigationallegationid limit 1
    );
END;

$function$

