CREATE OR REPLACE FUNCTION as_personalerttypegetvalues(vpersonid uuid)
 RETURNS TABLE(personalerttypekey character varying, typedescription character varying, helptext text, manualdeleteflag boolean)
 LANGUAGE plpgsql
AS $function$
DECLARE

begin
 
 return query
 
 select pa.personalerttypekey as personalerttypekey,pa.typedescription,pa.helptext,pa.manualdeleteflag 
 from personalerttype pa where
 case when vpersonid is not null then pa.personalerttypekey not in 
 (select alerttype from personalert where personid = vpersonid
 and activeflag = 1 and status = 'Active') else true end 
 order by typedescription asc;
 
 
end;
$function$

