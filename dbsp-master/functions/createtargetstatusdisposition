CREATE OR REPLACE FUNCTION createtargetstatusdisposition(servicerequesttypeconfigdispositioncodeid uuid, servicerequestdispositionsubtypeconfigid uuid, intakeserviceid uuid, roletypekey character varying, securityusersid character varying, closingcodetypekey character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

 #variable_conflict error
 #variable_conflict use_variable
 #variable_conflict use_column

DECLARE
 v_src_statustypekey character varying;
 v_src_dispositioncode character varying;
 v_src_dispositionsubtypekey character varying;
 v_intakeserviceid uuid;
 v_src_servicerequesttypeconfigid uuid;
 v_servicerequesttypeconfigdispositioncodeid uuid;
 v_servicerequestdispositionsubtypeconfigid uuid;
 v_roletypekey character varying;
 v_securityusersid character varying;
 v_closingcodetypekey character varying;
 
 v_target_statustypekey character varying;
 v_target_dispositioncode character varying;
 v_target_srtconfigdispositioncodid uuid;
 v_target_intakeserreqstatustypeid uuid;
 v_created_isrdispositioncodeid uuid;
BEGIN
 

 v_intakeserviceid := intakeserviceid;
 v_servicerequesttypeconfigdispositioncodeid := servicerequesttypeconfigdispositioncodeid;
 v_servicerequestdispositionsubtypeconfigid := servicerequestdispositionsubtypeconfigid;
 v_roletypekey := roletypekey;
 v_securityusersid := securityusersid;
 v_closingcodetypekey := closingcodetypekey;
 
 select srdstc.dispositioncode into v_src_dispositionsubtypekey from servicerequestdispositionsubtypeconfig srdstc
  where srdstc.servicerequestdispositionsubtypeconfigid = v_servicerequestdispositionsubtypeconfigid;
 
 select isrst.intakeserreqstatustypekey, srtcdc.dispositioncode, srtcdc.servicerequesttypeconfigid
  into v_src_statustypekey, v_src_dispositioncode, v_src_servicerequesttypeconfigid
 from servicerequesttypeconfigdispositioncode srtcdc
 join intakeserreqstatustype isrst on isrst.intakeserreqstatustypeid = srtcdc.intakeserreqstatustypeid
  and isrst.activeflag = 1
 where srtcdc.servicerequesttypeconfigiddispostionid = v_servicerequesttypeconfigdispositioncodeid and srtcdc.activeflag = 1
  and (srtcdc.roletypekey is null or srtcdc.roletypekey = v_roletypekey);

 select srdtc.targetstatustypekey, srdtc.targetdispositioncode into v_target_statustypekey, v_target_dispositioncode 
  from servicerequestdispositiontargetconfig srdtc where srdtc.statustypekey = v_src_statustypekey 
  and srdtc.dispositioncode = v_src_dispositioncode and (v_src_dispositionsubtypekey is null or srdtc.dispositionsubtypekey = v_src_dispositionsubtypekey) 
  and srdtc.roletypekey = v_roletypekey and srdtc.activeflag = 1; 
 
 select srtcdc.servicerequesttypeconfigiddispostionid, srtcdc.intakeserreqstatustypeid into v_target_srtconfigdispositioncodid, v_target_intakeserreqstatustypeid
 from servicerequesttypeconfigdispositioncode srtcdc
  join intakeserreqstatustype isrst on isrst.intakeserreqstatustypeid = srtcdc.intakeserreqstatustypeid
  and isrst.activeflag = 1
 where srtcdc.servicerequesttypeconfigid = v_src_servicerequesttypeconfigid and srtcdc.dispositioncode = v_target_dispositioncode
  and isrst.intakeserreqstatustypekey = v_target_statustypekey and srtcdc.activeflag = 1;
 
 if v_target_intakeserreqstatustypeid is not null and v_target_srtconfigdispositioncodid is not null then
 
  v_created_isrdispositioncodeid := gen_random_uuid();
  insert into intakeservicerequestdispositioncode (intakeservicerequestdispositioncodeid, intakeserviceid, insertedby, intakeserreqstatustypeid, servicerequesttypeconfigiddispostionid, closingcodetypekey, activeflag, updatedby, updatedon) 
  values (v_created_isrdispositioncodeid, v_intakeserviceid, v_securityusersid, v_target_intakeserreqstatustypeid, v_target_srtconfigdispositioncodid, v_closingcodetypekey, 1
  , v_securityusersid, now());
 
  Update Intakeservicerequest set intakeserreqstatustypeid = v_target_intakeserreqstatustypeid where intakeserviceid = v_intakeserviceid;
  
  RETURN v_created_isrdispositioncodeid :: character varying;
 end if;
 
 RETURN '' :: character varying;
 
END;

$function$

