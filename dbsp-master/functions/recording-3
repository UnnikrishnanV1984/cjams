CREATE OR REPLACE FUNCTION recording(recordingdetailsjsondata json, intakeserviceid uuid, daservicerequestnumber character varying, securityuserid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

declare l_recording json;
l_newProgressnoteId uuid;
v_DAServiceRequestNumber VARCHAR(50);
v_securityuserid character varying;
v_date timestamp without time zone;
recordingsloop json;
v_RecordingDetailsjsondata json;
v_IntakeServiceId uuid;
v_contactroletypekey json;
v_role json;
begin
 v_date:= now() ;
 v_RecordingDetailsjsondata := RecordingDetailsjsondata; 
 v_DAServiceRequestNumber := DAServiceRequestNumber;
 v_securityuserid := securityuserid;
 v_IntakeServiceId := IntakeServiceId;
 
  FOR recordingsloop IN SELECT * FROM json_array_elements(v_RecordingDetailsjsondata)
            LOOP
                IF(recordingsloop->>'RecordingDA' = v_DAServiceRequestNumber)
                THEN 

 v_contactroletypekey:= recordingsloop->>'contactroletypekey';               

                FOR v_role IN SELECT * FROM json_array_elements(v_contactroletypekey) LOOP
                INSERT INTO progressnote(
                        progressnotetypeid, title, description, entitytype, 
                        entitytypeid, pagetitle, pageurl, islatest,insertedby, 
                        insertedon, 
                        savemode, progressnotesubtypeid, contactdate, contactname, progressnotetypekey, 
                        contactroletypekey, contactphone, contactemail, attemptindicator, 
                        activeflag)            
                VALUES ((recordingsloop->>'RecordingType')::uuid,SUBSTRING(recordingsloop->>'title',1,50),recordingsloop->>'description','intakeservicerequest',v_IntakeServiceId,
                recordingsloop->>'pagetitle',recordingsloop->>'pageurl',(recordingsloop->>'Islatest')::int,v_securityuserid,v_date,1::boolean,(recordingsloop->>'RecordingsubType')::uuid,
                (recordingsloop->>'contactdate')::timestamp,recordingsloop->>'contactname',recordingsloop->>'progressnotetypekey',v_role->>'contactroletypekey',recordingsloop->>'contactphone',
                recordingsloop->>'contactEmail',(recordingsloop->>'Attemptindicator')::boolean,1) RETURNING "progressnoteid" INTO l_newProgressnoteId;

                INSERT INTO progressnotedetail(
                        progressnoteid, description, activeflag, 
                        effectivedate, insertedby, insertedon)
                VALUES (l_newProgressnoteId,recordingsloop->>'description',1,v_date,v_securityuserid,v_date);
  END LOOP;
                END IF;
                
            END LOOP;
   
        
return l_recording;        
end;

$function$

