CREATE OR REPLACE FUNCTION prov_addupdatecpamedicalinfo(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                               
     v_providerId int4;
     v_securityuserid character varying; 
     i json;                                                                                                                                                                                                                                                                                                                                                                                               
     v_cpa_siteid bigint;  
     v_cpa_provider_id bigint;
     v_cpa_household_id uuid;
     v_cpa_test_date timestamp;
     v_ismedical_family_record bool ;
     v_medical_type character varying;
     medical json;
     v_isdraft bool;
     v_check int;
     v_provider_cpa_adop_person_id int;
   
 begin
  
   v_providerId := insertobj->>'provider_id';                                                                                                                                                                                                                                                                                                                                                            
   v_securityuserid := insertobj->>'securityuserid';                                                                                                                                                                                                                                                                                                                                                     
   v_cpa_siteid := insertobj->>'cpa_siteid';
   v_cpa_household_id := insertobj->>'cpa_household_id';
   v_cpa_provider_id := insertobj->>'cpa_provider_id';
   medical := insertobj->>'medicalData';
   v_isdraft := insertobj->>'is_draft';
   v_provider_cpa_adop_person_id := insertobj->>'provider_cpa_adop_person_id';
  
  
select count(*) into v_check from tb_prov_cpa_medical where cpa_household_id=v_cpa_household_id;

if v_check > 0 then 

update tb_prov_cpa_medical set active_flag=0 where cpa_household_id=v_cpa_household_id;

end if;


                                                                                                                                                                                                                                                                                                                                                                                                        
FOR i IN SELECT * FROM json_array_elements(medical)

LOOP
    

INSERT INTO tb_prov_cpa_medical 
(provider_id,cpa_siteid,cpa_test_date,ismedical_family_record,medical_type,create_ts,create_user_id,update_ts,update_user_id,active_flag,is_draft,cpa_household_id,cpa_provider_id, provider_cpa_adop_person_id)                                                                                                                                         
values( v_providerId::int4, v_cpa_siteid::bigint,(i->>'cpa_test_date')::timestamp,(i->>'ismedical_family_record')::bool,(i->>'medical_type'),now(),v_securityuserid,now(),v_securityuserid,1,v_isdraft,v_cpa_household_id,v_cpa_provider_id, v_provider_cpa_adop_person_id);          

end loop;


return 'success';  
                                                                                                                                                                                                                                                                                                                                                                                              
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

