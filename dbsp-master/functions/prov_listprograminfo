CREATE OR REPLACE FUNCTION prov_listprograminfo(v_site_id bigint)
 RETURNS TABLE(provider_id integer, site_id bigint, provnm text, prgram character varying, program_name character varying, program_type character varying, license_no character varying, license_issue_dt date, license_expiry_dt date, license_capacity integer, agency character varying, approval_dt timestamp without time zone, director_info json)
 LANGUAGE plpgsql
AS $function$

    begin
        
        
    return query 

    select tp.provider_id,tpa.site_id,concat_ws(' ',provider_first_nm,provider_last_nm ) as provnm,tpa.prgram,tpa.program_name,tpa.program_type,tpl.license_no,
    tpl.license_issue_dt,tpl.license_expiry_dt,pac.children_no,tp.agency,
    (select tpd.insertedon from tb_provider_decision tpd where tpd.objectid = tpa.applicant_id 
    and tpd.fromroleid = 'Executive Director' and tpd.status = 'Approved' and tpd.activeflag = 1 limit 1) as approval_dt,
    case when tp.agency = 'OLM' 
    then (select json_agg(a) as DIRECTOR_INFO from (select mu.securityusersid,mu.username,mu.email,tm.roletypekey,
    --(select json_agg(x) from ()x) as contact_details
    (select  upp.phonenumber  as cell from userprofilephonenumber
    upp where mu.securityusersid = upp.securityusersid and upp.activeflag = 1 and userprofiletypekey = 'cell' limit 1)
    ,(select  upp.phonenumber  as cell from userprofilephonenumber
    upp where mu.securityusersid = upp.securityusersid and upp.activeflag = 1 and userprofiletypekey = 'fax' limit 1)
    from team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 
    join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
    join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
    where r.roletypekey = 'OLMED')a)   
    else (select json_agg(a) as DIRECTOR_INFO from (select mu.securityusersid,mu.username,mu.email,tm.roletypekey,
    --(select json_agg(x) from ()x) as contact_details
    (select  upp.phonenumber  as cell from userprofilephonenumber
    upp where mu.securityusersid = upp.securityusersid and upp.activeflag = 1 and userprofiletypekey = 'cell' limit 1)
    ,(select  upp.phonenumber  as cell from userprofilephonenumber
    upp where mu.securityusersid = upp.securityusersid and upp.activeflag = 1 and userprofiletypekey = 'fax' limit 1)
    from team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 
    join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
    join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
    where r.roletypekey = 'PVRDJSPD')a) 
    end
    from tb_provider tp 
    join tb_provider_applicant tpa on tpa.provider_id = tp.provider_id::character varying and tpa.delete_sw = 'N'
    join tb_provider_licensing tpl on  tpa.site_id = tpl.site_id and tpl.delete_sw = 'N'
    join tb_prov_accomodation pac on pac.license_application_id = tpl.license_application_id and pac.delete_sw = 'N' 
    where tpa.site_id = v_site_id;
            
    END;
    $function$

