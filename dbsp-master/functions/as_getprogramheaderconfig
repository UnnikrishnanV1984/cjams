CREATE OR REPLACE FUNCTION as_getprogramheaderconfig(actiontypekey character varying, v_programtypekey text)
 RETURNS TABLE(programconfigid uuid, isparent character varying, displayorder integer, programdescription character varying, headerdescription character varying)
 LANGUAGE plpgsql
AS $function$

declare
v_actiontypekey character varying;
v_search text[];
begin
 v_actiontypekey:=actiontypekey;
v_search :=v_programtypekey;

RAISE NOTICE 'test %',v_programtypekey;

RETURN query
select apc.programconfigid, apc.isparent,apc.displayorder, rv.description as programdescription,vr.description as headerdescription from actionletterprogramconfig apc
left join referencevalues rv on rv.ref_key=apc.comartypekey
left join referencetype rt on rt.referencetypeid=rv.referencetypeid 
left join actionletterheaderconfig ahc on ahc.headerconfigid=apc.headerconfigid
left join referencevalues vr on vr.ref_key=ahc.headertypekey
where apc.actiontypekey= v_actiontypekey and apc.programtypekey=ANY(v_search) 
order by apc.displayorder;

end;

$function$

