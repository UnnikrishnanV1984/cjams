CREATE OR REPLACE FUNCTION prov_cferesourcehomechild(v_providerid bigint)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 

DECLARE
returnStatus text;
v_cfechilddata json;


BEGIN

select jsonb_agg (a) into v_cfechilddata from (
    select p.cferesourcehomechild,p.personid,p.firstname,p.lastname from person p 
    left join tb_placement tp on p.cjamspid = tp.client_id  
    where tp.provider_id = v_providerid 
    and tp.delete_sw = 'N' 
 and tp.entry_dt is not null 
 and tp.exit_dt is null
 and ( tp.void_sw = 'N' or tp.void_sw  is null)
 and p.cferesourcehomechild = true
) a;

RETURN v_cfechilddata;
                                                      
END;

$function$

