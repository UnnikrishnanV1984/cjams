CREATE OR REPLACE FUNCTION courtmemorandum(i_petitionid uuid, i_secid character varying)
 RETURNS TABLE(currentdate character varying, youthname character varying, youthid character varying, dob character varying, petition_id character varying, courtorderdate timestamp without time zone, officername character varying, officerphone character varying, court character varying)
 LANGUAGE plpgsql
AS $function$
   BEGIN    
 RETURN QUERY    
   (select CAST(to_char(now(),'MM/DD/YYYY') as character varying) as currentdate,
   cast(p.firstname ||' '|| p.lastname as character varying) as youthname,
   cast (p.cjamspid as character varying)as youthid,
      cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as DOB,
   cast(pe.petitionid as character varying) as petition_id,
       cast(ca.courtorderdatetime as timestamp) as courtorderdate ,
      (select distinct up.fullname from userprofile up where securityusersid = cast(i_secid as character varying)) as officername,
      (select distinct phonenumber from userprofilephonenumber where securityusersid = cast(i_secid as character varying)) as officerphone,
       cast('Court' as character varying) as court
       from 
        intakeservicerequest ins 
       left join intakeservicerequestdispositioncode itsdc on ins.intakeserviceid =itsdc.intakeserviceid and itsdc.activeflag=1
       left join intakeservicerequestactor INSRA on INSRA.intakeserviceid=ins.intakeserviceid and INSRA.activeflag=1
  left join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype='Youth'
   left join person p on p.personid=ACC.personid and p.activeflag=1
   left join intakeservicerequestpetition pe on  pe.intakenumber=ins.intakenumber and pe.activeflag=1
   left join intakeservicerequestcourtaction ca on ca.intakenumber=pe.intakenumber and ca.activeflag=1
       where  pe.intakeservicerequestpetitionid = i_petitionid and p.cjamspid is not null) ; 
   end;
  $function$

