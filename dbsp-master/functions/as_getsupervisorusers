select distinct  ta.securityusersid ,ta.teammemberid,r.roletypekey ,
cast(rm.teamtypekey as character varying) agency,tm.teamid, tm.loadnumber,
replace(r.description ,','||rm.teamtypekey,'') rolename,true supervisor ,up.firstname,up.lastname
from userprofile up
inner join as_teammemberassignment ta on ta.securityusersid=up.securityusersid and ta.activeflag=1
inner join teammember tm on ta.teammemberid=tm.teammemberid and tm.activeflag=1
inner join team t on t.teamid=tm.teamid and t.activeflag=1
inner join securityusers su on su.securityusersid=up.securityusersid and su.activeflag=1
inner join muser m on m.securityusersid=up.securityusersid and m.activeflag=1
inner join rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
inner join role r on r.id = rm.roleid and r.activeflag=1 and r.roletypekey = 'ASSP' 
where up.activeflag=1 and t.countyid = v_countyid;


END;

