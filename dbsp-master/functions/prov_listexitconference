CREATE OR REPLACE FUNCTION prov_listexitconference(v_object_type character varying, v_object_id character varying)
 RETURNS TABLE(monitoring_id character varying, exit_conf_id integer, summary character varying, exit_dt timestamp without time zone, program_changes character varying, exit_conf_number character varying, ec_status character varying, ec_source character varying[], ec_source_other_text character varying, object_type character varying, object_id character varying, provider_id integer)
 LANGUAGE plpgsql
AS $function$
declare

begin 
return query 
select distinct mcf.monitoring_id,mcf.exit_conf_id,mcf.summary,mcf.exit_dt,mcf.program_changes,mcf.exit_conf_number,mcf.ec_status,
string_to_array(mcf.ec_source, ',')::character varying[], mcf.ec_source_other_text, (case when mcf.object_type is null then 'Monitoring'::varchar else mcf.object_type::varchar end) as object_type, (case when mcf.object_id is null then mcf.monitoring_id::varchar else mcf.object_id::varchar end) as object_id, mcf.provider_id 
from prov_monitoring_exit_conf mcf 
left join prov_monitoring m on m.monitoring_id = mcf.monitoring_id and m.delete_sw = 'N'
where case when v_object_type = 'Provider' then (case when  mcf.monitoring_id is not null then  m.provider_id =v_object_id else mcf.object_id =v_object_id end) else 
mcf.object_type = v_object_type and mcf.object_id = v_object_id end and mcf.delete_sw = 'N';
    
END;
$function$

