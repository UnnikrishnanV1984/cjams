CREATE OR REPLACE FUNCTION as_updateapplicationperson(v_objectid character varying, v_type character varying, v_securityuserid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

declare

v_inquiryid character varying;
v_inquirystatus character varying;
v_returnstatus character varying;


begin
  select replace(v_objectid,'A','R') into v_inquiryid;
  IF (v_type = 'application') then
  select updateinquiryperson into v_inquirystatus from as_updateinquiryperson(v_inquiryid,'inquiry',v_securityuserid);
  end if;
 
  IF (v_inquirystatus = 'Inquiry updated') then
  update tb_public_provider_applicant
set individual_applicant_first_nm=t.individual_applicant_first_nm,
    individual_applicant_ssn=t.individual_applicant_ssn,
 individual_applicant_dob=t.individual_applicant_dob,
 co_applicant_first_nm=t.co_applicant_first_nm, 
 co_applicant_ssn=t.co_applicant_ssn,
 co_applicant_dob=t.co_applicant_dob,
 individual_applicant_middle_nm=t.individual_applicant_middle_nm, 
 individual_applicant_last_nm=t.individual_applicant_last_nm,
 co_applicant_middle_nm=t.co_applicant_middle_nm,
 co_applicant_last_nm=t.co_applicant_last_nm, 
 individual_applicant_prefix=t.individual_applicant_prefix, 
 individual_applicant_suffix=t.individual_applicant_suffix,
 co_applicant_prefix=t.co_applicant_prefix, 
 co_applicant_suffix=t.co_applicant_suffix,
 individual_applicant_hm_phone=t.individual_applicant_hm_phone,
 individual_applicant_cell_nm=t.individual_applicant_cell_nm,
 individual_applicant_email=t.individual_applicant_email,
 individual_applicant_employer_nm=t.individual_applicant_employer_nm,
 individual_applicant_phone_nm=t.individual_applicant_phone_nm, 
 individual_applicant_us_citizen=t.individual_applicant_us_citizen, 
 co_applicant_hm_phone=t.co_applicant_hm_phone,
 co_applicant_cell_nm=t.co_applicant_cell_nm,
 co_applicant_email=t.co_applicant_email,
 co_applicant_employer_nm=t.co_applicant_employer_nm,
 co_applicant_phone_nm=t.co_applicant_phone_nm,
 co_applicant_us_citizen=t.co_applicant_us_citizen from
(SELECT 
individual_applicant_first_nm, individual_applicant_ssn, individual_applicant_dob,co_applicant_first_nm, co_applicant_ssn, co_applicant_dob, individual_applicant_middle_nm, individual_applicant_last_nm,co_applicant_middle_nm, co_applicant_last_nm, individual_applicant_prefix, individual_applicant_suffix, co_applicant_prefix, co_applicant_suffix,individual_applicant_hm_phone, individual_applicant_cell_nm, individual_applicant_email, individual_applicant_employer_nm,individual_applicant_phone_nm, individual_applicant_us_citizen, co_applicant_hm_phone, co_applicant_cell_nm, co_applicant_email,co_applicant_employer_nm, co_applicant_phone_nm, co_applicant_us_citizen
FROM tb_public_provider_referral WHERE referral_id=v_inquiryid) as t where applicant_id=v_objectid;


update tb_public_provider_applicant_household set 
              household_member_dob=t.individual_applicant_dob,
              household_member_ssn=t.individual_applicant_ssn,
              household_member_first_name=t.individual_applicant_first_nm,
              household_member_middle_name=t.individual_applicant_middle_nm,
              household_member_last_name=t.individual_applicant_last_nm from
(select individual_applicant_dob,individual_applicant_ssn::numeric,individual_applicant_first_nm,individual_applicant_middle_nm,individual_applicant_last_nm FROM tb_public_provider_referral WHERE referral_id=v_inquiryid)
as t where object_id=v_objectid and household_member_relation='Individual Applicant';


update tb_public_provider_applicant_household set 
              household_member_dob=t.co_applicant_dob,
              household_member_ssn=t.co_applicant_ssn,
              household_member_first_name=t.co_applicant_first_nm,
              household_member_middle_name=t.co_applicant_middle_nm,
              household_member_last_name=t.co_applicant_last_nm from
(select co_applicant_dob,co_applicant_ssn::numeric,co_applicant_first_nm,co_applicant_middle_nm,co_applicant_last_nm FROM tb_public_provider_referral WHERE referral_id=v_inquiryid)
as t where object_id=v_objectid and household_member_relation='Co Applicant';

update tb_provider_applicant_addresses tpp set adr_street_nm=t.adr_street_nm,adr_city_nm=t.adr_city_nm,adr_state_cd = t.adr_state_cd,adr_zip5_no=t.adr_zip5_no from
(select tpa.adr_street_nm,tpa.adr_city_nm,tpa.adr_state_cd,tpa.adr_zip5_no,tpa.address_id from tb_provider_applicant_addresses tpa
inner join tb_provider_address_mapping tpam on tpam.address_id=tpa.address_id where tpam.object_id=v_inquiryid and address_type='Individual Applicant Address') as t where tpp.address_id=t.address_id and delete_sw='N';

update tb_provider_applicant_addresses tpp set adr_street_nm=t.adr_street_nm,adr_city_nm=t.adr_city_nm,adr_state_cd = t.adr_state_cd,adr_zip5_no=t.adr_zip5_no from 
(select tpa.adr_street_nm,tpa.adr_city_nm,tpa.adr_state_cd,tpa.adr_zip5_no,tpa.address_id from tb_provider_applicant_addresses tpa
inner join tb_provider_address_mapping tpam on tpam.address_id=tpa.address_id where tpam.object_id=v_inquiryid and address_type='Co-Applicant Address') as t where tpp.address_id=t.address_id and delete_sw='N';
  
  
  v_returnstatus := 'Application updated';
 else 
  v_returnstatus := 'Failure';
  END IF;


RETURN v_returnstatus;
                                                      
END;

$function$

