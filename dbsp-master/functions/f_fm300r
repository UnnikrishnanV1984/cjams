                                           0)
                                      + COALESCE (
                                           (SELECT SUM (
                                                      TAT.TRANSACTION_AMOUNT_NO)
                                                FROM TB_ACCOUNT_TRANSACTION TAT
                                               WHERE     TAT.CLIENT_ACCOUNT_ID =
                                                         CA.CLIENT_ACCOUNT_ID
                                                     AND TAT.DELETE_SW = 'N'
                                                     AND TAT.TRANSACTION_TYPE_CD =
                                                         '588'
                                                     AND TAT.CREDIT_DEBIT_SW = 'C'
                                                     AND TAT.TRANSACTION_SOURCE_CD =
                                                         '5473'
                                                     AND TAT.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                         '3047'
                                                     AND TAT.BENEFIT_START_DT <
                                                         CAST (START_DATE AS DATE)
                                                     AND TAT.TRANSACTION_DT <=
                                                         CAST (END_DATE AS DATE)
                                                     AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                            FROM TB_ACCOUNT_TRANSACTION
                                                                 TR2
                                                           WHERE     TR2.TRANSACTION_ID =
                                                                     TAT.REFERENCE_TRANSACTION_ID
                                                                 AND TR2.DELETE_SW =
                                                                     'N'
                                                                 AND TR2.BENEFIT_START_DT <
                                                                     CAST (
                                                                        START_DATE
                                                                           AS DATE)
                                                                 AND TR2.TRANSACTION_DT <=
                                                                     CAST (
                                                                        END_DATE
                                                                           AS DATE)) IN
                                                             ('587', '586', '585'))
                                            GROUP BY TAT.CLIENT_ACCOUNT_ID),
                                           0)
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '5530'
                                                    AND TR.CREDIT_DEBIT_SW = 'C'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5475'
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END)))
                                   - (  COALESCE (
                                           (SELECT SUM (
                                                      COALESCE (
                                                         TR1.TRANSACTION_AMOUNT_NO,
                                                         0))
                                                FROM TB_ACCOUNT_TRANSACTION TR1,
                                                     TB_CLIENT_ACCOUNT AC1
                                               WHERE     TR1.CLIENT_ACCOUNT_ID =
                                                         AC1.CLIENT_ACCOUNT_ID
                                                     AND AC1.CLIENT_ACCOUNT_ID =
                                                         CA.CLIENT_ACCOUNT_ID
                                                     AND TR1.DELETE_SW = 'N'
                                                     AND AC1.DELETE_SW = 'N'
                                                     AND TR1.TRANSACTION_DT <=
                                                         CAST (END_DATE AS DATE)
                                                     AND TR1.TRANSACTION_TYPE_CD =
                                                         '588'
                                                     AND TR1.CREDIT_DEBIT_SW = 'D'
                                                     AND TR1.TRANSACTION_SOURCE_CD =
                                                         '5473'
                                                     AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                         '3047'
                                                     AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                            FROM TB_ACCOUNT_TRANSACTION
                                                                 TR2
                                                           WHERE     TR2.TRANSACTION_ID =
                                                                     TR1.REFERENCE_TRANSACTION_ID
                                                                 AND TR2.DELETE_SW =
                                                                     'N') IN
                                                             ('5471',
                                                              '582',
                                                              '583',
                                                              '584',
                                                              '5478'))
                                            GROUP BY AC1.CLIENT_ACCOUNT_ID),
                                           0)
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '588'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND (TR.TRANSACTION_SOURCE_CD IN
                                                            ('5472'))
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                                    AND ADJUSTMENT_APPROVAL_STATUS_CD =
                                                        '3047'
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))
                                      + COALESCE (
                                           (SELECT SUM (
                                                      TAT.TRANSACTION_AMOUNT_NO)
                                                FROM TB_ACCOUNT_TRANSACTION TAT
                                               WHERE     TAT.CLIENT_ACCOUNT_ID =
                                                         CA.CLIENT_ACCOUNT_ID
                                                     AND TAT.DELETE_SW = 'N'
                                                     AND TAT.TRANSACTION_TYPE_CD =
                                                         '588'
                                                     AND TAT.CREDIT_DEBIT_SW = 'D'
                                                     AND TAT.TRANSACTION_SOURCE_CD =
                                                         '5473'
                                                     AND TAT.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                         '3047'
                                                     AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                            FROM TB_ACCOUNT_TRANSACTION
                                                                 TR2
                                                           WHERE     TR2.TRANSACTION_ID =
                                                                     TAT.REFERENCE_TRANSACTION_ID
                                                                 AND TR2.DELETE_SW =
                                                                     'N') IN
                                                             ('587', '586', '585'))
                                                     AND (   (    TAT.BENEFIT_START_DT <
                                                                  CAST (
                                                                     START_DATE
                                                                        AS DATE)
                                                              AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                                START_DATE
                                                                                                   AS DATE)
                                                                                         AND CAST (
                                                                                                END_DATE
                                                                                                   AS DATE))
                                                          OR (    TAT.BENEFIT_START_DT BETWEEN CAST (
                                                                                                  START_DATE
                                                                                                     AS DATE)
                                                                                           AND CAST (
                                                                                                  END_DATE
                                                                                                     AS DATE)
                                                              AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                                START_DATE
                                                                                                   AS DATE)
                                                                                         AND CAST (
                                                                                                END_DATE
                                                                                                   AS DATE)))
                                            GROUP BY TAT.CLIENT_ACCOUNT_ID),
                                           0)
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '5530'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5476'
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '5531'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5476'
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '3444'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5477'
                                                    AND DATE_PART (
                                                           'MONTH',
                                                           TR.TRANSACTION_DT) =
                                                        DATE_PART ('MONTH',
                                                                   DATE (NOW ()))
                                                    AND DATE_PART (
                                                           'YEAR',
                                                           TR.TRANSACTION_DT) =
                                                        DATE_PART ('YEAR',
                                                                   DATE (NOW ()))
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '5531'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5474'
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))
                                      + COALESCE (
                                           (SELECT SUM (
                                                      TAT.TRANSACTION_AMOUNT_NO)
                                                FROM TB_ACCOUNT_TRANSACTION TAT
                                               WHERE     TAT.CLIENT_ACCOUNT_ID =
                                                         CA.CLIENT_ACCOUNT_ID
                                                     AND TAT.DELETE_SW = 'N'
                                                     AND TAT.TRANSACTION_TYPE_CD =
                                                         '588'
                                                     AND TAT.CREDIT_DEBIT_SW = 'D'
                                                     AND TAT.TRANSACTION_SOURCE_CD =
                                                         '5473'
                                                     AND TAT.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                         '3047'
                                                     AND TAT.BENEFIT_START_DT <
                                                         CAST (START_DATE AS DATE)
                                                     AND TAT.TRANSACTION_DT <=
                                                         CAST (END_DATE AS DATE)
                                                     AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                            FROM TB_ACCOUNT_TRANSACTION
                                                                 TR2
                                                           WHERE     TR2.TRANSACTION_ID =
                                                                     TAT.REFERENCE_TRANSACTION_ID
                                                                 AND TR2.DELETE_SW =
                                                                     'N'
                                                                 AND TR2.BENEFIT_START_DT <
                                                                     CAST (
                                                                        START_DATE
                                                                           AS DATE)
                                                                 AND TR2.TRANSACTION_DT <=
                                                                     CAST (
                                                                        END_DATE
                                                                           AS DATE)) IN
                                                             ('587', '586', '585'))
                                            GROUP BY TAT.CLIENT_ACCOUNT_ID),
                                           0)
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '3444'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5477'
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))
                                      + COALESCE (
                                           (SELECT CAD.AMOUNT
                                             FROM TB_CHILD_ACCOUNT_DISBURSEMENT
                                                  CAD,
                                                  INTAKESERVICEREQUESTDISPOSITIONCODE
                                                  SA
                                            WHERE     CAST (
                                                         CAD.DISBURSEMENT_ID
                                                            AS CHARACTER VARYING) =
                                                      SA.OLD_ID
                                                  AND CAD.CLIENT_ACCOUNT_ID =
                                                      CA.CLIENT_ACCOUNT_ID
                                                  AND CAD.DELETE_SW = 'N'
                                                  AND CAD.PAYMENT_APPROVAL_STATUS =
                                                      '3047'
                                                  --AND SA.DELETE_SW = 'N'
                                                  AND SA.APPROVALNATURETYPEKEY =
                                                      '3559'
                                                  AND SA.APPROVALSTATUSTYPEKEY =
                                                      '3047'
                                                  AND SA.STATUSDATE <=
                                                      CAST (END_DATE AS DATE)),
                                           0)
                                      + SUM (
                                           (CASE
                                               WHEN     TR.TRANSACTION_TYPE_CD =
                                                        '5530'
                                                    AND TR.CREDIT_DEBIT_SW = 'D'
                                                    AND TR.TRANSACTION_SOURCE_CD =
                                                        '5474'
                                                    AND TR.TRANSACTION_DT <=
                                                        CAST (END_DATE AS DATE)
                                               THEN
                                                  COALESCE (
                                                     TR.TRANSACTION_AMOUNT_NO,
                                                     0)
                                               ELSE
                                                  0
                                            END))))
                                     AS AVAILABLE_ANC_EOM,
                                    SUM (
                                       (CASE
                                           WHEN     TR.TRANSACTION_TYPE_CD =
                                                    '5530'
                                                AND TR.CREDIT_DEBIT_SW = 'D'
                                                AND TR.TRANSACTION_SOURCE_CD =
                                                    '5474'
                                                AND TR.TRANSACTION_DT <=
                                                    CAST (END_DATE AS DATE)
                                           THEN
                                              COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                        0)
                                           ELSE
                                              0
                                        END))
                                  - SUM (
                                       (CASE
                                           WHEN     TR.TRANSACTION_TYPE_CD =
                                                    '5530'
                                                AND TR.CREDIT_DEBIT_SW = 'C'
                                                AND TR.TRANSACTION_SOURCE_CD =
                                                    '5475'
                                                AND TR.TRANSACTION_DT <=
                                                    CAST (END_DATE AS DATE)
                                           THEN
                                              COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                        0)
                                           ELSE
                                              0
                                        END))
                                     AS OBLIGATED_EOM,
                                  COALESCE (
                                     (SELECT CAD.AMOUNT
                                       FROM TB_CHILD_ACCOUNT_DISBURSEMENT CAD,
                                            INTAKESERVICEREQUESTDISPOSITIONCODE SA
                                      WHERE     CAST (
                                                   CAD.DISBURSEMENT_ID
                                                      AS CHARACTER VARYING) =
                                                SA.OLD_ID
                                            AND CAD.CLIENT_ACCOUNT_ID =
                                                CA.CLIENT_ACCOUNT_ID
                                            AND CAD.DELETE_SW = 'N'
                                            AND CAD.PAYMENT_APPROVAL_STATUS =
                                                '3047'
                                            --AND SA.DELETE_SW = 'N'
                                            AND SA.APPROVALNATURETYPEKEY = '3559'
                                            AND SA.APPROVALSTATUSTYPEKEY = '3047'
                                            AND DATE_PART ('MONTH',
                                                           SA.STATUSDATE) =
                                                DATE_PART (
                                                   'MONTH',
                                                     DATE (
                                                        CAST (START_DATE AS DATE))
                                                   - INTERVAL '1 MONTH')
                                            AND DATE_PART ('YEAR', SA.STATUSDATE) =
                                                DATE_PART (
                                                   'YEAR',
                                                     DATE (
                                                        CAST (START_DATE AS DATE))
                                                   - INTERVAL '1 MONTH')),
                                     0)
                                     AS FINAL_DISBURSEMENT_AMT,
                                  CA.CLOSE_DT
                                     AS DATE_CLOSED,
                                  CASE
                                     WHEN (  SUM (
                                                (CASE
                                                    WHEN     TR.TRANSACTION_TYPE_CD =
                                                             '589'
                                                         AND TR.CREDIT_DEBIT_SW =
                                                             'C'
                                                         AND TR.TRANSACTION_SOURCE_CD IN
                                                                ('587', '5478')
                                                         AND DATE_PART (
                                                                'MONTH',
                                                                TR.TRANSACTION_DT) =
                                                             DATE_PART (
                                                                'MONTH',
                                                                  DATE (
                                                                     CAST (
                                                                        START_DATE
                                                                           AS DATE))
                                                                - INTERVAL '1 MONTH')
                                                         AND DATE_PART (
                                                                'YEAR',
                                                                TR.TRANSACTION_DT) =
                                                             DATE_PART (
                                                                'YEAR',
                                                                  DATE (
                                                                     CAST (
                                                                        START_DATE
                                                                           AS DATE))
                                                                - INTERVAL '1 MONTH')
                                                    THEN
                                                       COALESCE (
                                                          TR.TRANSACTION_AMOUNT_NO,
                                                          0)
                                                    ELSE
                                                       0
                                                 END))
                                           + COALESCE (
                                                (SELECT SUM (
                                                           COALESCE (
                                                              TR1.TRANSACTION_AMOUNT_NO,
                                                              0))
                                                     FROM TB_ACCOUNT_TRANSACTION TR1,
                                                          TB_CLIENT_ACCOUNT AC1
                                                    WHERE     TR1.CLIENT_ACCOUNT_ID =
                                                              AC1.CLIENT_ACCOUNT_ID
                                                          AND AC1.CLIENT_ACCOUNT_ID =
                                                              CA.CLIENT_ACCOUNT_ID
                                                          AND TR1.DELETE_SW = 'N'
                                                          AND AC1.DELETE_SW = 'N'
                                                          AND TR1.TRANSACTION_TYPE_CD =
                                                              '588'
                                                          AND TR1.CREDIT_DEBIT_SW =
                                                              'C'
                                                          AND TR1.TRANSACTION_SOURCE_CD =
                                                              '5473'
                                                          AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                              '3047'
                                                          AND DATE_PART (
                                                                 'MONTH',
                                                                 TR1.TRANSACTION_DT) =
                                                              DATE_PART (
                                                                 'MONTH',
                                                                   DATE (
                                                                      CAST (
                                                                         START_DATE
                                                                            AS DATE))
                                                                 - INTERVAL '1 MONTH')
                                                          AND DATE_PART (
                                                                 'YEAR',
                                                                 TR1.TRANSACTION_DT) =
                                                              DATE_PART (
                                                                 'YEAR',
                                                                   DATE (
                                                                      CAST (
                                                                         START_DATE
                                                                            AS DATE))
                                                                 - INTERVAL '1 MONTH')
                                                          AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                                 FROM TB_ACCOUNT_TRANSACTION
                                                                      TR2
                                                                WHERE     TR2.TRANSACTION_ID =
                                                                          TR1.REFERENCE_TRANSACTION_ID
                                                                      AND TR2.DELETE_SW =
                                                                          'N') IN
                                                                  ('587', '5478'))
                                                 GROUP BY AC1.CLIENT_ACCOUNT_ID),
                                                0)
                                           - COALESCE (
                                                (SELECT SUM (
                                                           COALESCE (
                                                              TR1.TRANSACTION_AMOUNT_NO,
                                                              0))
                                                     FROM TB_ACCOUNT_TRANSACTION TR1,
                                                          TB_CLIENT_ACCOUNT AC1
                                                    WHERE     TR1.CLIENT_ACCOUNT_ID =
                                                              AC1.CLIENT_ACCOUNT_ID
                                                          AND AC1.CLIENT_ACCOUNT_ID =
                                                              CA.CLIENT_ACCOUNT_ID
                                                          AND TR1.DELETE_SW = 'N'
                                                          AND AC1.DELETE_SW = 'N'
                                                          AND TR1.TRANSACTION_TYPE_CD =
                                                              '588'
                                                          AND TR1.CREDIT_DEBIT_SW =
                                                              'D'
                                                          AND TR1.TRANSACTION_SOURCE_CD =
                                                              '5473'
                                                          AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                              '3047'
                                                          AND DATE_PART (
                                                                 'MONTH',
                                                                 TR1.TRANSACTION_DT) =
                                                              DATE_PART (
                                                                 'MONTH',
                                                                   DATE (
                                                                      CAST (
                                                                         START_DATE
                                                                            AS DATE))
                                                                 - INTERVAL '1 MONTH')
                                                          AND DATE_PART (
                                                                 'YEAR',
                                                                 TR1.TRANSACTION_DT) =
                                                              DATE_PART (
                                                                 'YEAR',
                                                                   DATE (
                                                                      CAST (
                                                                         START_DATE
                                                                            AS DATE))
                                                                 - INTERVAL '1 MONTH')
                                                          AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                                 FROM TB_ACCOUNT_TRANSACTION
                                                                      TR2
                                                                WHERE     TR2.TRANSACTION_ID =
                                                                          TR1.REFERENCE_TRANSACTION_ID
                                                                      AND TR2.DELETE_SW =
                                                                          'N') IN
                                                                  ('587', '5478'))
                                                 GROUP BY AC1.CLIENT_ACCOUNT_ID),
                                                0)) >
                                          0
                                     THEN
                                        'YES'
                                     ELSE
                                        'NO'
                                  END
                                     AS IN_RECEIPT_OF_SSI,
                                  STATUS_CD,
                                  CA.CLIENT_ACCOUNT_ID
                             FROM TB_CLIENT_ACCOUNT CA
                                  LEFT JOIN TB_ACCOUNT_TRANSACTION TR
                                     ON     CA.CLIENT_ACCOUNT_ID =
                                            TR.CLIENT_ACCOUNT_ID
                                        AND TR.DELETE_SW = 'N'
                                  LEFT JOIN TB_CLIENT C
                                     ON     CA.CLIENT_ID = C.CLIENT_ID
                                        AND C.DELETE_SW = 'N'
                            WHERE                
                                                                           CA.OPEN_DT <= CAST (END_DATE AS DATE)
                                  AND CA.DELETE_SW = 'N'
                         GROUP BY CA.COUNTY_CD,
                                  CA.CLIENT_ID,
                                  CA.ACCOUNT_TYPE_CD,
                                  CA.ACCOUNT_NO_TX,
                                  CA.OPEN_DT,
                                  CA.CLIENT_ACCOUNT_ID,
                                  CA.STATUS_CD,
                                  CA.CLOSE_DT) TB_MAIN) TB_MAIN2
          WHERE    TB_MAIN2.STATUS_CD = '592'
                OR (    TB_MAIN2.STATUS_CD = '593'
                    AND TB_MAIN2.DATE_CLOSED > CAST (START_DATE AS DATE))
                OR TB_MAIN2.FINAL_DISBURSEMENT_AMT > 0
                OR TB_MAIN2.TOTAL_BALANCE_EOM > 0
       ORDER BY TB_MAIN2.COUNTY,
                TB_MAIN2.CLIENT_ID,
                TB_MAIN2.ACCOUNT_TYPE,
                TB_MAIN2.ACCOUNT_NO_TX);
END;
