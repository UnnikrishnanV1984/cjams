CREATE OR REPLACE FUNCTION f_fm300r(start_date date, end_date date)
 RETURNS TABLE(county character varying, county_cd character varying, account_type character, account_no_tx character varying, open_dt date, account_status character varying, client_id bigint, client_name text, in_receipt_of_ssi text, total_balance_bom numeric, available_balance_coc_bom numeric, available_balance_anc_bom numeric, obligated_bom numeric, receipts_for_coc_month numeric, receipts_for_anc_month numeric, actual_coc_month numeric, coc_reimbursement_month numeric, excess_available_for_anc numeric, obligated_month numeric, obligations_liquidation_month numeric, ancillary_payments_month numeric, total_balance_eom numeric, available_balance_no_coc_eom numeric, obligated_eom numeric, final_disbursement_amt numeric, date_closed date, status_cd_not_a_rpt_column character varying, client_account_id bigint)
 LANGUAGE plpgsql
AS $function$
BEGIN
   RETURN QUERY
      (  SELECT TB_MAIN2.COUNTY,
                TB_MAIN2.COUNTY_CD,
                TB_MAIN2.ACCOUNT_TYPE,
                TB_MAIN2.ACCOUNT_NO_TX,
                TB_MAIN2.OPEN_DT,
                TB_MAIN2.ACCOUNT_STATUS,
                TB_MAIN2.CLIENT_ID,
                TB_MAIN2.CLIENT_NAME--,CASE_STATUS
                                    ,
                TB_MAIN2.IN_RECEIPT_OF_SSI,
                TB_MAIN2.TOTAL_BALANCE_BOM,
                TB_MAIN2.AVAILABLE_BALANCE_COC_BOM,
                TB_MAIN2.AVAILABLE_BALANCE_ANC_BOM,
                (CASE
                    WHEN COALESCE (TB_MAIN2.OBLIGATED_BOM, 0) > 0
                    THEN
                       TB_MAIN2.OBLIGATED_BOM
                    ELSE
                       0
                 END) AS OBLIGATED_BOM,
                TB_MAIN2.RECEIPTS_FOR_COC_MONTH,
                TB_MAIN2.RECEIPTS_FOR_ANC_MONTH,
                TB_MAIN2.ACTUAL_COC_MONTH,
                TB_MAIN2.COC_REIMBURSEMENT_MONTH,
                TB_MAIN2.EXCESS_AVAILABLE_FOR_ANC,
                TB_MAIN2.OBLIGATED_MONTH,
                TB_MAIN2.OBLIGATIONS_LIQUIDATION_MONTH,
                TB_MAIN2.ANCILLARY_PAYMENTS_MONTH,
                TB_MAIN2.TOTAL_BALANCE_EOM,
                TB_MAIN2.AVAILABLE_BALANCE_NO_COC_EOM,
                TB_MAIN2.OBLIGATED_EOM,
                TB_MAIN2.FINAL_DISBURSEMENT_AMT,
                TB_MAIN2.DATE_CLOSED,
                TB_MAIN2.STATUS_CD AS STATUS_CD_NOT_A_RPT_COLUMN,
                TB_MAIN2.CLIENT_ACCOUNT_ID
           FROM (SELECT TB_MAIN.COUNTY,
                        TB_MAIN.ACCOUNT_TYPE,
                        TB_MAIN.ACCOUNT_NO_TX,
                        TB_MAIN.OPEN_DT,
                        TB_MAIN.ACCOUNT_STATUS,
                        TB_MAIN.CLIENT_ID,
                        TB_MAIN.CLIENT_NAME--,TB_MAIN.CASE_STATUS
                                           ,
                        TB_MAIN.IN_RECEIPT_OF_SSI,
                        (  COALESCE (TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM, 0)
                         + COALESCE (TB_MAIN.AVAILABLE_ANC_EOM, 0)
                         + COALESCE (TB_MAIN.OBLIGATED_EOM, 0)
                         + COALESCE (TB_MAIN.COC_REIMBURSEMENT_MONTH, 0)
                         + COALESCE (TB_MAIN.ANCILLARY_PAYMENTS_MONTH, 0)
                         + COALESCE (TB_MAIN.FINAL_DISBURSEMENT_AMT, 0)
                         - COALESCE (TB_MAIN.RECEIPTS_FOR_ANC_MONTH, 0)
                         - COALESCE (TB_MAIN.RECEIPTS_FOR_COC_MONTH, 0))
                           AS TOTAL_BALANCE_BOM,
                        (  COALESCE (TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM, 0)
                         + COALESCE (TB_MAIN.COC_REIMBURSEMENT_MONTH, 0)
                         + COALESCE (TB_MAIN.EXCESS_AVAILABLE_FOR_ANC, 0)
                         - COALESCE (TB_MAIN.RECEIPTS_FOR_COC_MONTH, 0))
                           AS AVAILABLE_BALANCE_COC_BOM,
                        (  COALESCE (TB_MAIN.AVAILABLE_ANC_EOM, 0)
                         + COALESCE (TB_MAIN.ANCILLARY_PAYMENTS_MONTH, 0)
                         + COALESCE (TB_MAIN.FINAL_DISBURSEMENT_AMT, 0)
                         - COALESCE (TB_MAIN.RECEIPTS_FOR_ANC_MONTH, 0)
                         - COALESCE (TB_MAIN.EXCESS_AVAILABLE_FOR_ANC, 0)
                         - (  COALESCE (TB_MAIN.OBLIGATIONS_LIQUIDATION_MONTH,
                                        0)
                            - COALESCE (TB_MAIN.OBLIGATED_MONTH, 0)))
                           AS AVAILABLE_BALANCE_ANC_BOM,
                        (  COALESCE (TB_MAIN.OBLIGATED_EOM, 0)
                         + COALESCE (TB_MAIN.OBLIGATIONS_LIQUIDATION_MONTH, 0)
                         - COALESCE (TB_MAIN.OBLIGATED_MONTH, 0))
                           AS OBLIGATED_BOM,
                        COALESCE (TB_MAIN.RECEIPTS_FOR_COC_MONTH, 0)
                           AS RECEIPTS_FOR_COC_MONTH,
                        COALESCE (TB_MAIN.RECEIPTS_FOR_ANC_MONTH, 0)
                           AS RECEIPTS_FOR_ANC_MONTH,
                        COALESCE (TB_MAIN.ACTUAL_COC, 0)
                           AS ACTUAL_COC_MONTH,
                        COALESCE (TB_MAIN.COC_REIMBURSEMENT_MONTH, 0)
                           AS COC_REIMBURSEMENT_MONTH,
                        COALESCE (TB_MAIN.EXCESS_AVAILABLE_FOR_ANC, 0)
                           AS EXCESS_AVAILABLE_FOR_ANC,
                        COALESCE (TB_MAIN.OBLIGATED_MONTH, 0)
                           AS OBLIGATED_MONTH,
                        COALESCE (TB_MAIN.OBLIGATIONS_LIQUIDATION_MONTH, 0)
                           AS OBLIGATIONS_LIQUIDATION_MONTH,
                        COALESCE (TB_MAIN.ANCILLARY_PAYMENTS_MONTH, 0)
                           AS ANCILLARY_PAYMENTS_MONTH,
                        CASE
                           WHEN COALESCE (TB_MAIN.FINAL_DISBURSEMENT_AMT, 0) >
                                0
                           THEN
                              0
                           ELSE
                              (  COALESCE (
                                    TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM,
                                    0)
                               + COALESCE (TB_MAIN.AVAILABLE_ANC_EOM, 0)
                               + COALESCE (TB_MAIN.OBLIGATED_EOM, 0))
                        END
                           AS TOTAL_BALANCE_EOM,
                        CASE
                           WHEN COALESCE (TB_MAIN.FINAL_DISBURSEMENT_AMT, 0) >
                                0
                           THEN
                              0
                           ELSE
                              COALESCE (TB_MAIN.AVAILABLE_ANC_EOM, 0)
                        END
                           AS AVAILABLE_FOR_ANC_EOM,
                        CASE
                           WHEN COALESCE (TB_MAIN.FINAL_DISBURSEMENT_AMT, 0) >
                                0
                           THEN
                              0
                           ELSE
                              COALESCE (TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM,
                                        0)
                        END
                           AS AVAILABLE_BALANCE_NO_COC_EOM,
                        (CASE
                            WHEN COALESCE (TB_MAIN.FINAL_DISBURSEMENT_AMT, 0) >
                                 0
                            THEN
                               0
                            ELSE
                               COALESCE (TB_MAIN.OBLIGATED_EOM, 0)
                         END)
                           AS OBLIGATED_EOM,
                        TB_MAIN.FINAL_DISBURSEMENT_AMT,
                        TB_MAIN.COUNTY_CD,
                        TB_MAIN.DATE_CLOSED,
                        TB_MAIN.STATUS_CD,
                        TB_MAIN.CLIENT_ACCOUNT_ID
                   FROM (  SELECT F_PLVALUE (CA.COUNTY_CD, 104)
                                     AS COUNTY,
                                  CAST (
                                     F_PLVALUE (CA.ACCOUNT_TYPE_CD, 40)
                                        AS CHAR (15))
                                     AS ACCOUNT_TYPE,
                                  CA.ACCOUNT_NO_TX,
                                  CA.OPEN_DT,
                                  F_PLVALUE (CA.STATUS_CD, 41)
                                     AS ACCOUNT_STATUS,
                                  CA.CLIENT_ID,
                                  CA.COUNTY_CD,
                                  (SELECT LAST_NM || ',' || FIRST_NM
                                    FROM TB_CLIENT
                                   WHERE     DELETE_SW = 'N'
                                         AND TB_CLIENT.CLIENT_ID = CA.CLIENT_ID)
                                     AS CLIENT_NAME/*,(SELECT F_PLVALUE(CASEACTIONTYPEKEY,1544)
                                                    FROM CASECLIENT CC
                                                      JOIN CASEHISTORY CH ON CC.CASEID = CH.CASEID
                                                      AND CC.ACTIVEFLAG = 0
                                                      AND CH.ACTIVEFLAG = 0
                                                     WHERE ((SELECT PR.PERSONIDENTIFIERVALUE FROM PERSONIDENTIFIER PR JOIN CASECLIENT CA ON PR.PERSONID = CA.PERSONID),CC.CASEID)
                                                     IN (SELECT OLD_ID,CASEID
                                                             FROM PERSONPROGRAMAREA
                                                              WHERE OLD_ID IN
                                                               ( SELECT OLD_ID
                                                                FROM PERSONPROGRAMAREA
                                                                 WHERE ACTIVEFLAG = 0
                                                                 -- AND AGENCYPROGRAMAREAID = 2 --UUID
                                                                 AND OLD_ID = CA.OLD_ID
                                                                 ORDER BY COALESCE(ENDDATE,CURRENT_DATE),STARTDATE
                                                                 FETCH FIRST 1 ROW ONLY
                                                                )
                                                             )
                                                     AND (SELECT PR.PERSONIDENTIFIERVALUE FROM PERSONIDENTIFIER PR JOIN CASECLIENT CA ON PR.PERSONID = CA.PERSONID) = CA.FK_ID
                                                     AND CH.OLD_ID IN (SELECT MAX(OLD_ID)
                                                           FROM CASEHISTORY
                                                           WHERE ACTIVEFLAG = 0
                                                           GROUP BY CASEID
                                                           )
                                                    ) AS CASE_STATUS*/


                                                   ,
                                  SUM (
                                     (CASE
                                         WHEN     TR.TRANSACTION_TYPE_CD = '5530'
                                              AND TR.CREDIT_DEBIT_SW = 'D'
                                              AND TR.TRANSACTION_SOURCE_CD =
                                                  '5474'
                                              AND DATE_PART ('MONTH',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART (
                                                     'MONTH',
                                                       DATE (
                                                          CAST (
                                                             START_DATE AS DATE))
                                                     - INTERVAL '1 MONTH')
                                              AND DATE_PART ('YEAR',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART (
                                                     'YEAR',
                                                       DATE (
                                                          CAST (
                                                             START_DATE AS DATE))
                                                     - INTERVAL '1 MONTH')
                                         THEN
                                            COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                      0)
                                         ELSE
                                            0
                                      END))
                                     AS OBLIGATED_MONTH,
                                  SUM (
                                     (CASE
                                         WHEN     TR.TRANSACTION_TYPE_CD = '5530'
                                              AND TR.CREDIT_DEBIT_SW = 'C'
                                              AND TR.TRANSACTION_SOURCE_CD =
                                                  '5475'
                                              AND DATE_PART ('MONTH',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART (
                                                     'MONTH',
                                                       DATE (
                                                          CAST (
                                                             START_DATE AS DATE))
                                                     - INTERVAL '1 MONTH')
                                              AND DATE_PART ('YEAR',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART (
                                                     'YEAR',
                                                       DATE (
                                                          CAST (
                                                             START_DATE AS DATE))
                                                     - INTERVAL '1 MONTH')
                                         THEN
                                            COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                      0)
                                         ELSE
                                            0
                                      END))
                                     AS OBLIGATIONS_LIQUIDATION_MONTH,
                                  SUM (
                                     (CASE
                                         WHEN     TR.TRANSACTION_TYPE_CD = '5531'
                                              AND TR.CREDIT_DEBIT_SW = 'D'
                                              AND TR.TRANSACTION_SOURCE_CD =
                                                  '5476'
                                              AND DATE_PART ('MONTH',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART (
                                                     'MONTH',
                                                       DATE (
                                                          CAST (
                                                             START_DATE AS DATE))
                                                     - INTERVAL '1 MONTH')
                                              AND DATE_PART ('YEAR',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART (
                                                     'YEAR',
                                                       DATE (
                                                          CAST (
                                                             START_DATE AS DATE))
                                                     - INTERVAL '1 MONTH')
                                         THEN
                                            COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                      0)
                                         ELSE
                                            0
                                      END))
                                     AS ANCILLARY_PAYMENTS_MONTH,
                                  (  COALESCE (
                                        (SELECT SUM (
                                                   COALESCE (PD.FINAL_AMOUNT_NO,
                                                             0))
                                          FROM TB_PAYMENT_DETAIL PD,
                                               TB_PAYMENT_HEADER PH,
                                               TB_PAYMENT_STATUS PS,
                                               TB_PLACEMENT PL
                                         WHERE     PH.PAYMENT_ID = PD.PAYMENT_ID
                                               AND PH.PAYMENT_ID = PS.PAYMENT_ID
                                               AND PL.PLACEMENT_ID =
                                                   PD.PLACEMENT_ID
                                               AND DATE_PART (
                                                      'MONTH',
                                                      PD.FINAL_SERVICE_START_DT) =
                                                   DATE_PART (
                                                      'MONTH',
                                                        DATE (
                                                           CAST (
                                                              START_DATE AS DATE))
                                                      - INTERVAL '1 MONTH')
                                               AND DATE_PART (
                                                      'YEAR',
                                                      PD.FINAL_SERVICE_START_DT) =
                                                   DATE_PART (
                                                      'YEAR',
                                                        DATE (
                                                           CAST (
                                                              START_DATE AS DATE))
                                                      - INTERVAL '1 MONTH')
                                               AND (   PH.PAYMENT_TYPE_CD = '6'
                                                    OR (    PH.PAYMENT_TYPE_CD =
                                                            '3294'
                                                        AND PH.MANUAL_SW = 'N'))
                                               AND PH.DELETE_SW = 'N'
                                               AND PD.DELETE_SW = 'N'
                                               AND PS.DELETE_SW = 'N'
                                               AND PL.DELETE_SW = 'N'
                                               AND PD.FINAL_SERVICE_ID
                                                      IS NOT NULL
                                               AND PS.PAYMENT_STATUS_CD NOT IN
                                                      ('1635', '1639')
                                               AND PD.PLACEMENT_ID IS NOT NULL
                                               AND (   PL.VOID_SW = 'N'
                                                    OR PL.VOID_SW IS NULL
                                                    OR RTRIM (LTRIM (PL.VOID_SW)) =
                                                       '')
                                               AND PD.CLIENT_ID = CA.CLIENT_ID),
                                        0)
                                   - COALESCE (
                                        (SELECT SUM (COALESCE (RD.AMOUNT_NO, 0))
                                          FROM TB_RECEIVABLE_DETAIL RD
                                         WHERE     RD.DELETE_SW = 'N'
                                               AND RD.PAYMENT_DETAIL_ID IN
                                                      (SELECT PD.PAYMENT_DETAIL_ID
                                                        FROM TB_PAYMENT_DETAIL PD,
                                                             TB_PAYMENT_HEADER PH,
                                                             TB_PAYMENT_STATUS PS,
                                                             TB_PLACEMENT PL
                                                       WHERE     PH.PAYMENT_ID =
                                                                 PD.PAYMENT_ID
                                                             AND PH.PAYMENT_ID =
                                                                 PS.PAYMENT_ID
                                                             AND PL.PLACEMENT_ID =
                                                                 PD.PLACEMENT_ID
                                                             AND DATE_PART (
                                                                    'MONTH',
                                                                    PD.FINAL_SERVICE_START_DT) =
                                                                 DATE_PART (
                                                                    'MONTH',
                                                                      DATE (
                                                                         CAST (
                                                                            START_DATE
                                                                               AS DATE))
                                                                    - INTERVAL '1 MONTH')
                                                             AND DATE_PART (
                                                                    'YEAR',
                                                                    PD.FINAL_SERVICE_START_DT) =
                                                                 DATE_PART (
                                                                    'YEAR',
                                                                      DATE (
                                                                         CAST (
                                                                            START_DATE
                                                                               AS DATE))
                                                                    - INTERVAL '1 MONTH')
                                                             AND (   PH.PAYMENT_TYPE_CD =
                                                                     '6'
                                                                  OR (    PH.PAYMENT_TYPE_CD =
                                                                          '3294'
                                                                      AND PH.MANUAL_SW =
                                                                          'N'))
                                                             AND PH.DELETE_SW =
                                                                 'N'
                                                             AND PD.DELETE_SW =
                                                                 'N'
                                                             AND PS.DELETE_SW =
                                                                 'N'
                                                             AND PL.DELETE_SW =
                                                                 'N'
                                                             AND PD.FINAL_SERVICE_ID
                                                                    IS NOT NULL
                                                             AND PS.PAYMENT_STATUS_CD NOT IN
                                                                    ('1635',
                                                                     '1639')
                                                             AND PD.PLACEMENT_ID
                                                                    IS NOT NULL
                                                             AND (   PL.VOID_SW =
                                                                     'N'
                                                                  OR PL.VOID_SW
                                                                        IS NULL
                                                                  OR RTRIM (
                                                                        LTRIM (
                                                                           PL.VOID_SW)) =
                                                                     '')
                                                             AND PD.CLIENT_ID =
                                                                 CA.CLIENT_ID)),
                                        0)
                                   + COALESCE (
                                        (SELECT SUM (
                                                   (CASE
                                                       WHEN (  FD.COC_FUNDING_AMT
                                                             + FD.SSI_FUNDING_AMT
                                                             + FD.SSA_FUNDING_AMT) =
                                                            0
                                                       THEN
                                                          FD.PAYMENT_AMOUNT
                                                       ELSE
                                                          (  FD.PAYMENT_AMOUNT
                                                           - (  FD.COC_FUNDING_AMT
                                                              + FD.SSI_FUNDING_AMT
                                                              + FD.SSA_FUNDING_AMT))
                                                    END))
                                          FROM TB_FUND_ALLOCATION_DETAIL FD
                                         WHERE FD.FUND_ALLOC_HISTORY_ID IN
                                                  (SELECT MAX (
                                                             FD1.FUND_ALLOC_HISTORY_ID)
                                                       FROM TB_FUND_ALLOCATION_DETAIL
                                                            FD1
                                                      WHERE     FD1.PAYMENT_DETAIL_ID IN
                                                                   (SELECT PAYMENT_DETAIL_ID
                                                                     FROM TB_PAYMENT_DETAIL
                                                                    WHERE     DELETE_SW =
                                                                              'N'
                                                                          AND FINAL_SERVICE_ID
                                                                                 IS NOT NULL
                                                                          AND TB_PAYMENT_DETAIL.CLIENT_ID =
                                                                              CA.CLIENT_ID)
                                                            AND FUND_ALLOC_ID IN
                                                                   (SELECT FUND_ALLOC_ID
                                                                     FROM TB_FUND_ALLOCATION_MASTER
                                                                    WHERE     INITIAL_STAMPING_SW =
                                                                              'N'
                                                                          AND (  COALESCE (
                                                                                    SSI_FUNDING_AMT,
                                                                                    0)
                                                                               + COALESCE (
                                                                                    SSA_FUNDING_AMT,
                                                                                    0)
                                                                               + COALESCE (
                                                                                    COC_FUNDING_AMT,
                                                                                    0)) >
                                                                              0
                                                                          AND FUND_ALLOCATION_DATE BETWEEN CAST (
                                                                                                              START_DATE
                                                                                                                 AS DATE)
                                                                                                       AND CAST (
                                                                                                              END_DATE
                                                                                                                 AS DATE))
                                                            AND FD1.FUND_ALLOCATION_DATE <
                                                                CAST (
                                                                   START_DATE
                                                                      AS DATE)
                                                   GROUP BY FD1.FUND_ALLOC_ID)),
                                        0))
                                     AS ACTUAL_COC,
                                  SUM (
                                     (CASE
                                         WHEN     TR.TRANSACTION_TYPE_CD = '3444'
                                              AND TR.CREDIT_DEBIT_SW = 'D'
                                              AND TR.TRANSACTION_SOURCE_CD =
                                                  '5477'
                                              AND DATE_PART ('MONTH',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART ('MONTH',
                                                             DATE (NOW ()))
                                              AND DATE_PART ('YEAR',
                                                             TR.TRANSACTION_DT) =
                                                  DATE_PART ('YEAR',
                                                             DATE (NOW ()))
                                         THEN
                                            COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                      0)
                                         ELSE
                                            0
                                      END))
                                     AS COC_REIMBURSEMENT_MONTH,
                                    COALESCE (
                                       (SELECT SUM (TAT.TRANSACTION_AMOUNT_NO)
                                            FROM TB_ACCOUNT_TRANSACTION TAT
                                           WHERE     TAT.CLIENT_ACCOUNT_ID =
                                                     CA.CLIENT_ACCOUNT_ID
                                                 AND TAT.DELETE_SW = 'N'
                                                 AND TAT.TRANSACTION_TYPE_CD = '589'
                                                 AND TAT.TRANSACTION_SOURCE_CD IN
                                                        ('587', '585', '586')
                                                 AND (   (    TAT.BENEFIT_START_DT <
                                                              CAST (
                                                                 START_DATE AS DATE)
                                                          AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                            START_DATE
                                                                                               AS DATE)
                                                                                     AND CAST (
                                                                                            END_DATE
                                                                                               AS DATE))
                                                      OR (    TAT.BENEFIT_START_DT BETWEEN CAST (
                                                                                              START_DATE
                                                                                                 AS DATE)
                                                                                       AND CAST (
                                                                                              END_DATE
                                                                                                 AS DATE)
                                                          AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                            START_DATE
                                                                                               AS DATE)
                                                                                     AND CAST (
                                                                                            END_DATE
                                                                                               AS DATE)))
                                        GROUP BY TAT.CLIENT_ACCOUNT_ID),
                                       0)
                                  + COALESCE (
                                       (SELECT SUM (TAT.TRANSACTION_AMOUNT_NO)
                                            FROM TB_ACCOUNT_TRANSACTION TAT
                                           WHERE     TAT.CLIENT_ACCOUNT_ID =
                                                     CA.CLIENT_ACCOUNT_ID
                                                 AND TAT.DELETE_SW = 'N'
                                                 AND TAT.TRANSACTION_TYPE_CD = '588'
                                                 AND TAT.CREDIT_DEBIT_SW = 'C'
                                                 AND TAT.TRANSACTION_SOURCE_CD =
                                                     '5473'
                                                 AND TAT.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                     '3047'
                                                 AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                        FROM TB_ACCOUNT_TRANSACTION
                                                             TR2
                                                       WHERE     TR2.TRANSACTION_ID =
                                                                 TAT.REFERENCE_TRANSACTION_ID
                                                             AND TR2.DELETE_SW = 'N') IN
                                                         ('587', '586', '585'))
                                                 AND (   (    TAT.BENEFIT_START_DT <
                                                              CAST (
                                                                 START_DATE AS DATE)
                                                          AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                            START_DATE
                                                                                               AS DATE)
                                                                                     AND CAST (
                                                                                            END_DATE
                                                                                               AS DATE))
                                                      OR (    TAT.BENEFIT_START_DT BETWEEN CAST (
                                                                                              START_DATE
                                                                                                 AS DATE)
                                                                                       AND CAST (
                                                                                              END_DATE
                                                                                                 AS DATE)
                                                          AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                            START_DATE
                                                                                               AS DATE)
                                                                                     AND CAST (
                                                                                            END_DATE
                                                                                               AS DATE)))
                                        GROUP BY TAT.CLIENT_ACCOUNT_ID),
                                       0)
                                  - SUM (
                                       (CASE
                                           WHEN     TR.TRANSACTION_TYPE_CD =
                                                    '3444'
                                                AND TR.CREDIT_DEBIT_SW = 'D'
                                                AND TR.TRANSACTION_SOURCE_CD =
                                                    '5477'
                                                AND DATE_PART ('MONTH',
                                                               TR.TRANSACTION_DT) =
                                                    DATE_PART ('MONTH',
                                                               DATE (NOW ()))
                                                AND DATE_PART ('YEAR',
                                                               TR.TRANSACTION_DT) =
                                                    DATE_PART ('YEAR',
                                                               DATE (NOW ()))
                                           THEN
                                              COALESCE (TR.TRANSACTION_AMOUNT_NO,
                                                        0)
                                           ELSE
                                              0
                                        END))
                                  - COALESCE (
                                       (SELECT SUM (TAT.TRANSACTION_AMOUNT_NO)
                                            FROM TB_ACCOUNT_TRANSACTION TAT
                                           WHERE     TAT.CLIENT_ACCOUNT_ID =
                                                     CA.CLIENT_ACCOUNT_ID
                                                 AND TAT.DELETE_SW = 'N'
                                                 AND TAT.TRANSACTION_TYPE_CD = '588'
                                                 AND TAT.CREDIT_DEBIT_SW = 'D'
                                                 AND TAT.TRANSACTION_SOURCE_CD =
                                                     '5473'
                                                 AND TAT.ADJUSTMENT_APPROVAL_STATUS_CD =
                                                     '3047'
                                                 AND ((SELECT TR2.TRANSACTION_SOURCE_CD
                                                        FROM TB_ACCOUNT_TRANSACTION
                                                             TR2
                                                       WHERE     TR2.TRANSACTION_ID =
                                                                 TAT.REFERENCE_TRANSACTION_ID
                                                             AND TR2.DELETE_SW = 'N') IN
                                                         ('587', '586', '585'))
                                                 AND (   (    TAT.BENEFIT_START_DT <
                                                              CAST (
                                                                 START_DATE AS DATE)
                                                          AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                            START_DATE
                                                                                               AS DATE)
                                                                                     AND CAST (
                                                                                            END_DATE
                                                                                               AS DATE))
                                                      OR (    TAT.BENEFIT_START_DT BETWEEN CAST (
                                                                                              START_DATE
                                                                                                 AS DATE)
                                                                                       AND CAST (
                                                                                              END_DATE
                                                                                                 AS DATE)
                                                          AND TAT.TRANSACTION_DT BETWEEN CAST (
                                                                                            START_DATE
                                                                                               AS DATE)
                                                                                     AND CAST (
                                                                                            END_DATE
                                                                                               AS DATE)))
                                        GROUP BY TAT.CLIENT_ACCOUNT_ID),
                                       0)
                                     AS EXCESS_AVAILABLE_FOR_ANC,
                                  (  SUM (
                                        (CASE
                                            WHEN     TR.TRANSACTION_TYPE_CD =
                                                     '589'
                                                 AND DATE_PART (
                                                        'MONTH',
                                                        TR.TRANSACTION_DT) =
