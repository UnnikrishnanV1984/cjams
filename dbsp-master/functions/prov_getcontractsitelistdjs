CREATE OR REPLACE FUNCTION prov_getcontractsitelistdjs(request json, v_is_csa boolean DEFAULT NULL::boolean)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
v_provider_id character varying;
v_provider_name CHARACTER VARYING;
v_contract_id character varying;
v_base_contract_id character varying;
v_search_contract boolean;
v_is_djs boolean;
v_skip numeric;
jsondata  json;
wherejson json;
v_program_id character varying;
v_program_name CHARACTER VARYING;

BEGIN

wherejson := request ->> 'where';
v_provider_id := wherejson ->> 'provider_id';
v_provider_name := wherejson ->> 'provider_name';
v_contract_id := wherejson ->> 'contract_id';
v_base_contract_id := wherejson ->> 'base_contract_id';
v_program_id := wherejson ->> 'program_id';
v_program_name := wherejson ->> 'program_name';
RAISE NOTICE 'base contract id %', v_base_contract_id;
v_search_contract := wherejson ->> 'search_contract';
v_skip := request ->> 'skip';

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  
SELECT count(1) over() as totalcount, tpc.*,tp.provider_nm,
      (select json_agg(x) from (
        SELECT cp.program_id, cp.is_csa, cp.program_nm as program_name,
        (select json_agg(s) from (
          SELECT cps.site_id, COALESCE(tp.provider_nm , concat(tp.provider_first_nm, tp.provider_last_nm)) as site_name,
          (select json_agg(l) from (
            SELECT tpl.license_no, tpl.license_level, tpl.license_type, tpl.license_application_id, tpl.license_status_cd, tpl.license_issue_dt, tpl.license_expiry_dt
            FROM tb_provider_licensing tpl 
            where tpl.site_id = cps.site_id and tpl.active_sw = 'Y'
            and tpl.delete_sw = 'N'
            ) l ) as licenses
          FROM tb_prov_program_sites cps 
          INNER JOIN tb_provider tp on tp.provider_id = cps.site_id 
            and tp.delete_sw = 'N'
          where cps.program_id = cp.program_id
            and cps.delete_sw='N'
        ) s ) as site_list
        FROM tb_contract_program cp
        where cp.contract_id = tpc.contract_id
        and case 
            when v_is_csa = true then cp.is_csa = v_is_csa 
            when v_is_csa = false then cp.is_csa = false or cp.is_csa is null 
            else true end
        and case 
            when v_is_djs = true then cp.is_djs = v_is_djs
            when v_is_djs = false then cp.is_djs = false
            else true end
        and cp.delete_sw = 'N'
        order by program_id desc
        ) x ) as programs,
      (select json_agg(x) from (
        SELECT cp.program_id, cp.is_csa, cp.program_nm as program_name,
        (select json_agg(s) from (
          SELECT cps.site_id, COALESCE(tp.provider_nm , concat(tp.provider_first_nm, tp.provider_last_nm)) as site_name,
          (select json_agg(l) from (
            SELECT tpl.license_no, tpl.license_level, tpl.license_type, tpl.license_application_id, tpl.license_status_cd, tpl.license_issue_dt, tpl.license_expiry_dt
            FROM tb_provider_licensing tpl 
            where tpl.site_id = cps.site_id and tpl.active_sw = 'Y'
            and tpl.delete_sw = 'N'
            ) l ) as licenses
          FROM tb_prov_program_sites cps 
          INNER JOIN tb_provider tp on tp.provider_id = cps.site_id 
            and tp.delete_sw = 'N'
          where cps.program_id = cp.program_id
            and cps.delete_sw='N'
        ) s ) as site_list
        FROM tb_contract_program_archive cp
        where cp.contract_id = tpc.contract_id
        and case 
            when v_is_csa = true then cp.is_csa = v_is_csa 
            when v_is_csa = false then cp.is_csa = false or cp.is_csa is null 
            else true end
        and case 
            when v_is_djs = true then cp.is_csa = v_is_djs 
            when v_is_djs = false then cp.is_djs = false
            else true end
        and cp.delete_sw = 'N'
        order by program_id desc
        ) x ) as programshistory,
      (select json_agg(x) from (
        SELECT budget_code
        FROM tb_contract_budget_codes bc 
        where bc.contract_id = tpc.contract_id
        and bc.active_flag = 1
        ) x ) as contract_budget_codes,
      (SELECT json_agg(x) from(SELECT tfy.* from tb_contract_fiscal_year tfy where tfy.contract_id = tpc.contract_id and tfy.active_flag = 1)  x) AS
      fiscalyeararray,      
      (SELECT json_agg(x) from(
        select DATE_PART('day', end_dt::timestamp -  now()::timestamp) ::integer as expire_days,
              case
              when (DATE_PART('day', end_dt::timestamp -  now()::timestamp ):: integer <=90 and DATE_PART('day', end_dt::timestamp -  now()::timestamp ):: integer >60) then 'yellow'
              when (DATE_PART('day', end_dt::timestamp -  now()::timestamp ):: integer <=60 and DATE_PART('day', end_dt::timestamp -  now()::timestamp ):: integer >30) then 'orange'
              when (DATE_PART('day', end_dt::timestamp -  now()::timestamp ):: integer <=30) then 'red'
              end as color_code
            from tb_provider_contracts cont_exp where cont_exp.contract_id = tpc.contract_id
            )  x) AS contractexpire      
      FROM tb_provider_contracts tpc  
      INNER JOIN tb_provider tp on tp.provider_id = tpc.provider_id and tp.delete_sw='N'
      INNER JOIN tb_provider_picklist tpp on tp.provider_id = tpp.provider_id and tpp.delete_sw='N' and tpp.picklist_value_cd=3049
      WHERE (v_provider_id is null or tpc.provider_id like '%'|| v_provider_id || '%')
     AND tpc.contract_agency::character VARYING ='DJS'
     AND (v_provider_name = '' or v_provider_name = null or trim(lower(tp.provider_nm::character varying)) like '%'||v_provider_name||'%') 
        AND (case when v_search_contract = true then  (v_contract_id is null or tpc.contract_id::character VARYING like '%'|| v_contract_id||'%') 
     else (case when (v_contract_id is null AND v_base_contract_id is not null) then 
        tpc.base_contract_id = v_base_contract_id::integer
       when (v_contract_id is not null AND v_base_contract_id is null) then 
        tpc.contract_id::character VARYING = v_contract_id
       else true end) end )
        AND (case when v_program_id is not null and v_program_id !='' then 
              exists(select 1 FROM tb_contract_program cp where cp.contract_id = tpc.contract_id and cp.program_id = v_program_id and cp.delete_sw = 'N')
            else true end) 
        AND (case when v_program_name is not null and v_program_name !='' then 
              exists(select 1 FROM tb_contract_program cp where cp.contract_id = tpc.contract_id and trim(lower(cp.program_nm)) like '%'||v_program_name||'%' and cp.delete_sw = 'N')
            else true end) 
      and tpc.DELETE_sw ='N'
      order by tpc.contract_id desc
      LIMIT 10  OFFSET v_skip
 )  a;

RETURN  jsondata;
END;

$function$

