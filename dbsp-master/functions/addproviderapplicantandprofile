CREATE OR REPLACE FUNCTION addproviderapplicantandprofile(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

declare

v_ReqReferralId text;
v_applicantId text;
returnStatus text;
v_securityuserid text;
v_providerid text;
v_program_type text;
v_provid int;
v_profileid uuid;

BEGIN

v_ReqReferralId := insertedtlsobj->>'provider_referral_id';
v_applicantId := insertedtlsobj->>'provider_applicant_id';
v_securityuserid := insertedtlsobj->>'securityuserid';
v_program_type := insertedtlsobj->>'program_type';
v_provid := insertedtlsobj->>'provid';
v_profileid := insertedtlsobj->>'profileid';
RAISE NOTICE '%','11111111111111111111111111111111111111111111111111111';



IF LENGTH(v_applicantId) > 1
THEN

Select provider_id into v_providerid from tb_provider_referral where provider_referral_id = v_ReqReferralId;

IF LENGTH(v_providerid) > 1
THEN

INSERT into  tb_provider_applicant(applicant_id, create_user_id,update_user_id,program_name,contact_email,contact_phonenumber,mailing_address,program_type,provider_id,prgram,application_status,program_tax_id_no,corporation_name,create_ts,agency) 
select v_applicantId, v_securityuserid, v_securityuserid, pr.provider_program_name,pr.adr_email_tx,pr.adr_cell_phone_tx,cast( pra.adr_street_no || ',' ||pra.adr_street_nm || ',' ||pra.adr_city_nm ||',' || pra.adr_state_cd ||',' || pra.adr_zip5_no as character varying),v_program_type,  v_providerid , pr.provider_referral_program, 'Pending',pr.corporation_entity_taxid::int,pr.corporation_entity,now()::timestamp,pr.agency from tb_provider_referral pr ,tb_provider_referral_addresses pra where pr.provider_referral_id = v_ReqReferralId and pra.parent_key_id= v_ReqReferralId ;

update tb_prov_ref_program_type set applicant_id = v_applicantId ,updatedby = v_securityuserid, updatedon=now() where referral_id = v_ReqReferralId and program_type = v_program_type;  

else

INSERT into  tb_provider_applicant(applicant_id, create_user_id,update_user_id,program_name,contact_email,contact_phonenumber,mailing_address,program_type,applicant_profile_id,prgram,provider_id,application_status,program_tax_id_no,corporation_name,create_ts,agency) 
select v_applicantId, v_securityuserid, v_securityuserid, pr.provider_program_name,pr.adr_email_tx,pr.adr_cell_phone_tx,cast( pra.adr_street_no || ',' ||pra.adr_street_nm || ',' ||pra.adr_city_nm ||',' || pra.adr_state_cd ||',' || pra.adr_zip5_no as character varying),v_program_type, v_profileid,pr.provider_referral_program, v_provid , 'Pending',pr.corporation_entity_taxid::int,pr.corporation_entity,now()::timestamp,pr.agency from tb_provider_referral pr ,tb_provider_referral_addresses pra where pr.provider_referral_id = v_ReqReferralId and pra.parent_key_id= v_ReqReferralId ;

update tb_prov_ref_program_type set applicant_id = v_applicantId ,updatedby = v_securityuserid, updatedon=now() where referral_id = v_ReqReferralId and program_type = v_program_type;  

end if;

else
returnStatus:= 'failure';
END IF;
returnStatus:= 'Success';
RETURN returnStatus;
                                                      
END;

$function$

