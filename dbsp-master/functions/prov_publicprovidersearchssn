CREATE OR REPLACE FUNCTION prov_publicprovidersearchssn(reqobj json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
v_ssn integer;

jsondata  json;


BEGIN


v_ssn := reqobj->>'tax_id_no';


SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

select distinct LOWER(trim(provider_first_nm)),LOWER(trim(provider_last_nm)),LOWER(trim(provider_nm)),tp.provider_nm,tp.provider_id,co.countyname,up.displayname,pa.toworkeridno,tp.provider_first_nm, tp.provider_last_nm, tp.county_cd
from tb_provider tp 
join county co on co.statecountycode = tp.county_cd 
join providerassignment pa on pa.objectid = tp.provider_id and (pa.enddate::date >= now()::date or pa.enddate is null) 
join userprofile up on pa.toworkeridno = up.securityusersid 
WHERE
 tp.tax_id_no = v_ssn
 AND tp.delete_sw = 'N'
order by LOWER(trim(provider_first_nm)),LOWER(trim(provider_last_nm)),LOWER(trim(provider_nm)) ASC NULLS last 
)  a;

RETURN  jsondata;
END;

$function$

