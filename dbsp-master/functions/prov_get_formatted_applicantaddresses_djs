CREATE OR REPLACE FUNCTION prov_get_formatted_applicantaddresses_djs(v_providerid character varying, v_adr_type_cd character varying DEFAULT '3357'::character varying)
 RETURNS TABLE(provider_adr character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 

 v_adrformat character varying;

BEGIN 
 

return query

select 
concat(
provadd.adr_foreign_tx, ' ',
provadd.adr_street_tx, ' ',
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_pre_dir_cd) and pv.picklist_type_id = 69 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), ' ',
provadd.adr_box_no, ' ',
provadd.adr_street_nm, ' ',
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_street_suffix_cd) and pv.picklist_type_id = 212 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), ', ',
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_post_dir_cd) and pv.picklist_type_id = 69 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), ' ',
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_unit_type_cd) and pv.picklist_type_id = 250 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), ' ',
provadd.adr_unit_no_tx, ' ',
(case when provadd.adr_unit_no_tx is not null or provadd.adr_unit_type_cd is not null then ',' end),
'<br>',INITCAP(provadd.adr_city_nm), ',',
provadd.adr_country_tx,
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_county_cd) and pv.picklist_type_id = 104 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), ' ',
(case when provadd.adr_county_cd is not null then ', ' end),
provadd.adr_state_cd, '- ',
provadd.adr_zip5_no, ' ',
provadd.adr_postal_code_tx, ' ',
provadd.adr_county_cd_tx, ' '
)::character VARYING

from tb_provider_applicant_addresses provadd 
where 
provadd.parent_key_id = v_providerid 
and provadd.delete_sw='N' 
and provadd.adr_default_sw ='Y' 
and provadd.adr_type_cd =v_adr_type_cd::integer 
limit 1 ;

end;

$function$

