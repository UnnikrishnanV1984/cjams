CREATE OR REPLACE FUNCTION prov_getprovideractorinvolved(v_provider_uir_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

 SELECT  distinct 
 (Select value_text as restraint_typekey_value from  referencevalues b where  b.ref_key  = PUAI.restraint_typekey),
 PUAI.*,
  AD.first_name as youthfname,AD.last_name as youthlname,
  TPS.first_nm,TPS.last_nm
  FROM provider_uir_actor_involved PUAI
  left join provider_uir_actor_detail AD on AD.provider_uir_actor_detail_id=PUAI.provider_uir_actor_detail_id
  left join providerstaff TPS on TPS.provider_staff_id::CHARACTER VARYING =PUAI.provider_staff_id::CHARACTER VARYING 
 WHERE 
  PUAI.provider_uir_id= v_provider_uir_id
  and PUAI.active_flag = 1
)  a;

RETURN  jsondata;
END;

$function$

