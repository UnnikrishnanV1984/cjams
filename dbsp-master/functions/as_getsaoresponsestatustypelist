CREATE OR REPLACE FUNCTION as_getsaoresponsestatustypelist(v_intakenumber character varying)
 RETURNS TABLE(saoresponsestatustypeid uuid, saoresponsestatustypekey character varying, description character varying, activeflag integer)
 LANGUAGE plpgsql
AS $function$

Declare 
v_count int;
                                                                                     
BEGIN   


SELECT COUNT(*) INTO v_count FROM intakeservicerequest AS ISR
JOIN intakeservicerequestdispositioncode AS ISRDC 
     ON ISRDC.intakeserviceid = ISR.intakeserviceid AND ISRDC.activeflag = 1 
JOIN servicerequesttypeconfigdispositioncode AS SRTCDC
     ON SRTCDC.servicerequesttypeconfigiddispostionid = ISRDC.servicerequesttypeconfigiddispostionid AND ISRDC.activeflag = 1
AND lower(SRTCDC.dispositioncode) = 'fafpria'    
where ISR.intakenumber = v_intakenumber AND ISR.activeflag = 1;
 
IF v_count = 0 THEN

     RETURN Query 
  SELECT SRST.saoresponsestatustypeid, SRST.saoresponsestatustypekey, SRST.description,
  SRST.activeflag FROM saoresponsestatustype AS SRST WHERE SRST.activeflag = 1
  AND lower(SRST.saoresponsestatustypekey) NOT IN('rbsaofid')
  ORDER BY SRST.description ASC;

ELSE 

     RETURN Query 
  SELECT SRST.saoresponsestatustypeid, SRST.saoresponsestatustypekey, SRST.description,
  SRST.activeflag FROM saoresponsestatustype AS SRST WHERE SRST.activeflag = 1
  AND lower(SRST.saoresponsestatustypekey) IN('rbsaofid')
  ORDER BY SRST.description ASC;

END IF;

END;
                    
$function$

