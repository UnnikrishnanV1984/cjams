CREATE OR REPLACE FUNCTION f_get_preadop_info(a_adoptioncaseid uuid, OUT a_preadoptionclientid uuid, OUT a_preadoptioncaseid uuid)
 RETURNS record
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare v_preadoptionclientid uuid;
    declare v_preadoptioncaseid uuid;
 
BEGIN
 -- Get Pre-Adoption Person ID & Case ID
 select preadoptionclientid,
  preadoptioncaseid
 into v_preadoptionclientid,
  v_preadoptioncaseid
 from adoptionlink 
 where adoptioncaseid = a_adoptioncaseid 
  and activeflag = 1 ;
  
 a_preadoptionclientid := v_preadoptionclientid;
 a_preadoptioncaseid := v_preadoptioncaseid;
 
END;

$function$

