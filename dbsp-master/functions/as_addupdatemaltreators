CREATE OR REPLACE FUNCTION as_addupdatemaltreators(maltreators json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

 DECLARE
 v_maltreators json;
 v_date timestamp without time zone;
    v_evaluationdate timestamp without time zone;
 
 BEGIN 
  
  v_maltreators := maltreators;
  v_date:= now() at time zone 'utc';
  raise notice 'v_caseevaluation%',v_caseevaluation;
    
   
    return 'Success';
 END;

$function$

