CREATE OR REPLACE FUNCTION as_getrelationshiptype(v_teamtypekey character varying, v_actortypekey character varying DEFAULT ''::character varying)
 RETURNS TABLE(sequencenumber integer, relationshiptypekey character varying, description text, activeflag integer, effectivedate timestamp without time zone, personrelationship boolean)
 LANGUAGE plpgsql
AS $function$

BEGIN

RETURN Query
  
 SELECT  
    rt.sequencenumber,rt.relationshiptypekey,rt.description,rt.activeflag,rt.effectivedate,rt.personrelationship
 FROM relationshiptype rt
 INNER JOIN relationshiptypeagency rta ON rt.relationshiptypekey = rta.relationshiptypekey AND rta.activeflag =1
 WHERE rta.teamtypekey = v_teamtypekey AND rt.activeflag =1
 and case when (v_actortypekey !='' and  v_actortypekey is not null  and (v_actortypekey = 'parent-or-guard'  or v_actortypekey = 'Others')) then (rt.actortypekey=v_actortypekey or rt.actortypekey='both') else 1=1 end
 AND CASE WHEN v_teamtypekey = 'DJS' then rt.relationshiptypekey NOT IN ('norelation') ELSE 1=1 END
 ORDER BY rt.description;
 
END;

$function$

