CREATE OR REPLACE FUNCTION createdynamnicuserprofile_external(allusers json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$                                                                                                                    
                                                                                                                                  

 declare v_provider_id character varying;    
 declare v_role character varying;                                                                                                                                     
 declare D_roletype character varying;                                                                                            
 declare D_id  int;   
 declare D_providerid character varying;                                                                                                       
 declare D_roletypekey character varying;                                                                                         
 declare D_Prinicpalid character varying;                                                                                         
 declare D_teamid uuid;                                                                                                           
 declare D_teammemberid uuid;                                                                                                     
 declare v_firstname character varying;                                                                                           
 declare v_lastname character varying;                                                                                            
 declare v_email character varying;                                                                                               
 declare d_securityusersid text;                                                                                                  
 declare D_email int;  
declare inputparams json;   
declare outputjson json;
declare output text [];                                                                                                            
                                                                                                                                  
 begin           
  --output = [];
        for inputparams in select * from json_array_elements(allusers)
  loop                                                                                                                          
        v_email := inputparams ->> 'email'; 
        v_provider_id := inputparams ->> 'providerId';                                                                                                                                   
        v_role := inputparams ->> 'role';   
  v_firstname := inputparams ->> 'firstname';
  v_lastname := inputparams ->> 'lastname';   
        raise notice 'v_email%', v_email;   

        /* select provider_first_nm , provider_last_nm into v_firstname,v_lastname from tb_provider tp 
        where tp.provider_id = v_provider_id and tp.delete_sw = 'N';         */



        raise notice 'v_firstname --%>',v_firstname;                                                                                                                                                                                                              
   --   select  roletypecode into D_roletype from roletype where roletypecode='PSA';                                          
      --  select provider_id into D_providerid from tb_provider_userconfig where provider_id = v_provider_id ;
   D_providerid = v_provider_id;
        select  id,roletypekey into D_id,D_roletypekey from "role" where openamrole = v_role;                                 
        select  teamid into D_teamid from team where  teamname='Provider Portal';                                                 
        select count (*) into D_email from muser where email=v_email;                                                            
                                                                                                                                  
         raise notice 'D_email --%>',D_email;                                                                                     
                                                                                                                                  
                                                                                                                                  
         if(D_teamid is not null and D_email = 0 and D_providerid is not null) then

   INSERT INTO teammember
   (teammemberid, activeflag, teamid, loadnumber, roletypekey, positioncode, insertedby, insertedon,
   updatedby, updatedon, effectivedate, linenumber,  rtfdate, coadate)   
   values 
   (gen_random_uuid(),1,D_teamid,'111001',D_roletypekey,'111001','admin',now(),
   'admin',now(), now(),'111001',now(),now()) 
   RETURNING "teammemberid" into D_teammemberid;
  -- raise notice 'D_teammemberid --%>',D_teammemberid;

   INSERT INTO userprofile(
   securityusersid, firstname, lastname, displayname, fullname, 
   activeflag,   email,    insertedby, insertedon, updatedby, updatedon,
   teamtypekey,usertypekey,autonotification,old_id,title)
   values
   (gen_random_uuid(),v_firstname,v_lastname,v_firstname||' '|| v_lastname,v_firstname||' '|| v_lastname,
   1,v_email,'admin' , now(),'admin',now(),
   'PVPROV','DSDS',false,'man',v_firstname)
   RETURNING "securityusersid" into d_securityusersid;
   raise notice 'd_securityusersid --%>',d_securityusersid;
 
 
   INSERT INTO securityusers(securityusersid, username , activeflag, insertedby, updatedby,insertedon, updatedon,old_id)
            select securityusersid, displayname,  1,'admin','admin',now(),now(),'man' from userprofile
   where securityusersid =d_securityusersid;
 -- raise notice '12345654323454 --%>',d_securityusersid;

   INSERT INTO muser( username, password, email,  id, securityusersid,
   insertedby, updatedby, insertedon, updatedon, activeflag ,old_id)
   SELECT  displayname,'$2a$10$fwlp0MMCDZHj9wk7mNdQ6uf1hQkZXcDYiqlLZZVWK0Ic4PCcm0lyW',
   v_email,nextval('muser_id_seq'),d_securityusersid, 'admin' ,'admin',now(),now(),1,title from userprofile 
   where securityusersid=d_securityusersid
         RETURNING "id" into D_Prinicpalid;
   
--   raise notice 'D_Prinicpalid --%>',D_Prinicpalid;
   INSERT INTO teammemberassignment
   (teammemberassignmentid, activeflag, teammemberid, securityusersid, insertedby,
   insertedon, updatedby, updatedon, effectivedate)
   VALUES 
   (gen_random_uuid(), 1,D_teammemberid,d_securityusersid, 'admin', now(), 'admin', now(), now()); 
  
   INSERT INTO rolemapping 
   (id, principaltype,principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon,teamtypekey )
   values
   ( nextval('rolemapping_id_seq'),'USER',D_Prinicpalid,D_id,1, 'admin', 'admin', now(), now(), 'OLM');

   INSERT INTO tb_provider_userconfig
   ( provider_id,  securityusers_id, activeflag)
   values (v_provider_id::int,(d_securityusersid)::uuid,1 );
   output = array_append(output, d_securityusersid);
    
  else
  select securityusersid into d_securityusersid from muser where email=v_email;
  output = array_append(output, d_securityusersid);

end if;
end loop;

 
 
  return  json_build_object('securityusers', array_to_string(output,','));
   
  
  end;




$function$

