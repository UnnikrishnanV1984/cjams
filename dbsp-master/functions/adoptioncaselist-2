CREATE OR REPLACE FUNCTION adoptioncaselist(adoptioncaseno character varying, pagenumber integer, pagesize integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_adoptioncaseno character varying;
 v_pageoffset  int;
 v_pagenumber  int;
 l_adoptioncase  json;
 v_adoptioncaselen int;
  
BEGIN
        v_pagenumber  :=  pagenumber-1;
        v_pageoffset  =  v_pagenumber  *  pagesize; 

 select length(v_adoptioncaseno) into  v_adoptioncaselen;
 
 IF v_adoptioncaselen != 0
   THEN 
 SELECT json_agg(TT) INTO l_adoptioncase FROM 
 (
  SELECT ac.adoptioncasenumber
  ,ac.insertedon as casecreateddate 
  ,ac.startdate
  , ac.enddate 
  ,ac.statustypekey
  ,
  (SELECT json_agg(per) FROM  (
            SELECT p.personid
      ,p.firstname
      ,p.lastname
      ,p.middlename
      ,p.dob
      ,p.gendertypekey,
  
  (SELECT json_agg(addr) FROM  ( 
         SELECT pa.address
      ,pa.address2
      ,pa.personaddresstypekey
      ,pa.zipcode
      ,pa.city
      ,pa.state
      ,pa.country
      ,pa.county
  FROM personaddress pa 
  WHERE pa.personid = p.personid 
  AND pa.activeflag = 1
  )addr) as address,
  
  (SELECT json_agg(cont) FROM  ( 
     SELECT  ppn.personphonetypekey
     ,ppn.phonenumber
     ,ppn.phoneextension 
  FROM  personphonenumber ppn 
  WHERE ppn.personid = p.personid 
  and ppn.activeflag = 1)cont) as contact
  
  FROM adoptioncaseactor aca 
  inner join person p on p.personid = aca.personid
  inner join actortype atp on atp.actortype = aca.actortypekey
  where aca.adoptioncaseid = ac.adoptioncaseid)per) as person
 
    FROM adoptioncase ac     
 WHERE ac.activeflag = 1 and ac.adoptioncaseid = v_adoptioncaseno 
    LIMIT  pagesize  OFFSET  v_pageoffset
) TT;
    ELSE 
    SELECT json_agg(TT) INTO l_adoptioncase FROM 
 (
  SELECT ac.adoptioncasenumber
  ,ac.insertedon as casecreateddate 
  ,ac.startdate
  , ac.enddate 
  ,ac.statustypekey
  ,
  (SELECT json_agg(per) FROM  (
            SELECT p.personid
      ,p.firstname
      ,p.lastname
      ,p.middlename
      ,p.dob
      ,p.gendertypekey,
  
  (SELECT json_agg(addr) FROM  ( 
         SELECT pa.address
      ,pa.address2
      ,pa.personaddresstypekey
      ,pa.zipcode
      ,pa.city
      ,pa.state
      ,pa.country
      ,pa.county
  FROM personaddress pa 
  WHERE pa.personid = p.personid 
  AND pa.activeflag = 1
  )addr) as address,
  
  (SELECT json_agg(cont) FROM  ( 
     SELECT  ppn.personphonetypekey
     ,ppn.phonenumber
     ,ppn.phoneextension 
  FROM  personphonenumber ppn 
  WHERE ppn.personid = p.personid 
  and ppn.activeflag = 1)cont) as contact
  
  FROM adoptioncaseactor aca 
  inner join person p on p.personid = aca.personid
  inner join actortype atp on atp.actortype = aca.actortypekey
  where aca.adoptioncaseid = ac.adoptioncaseid)per) as person
 
    FROM adoptioncase ac     
 WHERE ac.activeflag = 1
    LIMIT  pagesize  OFFSET  v_pageoffset
) TT;

  END IF; 
   

Return l_adoptioncase;
END;

$function$

