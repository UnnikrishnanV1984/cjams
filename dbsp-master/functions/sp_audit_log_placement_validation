CREATE OR REPLACE FUNCTION sp_audit_log_placement_validation(searchobj json, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, validation_month character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE  

 al_event_id bigint;
 as_event_type_cd character varying;
 v_pagenumber int;
 v_pageoffset int;

BEGIN 
al_event_id := searchobj ->> 'event_id';
as_event_type_cd := searchobj ->> 'event_type_cd';
v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

 return query
SELECT  COUNT(1) OVER() totalcount, 
 --MONTHNAME(PV.VALIDATION_START_DT) || ' ' || YEAR(PV.VALIDATION_START_DT) AS VALIDATION_MONTH
 to_char( (PV.validation_end_dt), 'MONTH-YYYY')::character varying as VALIDATION_MONTH
   FROM TB_FISCAL_AUDIT_TRAIL FA,
   TB_FISCAL_AUDIT_TRAIL_ENTITY_LINK FL,
   TB_PLACEMENT_VALIDATION PV 
WHERE FA.FISCAL_AUDIT_TRAIL_ID = FL.FISCAL_AUDIT_TRAIL_ID
 AND PV.PLACEMENT_VALIDATION_ID = FL.ENTITY_ID
 AND FA.EVENT_ID = al_event_id  --- REVISION_ID
 AND FA.EVENT_TYPE_CD = as_event_type_cd --- CHANGE_TYPE_CD
 AND FL.ENTITY_TYPE_CD = '1006'
 AND FA.DELETE_SW = 'N'
 AND FL.DELETE_SW = 'N'
ORDER BY PV.VALIDATION_START_DT
LIMIT v_liPageSize OFFSET v_pageoffset; 

END;
$function$

