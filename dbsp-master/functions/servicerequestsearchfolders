CREATE OR REPLACE FUNCTION servicerequestsearchfolders(searchkey character varying)
 RETURNS TABLE(foldertypekey character varying, description character varying)
 LANGUAGE plpgsql
AS $function$

declare searchstring character varying(1000);
BEGIN
 searchstring:= coalesce(searchstring,'');
 if (searchkey!='' or searchkey!=null) then
 searchstring:= coalesce(searchstring,'')|| ' AND (CASE WHEN '''||lower(searchkey)||''' is NOT NULL THEN (lower(cast( coalesce(PN.old_id,'''') as  character varying)) = '''||lower(searchkey)||''' or PN.cjamspid = '''||lower(searchkey)||''') ELSE TRUE end)';
        end if; 
  
  RETURN QUERY
     execute ' 
    select distinct FT.foldertypekey,FT.description

 FROM foldertype as FT
 JOIN intakeservicerequest as ISR 
      ON ISR.foldertypekey = FT.foldertypekey  
 JOIN (select intakeserviceid, max(actorid::character varying) ::uuid actorid FROM intakeservicerequestactor WHERE intakeservicerequestpersontypekey in (''Youth'') 
       AND activeflag =1 group by intakeserviceid )as ISRA 
      ON ISRA.intakeserviceid=ISR.intakeserviceid 
 JOIN actor as AR
      ON AR.actorid=ISRA.actorid AND AR.activeflag = 1
 JOIN person as PN 
      ON PN.personid=AR.personid AND PN.activeflag = 1
     '
     ' WHERE   ISR.intakeserreqstatustypeid NOT IN (select intakeserreqstatustypeid from intakeserreqstatustype where lower(intakeserreqstatustypekey) in (''closed'',''cancelled'',''completed''))
       '|| searchstring ||' and ISR.foldertypekey is not null '  ;

END; 

$function$

