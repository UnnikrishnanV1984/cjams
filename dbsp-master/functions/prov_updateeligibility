CREATE OR REPLACE FUNCTION prov_updateeligibility(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$   
 declare         
 v_providerId character varying;       
 v_securityuserid character varying;
 v_effectivedate date; 
 v_enddate date;  
 v_comments character varying;
 v_license_application_id character varying;

 begin
 v_providerId := insertobj->>'provider_id';          
 v_securityuserid := insertobj->>'securityuserid';  
 v_effectivedate :=  insertobj->>'effective_date';  
 v_enddate :=  insertobj->>'end_date';  
 v_comments := insertobj->>'comments';  
-- v_categorycd := '3795';



select license_application_id into v_license_application_id 
from tb_provider_licensing 
where site_id = v_providerId and active_sw = 'Y';


INSERT INTO tb_provider_licensing
    (site_id, provider_id, license_type_cd, license_status_cd, application_type_cd, license_decision_cd,          
    license_issue_dt, license_expiry_dt, license_modification_dt, license_no, licensing_agency_cd, licensing_corodinator_id, licensed_beds_no, requirement_sw, midterm_issue_dt, active_sw, comments_tx, program_id,
    revoke_dt, revoke_approval_status_cd, midterm_rqrmnt_sw, create_ts, create_user_id, update_ts, update_user_id, delete_sw, ref_license_application_id, lic_entry_dt, request_revoke_sw, pre_revoke_status_cd , license_type ,license_level)        
select site_id, provider_id, license_type_cd, license_status_cd, application_type_cd, license_decision_cd,          
    v_effectivedate, v_enddate, license_modification_dt, license_no, licensing_agency_cd, licensing_corodinator_id, licensed_beds_no, requirement_sw, midterm_issue_dt, 'Y', v_comments, program_id,
    revoke_dt, revoke_approval_status_cd, midterm_rqrmnt_sw, now(), v_securityuserid, now(), v_securityuserid, delete_sw, ref_license_application_id, lic_entry_dt, request_revoke_sw, pre_revoke_status_cd , license_type ,license_level
    from tb_provider_licensing tpl where tpl.license_application_id::character varying = v_license_application_id;


update tb_provider_licensing tpl 
set active_sw = 'N' ,
update_ts = now(),
update_user_id = v_securityuserid
where tpl.license_application_id::character varying = v_license_application_id;


 return 'success';
        
 end; 
 $function$

