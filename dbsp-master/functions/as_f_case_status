CREATE OR REPLACE FUNCTION as_f_case_status(ai_caseid bigint)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
 
BEGIN
    RETURN
         (select caseactiontypekey  from(
 select row_number() over() as num, caseactiontypekey from(
        SELECT
  caseactiontypekey,caseid
  from casehistory
  where  caseid :: character varying = AI_CASEID :: character varying  and 
  approvalstatustypekey = '3047'
  and activeflag = 1 order by caseactiondate desc, old_id desc
 ) first
 ) second where num=1
          );
END;
$function$

