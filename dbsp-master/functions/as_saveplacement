CREATE OR REPLACE FUNCTION as_saveplacement(v_intakeserviceid uuid, jsondata json, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


DECLARE 

v_placementid uuid;
v_intakeservicerequestactorid uuid;
j_placement json;
v_date timestamp without time zone;
 
BEGIN
        v_date:= now() ;
        j_placement := jsondata;
        v_placementid :=   gen_random_uuid();

        select ISRA.intakeservicerequestactorid into v_intakeservicerequestactorid from intakeservicerequest as ISR
        JOIN intakeservicerequestactor as ISRA on ISR.intakeserviceid = ISRA.intakeserviceid and ISRA.activeflag=1 and lower(ISRA.intakeservicerequestpersontypekey) = 'youth'
        where ISR.intakeserviceid = v_intakeserviceid limit 1;
        
 Insert Into placement (placementid, providerid, intakeserviceid, intakeservicerequestactorid, remarks, placementadmissionclassificationkey, placementadmissiontypekey,
 parentorg, addate, adtime, releasedate, detainer, startdatetime, placementadmissionauthorizationtypekey, placementprimaryadmissionreasontypekey,
 placementprimaryapprovedalttypekey, county, jlocation, jcounty, fieldworker,insertedby, updatedby,insertedon, updatedon, certifiedad, resourceworker, istempplacement)

 values (v_placementid, cast(j_placement ->> 'providerid' as uuid), v_intakeserviceid, v_intakeservicerequestactorid, cast(j_placement ->> 'remarks' as text), 
 cast(j_placement ->> 'placementadmissionclassificationkey' as character varying), cast(j_placement ->> 'placementadmissiontypekey' as character varying),
 cast(j_placement ->> 'parentorg' as character varying), cast(j_placement ->> 'addate' as date), cast(j_placement ->> 'adtime' as time),
 cast(j_placement ->> 'releasedate' as date), cast(j_placement ->> 'detainer' as character varying), v_date,
 cast(j_placement ->> 'PlacementAdmissionAuthorizationTypekey' as character varying), cast(j_placement ->> 'PlacementPrimaryAdmissionReasonTypekey' as character varying),
 cast(j_placement ->> 'PlacementPrimaryApprovedAltTypekey' as character varying), cast(j_placement ->> 'county' as uuid), cast(j_placement ->> 'jlocation' as character varying),
 cast(j_placement ->> 'jcounty' as character varying), cast(j_placement ->> 'fieldworker' as character varying), v_securityuserid, v_securityuserid, v_date,
 v_date, cast(j_placement ->> 'certifiedad' as character varying), cast(j_placement ->> 'resourceworker' as character varying),
 cast(j_placement ->> 'istempplacement' as boolean)  );

Return 'Success';
 
END;

$function$

