CREATE OR REPLACE FUNCTION getrstnchangeformdashboardlist(v_securityusersid character varying, pagenumber bigint, pagesize bigint, searchcol character varying, searchval character varying)
 RETURNS TABLE(totalcount bigint, intakeserreqrestitutionid uuid, restitutionno integer, intakenumber character varying, servicerequestnumber character varying, youthpersondetails json, victimpersondetails json, changeformreasontypes json, balance numeric, changeformreason character varying, status character varying, changeto numeric)
 LANGUAGE plpgsql
AS $function$ declare v_searchkey character varying ;

v_pageoffset int;

v_pagenumber int;

declare searchstring character varying(5000);
begin
v_pagenumber := pagenumber-1;

v_pageoffset = v_pagenumber * pagesize;

searchstring := coalesce(searchstring, '');

if(searchcol != ''
and searchval != '' ) then if (searchcol = 'intakenumber') then searchstring := '  AND  ISRR.intakenumber  =  ''' || searchval || '''  ';
end if;

if (searchcol = 'servicerequestnumber') then searchstring := '  AND  ISR.servicerequestnumber  =  ''' || searchval || '''  ';
end if;
end if;
--select (approvestatus = 'RSTAPR') into v_isapproved from intakeserreqrestitution isr where isr.activeflag=1;
 raise notice 'searchstring%',
searchstring;

return Query execute 'select count(1) over() as totalcount, ISRR.intakeserreqrestitutionid,ISRR.restitutionno,ISRR.intakenumber,ISR.servicerequestnumber,
json_build_object(''youthpersonid'',youthpersonid,''youthfirstname'',pp.firstname,
''youthlastname'', pp.lastname ,''youthcjamspid'', pp.cjamspid, ''youthdob'',pp.dob, ''youthgendertypekey'',pp.gendertypekey ) as youthpersondetails,
json_build_object(''victimpersonid'',victimpersonid,''victimfirstname'',pv.firstname,
''victimlastname'', pv.lastname ,''victimcjamspid'', pv.cjamspid, ''victimdob'',pv.dob, ''victimgendertypekey'',pv.gendertypekey ) as victimpersondetails,
(select json_agg(rv.value_text) from restitutionchangeformreasonconfig rcfrc join
referencevalues rv on rv.ref_key = rcfrc.changeformreasontypekey join referencetype rt on rt.referencetypeid = rv.referencetypeid  
where rcfrc.intakeserreqrestitutionid = ISRR.intakeserreqrestitutionid and rcfrc.activeflag = 1) as  changeformreasontypes,
case
 when isrr.approvestatus = ''RSTPND'' then (coalesce(isrr.payment, 0))
 else (coalesce(isrr.payment, 0) + coalesce(isrr.waivedamount, 0) - coalesce(isrr.additionalamount, 0))
 end as balance,
--(coalesce(isrr.payment, 0) + coalesce(isrr.waivedamount, 0) - coalesce(isrr.additionalamount, 0)) as balance, 
isrr.changeformreason,
(select rv.description from referencevalues rv join referencetype rt on rt.referencetypeid = rv.referencetypeid 
where rv.ref_key = isrr.approvestatus and rv.activeflag = 1 and rt.activeflag = 1 and 
rt.tablename = ''RestitutionApprStatusType'') as status,
--((coalesce(isrr.payment, 0) - coalesce(isrr.waivedamount, 0) + coalesce(isrr.additionalamount, 0)) - coalesce(isrr.paidamount, 0)) + (coalesce(isrr.additionalamount, 0)) - (coalesce(isrr.waivedamount, 0)) as changeto -- comment 08/03/2018
--((coalesce(isrr.payment, 0)) - coalesce(isrr.paidamount, 0)) + (coalesce(isrr.additionalamount, 0)) - (coalesce(isrr.waivedamount, 0)) as changeto
--(coalesce(isrr.payment, 0)) as changeto
case
 when isrr.approvestatus = ''RSTPND'' then (coalesce(isrr.payment, 0) + coalesce(isrr.additionalamount, 0) - coalesce(isrr.waivedamount, 0))
 else (coalesce(isrr.payment, 0))
 end as changeto
from intakeserreqrestitution as ISRR 
--(select restitutionno, max(insertedon) insertedon from intakeserreqrestitution where activeflag = 1 group by restitutionno) res
--JOin intakeserreqrestitution as ISRR 
--     on ISRR.restitutionno = res.restitutionno and ISRR.insertedon = res.insertedon
join routing as R 
     on R.objectid = ISRR.intakeserreqrestitutionid::character varying and R.activeflag=1
join intakeservicerequest as ISR
     on ISR.intakeserviceid = ISRR.intakeserviceid and ISR.activeflag=1
join person pp 
     on pp.personid= ISRR.youthpersonid and pp.activeflag=1
join person pv 
     on pv.personid = ISRR.victimpersonid and pv.activeflag=1

where (((R.fromsecurityusersid = ''' || v_securityusersid || ''' or 
R.tosecurityusersid = ''' || v_securityusersid || ''') and R.routingstatustypeid in (46)) 
or R.fromsecurityusersid is null)
--and ISRR.activeflag=1 --and ISRR.approvestatus=''RSTAPR''
' || searchstring || '
--ORDER BY isrr.restitutionno desc  
ORDER BY R.updatedon desc LIMIT ' || pagesize || ' OFFSET ' || v_pageoffset || '';
end;

$function$

