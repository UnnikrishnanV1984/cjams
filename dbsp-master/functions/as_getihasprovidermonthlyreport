CREATE OR REPLACE FUNCTION as_getihasprovidermonthlyreport(v_intakeserviceid uuid, _page integer, _limit integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE 
_offset    integer;
l_monthlyreport json;

begin  
_offset  :=  (_page  -  1)  *  _limit; 

 SELECT Json_agg(a) 
  INTO   l_monthlyreport 
  FROM   ( 
                  SELECT ihmr.* , 
      (SELECT json_agg(inj) FROM 
       (SELECT * FROM ihasprovidedmonthlyreportdaysconfig ihmrd
        WHERE ihmrd.ihasprovidermonthlyreportid = ihmr.ihasprovidermonthlyreportid
        AND ihmrd.activeflag =1) 
           inj )::json as monthlyreportdays                     
      from ihasprovidermonthlyreport ihmr                    
      where ihmr.intakeserviceid=v_intakeserviceid
      LIMIT  _limit  OFFSET  _offset
                  ) a;
  RETURN  l_monthlyreport;   
                  

 END;
 

$function$

