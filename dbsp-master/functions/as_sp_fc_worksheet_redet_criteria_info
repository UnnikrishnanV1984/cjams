CREATE OR REPLACE FUNCTION as_sp_fc_worksheet_redet_criteria_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, childbeeninfostercare12monthormore character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm         VARCHAR(100) DEFAULT 'sp_fc_worksheet_redet_criteria_info';
  vs_child_been_fc_mnths_more      VARCHAR(50);
  
 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_redet_criteria_info ( 
  client_id             BIGINT,
  childbeeninfostercare12monthormore      VARCHAR(50)
 );

-- Child Been In FC 12 Month/More
SELECT ( CASE WHEN (((extract('years' FROM coalesce(isrcr.returndate, current_date))::int -  extract('years' FROM isrcr.removaldate)::int) * 12) > 12) 
    THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END )
 INTO vs_child_been_fc_mnths_more
   FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra 
WHERE isra.intakeserviceid = isrcr.intakeserviceid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestpersontypekey = 'RC' AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
  
INSERT INTO Temp_worksheet_redet_criteria_info
SELECT 
  al_client_id,
  vs_child_been_fc_mnths_more;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_redet_criteria_info;
              
DROP TABLE Temp_worksheet_redet_criteria_info;

   END
    $function$

