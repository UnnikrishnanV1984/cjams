CREATE OR REPLACE FUNCTION as_getinvestigationformlist(v_intakeserviceid uuid, pagenumber bigint, pagesize bigint, v_intakenumber character varying)
 RETURNS TABLE(totalcount bigint, investigationformid uuid, intakeserviceid uuid, intakenumber character varying, investigationname character varying, investigationdate timestamp without time zone, notes text, recommendation text, statustypekey character varying, statusdescription character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_pageoffset int;
 v_pagenumber int;
DECLARE 
 totalcount integer;
BEGIN
    v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
  
RETURN query

SELECT COUNT(1)OVER(), IGF.investigationformid, IGF.intakeserviceid, IGF.intakenumber, IGF.investigationname,
IGF.investigationdate, IGF.notes, IGF.recommendation, IGF.statustypekey, rfv.description
 
FROM investigationform as IGF
Join referencetype rt on rt.tablename = 'investigationformstatus' 
Join referencevalues rfv on 
     rfv.ref_key = IGF.statustypekey and rfv.activeflag = 1 and rt.referencetypeid = rfv.referencetypeid
WHERE (IGF.intakeserviceid= v_intakeserviceid OR IGF.intakenumber = v_intakenumber) AND IGF.activeflag=1

LIMIT pagesize OFFSET v_pageoffset;
END;

$function$

