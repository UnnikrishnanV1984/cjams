    ---Send notification    
    SELECT prov_send_notification into v_success
    FROM  prov_send_notification( v_providerid, v_fromsecurityuserid, v_providerid, 'System', 'High',  v_subject, v_body, v_notification_objectid,  false, false, v_objecttype, v_providerid);
    
    select json_agg(a) into v_tousers4 from ( 
    SELECT distinct tpu.securityusers_id as toworkeridno 
    , up.email as email
            from tb_provider_userconfig tpu 
            inner join muser mu on mu.securityusersid = tpu.securityusers_id::character varying and mu.activeflag = 1
            inner join userprofile up on up.securityusersid::character varying  = tpu.securityusers_id ::character varying and up.activeflag =1
            inner join rolemapping r on r.principalid = mu.id and r.activeflag = 1 and r.roleid =2455
            inner join role ro on ro.id = r.roleid and ro.activeflag = 1
            where tpu.provider_id = v_providerid
                and tpu.activeflag = 1 
    )a;
    select json_agg(a) into v_tousers5 from ( 
        select m.email as email
        from tb_provider t
        cross join lateral (values (t.adr_email_tx), (t.ref_email_tx), (t.adm_email_tx))   as m(email) 
            where provider_id = v_providerid
    )a;

    select json_agg(a) into v_tousers6 from ( 
        select staff_email  as email
        from providerstaff p 
        where employee_type ='Program Administrator' 
        and delete_sw = 'N' and object_id = v_providerid
    )a;

