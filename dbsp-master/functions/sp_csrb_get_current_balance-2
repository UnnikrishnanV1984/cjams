CREATE OR REPLACE FUNCTION sp_csrb_get_current_balance(al_placement_id bigint, ad_placement_validation_start timestamp without time zone, as_csrfc_rate_type_cd character varying, as_csrfcd_rate_type_cd character varying, al_rate_structure_id bigint, OUT al_linked_pymnt_hdr_id bigint, OUT al_reference_payment_detail_id bigint, OUT adc_csrfc_current_balance numeric, OUT adc_csrfcd_current_balance numeric, OUT al_sqlcode integer, OUT as_error character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- 07/24/2007 Vineet Tirodkar
-- Returns Current Balances paid (Paid - Received) 
-- for the month under Room & Board/Clothing and Room & Board/Clothing/Differential 
-- Also returns reference Payment ID and Payment Detail ID 
-- Arguments INPUT Placement ID 
--            Placement Validation Start DT 
--            RFC Rate Type
--            County Specific RFCD Rate Type
--            Rate Structure ID
--            
--     OUTPUT Ref Payment ID
--     Ref Payment Detail
--      Current Balance for RFC
--     Current Balance for County Specific RFCD
--     SQL code 
--                 Error Text 
------------------------------------------------------------------------

DECLARE vdc_csrfc_total_amt_paid DECIMAL(10,2);--
DECLARE vdc_csrfc_total_amt_received DECIMAL(10,2);--
DECLARE vs_csrfc_rate_type_tx VARCHAR(150);--

DECLARE vdc_csrfcd_total_amt_paid DECIMAL(10,2);--
DECLARE vdc_csrfcd_total_amt_received DECIMAL(10,2);--
DECLARE vs_csrfcd_rate_type_tx VARCHAR(150);--

DECLARE vl_placement_structure_id BIGINT DEFAULT 0;--

DECLARE vl_sqlcode int default 0;--

DECLARE SQLCODE INT DEFAULT 0;--
DECLARE SQLSTATE CHAR(5) DEFAULT '00000';--
DECLARE vs_message_text VARCHAR(3000) DEFAULT '';--
DECLARE vs_Procedure_nm VARCHAR(100) DEFAULT 'SP_CSRB_GET_CURRENT_BALANCE';--

--DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
BEGIN
    --GET DIAGNOSTICS EXCEPTION 1 vs_message_text = MESSAGE_TEXT;--
     vl_sqlcode := -1 ;--
     as_error := COALESCE(as_error ,'') || TO_CHAR(CURRENT_TIMESTAMP) ||'::' || vs_Procedure_nm || '.' ;--
     as_error := COALESCE(as_error ,'') || '::RO ' || 'Placement id' || ' :: ' || COALESCE(to_char(al_placement_id),'');--
     as_error := as_error || COALESCE(vs_message_text ,'');--


--Reset Variables
 vdc_csrfc_total_amt_paid := 0;--
 vdc_csrfc_total_amt_received := 0;--
 adc_csrfc_current_balance  := 0;--
 vs_csrfc_rate_type_tx := '';--

 vdc_csrfcd_total_amt_paid := 0;--
 vdc_csrfcd_total_amt_received := 0;--
 adc_csrfcd_current_balance  := 0;--
 vs_csrfcd_rate_type_tx := '';--

-- Get value for RATE_TYPE_CD   
  SELECT VALUE_TX
    INTO vs_csrfc_rate_type_tx 
   FROM tb_PICKLIST_VALUES
  WHERE PICKLIST_TYPE_ID = 82 
   AND PICKLIST_VALUE_CD = as_csrfc_rate_type_cd ;--
   
   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
      as_error := 'Error in getting CSRFC Rate Type Value Tx';--
  END IF ; --
  
  SELECT VALUE_TX
    INTO vs_csrfcd_rate_type_tx 
     FROM tb_PICKLIST_VALUES
  WHERE PICKLIST_TYPE_ID = 82 
   AND PICKLIST_VALUE_CD = as_csrfcd_rate_type_cd ;--
     
   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
      as_error := 'Error in getting CSRFCD Rate Type Value Tx';--
  END IF ; --
  

-- Get Placement Structure ID from tb_PLACEMENT
  SELECT PLACEMENT_STRUCTURE_ID
     INTO vl_placement_structure_id
    FROM tb_PLACEMENT
  WHERE PLACEMENT_ID = al_placement_id;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
      as_error := 'Error in getting Placement Structure ID from tb_PLACEMENT';--
  END IF ; --


-- Get Total Payments    
  IF vl_placement_structure_id = 13 THEN -- Emergency Foster Home Care and Room & Board
    -- RFC
    SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
 INTO vdc_csrfc_total_amt_paid
     FROM tb_PAYMENT_HEADER PH,
     tb_PAYMENT_DETAIL PD,
   tb_PAYMENT_STATUS PS
    WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
 AND PH.PAYMENT_ID = PS.PAYMENT_ID 
 AND PH.DELETE_SW = 'N'
 AND PD.DELETE_SW = 'N'
 AND PH.MANUAL_SW= 'N'
 AND PS.DELETE_SW = 'N'
 AND PS.PAYMENT_STATUS_CD <> '1639'
 AND PD.PLACEMENT_ID = al_placement_id
 AND PH.PAYMENT_TYPE_CD in ('6','3294')
 AND PD.FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
 AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
 AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start)
 AND PD.FINAL_SERVICE_ID = al_rate_structure_id ;--

     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Payments of type ' || vs_csrfc_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
    END IF ;  --
   
   
    -- RFCD
    SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
 INTO vdc_csrfcd_total_amt_paid
     FROM tb_PAYMENT_HEADER PH,
     tb_PAYMENT_DETAIL PD,
   tb_PAYMENT_STATUS PS
    WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
 AND PH.PAYMENT_ID = PS.PAYMENT_ID 
 AND PH.DELETE_SW = 'N'
 AND PD.DELETE_SW = 'N'
 AND PH.MANUAL_SW= 'N'
 AND PS.DELETE_SW = 'N'
 AND PS.PAYMENT_STATUS_CD <> '1639'
 AND PD.PLACEMENT_ID = al_placement_id
 AND PH.PAYMENT_TYPE_CD in ('6','3294')
 AND PD.FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd
 AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
 AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start)
 AND PD.FINAL_SERVICE_ID = al_rate_structure_id ;--

     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Payments of type ' || vs_csrfcd_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
    END IF ;  --
   
  ELSE
    -- RFC
    SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
       INTO vdc_csrfc_total_amt_paid
      FROM tb_PAYMENT_HEADER PH,
           tb_PAYMENT_DETAIL PD,
           tb_PAYMENT_STATUS PS
    WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
        AND PH.PAYMENT_ID = PS.PAYMENT_ID 
        AND PH.DELETE_SW = 'N'
        AND PD.DELETE_SW = 'N'
        AND PH.MANUAL_SW= 'N'
        AND PS.DELETE_SW = 'N'
        AND PS.PAYMENT_STATUS_CD <> '1639'
        AND PD.PLACEMENT_ID = al_placement_id
        AND PH.PAYMENT_TYPE_CD in ('6','3294')
        AND PD.FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
        AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
        AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start) ;--

     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Payments of type ' || vs_csrfc_rate_type_tx ;--
    END IF ;--
   
    -- RFCD
    SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
         INTO vdc_csrfcd_total_amt_paid
     FROM tb_PAYMENT_HEADER PH,
          tb_PAYMENT_DETAIL PD,
          tb_PAYMENT_STATUS PS
    WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
        AND PH.PAYMENT_ID = PS.PAYMENT_ID 
        AND PH.DELETE_SW = 'N'
        AND PD.DELETE_SW = 'N'
        AND PH.MANUAL_SW= 'N'
        AND PS.DELETE_SW = 'N'
        AND PS.PAYMENT_STATUS_CD <> '1639'
        AND PD.PLACEMENT_ID = al_placement_id
        AND PH.PAYMENT_TYPE_CD in ('6','3294')
        AND PD.FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd
        AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
        AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start) ;--

     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Payments of type ' || vs_csrfcd_rate_type_tx ;--
    END IF ;   --
  END IF;--

  IF vdc_csrfc_total_amt_paid is NULL THEN
     vdc_csrfc_total_amt_paid := 0;--
  END IF;--
  
  IF vdc_csrfcd_total_amt_paid is NULL THEN
     vdc_csrfcd_total_amt_paid := 0;--
  END IF;--

-- Get Total Receipts
  IF vl_placement_structure_id = 13 THEN -- Emergency Foster Home Care and Room & Board
    -- RFC
    SELECT SUM(COALESCE(AMOUNT_NO,0))
       INTO vdc_csrfc_total_amt_received
      FROM tb_RECEIVABLE_DETAIL
    WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
       FROM tb_PAYMENT_HEADER PH,
     tb_PAYMENT_DETAIL PD,
     tb_PAYMENT_STATUS PS
    WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
          AND PH.PAYMENT_ID = PS.PAYMENT_ID 
          AND PH.DELETE_SW = 'N'
          AND PD.DELETE_SW = 'N'
          AND PH.MANUAL_SW= 'N'
          AND PS.DELETE_SW = 'N'
          AND PS.PAYMENT_STATUS_CD <> '1639'
          AND PD.PLACEMENT_ID = al_placement_id
          AND PH.PAYMENT_TYPE_CD in ('6','3294')
          AND PD.FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
          AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
          AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start)
          AND PD.FINAL_SERVICE_ID = al_rate_structure_id )
   AND DELETE_SW = 'N' ;--

     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Receipts of Type '|| vs_csrfc_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
    END IF ;--
    
    -- RFCD
    SELECT SUM(COALESCE(AMOUNT_NO,0))
           INTO vdc_csrfcd_total_amt_received
          FROM tb_RECEIVABLE_DETAIL
        WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
           FROM tb_PAYMENT_HEADER PH,
         tb_PAYMENT_DETAIL PD,
         tb_PAYMENT_STATUS PS
        WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
              AND PH.PAYMENT_ID = PS.PAYMENT_ID 
              AND PH.DELETE_SW = 'N'
              AND PD.DELETE_SW = 'N'
              AND PH.MANUAL_SW= 'N'
              AND PS.DELETE_SW = 'N'
              AND PS.PAYMENT_STATUS_CD <> '1639'
              AND PD.PLACEMENT_ID = al_placement_id
              AND PH.PAYMENT_TYPE_CD in ('6','3294')
              AND PD.FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd
              AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
              AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start)
              AND PD.FINAL_SERVICE_ID = al_rate_structure_id )
       AND DELETE_SW = 'N' ;--
    
     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Receipts of Type '|| vs_csrfcd_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
    END IF ;--

  ELSE
    -- RFC
    SELECT SUM(COALESCE(AMOUNT_NO,0))
       INTO vdc_csrfc_total_amt_received
      FROM tb_RECEIVABLE_DETAIL
    WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
       FROM tb_PAYMENT_HEADER PH,
     tb_PAYMENT_DETAIL PD,
     tb_PAYMENT_STATUS PS
    WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
          AND PH.PAYMENT_ID = PS.PAYMENT_ID 
          AND PH.DELETE_SW = 'N'
          AND PD.DELETE_SW = 'N'
          AND PH.MANUAL_SW= 'N'
          AND PS.DELETE_SW = 'N'
          AND PS.PAYMENT_STATUS_CD <> '1639'
          AND PD.PLACEMENT_ID = al_placement_id
          AND PH.PAYMENT_TYPE_CD in ('6','3294')
          AND PD.FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
          AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
          AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start) )
   AND DELETE_SW = 'N' ;--



     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Receipts of Type '|| vs_csrfc_rate_type_tx ;--
    END IF ;--
    
    --RFCD
    SELECT SUM(COALESCE(AMOUNT_NO,0))
           INTO vdc_csrfcd_total_amt_received
          FROM tb_RECEIVABLE_DETAIL
        WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
           FROM tb_PAYMENT_HEADER PH,
         tb_PAYMENT_DETAIL PD,
         tb_PAYMENT_STATUS PS
        WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
              AND PH.PAYMENT_ID = PS.PAYMENT_ID 
              AND PH.DELETE_SW = 'N'
              AND PD.DELETE_SW = 'N'
              AND PH.MANUAL_SW= 'N'
              AND PS.DELETE_SW = 'N'
              AND PS.PAYMENT_STATUS_CD <> '1639'
              AND PD.PLACEMENT_ID = al_placement_id
              AND PH.PAYMENT_TYPE_CD in ('6','3294')
              AND PD.FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd
              AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
              AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start) )
       AND DELETE_SW = 'N' ;--
    
    
    
     al_sqlcode := SQLCODE;--
    IF al_sqlcode < 0  THEN
        as_error := 'Error in getting Receipts of Type '|| vs_csrfcd_rate_type_tx ;--
    END IF ;--
  END IF;--


  IF vdc_csrfc_total_amt_received is NULL THEN
     vdc_csrfc_total_amt_received := 0;--
  END IF;--
  
  IF vdc_csrfcd_total_amt_received is NULL THEN
     vdc_csrfcd_total_amt_received := 0;--
  END IF;--

-- Set Current Balance
 adc_csrfc_current_balance := vdc_csrfc_total_amt_paid - vdc_csrfc_total_amt_received;--
 adc_csrfcd_current_balance := vdc_csrfcd_total_amt_paid - vdc_csrfcd_total_amt_received;--

-- Get Original Payment ID - START
-- First look for payment type '6' Maintenance if not found '3294' Adjustments

 al_linked_pymnt_hdr_id := 0; -- INITIAL VALE

SELECT MAX(PH.PAYMENT_ID)
 INTO al_linked_pymnt_hdr_id
   FROM tb_PAYMENT_HEADER PH,
 tb_PAYMENT_DETAIL PD
  WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
 AND PH.DELETE_SW = 'N'
 AND PD.DELETE_SW = 'N'
 AND PH.MANUAL_SW= 'N'
 AND PD.PLACEMENT_ID = al_placement_id
 AND PH.PAYMENT_TYPE_CD = '6'
 AND ( PD.FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
  OR PD.FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd )
 AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
 AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start) ;--

 al_sqlcode := SQLCODE;--
IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original Maintenance Payment ID';--
END IF ;--

IF al_linked_pymnt_hdr_id is NULL THEN
    al_linked_pymnt_hdr_id := 0;--
END IF;--

IF al_linked_pymnt_hdr_id = 0 THEN
  SELECT MAX(PH.PAYMENT_ID)
 INTO al_linked_pymnt_hdr_id
   FROM tb_PAYMENT_HEADER PH,
 tb_PAYMENT_DETAIL PD
  WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
 AND PH.DELETE_SW = 'N'
 AND PD.DELETE_SW = 'N'
 AND PH.MANUAL_SW= 'N'
 AND PD.PLACEMENT_ID = al_placement_id
 AND PH.PAYMENT_TYPE_CD = '3294'
 AND ( PD.FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
  OR PD.FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd )
 AND MONTH(PD.FINAL_SERVICE_START_DT) = MONTH(ad_placement_validation_start)
 AND YEAR(PD.FINAL_SERVICE_START_DT) = YEAR(ad_placement_validation_start) ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
      as_error := 'Error in getting Original Adjustment Payment ID';--
  END IF ;--
END IF;--

IF al_linked_pymnt_hdr_id is NULL THEN
    al_linked_pymnt_hdr_id := 0;--
END IF;--
--Get Original Payment ID - END


--Get Max Payment Detail ID of Original Payment - START
 al_reference_payment_detail_id := 0; -- INITIAL VALE

IF al_linked_pymnt_hdr_id > 0 THEN
   IF vl_placement_structure_id = 13 THEN -- Emergency Foster Home Care and Room & Board
   
      SELECT MAX(PAYMENT_DETAIL_ID)
    INTO al_reference_payment_detail_id
        FROM tb_PAYMENT_DETAIL
      WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
    AND PLACEMENT_ID = al_placement_id
  AND FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd
  AND FINAL_SERVICE_ID = al_rate_structure_id
  AND DELETE_SW = 'N';--

       al_sqlcode := SQLCODE;--
      IF al_sqlcode < 0  THEN
          as_error := 'Error in getting Original Payment Detl ID '|| vs_csrfcd_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
      END IF ;--

      IF al_reference_payment_detail_id is NULL OR al_reference_payment_detail_id = 0 THEN
    
         SELECT MAX(PAYMENT_DETAIL_ID)
       INTO al_reference_payment_detail_id
      FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
        AND PLACEMENT_ID = al_placement_id
        AND FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
        AND FINAL_SERVICE_ID = al_rate_structure_id
        AND DELETE_SW = 'N';--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
      as_error := 'Error in getting Original Payment Detl ID '|| vs_csrfc_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
  END IF ;--
      END IF;--

      IF al_reference_payment_detail_id is NULL OR al_reference_payment_detail_id = 0 THEN
       
         SELECT MAX(PAYMENT_DETAIL_ID)
             INTO al_reference_payment_detail_id
     FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
        AND PLACEMENT_ID = al_placement_id
        AND ( FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
        OR FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd )
        AND FINAL_SERVICE_ID IS NOT NULL
        AND DELETE_SW = 'N';--
 
   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
      as_error := 'Error in getting Original Payment Detl ID';--
  END IF ;--
      END IF;--

   ELSE
     SELECT MAX(PAYMENT_DETAIL_ID)
 INTO al_reference_payment_detail_id
       FROM tb_PAYMENT_DETAIL
     WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
  AND PLACEMENT_ID = al_placement_id
  AND FINAL_RATE_TYPE_CD = as_csrfcd_rate_type_cd
  AND FINAL_SERVICE_ID IS NOT NULL
  AND DELETE_SW = 'N';--

      al_sqlcode := SQLCODE;--
     IF al_sqlcode < 0  THEN
         as_error := 'Error in getting Original Payment Detl ID '|| vs_csrfcd_rate_type_tx ;--
     END IF ;--
     
     IF al_reference_payment_detail_id is NULL OR al_reference_payment_detail_id = 0 THEN
     
       SELECT MAX(PAYMENT_DETAIL_ID)
   INTO al_reference_payment_detail_id
         FROM tb_PAYMENT_DETAIL
       WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
    AND PLACEMENT_ID = al_placement_id
    AND FINAL_RATE_TYPE_CD = as_csrfc_rate_type_cd
    AND FINAL_SERVICE_ID IS NOT NULL
    AND DELETE_SW = 'N';--

        al_sqlcode := SQLCODE;--
       IF al_sqlcode < 0  THEN
           as_error := 'Error in getting Original Payment Detl ID '|| vs_csrfc_rate_type_tx ;--
       END IF;--
     END IF;--
   END IF;--
END IF;--
-- Get Max Payment Detail ID of Original Payment - END

 al_sqlcode := vl_sqlcode;--

END;
$function$

