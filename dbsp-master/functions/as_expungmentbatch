CREATE OR REPLACE FUNCTION as_expungmentbatch()
 RETURNS void
 LANGUAGE plpgsql
AS $function$


declare 
 v_finalfinding  character varying ;
 v_investigationallegationid character varying ;
 v_oahearingdecision character varying ;
 v_allrows record ;
begin
for v_allrows in select  ig.finalfinding , ig.investigationallegationid ,imt.oahearingdecision 
  from investigationfinding ig join investigationallegationmaltreators imt 
   on ig.investigationallegationid = imt.investigationallegationid
 --into  v_finalfinding , v_investigationallegationid 
---RAISE  NOTICE  'v_finalfinding  %',v_finalfinding;
--RAISE  NOTICE  'v_investigationallegationid  %',v_investigationallegationid;
--RAISE  NOTICE  'v_oahearingdecision  %',v_oahearingdecision;
loop
 
-- exit when not found;
 
 if  (v_allrows.finalfinding = lower('RO') ) then 
  
  update Investigationallegationmaltreators set expungementflag=1 
     where  investigationallegationid = v_allrows.investigationallegationid ;
    
  elseif (v_allrows.finalfinding is null  ) and (v_allrows.oahearingdecision = lower('RO')) then 
  
     update Investigationallegationmaltreators set expungementflag=1 
     where  investigationallegationid = v_allrows.investigationallegationid ;
 end if ;   
end loop ;
end;

$function$

