CREATE OR REPLACE FUNCTION as_listdsdsactioninpersonpopupdata(v_personid uuid, v_intakeserviceid uuid, v_userid character varying)
 RETURNS TABLE(intakeserviceid uuid, danumber character varying, dasubtype character varying, firstname character varying, lastname character varying, role character varying, roletypekey character varying, datereceived timestamp without time zone, datecreated timestamp without time zone, datecompleted timestamp without time zone, status character varying, datype character varying, county character varying, restrictstatus text)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                                                          
 BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                    
 RETURN QUERY                                                                                                                                                                                                                                                                                                                                                                                                             
 SELECT * FROM (                                                                                                                                                                                                                                                                                                                                                                                                                              
 select distinct                                                                                                                                                                                                                                                                                                                                                                                                          
 ISR.IntakeServiceId,                                                                                                                                                                                                                                                                                                                                                                                                     
 ISR.ServiceRequestNumber as DANumber,                                                                                                                                                                                                                                                                                                                                                                                    
 SRST.description as dasubtype,                                                                                                                                                                                                                                                                                                                                                                                           
 PRS.FirstName,                                                                                                                                                                                                                                                                                                                                                                                                           
 PRS.LastName,                                                                                                                                                                                                                                                                                                                                                                                                            
 AT.typedescription as Role,                                                                                                                                                                                                                                                                                                                                                                                              
 AT.actortype as roletypekey,                                                                                                                                                                                                                                                                                                                                                                                             
 ISR.Reporteddate as DateReceived,                                                                                                                                                                                                                                                                                                                                                                                        
 ISR.Insertedon as DateCreated,                                                                                                                                                                                                                                                                                                                                                                                           
 case when ISRST.intakeserreqstatustypekey = 'Closed' then ATMSR.updatedon else null end AS DateCompleted,                                                                                                                                                                                                                                                                                                                
 ISRST.intakeserreqstatustypekey AS Status,                                                                                                                                                                                                                                                                                                                                                                               
 ISRT.description as datype                                                                                                                                                                                                                                                                                                                                                                                               
 , (select upa.county from as_teammemberassignment tma join userprofileaddress upa on upa.securityusersid = tma.securityusersid                                                                                                                                                                                                                                                                                              
 where upa.activeflag = 1 and tma.activeflag = 1 and upa.county is not null and tma.teammemberid = atmsr.teammemberid limit 1) as county,                                                                                                                                                                                                                                                                                  
 --, upa.county   
 (SELECT * FROM getRestrictedCaseStatus(ISR.intakeserviceid::text,v_userid)) AS restrictStatus                                                                                                                                                                                                                                                                                                                                                                                                         
  from IntakeServiceRequest ISR join                                                                                                                                                                                                                                                                                                                                                                                      
 IntakeSerReqStatusType ISRST ON ISR.IntakeSerReqStatusTypeId = ISRST.IntakeSerReqStatusTypeId                                                                                                                                                                                                                                                                                                                            
 LEFT JOIN IntakeServiceRequestInputType ISRIT on ISRIT.IntakeServReqInputTypeId = ISR.IntakeSerReqStatusTypeId                                                                                                                                                                                                                                                                                                           
 LEFT JOIN  IntakeServiceRequestType ISRT ON ISRT.IntakeServReqTypeId = ISR.IntakeServReqTypeId                                                                                                                                                                                                                                                                                                                           
 LEFT JOIN  Priority PR ON PR.PriorityId = ISR.PriorityId                                                                                                                                                                                                                                                                                                                                                                 
 LEFT JOIN  ServiceRequestSubType SRST ON SRST.ServiceRequestSubTypeId = ISR.IntakeServiceRequestClassId                                                                                                                                                                                                                                                                                                                  
 LEFT JOIN  IntakeServiceRequestActor ISRA ON ISRA.IntakeServiceId = ISR.IntakeServiceId                                                                                                                                                                                                                                                                                                                                  
 --LEFT JOIN  ActorType AT ON AT.actortype = ISRA.intakeservicerequestpersontypekey                                                                                                                                                                                                                                                                                                                                         
 LEFT JOIN  Actor AC ON ISRA.ActorId = AC.ActorId                                                                                                                                                                                                                                                                                                                                                                         
 LEFT JOIN  Person PRS ON AC.PersonId = PRS.PersonId                                                                                                                                                                                                                                                                                                                                                                      
 --LEFT JOIN  PersonAddress PRA ON PRS.PersonId = PRA.PersonId                                                                                                                                                                                                                                                                                                                                                              
 LEFT JOIN  IntakeServiceRequestClearingData ISRCD ON ISRCD.IntakeServiceId = ISR.IntakeServiceId                                                                                                                                                                                                                                                                                                                         
 LEFT JOIN  AreaTeamMemberServiceRequest ATMSR ON ATMSR.IntakeServiceId = ISR.IntakeServiceId                                                                                                                                                                                                                                                                                                                             
 --Left join as_teammemberassignment tma on tma.teammemberid = atmsr.teammemberid                                                                                                                                                                                                                                                                                                                                            
 --join userprofileaddress upa on upa.securityusersid = tma.securityusersid                                                                                                                                                                                                                                                                                                                                               
 where PRS.PersonId = v_personid                                                                                                                                                                                                                                                                                                                                                                                          
 AND ISR.IntakeServiceId <> v_intakeserviceid
 )  AS datav 
       WHERE datav.restrictStatus IN('INCL','INCLRES') ; 
 END;                                                                                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                                                                                          
 $function$

