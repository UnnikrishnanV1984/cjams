CREATE OR REPLACE FUNCTION as_validtransporatationicj(v_intakenumber character varying, subserivicetypevalue character varying, istransportmandatory boolean DEFAULT true, isassessmentgenmandatory boolean DEFAULT true)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
v_count  bigint;
returnstatus text;
assesment_count bigint;
transportation_count bigint;
persontransportation_count bigint;
privatetransportation_count bigint;
transportationkey character varying;

BEGIN

returnstatus:='Success';

if (istransportmandatory = true) then
  select count(*) into v_count
  from persontransportation  pt 
  left  join routing rt on (pt.persontransportationid::character varying) = rt.objectid
  and pt.activeflag=1 and rt.activeflag=1
  WHERE  rt.routingstatustypeid = 79
  and pt.intakenumber=v_intakenumber;

  select distinct transportationtypekey into transportationkey from persontransportation  pt where pt.activeflag=1 and pt.intakenumber=v_intakenumber;

  select count(*) into persontransportation_count from persontransportation  pt where pt.activeflag=1 and pt.intakenumber=v_intakenumber;

  select count(*) into privatetransportation_count from privatetransportation  pt where pt.activeflag=1 and pt.intakenumber=v_intakenumber;

  transportation_count:=persontransportation_count+privatetransportation_count;

end if;

if (isassessmentgenmandatory = true) then
  select count(*) into assesment_count from assessment where intakenumber=v_intakenumber and documentpath is not  null;
end if;

if(subserivicetypevalue != 'ICJ Sending requisition due to warrant') then

returnstatus:='Success';

elsif (istransportmandatory = true and transportation_count = 0) then

returnstatus:='Transportation is not available';

elsif  (persontransportation_count>0 and v_count = 0 and transportationkey ='DJSTN') then

returnstatus:='Person Transportation is not approved';

elsif (isassessmentgenmandatory = true and assesment_count = 0) then

returnstatus:='assessment is not generated';

end if;

return returnstatus;

END

$function$

