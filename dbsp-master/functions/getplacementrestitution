CREATE OR REPLACE FUNCTION getplacementrestitution(v_personid uuid, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(residentialexists boolean, placementdetails json)
 LANGUAGE plpgsql
AS $function$


--------residential status flag and placement details--------------

begin


return query
select getresidentialstatus.residentialexists,(
(case when 
(select getresidentialstatus.residentialexists from getresidentialstatus(v_personid) ) is true 
then ( select row_to_json(row)
from (
    select *  from  getplacementsummary(v_personid,1,1,'open','')
) row ) else null end)) as placementdetails 
from getresidentialstatus(v_personid);

 
end;

$function$

