CREATE OR REPLACE FUNCTION deletelegalcustody(v_legalcustodyid character varying, v_userid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_message character varying;
    
BEGIN

 UPDATE legalcustody
 SET activeflag = 0, updatedon = now(), updatedby = v_userid
 WHERE 
 legalcustodyid::CHARACTER VARYING = v_legalcustodyid AND activeflag = 1;

 v_message:= 'Success';

    return v_message;
END  
$function$

