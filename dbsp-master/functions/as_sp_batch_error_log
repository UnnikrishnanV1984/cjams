CREATE OR REPLACE FUNCTION as_sp_batch_error_log(as_sp_nm character varying, vl_batch_log_id bigint, vl_batch_sp_log_id bigint, vs_batch_no character varying, vl_err_line_no integer, vs_err_cd character varying, vl_err_sqlcode integer, vs_err_desc_tx character varying, vs_create_user_id character varying, OUT vl_return_status integer)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE 
 declare vl_output_sqlcode INTEGER DEFAULT 0;
    declare SQLSTATE INTEGER;
 declare var_next_error_id INTEGER;
BEGIN

   BEGIN
        vl_output_sqlcode := SQLSTATE;
   END;
  
  
   
INSERT INTO tb_BATCH_ERROR_LOG (   ERROR_ID,
           BATCH_LOG_ID,
           BATCH_SP_LOG_ID,
           PROGRAM_NM ,
           BATCH_NO,
           ERR_LINE_NO,
           ERR_CD,
           ERR_SQLCODE,
           ERR_DESC_TX,
           CREATE_USER_ID,
           CREATE_TS 
          )
        VALUES (    (select CASE WHEN max(error_id) IS NULL THEN 1 ELSE max(error_id)+1 END from tb_BATCH_ERROR_LOG),
           vl_batch_log_id,
           vl_batch_sp_log_id,
           as_sp_nm,
           vs_batch_no,
           vl_err_line_no,
           vs_err_cd,
           vl_err_sqlcode,
           vs_err_desc_tx,
           vs_create_user_id,
           CURRENT_TIMESTAMP
          );

   IF vl_output_sqlcode <> 0 THEN
       vl_return_status := 1; 
   
   ELSE
    vl_return_status := 0; 
   
   END IF;

END;

$function$

