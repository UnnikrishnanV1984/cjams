CREATE OR REPLACE FUNCTION getproviderapplicant(v_securityusersid uuid, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, provider_id integer, applicant_id character varying, program_type character varying, program_name character varying, mailing_address character varying, prgram character varying, contact_phonenumber character varying, contact_fax character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 

                           
 v_pagenumber int;
 v_pageoffset int;
 
BEGIN 


v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;



 return query
  
 select count(1) over() as totalcount,p.provider_id,pa.applicant_id,pa.program_type,pa.program_name,pa.mailing_address,pa.prgram,pa.contact_phonenumber,pa.contact_fax  from tb_provider p
    join tb_provider_applicant pa on pa.provider_id::int=p.provider_id 
    join tb_provider_userconfig pu on pu.applicant_id=pa.applicant_id and pu.provider_id=pa.provider_id::int
    where pu.securityusers_id=v_securityusersid
 LIMIT v_liPageSize OFFSET v_pageoffset;      



END;

$function$

