CREATE OR REPLACE FUNCTION as_sp_batch_threshold_monitor_temp()
 RETURNS TABLE(as_status text, as_subject_text text)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 --Standard Exception/Warning/error variables.
 DECLARE SQLCODE     INT  DEFAULT 0;
 DECLARE SQLSTATE     CHAR(5) DEFAULT '00000';
 --DECLARE p_sp_error CONDITION  FOR  SQLSTATE '99999' ;
 declare p_sp_error CHAR(5);
 DECLARE vs_message_text   VARCHAR(3000) DEFAULT '';
 DECLARE vl_ret_status    INTEGER DEFAULT 0;
 DECLARE vs_Procedure_nm   VARCHAR(100) DEFAULT 'SP_BATCH_THRESHOLD_MONITOR'; 
 DECLARE al_sqlcode    INT DEFAULT 0;
 DECLARE as_error     VARCHAR(3000) DEFAULT '';

 
 -- SP specific variables.
 DECLARE vl_batch_id    Integer DEFAULT 0;
 DECLARE vs_batch_nm    VARCHAR(50);
 DECLARE vs_didnotrun_matter  VARCHAR(5000) DEFAULT '';
 DECLARE vs_critical_matter  VARCHAR(5000) DEFAULT '';
 DECLARE vs_warning_matter  VARCHAR(5000) DEFAULT '';
 DECLARE vs_subject_text   VARCHAR(500) DEFAULT '';
 DECLARE vs_ampm     VARCHAR(2);
 DECLARE vs_current_ampm   VARCHAR(2);
 DECLARE vs_err_tx    VARCHAR(500);
 DECLARE vl_err_count   Integer DEFAULT 0;
 DECLARE vd_batch_dt    DATE;
 DECLARE vd_current_dt   DATE;
 DECLARE vd_prev_dt    DATE;
 DECLARE vdt_start_ts   TIMESTAMP;
 DECLARE vdt_end_ts    TIMESTAMP;
 DECLARE vs_img_instructions  VARCHAR(2000) DEFAULT '';
 DECLARE vl_day     Integer DEFAULT 0;
 DECLARE vs_day_name    VARCHAR(10);

BEGIN
 
   BEGIN
   EXCEPTION WHEN OTHERS THEN                  
                     
                      al_sqlcode := SQLSTATE;          
                      vs_message_text :=SQLERRM;
                      as_error := 'Error in getting BATCH_LOG_ID for BATCH_NM: ' || RTRIM(as_batch_nm);
                      as_error := COALESCE(as_error ,'') || CAST(CURRENT_TIMESTAMP AS VARCHAR) ||'::' || vs_Procedure_nm || '.' ;
                      as_error := COALESCE(as_error ,'') || '::RO Batch Master id ::' || CAST(COALESCE(vl_batch_master_id,0) as VARCHAR) ;
                      as_error := COALESCE(as_error ,'') || vs_message_text;         
                      SELECT SP_BATCH_ERROR_LOG (vs_Procedure_nm,vl_batch_log_id::bigint,NULL::bigint,NULL::character varying,NULL::integer,NULL::character varying,al_sqlcode::character varying,as_error::character varying,'Script'::character varying) into vl_ret_status;
                      
   END;--
   

   drop TABLE if exists tmp_threshold_data;
  --CREATE TEMPORARY TABLE if not exists tmp_threshold_data as ( select
   CREATE  table tmp_threshold_data as ( select
   batch_master_id batch_id, 
   batch_nm, 
   batch_desc_tx batch_desc, 
   scheduled_tm sch_time,
   case 
   when cast(substring(scheduled_tm,1,2) as Integer) >= 12 then 'PM' 
   else 'AM' 
   end sch_ampm,
   threshold_tm treshold_tm, 
   threshold_cutoff_tm treshold_cutoff_tm, 
   frequency frequency,  
   now() curr_time, 
   alert_cd sev_level, 
   cast(current_date as timestamp) start_ts,
   cast(current_date as timestamp) end_ts,
   RTRIM(COALESCE(HELP_FAILURE_TX,''))img_instructions
  From tb_batch_master where 1=2 );
  

 SELECT SUBSTRING(TO_CHAR(current_timestamp, 'yyyy-mm-dd hh12:mi:ss AM'),21,2),
       current_date ,
       current_date - INTERVAL '1' DAYS, 
       TO_CHAR(current_date :: DATE, 'dd') 
       INTO 
       vs_current_ampm,
       vd_current_dt,
       vd_prev_dt, vl_day;

     
