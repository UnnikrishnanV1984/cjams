CREATE OR REPLACE FUNCTION sp_payment_exeception(vs_payment_tx character varying, vl_payment_error_line_no bigint, vs_payment_error_description character varying, OUT vl_output_sqlcode integer, OUT vs_message character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$

   DECLARE      SQLCODE                         INTEGER         DEFAULT 0;--
   DECLARE      VS_USER_ID                     VARCHAR(10)     DEFAULT  'finance';
 BEGIN
--

        INSERT INTO tb_PAYMENT_ERROR_LOG(   PAYMENT_ERROR_LOG_ID,
                                         PAYMENT_TX,
                                         PAYMENT_ERROR_TS,
                                         PAYMENT_BATCH_NO,
                                         PAYMENT_ERROR_LINE_NO,
                                         PAYMENT_ERROR_CODE,
                                         PAYMENT_ERROR_SQL_CODE,
                                         PAYMENT_ERROR_DESCRIPTION,
                                                CREATE_TS,
                                         CREATE_USER_ID,
                                         UPDATE_TS,
                                         UPDATE_USER_ID,
                                         DELETE_SW)
 
     VALUES(     NEXTVAL('SQ_PAYMENT_ERROR_LOG'),
                          VS_PAYMENT_TX,
                          CURRENT_TIMESTAMP,
                          '',
                          VL_PAYMENT_ERROR_LINE_NO,
                          '',
                          0,
                          VS_PAYMENT_ERROR_DESCRIPTION,
                          CURRENT_TIMESTAMP,
                          VS_USER_ID,          
                          CURRENT_TIMESTAMP,
                          VS_USER_ID,
                          'N');--
       VL_OUTPUT_SQLCODE   :=   SQLCODE;--

 --return VL_OUTPUT_SQLCODE;     
END ;

$function$

