CREATE OR REPLACE FUNCTION as_getviolenceconf(p_intakenumber character varying, p_intakeserviceid uuid, i_secid character varying)
 RETURNS TABLE(youthpid character varying, persons text, officeworkername character varying, youthnamewithsuffix character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN

     RETURN QUERY 
  select distinct 
        cast(p.cjamspid as character varying) as youthpid,
        '',
        (select distinct cast(concat(lastname,',',' ',firstname) as character varying) from userprofile up where securityusersid = i_secid) as officeworkername,
            cast(concat(p.lastname,case when (p.suffix is null or p.suffix ='') then '' else concat(' ',p.suffix) end,', ',p.firstname) as 
character varying) as youthnamewithsuffix
  from intakeservicerequest isr  
  join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid and isra.intakeservicerequestpersontypekey = 'Youth' and  isra.activeflag = 1
  join actor a on a.actorid = isra.actorid and a.actortype = 'Youth' and a.activeflag =1
  join person p on p.personid = a.personid and p.activeflag = 1
  where isr.activeflag = 1 
  and (case when p_intakeserviceid is not null then isr.intakeserviceid = p_intakeserviceid else true end)
  --and (case when p_intakenumber is not null then isr.intakenumber = p_intakenumber else true end)
  union
        select 
              '',
             ida.jsondata ->> 'persons' as persons,
              (select distinct cast(concat(lastname,',',' ',firstname) as character varying) from userprofile up where securityusersid = i_secid) as officeworkername,
              ''
              from intakedastaging ida 
              left join placement pl on ida.intakenumber = pl.intakenumber and pl.activeflag=1
              left join provider pr on pl.providerid = pr.providerid and pr.activeflag =1
              left join county jc on jc.countyid = pl.county and jc.activeflag = 1
              where ida.intakenumber = p_intakenumber and ida.activeflag=1 limit 1;
  
END;
$function$

