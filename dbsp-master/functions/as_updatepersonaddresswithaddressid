CREATE OR REPLACE FUNCTION as_updatepersonaddresswithaddressid(v_personid uuid, v_addressid uuid, v_personaddresstypekey character varying, v_expirationdate timestamp without time zone)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE
   v_personaddressid  uuid;
BEGIN

         update personaddress set addressstatus=false,expirationdate=v_expirationdate where personid=v_personid and personaddresstypekey=v_personaddresstypekey;
          
         select personaddressid INTO v_personaddressid from personaddress where addressid=v_addressid and personid=v_personid order by insertedon desc;

  UPDATE personaddress SET addressstatus = false,expirationdate=v_expirationdate WHERE personaddressid = v_personaddressid;
 
      RETURN 'Success';
  
END

$function$

