from tb_public_provider_referral WHERE referral_id=v_referralId;
            

returnStatus:= 'Application created! #'||v_applicantId;
--*************************************************************
        end if;

ELSE
returnStatus:= 'Failure';

END IF;

RETURN returnStatus;
                                                      
END;

