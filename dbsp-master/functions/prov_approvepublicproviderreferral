--RAISE NOTICE '%','v_securityUserId';
--select replace(v_applicantId,'A','R') into v_inquiryid;
IF LENGTH(v_applicantId) > 1
THEN
        select applicant_id into v_appid_exists from tb_public_provider_applicant where applicant_id = v_applicantId;
        if length(v_appid_exists) > 1
        then
                returnStatus:= 'Application already exists! #'||v_applicantId;
        else
        --***********************************************************************

