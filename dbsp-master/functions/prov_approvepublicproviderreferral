CREATE OR REPLACE FUNCTION prov_approvepublicproviderreferral(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

declare

v_referralId text;
v_applicantId text;
v_inquiryid text;
returnStatus text;
v_securityuserid text;
