CREATE OR REPLACE FUNCTION sp_cares_inbound_txt(user_id character varying, OUT errstate1 character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$

------------------------------------------------------------------------
-- SQL Stored Procedure
--'C' stands for can be processed
--'E' stands for Error
--'F' stands for footer missing, when create error flat file one new line has to be inserted
------------------------------------------------------------------------

declare 
i integer;--
 j integer;--
 k integer;--
 m integer;--
 varrun_id integer;--
 roll integer;--
 cnt integer;--
 cnt2 integer;--
 cnt3 integer;--

 vl_error_line integer;--
 b_seq integer;--
 ts_seq integer;--
 hdr integer;--
 ftr integer;--
 vartxt_id integer;--
 vartxt_id1 integer;--
 first integer;--

 vartxt varchar(400);--
 b_ts varchar(50);--
 batchno varchar(5);--
 prev_bno1 varchar(5);--
 prev_bno2 varchar(5);--
 prevpbno varchar(5);--
 last_processed_bno integer;--
 last_processed_bno_tmp integer;--
 stmt varchar(400);--
 stmt1 varchar(400);--

 rec_type varchar(2);--
 trn_type varchar(5);--
 local_cnt1 integer;--
 local_cnt2 integer;--

 errmes varchar(2000);--
 errcd integer;--
 errstate varchar(3);--

DECLARE c2 refcursor;--
DECLARE c3 refcursor;--
DECLARE c1 cursor  for

select ts,bno from(select distinct (substring(text,4,22)) as ts,substring(text,30,5) as bno from caresinboundtxt where (status = 'N' OR insertedon::date=current_date))as temp order by ts;--

BEGIN
VL_OUTPUT_SQLCODE := '00000';
select count(*) into cnt from(select distinct (substring(text,4,22)) as ts,substring(text,30,5) as bno from caresinboundtxt where (status = 'N' OR insertedon::date=current_date))as temp;--

open c1;--
 i:=1;--
 local_cnt1:=1;--
 local_cnt2:=1;--
 roll:=0;--
 first :=0;--
<<outer_loop>>
while i<=cnt loop
      fetch c1 into b_ts,batchno;--

      --BEING CHECKED WHETHER BATCH NO IS IN NEXT SEQUENCE OR NOT--

      if batchno::integer >0 and batchno::integer<50000 then
         select max(batchnumber::integer) into last_processed_bno from interfacesruntimeslog where batchnumber::integer>0 and batchnumber::integer<50000
            and interfaceid='CARES_OUTBOUND' and successful_sw='P';--
         if local_cnt1 > 1 then
              last_processed_bno :=prev_bno1::integer;--
         end if;--  
         if (batchno::integer!=last_processed_bno) OR (last_processed_bno is null)then
                update caresinboundtxt set status = 'E',text='104'||substring(text,4,length(text)-3)
                where substring(text,30,5)=batchno  AND (status= 'N' OR insertedon::date=current_date);--
                 roll :=2;--
                exit outer_loop;--
         else
                update interfacesruntimeslog set successful_sw='S' where batchnumber::integer=(select max(batchnumber::integer)
                from interfacesruntimeslog where batchnumber::integer >0 and batchnumber::integer <50000
                and interfaceid='CARES_OUTBOUND' and successful_sw='P') and batchnumber::integer >0 and batchnumber::integer<50000
                and interfaceid='CARES_OUTBOUND' and successful_sw='P';--
                 b_seq :=1;--
         end if;--
 
         if batchno::integer=last_processed_bno+1  then
                 b_seq :=1;--
         end if;--

/*
         if last_processed_bno is null then
             set b_seq=1;--
         end if;--
*/
          prev_bno1  :=batchno;--
          local_cnt1 :=local_cnt1 + 1;--
      end if;--

      if batchno::integer>49999 and batchno::integer <99998 then
         select max(batchnumber::integer) into last_processed_bno from interfacesruntimeslog where batchnumber::integer>49999 and batchnumber::integer<99998
            and interfaceid='CARES_INBOUND';--
         if local_cnt2 > 1 then
              last_processed_bno:=prev_bno2::integer;--
         end if;--
  
         if batchno::integer !=last_processed_bno+1  then
                update caresinboundtxt set status = 'E',text='104'||substring(text,4,length(text)-3)
                where substring(text,30,5)=batchno AND (status='N' OR insertedon::date=current_date);--
                 roll :=2;--
                exit outer_loop;--
         end if;--
  
         if batchno::integer=last_processed_bno+1 then
                 b_seq :=1;--
         end if;--
  
         if last_processed_bno is null then
                 b_seq :=1;--
         end if;--
   
        prev_bno2 :=batchno;--
        local_cnt2 :=local_cnt2 + 1;--
      end if;--

--CONSIDERING BATCH BY BATCH AND CHECKING ALL POSSIBLE CONDITIONS--

      if b_seq=1 then
             stmt := 'select old_id,text from caresinboundtxt where substring(text,30,5)=''' || batchno || '''  and (status = ''N'' OR insertedon::date=current_date) order by old_id :: INTEGER ASC';--
            select count(text) into cnt2 from caresinboundtxt where substring(text,30,5)=batchno AND (status = 'N' OR insertedon::date=current_date);--
            
            open c2 for execute stmt;--
             j :=1;--
             hdr :=0;--
             ftr :=0;--
             ts_seq :=0;--
            <<out_of_loop>>
            while j<=cnt2 loop
                fetch c2 into vartxt_id,vartxt;--

                if j=1 then
                    if substring(vartxt,35,5)='00000' then
                         hdr :=1;--
                    else
                        update caresinboundtxt set status = 'E', text='101'||substring(text,4,length(text)-3)
                        where substring(text,30,5)=batchno  AND (status = 'N' OR insertedon::date=current_date);--
                         roll :=2;--
                        exit out_of_loop;--
                    end if;--
    
                end if;--
  
                if j=cnt2 then
                    if substring(vartxt,35,5)='99999'then
                        if (substring(vartxt,40,10))::integer !=(cnt2-2) then
                                update caresinboundtxt set text='103'||substring(text,4,length(text)-3)
                                where substring(text,30,5)=batchno and old_id=vartxt_id  :: character varying  AND (status = 'N' OR insertedon::date=current_date);--
                                update caresinboundtxt set status = 'E', text='103'||substring(text,4,length(text)-3)
                                where substring(text,30,5)=batchno AND (status = 'N' OR insertedon::date=current_date);--
                                 roll :=2;--
                                exit out_of_loop;--
                        else
                                 ftr :=1;--
                        end if;--
     
                    else
                        update caresinboundtxt set status='F' where substring(text,30,5)=batchno AND (status = 'N'OR insertedon::date=current_date);--
                         roll :=2;--
                        exit out_of_loop;--
                    end if;--
                end if;--

                if j!=1 and j!=cnt2 and hdr=1 then
                        if (substring(vartxt,51,2)!='02' AND
                           substring(vartxt,51,2)!='16' AND
                           substring(vartxt,51,2)!='21' AND
                           substring(vartxt,51,2)!='51' AND
                           substring(vartxt,51,2)!='46' AND
                           substring(vartxt,51,2)!='26' ) then
                           update caresinboundtxt set status = 'E', text='506'||substring(text,4,length(text)-3)
                           where old_id=vartxt_id  :: character varying  AND (status = 'N'OR insertedon::date=current_date);--
                            roll :=2;--
                           exit out_of_loop;--
                        end if;--
     
                        if (substring(vartxt,40,2)!='80' AND
                           substring(vartxt,40,2)!='90') then
                           update caresinboundtxt set status = 'E', text='505'||substring(text,4,length(text)-3)
                           where old_id=vartxt_id  :: character varying   AND (status = 'N'OR insertedon::date=current_date);--
                            roll :=2;--
                           exit out_of_loop;--
                        end if;--
     
                        if vartxt_id!=vartxt_id1+1 then
                           update caresinboundtxt set status = 'E', text='501'||substring(text,4,length(text)-3)
                           where old_id = vartxt_id :: character varying  AND (status = 'N' OR insertedon::date=current_date);--
                           update caresinboundtxt set status = 'E' where (status ='N'OR insertedon::date=current_date);--
                            roll:=2;--
                           exit out_of_loop;--
                        end if;--
     
                end if;--
                 j:=j+1;--
                 vartxt_id1:=vartxt_id;--
            end loop out_of_loop;--

            if hdr=1 and ftr=1 and j-1=cnt2 then
                 update caresinboundtxt set status='C' where substring(text,30,5)=batchno AND (status ='N' OR insertedon::date=current_date);--
            else
                 roll:=2;--
                exit outer_loop;--
            end if;--
      end if;--
 
      close c2;--
       i :=i+1;--

end loop outer_loop;--
if roll=1 then

      update caresinboundtxt set status = 'E' where substring(text,30,5)=batchno AND insertedon::date=current_date;--
elseif roll=2 then
      insert into interfaceserrorlog(interfaceid,currentruntimestamp,batchnumber,errorlineno,errorcode,errorsqlcode,errordescription)  values ('CARES_INBOUND',current_timestamp,
      batchno,0,errstate,errcd,errmes);--
       errstate1 :='111';--

else
       errstate1 :='000';--
end if;--

END ;

$function$

