CREATE OR REPLACE FUNCTION as_geticpcroutinglist(p_objectid character varying, p_eventcode character varying)
 RETURNS TABLE(status character varying, remarks text, fromsecurityusersid character varying, fromusename text, tosecurityusersid character varying, tousername text, insertedon timestamp without time zone)
 LANGUAGE plpgsql
AS $function$

DECLARE  

BEGIN
            
RETURN  query
SELECT
        rs.routingstatustypekey  AS  status,  
 r.routeddescription as remarks,
 r.fromsecurityusersid,
 uf.firstname  ||'  '||  uf.lastname  fromusename,
 r.tosecurityusersid,
 up.firstname  ||'  '||  up.lastname  tousername,
 r.insertedon
FROM  routing  r  
INNER  JOIN  userprofile  up  ON  up.securityusersid  =  r.tosecurityusersid  AND  up.activeflag  =1  
INNER  JOIN  userprofile  uf  ON  uf.securityusersid  =  r.fromsecurityusersid  AND  uf.activeflag  =1  
INNER  JOIN  routingstatustype  rs  ON  r.routingstatustypeid  =  rs.sequencenumber  AND  rs.activeflag  =1
WHERE  r.objectid  =  p_objectid 
AND  r.eventcode  =  p_eventcode
order by r.insertedon asc ;


END;

$function$

