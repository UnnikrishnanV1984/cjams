CREATE OR REPLACE FUNCTION as_sp_add_manual_receivable(reqobj json)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE
v_Providerid int;
v_balance_no numeric;
v_securityuserid varchar( 50 );
v_receivable_id bigint;
vl_receivable_detail_id int;
v_payment_detail_id int;
--v_receivable_ts varchar( 50 );
v_receivable_status_cd varchar( 50 );
v_comments_tx text;
v_end_dt date;
v_start_dt date;
v_notes_tx text;
v_receivable_type varchar( 50 );
v_collection_status_cd varchar( 50 );
v_provider_category_cd varchar( 50 );
v_percentage_no numeric;
v_offset_sw bpchar;
v_payment_option_sw varchar(30);
v_offset_option_sw bpchar;
v_resend boolean;
v_receivable_exists integer; 
 vs_tickler_col VARCHAR(50) DEFAULT 'sq_ticklers';--
 vl_tickler_id BIGINT DEFAULT 0;--
 v_providernm character varying;
v_clientid bigint;

BEGIN 
v_Providerid := reqobj ->> 'provider_id';
v_balance_no := reqobj ->> 'balance_no'; 
v_securityuserid := reqobj ->> 'securityuserid';  
v_payment_detail_id := reqobj ->> 'payment_detail_id'; 
--v_receivable_ts := reqobj ->> 'receivable_ts'; 
v_receivable_status_cd := reqobj ->> 'receivable_status_cd'; 
v_comments_tx := reqobj ->> 'comments_tx'; 
v_start_dt := reqobj ->> 'start_dt'; 
v_end_dt := reqobj ->> 'end_dt';
v_notes_tx := reqobj ->> 'notes_tx';
v_receivable_type := reqobj ->> 'receivable_type';
v_collection_status_cd := reqobj ->> 'collection_status_cd';
v_resend := (reqobj ->> 'is_resend') :: boolean;
vl_receivable_detail_id := reqobj ->> 'receivable_detail_id';



select (case when provider_nm is null then concat_ws(' ',provider_first_nm,provider_last_nm) else provider_nm end) as provider_nm  into v_providernm from prov.tb_provider where provider_id =v_Providerid;
select client_id into v_clientid  from tb_payment_detail where payment_detail_id=v_payment_detail_id;
if(v_resend = true)
then 
 select rtd.receivable_id into  v_receivable_id from as_tb_receivable_detail rtd where rtd.receivable_detail_id = vl_receivable_detail_id;
 
 update as_tb_receivable_detail set amount_no = v_balance_no,  receivable_balance_no= v_balance_no , 
 comments_tx = v_comments_tx where receivable_detail_id = vl_receivable_detail_id ;
 
 update as_tb_receivable_header set 
 balance_no = v_balance_no, receivable_original_amount_no = v_balance_no where receivable_id = v_receivable_id;

 update tb_payment_plan set amount_no = v_balance_no,current_receivable_amount = v_balance_no where receivable_id = v_receivable_id; 

else

SELECT al_next_value from  sp_nextid ( 'sq_receivable_detail') into vl_receivable_detail_id;

select count(1) into v_receivable_exists  from as_tb_receivable_header where provider_id = v_Providerid;

if(v_receivable_exists = 0)
then
INSERT INTO as_tb_receivable_header
(provider_id, balance_no, receivable_original_amount_no,  create_user_id, update_user_id, delete_sw, create_ts, update_ts)
VALUES(v_Providerid, v_balance_no, v_balance_no,  v_securityuserid, v_securityuserid, 'N'::bpchar, now(), now())
returning receivable_id into v_receivable_id;


select provider_category_cd into v_provider_category_cd from prov.tb_provider where provider_id =v_Providerid;

if(v_provider_category_cd = '1783')
then 
v_percentage_no = 25 :: numeric;
else
v_percentage_no = 100 :: numeric;
end if;

if(v_collection_status_cd = '779')
then 
v_payment_option_sw := null;
v_offset_option_sw := 'A' :: bpchar; 
v_offset_sw := 'Y' :: bpchar;
else if(v_collection_status_cd = '779')
then 
v_payment_option_sw := 'A';
v_offset_option_sw := null; 
v_offset_sw := null;
end if;
end if;

INSERT INTO tb_payment_plan
(plan_dt, receivable_id, amount_no, percentage_no, months_no, start_dt, end_dt,
offset_sw, payment_option_sw, offset_option_sw, 
manual_sw, create_user_id, update_user_id, delete_sw, current_receivable_amount, create_ts, update_ts)
VALUES(now(), v_receivable_id, v_balance_no, v_percentage_no,null ,v_start_dt, v_end_dt,
v_offset_sw, v_payment_option_sw,v_offset_option_sw,
'Y', v_securityuserid, v_securityuserid, 'N'::bpchar, v_balance_no, now(),now());

else 
select trr.receivable_id into v_receivable_id 
from as_tb_receivable_header trr where provider_id = v_Providerid order by trr.create_ts desc limit 1;

update as_tb_receivable_header 
 set
  balance_no = coalesce(balance_no,0)+ v_balance_no ,
  receivable_original_amount_no = coalesce(receivable_original_amount_no,0)+ v_balance_no 
 where receivable_id = v_receivable_id;

update tb_payment_plan set 
 current_receivable_amount =  coalesce(current_receivable_amount,0)+ v_balance_no,
 amount_no =  coalesce(amount_no,0)+ v_balance_no
where receivable_id = v_receivable_id;



end if;


INSERT INTO as_tb_receivable_detail
(receivable_detail_id, payment_detail_id, receivable_id, amount_no, receivable_balance_no, 
 receivable_ts, receivable_status_cd, receivable_status_dt, comments_tx, start_dt, end_dt, 
  manual_sw, county_cd, notes_tx, approval_status_cd,create_user_id, update_user_id, delete_sw, receivable_type,
  create_ts, update_ts)

 select vl_receivable_detail_id, v_payment_detail_id, v_receivable_id, v_balance_no, v_balance_no,
 now(), v_receivable_status_cd , now(), v_comments_tx, v_start_dt, v_end_dt,
 'Y',tpd.county_cd, v_notes_tx, '3045', v_securityuserid,v_securityuserid,'N'::bpchar, v_receivable_type,
  now(),now()
  from tb_payment_detail tpd where tpd.payment_detail_id =v_payment_detail_id ;
 
 INSERT INTO as_tb_receivable_collection_status
(collection_status_cd, collection_status_dt, active_sw, create_user_id, receivable_detail_id, update_user_id, delete_sw, create_ts, update_ts)
VALUES(v_collection_status_cd, now(), 'Y', v_securityuserid, vl_receivable_detail_id, v_securityuserid, 'N'::bpchar, now(),now());




 
end if;
 SELECT sp_nextid(vs_tickler_col::character varying) into vl_tickler_id;
INSERT INTO tb_ticklers
(tickler_id, tickler_tx, tickler_type_sw, due_dt, reminder_start_dt, entity_type_cd,
entity_key_id, entity_nm, assigned_to_staff_id, client_id, create_ts, create_user_id, update_ts, update_user_id, delete_sw, 
county_cd, county_unit_id, system_tickler_id, tickler_nature_cd, assign_to_county_cd, assign_to_unit_id, expiry_dt, entity_id1, entity_id2, screen_cd, data_valid_sw, client_merge_id, action_tx, action_sw, action_dt, supervisor_review_sw, transfered_tickler_id, action_by_staff_id)
VALUES(vl_tickler_id,'An overpayment has occurred for Active provider. Send Overpayment Notice .', 'S', NULL, NULL, '2953', 
v_Providerid, v_providernm, NULL, v_clientid, now()::timestamp, 'finance', now()::timestamp, 'finance', 'N', 
null, NULL, 42, NULL, NULL, NULL, NULL, null, null, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);



return vl_receivable_detail_id;
END;


$function$

