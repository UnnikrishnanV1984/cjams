CREATE OR REPLACE FUNCTION updateapplprograminfo(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
v_securityuserid character varying;
i json;
v_addressarr json;
v_randomuuid uuid;
v_applicantid character varying;
v_accomid character varying;

begin
v_securityuserid:=insertobj->>'securityuserid';
v_addressarr:=insertobj->>'address';
v_applicantid:=insertobj->>'applicant_id';

if length(v_applicantid)>0
then

UPDATE tb_provider_applicant
SET program_name=insertobj->>'program_name', contact_first_nm=insertobj->>'contact_first_nm',contact_last_nm=insertobj->>'contact_last_nm',contact_middle_nm=insertobj->>'contact_middle_nm', contact_prefix_cd=insertobj->>'contact_prefix_cd',contact_suffix_cd=insertobj->>'contact_suffix_cd',
program_tax_id_no=(insertobj->>'program_tax_id_no')::int,contact_phonenumber=insertobj->>'contact_phonenumber',contact_email=insertobj->>'contact_email', contact_fax=insertobj->>'contact_fax',program_type=insertobj->>'program_type', program_type_other=insertobj->>'program_type_other', 
prgram_size=insertobj->>'prgram_size', update_ts=now(), update_user_id=v_securityuserid, delete_sw='N'::bpchar WHERE applicant_id=v_applicantid;

select prov_applicant_accomodation_id into v_accomid from tb_prov_applicant_accomodation where provider_applicant_id = v_applicantid;

if v_accomid is null 
then
INSERT INTO tb_prov_applicant_accomodation
(prov_applicant_accomodation_id, provider_applicant_id, minimum_age_no, maximum_age_no, gender_cd, children_no, create_ts, create_user_id, update_ts, update_user_id, delete_sw, min_age_months_no, max_age_months_no,iq_range_from,iq_range_to)
VALUES(gen_random_uuid(), v_applicantid, (insertobj->>'minimum_age_no')::int, (insertobj->>'maximum_age_no')::int, insertobj->>'gender_cd', (insertobj->>'children_no')::int, now(), v_securityuserid, now(), v_securityuserid, 'N'::bpchar, (insertobj->>'min_age_months_no')::int, (insertobj->>'max_age_months_no')::int,insertobj->>'iq_range_from',insertobj->>'iq_range_to');
else
UPDATE tb_prov_applicant_accomodation
SET minimum_age_no=(insertobj->>'minimum_age_no')::int, maximum_age_no=(insertobj->>'maximum_age_no')::int, gender_cd=insertobj->>'gender_cd', children_no=(insertobj->>'children_no')::int, update_ts=now(), update_user_id=v_securityuserid, min_age_months_no=(insertobj->>'min_age_months_no')::int, max_age_months_no=(insertobj->>'max_age_months_no')::int, iq_range_from=insertobj->>'iq_range_from', iq_range_to=insertobj->>'iq_range_to'
WHERE prov_applicant_accomodation_id=(v_accomid)::uuid;

end if;

for i IN SELECT * FROM json_array_elements(v_addressarr)
loop

UPDATE tb_provider_applicant_addresses
SET adr_type_cd=i->>'adr_type_cd', adr_format_cd=i->>'adr_format_cd', adr_street_no=(i->>'adr_street_no')::int, adr_box_no=(i->>'adr_box_no')::int, adr_pre_dir_cd=i->>'adr_pre_dir_cd', 
adr_street_nm=i->>'adr_street_nm', adr_street_suffix_cd=i->>'adr_street_suffix_cd',adr_post_dir_cd=i->>'adr_post_dir_cd', adr_unit_type_cd=i->>'adr_unit_type_cd', adr_unit_no_tx=i->>'adr_unit_no_tx', 
adr_city_nm=i->>'adr_city_nm', adr_county_cd=i->>'adr_county_cd', adr_state_cd=i->>'adr_state_cd', adr_zip5_no=(i->>'adr_zip5_no')::numeric, adr_zip4_no=(i->>'adr_zip4_no')::numeric,
adr_direction_tx=i->>'adr_direction_tx', adr_foreign_tx=i->>'adr_foreign_tx', adr_foreign_state_tx=i->>'adr_foreign_state_tx', adr_country_tx=i->>'adr_country_tx', adr_postal_code_tx=i->>'adr_postal_code_tx', adr_default_sw=i->>'adr_default_sw', adr_start_dt=(i->>'adr_start_dt')::date,
adr_end_dt=(i->>'adr_end_dt')::date, update_ts=now(), update_user_id=v_securityuserid, delete_sw='N'::bpchar, adr_street_tx=i->>'adr_street_tx' , adr_county_cd_tx=i->>'adr_county_cd_tx' WHERE address_id=(i->>'address_id')::uuid;

END LOOP;
return 'success'; 
else
return 'failure';
end if;

end;
$function$

