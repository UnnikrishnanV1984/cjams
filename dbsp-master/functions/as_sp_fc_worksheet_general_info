CREATE OR REPLACE FUNCTION as_sp_fc_worksheet_general_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, dateofchildplacement date, dateoflivingarrangement timestamp without time zone, islivingarrangementsameasplacement character varying, isplacementeligible character varying, isdjsordsschild character varying, dateofbirth timestamp without time zone, uscitizen character varying, qualifiedalien character varying, qualifiedalienstaus character varying, alienregistrationnumber character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm      VARCHAR(100) DEFAULT 'sp_fc_worksheet_general_info';
  vd_child_plct_dt     DATE;
  vd_lvng_strt_dt      TIMESTAMP;
  vs_lvng_arng_plct     VARCHAR(50);
  vs_plct_elig      VARCHAR(50);
  vs_djs_dss_child     VARCHAR(50);
  vd_birth_dt       TIMESTAMP;
  vs_us_ctzn       VARCHAR(50);
  vs_qlfd_alien      VARCHAR(50);
  vs_qlfd_alien_sts     VARCHAR(50);
  vs_alien_rgstn_txt     VARCHAR(50);
 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_general_info ( 
  client_id          BIGINT,
  dateofchildplacement       DATE,
  dateoflivingarrangement      TIMESTAMP,
  islivingarrangementsameasplacement   VARCHAR(50),
  isplacementeligible       VARCHAR(50),
  isdjsordsschild        VARCHAR(50),
  dateofbirth         TIMESTAMP,
  uscitizen         VARCHAR(50),
  qualifiedalien        VARCHAR(50),
  qualifiedalienstaus       VARCHAR(50),
  alienregistrationnumber      VARCHAR(50)
 ); 

-- Child Placement Date
SELECT tpl.entry_dt
 INTO vd_child_plct_dt
   FROM tb_placement tpl, intakeservicerequestactor isra, person per
WHERE isra.intakeservicerequestactorid = tpl.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 order by tpl.create_ts asc;
  
-- Living Arrangement Date
SELECT la.livingstartdate  
 INTO vd_lvng_strt_dt
   FROM livingarrangement la, person per     
WHERE per.personid = la.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 order by la.insertedon asc;  

-- Living Arrangement Same as Placement
select (case when (vd_lvng_strt_dt is not null and vd_child_plct_dt is not null) then (CASE WHEN vd_lvng_strt_dt > vd_child_plct_dt then
    'YES'::VARCHAR when vd_lvng_strt_dt < vd_child_plct_dt then 'NO'::VARCHAR END) 
    when (vd_child_plct_dt is not null and vd_lvng_strt_dt is null) then 'YES'::VARCHAR 
   when (vd_child_plct_dt is null and vd_lvng_strt_dt is not null) then 'NO'::VARCHAR else 'NO'::VARCHAR end)
 INTO vs_lvng_arng_plct; 

--select (CASE WHEN la.placementid = pl.placementid then
--    'YES'::VARCHAR 
--   ELSE 'NO'::VARCHAR END)
-- INTO vs_lvng_arng_plct  
-- FROM livingarrangement la, placement pl, intakeservicerequestactor isra, person per  
--WHERE pl.placementid = la.placementid AND pl.activeflag = 1
-- AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid AND isra.activeflag = 1
-- AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
  
-- Placement Eligibility  
SELECT (CASE WHEN LEFT(tp.fiscal_category_cd, 2) = '21' 
    THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END) 
 INTO vs_plct_elig
   FROM tb_placement tp
WHERE tp.client_id::BIGINT = al_client_id
   AND tp.delete_sw = 'N';

-- DJS/DSS Child
SELECT (CASE WHEN teamtypekey = 'CW' THEN
    'DHS'::VARCHAR 
   WHEN teamtypekey = 'DJS' THEN
    'DJS'::VARCHAR
   ELSE NULL END)
 INTO vs_djs_dss_child  
 FROM intakeservicerequest isr, placement pl, intakeservicerequestactor isra, person per 
WHERE pl.servicecaseid = isr.servicecaseid AND pl.activeflag = 1
 AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
   
-- Date of Birth   
SELECT per.dob  
 INTO vd_birth_dt
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;  

-- US Citizen   
SELECT ( CASE per.citizenalenageflag WHEN 1
     THEN 'YES'::VARCHAR WHEN 0 THEN 'NO'::VARCHAR ELSE NULL END )  
 INTO vs_us_ctzn
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;
   
-- Qualified Alien   
SELECT ( CASE per.isqualifiedalien WHEN 1
     THEN 'YES'::VARCHAR ELSE NULL END )  
 INTO vs_qlfd_alien
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
  
-- Qualified Alien Status
SELECT rv.value_text   
 INTO vs_qlfd_alien_sts
   FROM referencevalues rv, person per
WHERE referencetypeid = 89 AND rv.activeflag = 1 
    AND TRIM(rv.ref_key) = TRIM(per.alienstatustypekey)
    AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;
   
-- Alien Registration Number   
SELECT per.alienregistrationtext  
 INTO vs_alien_rgstn_txt
   FROM person as per     
WHERE per.cjamspid::BIGINT = al_client_id
   AND per.activeflag = 1;  
 
INSERT INTO Temp_worksheet_general_info
SELECT 
  al_client_id,
  vd_child_plct_dt,
  vd_lvng_strt_dt,
  vs_lvng_arng_plct,
  vs_plct_elig,
  vs_djs_dss_child,
  vd_birth_dt,
  vs_us_ctzn,
  vs_qlfd_alien,
  vs_qlfd_alien_sts,
  vs_alien_rgstn_txt;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_general_info;
              
DROP TABLE Temp_worksheet_general_info;

   END
    $function$

