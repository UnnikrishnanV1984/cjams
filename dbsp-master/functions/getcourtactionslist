CREATE OR REPLACE FUNCTION getcourtactionslist(v_intakeserviceid uuid)
 RETURNS TABLE(courtactiontypeid uuid, hearingtypekey character varying, courtactiontypekey character varying, description character varying)
 LANGUAGE plpgsql
 ROWS 10000
AS $function$


BEGIN
RETURN QUERY 
select CAT.courtactiontypeid,CAT.hearingtypekey ,CAT.courtactiontypekey ,CAT.description
from courtactiontype as CAT where  CAT.activeflag=1 and CAT.hearingtypekey
in(select ISRCH.hearingtypekey from intakeservicerequestcourthearing as ISRCH where ISRCH.intakeserviceid = v_intakeserviceid);

      
 end;
 
$function$

