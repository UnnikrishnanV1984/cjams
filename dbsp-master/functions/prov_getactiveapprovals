CREATE OR REPLACE FUNCTION prov_getactiveapprovals(v_providerid character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(totalcount bigint, approvaltype character varying, providerapprovalid uuid, provider_approval_id character varying, approvaldesc character varying, approvaldate character varying, approved_beds_no integer, approvalcomments text, nextrecondate character varying, active_sw character varying, approvalstatus character varying)
 LANGUAGE plpgsql
AS $function$
 
DECLARE
 v_pageoffset int;
    v_pagenumber int;
   v_applicantid character varying;
 
BEGIN

 v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;   
return query 

 select count(1) over() as totalcount,tpv.value_tx as approvaltype,tpa.providerapprovalid , tpa.provider_approval_id::character varying,tpa.approval_comments_tx as approvaldesc,tpa.approval_dt::character varying as approvaldate,tpa.approved_beds_no,
 ''::text as approvalcomments,tpa.next_recon_dt::character varying,tpa.active_sw ::character varying,tpstatus.value_tx::character varying as approvalstatus
 from tb_provider_approval tpa
  inner join tb_picklist_values tpv on trim(tpv.picklist_value_cd) = trim(tpa.approval_type_cd) and (tpv.picklist_type_id='367' or tpv.picklist_type_id='368')
  inner join tb_picklist_values tpstatus on trim(tpstatus.picklist_value_cd) = trim(tpa.approval_status_cd) and ( tpstatus.picklist_type_id='368')
 -- left outer join tb_public_provider_applicant tppp on tppp.applicant_id=v_applicantid
  where tpa.provider_id=v_providerid::bigint and tpa.delete_sw='N' and tpa.approval_dt is not null and tpa.active_sw='Y'
  order by approvaldate desc
  LIMIT pagesize OFFSET v_pageoffset;

END;
$function$

