SELECT pl.startdatetime INTO vd_ltst_fc_plcmt_st_dt_with_grd FROM person p
 INNER JOIN intakeservicerequestactor isra ON isra.personid = p.personid AND p.activeflag= 1
 INNER JOIN placement pl ON pl.servicecaseid = isra.servicecaseid AND pl.activeflag = 1
 INNER JOIN guardianship gs ON gs.servicecaseid = isra.servicecaseid AND gs.guardianoneproviderid = pl.altproviderid AND gs.activeflag = 1
WHERE p.cjamspid::BIGINT = al_client_id ORDER BY pl.startdatetime DESC LIMIT 1;

-- Guardian Application Date 
SELECT gdis.disclosuredate
 INTO vd_grd_appl_dt
   FROM gapdisclosure gdis, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE gdis.gapid = grd.gapid AND gdis.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND grd.permanencyplanid = pp.permanencyplanid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;
 
--IsRelative (for Primary Guardian -info in this bracket for your information only)

select (case 
  when primaryrelationshipkey = '1001' then true
  when primaryrelationshipkey = '1014' then true
  else false
   end) as isprimaryrelationshipkey,
 (case 
  when secondaryrelationshipkey = '1001' then true
  when secondaryrelationshipkey = '1014' then true
  else false
   end) as issecondaryrelationshipkey
   
into vd_relation
 from 
guardianship g 
inner join intakeservicerequest isrq on isrq.servicecaseid = g.servicecaseid
inner join servicecase sc on sc.servicecaseid = isrq.servicecaseid
inner join intakeservicerequestactor iac on iac.intakeserviceid = isrq.intakeserviceid
inner join person p on p.personid = iac.personid
where iac.intakeservicerequestpersontypekey = 'CHILD' 
and p.cjamspid = al_client_id;

-- 'guardianshipfinalizationdate'

select  isrco.courtorderdate into v_guardianshipfinalizationdate from Intakeservreqcohearingoutcome hoc
inner join intakeservreqcourtorder isrco on isrco.intakeservreqcourtorderid = hoc.intakeservreqcourtorderid
inner join intakeservicerequestpetition pet on pet.intakeservicerequestpetitionid = isrco.intakeservicerequestpetitionid
inner join intakeservicerequest isrq on isrq.servicecaseid = pet.servicecaseid
inner join intakeservicerequestactor iac on iac.intakeserviceid = isrq.intakeserviceid
inner join servicecase sc on sc.servicecaseid = isrq.servicecaseid
inner join person p on p.personid = iac.personid
where iac.intakeservicerequestpersontypekey = 'CHILD' 
and hoc.hearingoutcometypekey in ('CUSGUA') 
and p.cjamspid = al_client_id;

 -- Age Appropriate Consult Place
