INSERT INTO Temp_worksheet_general_info
SELECT 
  al_client_id,
  vs_apprvd_fstr_prnt,
  vd_full_apprvl_fp_dt,
  vd_relation.isprimaryrelationshipkey,
  vn_pri_rltn_id,
  vs_pri_rltn,
  vd_relation.issecondaryrelationshipkey,
  vn_sec_rltn_id,
  vs_sec_rltn,  
