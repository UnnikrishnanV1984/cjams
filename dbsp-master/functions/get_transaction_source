CREATE OR REPLACE FUNCTION get_transaction_source(v_client_account_id integer)
 RETURNS TABLE(value_tx character varying, picklist_value_cd character varying)
 LANGUAGE plpgsql
AS $function$


declare
 v_pagenumber int;
 v_pageoffset int;
 
BEGIN 

return query 
select x.* from 
(
SELECT tpv.value_tx :: character varying,trim(tpv.picklist_value_cd) :: character varying picklist_value from
tb_picklist_values tpv where tpv.picklist_type_id=38 and tpv.delete_sw='N'
)x group by x.value_tx,x.picklist_value order by x.value_tx asc;

END;

$function$

