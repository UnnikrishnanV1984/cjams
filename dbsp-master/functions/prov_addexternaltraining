CREATE OR REPLACE FUNCTION prov_addexternaltraining(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
 declare                                                                                                                                                                                                                                                                                                                                                                                               
status character varying;
v_trainingnumber character varying; 
trgid character varying;
attendanceid character varying;
training_attended boolean;
i json; 
begin                                                                                                                                                                                                                                                                                                                                                                                                 
status:='started';
training_attended = true;

 RAISE NOTICE 'status:%', status;   
INSERT INTO providerorientationtraining (orientation_training_id, training_number, training_type,
training_date, start_datetime, end_datetime, duration, medium, addr_line1, addr_line2, addr_city, addr_state, addr_zip, training_url, narrative, 
instructor_1, instructor_2, create_ts, create_user_id, update_ts, update_user_id,
delete_sw, active_flag, jurisdiction, training_topic, training_status, room_no, session_type, session_no, is_cfe) 
VALUES(gen_random_uuid(), (insertobj->>'training_number'), (insertobj->>'training_type'),
(insertobj->>'training_date')::date, (insertobj->>'start_datetime')::timestamp, (insertobj->>'end_datetime')::timestamp ,(insertobj->>'duration')::numeric, '', '', '', '', '', '', '', insertobj->>'narrative',
(insertobj->>'instructor_1')::uuid, null, now(), insertobj->>'securityuserid', now(),insertobj->>'securityuserid', 
'N'::bpchar, 1, insertobj->>'jurisdiction',insertobj->>'training_topic', insertobj->>'training_status', '', insertobj->>'session_type', (insertobj->>'session_no')::int4, (insertobj->>'is_cfe')::bool) returning orientation_training_id into trgid;

status:='firstquery executed';

--For external training orientation_training_id is set to null
if (trgid is not null) then
 if((insertobj->>'training_attended') is not null) then
  training_attended = (insertobj->>'training_attended')::bool;
 end if;
 for i IN SELECT * FROM json_array_elements((insertobj->>'personsinfo')::json)
 loop
  INSERT INTO providerorientationtrainingattendance (orientation_training_attendance_id, orientation_training_id, training_number, 
  object_id, narrative, phase, create_ts, create_user_id, update_ts, update_user_id, delete_sw, active_flag, is_attended, is_intent_to_attend, 
  attendee_first_nm, attendee_last_nm, personid, personrole) 
  VALUES(gen_random_uuid(),null, insertobj->>'training_number', 
  insertobj->>'objectid', insertobj->>'narrative',insertobj->>'phase', now(), insertobj->>'securityuserid', now(),insertobj->>'securityuserid', 'N'::bpchar, 1, 
  training_attended, true, '', '', i->>'personid', i->>'personrole') returning orientation_training_attendance_id into attendanceid;
  status:='secondquery executed';
 END LOOP;
 
end if;

if (attendanceid is not null) then
 return 'Success' ;          
else
 return 'Failed create training';
end if;
 end;                                                                                                                                                                                                                                                                                                                                                                                                  
 $function$

