CREATE OR REPLACE FUNCTION createuserbackend(sfirstname character varying, slastname character varying, semail character varying, steamtypekey character varying, nuserid bigint)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare lsecurityusersid character varying(100);
begin
INSERT INTO userprofile(
 securityusersid, firstname, lastname, displayname, fullname, 
    activeflag,   email,    insertedby, insertedon, updatedby, updatedon,
      teamtypekey,usertypekey,autonotification)
 VALUES (gen_random_uuid(),sfirstname,slastname,sfirstname|| ' ' || slastname 
            ,sfirstname|| ' ' || slastname  ,
            1,semail ,'admin' ,now(),'admin',now(),steamtypekey,'DSDS',false )
            returning securityusersid into  lsecurityusersid;
 
INSERT INTO muser(
   username, password, email,  id, securityusersid,
    insertedby, updatedby, insertedon, updatedon, activeflag )
 VALUES (sfirstname|| ' ' || slastname,
            '$2a$10$fwlp0MMCDZHj9wk7mNdQ6uf1hQkZXcDYiqlLZZVWK0Ic4PCcm0lyW'
            , semail,nuserid,lsecurityusersid,
            'admin' ,'admin',now(),now(),1);
 
 INSERT INTO securityusers(
 securityusersid, username , activeflag, insertedby, updatedby, insertedon, updatedon)
    values (lsecurityusersid,sfirstname|| ' ' || slastname ,1,'admin','admin',now(),now());
 return 'success';           
end;            
 $function$

