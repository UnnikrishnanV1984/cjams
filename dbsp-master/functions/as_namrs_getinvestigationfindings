CREATE OR REPLACE FUNCTION as_namrs_getinvestigationfindings(caseno character varying)
 RETURNS TABLE(cjamspid character varying, age integer, gendertypekey integer, racetypekey character varying, ethnicgrouptypekey integer, investigationfinding integer, allegation integer)
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_intakeserviceid uuid;
v_intakeservreqtypekey character varying;
v_intakenumber character varying;
v_cjamspid bigint;
v_personid uuid;
v_allegationlist text;

BEGIN
  


RETURN QUERY  

select f_afcars_encrypt(p.cjamspid:: character varying),
date_part('year',age(p.dob)) :: integer,
case when p.gendertypekey in ('M') then 1 when p.gendertypekey in ('F') then 2 when p.gendertypekey in ('TG','TGIM','TGIF') then 3 else 0 end,
p.racetypekey,
case p.ethnicgrouptypekey when 'H' then 10 else 20 end,
(case when ig.investigationfindingtypekey = 'ID' then 1 when ig.investigationfindingtypekey ='RO' then 2 when ig.investigationfindingtypekey ='UD' then 3 when ig.investigationfindingtypekey ='UC' then 4 
end) as investigationfinding,
--ig.investigationfindingtypekey,
(case when a."name" = 'Financial Exploitation' then 31 when a."name" = 'Neglect by Others' then 40 when a."name" = 'Physical Abuse' then 50  when a."name" = 'Sexual Abuse/Exploitation' then 60 when a."name" = 'Self-Neglect' then 80 end) as allegation 
--a."name" 
from investigationfinding ig
inner join investigationallegation i on ig.investigationallegationid = i.investigationallegationid 
inner join allegation a on i.allegationid = a.allegationid 
inner join investigation i2 on i2.investigationid = i.investigationid 
inner join intakeservicerequest i3 on i3.intakeserviceid =i2.intakeserviceid 
inner join person p on p.personid = ig.personid 
where i3.servicerequestnumber =caseno
and ig.activeflag =1 
and i.activeflag =1 and a.activeflag =1 ;  


END;


$function$

