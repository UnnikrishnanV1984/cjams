  INSERT INTO KeyResults\r
 (PersonId, RankNo, MatchScore,NameRank, AliasRank)\r
\r
 SELECT \r
  distinct\r
  p.PersonId,\r
  0 AS match_rank,\r
  CASE  WHEN v_lvFirstName is not null and coalesce(v_firstname_clean,' ') = trim(lower(p.FirstName)) THEN 1 \r
    WHEN v_lvFirstName is not null and coalesce(v_firstname_clean,' ') = trim(lower(al.FirstName)) THEN 1 \r
    WHEN v_lvFirstName is not null and trim(lower(p.FirstName)) like v_firstname_clean||'%' THEN 1 \r
    WHEN v_lvFirstName is not null and trim(lower(al.FirstName)) like v_firstname_clean||'%' THEN 1 \r
    WHEN v_lvFirstName is not null and coalesce(v_firstname_clean,' ') = split_part(trim(lower(p.FirstName)), ' ',1) THEN 1 \r
    WHEN v_lvFirstName is not null and coalesce(v_firstname_clean,' ') = split_part(trim(lower(al.FirstName)), ' ',1) THEN 1 \r
    ELSE 0 end\r
  + CASE  WHEN v_lvLastName is not null and coalesce(v_lastname_clean,' ') = trim(lower(p.LastName)) THEN 1 \r
    WHEN v_lvLastName is not null and coalesce(v_lastname_clean,' ') = trim(lower(al.LastName)) THEN 1 \r
    WHEN v_lvLastName is not null and trim(lower(p.LastName)) like v_lastname_clean||'%' THEN 1\r
    WHEN v_lvLastName is not null and trim(lower(al.LastName)) like v_lastname_clean||'%' THEN 1\r
    WHEN v_lvLastName is not null and coalesce(v_lastname_clean,' ') = split_part(trim(lower(p.LastName)), ' ',1) THEN 1 \r
    WHEN v_lvLastName is not null and coalesce(v_lastname_clean,' ') = split_part(trim(lower(al.LastName)), ' ',1) THEN 1 \r
    ELSE 0 end\r
  + CASE WHEN v_lvMiddleName is not null and coalesce(v_middlename_clean,' ') = trim(lower(p.MiddleName)) THEN 1 \r
           WHEN v_lvMiddleName is not null and coalesce(v_middlename_clean,' ') = split_part(trim(lower(p.MiddleName)), ' ',2) THEN 1 ELSE 0 end\r
  ::int as match_score,\r
  CASE  WHEN v_lvFirstName is not null THEN COALESCE(difference(v_firstname_clean, trim(lower(p.FirstName))),0) ELSE 0 end\r
  + CASE  WHEN v_lvLastName is not null THEN COALESCE(difference(v_lastname_clean, trim(lower(p.LastName))),0) ELSE 0 end\r
  + CASE  WHEN v_lvMiddleName is not null THEN COALESCE(difference(v_middlename_clean, trim(lower(p.MiddleName))),0) ELSE 0 end\r
  ::int as name_rank,\r
  CASE  WHEN v_lvFirstName is not null THEN COALESCE(difference(v_firstname_clean, trim(lower(al.FirstName))),0) ELSE 0 end\r
  + CASE  WHEN v_lvLastName is not null THEN COALESCE(difference(v_lastname_clean, trim(lower(al.LastName))),0) ELSE 0 end\r
  + CASE  WHEN v_lvMiddleName is not null THEN COALESCE(difference(v_middlename_clean, trim(lower(al.MiddleName))),0) ELSE 0 end\r
  ::int as alias_rank\r
 FROM    Person  AS  p  \r
    LEFT  JOIN  PersonIdentifier  AS  i  ON  i.PersonId  =  p.PersonId \r
 LEFT  JOIN  PersonAddress    AS  a  ON  a.PersonId  =  p.PersonId  and  a.ActiveFlag  =  1  --AND  a.PersonAddressTypeKey  =  'C'\r
 LEFT  JOIN  PersonPhoneNumber  AS  pn  ON  pn.PersonId  =  p.PersonId\r
 LEFT  JOIN  PersonEmail  AS  pe  ON  pe.PersonId  =  p.PersonId\r
 LEFT  JOIN  County        AS  c  ON    a.county :: character varying  =  c.countyid :: character varying\r
 Left  Join  Alias  As  al  On  al.personid  =  p.personid\r
 WHERE (p.clientflag is null or p.clientflag = 1 or p.cisclientid is not null)\r
 AND CASE WHEN personid_list IS NOT NULL THEN p.personid != ANY (personid_list::uuid[]) ELSE TRUE END\r
 AND (( CASE WHEN v_lvFirstName  is NOT NULL THEN soundex_firstname = soundex(trim(lower(p.FirstName)))  ELSE TRUE END\r
   AND CASE WHEN v_lvLastName   is NOT NULL THEN soundex_lastname = soundex(trim(lower(p.LastName)))  ELSE TRUE END\r
   AND CASE WHEN v_lvMiddleName is NOT NULL THEN soundex_middlename = soundex(trim(lower(p.MiddleName))) ELSE TRUE END) \r
   OR\r
  ( CASE WHEN v_lvFirstName  is NOT NULL THEN soundex_firstname = soundex(trim(lower(al.FirstName)))  ELSE TRUE END\r
   AND CASE WHEN v_lvLastName   is NOT NULL THEN soundex_lastname = soundex(trim(lower(al.LastName)))  ELSE TRUE END\r
   AND CASE WHEN v_lvMiddleName is NOT NULL THEN soundex_middlename = soundex(trim(lower(al.MiddleName))) ELSE TRUE END))\r
  AND CASE WHEN v_lvRace is NOT NULL THEN (p.RaceTypeKey = v_lvRace) ELSE TRUE END\r
  AND CASE WHEN v_lvGender is NOT NULL THEN (p.GenderTypeKey = v_lvGender) ELSE TRUE END\r
  AND CASE WHEN v_lDCNType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lDCNType) ELSE TRUE END\r
  AND CASE WHEN v_liDangerous is NOT NULL THEN (p.DangerLevel = v_liDangerous) ELSE TRUE END\r
  AND CASE WHEN v_liRegion is NOT NULL THEN (c.APSRegion = v_liRegion) ELSE TRUE END\r
  AND (CASE WHEN (v_lDLType is NOT NULL AND v_lDLValue is NOT NULL)\r
           THEN (i.PersonIdentifierTypeKey = v_lDLType AND i.PersonIdentifierValue ILIKE v_lDLValue)\r
          ELSE TRUE END)\r
  and CASE WHEN v_lvStateId is NOT NULL THEN a.state ILIKE v_lvStateId ELSE TRUE end\r
  AND  CASE  WHEN  v_lvAddress  is  NOT  NULL  THEN  (lower(a.address)  ILIKE  lower(v_lvAddress)||'%' )  ELSE  TRUE  end\r
     AND  CASE  WHEN  v_lvAddress2  is  NOT  NULL  THEN  (lower(a.address2) ILIKE  lower(v_lvAddress2)||'%' )  ELSE  TRUE  END\r
  AND CASE WHEN v_lvSocialMediaSrc is NOT NULL THEN (lower(p.socialmediasource) = lower(v_lvSocialMediaSrc)) ELSE TRUE END\r
  AND CASE WHEN v_lvFein is NOT NULL THEN (p.fein = v_lvFein) ELSE TRUE END\r
  AND CASE WHEN v_lvComplaintnumber is NOT NULL THEN (p.complaintnumber = v_lvComplaintnumber) ELSE TRUE end\r
  AND CASE WHEN v_lvcjamspid is NOT NULL THEN ( p.cjamspid = v_lvcjamspid::bigint) ELSE TRUE END\r
  AND CASE WHEN v_lvPetitionid is NOT NULL THEN (p.petitionid = v_lvPetitionid) ELSE TRUE END\r
  AND \r
   CASE \r
    WHEN v_lvAlias is NOT NULL \r
    THEN ((concat(trim(lower(al.firstname)), case when al.lastname is not null then '' else ' '|| trim(lower(al.lastname)) end ) = v_alias_clean) and al.akatypetypekey='AN' and al.activeflag=1)\r
    ELSE true\r
   END\r
   AND CASE \r
     WHEN v_lvMaidenName is NOT NULL \r
     THEN ((concat(lower(al.firstname), case when al.lastname is not null then '' else ' '|| lower(al.lastname) end ) = v_maidenname_clean) and al.akatypetypekey='MN' and al.activeflag=1)\r
     ELSE true\r
    END\r
  AND CASE WHEN v_lvZip is NOT NULL THEN (lower(a.zipcode) = lower(v_lvZip)) ELSE TRUE END\r
  AND CASE WHEN v_lvState is NOT NULL THEN (a.state ILIKE v_lvState) ELSE TRUE END\r
  AND CASE WHEN v_lvCounty is NOT NULL THEN (a.county ILIKE v_lvCounty) ELSE TRUE END\r
  AND CASE WHEN v_lvCity is NOT NULL THEN (lower(a.city) = lower(v_lvCity)) ELSE TRUE END\r
  AND CASE WHEN v_lDCNValue is NOT NULL THEN (i.PersonIdentifierValue ILIKE v_lDCNValue) ELSE TRUE END\r
  AND CASE WHEN v_lvPhone is NOT NULL THEN (pn.phoneNumber ILIKE v_lvPhone) ELSE TRUE END\r
  AND CASE WHEN v_lvEmail is NOT NULL THEN (pe.email ILIKE v_lvEmail) ELSE TRUE END\r
  AND CASE WHEN v_lvOccupation is NOT NULL THEN (p.occupation ILIKE v_lvOccupation) ELSE TRUE END\r
  AND (v_liAge IS NULL OR date_part('year', age(now(), p.DOB)) = v_liAge)\r
  AND CASE WHEN v_lmdmType is NOT NULL THEN (i.PersonIdentifierTypeKey = v_lmdmType) ELSE TRUE end\r
  AND CASE WHEN v_lmdmValue is NOT NULL THEN (i.PersonIdentifierValue ilike '%'  || v_lmdmValue ||  '%' ) ELSE TRUE END\r
  AND CASE WHEN v_ldDOB is NOT NULL THEN (p.DOB BETWEEN v_dob_from AND v_dob_to) ELSE TRUE END \r
  AND p.ActiveFlag  =  1\r
  LIMIT v_liPageSize OFFSET v_pageoffset;\r
 END IF;\r
