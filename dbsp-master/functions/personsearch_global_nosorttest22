  CREATE TEMP TABLE KeyResults(PersonId uuid, PersonAddressId uuid, RankNo int, RankSound int, MatchScore int, NameRank int, AliasRank int);\r
  argcount := 1;\r
  IF (v_lSSNValue IS NOT NULL) THEN\r
  argcount := argcount + 1;\r
  INSERT INTO KeyResults (PersonId, RankNo, MatchScore, NameRank, AliasRank)\r
   SELECT \r
    distinct\r
    p.PersonId,\r
    99 as match_rank,\r
    searchargperson as match_score,\r
    0 as name_rank,\r
    0 as alias_rank\r
   FROM    Person  AS  p                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          \r
   LEFT  JOIN  PersonIdentifier  AS  i  ON  i.PersonId  =  p.PersonId\r
   LEFT  JOIN  PersonAddress    AS  a  ON  a.PersonId  =  p.PersonId  and  a.ActiveFlag  =  1  --AND  a.PersonAddressTypeKey  =  'C'\r
   LEFT  JOIN  PersonPhoneNumber  AS  pn  ON  pn.PersonId  =  p.PersonId\r
   LEFT  JOIN  PersonEmail  AS  pe  ON  pe.PersonId  =  p.PersonId\r
   LEFT  JOIN  County        AS  c  ON    a.county :: character varying  =  c.countyid :: character varying\r
   Left  Join  Alias  As  al  On  al.personid  =  p.personid\r
   WHERE (p.clientflag is null or p.clientflag = 1 or p.cisclientid is not null)\r
   AND  i.PersonIdentifierValue = v_lSSNValue\r
   AND p.ActiveFlag  =  1;\r
  \r
  END IF;\r
  \r
  \r
  IF (v_lvCjisnumber IS NOT NULL) THEN\r
  argcount := argcount + 1;\r
  INSERT INTO KeyResults (PersonId, RankNo, MatchScore, NameRank, AliasRank)\r
   SELECT \r
    distinct\r
    p.PersonId,\r
    99 as match_rank,\r
    searchargperson as match_score,\r
    0 as name_rank,\r
    0 as alias_rank\r
   FROM    Person  AS  p                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          \r
   LEFT  JOIN  PersonIdentifier  AS  i  ON  i.PersonId  =  p.PersonId\r
   LEFT  JOIN  PersonAddress    AS  a  ON  a.PersonId  =  p.PersonId  and  a.ActiveFlag  =  1  --AND  a.PersonAddressTypeKey  =  'C'\r
   LEFT  JOIN  PersonPhoneNumber  AS  pn  ON  pn.PersonId  =  p.PersonId\r
   LEFT  JOIN  PersonEmail  AS  pe  ON  pe.PersonId  =  p.PersonId\r
   LEFT  JOIN  County        AS  c  ON    a.county :: character varying  =  c.countyid :: character varying\r
   Left  Join  Alias  As  al  On  al.personid  =  p.personid\r
   WHERE (p.clientflag is null or p.clientflag = 1 or p.cisclientid is not null)\r
    AND  (p.cjamspid = v_lvCjisnumber::bigint or trim(p.cisclientid) = v_lvCjisnumber::character varying)\r
    AND p.ActiveFlag  =  1;\r
  END IF;\r
  \r
  IF (argcount > 1 and v_lvCjisnumber IS NULL) THEN\r
 SELECT array_agg(k.personid) into personid_list from KeyResults k ;\r
  END IF;\r
