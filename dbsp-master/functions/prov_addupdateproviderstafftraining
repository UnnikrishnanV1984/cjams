CREATE OR REPLACE FUNCTION prov_addupdateproviderstafftraining(insertedlsobj json)
 RETURNS TABLE(status text, providerstaff_id uuid)
 LANGUAGE plpgsql
AS $function$ 

DECLARE
v_provstaff_id uuid;
returnStatus text;
v_Securityuserid text;
v_training_details JSON;
i json;

BEGIN
v_provstaff_id := insertedlsobj->>'provider_staff_id';
v_Securityuserid := insertedlsobj->>'securityuserid';
v_training_details := insertedlsobj ->> 'training_details';

RAISE NOTICE ' staff_id>>>>>  :%', insertedlsobj->>'provider_staff_id';

IF(v_provstaff_id IS NOT NULL) THEN 

FOR i IN SELECT *FROM json_array_elements_text(v_training_details)
LOOP

RAISE NOTICE ' iiiii>>>>>  :%', i->>'rcc_training_name';
RAISE NOTICE ' rcc_training_name>>>>>  :%', i->>'rcc_training_name';
RAISE NOTICE ' provider_training_hrs>>>>>  :%', i->>'provider_training_hrs';
RAISE NOTICE ' provider_training_date>>>>>  :%', i->>'provider_training_date';

--For getting training history
UPDATE tb_prov_trainingnames
SET rcc_training_name =i->>'rcc_training_name',
provider_training_hrs = i->>'provider_training_hrs',
other_training_name =(i->>'other_training_name')::character varying,
provider_training_date =(i->>'provider_training_date')::date,
update_ts = now()::timestamp, 
update_user_id = v_Securityuserid, 
delete_sw =  'N'::bpchar, active_flag = 1
where provider_training_id = (i->>'provider_training_id')::uuid; ---traing id

if ((i->>'provider_training_id') is null ) then
-- UPDATE tb_prov_trainingnames
-- SET active_flag = 0
-- where rcc_training_name = i->>'rcc_training_name';
--Insert new entry for training
INSERT INTO tb_prov_trainingnames
(provider_staff_id,rcc_training_name,other_training_name, provider_training_hrs, provider_training_date,create_ts, create_user_id, update_ts, 
update_user_id, delete_sw, active_flag)
VALUES(v_provstaff_id,i->>'rcc_training_name', i->>'other_training_name', 
i->>'provider_training_hrs', (i->>'provider_training_date')::date,
now()::timestamp, v_Securityuserid, now()::timestamp, v_Securityuserid, 'N'::bpchar, 1);
end if ;
END LOOP;

returnStatus := 'Success';

ELSE
returnStatus := 'failed';

END IF;

return query
select returnStatus, v_provstaff_id;                                                    
END;

$function$

