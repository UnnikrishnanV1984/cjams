CREATE OR REPLACE FUNCTION as_f_ldssloc_ad(as_tabname character varying, ai_key_id integer, as_adr_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 

DECLARE

 f_final varchar(2000) default '';--
 lb_po_box varchar(1);--

 t_ADDRESS_ID           INTEGER;   --
 t_ADR_FORMAT_CD        VARCHAR(15)   default '';--
 t_EMP_SCHOOL_NM        VARCHAR(50)   default '';--
 t_ADR_STREET_NO        VARCHAR(10)   default '';--
 t_ADR_BOX_NO           VARCHAR(10)   default '';--
 t_ADR_PRE_DIR_CD       VARCHAR(100)  default '';--
 t_ADR_STREET_NM        VARCHAR(50)   default '';--
 t_ADR_STREET_SX_CD     VARCHAR(100)  default '';--
 t_ADR_POST_DIR_CD      VARCHAR(100)  default '';--
 t_ADR_UNIT_TYPE_CD     VARCHAR(100)  default '';--
 t_ADR_UNIT_NO_TX       VARCHAR(5)    default '';--
 t_ADR_CITY_NM          VARCHAR(50)   default '';   --
 t_ADR_COUNTY_CD        VARCHAR(5)    default '';--
 t_ADR_STATE_CD         VARCHAR(100)  default '';   --
 t_ADR_ZIP5_NO          VARCHAR(10)   default '';   --
 t_ADR_ZIP4_NO          VARCHAR(10)   default ''; --
 t_ADR_DIRECTION_TX     VARCHAR(500)  default '';    --
 t_ADR_FOREIGN_TX       VARCHAR(500)  default '';   --
 t_ADR_FOREIGN_STTX     VARCHAR(50)   default '';   --
 t_ADR_COUNTRY_TX       VARCHAR(50)   default '';   --
 t_ADR_POSTAL_CD_TX     VARCHAR(10)   default '';--
 
 ----
 f_adr_street_NM   VARCHAR(50)   default '';--
 f_ADR_STREET_NO   VARCHAR(10)   default '';--
 f_ADR_PRE_DIR_CD   VARCHAR(100)  default '';--
 f_ADR_STREET_SUFFIX_CD  VARCHAR(100)  default '';--
 f_ADR_FORMAT_CD      VARCHAR(10)   default '';--
 f_ADR_UNIT_TYPE_CD   VARCHAR(100)  default '';--
 f_ADR_UNIT_NO_TX       VARCHAR(5)    default '';--
 f_ADR_CITY_NM           VARCHAR(50)   default '';   --
 f_ADR_COUNTY_CD         VARCHAR(5)    default '';--
 f_ADR_STATE_CD          VARCHAR(100)  default '';   --
 f_ADR_ZIP5_NO           VARCHAR(10)   default '';   --
 f_ADR_ZIP4_NO           VARCHAR(10)   default ''; --
 f_ADR_DIRECTION_TX      VARCHAR(500)  default '';  --
 f_ADR_FOREIGN_TX        VARCHAR(500)  default '';   --
 f_ADR_FOREIGN_STATE_TX  VARCHAR(50)   default '';   --
 f_ADR_COUNTRY_TX        VARCHAR(50)   default '';   --
 f_ADR_POSTAL_CODE_TX    VARCHAR(10)   default '';--
 
BEGIN 

 SELECT    
         COALESCE(formattypekey,'')             AS  t_ADR_FORMAT_CD,  
         COALESCE(streetnumber,'')             AS  t_ADR_STREET_NO,  
         COALESCE(boxnumber,'')             AS  t_ADR_BOX_NO,   
         COALESCE(F_PDESC(predirtypekey,69),'')      AS  t_ADR_PRE_DIR_CD,  
         COALESCE(streetname,'')                   AS  t_ADR_STREET_NM,   
         COALESCE(F_PDESC(streetsuffixtypekey,212),'')  AS  t_ADR_STREET_SX_CD,   
         COALESCE(F_PDESC(postdirtypekey,69) ,'')    AS  t_ADR_POST_DIR_CD,   
         COALESCE(F_PDESC(unittypekey,250),'')    AS  t_ADR_UNIT_TYPE_CD,   
         COALESCE(unitnumbertx ,'')                 AS  t_ADR_UNIT_NO_TX,   
         COALESCE(cityname ,'')                    AS  t_ADR_CITY_NM,   
         COALESCE(adrcountytypekey ,'')                 AS  t_ADR_COUNTY_CD,
         COALESCE(F_PDESC(statetypekey,211) ,'')     AS  t_ADR_STATE_CD,   
         COALESCE(zip5no, NULL)                AS  t_ADR_ZIP5_NO,   
         COALESCE(zip4no, NULL)                AS  t_ADR_ZIP4_NO,
         COALESCE(direction,'')            AS  t_ADR_DIRECTION_TX,   
         COALESCE(foreignaddress,'')             AS  t_ADR_FOREIGN_TX,   
         COALESCE(foreignstate,'')             AS  t_ADR_FOREIGN_STTX,   
         COALESCE(country ,'')                  AS  t_ADR_COUNTRY_TX,   
         COALESCE(postalcode ,'')              AS  t_ADR_POSTAL_CD_TX
    FROM LDSSLOCATIONS
 WHERE LDSSLOCATIONS.adrcountytypekey = AS_ADR_TYPE_CD AND 
   LDSSLOCATIONS.activeflag = 1 AND
   LDSSLOCATIONS.location LIKE 'Return%';

RETURN F_ad_format(
  t_ADDRESS_ID ,
  t_ADR_FORMAT_CD ,
  t_EMP_SCHOOL_NM ,   
  t_ADR_STREET_NO ,    
  t_ADR_BOX_NO ,   
  t_ADR_PRE_DIR_CD ,  
  t_ADR_STREET_NM , 
  t_ADR_STREET_SX_CD ,
  t_ADR_POST_DIR_CD ,  
  t_ADR_UNIT_TYPE_CD ,  
  t_ADR_UNIT_NO_TX ,  
  t_ADR_CITY_NM ,  
  t_ADR_COUNTY_CD ,  
  t_ADR_STATE_CD ,  
  t_ADR_ZIP5_NO ,   
  t_ADR_ZIP4_NO ,   
  t_ADR_DIRECTION_TX ,  
  t_ADR_FOREIGN_TX ,  
  t_ADR_FOREIGN_STTX ,  
  t_ADR_COUNTRY_TX ,  
  t_ADR_POSTAL_CD_TX );

END ; 
 $function$

