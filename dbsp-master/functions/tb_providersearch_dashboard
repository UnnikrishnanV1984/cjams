CREATE OR REPLACE FUNCTION tb_providersearch_dashboard(searchobj json)
 RETURNS TABLE(totalcount bigint, providername character varying, providerfirstname character varying, providerlastname character varying, provider_id integer, taxid numeric, mail_code_tx character varying, provider_type character varying, balance_no numeric, receivable_original_amount_no numeric, under_payment numeric)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_Providerid INT;
    v_Clientid INT;
    v_ProviderName VARCHAR(50);
    v_Paymentid INT;
    v_taxid INT;
    v_Firstname varchar(50); 
    v_Lastname varchar(50);
 v_Mailcode varchar(50);
    v_Enteredby varchar(50);
 v_status text[];
    v_liPageNumber INT;                              
    v_liPageSize INT;
    v_pagenumber int;
 v_pageoffset int;
 v_receivable_type varchar(20);
 sortcolumn character varying;
 sortorder character varying;
 
BEGIN 
v_Providerid := searchobj ->> 'providerid';
v_Clientid := searchobj ->> 'clientid'; 
v_ProviderName := searchobj ->> 'providername';  
v_Paymentid := searchobj ->> 'paymentid';  
v_taxid := searchobj ->> 'taxid'; 
v_Firstname := searchobj ->> 'fname'; 
v_Lastname := searchobj ->> 'lname'; 
v_Mailcode := searchobj ->> 'mailcode';
v_liPageNumber := searchobj ->> 'pagenumber';
v_liPageSize := searchobj ->> 'pagesize'; 
v_Enteredby := searchobj ->> 'enteredby';
v_status := searchobj ->> 'writeoffstatus';
v_receivable_type := searchobj ->> 'receivable_type'; 
sortcolumn := searchobj ->> 'sortcolumn';
sortorder := searchobj ->> 'sortorder';
raise notice 'enteredby%',v_Enteredby;
 
IF COALESCE(v_liPageSize, 0) < 1 THEN                     
 v_liPageSize := 10;
END IF;

IF COALESCE(v_liPageNumber, 0) < 1 
THEN
 v_liPageNumber := 1; 
end if;

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

if(v_receivable_type = 'System')
then
return query
 
select count(1) over() as totalcount,(CASE WHEN (tp.provider_nm is null OR tp.provider_nm='') THEN CONCAT(tp.provider_first_nm,' ',tp.provider_last_nm) ELSE tp.provider_nm END) as providername,tp.provider_first_nm as providerfirstname,tp.provider_last_nm as providerlastname,
tp.provider_id,tp.tax_id_no as taxid
,tp.mail_code_tx AS     mail_code_tx
,
(
select value_tx from tb_picklist_values 
 where PICKLIST_type_id=155 
 AND delete_sw='N'
 AND active_sw='Y' 
 AND  TRIM(PICKLIST_VALUE_CD)=TRIM(tp.provider_category_cd)
) AS  providertype,

(
select sum(trdd.amount_no) from tb_receivable_detail trdd
 join tb_receivable_header ttrh on ttrh.receivable_id=trdd.receivable_id
 join tb_provider tp1 on tp1.provider_id =ttrh.provider_id 
 where trdd.receivable_detail_id :: character varying 
 not in 
 (
 select objectid from routing r
  join tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
   and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
  join tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
  where r.eventcode = 'MANREC' and trhr.provider_id = tp.provider_id
  and r.routingstatustypeid  in (73,75) and r.activeflag = 1 
 )
 and trdd.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
 and tp1.provider_id=  tp.provider_id 
 and tp1.delete_sw = 'N'
 and  ttrh.delete_sw='N'
 and trdd.delete_sw = 'N'
) as balance_no,

(
select sum(trdd.receivable_balance_no) from tb_receivable_detail trdd
 join tb_receivable_header ttrh on ttrh.receivable_id=trdd.receivable_id
 join tb_provider tp1 on tp1.provider_id =ttrh.provider_id 
 where trdd.receivable_detail_id :: character varying 
 not in 
 (
 select objectid from routing r
  join tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
   and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
  join tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
  where r.eventcode = 'MANREC' and trhr.provider_id = tp.provider_id
  and r.routingstatustypeid  in (73,75) and r.activeflag = 1 
 )
 and trdd.receivable_detail_id :: character varying  
     not in 
    (select receivable_detail_id from tb_receivable_collection_status where collection_status_cd = '775' and delete_sw = 'N' and active_sw = 'Y')
 and trdd.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
 and tp1.provider_id=  tp.provider_id 
 and tp1.delete_sw = 'N'
 and  ttrh.delete_sw='N'
 and trdd.delete_sw = 'N'
) as receivable_original_amount_no,

coalesce(
(
select sum(trde.receivable_balance_no) from routing r
 join tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
  and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
 join tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
 where r.eventcode = 'MANREC' --and r.objectid = '10000079'--and trhr.provider_id = 201900420
 and r.routingstatustypeid in (73) and r.activeflag = 1 
 and trhr.provider_id = tp.provider_id 
 and tp.delete_sw = 'N'
 and  trhr.delete_sw='N'
 and trde.delete_sw = 'N'
),0.00) as under_payment

from tb_provider tp 
join tb_receivable_header trh on trh.provider_id = tp.provider_id and trh.delete_sw = 'N'
join tb_receivable_detail trd on trd.receivable_id = trh.receivable_id and trd.delete_sw = 'N'
 and trd.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
left join tb_payment_detail tpd on tpd.payment_detail_id = trd.payment_detail_id and tpd.delete_sw = 'N'
where (v_Providerid is null or tp.provider_id=v_Providerid) 
and trd.manual_sw !='Y'
and (
 (case 
 when tp.provider_nm is not null 
  then (COALESCE(lower(tp.provider_nm) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%')  
 when tp.provider_nm is  null  
  then  ((COALESCE(lower(tp.provider_first_nm) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%') 
     or  (COALESCE(lower(tp.provider_last_nm) ,'') LIKE COALESCE(lower(v_ProviderName) ,'')||'%')) 
 or  (COALESCE(lower(concat (tp.provider_first_nm,' ',tp.provider_last_nm)) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%') end )
 or v_ProviderName is null  
 OR soundex(lower(trim(tp.provider_nm))) = soundex(lower(trim(v_ProviderName)))   
 OR soundex(lower(trim(tp.provider_first_nm))) = soundex(lower(trim(v_ProviderName)))
 OR soundex(lower(trim(tp.provider_last_nm))) = soundex(lower(trim(v_ProviderName)))
 )   
and (v_Paymentid is null or tpd.payment_id=v_Paymentid)
and (v_taxid is null or tp.tax_id_no=v_taxid)
AND (COALESCE(lower(tp.provider_first_nm) ,'') LIKE COALESCE(lower(v_Firstname) ,'')||'%')
AND (COALESCE(lower(tp.provider_last_nm) ,'') LIKE COALESCE(lower(v_Lastname) ,'')||'%')
and (v_Mailcode is null or tp.mail_code_tx=v_Mailcode)
and (v_status is null or trd.write_off_approval_status= ANY (v_status))
group by 
 providername, providerfirstname, providerlastname,
 tp.provider_id,tp.tax_id_no,providertype,tp.mail_code_tx 
LIMIT v_liPageSize OFFSET v_pageoffset; 

else if(v_receivable_type = 'Manual') then

return query
 select count(1) over() as totalcount,
 (CASE WHEN (prov.provider_nm is null OR prov.provider_nm='') 
  THEN CONCAT(prov.provider_first_nm,' ',prov.provider_last_nm) 
  ELSE prov.provider_nm END) as providername,prov.provider_first_nm as providerfirstname,prov.provider_last_nm as providerlastname,
 prov.provider_id,prov.tax_id_no as taxid, prov.mail_code_tx AS mail_code_tx,
 (select value_tx from tb_picklist_values where PICKLIST_type_id=155 AND delete_sw='N'
  AND active_sw='Y' AND  TRIM(PICKLIST_VALUE_CD)=TRIM(prov.provider_category_cd)) AS  providertype,

 (select sum(trdd.amount_no) from tb_receivable_detail trdd
  join tb_receivable_header ttrh on ttrh.receivable_id=trdd.receivable_id
  join tb_provider tp on tp.provider_id =ttrh.provider_id 
  where trdd.receivable_detail_id :: character varying 
  not in 
  (
  select objectid from routing r
   join tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
    and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
   join tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
   where r.eventcode = 'MANREC' and trhr.provider_id = prov.provider_id
   and r.routingstatustypeid  in (73,75) and r.activeflag = 1 
  )
  and trdd.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
  and tp.provider_id=  prov.provider_id 
  and tp.delete_sw = 'N'
  and  ttrh.delete_sw='N'
  and trdd.delete_sw = 'N'
 ) as balance_no,
 
 (
 select sum(trdd.receivable_balance_no) from tb_receivable_detail trdd
 join tb_receivable_header ttrh on ttrh.receivable_id=trdd.receivable_id
 join tb_provider tp on tp.provider_id =ttrh.provider_id 
 where trdd.receivable_detail_id :: character varying 
 not in 
 (
 select objectid from routing r
  join tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
   and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
  join tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
  where r.eventcode = 'MANREC' and trhr.provider_id = prov.provider_id
  and r.routingstatustypeid  in (73,75) and r.activeflag = 1 
 )
 and trdd.receivable_detail_id :: character varying  
     not in 
    (select receivable_detail_id from tb_receivable_collection_status where collection_status_cd = '775' and delete_sw = 'N' and active_sw = 'Y')
 and trdd.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
 and tp.provider_id=  prov.provider_id and  ttrh.delete_sw='N'
 and tp.delete_sw = 'N'
 and trdd.delete_sw = 'N'
 ) as receivable_original_amount_no,
 
 (
 select sum(trde.receivable_balance_no) from routing r
  join tb_receivable_detail trde on trde.receivable_detail_id :: character varying = r.objectid
   and trde.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
  join tb_receivable_header trhr on trhr.receivable_id=trde.receivable_id
  where r.eventcode = 'MANREC' --and r.objectid = '10000079'--and trhr.provider_id = 201900420
  and r.routingstatustypeid in (73) and r.activeflag = 1 
  and trhr.provider_id = prov.provider_id and  trhr.delete_sw='N'
  and trde.delete_sw = 'N'
 ) as under_payment
 
from tb_payment_header as payhead
inner join tb_payment_detail as paydet on payhead.payment_id = paydet.payment_id and paydet.delete_sw = 'N'
inner join tb_provider as prov on payhead.provider_id = prov.provider_id and prov.delete_sw = 'N'
left join tb_receivable_header trh on trh.provider_id = prov.provider_id and trh.delete_sw = 'N'
left join tb_receivable_detail trd on trd.receivable_id = trh.receivable_id  and trd.manual_sw ='Y' and trd.delete_sw = 'N'
 and trd.county_cd in (select statecountycode from county where golivedate <= CURRENT_DATE)
where payhead.payment_type_cd = '4'
and (v_Providerid is null or prov.provider_id=v_Providerid)
and ( (case when prov.provider_nm is not null then (COALESCE(lower(prov.provider_nm) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%')  
          when prov.provider_nm is  null  then  ((COALESCE(lower(prov.provider_first_nm) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%') or  (COALESCE(lower(prov.provider_last_nm) ,'') LIKE COALESCE(lower(v_ProviderName) ,'')||'%')) or 
          (COALESCE(lower(concat (prov.provider_first_nm,' ',prov.provider_last_nm)) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%') end )
  or v_ProviderName is null  
  OR soundex(lower(trim(prov.provider_nm))) = soundex(lower(trim(v_ProviderName)))   
  OR soundex(lower(trim(prov.provider_first_nm))) = soundex(lower(trim(v_ProviderName)))
  OR soundex(lower(trim(prov.provider_last_nm))) = soundex(lower(trim(v_ProviderName))))  
  
and (v_Paymentid is null or paydet.payment_id=v_Paymentid)
and (v_taxid is null or prov.tax_id_no=v_taxid)
AND (COALESCE(lower(prov.provider_first_nm) ,'') LIKE COALESCE(lower(v_Firstname) ,'')||'%')
AND (COALESCE(lower(prov.provider_last_nm) ,'') LIKE COALESCE(lower(v_Lastname) ,'')||'%')
and (v_Mailcode is null or prov.mail_code_tx=v_Mailcode)
group by 
 providername, providerfirstname, providerlastname,
 prov.provider_id,prov.tax_id_no,providertype,prov.mail_code_tx 
LIMIT v_liPageSize OFFSET v_pageoffset; 

else 

return query

