          when tp.provider_nm is  null  then  ((COALESCE(lower(tp.provider_first_nm) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%')
          or  (COALESCE(lower(tp.provider_last_nm) ,'') LIKE COALESCE(lower(v_ProviderName) ,'')||'%')) 
          or  (COALESCE(lower(concat (tp.provider_first_nm,' ',tp.provider_last_nm)) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%') end 
   )
  or v_ProviderName is null  
