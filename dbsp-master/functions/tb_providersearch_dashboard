    or (COALESCE(lower(prov.provider_last_nm) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%')
   )
   or (COALESCE(lower(concat (prov.provider_first_nm,' ',prov.provider_last_nm)) ,'') LIKE '%'||COALESCE(lower(v_ProviderName) ,'')||'%') end 
  )
  or v_ProviderName is null  
  OR soundex(lower(trim(prov.provider_nm))) = soundex(lower(trim(v_ProviderName)))   
  OR soundex(lower(trim(prov.provider_first_nm))) = soundex(lower(trim(v_ProviderName)))
  OR soundex(lower(trim(prov.provider_last_nm))) = soundex(lower(trim(v_ProviderName)))) 
and (v_Paymentid is null or paydet.payment_id=v_Paymentid)
and (v_taxid is null or prov.tax_id_no=v_taxid)
AND (COALESCE(lower(prov.provider_first_nm) ,'') LIKE COALESCE(lower(v_Firstname) ,'')||'%')
AND (COALESCE(lower(prov.provider_last_nm) ,'') LIKE COALESCE(lower(v_Lastname) ,'')||'%')
and (v_Mailcode is null or prov.mail_code_tx=v_Mailcode)
group by 
 providername, providerfirstname, providerlastname,
 prov.provider_id,prov.tax_id_no,providertype,prov.mail_code_tx )
) as x
group by 
 x.receivable_original_amount_no,x.balance_no, x.providername, x.providerfirstname, x.providerlastname,
 x.provider_id,x.taxid,x.providertype,x.mail_code_tx ,x.under_payment
order by (case when (v_ProviderName is not null or trim(v_ProviderName) !='') then levenshtein((case when x.providername is not null then x.providername else (concat_ws(' ',x.providerfirstname, x.providerlastname) )end),(lower( trim( v_ProviderName) )),1,0,4)
   end )

) as z
order by 
 case when lower(trim(sortorder)) = 'asc' then 
  case 
   when sortcolumn = 'providername' then z.providername ::varchar 
   when sortcolumn = 'providertype' then z.providertype ::varchar
   when sortcolumn = 'mailcode'   then z.mail_code_tx ::varchar
  end    
 end asc, 
 case  when lower(trim(sortorder)) = 'desc' then 
  case 
   when sortcolumn = 'providername' then z.providername  ::varchar
   when sortcolumn = 'providertype' then z.providertype ::varchar 
   when sortcolumn = 'mailcode'   then z.mail_code_tx ::varchar
  end 
 end  desc nulls last, 
 case when lower(trim(sortorder)) = 'asc' then 
  case when sortcolumn = 'providerid'   then z.provider_id 
   when sortcolumn = 'receivableamount' then z.receivable_original_amount_no 
   when sortcolumn = 'underpayment' then z.under_payment
   when sortcolumn = 'taxid'        then z.taxid
  end 
 end asc, 
 case  when lower(trim(sortorder)) = 'desc' then 
  case when sortcolumn = 'providerid'   then z.provider_id 
   when sortcolumn = 'receivableamount' then z.receivable_original_amount_no
   when sortcolumn = 'underpayment' then z.under_payment 
   when sortcolumn = 'taxid'        then z.taxid
  end 
 end  desc nulls last
LIMIT v_liPageSize OFFSET v_pageoffset; 

end if;
end if;

END;

