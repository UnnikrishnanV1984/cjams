CREATE OR REPLACE FUNCTION as_updaterecondates(v_intakeserviceid uuid, v_servicesubtypeid uuid, v_securityusersid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
--v_message character varying(100);
l_response    json;
BEGIN
 
update asservicesoncase
set recon_due_dt = (now() + (select srtc.duedateoffset from servicerequesttypeconfig srtc , servicerequestsubtype srst, intakeserv ints
         where srtc.servicerequestsubtypeid = srst.servicerequestsubtypeid and srtc.activeflag=1 and srtc.workload  = 1 and
         srst.activeflag =1 and srst.classkey  = ints.intakeservtypekey and ints.intakeservid = v_servicesubtypeid and  
         ints.activeflag=1 limit 1)-1),
recon_done_dt = now(), 
updatedon = now(), 
updatedby = v_securityusersid
where ascaseid = v_intakeserviceid and
caseservicetypeid = v_servicesubtypeid and
((approvalstatus = 'approved') or 
(approvalstatus = 'draft' and enddate is not null) or
(approvalstatus = 'review' and enddate is not null))  and
activeflag=1;

--v_message := 'Recon Due Date and Recon Completed Date updated Successfully';


SELECT json_agg(x)   INTO l_response FROM (
  select * from asservicesoncase
where ascaseid = v_intakeserviceid and
caseservicetypeid = v_servicesubtypeid and
((approvalstatus = 'approved') or 
(approvalstatus = 'draft' and enddate is not null) or
(approvalstatus = 'review' and enddate is not null))  and
activeflag=1) x;

return l_response;
 
--return  v_message;  

END;

$function$

