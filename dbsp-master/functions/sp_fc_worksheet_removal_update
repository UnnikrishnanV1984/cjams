CREATE OR REPLACE FUNCTION sp_fc_worksheet_removal_update(client_id bigint, rsn_for_exit character varying, prvs_fc_exit_dt timestamp without time zone)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
        al_client_id                                                            BIGINT;
  vs_rsn_for_exit               VARCHAR(100);
  vd_prvs_fc_exit_dt              DATE;
        response                                                                VARCHAR(50);
 BEGIN
    al_client_id           := client_id;
    vs_rsn_for_exit        := rsn_for_exit;
    vd_prvs_fc_exit_dt     := prvs_fc_exit_dt;
    response               := 'sucess';

-- Reason For Exit--
update intakeservreqchildremoval
set removalreasontypekey = vs_rsn_for_exit
where intakeserviceid = (
 SELECT isrcr.intakeserviceid  
   FROM intakeservicerequestcourtaction isrca, intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra
WHERE  
 isrca.intakeservicerequestid = isrcr.intakeserviceid AND isrca.activeflag = 1
 AND isra.intakeserviceid = isrcr.intakeserviceid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestpersontypekey = 'RC' AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1);    
   
-- Previous FC Episode Exit Care Date--  
update intakeservreqchildremoval
set returndate = vd_prvs_fc_exit_dt
where intakeserviceid = (
 SELECT isrcr.intakeserviceid
   FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra 
WHERE isra.intakeserviceid = isrcr.intakeserviceid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestpersontypekey = 'RC' AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1);
  

    
RETURN response;

   END
    
$function$

