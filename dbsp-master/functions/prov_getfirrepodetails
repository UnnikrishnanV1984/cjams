CREATE OR REPLACE FUNCTION prov_getfirrepodetails(v_fir_no character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
jsondata  json;
BEGIN
SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT pfirrepo.*, tp.provider_nm  , tp1.provider_nm as provider_name ,pf.fir_no, pf.site_id
FROM provider_fir_repodetails pfirrepo
join provider_fir pf on pf.fir_no = pfirrepo.fir_no
join tb_provider tp on tp.provider_id = pf.site_id 
join tb_provider tp1 on tp1.provider_id = pf.provider_id 
where pfirrepo.fir_no=v_fir_no 


   )  a;

RETURN  jsondata;
END;

$function$

