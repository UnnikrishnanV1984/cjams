CREATE OR REPLACE FUNCTION getsafetyplan(v_intakeserviceid uuid, v_externalid character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(versionid uuid, intakeserviceid uuid, externaltemplateid character varying, submissionid character varying, plandate timestamp without time zone, templatename character varying, servicerequestnumber character varying, safetyplanid uuid, savemode integer, dangerinfluence json, safetyplanactor jsonb)
 LANGUAGE plpgsql
AS $function$

DECLARE    v_pageoffset  int;
                  v_pagenumber  int;
  
    

BEGIN
            
        v_pagenumber  :=  pagenumber-1;
        v_pageoffset  =  v_pagenumber  *  pagesize;
  
RETURN  QUERY
                  
 SELECT  irsp1.versionid,  
               irsp1.intakeserviceid,  
               irsp1.external_templateid,  
               irsp1.submissionid  AS  submitid,  
               irsp1.plandate,  
               a.name  ::  CHARACTER  VARYING,  
               isr.servicerequestnumber,  
               irsp1.safetyplanid,  
               irsp1.savemode,  
               (SELECT  Json_agg(e1)  
  FROM      (SELECT  irsp.dangerinfluencenumber,  
                 irsp.dangerinfluencedesc,  
                 irsp.completiondate,  
                 irsp.partiesname,  
                 irsp.reevaluationdate,  
                 irsp.actiondescription  
   FROM      safetyplanaction  irsp  
   WHERE    irsp.safetyplanid  =  irsp1.safetyplanid  
   ORDER    BY  irsp.completiondate)  e1)  ::  json  AS  dangerinfluence,  
               (SELECT  Json_agg(actor)  
  FROM      (SELECT  spa.signimage,  
    spa.issignrefuse,
                 spa.intakeservicerequestactorid,  
                 isra.personid,  
                 p.firstname  AS  firstname,  
                 p.lastname    AS  lastname,  
                 isra.actorid,  
                 at.actortype,  
                 at.typedescription  
   FROM      safetyplanactor  spa  
   LEFT  JOIN  intakeservicerequestactor  isra  ON  isra.intakeservicerequestactorid  =  spa.intakeservicerequestactorid  
   LEFT  JOIN  person  p  ON  p.personid  =  isra.personid  
   LEFT  JOIN  actortype  at  ON  at.actortype  =  isra.intakeservicerequestpersontypekey  
   WHERE    spa.safetyplanid  =  irsp1.safetyplanid)actor)  ::  jsonb  AS  safetyplanactor  
 FROM      safetyplan  irsp1  
               INNER  JOIN  assessmenttemplate  a  ON  a.assessmenttemplateid  =  irsp1.assessmenttemplateid  AND  irsp1.external_templateid  =  a.external_templateid  
               INNER  JOIN  intakeservicerequest  isr  ON  isr.intakeserviceid  =  irsp1.intakeserviceid  
 WHERE    irsp1.intakeserviceid  =  v_intakeserviceid
               AND  a.activeflag  =  1  
 GROUP    BY  irsp1.versionid,  
      irsp1.intakeserviceid,  
      irsp1.external_templateid,  
      irsp1.submissionid,  
      irsp1.plandate,  
      a.name,  
      isr.servicerequestnumber,  
      irsp1.safetyplanid,  
      irsp1.savemode  
 ORDER    BY  Max(irsp1.activeflag)  DESC,  
      Max(irsp1.insertedon)  DESC  
 LIMIT    pagesize  OFFSET  v_pageoffset;  
      
END;

$function$

