CREATE OR REPLACE FUNCTION f_supervisor(ai_staff_id character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare ai_entity_cd varchar(5);
    declare ai_case_cd varchar(5);
BEGIN

Return
(
    SELECT cast(tb_staff.staff_id as integer)
 FROM tb_staff 
 WHERE tb_staff.staff_id = ( SELECT TB_COUNTY_UNIT.UNIT_SUPERVISOR_ID 
  FROM TB_STAFF  , TB_COUNTY_UNIT  WHERE TB_STAFF.STAFF_ID = ai_staff_id  AND  
  TB_COUNTY_UNIT.COUNTY_CD = TB_STAFF.PRIMARY_COUNTY_CD AND   
  TB_COUNTY_UNIT.COUNTY_UNIT_ID = TB_STAFF.PRIMARY_COUNTY_UNIT_ID and 
  TB_COUNTY_UNIT.DELETE_SW <> 'Y' AND  TB_STAFF.DELETE_SW <> 'Y' ) 
);
END;

$function$

