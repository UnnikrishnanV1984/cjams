CREATE OR REPLACE FUNCTION as_getactivitytaskbyuser(userid character varying, pageno integer, pagesize integer, filterdatetype character varying, sortcolumn character varying, sortorder character varying)
 RETURNS TABLE(activityid uuid, activitytaskid uuid, actvityname text, duedate timestamp without time zone, task character varying, required boolean, assignedon timestamp without time zone, completeddate timestamp without time zone, activitytasktypekey character varying, insertedon timestamp without time zone, assignloadnumber character varying, activitytaskstatustypekey character varying, taskdescription text, intakeserviceid uuid, servicerequestnumber character varying, legalguardian character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE v_pageoffset int;
  v_pagenumber int;
  v_DateFrom TIMESTAMP;                        
  v_DateTo TIMESTAMP; 
  
BEGIN
 v_pagenumber := pageno-1;
 v_pageoffset = v_pagenumber * pagesize;
    
    IF filterdatetype = 'Nex30' THEN 
         SELECT now() INTO v_DateFrom ; 
         SELECT now() + interval '30' DAY INTO v_DateTo;
    END IF;
    IF filterdatetype = 'Nex60' THEN 
         SELECT now() INTO v_DateFrom ; 
         SELECT now() + interval '60' DAY INTO v_DateTo;
    END IF;
    IF filterdatetype = 'Nex90' THEN 
         SELECT now() INTO v_DateFrom ; 
         SELECT now() + interval '90' DAY INTO v_DateTo;
    END IF;
    
     IF filterdatetype = 'Prev30' THEN 
         SELECT now() INTO v_DateTo ; 
         SELECT now() - interval '30' DAY INTO v_DateFrom;
    END IF;
    IF filterdatetype = 'Prev60' THEN 
         SELECT now() INTO  v_DateTo; 
         SELECT now() - interval '60' DAY INTO  v_DateFrom;
    END IF;
    IF filterdatetype = 'Prev90' THEN 
         SELECT now() INTO v_DateTo ; 
         SELECT now() - interval '90' DAY INTO v_DateFrom;
    END IF;
    
RETURN QUERY  
select * from (

SELECT 
act.ActivityId, 
 acttask.ActivityTaskId, 
 act.description, 
 acttask.duedate, 
 acttask.name As task,
 acttask.Required , 
 acttask.AssignedOn ,
 --atst.description as taskstatus,
acttask.completeddate,
acttask.ActivityTaskTypeKey,
acttask.insertedon, 
acttask.assignedto as assignloadnumber,
acttask.ActivityTaskStatusTypeKey,
acttask.description as taskdescription,
ISR.intakeserviceid,
ISR.servicerequestnumber,
(select concat(per.firstname , ' ' , per.lastname)::character varying as legalguardian from intakeservicerequestactor isra join person per on isra.personid = per.personid and per.activeflag=1 where isra.intakeserviceid = ISR.intakeserviceid and isra.activeflag = 1 and isra.intakeservicerequestpersontypekey in ('RA','AV') LIMIT 1)
FROM intakeservicerequest AS ISR 
INNER JOIN caseassignment CA ON CA.objectid = ISR.intakeserviceid AND CA.enddate IS NULL AND CA.activeflag = 1 AND ISR.activeflag=1
--INNER JOIN AreaTeamMemberServiceRequest  AS ATSR  ON  ATSR.IntakeServiceId   = ISR.IntakeServiceId AND   ATSR.ActiveFlag = 1 AND ISR.activeflag=1                                                           
--INNER JOIN TeamMember AS TM  ON  ATSR.TeamMemberId   = TM.TeamMemberId  AND TM.activeflag=1                                                                
--INNER JOIN as_teammemberassignment   AS TMA  ON  TMA.TeamMemberId   = ATSR.TeamMemberId     AND TMA.ActiveFlag = 1                                                     
INNER JOIN Investigation invst ON ISR.intakeserviceid=invst.intakeserviceid and invst.activeflag=1
INNER JOIN Activity act on invst.investigationid = act.objectid and act.activeflag=1
INNER JOIN Activitytask acttask on act.activityid = acttask.activityid  and acttask.activeflag = 1 
--and TMA.securityusersid = userid
and CA.toworkeridno = userid  and acttask.activitytaskstatustypekey NOT IN ('InvClosed')
AND (v_DateFrom IS NULL OR (CAST( acttask.duedate AS DATE) between CAST(v_DateFrom AS DATE) AND CAST(v_DateTo AS DATE)))  
WHERE ISR.teamtypekey = 'AS' and ( ISR.isclosecpshistory is null or ISR.isclosecpshistory!=1 )
) as atl
--order by duedate asc 


  ORDER BY 
   -- duedate asc
 
   CASE sortorder
     WHEN 'asc' THEN
      CASE sortcolumn 
       WHEN 'duedate' THEN cast( atl.duedate as character varying) 
       when 'servicerequestnumber' then atl.servicerequestnumber
       when 'task' then  atl.task 
       when 'focusperson' then atl.legalguardian
       when 'taskstatustype' then  atl.ActivityTaskStatusTypeKey
       
       END
 END 
 ASC,
 CASE sortorder
      WHEN 'desc' THEN
       CASE sortcolumn 
       WHEN 'duedate' THEN cast( atl.duedate as character varying) 
       when 'servicerequestnumber' then atl.servicerequestnumber
       when 'task' then  atl.task
       when 'focusperson' then atl.legalguardian
       when 'taskstatustype' then  atl.ActivityTaskStatusTypeKey
       END
 END
 desc 


 
LIMIT pagesize OFFSET v_pageoffset;     
END;


$function$

