CREATE OR REPLACE FUNCTION get_service_plan_list(v_serviceplanactionid uuid, pagenumber bigint, pagesize bigint)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_pageoffset  int;
 v_pagenumber  int;  
 l_serviceplan json;
BEGIN
        v_pagenumber  :=  pagenumber-1;
        v_pageoffset  =  v_pagenumber  *  pagesize;
    
     SELECT json_agg(e) INTO l_serviceplan FROM(SELECT count(1)  over() as totalcount,sp.serviceplanid,sp.serviceplanname, sp.effectivedate, sp.targetenddate

FROM serviceplanaction sa 
JOIN splanobjective sf on sa.splanobjectiveid=sf.splanobjectiveid
JOIN splangoal sg on sg.splangoalid = sf.splangoalid
JOIN serviceplan sp on sp.serviceplanid=sg.serviceplanid
WHERE sa.serviceplanactionid=v_serviceplanactionid::uuid 
--LIMIT  pagesize  OFFSET  v_pageoffset          
      )e ;
RETURN l_serviceplan;
END;

$function$

