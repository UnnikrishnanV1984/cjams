CREATE OR REPLACE FUNCTION getchildremoval_invsummary(v_intakeserviceid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE 
l_childremoval json;

begin  

 SELECT Json_agg(a) 
  INTO   l_childremoval 
     FROM   (

   SELECT CR.insertedon, 
          COALESCE(cr.removaladd1, '') 
          || ' ' 
          || COALESCE(cr.removaladd2, '') 
          || COALESCE(cr.removalcity, '') 
          || COALESCE(cr.removalzip, '') AS address, 
          P.lastname 
          || ', ' 
          || P.firstname                 AS Removedfrom, 
          (SELECT Json_agg(e) 
    FROM  (SELECT rr.description 
           FROM   intakeservreqchildremovalreason CRR 
           INNER JOIN removalreasontype RR 
            ON RR.removalreasontypekey = 
        CRR.removalreasontypekey 
        AND rr.activeflag = 1 
           WHERE  crr.activeflag = 1 
           AND crr.intakeservreqchildremovalid = 
        CR.intakeservreqchildremovalid) AS 
          e)  reason 
   FROM   intakeservreqchildremoval CR 
          LEFT JOIN person P 
          ON p.personid = cr.rmvdfrmisractorid 
      AND P.activeflag = 1 
    where CR.intakeserviceid = v_intakeserviceid
                  ) a;

  RETURN  l_childremoval;   
                  

 END;
 $function$

