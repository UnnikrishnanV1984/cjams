CREATE OR REPLACE FUNCTION as_placementreleasereasonyouthstatus(v_placementid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare 
v_savefocuspersoncasestatus character varying;
v_count bigint;
v_releasereason character varying;
v_intakenumber  character varying;
v_intakeserviceid  uuid;
v_personid uuid;

Begin

select  count(1) over(),p.intakeserviceid, isra.personid,  isr.intakenumber
into v_count ,v_intakeserviceid,v_personid, v_intakenumber 
from placement p
inner join placementrelease   pr on p.placementid = pr.placementid and pr.activeflag =1
inner join intakeservicerequest isr on p.intakeserviceid = isr.intakeserviceid and isr.activeflag =1
inner join intakeservicerequesttype isrt on isr.intakeservreqtypeid = isrt.intakeservreqtypeid and isrt.activeflag =1
inner join intakeservicerequestactor isra on isra.intakeserviceid = isr.intakeserviceid and isra.activeflag =1
where 
 p.activeflag =1 
 and lower(isra.intakeservicerequestpersontypekey) = 'youth'
 and isrt.intakeservreqtypekey = 'AH'
 and pr.releasereason not  in ('CD','ATD') 
 and pr.placementid =v_placementid;

 if v_count = 1 then 
 
   SELECT savefocuspersoncasestatus into v_savefocuspersoncasestatus
    FROM as_savefocuspersoncasestatus(v_personid,v_intakeserviceid,v_intakenumber,'DET',
    'Closed','admin', null, null);
 end if ;
 
 
Return 'Success'        ;

End;
$function$

