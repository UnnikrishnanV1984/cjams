CREATE OR REPLACE FUNCTION as_createduplicateserviceplan(oldintakeserviceid uuid, newintakeserviceid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

DECLARE

v_goalid uuid;
--serviceplangoals json;
v_oldintakeserviceid uuid;
v_newintakeserviceid uuid;

begin
 
 v_oldintakeserviceid=oldintakeserviceid;
 v_newintakeserviceid=newintakeserviceid;
 
  DROP TABLE IF EXISTS tmp_status;
  DROP TABLE IF EXISTS tmp_status_log;
   
    CREATE TEMP TABLE   tmp_status ( v_goalid uuid,oldintakeserviceid uuid);
   
   
   
    CREATE TEMP TABLE   tmp_status_log ( v_activityid uuid,oldintakeserviceid uuid);
 
 INSERT INTO serviceplangoal
( goaldate, goal, strategy, effectivedate, insertedby, insertedon, objecttypekey, objectid, serviceplanid, objectivestatustypekey, objectiveid, goaltypekey, isprojecthome, initialcondition, goalscategorytype, plannedstartdate, plannedenddate, challenges, strengths)

SELECT 
 goaldate, goal, strategy, effectivedate, insertedby, insertedon, objecttypekey, v_newintakeserviceid, serviceplanid, objectivestatustypekey, objectiveid, goaltypekey, isprojecthome, initialcondition, goalscategorytype, plannedstartdate, plannedenddate, challenges, strengths
FROM serviceplangoal where objectid=v_oldintakeserviceid::character varying;


 INSERT INTO tmp_status(v_goalid,oldintakeserviceid)        
select serviceplangoalid,v_oldintakeserviceid  from serviceplangoal where objectid=v_newintakeserviceid::character varying;


 INSERT INTO serviceplanactivity
 
( activity, servicetypekey, servicesubtypekey, personinvolved, responsibleperson, reevaluationdate, 
completiondate, serviceplangoalid, serviceplanactivitystatustypekey, activeflag, effectivedate, 
insertedby, updatedby, insertedon, updatedon, old_id, objecttypekey, objectid, serviceplanid, 
personid, staffid, taskideatypekey, datavalidflag, clientmergeid, fk_id, activitysubtypekey,
need, otherservicetypedescription, othersubtypedescription, otherreason, reasontypekey, 
serviceunavailable, initialcondition, personsinvolvedid, responsiblepersonid, plannedstartdate, 
plannedenddate, progressnote, responsiblepersontype, otherresponsibleperson, approvalstatus)

SELECT  spa.activity, spa.servicetypekey, spa.servicesubtypekey, spa.personinvolved, spa.responsibleperson, spa.reevaluationdate, 
spa.completiondate, tmp.v_goalid, spa.serviceplanactivitystatustypekey, spa.activeflag, spa.effectivedate, 
spa.insertedby, spa.updatedby, spa.insertedon, spa.updatedon, spa.old_id, spa.objecttypekey, v_newintakeserviceid,
spa.serviceplanid, spa.personid, spa.staffid, spa.taskideatypekey, spa.datavalidflag, spa.clientmergeid,
spa.fk_id, spa.activitysubtypekey, spa.need, spa.otherservicetypedescription, spa.othersubtypedescription, spa.otherreason, spa.reasontypekey, 
spa.serviceunavailable, spa.initialcondition, spa.personsinvolvedid, spa.responsiblepersonid, spa.plannedstartdate, spa.plannedenddate,
spa.progressnote, spa.responsiblepersontype, spa.otherresponsibleperson, spa.approvalstatus
FROM serviceplanactivity spa
inner join tmp_status tmp on tmp.oldintakeserviceid::character varying=spa.objectid
where objectid=v_oldintakeserviceid::character varying;


 INSERT INTO tmp_status_log(v_activityid,oldintakeserviceid)        
select serviceplanactivityid,v_oldintakeserviceid  from serviceplanactivity where objectid=v_newintakeserviceid::character varying;



INSERT INTO serviceplanlog
( serviceplanactivityid, objecttypekey, objectid, providerid, providercontracttypekey, providercontractrateid,
startdate, enddate, isrepeats, noofoccurence, rate, reason, serviceplanlogstatustypekey, activeflag, 
effectivedate, insertedby, updatedby, insertedon, updatedon, old_id, noofweeks, noofhours, providertypekey,
familyworkername, servicecategorytypekey, categorysubtypekey, serviceplanvendorid, securityusersid,
countyid, careworkername)

SELECT  tmpa.v_activityid, spl.objecttypekey, spl.objectid, spl.providerid, spl.providercontracttypekey, spl.providercontractrateid, 
spl.startdate, spl.enddate, spl.isrepeats, spl.noofoccurence, spl.rate, spl.reason, spl.serviceplanlogstatustypekey, spl.activeflag,
spl.effectivedate, spl.insertedby, spl.updatedby, spl.insertedon, spl.updatedon, spl.old_id, spl.noofweeks, spl.noofhours, spl.providertypekey, 
spl.familyworkername, spl.servicecategorytypekey, spl.categorysubtypekey, spl.serviceplanvendorid, spl.securityusersid,
spl.countyid, spl.careworkername
FROM serviceplanlog spl 
inner join tmp_status_log tmpa on tmpa.oldintakeserviceid::character varying=spl.objectid;


RETURN 'Sucess';

 
END





                                                      


$function$

