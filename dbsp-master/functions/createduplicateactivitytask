CREATE OR REPLACE FUNCTION createduplicateactivitytask(v_intakeserviceid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

  declare 
  
   rec record;
   query text;
  
         j record;
         v_activitytaskid uuid;
   begin
   
 FOR  rec  IN  select astt.activitytaskid, astt.amtaskid,astt.updatedon, asa.updatedon from  activitytask astt join activity a on a.activityid=astt.activityid and a.activeflag=1
           join investigation iv on iv.investigationid=a.objectid and iv.activeflag=1
           join amactivity aa on aa.amactivityid=a.amactivityid and aa.activeflag=1
           left join ( select ast.amtaskid,max(ast.updatedon) as updatedon from activitytask ast 
          join activity as ac on ac.activityid=ast.activityid and ast.activeflag=1
             join investigation ivs on ivs.investigationid=ac.objectid and ivs.activeflag=1
              join amactivity aa on aa.amactivityid=ac.amactivityid and aa.activeflag=1
             where ivs.intakeserviceid=v_intakeserviceid and aa.iscontinue=true
           and ast.taskdispositiontypekey='Continued'
            group by ast.amtaskid) as asa on asa.updatedon=astt.updatedon and asa.amtaskid = astt.amtaskid
           where iv.intakeserviceid=v_intakeserviceid and aa.iscontinue=true
           and astt.taskdispositiontypekey='Continued' and astt.activitytaskstatustypekey='InvClosed'and astt.iscontinual=false
            
    
   LOOP
    
    v_activitytaskid   :=    rec.activitytaskid;
    RAISE  NOTICE  '  activitytaskid  %',v_activitytaskid; 
     update activitytask set iscontinual=true where activitytaskid=v_activitytaskid;
    
     insert into activitytask (activityid,name,description,amtaskid,assignedto,assignedon,duedate,
     activitytaskstatustypekey,activitytasktypekey,activityprioritytypekey,required,insertedby,reminderdate,iscontinual,iseditable )
     
     select activityid,name,description,amtaskid,assignedto,completeddate,(completeddate+ interval '1' day * 180 ),'InvOpen'
     activitytasktypekey,activitytasktypekey,activityprioritytypekey,required,insertedby,((completeddate+ interval '1' day * 135 )) as reminderdate,false,true   from activitytask 
     where activitytaskid=v_activitytaskid and activeflag=1;
       
   END LOOP;

return 'success';
                          
end;

$function$

