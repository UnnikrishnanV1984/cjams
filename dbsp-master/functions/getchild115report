CREATE OR REPLACE FUNCTION getchild115report(v_providerid integer, date_sw character varying, date_from date, date_to date)
 RETURNS TABLE(child115report json)
 LANGUAGE plpgsql
AS $function$

BEGIN
return QUERY 
(SELECT json_agg(x) from (
SELECT distinct MAIN.*
 ,TAB.RECEIPT_ID
 ,TAB.RECEIPT_DT
 ,F_PDESC(TAB.PAYMENT_METHOD_CD,5) AS PAYMENT_METHOD_CD
 ,TAB.PAYMENT_NO_TX
 ,TAB.PAYMENT_AMOUNT_NO
 ,TAB.COLLECTED_AMOUNT_NO
 ,TAB.TRAN_TYPE
-- ,V_FROMDATE AS FROM_DATE_ARG
 ,date_from as FROM_DATE_ARG
-- ,V_TODATE AS TO_DATE_ARG
 ,date_to as TO_DATE_ARG
 ,F_PDESC(NULL, 7) AS AR_STATUS_ARG 
 ,F_PDESC(NULL, 52) AS COLLECTION_STATUS_ARG

FROM 
(
SELECT
 PR.PROVIDER_ID
 , F_ENAME('2953',PR.PROVIDER_ID) AS PROVIDER_NAME
 
 ,concat('',COALESCE((select sum(trdd.receivable_balance_no) from tb_receivable_detail trdd
join tb_receivable_header ttrh on ttrh.receivable_id=trdd.receivable_id
join tb_provider tp on tp.provider_id =ttrh.provider_id where tp.provider_id=  pr.provider_id
),0.00)) as total_balance_due

 ,(CASE WHEN PR.PROV_TAX_TYPE_CD = '2518' THEN
  (CONCAT('***-**-',RIGHT(PR.TAX_ID_NO::VARCHAR,4)))
  ELSE 
  LEFT(PR.TAX_ID_NO::VARCHAR,2) || '-' || SUBSTR(PR.TAX_ID_NO::VARCHAR ,2, LENGTH(PR.TAX_ID_NO::VARCHAR))
  END 
 )AS TAXID
 ,PR.MAIL_CODE_TX AS MAIL_CODE
 ,F_PDESC(PR.PROV_TAX_TYPE_CD,216) AS TAX_ID_TYPE
 ,(SELECT CASE WHEN PP.OFFSET_SW = 'Y' THEN 'OFFSET'
   ELSE 'RECOVERY' END
  FROM TB_PAYMENT_PLAN PP 
   WHERE PP.RECEIVABLE_ID = RH.RECEIVABLE_ID AND   
    PP.DELETE_SW = 'N'
    ORDER BY END_DT DESC
    FETCH FIRST 1 ROWS ONLY
 ) AS PROVIDER_AR_STATUS

 ,RD.RECEIVABLE_DETAIL_ID AS RECEIVABLE_DETAIL_ID
 ,DATE(RD.RECEIVABLE_TS) AS DATE_IDENTIFIED
 ,PD.CLIENT_ID
 ,F_ENAME('2955',PD.CLIENT_ID) AS CLIENT_NAME
 ,F_PLVALUE(RD.COUNTY_CD,104) AS LOCAL_DEPARTMENT
 ,PD.PAYMENT_ID AS ORIGINAL_PAYMENT_ID
 ,RD.START_DT AS FROM_DATE
 ,RD.END_DT AS TODATE
 ,concat('',COALESCE(RD.AMOUNT_NO,0.00)) AS OVERPAYMENT_AMOUNT
 ,concat('',COALESCE(RD.RECEIVABLE_BALANCE_NO,0.00)) AS BALANCE
 ,F_PDESC(RD.RECEIVABLE_STATUS_CD, 7) AS AR_STATUS
 ,F_PDESC(RCS.COLLECTION_STATUS_CD, 52) AS COLLECTION_STATUS
 ,F_PDESC(RD.RECEIVABLE_TYPE, 64) AS RECEIVABLE_TYPE
 ,PD.FINAL_FISCAL_CATEGORY_CD
 ,F_PLVALUE(PR.COUNTY_CD,104) AS COLLECTION_RESPONSIBILITY

FROM TB_PROVIDER PR,
TB_RECEIVABLE_HEADER RH,
TB_PAYMENT_DETAIL PD,
TB_RECEIVABLE_DETAIL RD,
TB_RECEIVABLE_COLLECTION_STATUS RCS,
TB_payment_header PAYHEAD 

WHERE PR.PROVIDER_ID = PAYHEAD.PROVIDER_ID AND PAYHEAD.payment_type_cd not in ('21','22')
 AND PR.PROVIDER_ID = RH.PROVIDER_ID
 AND RH.RECEIVABLE_ID = RD.RECEIVABLE_ID
 AND PD.PAYMENT_DETAIL_ID = RD.PAYMENT_DETAIL_ID
 AND RCS.RECEIVABLE_DETAIL_ID = RD.RECEIVABLE_DETAIL_ID 
 AND PR.DELETE_SW = 'N'
 AND RH.DELETE_SW = 'N'
 AND PD.DELETE_SW = 'N'
 AND RD.DELETE_SW = 'N'
 AND RCS.DELETE_SW = 'N'
 AND RCS.ACTIVE_SW = 'Y'
 AND PR.PROVIDER_ID = V_PROVIDERID
 AND ( (DATE(RD.RECEIVABLE_TS) >= date_from OR date_from IS NULL) AND (DATE(RD.RECEIVABLE_TS) <= date_to OR date_to IS NULL) )
   /*
 AND RD.RECEIVABLE_STATUS_CD = (CASE WHEN V_AR_STATUS IS NULL OR RTRIM(LTRIM(V_AR_STATUS)) = '' THEN 
          RD.RECEIVABLE_STATUS_CD 
         ELSE 
          V_AR_STATUS 
         END )
 AND RCS.COLLECTION_STATUS_CD = (CASE WHEN V_COLLECTION_STATUS IS NULL OR RTRIM(LTRIM(V_COLLECTION_STATUS)) = '' THEN 
          RCS.COLLECTION_STATUS_CD 
          ELSE 
          V_COLLECTION_STATUS 
         END )*/
ORDER BY RD.RECEIVABLE_DETAIL_ID,
   RD.START_DT
) MAIN

LEFT OUTER JOIN 
(SELECT RL.RECEIVABLE_DETAIL_ID,
  PR.RECEIPT_ID AS RECEIPT_ID,
  PR.RECEIPT_DT AS RECEIPT_DT,
  PR.PAYMENT_METHOD_CD,
  PR.PAYMENT_NO_TX,
  concat('',COALESCE(PR.PAYMENT_AMOUNT_NO,0.00)) AS PAYMENT_AMOUNT_NO,
  concat('',COALESCE((CASE WHEN RL.DELETE_SW = 'N'
    THEN RL.COLLECTED_AMOUNT_NO
    ELSE 0
  END),0.00)) AS COLLECTED_AMOUNT_NO,
  'Receipt' as TRAN_TYPE
 FROM TB_PAYMENT_RECEIPT PR,
  TB_RECEIVABLE_LIQUIDATION RL
 WHERE PR.RECEIPT_ID = RL.RECEIPT_ID
 AND PR.DELETE_SW = 'N'
 AND ( RL.DELETE_SW = 'N' OR (  RL.DELETE_SW = 'Y' and RL.UPDATE_USER_ID = 'REVERSAL'))
UNION ALL

 SELECT RL.RECEIVABLE_DETAIL_ID,
  PR.RECEIPT_ID AS RECEIPT_ID,
  PR.RECEIPT_DT AS RECEIPT_DT,
  PR.PAYMENT_METHOD_CD,
  PR.PAYMENT_NO_TX,
  concat('',COALESCE(PR.PAYMENT_AMOUNT_NO,0.00)) AS PAYMENT_AMOUNT_NO,
  concat('',COALESCE(0.00,0.00)) AS COLLECTED_AMOUNT_NO,
  'Receipt' as TRAN_TYPE
 FROM TB_PAYMENT_RECEIPT PR,
  TB_RECEIVABLE_LIQUIDATION RL
 WHERE RL.DELETE_SW = 'Y'
 AND TRIM(UPPER(PR.PAYMENT_NO_TX)) = (RL.RECEIPT_ID)::varchar
 AND PR.DELETE_SW = 'N'
 AND PR.PAYMENT_METHOD_CD = '16'
 AND PR.APPROVAL_STATUS_CD = '3047'

 UNION ALL

 SELECT RL.RECEIVABLE_DETAIL_ID,
  RO.OFFSET_ID AS RECEIPT_ID,
  RO.OFFSET_DT AS RECEIPT_DT,
  '' as PAYMENT_METHOD_CD,
  (PH.PAYMENT_ID)::varchar AS PAYMENT_NO_TX,
  concat('',COALESCE(RO.OFFSET_AMOUNT_NO,0.00)) AS PAYMENT_AMOUNT_NO,
  concat('',COALESCE(RL.COLLECTED_AMOUNT_NO,0.00)),
  'Offset' as TRAN_TYPE
 FROM TB_PAYMENT_HEADER PH,
  TB_RECEIVABLE_OFFSET RO,
  TB_RECEIVABLE_LIQUIDATION RL
 WHERE PH.PAYMENT_ID = RO.PAYMENT_ID
  AND RO.OFFSET_ID =  RL.OFFSET_ID
  AND PH.DELETE_SW = 'N'
  AND RO.DELETE_SW = 'N'
  AND RL.DELETE_SW = 'N'
)TAB ON TAB.RECEIVABLE_DETAIL_ID = MAIN.RECEIVABLE_DETAIL_ID
 ) X
);
END;
$function$

