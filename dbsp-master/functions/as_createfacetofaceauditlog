CREATE OR REPLACE FUNCTION as_createfacetofaceauditlog(v_progressnoteid uuid, v_userid character varying, v_progressnotetypeid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_progressnotetypekey character varying; 

BEGIN
 
 SELECT progressnotetypekey into v_progressnotetypekey from progressnotetype where progressnotetypeid = v_progressnotetypeid;
 
 IF(v_progressnotetypekey = 'Face to Face')
 THEN
  

     insert into auditlog(logtypekey,description,isnew,isedit,isdelete,insertedby,updatedby,insertedon,updatedon,objectid, objecttype) 
     VALUES ( 'WL004', 'Face to Face Contact made', false, true, true,v_userid, v_userid, now(), now(), v_progressnoteid, v_progressnotetypeid);
  
 END IF;

    RETURN 'Success';
END;

$function$

