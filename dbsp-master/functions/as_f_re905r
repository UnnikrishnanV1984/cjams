CREATE OR REPLACE FUNCTION as_f_re905r(start_date date, end_date date)
 RETURNS TABLE(ldss character varying, no_of_cases bigint, no_of_clients bigint, no_of_cl_candidates bigint, no_of_cl_not_candidates bigint, no_of_cl_candidate_not_determined bigint, perc_candidates bigint)
 LANGUAGE plpgsql
AS $function$
BEGIN
RETURN QUERY(

 WITH UNIV AS (
        SELECT ( SELECT C.OLD_ID
                    FROM CASE C
                     JOIN PERSONPROGRAMAREA CPA_1 ON C.OLD_ID = CPA_1.OLD_ID) AS CASE_ID,
            ( SELECT PI.PERSONIDENTIFIERVALUE
                   FROM PERSONIDENTIFIER PI
                     JOIN PERSON P ON PI.PERSONID = P.PERSONID) AS CASEHEAD_ID,
            ( SELECT AP.OLD_ID
                   FROM  AGENCYPROGRAMAREA AP
                     JOIN PERSONPROGRAMAREA PP ON PP.PROGRAMKEY = AP.PROGRAMNAME
                  WHERE AP.PROGRAMNAME::TEXT = 'ADOPTION'::TEXT) AS AGENCY_PROGRAM_AREA_ID,
           -- CPA.SUBPROGRAMAREAKEY AS SUB_PROGRAM_AREA_CD,
            CPA.STARTDATE AS START_DT,
            CPA.ENDDATE AS END_DT
           FROM PERSONPROGRAMAREA CPA,
             CASECLIENT CC,
            INTAKESERVICEREQUESTACTOR CR
          WHERE CPA.ACTIVEFLAG=1 AND CC.ACTIVEFLAG=1 AND CR.ACTIVEFLAG=1 AND CPA.OLD_ID = CC.OLD_ID AND CR.CASECLIENTID = (( SELECT PR.PERSONIDENTIFIERVALUE::INTEGER AS PERSONIDENTIFIERVALUE
                   FROM PERSONIDENTIFIER PR
                     JOIN CASECLIENT CA ON PR.PERSONID = CA.PERSONID)) AND CPA.STARTDATE <= CAST(START_DATE AS DATE) 
                     AND (CPA.ENDDATE IS NULL OR CPA.ENDDATE >= CAST(END_DATE  AS DATE)) AND CR.INTAKESERVICEREQUESTPERSONTYPEKEY::TEXT = '2085'::TEXT AND (( SELECT AP.OLD_ID::INTEGER AS OLD_ID
                   FROM AGENCYPROGRAMAREA AP
                     JOIN PERSONPROGRAMAREA PP ON PP.PROGRAMKEY = AP.PROGRAMNAME
                  WHERE AP.PROGRAMNAME::TEXT = 'ADOPTION'::TEXT)) = 1
        ), WORKER AS (
         SELECT A.TO_COUNTY_CD,
            A.ASSIGN_TO_STAFF_ID,
            A.ENTITY_KEY_ID AS CASE_ID
           FROM TB_ASSIGNMENT A,
            userprofile SF
          WHERE A.ASSIGN_TO_STAFF_ID = SF.cjamSPid AND SF.ACTIVEFLAG=1 AND A.ASSIGNMENT_ID = (( SELECT MAX(B.ASSIGNMENT_ID) AS MAX
                   FROM TB_ASSIGNMENT B
                  WHERE B.START_DT <= CAST(END_DATE  AS DATE) AND B.DELETE_SW = 'N'::BPCHAR AND A.ENTITY_KEY_ID = B.ENTITY_KEY_ID AND (B.END_DT IS NULL OR B.END_DT >= CAST(START_DATE AS DATE)) AND B.RESPONSIBILITY_CD::TEXT = 'P'::TEXT)) 
      AND (EXISTS ( SELECT 1
                   FROM UNIV
                  WHERE A.ENTITY_KEY_ID = UNIV.CASE_ID::INTEGER))
        ), PROGRAM_ASSIGNMENT AS (
         SELECT DISTINCT A.CASE_ID,
            A.CLIENT_ID,
            A.COUNTY_CD,
            A.CHILD_SW,
            A.AGENCY_PROGRAM_AREA_ID
   --,            A.SUB_PROGRAM_AREA_CD
           FROM ( SELECT CPA.CASE_ID,
                    ( SELECT PR.PERSONIDENTIFIERVALUE
                           FROM PERSONIDENTIFIER PR
                             JOIN CASECLIENT CA ON PR.PERSONID = CA.PERSONID) AS CLIENT_ID,
                    COALESCE(WORKER.TO_COUNTY_CD, F_PRIM_COUNTY(CPA.CASE_ID)) AS COUNTY_CD,
                    CC.CHILDFLAG AS CHILD_SW,
                    ( SELECT AP.OLD_ID
                           FROM AGENCYPROGRAMAREA AP
                             JOIN PERSONPROGRAMAREA PP ON PP.PROGRAMKEY = AP.PROGRAMNAME
                          WHERE AP.PROGRAMNAME::TEXT = 'ADOPTION'::TEXT) AS AGENCY_PROGRAM_AREA_ID
                --, CP.SUBPROGRAMAREAKEY AS SUB_PROGRAM_AREA_CD
                   FROM UNIV CPA
                     JOIN CASECLIENT CC ON CPA.CASE_ID::TEXT = ((( SELECT CS.OLD_ID
                           FROM CASECLIENT CST
                             JOIN CASE CS ON CS.CASEID = CST.CASEID))::TEXT)
                     JOIN PERSON C ON ((( SELECT PR.PERSONIDENTIFIERVALUE
                           FROM PERSONIDENTIFIER PR
                          WHERE PR.PERSONID = CC.PERSONID))::TEXT) = C.FK_ID::TEXT AND C.ACTIVEFLAG=1
                     LEFT JOIN PERSONPROGRAMAREA CP ON ((( SELECT CS.OLD_ID
                           FROM CASE CS
                          WHERE CS.CASEID = CC.CASEID))::TEXT) = ((( SELECT C_1.OLD_ID
                           FROM CASE C_1
                          WHERE C_1.old_id = CP.old_id))::TEXT) AND CP.ACTIVEFLAG=1
                     LEFT JOIN WORKER ON CPA.CASE_ID::INTEGER = WORKER.CASE_ID) A
          WHERE (( SELECT COUNT(*) AS COUNT
                   FROM PERSONPROGRAMAREA CPA2
                  WHERE A.CASE_ID::TEXT = ((( SELECT C.OLD_ID
                           FROM CASE C
                          WHERE C.old_id = CPA2.old_id))::TEXT) AND A.CLIENT_ID::TEXT = ((( SELECT PI.PERSONIDENTIFIERVALUE
                           FROM PERSONIDENTIFIER PI,
                            PERSON P
                          WHERE PI.PERSONID = P.PERSONID))::TEXT) AND (( SELECT AP.OLD_ID::INTEGER AS OLD_ID
                           FROM AGENCYPROGRAMAREA AP
                             JOIN PERSONPROGRAMAREA PP ON  PP.PROGRAMKEY = AP.PROGRAMNAME
                          WHERE AP.PROGRAMNAME::TEXT = 'ADOPTION'::TEXT)) = 2 AND CPA2.ACTIVEFLAG=1 AND CPA2.STARTDATE <= CAST(START_DATE AS DATE) AND (CPA2.ENDDATE IS NULL OR CPA2.ENDDATE > CAST(END_DATE  AS DATE)))) = 0
        ), SERVICE_PLAN AS (
         SELECT DISTINCT SP.OLD_ID AS SERVICE_PLAN_ID,
            ( SELECT C.OLD_ID
                   FROM CASE C
                  WHERE C.CASEID = SP.CASEID) AS CASE_ID,
            SP.EFFECTIVEDATE AS PLAN_DT
           FROM SERVICEPLAN SP
          WHERE SP.OLD_ID::TEXT = ((( SELECT SP2.OLD_ID AS SERVICE_PLAN_ID
                   FROM SERVICEPLAN SP2
                  WHERE SP.CASEID = SP2.CASEID AND SP2.ACTIVEFLAG=1 AND SP2.EFFECTIVEDATE <= CAST(END_DATE  AS DATE) 
      AND SP2.APPROVALSTATUSTYPEKEY::TEXT = '3047'::TEXT
                  ORDER BY SP2.EFFECTIVEDATE DESC, SP2.OLD_ID DESC
                 LIMIT 1))::TEXT) AND (EXISTS ( SELECT 1
                   FROM UNIV
                  WHERE ((( SELECT C.OLD_ID
                           FROM CASE C
                          WHERE C.CASEID = SP.CASEID))::TEXT) = UNIV.CASE_ID::TEXT))
        ), CANDIDACY AS (
         SELECT DISTINCT CPA.COUNTY_CD,
            SP.CASE_ID,
            ( SELECT PI.PERSONIDENTIFIERVALUE
                   FROM PERSONIDENTIFIER PI,
                    PERSON P
                  WHERE PI.PERSONID = P.PERSONID AND P.PERSONID = FCC.PERSONID) AS CLIENT_ID,
            FCC.CANDIDACYDETERMINATIONTYPEKEY AS CANDIDACY_DETERMINATION_CD
           FROM SERVICE_PLAN SP
             JOIN SERVICEPLANFOSTERCARECANDIDACY FCC ON SP.SERVICE_PLAN_ID::TEXT = ((( SELECT SERVICEPLAN.OLD_ID
                   FROM SERVICEPLAN
                  WHERE SERVICEPLAN.SERVICEPLANID = FCC.SERVICEPLANID))::TEXT) AND FCC.ACTIVEFLAG=1
             JOIN PROGRAM_ASSIGNMENT CPA ON CPA.CLIENT_ID::TEXT = ((( SELECT PI.PERSONIDENTIFIERVALUE
                   FROM PERSONIDENTIFIER PI,
                    PERSON P
                  WHERE PI.PERSONID = P.PERSONID AND P.PERSONID = FCC.PERSONID))::TEXT) AND CPA.CHILD_SW = 1
        )
 SELECT PLV.LDSS,
    NUM_CASES.NO_OF_CASES,
    NUM_CLIENTS.NO_OF_CLIENTS,
    NUM_CANDIDATES.NO_OF_CL_CANDIDATES,
    NUM_NOT_CANDIDATES.NO_OF_CL_NOT_CANDIDATES,
    COALESCE(NUM_CLIENTS.NO_OF_CLIENTS, 0::BIGINT) - (COALESCE(NUM_CANDIDATES.NO_OF_CL_CANDIDATES, 0::BIGINT) + COALESCE(NUM_NOT_CANDIDATES.NO_OF_CL_NOT_CANDIDATES, 0::BIGINT)) AS NO_OF_CL_CANDIDATE_NOT_DETERMINED,
        CASE
            WHEN NUM_CLIENTS.NO_OF_CLIENTS = 0 THEN 0::BIGINT
            ELSE NUM_CANDIDATES.NO_OF_CL_CANDIDATES / NUM_CLIENTS.NO_OF_CLIENTS * 100
        END AS PERC_CANDIDATES
   FROM ( SELECT TB_PICKLIST_VALUES.PICKLIST_VALUE_CD AS COUNTY_CD,
            TB_PICKLIST_VALUES.VALUE_TX AS LDSS
           FROM TB_PICKLIST_VALUES
          WHERE TB_PICKLIST_VALUES.PICKLIST_TYPE_ID = 104 AND (TB_PICKLIST_VALUES.PICKLIST_VALUE_CD::TEXT <> ALL (ARRAY['9115'::CHARACTER VARYING, '15988'::CHARACTER VARYING, '3824'::CHARACTER VARYING, '3825'::CHARACTER VARYING, '3826'::CHARACTER VARYING]::TEXT[]))) PLV
     LEFT JOIN ( SELECT A.COUNTY_CD,
            COUNT(A.CASE_ID) AS NO_OF_CASES
           FROM ( SELECT DISTINCT A_1.COUNTY_CD,
                    A_1.CASE_ID
                   FROM PROGRAM_ASSIGNMENT A_1
                  WHERE A_1.CHILD_SW = 1 AND (EXISTS ( SELECT 1
                           FROM UNIV
                          WHERE A_1.CASE_ID::TEXT = UNIV.CASE_ID::TEXT AND A_1.AGENCY_PROGRAM_AREA_ID::INTEGER = 1 
              -- AND A_1.SUB_PROGRAM_AREA_CD::TEXT = UNIV.SUB_PROGRAM_AREA_CD::TEXT
              ))
                UNION
                 SELECT DISTINCT B.COUNTY_CD,
                    A_1.CASE_ID
                   FROM UNIV A_1,
                    PROGRAM_ASSIGNMENT B
                  WHERE A_1.CASE_ID::TEXT = B.CASE_ID::TEXT AND B.CHILD_SW <> 1) A
          GROUP BY A.COUNTY_CD) NUM_CASES ON PLV.COUNTY_CD::TEXT = NUM_CASES.COUNTY_CD::TEXT
     LEFT JOIN ( SELECT PROGRAM_ASSIGNMENT.COUNTY_CD,
            COUNT(DISTINCT PROGRAM_ASSIGNMENT.CLIENT_ID) AS NO_OF_CLIENTS
           FROM PROGRAM_ASSIGNMENT
          WHERE PROGRAM_ASSIGNMENT.CHILD_SW = 1
          GROUP BY PROGRAM_ASSIGNMENT.COUNTY_CD) NUM_CLIENTS ON PLV.COUNTY_CD::TEXT = NUM_CLIENTS.COUNTY_CD::TEXT
     LEFT JOIN ( SELECT A.COUNTY_CD,
            COUNT(DISTINCT A.CLIENT_ID) AS NO_OF_CL_CANDIDATES
           FROM CANDIDACY A
          WHERE A.CANDIDACY_DETERMINATION_CD::TEXT = 'Y'::TEXT
          GROUP BY A.COUNTY_CD) NUM_CANDIDATES ON PLV.COUNTY_CD::TEXT = NUM_CANDIDATES.COUNTY_CD::TEXT
     LEFT JOIN ( SELECT A.COUNTY_CD,
            COUNT(DISTINCT A.CLIENT_ID) AS NO_OF_CL_NOT_CANDIDATES
           FROM CANDIDACY A
          WHERE A.CANDIDACY_DETERMINATION_CD::TEXT = 'N'::TEXT
          GROUP BY A.COUNTY_CD) NUM_NOT_CANDIDATES ON PLV.COUNTY_CD::TEXT = NUM_NOT_CANDIDATES.COUNTY_CD::TEXT

);
END;
$function$

