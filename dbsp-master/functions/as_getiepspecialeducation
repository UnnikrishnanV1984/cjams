CREATE OR REPLACE FUNCTION as_getiepspecialeducation(personeducationidval uuid)
 RETURNS TABLE(iepspecialeducation json)
 LANGUAGE plpgsql
AS $function$

declare v_personeducationidval uuid;

BEGIN

 v_personeducationidval:=personeducationidval;
 
 Return Query
 
  SELECT json_agg(pe) FROM(
 select ise.iepspecialeducationid,personeducationid,currentiep,
    courseandgrades,
    describeappropriateness,
    youthsacademicadjustmentkey,
    youthsacademicadjustmentdesc,
    youthssocialadjustmentkey,
    youthssocialadjustmentdesc,json_agg( case when ies.activeflag=1 then 
  json_build_object('iepeducationalservicesid',iepeducationalservicesid,'educationalserviceskey',educationalserviceskey,
 'educationalservicesdesc',educationalservicesdesc)
  else null end) as iepeducationalservices,
  json_agg( case when ids.activeflag=1 then 
  json_build_object('iepdisabilitycodeid',iepdisabilitycodeid,'disabilitycodekey',disabilitycodekey,
 'disabilitycodedesc',disabilitycodedesc)
  else null end) as iepdisabilitycode
   from iepspecialeducation as ise
   left join iepeducationalservices as ies on ise.iepspecialeducationid=ies.iepspecialeducationid
   and ies.activeflag=1
   left join iepdisabilitycode as ids on ise.iepspecialeducationid=ids.iepspecialeducationid
   where case when (v_personeducationidval is not null) then ise.personeducationid=v_personeducationidval else 1=1 end
   group by ise.iepspecialeducationid) as pe;
  end;

$function$

