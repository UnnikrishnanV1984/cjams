CREATE OR REPLACE FUNCTION getstatedetails(v_zipcode integer)
 RETURNS TABLE(countycode character varying, countyname character varying, citycode character varying, cityname character varying, statename character varying, stateabbr character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
   RETURN QUERY
      SELECT co.countycode,
             co.countyname,
             cy.citycode,
             cy.town,
             st.statename,
             st.stateabbr
        FROM county co
             INNER JOIN city cy
                ON co.countycode = cy.county AND co.activeflag = 1
             INNER JOIN zipcode zc
                ON zc.citycode = cy.citycode AND zc.activeflag = 1
             INNER JOIN state st
                ON st.stateabbr = co.state AND st.activeflag = 1
       WHERE     co.activeflag = 1
             AND (zc.zipcd::CHARACTER VARYING) ILIKE
                    v_zipcode || '%';
END;
$function$

