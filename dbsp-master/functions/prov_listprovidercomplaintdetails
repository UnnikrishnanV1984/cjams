CREATE OR REPLACE FUNCTION prov_listprovidercomplaintdetails(v_providerid integer, p_status character varying, pagenumber integer, pagelimit integer)
 RETURNS TABLE(totalcount bigint, provider_complaintid uuid, provider_id integer, complaint_date timestamp without time zone, narrative text, activeflag integer, complaint_number character varying, updated_on timestamp without time zone, complaint_status character varying, isnotificationsent boolean)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
 DECLARE                                                                                                                                                                                                                                                                                                           
 v_pageoffset int;                                                                                                                                                                                                                                                                                                 
 v_pagenumber int;                                                                                                                                                                                                                                                                                                 
 v_pagelimit int;                                                                                                                                                                                                                                                                                                  
 v_limit int;                                                                                                                                                                                                                                                                                                      
  totalcount integer;                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                   
  BEGIN                                                                                                                                                                                                                                                                                                            
  v_limit=pagelimit;                                                                                                                                                                                                                                                                                               
   v_pagenumber := pageNumber-1;                                                                                                                                                                                                                                                                                 
     v_pageoffset = v_pagenumber * v_limit;                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
  RETURN QUERY                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                   
 select  count(1) OVER() totalcount,
  tpc.provider_complaintid,tpc.provider_id, tpc.complaint_date, tpc.narrative, tpc.activeflag,
 tpc.complaint_number, tpc.updated_on, tpc.complaint_status , tcd.isnotificationsent
 
 from tb_provider_complaint_deficiency tcd
 left join tb_provider_complaint tpc on tcd.provider_complaintid =tcd.provider_complaintid
 where  (tpc.provider_id=v_providerid)
 and case when p_status = 'pending' then ( tcd.isnotificationsent = false or tcd.isnotificationsent is null )
 else  tcd.isnotificationsent = true  end

group by 
 tpc.provider_complaintid,tpc.provider_id,  tpc.complaint_date, tpc.narrative, tpc.activeflag,
 tpc.complaint_number,  tpc.updated_on,  tpc.complaint_status ,tcd.isnotificationsent
 
LIMIT v_limit OFFSET v_pageoffset ;    
        
 end;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 $function$

