CREATE OR REPLACE FUNCTION getprovidercomplaintdeficiencydetails(v_provider_complaintid uuid, pagenumber integer, pagelimit integer)
 RETURNS TABLE(totalcount bigint, tb_provider_complaint_deficiencyid uuid, provider_complaintid uuid, deficiency_violationname character varying, citation text, comments text, frequencyofdeficiency character varying, impactofdeficiency character varying, scopeofdeficiency character varying, findings text)
 LANGUAGE plpgsql
AS $function$

DECLARE 
v_pageoffset int;
v_pagenumber int;
v_pagelimit int;
v_limit int;
 totalcount integer;



 BEGIN
 v_limit=pagelimit;
    v_pagenumber := pageNumber-1;
    v_pageoffset = v_pagenumber * v_limit; 


 RETURN QUERY 
 
  select count(1) OVER() totalcount, tcd.tb_provider_complaint_deficiencyid,tcd.provider_complaintid,tcd.deficiency_violationname,
 tcd.citation,tcd.comments,tcd.frequencyofdeficiency,tcd.impactofdeficiency,tcd.scopeofdeficiency,tcd.findings from tb_provider_complaint_deficiency tcd where tcd.provider_complaintid=v_provider_complaintid and tcd.activeflag=1

 LIMIT v_limit OFFSET v_pageoffset ;  
                     
end

$function$

