CREATE OR REPLACE FUNCTION prov_addupdatecpahomeinfo(insertobj json)
 RETURNS TABLE(status text, applicant_id character varying, cpa_site bigint, v_cpa_provider_id character varying, v_cpahomeid character varying, v_new_provider_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
 declare                                                                                                                                                                                                                                                                                                                                                                                               
    v_providerId character varying;                                                                                                                                                                                                                                                                                                                                                                       
    v_securityuserid character varying; 
    v_applicantId character varying;
   v_cpa_site_id bigint;
    i text;                                                                                                                                                                                                                                                                                                                                                                                               
 v_person_type character varying; 
 v_person_first_nm character varying; 
 v_person_last_nm character varying; 
 v_person_home_phone character varying; 
 v_person_mobile_phone character varying; 
 v_person_email character varying; 
 v_person_dob_dt date;
 v_person_dod_dt date;
 v_person_sex character varying; 
 v_hispanic_heritage character varying; 
 v_home_start_dt date;
 v_home_end_dt date;  
primaryrace json;
 secondaryrace json;
k text;
v_cpahomeid   uuid;
v_num int;
existing_num int;
v_response character varying;
v_new_provider_id character varying;
genr_num character varying;

 begin                                                                                                                                                                                                                                                                                                                                                                                                 
 v_providerId := insertobj->>'provider_id';                                                                                                                                                                                                                                                                                                                                                            
 v_applicantId := insertobj->>'applicant_id';                                                                                                                                                                                                                                                                                                                                                                
 v_securityuserid := insertobj->>'securityuserid';                                                                                                                                                                                                                                                                                                                                                     
 v_person_type := insertobj->>'person_type';
 v_person_first_nm := insertobj->>'person_first_nm';
 v_person_last_nm := insertobj->>'person_last_nm';
 v_person_home_phone := insertobj->>'person_home_phone';
 v_person_mobile_phone := insertobj->>'person_mobile_phone';
 v_person_email := insertobj->>'person_email';
 v_person_dob_dt := insertobj->>'person_dob_dt';
 v_person_dod_dt := insertobj->>'person_dod_dt';
 v_person_sex := insertobj->>'person_sex';
 v_hispanic_heritage := insertobj->>'hispanic_heritage';
 v_home_start_dt := insertobj->>'home_start_dt';
 v_home_end_dt := insertobj->>'home_end_dt';  
    primaryrace := insertobj->>'primaryrace';  
   secondaryrace := insertobj->>'secondaryrace';  
   v_cpahomeid = insertobj->>'provider_cpa_adop_person_id';
  v_cpa_site_id := insertobj->>'cpa_siteid';

--   v_cpahomeidnew := gen_random_uuid();
 v_cpa_provider_id := (insertobj->>'cpa_provider_id') ;
 
 SELECT count(*) into existing_num from tb_prov_cpa_adop_person where lower(person_first_nm) = lower(v_person_first_nm) and lower(person_last_nm) = lower(v_person_last_nm)
 and person_dob_dt = v_person_dob_dt and activeflag = 1; 
 
 
IF v_cpahomeid is not null then 
         UPDATE tb_prov_cpa_adop_person
  SET  provider_id=v_providerId,applicant_id=v_applicantId,person_type=v_person_type,person_first_nm=v_person_first_nm,person_last_nm=v_person_last_nm,
   person_home_phone=v_person_home_phone,person_mobile_phone=v_person_mobile_phone,person_email=v_person_email,person_dob_dt=v_person_dob_dt,
   person_dod_dt=v_person_dod_dt,person_sex=v_person_sex,hispanic_heritage=v_hispanic_heritage,home_start_dt=v_home_start_dt,home_end_dt=v_home_end_dt,
   create_ts=now(),create_user_id=v_securityuserid,update_ts=now(),update_user_id=v_securityuserid,activeflag=1,cpa_siteid =v_cpa_site_id
  WHERE provider_cpa_adop_person_id = v_cpahomeid;

 if(v_person_type = 'Applicant')
 then 
  UPDATE tb_provider 
  SET 
   provider_first_nm = v_person_first_nm,
   provider_last_nm = v_person_last_nm,
   adr_home_phone_tx = v_person_home_phone, 
   adr_email_tx = v_person_email, 
   adr_cell_phone_tx = v_person_mobile_phone, 
   update_ts = now(), 
   update_user_id = v_securityuserid
  WHERE 
  provider_id = (insertobj->>'cpa_provider_id')::int4;
 end if;


    delete from tb_prov_cpa_person_race where person_cpahomeid=v_cpahomeid;
  
 FOR i IN SELECT * FROM json_array_elements(primaryrace)
 LOOP

 INSERT INTO tb_prov_cpa_person_race
 (race_type,race_value,create_ts,create_user_id,update_ts,update_user_id,activeflag,provider_id,applicant_id,cpa_siteid,person_cpahomeid)                                                                                                                                               
 VALUES('PRIMARY RACE',i,now(),v_securityuserid, now(), v_securityuserid,1,v_providerId, v_applicantId,v_cpa_site_id,v_cpahomeidnew);                                                                                                   
 END LOOP;


 FOR k IN SELECT * FROM json_array_elements(secondaryrace)
 LOOP

 INSERT INTO tb_prov_cpa_person_race
 (race_type,race_value,create_ts,create_user_id,update_ts,update_user_id,activeflag,provider_id,applicant_id,cpa_siteid,person_cpahomeid)                                                                                                                                               
 VALUES('SECONDARY RACE',k,now(),v_securityuserid, now(), v_securityuserid,1,v_providerId, v_applicantId,v_cpa_site_id,v_cpahomeidnew);                                                                                                   
 END LOOP;  

else                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                               
INSERT INTO tb_prov_cpa_adop_person(provider_cpa_adop_person_id,provider_id,applicant_id,person_type,person_first_nm,person_last_nm, person_home_phone,person_mobile_phone,person_email,person_dob_dt,person_dod_dt,
 person_sex,hispanic_heritage,home_start_dt,home_end_dt,create_ts,create_user_id,update_ts,update_user_id,activeflag,cpa_siteid,cpa_provider_id)                                                                                                                                         
values( v_cpahomeidnew,v_providerId, v_applicantId, v_person_type , v_person_first_nm,v_person_last_nm, v_person_home_phone,v_person_mobile_phone,v_person_email,v_person_dob_dt,v_person_dod_dt,
v_person_sex,v_hispanic_heritage,v_home_start_dt,v_home_end_dt,now(),v_securityuserid, now(), v_securityuserid,1,v_cpa_site_id, v_cpa_provider_id::int4) RETURNING "provider_cpa_adop_person_id" INTO v_cpahomeid;                                                                               



 if(v_person_type = 'Applicant')
 then 
  UPDATE tb_provider 
  SET 
   provider_first_nm = v_person_first_nm,
   provider_last_nm = v_person_last_nm,
   adr_home_phone_tx = v_person_home_phone, 
   adr_email_tx = v_person_email, 
   adr_cell_phone_tx = v_person_mobile_phone, 
   update_ts = now(), 
   update_user_id = v_securityuserid
  WHERE 
  provider_id = (insertobj->>'cpa_provider_id')::int4;
 end if;




FOR i IN SELECT * FROM json_array_elements(primaryrace)
LOOP

INSERT INTO tb_prov_cpa_person_race
(race_type,race_value,create_ts,create_user_id,update_ts,update_user_id,activeflag,provider_id,applicant_id,cpa_siteid,person_cpahomeid)                                                                                                                                               
 VALUES('PRIMARY RACE',i,now(),v_securityuserid, now(), v_securityuserid,1,v_providerId, v_applicantId,v_cpa_site_id,v_cpahomeidnew);                                                                                                   
END LOOP;


FOR k IN SELECT * FROM json_array_elements(secondaryrace)
LOOP

INSERT INTO tb_prov_cpa_person_race
(race_type,race_value,create_ts,create_user_id,update_ts,update_user_id,activeflag,provider_id,applicant_id,cpa_siteid,person_cpahomeid)                                                                                                                                               
 VALUES('SECONDARY RACE',k,now(),v_securityuserid, now(), v_securityuserid,1,v_providerId, v_applicantId,v_cpa_site_id,v_cpahomeidnew);                                                                                                   
END LOOP;

v_response = 'success';

end if;

return query
select v_response::text, v_applicantId, v_cpa_site_id, v_cpa_provider_id::character varying,v_cpahomeidnew::character varying,v_new_provider_id::character varying; 

                                                                                                                                                                                                                                                                                                                                                                                              
 end;                                                                                                                                                                                                                                                                                                                                                                                                  
 $function$

