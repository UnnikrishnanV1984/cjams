CREATE OR REPLACE FUNCTION prov_getsanctionappeallist(v_sanction_id uuid, pagenumber integer, pagesize integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
v_appealdata json;
v_pageoffset int;                                                                                                                                                                                                                                                                                                                                                            
v_pagenumber int;      

BEGIN  
     v_pagenumber := pagenumber-1;                                                                                                                                                                                                                                                                                                                                                     
     v_pageoffset = v_pagenumber * pagesize;     

select  jsonb_agg(x) as sanctiondata into v_appealdata from
(select * from tb_provider_appeal where sanction_id =  v_sanction_id
LIMIT pagesize OFFSET v_pageoffset)x;

return v_appealdata;
END;
$function$

