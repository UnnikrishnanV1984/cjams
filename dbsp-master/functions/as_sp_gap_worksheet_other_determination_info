CREATE OR REPLACE FUNCTION as_sp_gap_worksheet_other_determination_info(al_client_id bigint)
 RETURNS TABLE(client_id bigint, successorguardianexists character varying, successorguardianname character varying, successorguardianid integer, dateofsuccessionaddendum timestamp without time zone, gapeligibilitystatus character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm            VARCHAR(100) DEFAULT 'sp_gap_worksheet_other_determination_info';
  vs_suc_grd_exts            VARCHAR(20);
  vs_succ_grdn_nm            VARCHAR(250);
  vn_succ_grdn_id            INTEGER;
  vd_succ_adndm_dt           TIMESTAMP;
  vs_gap_elig_sts            VARCHAR(50);
   
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_other_determination_info ( 
  client_id              BIGINT,
  successorguardianexists          VARCHAR(20),
  successorguardianname          VARCHAR(250),
  successorguardianid           INTEGER,
  dateofsuccessionaddendum         TIMESTAMP,
  gapeligibilitystatus          VARCHAR(50)
 ); 
               
-- Successor Guardian Exists  
SELECT ( CASE WHEN (grd.successorguardianname IS NOT NULL) 
    THEN 'YES'::VARCHAR ELSE 'NO'::VARCHAR END )
 INTO vs_suc_grd_exts
   FROM gapdisclosure gdis, guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE gdis.gapid = grd.gapid AND gdis.activeflag = 1
 AND grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY gdis.updatedon DESC LIMIT 1;

-- Successor Guardian Name  
SELECT grd.successorguardianname
 INTO vs_succ_grdn_nm
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Successor Guardian ID  
SELECT grd.successorguardianid
 INTO vn_succ_grdn_id
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

-- Succession Addendum Date  
SELECT grd.successionaddendumdate
 INTO vd_succ_adndm_dt
   FROM guardianship grd, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per     
WHERE grd.servicecaseid = pp.servicecaseid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' AND tp.approval_status_cd = '3047' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY grd.updatedon DESC LIMIT 1;

SELECT taer.eligibilitystatus
 INTO vs_gap_elig_sts
   FROM tb_ive_gapaudit ga, tb_audit_eligibility_result taer
WHERE ga.gapauditid = taer.gapauditid AND ga.category = 'I' 
 AND taer.client_id::BIGINT = al_client_id ORDER BY taer.updatedon DESC LIMIT 1;

INSERT INTO Temp_worksheet_other_determination_info
SELECT 
  al_client_id,
  vs_suc_grd_exts,
  vs_succ_grdn_nm,
  vn_succ_grdn_id,
  vd_succ_adndm_dt,
  vs_gap_elig_sts;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_other_determination_info;
              
DROP TABLE Temp_worksheet_other_determination_info;

   END
    $function$

