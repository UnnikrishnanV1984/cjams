CREATE OR REPLACE FUNCTION prov_getprogramplacements_snapshot(v_req json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE 
l_placements json;
v_where json;
 v_skip integer;
  v_sortcol character varying;
   v_sortorder character varying;
   v_providerid character varying;
v_status character varying;
v_client_id character varying;
v_client_name character varying;

BEGIN 

v_skip = v_req->>'skip';
v_sortcol = v_req->>'sort_column';
v_sortorder = v_req->>'sort_order';

v_where = v_req->>'where';

v_providerid = v_where->>'provider_id';
v_status = v_where->>'status';
v_client_id = v_where->>'client_id';
v_client_name = v_where->>'client_name';


SELECT json_agg(placements) INTO l_placements FROM(
 select count(1) over() as totalcount, pl.* ,p.firstname,p.lastname,p.dob,p.gendertypekey,p.cjamspid
 from tb_placement_snapshot pl 
    left join person p on  pl.personid = p.personid
    where 
    pl.delete_sw='N' 
 and (case when v_providerid is  null then true else 
  pl.provider_id =v_providerid or pl.contract_program_id = v_providerid
 end )
 and (case when v_client_id is null then true else 
  p.cjamspid like '%'||v_client_id||'%'
 end )
 and (case when v_client_name is null then true else 
  p.firstname ilike '%'||v_client_name||'%' or
  p.lastname ilike '%'||v_client_name||'%' or
  p.firstname||' '||p.lastname ilike '%'||v_client_name||'%' or
  p.lastname||','||p.firstname ilike '%'||v_client_name||'%' or
  p.lastname||', '||p.firstname ilike '%'||v_client_name||'%' 
 end )
 and (case when v_status is null  or v_status = 'All' then true  
        when v_status = 'Active' then pl.exit_dt IS NULL AND coalesce(pl.void_sw, 'N') <> 'Y'
        when v_status = 'Inactive' then pl.exit_dt IS NOT NULL OR pl.void_sw = 'Y'
 end )
 
 order by 
    (
 case
  v_sortorder
  when 'asc' then
  case v_sortcol
  when 'entry_dt' then COALESCE(pl.entry_dt:: character varying,'')
  when 'exit_dt' then COALESCE(pl.exit_dt:: character varying ,'')
  end
  else  NULL
 end) ASC,
 (
 case
  v_sortorder
  when 'desc' then
  case v_sortcol
  when 'entry_dt' then COALESCE(pl.entry_dt:: character varying  ,'')
  when 'exit_dt' then COALESCE(pl.exit_dt:: character varying ,'')
  end
  else  NULL
 end ) DESC
    limit 10 offset v_skip
) AS placements;

RETURN l_placements; 
 
END;

$function$

