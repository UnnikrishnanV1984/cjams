CREATE OR REPLACE FUNCTION sp_cares_outbound_interface_gen_data_25(vl_client_id integer, vl_other_id bigint, vs_transaction_type_cd character varying, vl_transaction_sequence integer, vd_transaction_ts timestamp without time zone, OUT vs_message character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- Author: Sudhin
-- Date Created :08/01/2005
-- generates Cares Interface Outbound Data
------------------------------------------------------------------------

    DECLARE VS_RECORD_TYPE VARCHAR(2);--
     VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';--
     VL_RECORD_SEQUENCE INTEGER DEFAULT 000;--
     VS_TRANSACTION_SEQUENCE VARCHAR(5);--
     VS_RECORD_SEQUENCE VARCHAR(3);--
    -- Client Variables
     VS_CIS_CLIENT_ID VARCHAR(10);      --  CARES_OUT_COL6

     CARES_OUT_LIFE_INS_COL1 DECIMAL(10,2);--
     CARES_OUT_LIFE_INS_COL1_CONV VARCHAR(15);--
     CARES_OUT_LIFE_INS_COL2 DECIMAL(10,2);--
     CARES_OUT_LIFE_INS_COL2_CONV VARCHAR(15);--
     CARES_OUT_LIFE_INS_COL3 VARCHAR(20);--
     CARES_OUT_LIFE_INS_COL4 VARCHAR(50);--

    DECLARE CURSOR_LIFE_INS  CURSOR FOR
        SELECT facevalue, marketvaluetypekey, accountno, locationname
        FROM personasset, person
        WHERE personasset.personid = person.personid
  and person.cjamspid = VL_CLIENT_ID
        AND   personasset.assettypekey IN ('77', 'LI')
        AND   personasset.caresassetno IS NULL
        AND   personasset.activeflag = 1;--

 BEGIN    
   VL_OUTPUT_SQLCODE:='00000';   
   
   RAISE NOTICE 'GEN DATA 25 STARTS';--

    -- SET transaction sequence
     VS_TRANSACTION_SEQUENCE := LTRIM(RTRIM(VL_TRANSACTION_SEQUENCE::VARCHAR)) ;--

    -- Get CIS_CLIENT_ID
BEGIN
     SELECT  person.cisclientid
   INTO    VS_CIS_CLIENT_ID
    FROM    person   
    WHERE   person.cjamspid = VL_CLIENT_ID
    AND     person.activeflag  = 1;  
 
   EXCEPTION WHEN OTHERS THEN 
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
    VS_MESSAGE :=  'SELECT CIS_CLIENT_ID FAILED FOR TB_CLIENT'  ;--
       RETURN;
    END ;--

    -- Generate records for record type 25
  
     VS_RECORD_TYPE := '25';--
  
     VL_RECORD_SEQUENCE := 000 ;--

     VS_RECORD_SEQUENCE := '';--

    IF  VS_RECORD_TYPE = '25' THEN

       OPEN CURSOR_LIFE_INS;--
       <<CURS_LIFE_INS>>
       WHILE VL_OUTPUT_SQLCODE = '00000' LOOP
            FETCH CURSOR_LIFE_INS INTO CARES_OUT_LIFE_INS_COL1, CARES_OUT_LIFE_INS_COL2,
                                        CARES_OUT_LIFE_INS_COL3, CARES_OUT_LIFE_INS_COL4   ;--

            EXIT CURS_LIFE_INS WHEN NOT FOUND;--
     

      VL_RECORD_SEQUENCE := VL_RECORD_SEQUENCE + 1 ;--
 
      VS_RECORD_SEQUENCE := LTRIM(RTRIM(VL_RECORD_SEQUENCE::VARCHAR));--
 

       CARES_OUT_LIFE_INS_COL1_CONV = LTRIM(RTRIM(CARES_OUT_LIFE_INS_COL1::VARCHAR)) ;--
 
       CARES_OUT_LIFE_INS_COL1_CONV = SUBSTRING('00000000000',1,11 - LENGTH(CARES_OUT_LIFE_INS_COL1_CONV)) || CARES_OUT_LIFE_INS_COL1_CONV ;--

       CARES_OUT_LIFE_INS_COL2_CONV = LTRIM(RTRIM(CARES_OUT_LIFE_INS_COL2::VARCHAR)) ;--
 
       CARES_OUT_LIFE_INS_COL2_CONV = SUBSTRING('00000000000',1,11 - LENGTH(CARES_OUT_LIFE_INS_COL2_CONV)) || CARES_OUT_LIFE_INS_COL2_CONV ; --
 
      -- Set Interface Data
      INSERT INTO TB_CARES_OUTBOUND_INTERFACE
         (CARES_RECORD_ID,
          STATUS_CD,
          BATCH_SEQ_NO,
          TRANSACTION_SEQ_NO,
   TRANSACTION_TYPE_CD,
       CIS_CLIENT_ID,
   RECORD_TYPE_CD,
   TRANSACTION_TS,
          RECORD_SEQ_NO,
   CARES_OUT_COL1,
   CARES_OUT_COL2,
   CARES_OUT_COL3,
   CARES_OUT_COL4
   )
      SELECT
  NEXTVAL('SQ_CARES_OUTBOUND_INTERFACE'),
  '000',
  '',
  CASE WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 1 THEN '0000'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 2 THEN '000'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 3 THEN '00'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 4 THEN '0'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 5 THEN VS_TRANSACTION_SEQUENCE
       END,
  VS_TRANSACTION_TYPE_CD,
  COALESCE(SUBSTRING('000000000',1,9 - LENGTH(LTRIM(RTRIM(VS_CIS_CLIENT_ID)))) || LTRIM(RTRIM(VS_CIS_CLIENT_ID)),'000000000'),
  '25',
  VD_TRANSACTION_TS,
  CASE WHEN LENGTH(VS_RECORD_SEQUENCE) = 1 THEN '00'||VS_RECORD_SEQUENCE
       WHEN LENGTH(VS_RECORD_SEQUENCE) = 2 THEN '0'||VS_RECORD_SEQUENCE
       WHEN LENGTH(VS_RECORD_SEQUENCE) = 3 THEN VS_RECORD_SEQUENCE
       END,
                CASE WHEN CARES_OUT_LIFE_INS_COL1_CONV = '' THEN '00000000.00'
                     WHEN LENGTH(CARES_OUT_LIFE_INS_COL1_CONV) <= 0 THEN '00000000.00'
                     ELSE COALESCE(CARES_OUT_LIFE_INS_COL1_CONV::VARCHAR,'00000000.00')
                END,    
                CASE WHEN CARES_OUT_LIFE_INS_COL2_CONV = '' THEN '00000000.00'
                     WHEN LENGTH(CARES_OUT_LIFE_INS_COL2_CONV) <= 0 THEN '00000000.00'
                     ELSE COALESCE(CARES_OUT_LIFE_INS_COL2_CONV::VARCHAR,'00000000.00')
                END,    
  CARES_OUT_LIFE_INS_COL3,
  CARES_OUT_LIFE_INS_COL4
     ;  --
 
 RAISE NOTICE 'INSERT IN GEN DATA 25 SUCCESSFUL';--
  
       END LOOP;--
       CLOSE CURSOR_LIFE_INS;--

       --
 
    END IF;--

    RETURN ;--
    EXCEPTION WHEN OTHERS THEN 
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
    VS_MESSAGE :='INSERT INTO TB_CARES_OUTBOUND_INTERFACE FAILED-' ||SQLERRM ;--
     RETURN;
    
END 
;
$function$

