    raise notice 'Cur_auto_validation--vd_validation_month_end_dt-> %',vd_validation_month_end_dt;
   --OPEN Cur_auto_validation;
   <<Cur_auto_validation_no_data_1>>
   LOOP
   FETCH Cur_auto_validation INTO  vs_insert_updt_sw, 
           vl_placement_validation_id, 
           vd_validation_month_start_dt,
           vd_validation_month_end_dt,
           vs_auto_valid_success_sw,
           vs_auto_valid_errors;
   EXIT Cur_auto_validation_no_data_1 WHEN NOT FOUND;
   
   --WHILE (SQLCODE = 0)
   -- DO
    
    
    IF vs_first_call_Failed = 'Y' THEN
     IF vs_final_first_call_errors is NOT NULL AND RTRIM(LTRIM(vs_final_first_call_errors)) <> '' THEN
       vs_error_reasons := vs_final_first_call_errors ;
     END IF; 
     IF vs_auto_valid_errors is NOT NULL AND RTRIM(LTRIM(vs_auto_valid_errors)) <> '' THEN
       vs_error_reasons := vs_error_reasons || ' ' || CHR(13) || COALESCE(vs_auto_valid_errors,'') ;
     END IF; 
    ELSE
      vs_error_reasons := COALESCE(vs_auto_valid_errors,'') ;
    END IF; 
    raise notice 'Cur_auto_validation--vl_auto_validation_log_id-> %',vl_auto_validation_log_id;
    INSERT INTO  TB_PLACEMENT_AUTO_VALIDATION_LOG  
       ( PLACEMENT_ID,   
         INSERT_UPDT_SW,   
         PLACEMENT_VALIDATION_ID,   
         VALIDATION_START_DT,   
         VALIDATION_END_DT,   
         AUTO_VALID_SW,   
         ERROR_REASONS )  
    VALUES (   al_placement_id,   
         vs_insert_updt_sw,   
         vl_placement_validation_id,   
         vd_validation_month_start_dt,   
         vd_validation_month_end_dt,   
         vs_auto_valid_success_sw,   
         vs_error_reasons )  ;

    
     vl_error_cnt := vl_error_cnt + 1; 
    -- Reset
     vs_insert_updt_sw := NULL; 
     vl_placement_validation_id := NULL;
     vd_validation_month_start_dt := NULL;
     vd_validation_month_end_dt := NULL;
     vs_auto_valid_success_sw := NULL;
     vs_auto_valid_errors := NULL;
     vs_error_reasons := '';
   
   
    FETCH Cur_auto_validation INTO  vs_insert_updt_sw, 
           vl_placement_validation_id, 
           vd_validation_month_start_dt,
           vd_validation_month_end_dt,
           vs_auto_valid_success_sw,
           vs_auto_valid_errors;
   --END WHILE;
   END LOOP;
   CLOSE Cur_auto_validation;
   
 END IF;
 -- Auto-Validation Verification - END
END IF;

