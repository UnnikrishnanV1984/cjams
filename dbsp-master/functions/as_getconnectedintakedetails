CREATE OR REPLACE FUNCTION as_getconnectedintakedetails(v_intakenumber character varying)
 RETURNS TABLE(reportertitle text, reporterphonenumber text, reporterorganization text, reporterfirstname text, reporterlastname text, receiveddate text, createddate timestamp without time zone, narrative text, isunknownreporter boolean, isanonymousreporter boolean, servicetype text, servicesubtype text, jurisdiction character varying, referral text)
 LANGUAGE plpgsql
AS $function$

DECLARE  
BEGIN

 RETURN QUERY 
  SELECT ((jsondata->>'narrative')::json #>>'{0}')::json ->> 'title' AS reportertitle, 
  ((jsondata->>'narrative')::json #>>'{0}')::json ->> 'PhoneNumber' AS reporterphonenumber, 
  ((jsondata->>'narrative')::json #>>'{0}')::json ->> 'organization' AS reporterorganization, 
  ((jsondata->>'narrative')::json #>>'{0}')::json ->> 'Firstname' AS reporterfirstname, 
  ((jsondata->>'narrative')::json #>>'{0}')::json ->> 'Lastname' AS reporterlastname, 
  (jsondata->>'General')::json ->> 'RecivedDate' AS receiveddate, insertedon as createddate, 
  (jsondata->>'General')::json ->> 'Narrative' AS narrative,
  CAST((jsondata->>'General')::json ->> 'IsUnknownReporter' AS bool) AS isunknownreporter,
  CAST((jsondata->>'General')::json ->> 'IsAnonymousReporter' AS bool) AS isanonymousreporter,
  ((jsondata->>'createdCases')::json #>>'{0}')::json ->> 'serviceTypeValue' AS servicetype, 
  ((jsondata->>'createdCases')::json #>>'{0}')::json ->> 'subSeriviceTypeValue' AS servicesubtype, 
  (SELECT countyname FROM county WHERE countyid::TEXT = (jsondata->>'General')::json ->> 'countyid') AS jurisdiction, 
  (SELECT description FROM Intakeservicerequestinputtype WHERE intakeservreqinputtypeid::text = (jsondata->>'General')::json ->> 'InputSource') AS referral
  FROM intakedastaging WHERE intakenumber = v_intakenumber ORDER BY insertedon DESC LIMIT 1;

END;

$function$

