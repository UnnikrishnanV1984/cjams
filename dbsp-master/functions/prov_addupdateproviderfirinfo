CREATE OR REPLACE FUNCTION prov_addupdateproviderfirinfo(firinfoobj json)
 RETURNS TABLE(status text, provider_fir_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
 v_securityuserid character varying;
v_response  character varying;
v_providerfirid character varying;
 begin                                                                                                                                                                                                                                                                                                                                                                                                 
v_providerfirid:=null;
v_securityuserid := firinfoobj->>'securityuserid';
if (firinfoobj->>'provider_fir_id' is not null) then
 v_providerfirid := firinfoobj->>'provider_fir_id';
end if;
--v_providerfirid='38df4661-1bdb-4c14-8e6c-b5fb3819781c';
 raise notice '%s',v_providerfirid;
raise notice '%s',v_securityuserid;

  if (v_providerfirid) is null  then
   raise notice '%s',v_providerfirid;
    INSERT INTO provider_fir (provider_fir_id, fir_no, provider_id, site_id, licence_type, fir_comments, incident_date, 
   fir_status, fir_statusdesc, inserted_on, updated_on, updated_by, inserted_by, delete_sw, active_flag) 
  VALUES(gen_random_uuid(),
      (firinfoobj->>'fir_no'),  
      (firinfoobj->>'provider_id')::int4,
      (firinfoobj->>'site_id')::int4 , 
      (firinfoobj->>'licence_type'), 
      (firinfoobj->>'fir_comments'), 
      current_date, 
      (firinfoobj->>'fir_status'),
      (firinfoobj->>'fir_statusdesc'),     
      now(),now(), v_securityuserid,  v_securityuserid, 'N'::bpchar, 1) 
      returning provider_fir.provider_fir_id into v_providerfirid;    
  else
   raise notice '%s',v_providerfirid;
   --v_providerfirid=(firinfoobj->>'home_info_id');
   update  provider_fir pfir set                                                                                                                                  
     fir_no=(firinfoobj->>'fir_no'),  
     provider_id= (firinfoobj->>'provider_id')::int4,
     site_id= (firinfoobj->>'site_id')::int4 , 
     licence_type= (firinfoobj->>'licence_type'), 
     fir_comments= (firinfoobj->>'fir_comments'), 
     incident_date= (firinfoobj->>'incident_date')::date, 
     fir_status= (firinfoobj->>'fir_status'),
     fir_statusdesc= (firinfoobj->>'fir_statusdesc'),     
     updated_on= now(), updated_by=v_securityuserid,
     delete_sw=(firinfoobj->>'delete_sw')::bpchar,
     active_flag= (firinfoobj->>'active_flag')::int4
    where pfir.provider_fir_id=v_providerfirid::uuid;
  end if;
v_response:='Success';
   return query
select v_response::text,v_providerfirid::CHARACTER VARYING;                                              
                                                                                                                                                                                                                                                                                                                                                                                           
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

