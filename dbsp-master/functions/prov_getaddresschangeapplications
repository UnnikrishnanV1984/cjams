CREATE OR REPLACE FUNCTION prov_getaddresschangeapplications(v_object json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$         
         
declare
         
v_listdata json;
 
BEGIN
    select json_agg(x) into v_listdata from (
        select  ta.*
        from tb_provider_applicant ta
        where  ((v_object->>'site_id') is null or  ta.site_id=(v_object->>'site_id')::int4 )
        and  ((v_object->>'provider_id') is null or  ta.provider_id=(v_object->>'provider_id')::int4 )
            and ta.application_type='ADDRESSCHANGE'
    )x;
    return v_listdata;
END; 

$function$

