CREATE OR REPLACE FUNCTION prov_addupdateaddresscertificate(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying; 

 begin                                                                                                                                                                                                                                                                                                                                                                                                 

v_securityuserid := insertobj->>'securityuserid';

if insertobj->>'provider_cpa_address_cert_id' is not null THEN 
    UPDATE tb_prov_cpa_address_cert tc 
    SET tc.active_flag = 0 
    WHERE tc.provider_cpa_address_cert_id = (insertobj->>'provider_cpa_address_cert_id')::uuid;
END IF;

if (insertobj->>'active_flag')::int4 = 1 THEN 

INSERT INTO tb_prov_cpa_address_cert (
cpa_provider_id, provider_id, cpa_siteid, cpa_initial_date, cpa_certificate_type, 
cpa_homeins_date, cpa_fireins_date, isinspection_home_family_record, isinspection_fire_family_record, 
ismeets_comar_requiremnt, status, create_ts, create_user_id, update_ts, update_user_id, active_flag, cpa_recert_date, 
cert_upload_url) VALUES((insertobj->>'cpa_provider_id')::int4,
(insertobj->>'provider_id')::int4, (insertobj->>'cpa_siteid')::bigint, (insertobj->>'cpa_initial_date')::Date, (insertobj->>'cpa_certificate_type')::character varying, 
(insertobj->>'cpa_homeins_date')::date, (insertobj->>'cpa_fireins_date')::date, (insertobj->>'isinspection_home_family_record')::bool,(insertobj->>'isinspection_fire_family_record')::bool, 
(insertobj->>'ismeets_comar_requiremnt')::bool, (insertobj->>'status')::character varying,now(), v_securityuserid,now(),v_securityuserid,1,(insertobj->>'cpa_recert_date')::date, 
(insertobj->>'cert_upload_url')::text);

END IF ;

return 'success';  
                                                                                                                                                                                                                                                                                                                                                                                              
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

