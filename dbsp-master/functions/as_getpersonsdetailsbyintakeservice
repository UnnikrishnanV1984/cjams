CREATE OR REPLACE FUNCTION as_getpersonsdetailsbyintakeservice(v_intakeserviceid uuid)
 RETURNS TABLE(rolename character varying, personid uuid, firstname character varying, lastname character varying, middlename character varying, dob timestamp without time zone, gender character varying, maritalstatus character varying, race character varying, ssn character varying, dcn character varying, drivinglicense character varying, address json, userphoto text, insertedbyid bigint, interfaceid bigint, currentgrade character varying, relationshiptypekey character varying, relationshiptypenumber integer, homephone character varying, mobile character varying)
 LANGUAGE plpgsql
AS $function$ declare _offset integer;
begin
return QUERY select
 "Person"."intakeservicerequestpersontypekey",
 "Person".personid,
 "Person".firstname,
 "Person".lastname,
 "Person".middlename,
 "Person".dob,
 "Person".gender,
 "Person".maritalstatus,
 "Person".race,
 "Person".SSN,
 "Person".DCN,
 "Person".DrivingLicense,
 (
 select
  json_agg(paddress) as address
 from
  (
  select
   pa.address,
   pa.address2,
   pa.city,
   pa.state,
   pa.zipcode
  from
   personaddress pa
  where
   pa.personid = "Person".personid
   --and pa.personaddresstypekey = 'C' 
   and activeflag = 1
  order by
   insertedon desc
  limit 1 ) as paddress )::json,
 "Person".userphoto ::text,
 --"Person".relationship :: character varying,
 "Person".insertedbyid,
 "Person".interfaceid,
 "Person".currentgrade,
 "Person".relationshiptypekey,
 "Person".relationshiptypenumber,
 "Person".HomePhone,
 "Person".Mobile
from
 (
 select
  IAR.intakeservicerequestpersontypekey as "intakeservicerequestpersontypekey",
  P.personid,
  p.firstname,
  p.lastname,
  p.middlename,
  gt.typedescription as gender,
  p.dob,
  p.userphoto,
  ---PA.address,PA.address2,PA.city,Pa.state,PA.zipcode,
  --AC.actorid,
  --max( IAR.intakeservicerequestactorid:: character varying) :: uuid as intakeservicerequestactorid,
 P.maritalstatustypekey as maritalstatus,
  RC.typedescription as race,
  PIDSSN.personidentifiervalue SSN,
  PIDDCN.personidentifiervalue DCN,
  PIDDL.personidentifiervalue DrivingLicense,
  --(SELECT PE.currentgradetypekey FROM Personeducation PE where PE.personid = P.personid
  --and PE.activeflag =1 order by PE.insertedon desc limit 1) currentgrade,
  -- (SELECT RT.relationshiptypekey from relationshiptype RT inner join actorrelationship AR on 
  -- RT.relationshiptypekey= AR.relationshiptypekey and AR.activeflag=1 
  -- and RT.activeflag =1
  -- where AR.intakeservicerequestactorID = 
  -- --max( IAR.intakeservicerequestactorid:: character varying) :: uuid
  -- IAR.intakeservicerequestactorid  
  -- group by RT.relationshiptypekey) as relationship,
 U.id as insertedbyid,
  P.interfaceid,
  AR.relationshiptypekey,
  RT.sequencenumber relationshiptypenumber,
  PHNHM.phonenumber as HomePhone,
  PHNMB.phonenumber as Mobile
 from
  Intakeservicerequestactor as IAR
 join actor as AC on
  IAR.actorid = AC.actorid
  and AC.activeflag = 1
  and IAR.activeflag = 1
 join person as P on
  P.personid = AC.personid
  and P.activeflag = 1
 left join gendertype GT on
  GT.gendertypekey = P.gendertypekey
 left join racetype RC on
  RC.racetypekey = P.racetypekey
 left join PersonIdentifier PIDSSN on
  PIDSSN.personid = p.personid
  and PIDSSN.personidentifiertypekey = 'SSN'
 left join PersonIdentifier PIDDCN on
  PIDDCN.personid = p.personid
  and PIDDCN.personidentifiertypekey = 'DCN'
 left join PersonIdentifier PIDDL on
  PIDDCN.personid = p.personid
  and PIDDCN.personidentifiertypekey = 'DL'
 left join actorrelationship AR on
  AR.intakeservicerequestactorID = IAR.intakeservicerequestactorid
  and AR.activeflag = 1
 left join relationshiptype RT on
  RT.relationshiptypekey = AR.relationshiptypekey
  and RT.activeflag = 1
 left join personphonenumber PHNHM on
  PHNHM.personid = p.personid
  and PHNHM.personphonetypekey = 'H'
 left join personphonenumber PHNMB on
  PHNMB.personid = p.personid
  and PHNMB.personphonetypekey = 'M'
 join UserProfile UP on
  UP.securityusersid = P.insertedby
 join muser U on
  U.securityusersid = UP.securityusersid
 where
  IAR.IntakeServiceId = v_intakeserviceid
  --and coalesce(iar.isprimary,false) =true 
) as "Person";
end;

$function$

