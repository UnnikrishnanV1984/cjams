/** Logic to Update the assessment at ApprovalIntake **/
IF EXISTS (SELECT * FROM assessment where intakenumber = v_intakenumber and activeflag = 1 and assessmentstatustypekey='Submitted')
THEN
Update assessment set updatedby=v_securityuserid,assessmentstatustypekey='Approved' WHERE intakenumber =v_intakenumber AND activeflag = 1 and assessmentstatustypekey='Submitted';
END IF;

SELECT (((jsondata->>'DAType')::json->>'DATypeDetail')::json #>>'{0}')::json ->> 'dispositioncode' into v_recomtype
  FROM intakedastaging WHERE intakenumber = v_intakenumber AND activeflag = 1;

SELECT (((jsondata->>'DAType')::json->>'DATypeDetail')::json #>>'{0}')::json ->> 'subSeriviceTypeValue' into v_servicetype
  FROM intakedastaging WHERE intakenumber = v_intakenumber AND activeflag = 1;

