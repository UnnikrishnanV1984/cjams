CREATE OR REPLACE FUNCTION as_validatecaseclosure(v_intakeserviceid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

declare  l_closure  json;

begin

    SELECT  json_agg(caseclosure)  INTO  l_closure  FROM  (
          SELECT  
                          --(SELECT  json_agg(task)  
          --  FROM(
    --  SELECT    am.name,ast.typedescription  AS  status  FROM  investigation  inv  
    --  INNER  JOIN  activity  act  ON  act.objectid  =  inv.investigationid  AND  inv.activeflag=1
    --  INNER  JOIN  activitytask  ats  ON  act.activityid  =  ats.activityid  AND  act.activeflag  =1
    --  INNER  JOIN  amtask  am  ON  ats.amtaskid  =  am.amtaskid  AND  am.activeflag=1  AND  ats.activeflag  =1
    --  INNER  JOIN    activitytaskstatustype  ast  ON  ast.activitytaskstatustypekey  =  ats.activitytaskstatustypekey  AND  ast.activeflag  =1               
    --  WHERE  inv.intakeserviceid  =v_intakeserviceid  AND  ats.activitytaskstatustypekey  NOT  IN  ('InvClosed')  )task)::  json  AS  task,
   (SELECT  json_agg(ass)  
              FROM(
           SELECT  astm.titleheadertext  AS  name,asst.typedescription  AS  status  FROM  assessment    ass
    INNER  JOIN  assessmentstatustype  asst  ON  ass.assessmentstatustypekey  =  asst.assessmentstatustypekey  AND  ass.activeflag=1  AND  asst.activeflag=1
    INNER  JOIN  assessmenttemplate  astm    ON  astm.assessmenttemplateid  =  ass.assessmenttemplateid  AND  astm.activeflag  =1
    WHERE  ass.assessmentstatustypekey  IN  ('InProcess','Review')  
    AND  ass.objectid  =  v_intakeserviceid
     )  ass
   )::  json  AS  assessment
 )caseclosure;  
return  l_closure;                
end;

$function$

