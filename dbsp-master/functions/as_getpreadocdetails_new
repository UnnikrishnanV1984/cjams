CREATE OR REPLACE FUNCTION as_getpreadocdetails_new(i_intakenumber character varying, i_intakeserviceid uuid, i_secid character varying)
 RETURNS TABLE(youthname character varying, youthid character varying, dateofbirth character varying, race character varying, gender character varying, provider_name character varying, provider_address character varying, provider_number character varying, school character varying, currentgrade character varying, officeworkername character varying, fathername character varying, fatherphonenumber character varying, fatheraddress character varying, fatherdob character varying, fatherage character varying, mothername character varying, motherphonenumber character varying, motheraddress character varying, motherdob character varying, motherage character varying, guardianname character varying, relationship character varying, guardianphonenumber character varying, guardianaddress character varying, guardiandob character varying, guardianage character varying, offensename jsonb, youthfullname character varying, youthfulladdress character varying, zipcode character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                             
DECLARE          
parentguaridanname character varying;  
relationship character varying;
parentguardianphonenumber character varying;
parentaddress character varying;
fathername character varying;
fatherphonenumber character varying;
fatheraddress character varying;
fatherdob character varying;
fatherage character varying;
mothername character varying;
motherphonenumber character varying;
motheraddress character varying;
motherdob character varying;
motherage character varying;
guardianname character varying;
guardianphonenumber character varying;
guardianaddress character varying;
guardiandob character varying;
guardianage character varying;
BEGIN         
  select  
   cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying),
   --cast(ac.relationshiptypekey as character varying),
   cast(coalesce(relphone.phoneextension,'000')||relphone.phonenumber as character varying),
   cast(pa.address||' '||pa.address2||' '||pa.city||','||pa.state||','||pa.zipcode as character varying) as parentaddress,
   cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,
   cast(age(now()::date,p.dob::date) as character varying) as parentage
   into fathername,fatherphonenumber,fatheraddress,fatherdob,fatherage
  from intakeservicerequestactor isra  
  left join actorrelationship ac on ac.intakeservicerequestactorid = isra.intakeservicerequestactorid and ac.relationshiptypekey = 'father' and ac.activeflag = 1
  join actor a on a.actorid = isra.actorid and a.activeflag =1
  join person p on p.personid = a.personid and p.activeflag = 1
  left join (select pa.*,pat.sequencenumber,pat.personaddresstypekey,pat.typedescription from personaddress pa 
   join personaddresstype pat on pat.personaddresstypekey = pa.personaddresstypekey and pat.activeflag = 1 and pa.activeflag = 1)pa
    on pa.personid = p.personid and pa.activeflag = 1
  left join (select ph.phoneextension,ph.phonenumber,ph.personid,pp.sequencenumber from personphonenumber ph left join personphonetype pp on ph.personphonetypekey = pp.personphonetypekey and ph.activeflag =1 and pp.activeflag =1) relphone on relphone.personid = p.personid 
  where  isra.intakeservicerequestpersontypekey = 'parent-or-guard' and isra.activeflag = 1 and 
  (case when i_intakenumber is not null then isra.intakenumber=i_intakenumber else true end) 
  or  
  (case when i_intakeserviceid is not null then isra.intakeserviceid=i_intakeserviceid else true end)
  order by pa.sequencenumber,relphone.sequencenumber limit 1;
  
  select  
   cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying),
   --cast(ac.relationshiptypekey as character varying),
   cast(coalesce(relphone.phoneextension,'000')||relphone.phonenumber as character varying),
   cast(pa.address||' '||pa.address2||' '||pa.city||','||pa.state||','||pa.zipcode as character varying) as parentaddress,
   cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,
   cast(age(now()::date,p.dob::date) as character varying) as parentage
   into mothername,motherphonenumber,motheraddress,motherdob,motherage
  from intakeservicerequestactor isra  
  left join actorrelationship ac on ac.intakeservicerequestactorid = isra.intakeservicerequestactorid and ac.relationshiptypekey = 'mother' and ac.activeflag = 1
  join actor a on a.actorid = isra.actorid and a.activeflag =1
  join person p on p.personid = a.personid and p.activeflag = 1
  left join (select pa.*,pat.sequencenumber,pat.personaddresstypekey,pat.typedescription from personaddress pa 
   join personaddresstype pat on pat.personaddresstypekey = pa.personaddresstypekey and pat.activeflag = 1 and pa.activeflag = 1)pa
    on pa.personid = p.personid and pa.activeflag = 1
  left join (select ph.phoneextension,ph.phonenumber,ph.personid,pp.sequencenumber from personphonenumber ph left join personphonetype pp on ph.personphonetypekey = pp.personphonetypekey and ph.activeflag =1 and pp.activeflag =1) relphone on relphone.personid = p.personid 
  where  isra.intakeservicerequestpersontypekey = 'parent-or-guard' and isra.activeflag = 1 and 
  (case when i_intakenumber is not null then isra.intakenumber=i_intakenumber else true end) 
  or  
  (case when i_intakeserviceid is not null then isra.intakeserviceid=i_intakeserviceid else true end)
  order by pa.sequencenumber,relphone.sequencenumber limit 1;
  
  select  
   cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying),
   cast(ac.relationshiptypekey as character varying),
   cast(coalesce(relphone.phoneextension,'000')||relphone.phonenumber as character varying),
   cast(pa.address||' '||pa.address2||' '||pa.city||','||pa.state||','||pa.zipcode as character varying) as parentaddress,
   cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,
   cast(age(now()::date,p.dob::date) as character varying) as parentage
   into guardianname,relationship,guardianphonenumber,guardianaddress,guardiandob,guardianage
  from intakeservicerequestactor isra  
  left join actorrelationship ac on ac.intakeservicerequestactorid = isra.intakeservicerequestactorid and ac.relationshiptypekey not in ('father','mother') and ac.activeflag = 1
  join actor a on a.actorid = isra.actorid and a.activeflag =1
  join person p on p.personid = a.personid and p.activeflag = 1
  left join (select pa.*,pat.sequencenumber,pat.personaddresstypekey,pat.typedescription from personaddress pa 
   join personaddresstype pat on pat.personaddresstypekey = pa.personaddresstypekey and pat.activeflag = 1 and pa.activeflag = 1)pa
    on pa.personid = p.personid and pa.activeflag = 1
  left join (select ph.phoneextension,ph.phonenumber,ph.personid,pp.sequencenumber from personphonenumber ph left join personphonetype pp on ph.personphonetypekey = pp.personphonetypekey and ph.activeflag =1 and pp.activeflag =1) relphone on relphone.personid = p.personid 
  where  isra.intakeservicerequestpersontypekey = 'parent-or-guard' and isra.activeflag = 1 and 
  (case when i_intakenumber is not null then isra.intakenumber=i_intakenumber else true end) 
  or  
  (case when i_intakeserviceid is not null then isra.intakeserviceid=i_intakeserviceid else true end)
  order by pa.sequencenumber,relphone.sequencenumber limit 1;
  
         RETURN QUERY                                                                                                                                                                                                                                                                                                                                      
           (select   
                cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying)as youthname,
                cast (p.cjamspid as character varying)as youthid,                      
    cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,    
    (select distinct typedescription from racetype where racetypekey=p.racetypekey) as race,   
    (select distinct typedescription from gendertype where gendertypekey=p.gendertypekey) as gender,      
     cast(pr.providername as character varying) as provider_name,                                                                                                                                                                                                                                                                              
    cast(paddr.buildingno||','||paddr.addressline1||','|| paddr.addressline2||','||paddr.city||','||paddr.state  as character varying) as provider_address,                                                                                                                                                                                           
    cast(pcinfo.phonenumber as character varying) as provider_number,                                                                                                                                                                                                                                                                                 
     cast(s.schoolname as character varying) as school,
     cast(gt.typedescription as character varying) as currentgrade,   
    (select distinct cast(concat(lastname,',',' ',firstname) as character varying) from userprofile up where securityusersid = i_secid) as officeworkername,
    --parentguaridanname,relationship,parentguardianphonenumber,parentaddress,parentdob,parentage,
    fathername,fatherphonenumber,fatheraddress,fatherdob,fatherage,
    mothername,motherphonenumber,motheraddress,motherdob,motherage,
    guardianname,relationship,guardianphonenumber,guardianaddress,guardiandob,guardianage,
    (select jsonb_agg(a."name")
      from allegation a 
      join intakeservicerequestevaluationconfig isrec on isrec.allegationid = a.allegationid and isrec.activeflag = 1 
      where isrec.intakeservicerequestevaluationid = isre.intakeservicerequestevaluationid 
      and isrec.activeflag = 1) as offensename,
    cast(INITCAP(TRIM(coalesce(p.lastname,''))|| CASE WHEN (p.suffix is not null and p.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(p.suffix,'')) || ', ' ||TRIM(coalesce(p.firstname,''))) as  character varying)   as youthfullname,  
    cast(pa.address||' '||pa.address2||' '||pa.city||','||pa.state||','||pa.zipcode as character varying) as youthfulladdress,
    cast(pa.zipcode as character varying) as zipcode
   from                                                                                                                                                                                                                                                                                                                                               
   intakedastaging idas 
   left join intakeservicerequest isr on isr.intakenumber = idas.intakenumber and isr.activeflag = 1 
   left join person p on idas.focuspersonid=p.personid and p.activeflag=1  
   left join (select pa.*,pat.sequencenumber,pat.personaddresstypekey,pat.typedescription from personaddress pa 
      join personaddresstype pat on pat.personaddresstypekey = pa.personaddresstypekey and pat.activeflag = 1 and pa.activeflag = 1)pa
       on pa.personid = p.personid and pa.activeflag = 1   
   left join placement pl on (idas.intakenumber =pl.intakenumber or isr.intakeserviceid = pl.intakeserviceid) and pl.activeflag=1                                                                                                                                                                                                                                                              
   left join placementprimaryadmissionreasontype pprt on pl.placementprimaryadmissionreasontypekey = pprt.placementprimaryadmissionreasontypekey and pprt.activeflag=1                                                                                                                                                                           
   left join provider pr ON pl.providerid = pr.providerid AND pr.activeflag=1                                                                                                                                                                                                                                                                
   left join provideraddress paddr ON pr.providerid = paddr.providerid AND paddr.activeflag=1                                                                                                                                                                                                                                                        
   left join providercontactinfo pcinfo ON pr.providerid = pcinfo.providerid AND pcinfo.activeflag = 1
   left join intakeservicerequestevaluation isre on isre.intakenumber = idas.intakenumber and isre.activeflag = 1
   left join (select *,row_number() over(partition by personid order by startdate desc) as recno from personeducation where activeflag = 1) pe on pe.personid = p.personid and pe.recno = 1
   left join school s on s.schoolid = pe.schoolid
   left join gradetype gt on gt.gradetypekey = pe.currentgradetypekey and gt.activeflag = 1
   where 
   ((case when i_intakenumber is not null then idas.intakenumber=i_intakenumber else true end) 
   or  
   (case when i_intakeserviceid is not null then isr.intakeserviceid=i_intakeserviceid else true end) )and idas.activeflag = 1
   order by pa.sequencenumber limit 1) ;                                                                                                                                                                                                                                                                                                       
    end;                                                                                                                                                                                                                                                                                                                                                   
  $function$

