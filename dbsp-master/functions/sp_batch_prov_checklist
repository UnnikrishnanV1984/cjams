 --PROVIDER_CHECKLIST:                       
 loop EXIT WHEN vl_row_cnt = 0::bigint ;     
  --WHILE vl_row_cnt > 0  DO              
  vl_provider_id := 0; -- INITIAL VALUE   
            
  FETCH CUR_PROVIDERS INTO vl_provider_id;
            
  IF vl_row_cnt = 0 THEN                  
   -- LEAVE PROVIDER_CHECKLIST;--      
  END IF; 
  
  IF vl_provider_id > 0 THEN       
   vl_outcode := 0; -- INITIAL VALUE 
   RAISE NOTICE '>>>>>>>>>before SP_FINANCIAL_EDITS---vl_provider_id>>>>>>>>>>%',vl_provider_id;
                          
   SELECT SP_FINANCIAL_EDITS 
    ( vl_provider_id, 
     'finance',              
     'Y'
    ) a 
   into vl_outcode;                
   RAISE NOTICE '>>>>>>>>>Output>>> SP_FINANCIAL_EDITS---vl_outcode>>>>>>>>>>%',vl_outcode;  
                         
   IF vl_outcode NOT IN ( 1, -1) THEN     
    RAISE NOTICE '>>>>>>>>>Inside---IF vl_outcode NOT IN ( 1, -1) THEN';  
    as_error := 'SP_FINANCIAL_EDITS failed for the Provider';             
    vs_identity_column := 'Provider ID';                                  
    vs_identity_val := TO_CHAR(vl_provider_id);                           
    -- SIGNAL p_sp_error  ;--                                             
   END IF ;                                                                  
                      
   -- 06/02/2008 To Update WITHHOLD_PAYMENT_SW, REASON_CHANGED and INFO_DATE_CHANGED - START 
   IF vl_outcode = -1 THEN                                
    vs_WITHHOLD_PAYMENT_SW := NULL; -- INITIAL VALUE   
    vs_REASON_CHANGED := NULL; -- INITIAL VALUE        
    vd_INFO_DATE_CHANGED := NULL; -- INITIAL VALUE     
    vl_find := NULL; -- INITIAL VALUE                  
                 
    SELECT WITHHOLD_PAYMENT_SW,                         
     REASON_CHANGED,                                 
     INFO_DATE_CHANGED,                              
     -- POSSTR( REASON_CHANGED, 'Withhold Payment (Returned Check)' ) AS POS    
     POSITION( REASON_CHANGED IN 'Withhold Payment (Returned Check)' ) AS POS   
    INTO vs_WITHHOLD_PAYMENT_SW,    
     vs_REASON_CHANGED,          
     vd_INFO_DATE_CHANGED,       
     vl_find                     
    FROM TB_PROVIDER                
    WHERE PROVIDER_ID = vl_provider_id 
     AND DELETE_SW = 'N' ;          
                      
    al_sqlcode := SQLCODE;          
    IF al_sqlcode <> 0 THEN         
     as_error := 'Error in selecting Provider Details, withhold sw and fields updated info'  ;    
     vs_identity_column := 'Provider ID';     
     vs_identity_val := TO_CHAR(vl_provider_id);
     --SIGNAL p_sp_error  ;--                   
    ELSE
     IF vs_WITHHOLD_PAYMENT_SW is NULL THEN   
      vs_WITHHOLD_PAYMENT_SW := 'N';       
     END IF;                                  
               
     IF vs_WITHHOLD_PAYMENT_SW = 'N' THEN    
      UPDATE TB_PROVIDER                  
       SET WITHHOLD_PAYMENT_SW = 'Y'   
      WHERE ( PROVIDER_ID = vl_provider_id OR AFFILIATE_PROVIDER_ID = vl_provider_id )  
       AND TB_PROVIDER.DELETE_SW = 'N' ;  
                
      al_sqlcode := SQLCODE;                  
      IF al_sqlcode <> 0 THEN                 
       as_error := 'Error in Updating TB_PROVIDER for WITHHOLD_PAYMENT_SW. (SQL-1)'  ;  
       vs_identity_column := 'Provider ID';           
       vs_identity_val := TO_CHAR(vl_provider_id);    
       --SIGNAL p_sp_error  ;--                       
      ELSE                                               
       vs_reason := NULL; -- INITIAL VALUE            
                   
       IF vl_find is NULL THEN                         
        vl_find := 0;                               
       END IF;                                         
                   
       IF vd_INFO_DATE_CHANGED = CURRENT_DATE THEN     
        vs_reason := vs_REASON_CHANGED;             
        IF vs_reason is NULL THEN                   
         vs_reason := '';                        
        END IF;                                     
        vs_reason := vs_reason || ', ';             
       ELSE                                            
        vs_reason := '';                            
       END IF;                                         
                   
       IF vl_find = 0 THEN                             
        vs_reason := vs_reason || 'Withhold Payment (Returned Check)' ;   
       END IF;                         
               
       UPDATE TB_PROVIDER              
        SET REASON_CHANGED = vs_reason , 
         INFO_DATE_CHANGED = CURRENT_DATE
       WHERE TB_PROVIDER.PROVIDER_ID = vl_provider_id 
        AND TB_PROVIDER.DELETE_SW = 'N' ;          
                   
       al_sqlcode = SQLCODE;                           
       IF al_sqlcode <> 0 THEN                         
        as_error := 'Error in Updating TB_PROVIDER for Fields Updated info. (SQL-2)'  ; 
        vs_identity_column := 'Provider ID';        
        vs_identity_val := TO_CHAR(vl_provider_id); 
        -- SIGNAL p_sp_error  ;--                   
       END IF ;                                        
      END IF ;                                            
     END IF;                                                 
    END IF ;                                                    
   END IF;                                                         
   -- 06/02/2008 To Update WITHHOLD_PAYMENT_SW, REASON_CHANGED and INFO_DATE_CHANGED - END  
  END IF;                             
           
  vl_row_cnt := vl_row_cnt  - 1;      
  --END WHILE ;--                     
 END loop;                               
CLOSE CUR_PROVIDERS ;                       
           
