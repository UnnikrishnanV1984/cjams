  ' UNION '||   
  ' SELECT DISTINCT ( CASE WHEN PR.PAY_TO_AFFILIATE_CD = ''3368'' THEN '|| 
  '                        P.PROVIDER_ORGANIZATION_ID '||
  '                   ELSE '|| 
  '                        P.PROVIDER_ID '||
  '                   END ) AS PROVIDER_ID '||    
  '  FROM TB_PLACEMENT_VALIDATION PV, '||   
  '        TB_PLACEMENT P, '||              
  '        TB_PROVIDER PR, '||              
  '       person C '||                   
  ' WHERE P.CLIENT_ID = C.cjamspid '||     
  '       AND P.PROVIDER_ID = PR.PROVIDER_ID '|| 
  '       AND C.activeflag = 1 '||            
  '       AND PR.DELETE_SW = ''N'' '||           
  '       AND P.PLACEMENT_ID = PV.PLACEMENT_ID '|| 
  '       AND PV.VALIDATION_STATUS_CD = ''1750'' '|| 
  '       AND PV.DELETE_SW = ''N'' '||               
  '       AND P.DELETE_SW = ''N'' '||                
  '       AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = ''N'')) '||   
  '       AND DATE(PV.UPDATE_TS) = '''|| TO_CHAR(ad_run_dt:: DATE, 'yyyy-mm-dd') ||''' '|| 
  '       AND P.CONVERSION_SW IS NULL '||                         
  '       AND P.PROVIDER_ORGANIZATION_ID IS NOT NULL '||          
  '       AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT)  '|| 
  ' UNION '||  
  ' SELECT DISTINCT ( CASE WHEN PR.PAY_TO_AFFILIATE_CD = ''3368'' THEN '|| 
  '                        P.PROVIDER_ORGANIZATION_ID '||                  
  '                   ELSE '||     
  '                        P.PROVIDER_ID '||  
  '                   END ) AS PROVIDER_ID '||
  '    FROM TB_PLACEMENT_VALIDATION PV, '||   
  '         TB_PLACEMENT P, '||               
  '         TB_PROVIDER PR, '||               
  '         person C '||                   
  '  WHERE P.CLIENT_ID = C.cjamspid '||      
  '        AND P.PROVIDER_ID = PR.PROVIDER_ID '|| 
  '        AND C.activeflag = 1 '||            
  '        AND PR.DELETE_SW = ''N'' '||           
  '        AND P.PLACEMENT_ID = PV.PLACEMENT_ID '|| 
  '        AND PV.VALIDATION_STATUS_CD = ''1750'' '|| 
  '        AND PV.DELETE_SW = ''N'' '||               
  '        AND P.DELETE_SW = ''N'' '||                
  '        AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = ''N'')) '|| 
  '        AND DATE(PV.UPDATE_TS) <> '''|| TO_CHAR(ad_run_dt:: DATE, 'yyyy-mm-dd') ||''' '||  
  '        AND P.CONVERSION_SW IS NULL '||                    
  '        AND P.PROVIDER_ORGANIZATION_ID IS NOT NULL '|| 
  '        AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT) '|| 
  '        AND P.CONTRACT_PROGRAM_ID IN ( SELECT A.PROGRAM_ID '|| 
  '                                    FROM TB_PROV_PROGRAM_SITES A '||  
  '                                   WHERE A.SITE_ID IN '||  
  '                                             ( SELECT SITE_ID '||  
  '                                                 FROM TB_PROV_PROGRAM_SITES '|| 
  '                                               WHERE DELETE_SW = ''N'' '||      
  '                                                     AND PROGRAM_ID IN '||      
  '                                                          ( SELECT PROGRAM_ID '|| 
  '                                                              FROM TB_PROV_PROGRAM_RATES '|| 
  '                                                            WHERE DELETE_SW = ''N'' '||      
  '                                                                  AND DATE(UPDATE_TS) = '''|| TO_CHAR(ad_run_dt:: DATE, 'yyyy-mm-dd') ||''' ))) ';
                                  
  -- SQL for Cursor (UNDER OVER PAYMENTS) - END
                         
  -- Take count to run a loop for cursor (UNDER OVER PAYMENTS) - START 
  SELECT COUNT(*)     
   INTO vl_row_cnt 
  FROM (              
    SELECT DISTINCT P.PROVIDER_ID     
    FROM TB_PLACEMENT_VALIDATION PV, 
      TB_PLACEMENT P,             
      TB_PROVIDER PR,             
      person C                 
    WHERE P.CLIENT_ID = C.cjamspid  
       AND P.PROVIDER_ID = PR.PROVIDER_ID   
       AND C.activeflag = 1 
       AND PR.DELETE_SW = 'N'               
       AND P.PLACEMENT_ID = PV.PLACEMENT_ID 
       AND PV.VALIDATION_STATUS_CD = '1750' 
       AND PV.DELETE_SW = 'N'               
       AND P.DELETE_SW = 'N'                
       AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = 'N'))   
       AND DATE(PV.UPDATE_TS) = ad_run_dt               
       AND P.CONVERSION_SW IS NULL                      
       AND P.PROVIDER_ORGANIZATION_ID IS NULL           
       AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT) 
    UNION   
    SELECT DISTINCT ( CASE WHEN PR.PAY_TO_AFFILIATE_CD = '3368' THEN  
       P.PROVIDER_ORGANIZATION_ID 
        ELSE                         
       P.PROVIDER_ID              
        END ) AS PROVIDER_ID         
    FROM TB_PLACEMENT_VALIDATION PV,       
    TB_PLACEMENT P,                     
    TB_PROVIDER PR,                     
    person C                         
    WHERE P.CLIENT_ID = C.cjamspid        
      AND P.PROVIDER_ID = PR.PROVIDER_ID
      AND C.activeflag = 1 
      AND PR.DELETE_SW = 'N'            
      AND P.PLACEMENT_ID = PV.PLACEMENT_ID 
      AND PV.VALIDATION_STATUS_CD = '1750' 
      AND PV.DELETE_SW = 'N'               
      AND P.DELETE_SW = 'N'                
      AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = 'N'))
      AND DATE(PV.UPDATE_TS) = ad_run_dt        
      AND P.CONVERSION_SW IS NULL               
      AND P.PROVIDER_ORGANIZATION_ID IS NOT NULL
      AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT)
   UNION                                                   
   SELECT DISTINCT ( CASE WHEN PR.PAY_TO_AFFILIATE_CD = '3368' THEN
       P.PROVIDER_ORGANIZATION_ID  
        ELSE                          
       P.PROVIDER_ID               
        END ) AS PROVIDER_ID          
   FROM TB_PLACEMENT_VALIDATION PV,         
    TB_PLACEMENT P,                      
    TB_PROVIDER PR,                      
    person C                          
   WHERE P.CLIENT_ID = C.cjamspid          
      AND P.PROVIDER_ID = PR.PROVIDER_ID    
      AND C.activeflag = 1 
      AND PR.DELETE_SW = 'N'                
      AND P.PLACEMENT_ID = PV.PLACEMENT_ID  
      AND PV.VALIDATION_STATUS_CD = '1750'  
      AND PV.DELETE_SW = 'N'                
      AND P.DELETE_SW = 'N'                 
      AND ((P.VOID_SW IS NULL) OR (P.VOID_SW = 'N')) 
      AND DATE(PV.UPDATE_TS) <> ad_run_dt            
      AND P.CONVERSION_SW IS NULL                    
      AND P.PROVIDER_ORGANIZATION_ID IS NOT NULL     
      AND (P.EXIT_DT IS NULL OR P.ENTRY_DT <> P.EXIT_DT) 
      AND P.CONTRACT_PROGRAM_ID IN ( SELECT A.PROGRAM_ID 
            FROM TB_PROV_PROGRAM_SITES A  
           WHERE A.SITE_ID IN             
               ( SELECT SITE_ID     
                FROM TB_PROV_PROGRAM_SITES  
              WHERE DELETE_SW = 'N'         
                 AND PROGRAM_ID IN       
                   ( SELECT PROGRAM_ID
                    FROM TB_PROV_PROGRAM_RATES  
                  WHERE DELETE_SW = 'N' 
                     AND DATE(UPDATE_TS) = ad_run_dt  )))
  ) AS DUMMY ;
  -- Take count to run a loop for cursor (UNDER OVER PAYMENTS) - END  
  
 ELSEIF as_activity = 'S' THEN 
  -- SQL for Cursor (Adult Services Service Plan Payment) - START 
  vs_cursor_sql :=   
  ' select distinct pr.provider_id '||  
  ' from ihasprovidermonthlyreport mrpt, '||  
  '  serviceplanlog svlg, '||  
     '  tb_provider pr, '||  
  '  intakeservicerequest cs '||  
  ' where mrpt.serviceplanlogid = svlg.serviceplanlogid '||  
  ' and mrpt.provider_id = pr.provider_id '||  
     ' and mrpt.intakeserviceid = cs.intakeserviceid '||  
  ' and mrpt.totalinvoiceamount > 0  '||  
  ' and mrpt.status = ''Approved'' '||  
  ' and mrpt.activeflag = 1 '||  
  ' and svlg.activeflag = 1 '||  
  ' and pr.delete_sw = ''N'' '||  
  ' and cs.activeflag = 1 '||  
  ' and  (  mrpt.reportedmonthyear::date between '''|| TO_CHAR(vd_previous_month_start_dt:: DATE, 'yyyy-mm-dd') ||''' AND '||
  '   '''|| TO_CHAR(vd_previous_month_end_dt:: DATE, 'yyyy-mm-dd') ||''' '||  
  '   OR '||  
  '   COALESCE(mrpt.ispaid, ''N'') <> ''Y'' '||  -- to process late approved Service Plans 
  '   ) '||  
  ' and mrpt.isvendorapproved = true   '||  
  ' order by pr.provider_id '   ; 
  -- SQL for Cursor (Adult Services Service Plan Payment) - END
                        
  -- Take count to run a loop for cursor (Adult Services Service Plan Payment) - START 
  select count(*) 
    into vl_row_cnt                                                                   
  from (             
   select distinct pr.provider_id
   from ihasprovidermonthlyreport mrpt,
     serviceplanlog svlg,
     tb_provider pr,
     intakeservicerequest cs
   where mrpt.serviceplanlogid = svlg.serviceplanlogid
    and mrpt.provider_id = pr.provider_id
    and mrpt.intakeserviceid = cs.intakeserviceid
