CREATE OR REPLACE FUNCTION prov_getactiveplacementforotherservices(v_providerid bigint, v_providertype character varying)
 RETURNS numeric
 LANGUAGE plpgsql
AS $function$

declare 
v_provplacement number;
v_service_nm text;
v_servicecount number;

BEGIN 

if v_providertype = 'Keep Adoptive Home Only'
then
v_service_nm = 'Adoptive Home';
end if;

if v_providertype = 'Keep Guardianship Home Only'
then
v_service_nm = 'Guardianship Assistance Program';
end if;

select count(*) into v_servicecount from tb_provider_services tps
join tb_services ts
on tps.service_id = ts.service_id 
where tps.provider_id = v_providerid
and ts.structure_service_cd = 'P' and ts.service_nm = v_service_nm;

if v_servicecount > 0
then
select count(*) into v_provplacement from tb_placement pl
join tb_services ts
on pl.placement_structure_id = ts.service_id 
where pl.delete_sw = 'N' and (pl.exit_dt is null or pl.exit_dt >= now())
  and ( pl.provider_organization_id = v_providerid or pl.provider_id = v_providerid or pl.contract_program_id = v_providerid ) 
  and ts.structure_service_cd = 'P' and ts.service_nm != v_service_nm;
else
v_provplacement = -1;
end if;

RETURN v_provplacement; 
 
END;

$function$

