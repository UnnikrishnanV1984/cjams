CREATE OR REPLACE FUNCTION as_isperonrolepresent(objectid character varying, personid character varying, objecttype character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
DECLARE
   v_result integer;
   v_count integer;
   v_personid uuid;
   v_rolekey character VARYING;
BEGIN
               v_personid := personid::uuid;
               IF(objectType = 'IN') THEN
       SELECT  CASE WHEN count(*) = 0
                           THEN 0
                           ELSE  1
                           END INTO v_result
       FROM     intakeservicerequestactor AS isra
       INNER JOIN     actor AS ar
       ON       ar.actorid = isra.actorid 
       INNER JOIN     person AS pn 
       ON       pn.personid = ar.personid 
       INNER JOIN     personrole AS pr 
       ON       pn.personid = pr.personid 
       INNER JOIN     personroletype AS ptype 
       ON       ptype.personroleid = pr.personroleid 
       INNER JOIN     referencevalues AS rv 
       ON       ptype.roletype = rv.ref_key AND referencetypeid=342
          WHERE    pn.personid =v_personid::uuid
          AND isra.intakenumber=objectID;
          return v_result;
     ELSEIF(objectType = 'IS') THEN
        SELECT   CASE WHEN count(*) = 0
                           THEN 0
                           ELSE  1
                           END INTO v_result
        FROM     intakeservicerequestactor AS isra
        INNER JOIN     actor AS ar
        ON       ar.actorid = isra.actorid 
        INNER JOIN     person AS pn 
        ON       pn.personid = ar.personid 
        INNER JOIN     personrole AS pr 
        ON       pn.personid = pr.personid 
        INNER JOIN     personroletype AS ptype 
        ON       ptype.personroleid = pr.personroleid 
        INNER JOIN     referencevalues AS rv 
        ON       ptype.roletype = rv.ref_key AND referencetypeid=342
           WHERE    pn.personid =v_personid::uuid
           AND isra.intakeserviceid=objectID::uuid;
           return v_result;
        ELSE
              SELECT   CASE WHEN count(*) = 0
                           THEN 0
                           ELSE  1
                           END INTO v_result
        FROM     intakeservicerequestactor AS isra
        INNER JOIN     actor AS ar
        ON       ar.actorid = isra.actorid 
        INNER JOIN     person AS pn 
        ON       pn.personid = ar.personid 
        INNER JOIN     personrole AS pr 
        ON       pn.personid = pr.personid 
        INNER JOIN     personroletype AS ptype 
        ON       ptype.personroleid = pr.personroleid 
        INNER JOIN     referencevalues AS rv 
        ON       ptype.roletype = rv.ref_key AND referencetypeid=342
           WHERE    pn.personid = v_personid::uuid
           AND isra.servicecaseid=objectID::uuid;
           return v_result;
      
     END IF;
END;
$function$

