CREATE OR REPLACE FUNCTION as_personadd(v_person json, v_securityuserid character varying)
 RETURNS TABLE(v_personuniqueid uuid, vcjamspid bigint)
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_date timestamp without time zone;
v_personuniqueid uuid;
v_cjamspid bigint;

 BEGIN  
 
  v_date:=  now()  at  time  zone  'utc';
 
 

INSERT INTO Person
 (              
    
  activeflag,

  firstname,

  lastname,

  middlename,

  dob,

  gendertypekey,

  insertedby,

  insertedon,

  dateofdeath,

  isapproxdod,

  stateid,  

  racetypekey,  

  ethnicgrouptypekey,  

  occupation,    

  tribalassociation,  

  physicalattributes,   

  effectivedate,   

  suffix,  

  userphoto,

  livingsituationdesc,

  primarylanguageid,

  secondarylanguageid,

  isuscitizen,
  
  ssnno,
  
  --heightininch,

  --weightinlb,
  
     citizenalenageflag 
 )
 VALUES(

   1,
         
   v_person  ->>'firstname' :: character varying,  

   v_person  ->>'lastname' :: character varying,  

   v_person  ->>'middlename' :: character varying, 

   (v_person  ->>'dob')::timestamp,

   v_person  ->>'gendertypekey' :: character varying, 

   v_securityuserid :: character varying ,

   v_date,

   (v_person  ->>'dateofdeath')::timestamp ,
   
   (v_person  ->>'isapproxdod')::int,

   v_person  ->>'stateid' :: character varying,

   v_person  ->>'racetypekey' :: character varying, 

   v_person  ->>'ethnicgrouptypekey' :: character varying, 

   v_person  ->>'occupation' :: character varying ,

   v_person  ->>'tribalassociation' :: character varying ,

   v_person  ->>'physicalattributes' :: character varying ,

   v_date,

   v_person  ->>'suffix' :: character varying, 

   v_person  ->>'userphoto' :: character varying, 

   v_person  ->>'livingsituationdesc' :: character varying,

   v_person  ->>'primarylanguageid' :: character varying,

   v_person  ->>'secondarylanguageid' :: character varying,

   v_person  ->>'isuscitizen' :: character varying,

   v_person  ->>'ssn' :: character varying,

   --(v_person  ->>'height')::int,

   --(v_person  ->>'weight')::int,
   
   (v_person->>'citizenalenageflag'):: int
  
   )returning personid,cjamspid INTO v_personuniqueid,v_cjamspid;
   
   RETURN query
  select v_personuniqueid,v_cjamspid;
     END;
   
$function$

