CREATE OR REPLACE FUNCTION getproviderstaffconfig(v_provider_uir_staff_config_id uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

SELECT  Json_agg(a)  INTO      jsondata  FROM      (  

SELECT PUSC.provider_uir_staff_config_id, PUSC.provider_uir_id, PUSC.provider_staff_id,
TPS.employee_first_nm,TPS.employee_middle_nm,TPS.employee_last_nm,TPS.job_title,
TPS.behavioral_interventions_training,TPS.training_program

FROM provider_uir_staff_config PUSC 

left join tb_provider_staff TPS on TPS.provider_staff_id=PUSC.provider_staff_id

where PUSC.provider_uir_staff_config_id=v_provider_uir_staff_config_id



   )  a;

RETURN  jsondata;
END;

$function$

