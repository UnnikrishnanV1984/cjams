 LANGUAGE plpgsql
AS $function$ declare v_searchkey character varying ;

v_pageoffset int;

v_pagenumber int;

limitstring character varying(500);

declare searchstring character varying(5000);
begin
v_pagenumber := pagenumber-1;

v_pageoffset = v_pagenumber * pagesize;

limitstring := '';

if (not nolimit) then limitstring := ' LIMIT ' || pagesize || ' OFFSET ' || v_pageoffset;
end if ;

searchstring := coalesce(searchstring, '');

if(searchcol != ''
and searchval != '' ) then if (searchcol = 'intakenumber') then searchstring := '  AND  inr.intakenumber  =  ''' || searchval || '''  ';
end if;

if (searchcol = 'servicerequestnumber') then searchstring := '  AND  ISR.servicerequestnumber  =  ''' || searchval || '''  ';
end if;
end if;

