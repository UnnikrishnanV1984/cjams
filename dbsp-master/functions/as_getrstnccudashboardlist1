  where inr.isccusent = true and inr.activeflag=1 and inr.status!=''Inactive'' and r.fromsecurityusersid = ''' || v_securityusersid || '''  
  ' || searchstring || '
   ORDER BY inr.updatedon desc  ' || limitstring || '';

elsif lower(v_status) = 'approved finance worker' then return Query execute 'select count(1) over() totalcount, inr.intakeserreqrestitutionid,
cast((select distinct up.lastname || ', ' || up.firstname from userprofile up where securityusersid = v_securityuserid) as character varying) as  officeworkername,
 inr.restitutionno ,
