  cast(INITCAP(TRIM(coalesce(yp.lastname,''''))|| CASE WHEN yp.suffix is not null THEN '' '' ELSE '''' END  || TRIM(coalesce(yp.suffix,'''')) || '', '' ||TRIM(coalesce(yp.firstname,''''))) as  character varying) as DJSyouthpersonname,
