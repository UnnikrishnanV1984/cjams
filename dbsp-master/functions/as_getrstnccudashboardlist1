    on ISR.intakeserviceid = inr.intakeserviceid and ISR.activeflag=1  
        Join routing as r 
    on r.objectid = inr.restitutionno::character varying and r.activeflag = 1 and r.routingstatustypeid = 63    
  where inr.isccusent = true and inr.activeflag=1 and inr.status!=''Inactive'' and r.tosecurityusersid = ''' || v_securityusersid || ''' 
  ' || searchstring || '
   ORDER BY inr.updatedon desc  ' || limitstring || '';

