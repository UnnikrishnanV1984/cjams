CREATE OR REPLACE FUNCTION get_service_plan_action_list(v_personid uuid, pagenumber bigint, pagesize bigint)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE
 v_pageoffset  int;
 v_pagenumber  int;  
 l_serviceaction json;
BEGIN
        v_pagenumber  :=  pagenumber-1;
        v_pageoffset  =  v_pagenumber  *  pagesize;
    
     SELECT json_agg(e) INTO l_serviceaction FROM(SELECT count(1)  over() as totalcount,sp.serviceplanid,sp.serviceplanname,
sa.serviceplanactionid,sa.serviceplanactionname,
sf.objectivename,sf.splanobjectiveid 
FROM serviceplanaction sa 
JOIN splanobjective sf on sa.splanobjectiveid=sf.splanobjectiveid
join splangoal sg on sg.splangoalid = sf.splangoalid
JOIN serviceplan sp on sp.serviceplanid=sg.serviceplanid
JOIN serviceplanpersoninvolved sppi on sppi.serviceplanactionid=sa.serviceplanactionid
              
WHERE sppi.personinvolved=v_personid::uuid 
AND lower(sp.approvalstatustypekey) = 'approved' 
--LIMIT  pagesize  OFFSET  v_pageoffset          
group by sp.serviceplanid,sp.serviceplanname,
sa.serviceplanactionid,sa.serviceplanactionname,
sf.objectivename,sf.splanobjectiveid      
)e ;
RETURN l_serviceaction;
END;

$function$

