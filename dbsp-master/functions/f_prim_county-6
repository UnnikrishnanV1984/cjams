CREATE OR REPLACE FUNCTION f_prim_county(ai_entity_id integer, p_start_date date, p_end_date date)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare ai_entity_cd varchar(5);
    declare ai_case_cd varchar(5);
BEGIN
    return (select from_county_cd 
              from (select row_number() over() as num
                         , from_county_cd
                         , assignment_id 
                      from (SELECT CASE WHEN ACTIVITY_SW = 'W' THEN FROM_COUNTY_CD
                                        WHEN ACTIVITY_SW = 'T' THEN TO_COUNTY_CD
                                        WHEN ACTIVITY_SW = 'U' THEN TO_COUNTY_CD 
                                    END AS county_code
                                 , assignment_id
                              FROM TB_ASSIGNMENT
                             WHERE ENTITY_KEY_ID     = AI_ENTITY_ID 
                               AND RESPONSIBILITY_CD = 'P'
                               AND DELETE_SW         = 'N' 
                               AND START_DT         <= P_END_DATE 
                               AND (ENTITY_TYPE_CD = '2952' OR ENTITY_TYPE_CD   = '5590') 
                               AND (END_DT >= P_START_DATE OR END_DT IS NULL) 
                             ORDER BY assignment_id DESC
                          ) as te 
                   ) as rty where num=1
           );
END;

$function$

