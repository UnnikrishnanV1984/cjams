CREATE OR REPLACE FUNCTION as_isprimarypersonrolepresent(intakeserviceid uuid, intakenumber character varying, personid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE
   v_result text;
   v_count integer;
   v_personid uuid;
   v_rolekey character VARYING;
   v_intakeserviceid character VARYING;
   v_intakenumber character VARYING;

BEGIN
v_personid := personid::uuid;
v_intakeserviceid :=intakeserviceid::uuid;
v_intakenumber := intakenumber;
raise notice 'v_personid %',  v_personid;
raise notice 'intakeserviceid %',  intakeserviceid;
-- Primary role has been configure as 342 
-- This will return null if person role are not bellongs to primary role 
-- Limit 1 - as per buisness logic CHILD and LG can not be selected for selected person
             IF intakeserviceid IS NOT NULL THEN  
       SELECT rv.ref_key INTO  v_result
       FROM     intakeservicerequestactor AS isra
       INNER JOIN     actor AS ar
       ON       ar.actorid = isra.actorid 
       INNER JOIN     person AS pn 
       ON       pn.personid = ar.personid 
       INNER JOIN     personrole AS pr 
       ON       pn.personid = pr.personid 
       INNER JOIN     personroletype AS ptype 
       ON       ptype.personroleid = pr.personroleid 
       INNER JOIN     referencevalues AS rv 
       ON       ptype.roletype = rv.ref_key 
          WHERE    pn.personid =v_personid::uuid
          AND isra.intakeserviceid=v_intakeserviceid::uuid  AND referencetypeid=342  Limit 1;
          raise notice 'v_result %',  v_result;
       -- IF primary role not found then select 1st array role 
       IF v_result ISNULL THEN 
        SELECT ptype.roletype INTO  v_result
        FROM     intakeservicerequestactor AS isra
        INNER JOIN     actor AS ar
        ON       ar.actorid = isra.actorid 
        INNER JOIN     person AS pn 
        ON       pn.personid = ar.personid 
        INNER JOIN     personrole AS pr 
        ON       pn.personid = pr.personid 
        INNER JOIN     personroletype AS ptype 
        ON       ptype.personroleid = pr.personroleid 
        WHERE    pn.personid =v_personid::uuid
           AND isra.intakeserviceid=v_intakeserviceid::uuid  Limit 1;
        
       END IF;
      ELSE 
        SELECT rv.ref_key INTO  v_result
       FROM     intakeservicerequestactor AS isra
       INNER JOIN     actor AS ar
       ON       ar.actorid = isra.actorid 
       INNER JOIN     person AS pn 
       ON       pn.personid = ar.personid 
       INNER JOIN     personrole AS pr 
       ON       pn.personid = pr.personid 
       INNER JOIN     personroletype AS ptype 
       ON       ptype.personroleid = pr.personroleid 
       INNER JOIN     referencevalues AS rv 
       ON       ptype.roletype = rv.ref_key 
          WHERE    pn.personid =v_personid::uuid
          AND isra.intakenumber=v_intakenumber  AND referencetypeid=342  Limit 1;
          raise notice 'v_result %',  v_result;
       -- IF primary role not found then select 1st array role 
       IF v_result ISNULL THEN 
        SELECT ptype.roletype INTO  v_result
        FROM     intakeservicerequestactor AS isra
        INNER JOIN     actor AS ar
        ON       ar.actorid = isra.actorid 
        INNER JOIN     person AS pn 
        ON       pn.personid = ar.personid 
        INNER JOIN     personrole AS pr 
        ON       pn.personid = pr.personid 
        INNER JOIN     personroletype AS ptype 
        ON       ptype.personroleid = pr.personroleid 
        WHERE    pn.personid =v_personid::uuid
           AND isra.intakenumber=v_intakenumber  Limit 1;
        
       END IF;
   
   END IF;    
       return v_result;

END;
$function$

