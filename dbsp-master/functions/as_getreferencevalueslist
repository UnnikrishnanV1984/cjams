CREATE OR REPLACE FUNCTION as_getreferencevalueslist(v_rolecode character varying)
 RETURNS TABLE(ref_key character varying, referencetypeid integer, value_text character varying, description character varying, teamtypekey character varying, activeflag integer, displayorder integer, mdmcode character varying, parenttypeid integer, parentkey character varying, isyouthbasereport boolean)
 LANGUAGE plpgsql
AS $function$
begin
 return query
 SELECT 
 rv.ref_key as ref_key,
rv.referencetypeid as referencetypeid,
rv.value_text as value_text,
rv.description as description,
rv.teamtypekey as teamtypekey,
rv.activeflag as activeflag,
rv.displayorder as displayorder,
rv.mdmcode as mdmcode,
rv.parenttypeid as parenttypeid,
rv.parentkey as parentkey,
prc.isyouthbasereport as isyouthbasereport
FROM referencevalues rv
LEFT JOIN personreportconfig prc ON prc.ref_key = rv.ref_key
inner join referencetype rt on rt.referencetypeid=rv.referencetypeid and rt.activeflag=1 where
CASE
    WHEN v_rolecode = 'JSSP' THEN rt.tablename='djssupreports'
    WHEN v_rolecode = 'JSCW' THEN rt.tablename='djscommonreports'
end
ORDER BY rv.displayorder asc;
end;
$function$

