CREATE OR REPLACE FUNCTION savepersonalert(v_alerttype character varying, v_status character varying, v_startdatetime timestamp without time zone, v_notes text, v_personid uuid, v_securityuserid character varying, intakeserviceid uuid DEFAULT NULL::uuid, duedate timestamp without time zone DEFAULT NULL::timestamp without time zone, v_intakeserreqrestitutionid uuid DEFAULT NULL::uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


DECLARE 

v_personalertid uuid;
v_date timestamp without time zone;
v_intakeserviceid uuid;
v_duedate date;
v_enddate timestamp without time zone;
v_personalertidtext text;
 
BEGIN
        v_date:= now()::date;
  v_intakeserviceid := intakeserviceid;
  v_duedate := duedate;
     v_enddate := null;
 if (v_alerttype='PONA') then
 v_enddate = ((now()+ interval '90 day')::date );
 end if;
 v_personalertid :=   gen_random_uuid();
--if (v_alerttype='REST') then
 --  raise notice 'v_personalertid%',v_personalertid;
 --update intakeserreqrestitution set personalertid=v_personalertid where intakeserreqrestitutionid=v_intakeserreqrestitutionid;
 --end if;
  
 
 Insert Into personalert (personalertid, alerttype, status, startdatetime,enddatetime, notes, activeflag, insertedby, updatedby, insertedon, updatedon, personid
 , intakeserviceid, duedate)
 values (v_personalertid, v_alerttype, v_status, v_startdatetime, v_enddate, v_notes, 1, v_securityuserid, v_securityuserid, v_date, v_date, v_personid
 , v_intakeserviceid, v_duedate);
v_personalertidtext:=v_personalertid;

Return v_personalertidtext;
 
END;


$function$

