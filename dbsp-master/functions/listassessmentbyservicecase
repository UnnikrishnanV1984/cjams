CREATE OR REPLACE FUNCTION listassessmentbyservicecase(v_servicecaseid uuid, pageno integer, pagesize integer, v_roletypecode character varying DEFAULT ''::character varying)
 RETURNS TABLE(totalcount bigint, assessmenttemplateid uuid, external_templateid character varying, isvisible boolean, description text, targetroletypekey character varying, intakassessment json)
 LANGUAGE plpgsql
AS $function$


declare 

BEGIN


   CREATE temp TABLE temp_servreqtype 
    ( 
       intakeservreqtypeid    UUID, 
       intakeservreqsubtypeid UUID 
    ); 
  
   INSERT INTO temp_servreqtype 
               (intakeservreqtypeid, 
                intakeservreqsubtypeid) 
   SELECT DISTINCT intakeservreqtypeid::uuid , 
                    '00000000-0000-0000-0000-000000000000'::uuid  
   FROM   servicecase 
   WHERE  servicecaseid = v_servicecaseid; 
  
  


RETURN QUERY  

  SELECT Count(1) OVER() totalcount, 
      * 
   FROM   ( SELECT     at.assessmenttemplateid, 
             at.external_templateid , 
             at.isvisible, 
             Cast(at.titleheadertext AS TEXT) AS description , 
             at.targetroletypekey, 
             ( SELECT * FROM   Getassessmentdetailsbyservicecase(v_servicecaseid :: character VARYING,at.assessmenttemplateid,'CW')) as intakassessment 
             
             FROM       assessmenttemplate at 
   INNER JOIN assessmenttemplatecategoryfiltermap astfm 
   ON         astfm.assessmenttemplateid = at.assessmenttemplateid 
   AND        astfm.activeflag =1 
   AND        at.activeflag =1 
   WHERE      ( 
                         intakeservicerequesttypeid,intakeservicerequestsubtypeid) IN 
              ( 
                     SELECT intakeservreqtypeid, 
                            intakeservreqsubtypeid 
                     FROM   temp_servreqtype) 
   AND        astfm.assessmenttemplatetargetid= '30c89758-0cc4-4b4a-92b6-df57819a178b'
  
  ) AS ast ORDER BY ast.description limit pagesize offset pageno ;

drop table temp_servreqtype;
 
END;


$function$

