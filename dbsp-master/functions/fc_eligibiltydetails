CREATE OR REPLACE FUNCTION fc_eligibiltydetails(client_id integer, eligibility character varying)
 RETURNS TABLE(clientid integer, createddate timestamp without time zone, v_eligibility character varying, periodtype character varying, peroidstartdate timestamp without time zone, periodenddate timestamp without time zone, periodstatus character varying, eventdate timestamp without time zone, eventstartdate timestamp without time zone, eventenddate timestamp without time zone, eventtype character varying, eventstatus character varying, eventreason character varying, first_nm character varying, middle_nm character varying, last_nm character varying)
 LANGUAGE plpgsql
AS $function$ 

DECLARE 
 --
 v_clientId int;
 clientId int;
 v_eligibility_id int;
 createdDate timestamp;
 v_eligibility varchar(20); 
 periodType character varying; 
 peroidStartDate date; 
 periodEndDate date; 
 periodStatus character varying; 
 eventDate date; 
 eventStartDate date; 
 eventEndDate date; 
 eventType character varying; 
 eventStatus character varying; 
 eventReason character varying; 
 first_nm character varying; 
 middle_nm character varying; 
 last_nm character varying;

BEGIN  
 --
 v_clientId := client_id;

RETURN QUERY 
SELECT 
 --TB_CLIENT_ELIGIBILITY
 tce.client_id                            AS  clientId,              
 tce.create_ts                            AS  createdDate,             
 tce.eligibility_type_cd                  AS  eligibility, 

 --TB_ELIGIBILITY_PERIOD
 tep.type_cd                             AS  periodType,              
 tep.start_dt                            AS  peroidStartDate,             
 tep.end_dt                     AS  periodEndDate,
 tep.status_cd                            AS  periodStatus,

 --TB_ELIGIBILITY_EVENTS
 tee.event_dt                            AS  eventDate,              
 tee.event_start_dt                         AS  eventStartDate,             
 tee.event_end_dt                    AS  eventEndDate,
 tee.type_cd                             AS  eventType,
 tee.resulting_status_cd                 AS  eventStatus,
 tee.reason_cd                           AS  eventReason,

 --person
 per.firstname                              AS  first_nm,              
 per.middlename                             AS  middle_nm,             
 per.lastname                               AS  last_nm

FROM tb_client_eligibility AS tce
INNER JOIN tb_eligibility_period AS tep ON tce.eligibility_id = tep.eligibility_id
INNER JOIN tb_eligibility_events AS tee ON tep.eligibility_period_id = tee.eligibility_period_id
INNER JOIN person AS per ON tce.client_id = per.cjamspid
WHERE per.cjamspid = v_clientId;

SELECT 
--TB_CLIENT_ELIGIBILITY
tbce.eligibility_id INTO v_eligibility_id 

FROM tb_client_eligibility AS tbce
WHERE tbce.client_id = v_clientId;

UPDATE tb_client_eligibility AS tc SET eligibility_type_cd = eligibility 
WHERE tc.eligibility_id = v_eligibility_id;

--return clientId;

 END;
$function$

