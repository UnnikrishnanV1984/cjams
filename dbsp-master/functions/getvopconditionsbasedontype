CREATE OR REPLACE FUNCTION getvopconditionsbasedontype(i_vopviolationoffencetype character varying, i_intakeservicepetitionid uuid)
 RETURNS TABLE(conditiontypekey character varying, description character varying, conditiontypedescription text, completiondate timestamp without time zone, intakeservicerequestcourtconditiontypeconfigid uuid)
 LANGUAGE plpgsql
AS $function$

declare querycct text;
declare querytct  text ;
 
begin
 
 querycct='
select cndt.conditiontypekey, cndt.description,cctc.conditiontypedescription,cctc.completiondate,cctc.intakeservicerequestcourtconditiontypeconfigid
 from intakeservicerequestcourtconditiontypeconfig cctc 
 join conditiontype cndt on cndt.conditiontypekey = cctc.conditiontypekey
 where cctc.courtactionallegationconfigid in
(select cac.courtactionallegationconfigid  from intakeservicerequestcourtordertypeconfig incoc 
join courtactionallegationconfig cac on cac.courtactionallegationconfigid=incoc.courtactionallegationconfigid and cac.activeflag=1
join intakeservicerequestevaluationconfig itc on cac.intakeservicerequestevaluationconfigid=itc.intakeservicerequestevaluationconfigid and itc.activeflag=1
join courtordertype ct on ct.courtordertypekey=incoc.courtordertypekey
where incoc.courtordertypekey=''PB''
and itc.intakeservicerequestevaluationconfigid in 
(select ITSEC.intakeservicerequestevaluationconfigid from intakeservicerequestevaluationconfig ITSEC 
join intakeservreqevalpetitionconfig inpe on inpe.intakeservicerequestevaluationid=ITSEC.intakeservicerequestevaluationid and inpe.activeflag=1
where  ITSEC.activeflag=1 and
inpe.intakeservicerequestpetitionid='''||I_intakeservicepetitionid||''' or 
inpe.intakeservicerequestpetitionid in (select ipr.intakeservicerequestpetitionid from intakeservicerequestpetition ipr where 
ipr.voppetitionid='''||I_intakeservicepetitionid||''')
-- inpe.intakeservicerequestpetitionid='''||I_intakeservicepetitionid||'''
))';

 querytct='select  value_text ,description ,'''' ::text,null :: timestamp without time zone,null:: uuid from referencevalues rv
 join referencetype rt on rt.referencetypeid=rv.referencetypeid and rt.activeflag=1
 where rt.tablename=''vop Technical Conditions''';

 if(I_vopviolationoffencetype='cct')
 then
 return query execute querycct;
 else if(I_vopviolationoffencetype='tct')
 then
  return query execute querytct;
 end if;
 end if;
  end;


$function$

