CREATE OR REPLACE FUNCTION f_sp_ename(as_type_cd character varying, ai_key_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
 declare vi_start_screening_id integer;
 
BEGIN

         select ((rtrim(app_pref_value_tx))::INTEGER) INTO vi_start_screening_id from tb_application_preference where app_pref_id = 52;

      case as_type_cd
         when '2952' then
            return (select case_nm from chessie.tb_case where case_id = ai_key_id and delete_sw = 'N');

         when '2953' then
      return (select
    CASE
      WHEN LENGTH(RTRIM(provider_nm)) > 0 THEN provider_nm
      ELSE
        coalesce(provider_first_nm || ' ','')  ||
        coalesce(provider_middle_nm || ' ','') ||
        coalesce(provider_last_nm || ' ','') ||
        coalesce(f_pdesc(provider_suffix_cd,214),'')
    END
       from chessie.tb_provider
       where provider_id = ai_key_id and delete_sw = 'N');

         when '2954' then
        if AI_KEY_ID >= vi_start_screening_id then
               return (select screening_nm from chessie.tb_screening where screening_id = ai_key_id and delete_sw = 'N');
       else
               return (select referral_nm from chessie.tb_referral where referral_id = ai_key_id and delete_sw = 'N');
              end if;  

         when '2957' then
              return (select referral_nm from chessie.tb_referral where referral_id = ai_key_id and delete_sw = 'N');

         when  '2955' then
              return (select  coalesce(first_nm || ' ','') ||
    coalesce(middle_nm || ' ','') ||
    coalesce(last_nm || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from chessie.tb_client
   where client_id = ai_key_id and delete_sw = 'N');

         when '2956' then
              return (select  coalesce(first_nm || ' ','') ||
    coalesce(middle_nm || ' ','') ||
    coalesce(last_nm || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from chessie.tb_staff
   where staff_id = ai_key_id and delete_sw = 'N');

         when '5189' then
   return ( select   CASE
      WHEN LENGTH(RTRIM(provider_referral_nm)) > 0 THEN provider_referral_nm
      ELSE
     coalesce(provider_referral_first_nm || ' ','')  ||
       coalesce(provider_referral_middle_nm || ' ','') ||
     coalesce(provider_referral_last_nm || ' ','')   ||
   coalesce(f_pdesc(provider_referral_suffix_cd,214),'')
      END 
   from chessie.tb_provider_referral
   where provider_referral_id = ai_key_id and delete_sw = 'N' );

        when '5589' then

              return (select  coalesce(first_nm || ' ','') ||
    coalesce(middle_nm || ' ','') ||
    coalesce(last_nm || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from chessie.tb_person
   where person_id = ai_key_id and delete_sw = 'N');

         when '5590' then
              return (select case_nm from chessie.tb_case where case_id = ai_key_id and  delete_sw = 'N');

        else
              return space(1);
      end case;
      
end;

$function$

