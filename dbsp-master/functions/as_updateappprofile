CREATE OR REPLACE FUNCTION as_updateappprofile(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
v_securityuserid character varying;
v_profileid uuid;
i json;
v_addressarr json;
v_emails json;
v_phones json;
v_providerid character varying;

begin
v_securityuserid:=insertobj->>'securityuserid';
v_addressarr:=insertobj->>'address';
v_emails:=insertobj->>'emails';
v_phones:=insertobj->>'phonenumbers';

select provider_id , applicant_profile_id into v_providerid , v_profileid from tb_provider_applicant where tb_provider_applicant.applicant_id = insertobj->>'applicant_id';

if v_profileid is not null AND v_providerid is null
THEN

UPDATE tb_provider_applicant_profile
SET tax_id_no=(insertobj->>'tax_id_no')::int, medicaid_sw=insertobj->>'medicaid_sw', withhold_payment_sw=insertobj->>'withhold_payment_sw',provider_applicant_category_cd=insertobj->>'provider_applicant_category_cd', 
provider_applicant_status_cd=insertobj->>'provider_applicant_status_cd', provider_applicant_nm=insertobj->>'provider_applicant_nm', provider_applicant_prefix_cd=insertobj->>'provider_applicant_prefix_cd', provider_applicant_first_nm=insertobj->>'provider_applicant_first_nm',
provider_applicant_middle_nm=insertobj->>'provider_applicant_middle_nm', provider_applicant_last_nm=insertobj->>'provider_applicant_last_nm', provider_applicant_suffix_cd=insertobj->>'provider_applicant_suffix_cd',
medical_license_no_tx=insertobj->>'medical_license_no_tx', medical_speciality_tx=insertobj->>'medical_speciality_tx', school_district_tx=insertobj->>'school_district_tx',vacancy_no=0, pay_to_affiliate_cd=insertobj->>'pay_to_affiliate_cd', dob_dt=(insertobj->>'dob_dt')::date, adr_work_phone_tx=insertobj->>'adr_work_phone_tx',
adr_work_xtn_tx=insertobj->>'adr_work_xtn_tx', adr_home_phone_tx=insertobj->>'adr_home_phone_tx', adr_pager_tx=insertobj->>'adr_pager_tx', adr_email_tx=insertobj->>'adr_email_tx', adr_fax_tx=insertobj->>'adr_fax_tx', adr_cell_phone_tx=insertobj->>'adr_cell_phone_tx', adr_url_tx=insertobj->>'adr_url_tx',
update_ts=now(), update_user_id=v_securityuserid,delete_sw='N'::bpchar,provider_applicant_type_cd='',info_date_changed=(insertobj->>'info_date_changed')::date, reason_changed=insertobj->>'reason_changed',dba_name=insertobj->>'dba_name'
WHERE provider_applicant_profile_id=v_profileid;


for i IN SELECT * FROM json_array_elements(v_addressarr)
loop


UPDATE tb_provider_applicant_addresses
SET adr_type_cd=i->>'adr_type_cd', adr_format_cd=i->>'adr_format_cd', adr_street_no=(i->>'adr_street_no')::int, adr_box_no=(i->>'adr_box_no')::int, adr_pre_dir_cd=i->>'adr_pre_dir_cd', 
adr_street_nm=i->>'adr_street_nm', adr_street_suffix_cd=i->>'adr_street_suffix_cd',adr_post_dir_cd=i->>'adr_post_dir_cd', adr_unit_type_cd=i->>'adr_unit_type_cd', adr_unit_no_tx=i->>'adr_unit_no_tx', 
adr_city_nm=i->>'adr_city_nm', adr_county_cd=i->>'adr_county_cd', adr_state_cd=i->>'adr_state_cd', adr_zip5_no=(i->>'adr_zip5_no')::numeric, adr_zip4_no=(i->>'adr_zip4_no')::numeric,
adr_direction_tx=i->>'adr_direction_tx', adr_foreign_tx=i->>'adr_foreign_tx', adr_foreign_state_tx=i->>'adr_foreign_state_tx', adr_country_tx=i->>'adr_country_tx', adr_postal_code_tx=i->>'adr_postal_code_tx', adr_default_sw=i->>'adr_default_sw', adr_start_dt=(i->>'adr_start_dt')::date,
adr_end_dt=(i->>'adr_end_dt')::date, update_ts=now(), update_user_id=v_securityuserid, delete_sw='N'::bpchar, adr_street_tx=i->>'adr_street_tx' , adr_county_cd_tx=i->>'adr_county_cd_tx' WHERE address_id=(i->>'address_id')::uuid;

END LOOP;

for i IN SELECT * FROM json_array_elements(v_emails)
loop

UPDATE tb_provider_applicant_email
SET email=i->>'email', updatedby=v_securityuserid, updatedon=now()
WHERE email_unique_id=(i->>'email_unique_id')::uuid;

end loop;

for i IN SELECT * FROM json_array_elements(v_phones)
loop

UPDATE tb_provider_applicant_phone
SET phone=i->>'phone', phonetype=i->>'phonetype', updatedby=v_securityuserid, updatedon=now()
WHERE phone_id=(i->>'phone_id')::uuid;

end loop;
return 'success';
else
return 'failure';
end if;
end;
$function$

