CREATE OR REPLACE FUNCTION as_pdfappointmentletter(i_evalutionid uuid, i_secid character varying)
 RETURNS TABLE(complaintid character varying, complaintdate timestamp without time zone, youthname text, cjamspid bigint, policename text, streetno character varying, street1 character varying, street2 character varying, agency character varying, appointmentaddress text, appointmentdate timestamp without time zone, guardian_name character varying, offensedate text, allegationname character varying[], officeworkername character varying, youthnamewithsuffix character varying)
 LANGUAGE plpgsql
AS $function$
begin
 return query 

select inve.complaintid,inve.complaintreceiveddate,p.firstname ||' '|| p.lastname as youthname,p.cjamspid as youthid,
es.firstname ||' '|| es.lastname as policename , es.streetno ,es.street1,es.street2,ea.description as agency,
upa.address ||', '|| upa.city ||', '|| upa.state ||', '|| upa.country ||' '|| upa.zipcode  as appointmentaddress,sap.appointmentdate,
CAST(COALESCE(
      (select person.firstname||' '||person.lastname from person  
            where person.personid IN (select a.actorid 
            from actor a join intakeservicerequestactor insa
             on a.actorid=insa.actorid and insa.activeflag=1
              join actorrelationship ar on ar.intakeservicerequestactorid=insa.intakeservicerequestactorid and ar.activeflag=1
             where  ar.relationshiptypekey='mother' and a.personid=p.personid)),
        (select person.firstname||' '||person.lastname from person  
            where person.personid IN (select a.actorid 
            from actor a join intakeservicerequestactor insa
            on a.actorid=insa.actorid and insa.activeflag=1
            join actorrelationship ar on ar.intakeservicerequestactorid=insa.intakeservicerequestactorid and ar.activeflag=1
            where  ar.relationshiptypekey='father' and a.personid=p.personid)),
        (select person.firstname||' '||person.lastname from person  
           where person.personid IN (select a.actorid 
            from actor a join intakeservicerequestactor insa
            on a.actorid=insa.actorid and insa.activeflag=1
            join actorrelationship ar on ar.intakeservicerequestactorid=insa.intakeservicerequestactorid and ar.activeflag=1
            where  ar.relationshiptypekey not in ('mother','father') and a.personid=p.personid))) as character varying) 
    as guardian_name,
case 
 when inve.unknownrange=0 then to_char(inve.offensedate,'MM/DD/YYYY') 
  when inve.unknownrange=1 then to_char(inve.offensedate,'MM/DD/YYYY')
   when inve.unknownrange=2 then to_char(inve.begindate,'MM/DD/YYYY')|| ' - ' || to_char(inve.enddate,'MM/DD/YYYY')
end as offensedate,
(select array_agg(AG.name)  from  allegation AG
      join intakeservicerequestevaluationconfig ITSEC  on ITSEC.allegationid=AG.allegationid and AG.activeflag=1
      where  ITSEC.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid and ITSEC.activeflag=1 )as allegationname,
      (select distinct cast(concat(lastname,',',' ',firstname) as character varying) from userprofile up where securityusersid = i_secid) as officeworkername,
            cast(concat(p.lastname,case when (p.suffix is null or p.suffix ='') then '' else concat(' ',p.suffix) end,', ',p.firstname) as 
character varying) as youthnamewithsuffix 
      from intakeservicerequestevaluation inve
left join intakeservicerequest INTSR on INTSR.intakenumber=inve.intakenumber and INTSR.activeflag=1
left join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1
left join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype='Youth'
join person p on ACC.personid=p.personid and p.activeflag=1
left join servicerequestappointment sap on sap.intakeserviceid=INTSR.intakeserviceid and sap.activeflag=1
left join userprofileaddress upa on upa.securityusersid=sap.appointmentworkerid :: character varying and upa.activeflag=1
and upa.userprofileaddresstypekey='P'
left join evaluationsource es on es.evaluationsourceid=inve.evaluationsourceid and es.activeflag=1
left join evaluationsourceagency ea on ea.evaluationsourceagencyid=inve.evaluationsourceagencyid and ea.activeflag=1
where  inve.intakeservicerequestevaluationid= i_evalutionid limit 1;

end

$function$

