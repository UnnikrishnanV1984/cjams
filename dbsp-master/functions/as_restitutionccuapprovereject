CREATE OR REPLACE FUNCTION as_restitutionccuapprovereject(v_restitution json, securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
 
 v_ccuno int;
 v_eventcode character varying;
 v_restitutionno integer;
 i_restitutionccuconfigcount int;
 v_securityuserid character varying;
 v_restitutionccuconfigid uuid;
 v_date timestamp without time zone;
 l_status character varying;
 v_ccustatus character varying;
 
BEGIN

 v_securityuserid := securityuserid;
 
 v_restitutionno:= v_restitution ->>'restitutionno';
 v_ccustatus:= v_restitution ->>'ccustatus';
 v_eventcode:= v_restitution ->>'appevent';
 v_date:= now() at time zone 'utc';

 RAISE NOTICE ' v_restitutionno:  %',v_restitutionno;  

 IF lower(v_ccustatus) = 'approved' THEN
 
 Update restitutionccuconfig set status = 'Closed' where restitutionno = v_restitutionno and activeflag = 1;
 
 --Update intakeserreqrestitution set isccusent = false where restitutionno = v_restitutionno and approvestatus ='RSTAPR' and activeflag = 1;
 
 select routingintake into l_status from routingintake (v_restitutionno::character varying,v_securityuserid,v_eventcode,64,null);
 
    ELSIF lower(v_ccustatus) = 'rejected' THEN
 
 Update restitutionccuconfig set status = 'Closed' where restitutionno = v_restitutionno and activeflag = 1;
 
 select routingintake into l_status from routingintake (v_restitutionno::character varying,v_securityuserid,v_eventcode,65,null);
 
 END IF;
 
 

RETURN
   'Success';
END;


$function$

