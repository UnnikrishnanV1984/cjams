CREATE OR REPLACE FUNCTION revertapprovedintake(v_intakenumber character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

 DECLARE
 v_intakeserviceid uuid;
 v_intakeservreqserviceid uuid;
 v_investigationid uuid;
 v_investigationallegationid uuid;
 v_progressnoteid uuid;
 v_servreqaptmtid uuid;
 l_status text;  
 v_collateral RECORD;

 BEGIN
 
 l_status := 'FAILURE';
 
 SELECT intakeserviceid INTO v_intakeserviceid FROM intakeservicerequest WHERE intakenumber = v_intakenumber and activeflag = 1;
 
 IF v_intakeserviceid IS NOT NULL THEN 
  UPDATE assessment 
  SET objectid = '00000000-0000-0000-0000-000000000000', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE  intakenumber = v_intakenumber and objectid = v_intakeserviceid and activeflag = 1;

  UPDATE documentproperties 
  SET servicerequestid = '00000000-0000-0000-0000-000000000000', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE  intakenumber = v_intakenumber and servicerequestid = v_intakeserviceid and activeflag = 1;

  UPDATE actor
  SET intakeserviceid = '00000000-0000-0000-0000-000000000000', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestactor
  SET intakeserviceid = '00000000-0000-0000-0000-000000000000', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE personrole
  SET intakeserviceid = '00000000-0000-0000-0000-000000000000', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE personrole
  SET intakeserviceid = '00000000-0000-0000-0000-000000000000', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeServiceRequestActor
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakedastatus
  SET status = 1, sstastatustypekey = null, isclw = false, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and activeflag = 1;

  UPDATE intakedastaging
  SET status = 'pending', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now(), ispreintake = false
  WHERE intakenumber = v_intakenumber and activeflag = 1;

  UPDATE intakereqforservconfig
  SET reqforservstatus = null, closingdate = null, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and activeflag = 1;

  UPDATE routing
  SET routingstatustypeid = 1, activeflag= 1, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE objectid = v_intakenumber;

  UPDATE personsupport
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequest
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestservice
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1
  RETURNING intakeservreqserviceid into v_intakeservreqserviceid;

  UPDATE intakeservicerequestsubservice
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeservreqserviceid = v_intakeservreqserviceid and activeflag = 1;

  UPDATE investigation
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1
  RETURNING investigationid INTO v_investigationid;

  UPDATE intakeservicerequestagency
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE usernotification
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE objectid = v_intakeserviceid :: character varying and activeflag = 1;

  UPDATE intakeservicerequestsdm
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestcrossreference
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE withintakeservicerequestid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestillegalactivity
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeservicerequestid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestdispositioncode
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestclearingdata
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestdispositioncode
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestuseraccess
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE investigationmaltreatment
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE investigationid = v_investigationid and activeflag = 1;

  UPDATE investigationallegation
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE investigationid = v_investigationid and activeflag = 1
  RETURNING investigationallegationid into v_investigationallegationid;

  UPDATE investigationallegationindicator
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE investigationallegationid = v_investigationallegationid and activeflag = 1;

  IF (SELECT count(*) from folderassignment where objectid = v_intakenumber and activeflag = 1) = 0 THEN
   INSERT INTO folderassignment(folderassignmentid, objectid, foldertypekey, status, opendate, activeflag, effectivedate)
   VALUES(gen_random_uuid(), v_intakenumber, 'Intake', 'Active', now(), 1, now());
  ELSE 
   UPDATE folderassignment
   SET foldertypekey = 'Intake', updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
   WHERE folderassignmentid IN ( 
    SELECT folderassignmentid FROM folderassignment WHERE objectid = v_intakenumber and status = 'Active' and activeflag = 1 ORDER BY insertedon desc limit 1);
  END IF; 

  UPDATE progressnote
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE entitytypeid = v_intakeserviceid :: character varying and activeflag = 1
  RETURNING progressnoteid INTO v_progressnoteid;

  UPDATE progressnotedetail
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE progressnoteid = v_progressnoteid and activeflag = 1;

  UPDATE contactparticipant
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE progressnoteid = v_progressnoteid and activeflag = 1;

  UPDATE servicerequestappointment
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1
  RETURNING servreqaptmtid INTO v_servreqaptmtid;

  UPDATE servicerequestappointmentactor
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE servreqaptmtid = v_servreqaptmtid and activeflag = 1;

  UPDATE intakeserreqrestitution
  SET activeflag = 0, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakeserviceid = v_intakeserviceid and activeflag = 1;

  UPDATE intakeservicerequestevaluation
  SET complaintstatustypekey = null, updatedby = '00000000-0000-0000-0000-000000000000', updatedon = now()
  WHERE intakenumber = v_intakenumber and activeflag = 1;

  FOR  v_collateral  IN  (SELECT * FROM collateral WHERE caseid = v_intakeserviceid and activeflag = 1)
  LOOP
   UPDATE collateral
   SET activeflag = 0
   WHERE collateralid = v_collateral ->> 'collateralid' and activeflag = 1;
   
   UPDATE collateraladdress
   SET activeflag = 0
   WHERE collateralid = v_collateral ->> 'collateralid' and activeflag = 1;
   
   UPDATE collateralroleconfig
   SET activeflag = 0
   WHERE collateralid = v_collateral ->> 'collateralid' and activeflag = 1;  
  END LOOP;
  l_status := 'SUCCESS';
 ELSE
  l_status := 'FAILURE';
 END IF;
 
 RETURN l_status;
 
 END;                                                                                                                                                                                                                                                                    

$function$

