CREATE OR REPLACE FUNCTION prov_getabpprograms(reqjson json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
jsondata  json;
v_abpid character varying;

BEGIN

v_abpid = reqjson->>'object_id';


SELECT  Json_agg(a)  INTO  jsondata  FROM  (

select
count(1) over() as totalcount,
        (select json_agg(s) from  (
                    select tpps.site_id, p.provider_nm ,tpl.license_no, tpl.license_level, tpl.license_type
                    from prov.tb_prov_program_sites tpps 
                    join prov.tb_provider p on p.provider_id = tpps.site_id and p.delete_sw = 'N'
                    join prov.tb_provider_licensing tpl on tpl.site_id = tpps.site_id and tpl.delete_sw = 'N' and tpl.active_sw ='Y'
                    where tpps.program_id= t.program_id and tpps.delete_sw='N') s ) as site_list,
    t.*
    from
        (select program_status_cd,contract_license_type_status ,tp.* , tabp.object_id, tabp.ann_budget_mapping_id
        from tb_annualbudgetmappings tabp
        join prov.tb_contract_program tp  on tabp.site_id = tp.program_id and tp.delete_sw ='N' and trim(tp.program_status_cd) = '3625' 
        join prov.tb_provider_contracts tpc on tpc.contract_id = tp.contract_id and tpc.delete_sw ='N'
        where tabp.delete_sw = 'N'
        and tabp.object_id = v_abpid
    ) t 
)  a;

RETURN  jsondata;
END;

$function$

