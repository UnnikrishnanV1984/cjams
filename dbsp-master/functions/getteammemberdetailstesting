CREATE OR REPLACE FUNCTION getteammemberdetailstesting(_position_code character varying, _role_type character varying, _first_name character varying, _last_name character varying, _servicerequesttypeconfigid character varying, _type character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE result json;
DECLARE position_code character varying;
DECLARE role_type character varying;
DECLARE first_name character varying;
DECLARE last_name character varying;
DECLARE service_request_typeconfigid uuid;

BEGIN
     
      IF _first_name = 'undefined' THEN 
           first_name = null; 
      ELSE 
           first_name = _first_name; 
      END IF;
      IF _last_name = 'undefined' THEN 
          last_name = null; 
      ELSE 
          last_name = _last_name; 
      END IF;
      IF _position_code = 'undefined' THEN 
         position_code = null; 
      ELSE 
         position_code = _position_code; 
      END IF;

        IF _role_type = 'undefined' THEN 
         role_type = null; 
      ELSE 
         role_type = _role_type; 
      END IF;

      RAISE NOTICE '----aaaa--------->>>>>>>%',_servicerequesttypeconfigid;

      IF _servicerequesttypeconfigid != 'undefined' THEN
      RAISE NOTICE '----bbbbb---------';
        service_request_typeconfigid = _servicerequesttypeconfigid; 
 
      END IF;
       

         --RAISE NOTICE '----aaaa--------->>>>>>>%',service_request_typeconfigid;
         IF _type='search' THEN

         select array_to_json(array_agg(e)) from
        (SELECT array_to_json(array_agg(row_to_json(d))) as "data" from (
        SELECT A.* FROM (SELECT A.positioncode,A.roletypekey,C.displayname FROM teammember A, teammemberassignment B, userprofile C 
        WHERE A.teammemberid = B.teammemberid AND B.SecurityUsersId = C.SecurityUsersId AND 
         A.positioncode not in (select loadnumber from accesslist where servicerequesttypeconfigid =service_request_typeconfigid::uuid and activeflag=1)
        AND CASE WHEN length(first_name)>0 THEN lower(C.displayname) LIKE '%'|| first_name || '%' ELSE TRUE END
        AND CASE WHEN length(last_name)>0 THEN  lower(C.displayname)  LIKE '%'||last_name || '%' ELSE TRUE END
        AND CASE WHEN length(position_code)>0 THEN A.positioncode LIKE position_code || '%' ELSE TRUE END
        AND CASE WHEN length(role_type)>0 THEN lower(A.roletypekey) LIKE role_type || '%' ELSE TRUE END
        ) A
       -- LEFT OUTER JOIN usernotificationgroupdetail D ON A.teammemberid = D.teammemberid 
        GROUP BY A.positioncode,A.roletypekey,A.displayname
        ORDER BY A.displayname ASC )d)e INTO result;

        RAISE NOTICE '----1111111--------->>>>>>>%',result;

RETURN COALESCE(result,'[]');

 RAISE NOTICE '----idddddd--------->>>>>>>%',servicerequesttypeconfigid;

 ELSE IF _type='list' THEN
     RAISE NOTICE '%','sssssssss';
 select array_to_json(array_agg(e)) from
        (SELECT array_to_json(array_agg(row_to_json(d))) as "data" from (
        SELECT A.* FROM (SELECT A.positioncode,A.roletypekey,C.displayname,C.activeflag 
                         FROM teammember A inner join  teammemberassignment B ON B.teammemberid = A.teammemberid 
                         inner join userprofile C ON C.SecurityUsersId =B.SecurityUsersId 
                         inner join accesslist D  on D.loadnumber=A.loadnumber where C.activeflag = 1 and  A.positioncode not in (select loadnumber from accesslist where servicerequesttypeconfigid =service_request_typeconfigid::uuid and activeflag=1)
        
        ) A
       -- LEFT OUTER JOIN usernotificationgroupdetail D ON A.teammemberid = D.teammemberid 
        GROUP BY A.positioncode,A.roletypekey,A.displayname,A.activeflag
        ORDER BY A.displayname ASC )d)e INTO result;
        
RAISE NOTICE '----333333--------->>>>>>>%',result;
 
RETURN COALESCE(result,'[]');

ELSE  

 select array_to_json(array_agg(e)) from
 (SELECT array_to_json(array_agg(row_to_json(d))) as "data" from (
 select DISTINCT a.loadnumber as positioncode,a.activeflag,b.roletypekey,d.displayname FROM accesslist as a,teammember as b,teammemberassignment c, userprofile d  where 
 a.loadnumber=b.loadnumber 
 and a.servicerequesttypeconfigid=service_request_typeconfigid::uuid
 and b.teammemberid = c.teammemberid AND 
 a.activeflag = 1 AND 
 c.SecurityUsersId = d.SecurityUsersId ORDER BY a.activeflag desc)d)e INTO result;

RAISE NOTICE '----22222--------->>>>>>>%',result;

RETURN COALESCE(result,'[]');



END IF;
END IF;
END;
 
$function$

