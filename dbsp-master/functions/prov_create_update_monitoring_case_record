CREATE OR REPLACE FUNCTION prov_create_update_monitoring_case_record(v_case_name character varying, v_case_status character varying, v_case_comments text, v_record_id uuid, v_user_id character varying, v_monitoring_record_site_id uuid, v_monitoring_case_record_id uuid)
 RETURNS TABLE(monitoring_case_record_id_val uuid, message text)
 LANGUAGE plpgsql
AS $function$
 DECLARE 
 v_status TEXT;

 BEGIN 
  v_status := 'failure';
  IF v_monitoring_case_record_id IS NULL THEN 
   INSERT INTO prov_monitoring_case_record (case_name, case_status, case_comments, monitoring_record_id, create_ts, create_user_id)
   VALUES(v_case_name, v_case_status, v_case_comments, v_record_id, now(), v_user_id)
   RETURNING monitoring_case_record_id INTO v_monitoring_case_record_id;
  
   IF v_monitoring_record_site_id IS NOT NULL THEN 
    UPDATE prov_monitoring_record_site
    SET objectid=v_monitoring_case_record_id, update_ts=now(), update_user_id=v_user_id
    WHERE monitoring_record_site_id = v_monitoring_record_site_id;
   END IF; 
   v_status := 'success'; 
  ELSE 
   UPDATE prov_monitoring_case_record 
   SET case_name=v_case_name, case_status=v_case_status, case_comments=v_case_comments, monitoring_record_id=v_record_id, update_ts=now(), update_user_id=v_user_id 
   WHERE monitoring_case_record_id = v_monitoring_case_record_id; 
  
   v_status := 'success'; 
  END IF;
 
  RETURN QUERY 
  SELECT v_monitoring_case_record_id , v_status;
 END;
$function$

