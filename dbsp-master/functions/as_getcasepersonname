 FOR rolerec IN select * from intakeservicerequestactor isra join person per on per.personid = isra.personid join actor act on act.actorid = isra.actorid and act.activeflag = 1  where isra.intakenumber = v_objectid and isra.activeflag = 1 
 loop
  if (rolerec.intakeservicerequestpersontypekey = 'LG')
  then
  
