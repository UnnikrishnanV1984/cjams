CREATE OR REPLACE FUNCTION as_serviceplanactivitylist(searchobj json)
 RETURNS TABLE(totalcount bigint, serviceplanactivityid uuid, objecttypekey character varying, groupinglog integer, objectid character varying, activity character varying, clientfirstname character varying, clientmiddlename character varying, clientlastname character varying, clientid character varying, casemanagerphone character varying, objective character varying, clientgoal character varying, clientmeetgoal character varying, ihastaskperform character varying, contractordetails character varying, contractoragencydetails character varying, additionalinstruction character varying, ihassbackupplan character varying, clientfee character varying, casemanagername character varying, reconsiderationdate timestamp without time zone, ihasserviceplandate timestamp without time zone, effectivedate timestamp without time zone, isnew character varying, approvalstatus character varying, approvedby character varying, servicetypekey character varying, servicetypedescription character varying, servicesubtypekey character varying, servicesubtypedescription character varying, personinvolved character varying, responsibleperson character varying, reevaluationdate timestamp without time zone, completiondate timestamp without time zone, serviceplangoalid uuid, goal character varying, serviceplanactivitystatustypekey character varying, activitysubtypekey character varying, change_reason text, suspendstartdate timestamp without time zone, suspendenddate timestamp without time zone, paymenttype character varying, fundingtype character varying, activitysubtypedescription character varying, goaltypekey character varying, goaltypedescription character varying, initialcondition character varying, personsinvolvedid uuid, responsiblepersonid character varying, insertedon timestamp without time zone, plannedstartdate timestamp without time zone, plannedenddate timestamp without time zone, responsiblepersontype character varying, otherresponsibleperson character varying, progressnote character varying, supervisorname character varying, caseworkername character varying, submissiondate timestamp without time zone, approvaldate timestamp without time zone, services json, serviceplanactivitystatustype character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
    v_intakenumber    VARCHAR(50);
    v_intakeservreqid  uuid;    
    v_objecttypekey    VARCHAR(50);  
    v_objectid    VARCHAR(50);                                                     
   
    v_liPageNumber  INT;                              
    v_liPageSize   INT;
                             
    v_lvSortCol   VARCHAR;                              
    v_lvSortDir   VARCHAR;    
 v_pageoffset int;
    v_pagenumber int;  
begin
   
v_intakenumber := searchobj ->> 'intakenumber';
v_intakeservreqid := searchobj ->> 'intakeservicerequestid'; 
v_objecttypekey := searchobj ->> 'objecttypekey'; 
v_objectid := searchobj ->> 'objectid'; 
v_liPageNumber := searchobj ->> 'pagenumber';
v_liPageSize := searchobj ->> 'pagesize'; 
v_lvSortCol := searchobj ->> 'sortcolumn'; 
v_lvSortDir := searchobj ->> 'sortorder'; 
IF COALESCE(v_liPageSize, 0) < 1 THEN                     
 v_liPageSize := 10;
END IF;

IF COALESCE(v_liPageNumber, 0) < 1 
THEN
 v_liPageNumber := 1; 
end if;

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

return query

SELECT count(1) OVER() totalcount,
a.serviceplanactivityid,  
a.objecttypekey,a.groupinglog, a.objectid,a.activity, a.clientfirstname, a.clientmiddlename, a.clientlastname, a.clientid, 
a.casemanagerphone, a.objective, a.clientgoal, a.clientmeetgoal, a.ihastaskperform, a.contractordetails, a.contractoragencydetails, 
a.additionalinstruction, a.ihassbackupplan, a.clientfee, a.casemanagername, a.reconsiderationdate,a.ihasserviceplandate, a.effectivedate, a.isnew,
a.approvalstatus,a.approvedby,a.servicetypekey, 
coalesce(d.servicetypedescription,tpt.description_tx), a.servicesubtypekey, e.servicesubtypedescription,
a.personinvolved, a.responsibleperson, a.reevaluationdate, a.completiondate, 
a.serviceplangoalid, b.goal, a.serviceplanactivitystatustypekey,a.activitysubtypekey,a.change_reason,a.suspendstartdate,a.suspendenddate,a.paymenttype,a.fundingtype,
rv.description as activitysubtypedescription,b.goaltypekey,rv1.description as goaltypedescription,
a.initialcondition,a.personsinvolvedid,a.responsiblepersonid,a.insertedon,a.plannedstartdate,a.plannedenddate,a.responsiblepersontype,a.otherresponsibleperson,a.progressnote,
(select u.displayname from routing r inner join userprofile u on u.securityusersid  = r.tosecurityusersid
where r.objectid :: uuid = a.serviceplanactivityid and r.routingstatustypeid=100 and r.activeflag = 1 order by r.insertedon desc limit 1) as supervisorname,
 (select u.displayname from routing r inner join userprofile u on u.securityusersid = r.fromsecurityusersid
 where r.objectid :: uuid = a.serviceplanactivityid and r.routingstatustypeid in (100) and r.activeflag = 1 order by r.insertedon desc limit 1) as caseworkername,
  (select r.insertedon from routing r 
  where r.objectid :: uuid = a.serviceplanactivityid and r.routingstatustypeid in (100) and r.activeflag = 1 order by r.insertedon desc limit 1) as submissiondate,
  (select r.updatedon from routing r 
  where r.objectid :: uuid = a.serviceplanactivityid and r.routingstatustypeid=100 and r.activeflag = 1 order by r.insertedon desc limit 1) as approvaldate,
(SELECT json_agg(item)
FROM (select distinct s.serviceplanlogid, s.objecttypekey, s.objectid, s.serviceplanactivityid, s.providerid, s.altproviderid, s.contractid, s.serviceid, 
  s.providercontracttypekey, s.providercontractrateid, s.startdate, s.enddate, s.isrepeats, s.noofoccurence, 
  s.reason, s.serviceplanlogstatustypekey, 
  p.providerid, p.providercategorytypekey, p.providername, p.providercode,
  p.prefix, p.firstname, p.middlename, p.lastname,
  paddr.provideraddresstypekey, paddr.buildingno, paddr.addressline1, paddr.addressline2,
  paddr.city, paddr.countyid, coun.countyname, paddr.state, coun.zipcode,
  pcont.contracttypekey as providercontracttypekey, pconttype.providercontracttypename,
  s.rate,s.providertypekey,s.familyworkername,(CASE WHEN (sp.provider_nm is null OR sp.provider_nm='') THEN CONCAT(sp.provider_first_nm,' ',sp.provider_middle_nm,' ',sp.provider_last_nm) ELSE sp.provider_nm END) as vendorname,sp.provider_id,up.fullname,s.careworkername,s.countyid,
  sr.servicename, stype.servicetypedescription,s.rate,s.noofhours,s.noofweeks,s.categorysubtypekey,s.servicecategorytypekey,s.providercontracttypekey,
  ''::character varying as servicesubtypedescription, s.activitytask
  -- ssubtype.servicesubtypedescription
  -- json_agg(ssubtype.servicesubtypedescription)::json
  FROM serviceplanlog s
  left join provider p on s.providerid = p.providerid and p.activeflag = 1
  --left join serviceplanvendor sp on sp.serviceplanvendorid=s.serviceplanvendorid and sp.activeflag=1
  left join prov.tb_provider sp on sp.provider_id=s.altproviderid and sp.delete_sw='N'
  left join userprofile up on up.securityusersid=s.securityusersid and up.activeflag=1
  left join provideraddress paddr on p.providerid = paddr.providerid and paddr.activeflag = 1
  left join providercontactinfo pcinfo on p.providerid = pcinfo.providerid and pcinfo.activeflag = 1
  left join providercontactinfotype pcinfotype on pcinfo.providercontactinfotypekey = pcinfotype.providercontactinfotypekey and pcinfotype.activeflag = 1
  left join providercontract pcont on p.providerid = pcont.providerid and pcont.activeflag = 1
  left join providercontracttype pconttype on pcont.programstatuskey = pconttype.providercontracttypekey and pconttype.activeflag = 1
  left join providercontractrate pcontrate on pcontrate.providercontractid = pcont.providercontractid and pcontrate.activeflag = 1
  left join providerservice pserv on p.providerid = pserv.providerid and pserv.activeflag = 1
  left join service sr on sr.serviceid = pserv.serviceid and sr.activeflag = 1
  left join servicetype stype on sr.servicetypekey = stype.servicetypekey and stype.activeflag = 1
  --left join servicesubtype ssubtype on sr.serviceid = ssubtype.serviceid and ssubtype.activeflag = 1
  left join county coun on paddr.countyid = coun.countyid and coun.activeflag = 1
  where --p.activeflag = 1 and 
  s.serviceplanactivityid = a.serviceplanactivityid) item
) as services, 
(SELECT description FROM serviceplanactivitystatustype spast WHERE spast.serviceplanactivitystatustypekey = a.serviceplanactivitystatustypekey AND spast.activeflag = 1 ORDER BY spast.insertedon DESC LIMIT 1)
FROM serviceplanactivity a 
left join serviceplangoal b on a.serviceplangoalid = b.serviceplangoalid and b.activeflag = 1
left join serviceplanlog c on a.serviceplanactivityid = c.serviceplanactivityid and c.activeflag = 1
left join servicetype d on d.servicetypekey = a.servicetypekey and d.activeflag = 1
left join tb_picklist_values tpt on tpt.picklist_type_id = 10045 and tpt.value_tx = a.servicetypekey
left join servicesubtype e on e.servicesubtypekey = a.servicesubtypekey and e.activeflag = 1
left join referencevalues rv on rv.ref_key=a.activitysubtypekey and rv.activeflag=1
left join referencevalues rv1 on rv1.ref_key=b.goaltypekey and rv1.activeflag=1
where a.activeflag = 1 
--and (a.intakenumber = v_intakenumber or a.intakeservicerequestid = v_intakeservreqid) 
and a.objectid = v_objectid and a.serviceunavailable is null
group by a.serviceplanactivityid, 
a.objecttypekey, a.objectid,a.activity, a.servicetypekey, 
a.servicesubtypekey, a.personinvolved, a.responsibleperson, a.reevaluationdate, a.completiondate, 
a.serviceplangoalid, b.goal, a.serviceplanactivitystatustypekey, d.servicetypedescription, e.servicesubtypedescription,
a.activitysubtypekey,rv.description,b.goaltypekey,rv1.description, tpt.description_tx
order by (
  CASE v_lvSortDir
     WHEN 'asc'
     THEN
              CASE v_lvSortCol
           WHEN 'activity' THEN a.activity
        WHEN 'personinvolved' THEN a.personinvolved
        WHEN 'completiondate' THEN CAST(a.completiondate as character varying )
           WHEN 'approvalstatus' THEN a.approvalstatus 
 
          ELSE
            a.insertedon :: character varying
          END
  END
) ASC NULLS LAST,
(
CASE v_lvSortDir
     WHEN 'desc'
     THEN
              CASE v_lvSortCol
              
              WHEN 'activity' THEN a.activity
           WHEN 'personinvolved' THEN a.personinvolved
           WHEN 'completiondate' THEN CAST(a.completiondate as character varying )
           WHEN 'approvalstatus' THEN a.approvalstatus  
          ELSE
            a.insertedon :: character varying
          END
  END
) DESC NULLS LAST 
LIMIT v_liPageSize OFFSET v_pageoffset; 

end;

$function$

