CREATE OR REPLACE FUNCTION as_getallpersonrelationbyprovidedpersonid(v_objectid character varying, v_personid character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_relationships json;
 v_personid_uuid uuid;
 v_intakeserviceid uuid;

BEGIN 

 SELECT as_uuid_or_null INTO v_personid_uuid FROM as_uuid_or_null(v_personid);

 IF v_objectid NOT ILIKE 'I%' THEN 
  SELECT as_uuid_or_null INTO v_intakeserviceid FROM as_uuid_or_null(v_objectid);
 END IF;  

 SELECT json_agg(a) INTO v_relationships FROM (
  SELECT p.personid, ar.actorrelationshipid, ar.caregiverflag, ar.intakeservicerequestactorid, ar.relationshiptypekey, 
  COALESCE(rt.description,'Unknown') relation, ar.intakeserviceid, p.firstname, p.lastname, p.userphoto, p.dob, p.gendertypekey, 
  ar.person1id person2id, ar.person2id person1id, ar.updatedon
        FROM actor a
        INNER JOIN person p ON p.personid = a.personid 
        INNER JOIN actorrelationship ar ON ar.person2id = p.personid
        LEFT JOIN relationshiptype rt ON rt.relationshiptypekey= ar.relationshiptypekey AND rt.activeflag=1
        WHERE a.activeflag=1 AND p.activeflag=1 AND ar.activeflag=1
   AND ((v_intakeserviceid IS NOT NULL AND a.intakeserviceid = v_intakeserviceid) OR a.intakenumber = v_objectid)
            AND ar.person2id = v_personid_uuid AND ar.person2id IS NOT NULL 
        ORDER BY ar.updatedon DESC
 ) a;
    
 RETURN v_relationships;
END;

$function$

