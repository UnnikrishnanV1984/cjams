CREATE OR REPLACE FUNCTION as_f_prim_worker(ai_entity_id integer, as_entity_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
 
BEGIN  
 RETURN
    CASE
      when as_entity_type_cd = '2955' then
        (select securityusersid from (
SELECT row_number() over() as num, userprofile.securityusersid
     FROM servicecase ca,   
            caseclient,   
            TB_CLIENT,
     caseassignment,
       userprofile  

     WHERE ( caseclient.caseid = ca.servicecaseid ) and  
            ( TB_CLIENT.CLIENT_ID ::VARCHAR = caseclient.old_id )  and  --TB_CLIENT.CLIENT_ID IN INTEGER
     ( caseassignment.OBJECTTYPEKEY = '2952') and
     ( caseassignment.OBJECTID :: VARCHAR = caseclient.old_id) and --Caseassignment.OBJECTID IN UUID 
     ( caseassignment.RESPONSIBILITYTYPEKEY = 'P') and 
     ( caseassignment.ENDDATE IS NULL) and 
     ( userprofile.securityusersid = caseassignment.TOWORKERIDNO) and 
      --( TB_CLIENT.CLIENT_ID = AI_ENTITY_ID) and
     ( ca.activeflag = 0) and
     ( TB_CLIENT.DELETE_SW = 'N') and
     ( caseassignment.activeflag = 1) and
     ( userprofile.activeflag = 0))as er where num=1 )
        
 
    else
  (select securityusersid from (
SELECT  row_number() over() as num,userprofile.securityusersid
     FROM  caseassignment,
           userprofile
     WHERE ( caseassignment.OBJECTTYPEKEY = AS_ENTITY_TYPE_CD) and
            ( caseassignment.OBJECTID :: VARCHAR= AI_ENTITY_ID :: VARCHAR ) and   --Caseassignment.OBJECTID IN UUID 
            ( caseassignment.RESPONSIBILITYTYPEKEY = 'P') and
            ( caseassignment.ENDDATE IS NULL) and
            ( userprofile.securityusersid = caseassignment.toworkeridno)  and
            ( caseassignment.activeflag = 1) and
            ( userprofile.activeflag = 0) ) as ty where num=1)

    END;
END;

$function$

