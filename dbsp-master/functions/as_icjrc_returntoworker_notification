CREATE OR REPLACE FUNCTION as_icjrc_returntoworker_notification(v_intakeserviceid uuid, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

 v_servicerequestnumber character varying;
 v_tosecurityusersid character varying;
 v_username text;
 v_msg character varying;
 v_sendnotification character varying;
 
BEGIN

   SELECT ISR.servicerequestnumber,R.tosecurityusersid,(SELECT COALESCE(lastname,'')||', '|| COALESCE(firstname,'')
   FROM userprofile WHERE securityusersid = v_securityuserid limit 1) as username INTO v_servicerequestnumber, v_tosecurityusersid , v_username from intakeservicerequest as ISR
   JOIN routing as R on R.objectid = ISR.intakeserviceid::character varying and R.routingstatustypeid = 4 
   and R.toroleid = 'JSCW' WHERE ISR.intakeserviceid = v_intakeserviceid limit 1;

   v_msg := 'Case (' || v_servicerequestnumber || ') is Return to Worker by ' || v_username || ' (ICJ Regional Coordinator).';
  
   SELECT send_notification INTO v_sendnotification FROM as_send_notification(v_tosecurityusersid,v_securityuserid,v_tosecurityusersid,'System','High',v_msg,v_msg,v_intakeserviceid::varchar,false);
  

RETURN 'Success';
   
END;


$function$

