CREATE OR REPLACE FUNCTION prov_childspecificagreementlist(v_program_id integer)
 RETURNS TABLE(totalcount bigint, childspecificagreementid uuid, provider_id integer, site_id integer, agreementtype character varying, csafiscalyear_enddt character varying, contract_id integer, activeflag integer, insertedby character varying, insertedon timestamp without time zone, updatedby character varying, updatedon timestamp without time zone, csanarrative text, csaattachments json, csastatus character varying, program_id integer, childrenadded json)
 LANGUAGE plpgsql
AS $function$

DECLARE

BEGIN
RETURN  QUERY

 select count(1) over() as totalcount, csa.childspecificagreementid, csa.provider_id, csa.site_id, csa.agreementtype, csa.csafiscalyear_enddt,   
               csa.contract_id, csa.activeflag, csa.insertedby, csa.insertedon, csa.updatedby, csa.updatedon , csa.csanarrative, csa.csaattachments,
               csa.csastatus,csa.program_id,
      (select json_agg(e) AS childrenadded from (
    select distinct p.firstname,p.lastname,p.middlename,p.personid ,p.cjamspid,p.gendertypekey,csad.childspecificagreementid
       from childspecificagreementdetails csad 
       join person p on NULLIF (csad.personid,'')::uuid = p.personid  where csad.childspecificagreementid = csa.childspecificagreementid and csad.activeflag = 1) e)::JSON
               from childspecificagreement csa
     where 
     (v_program_id is null or csa.program_id = v_program_id)
     and csa.activeflag = 1;
 
END;

$function$

