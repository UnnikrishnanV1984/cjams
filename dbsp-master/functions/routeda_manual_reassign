CREATE OR REPLACE FUNCTION routeda_manual_reassign(intake_service_id uuid, old_team_member_id uuid, new_team_member_id uuid, updtusr character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 
caseworker_name character varying;
count_flag int;
BEGIN

SELECT up.fullname INTO caseworker_name FROM teammemberassignment tma JOIN userprofile up ON tma.securityusersid = up.securityusersid
WHERE tma.teammemberid = new_team_member_id;

select count(1) INTO count_flag from areateammemberservicerequest where intakeserviceid = intake_service_id and teammemberid = old_team_member_id;

IF count_flag > 0 THEN

 UPDATE areateammemberservicerequest 
  SET teammemberid = new_team_member_id
  , activeflag = 1
  --, routedby = updtusr
  , updatedby = updtusr, updatedon = now() WHERE 
  intakeserviceid = intake_service_id AND teammemberid = old_team_member_id;

  
-- ELSE
--  RAISE EXCEPTION 'Wrong team member';
END IF;

RETURN 'DA Reassigned to ' || caseworker_name;

END;
$function$

