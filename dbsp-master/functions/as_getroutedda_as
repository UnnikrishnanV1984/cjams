  WHERE ISR.servicerequestnumber LIKE servicereqno ||'%'
  AND coalesce(ISR.isrouted,FALSE) =isassigned
  AND ISR.activeflag =1 AND userid IN (ISR.insertedby,
  (SELECT insertedby FROM intakeservicerequestdispositioncode isrdc WHERE isrdc.intakeserviceid = isr.intakeserviceid AND activeflag = 1 ORDER BY isrdc.insertedon DESC LIMIT 1))
  --AND (SELECT count(*) = 0 FROM caseassignment CA WHERE CA.objectid = ISR.intakeserviceid AND CA.activeflag = 1) AND ISR.teamtypekey='AS'
  AND ISR.teamtypekey = 'AS'

