CREATE OR REPLACE FUNCTION getintakeusers(roletypekey character varying, skipno integer, pagesize integer)
 RETURNS TABLE(totalcount bigint, userid character varying, teamname character varying, username character varying, agencykey character varying, userrole text, loadnumber character varying, homelocationcode character varying, worklocationcode character varying)
 LANGUAGE plpgsql
AS $function$ declare v_roletypekey character varying = null;
begin
v_roletypekey := roletypekey;

return Query select
 count(1) over() totalcount,
 UP.securityusersid as userid,
 T.teamname,
 --UP.fullname as username,
 cast(UP.lastname||', '||UP.firstname as character varying) as username,
 TMRT.teamtypekey as agencykey ,
 replace(TMRT.description, ',' || TMRT.teamtypekey, '') userrole,
 TM.loadnumber ,
 upa.zipcode as homelocationcode,
 upa.zipcodeplus as worklocationcode
from
 Team T
join TeamMember TM on
 TM.teamid = T.teamid
join TeamMemberAssignment TMA on
 TMA.teammemberId = TM.teammemberid
left join TeamMemberRoleType TMRT on
 TMRT.roletypekey = TM.roletypekey
left join TeamType TTY on
 TTY.teamtypekey = TMRT.teamtypekey
join UserProfile UP on
 UP.securityusersid = TMA.securityusersid
left join UserProfileAddress UPA on
 UPA.securityusersid = UP.securityusersid
 and lower(UPA.userprofileaddresstypekey)= 'p'
where
 TM.roletypekey = v_roletypekey
 and T.activeflag = 1
 and TM.activeflag = 1
 and TMA.activeflag = 1
 and TMRT.activeflag = 1
 and UP.activeflag = 1
 and UPA.activeflag = 1
order by
 T.teamname,
 UP.fullname
limit pagesize offset skipno;
end;

$function$

