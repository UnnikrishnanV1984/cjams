CREATE OR REPLACE FUNCTION as_f_prim_assignment(ai_entity_id integer, as_entity_type_cd character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
begin

return
(SELECT securityusersid FROM (
   SELECT   ROW_NUMBER() OVER() AS NUM, userprofile.securityusersid
    FROM       caseassignment,
            userprofile
    WHERE     ( caseassignment.objecttypekey = as_entity_type_cd) and
            ( caseassignment.objectid ::varchar = ai_entity_id :: varchar) and  -- caseassignment.objectid in uuid column
            ( caseassignment.RESPONSIBILITYTYPEKEY = 'P') and
            ( caseassignment.ENDDATE IS NULL) and
            (userprofile.securityusersid = caseassignment.toworkeridno)  and
            ( caseassignment.activeflag = 1) and
            ( userprofile.activeflag = 1) ORDER BY caseASSIGNMENTID DESC) TAB WHERE NUM=1 );
   
end;

$function$

