CREATE OR REPLACE FUNCTION getadoptionsuspension(v_adoptioncaseid uuid, v_page integer, v_limit integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE

v_adoptionplanningid uuid;
v_adoptionagreement json;

BEGIN

SELECT  ac.adoptionplanningid  INTO v_adoptionplanningid
FROM  adoptioncase ac 
WHERE  ac.activeflag =1 AND ac.adoptioncaseid = v_adoptioncaseid; 

SELECT  getadoptionagreementlist INTO v_adoptionagreement
FROM  getadoptionagreementlist(v_adoptionplanningid,v_page, v_limit);


RETURN v_adoptionagreement;
END;
$function$

