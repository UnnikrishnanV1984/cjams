CREATE OR REPLACE FUNCTION as_getadoptioncase(userid character varying, casenumber character varying, page integer, pagelimit integer, v_status character varying)
 RETURNS TABLE(totalcount bigint, servicecaseid uuid, adoptioncaseid uuid, servicerequestnumber character varying, adoptioncasenumber character varying, adoptionplanningid uuid, statustypekey character varying, startdate timestamp without time zone, enddate timestamp without time zone, restrictstatus text)
 LANGUAGE plpgsql
AS $function$


DECLARE  
v_pageoffset int;
v_pagenumber int;


BEGIN

v_pagenumber := (page-1) * 10;

RETURN QUERY
SELECT * FROM (   
SELECT 
 count(1) over(), 
    ac.servicecaseid,
 ac.adoptioncaseid,
 ac.adoptioncasenumber,
 ac.adoptioncasenumber,
 ac.adoptionplanningid,
 --ac.statustypekey,
 case when ac.statustypekey = 'Closed' then 'Closed' else 'In Progress' end::varchar as statustypekey ,
 ac.startdate,
 ac.enddate,
 (SELECT * FROM getRestrictedCaseStatus( ac.servicecaseid::text,userid)) AS restrictStatus
FROM adoptioncase ac
--INNER JOIN servicecase sc ON ac.servicecaseid = sc.servicecaseid AND sc.activeflag =1
WHERE ac.activeflag=1 
--AND ac.statustypekey = 'Open' 
AND 
 
 (select r.fromsecurityusersid from routing r
     where r.objectid=ac.adoptioncaseid :: character varying and r.eventcode = 'ADPC' and r.fromroleid = 'CWCW') :: character varying
 = userid
AND (casenumber is null or casenumber='' or ac.adoptioncasenumber  like '%' ||   LOWER(casenumber)  ||  '%')
-- ac.adoptioncasenumber = casenumber 

and CASE WHEN v_status is NOT NULL then ( lower(ac.statustypekey)=v_status) ELSE TRUE end
ORDER BY ac.startdate DESC
)AS datav 
       WHERE datav.restrictStatus IN('INCL','INCLRES') ; 

END;


$function$

