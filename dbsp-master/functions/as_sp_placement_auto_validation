  \r
   as_auto_valid_success_sw := 'N';\r
  IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
    as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || RTRIM(LTRIM(vs_license_msg)) ;\r
  ELSE \r
    as_auto_valid_errors := RTRIM(LTRIM(vs_license_msg)) ; \r
  END IF; \r
  \r
 ELSEIF vs_license_check_failed = 'E' THEN\r
\r
   as_auto_valid_success_sw := 'N';\r
  IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
    as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || 'Error in Getting Active License for the Provider.';  \r
