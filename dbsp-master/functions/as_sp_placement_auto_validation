    ELSEIF vl_msg_id2 = 1362 THEN\r
      vs_license_msg := vs_license_msg || CHR(13) || 'The placement validation start date cannot be prior to the Program start date. Please contact SSA.';\r
    ELSEIF vl_msg_id2 = 1363  THEN\r
      vs_license_msg := vs_license_msg || CHR(13) || 'The placement validation end date cannot extend beyond the License end date. Please contact OLM.';\r
    ELSEIF vl_msg_id2 = 1364 THEN \r
      vs_license_msg := vs_license_msg || CHR(13) || 'The placement validation end date cannot extend beyond the Program end date. Please contact SSA.'; \r
    END IF; \r
   END IF;\r
   \r
   -- 3rd message\r
   IF vl_msg_id3 > 0 THEN\r
