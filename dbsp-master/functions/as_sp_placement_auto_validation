  AND START_DT <= vd_service_end_dt\r
  AND ( END_DT >= vd_service_start_dt OR END_DT IS NULL)\r
 ORDER BY PROGRAM_RATE_ID DESC\r
 FETCH FIRST ROW ONLY;\r
\r
  al_sqlcode := SQLCODE;\r
 IF al_sqlcode < 0 THEN\r
   as_error := 'Error in getting Contract Rate ID for PROGRAM_ID : ' || LTRIM(RTRIM(TO_CHAR(vl_contract_program_id)));\r
  --SIGNAL p_sp_error;\r
 END IF ;\r
\r
 IF vl_prog_rate_id = 0 OR vl_prog_rate_id is NULL THEN\r
   as_auto_valid_success_sw := 'N';\r
