-- Public Providers Edits - START\r
IF vl_contract_program_id = 0 THEN\r
 -- Provider Home Approval Check - START\r
 SELECT APPROVAL_STATUS_CD,\r
  HA_REVOKE_APPROVAL_STATUS_CD,\r
  HA_REVOKE_APPROVAL_DT\r
 INTO vs_ha_app_status_cd,\r
  vs_ha_revoke_app_status_cd,\r
  vd_ha_revoke_dt   \r
 FROM TB_PROVIDER_APPROVAL  \r
 WHERE DELETE_SW = 'N'   \r
  AND PROVIDER_ID = vl_provider_id\r
  AND HA_APPROVAL_STATUS_CD = '3047' \r
 ORDER BY PROVIDER_APPROVAL_ID DESC\r
 FETCH FIRST ROW ONLY ;\r
 \r
  al_sqlcode := SQLCODE;\r
 IF al_sqlcode < 0 THEN\r
   as_auto_valid_success_sw := 'N';\r
  IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
    as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || 'Error in Getting Approved Home Approval for the Provider.' ;\r
  ELSE \r
    as_auto_valid_errors := 'Error in Getting Approved Home Approval for the Provider.' ;\r
  END IF; \r
 ELSE\r
 \r
  IF vs_ha_app_status_cd is NULL THEN\r
    vs_ha_app_status_cd := '';\r
  END IF;\r
  \r
  IF vs_ha_app_status_cd = '3585' AND vs_ha_revoke_app_status_cd = '3047' THEN\r
   IF ad_placement_exit_dt IS NULL THEN -- Open Placement\r
     as_auto_valid_success_sw := 'N';\r
    IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
      as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || 'Placement validation for this child cannot take place until the child''s placement is end-dated.';\r
    ELSE \r
      as_auto_valid_errors := 'Placement validation for this child cannot take place until the child''s placement is end-dated.';\r
    END IF;  \r
   ELSE\r
    IF vd_ha_revoke_dt is NOT NULL THEN\r
     IF ad_placement_exit_dt > vd_ha_revoke_dt THEN\r
       as_auto_valid_success_sw := 'N';\r
      IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
        as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || 'Placement validation for this child cannot take place until the child''s placement is end-dated on or before the revocation date.';\r
      ELSE \r
        as_auto_valid_errors := 'Placement validation for this child cannot take place until the child''s placement is end-dated on or before the revocation date.';\r
      END IF; \r
     END IF;\r
    ELSE\r
     -- Allow placement Validation, for HA data with 'Revoked' status an d NULL Approved DT (Data issue).\r
    END IF;\r
   END IF;\r
  ELSEIF vs_ha_app_status_cd <> '3579' AND vs_ha_app_status_cd <> '3586' THEN \r
   -- 3579 Approved / 3586 On Hold\r
    as_auto_valid_success_sw := 'N';\r
   IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
     as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || 'Approved Home Approval not found for ' || vs_provider_nm || '; placement cannot be validated.';\r
   ELSE \r
     as_auto_valid_errors := 'Approved Home Approval not found for ' || vs_provider_nm || '; placement cannot be validated.';\r
   END IF; \r
  END IF; \r
 END IF; \r
 -- Provider Home Approval Check - END\r
 \r
 -- Location Address Check (Only if Service Start Date >= 2010-04-01 – County Specific Implementation date) - START\r
 -- 1783 - Local Department Home\r
 -- 2010-04-01 - County Specific Rate Implementation date\r
  \r
 IF vs_provider_category = '1783' AND vd_service_start_dt >= DATE('2010-04-01') THEN \r
 \r
\r
--  SELECT DAYS(vd_service_start_dt) - DAYS(ad_placement_entry_dt) AS PLACEMENT_DAYS \r
       -- select EXTRACT(DAY FROM DATE ((TO_CHAR(vd_service_start_dt,'YYYY-MM-DD')))) :: integer - EXTRACT(DAY FROM DATE ((TO_CHAR(ad_placement_entry_dt,'YYYY-MM-DD')))) :: integer AS PLACEMENT_DAYS \r
  -- INTO vl_efc_days;\r
 select (vd_service_start_dt::date - ad_placement_entry_dt::date)AS PLACEMENT_DAYS INTO vl_efc_days;\r
  --FROM SYSIBM.SYSDUMMY1;\r
  \r
  -- 10 - Regular Foster Care and 13 - Emergency Foster Home Care \r
  IF vl_rate_strucure_id = 10 OR ( vl_plc_strucure_id = 13 AND vl_efc_days >  60 ) THEN  \r
   -- Check for Location Address information is completely missing\r
   SELECT COUNT(*)\r
    INTO vl_add_count\r
   FROM TB_PROVIDER_ADDRESSES\r
   WHERE DELETE_SW = 'N'\r
    AND PARENT_KEY_ID = vl_provider_id\r
    AND ADR_TYPE_CD = '3357'\r
    AND ADR_START_DT <= vd_service_end_dt\r
    AND ( ADR_END_DT is NULL OR ADR_END_DT >= vd_service_start_dt );\r
\r
    al_sqlcode := SQLCODE;\r
   IF al_sqlcode < 0 THEN\r
     as_error := 'Error in getting Location Address for PROVIDER_ID : ' || LTRIM(RTRIM(TO_CHAR(vl_provider_id)));\r
    --SIGNAL p_sp_error;\r
   END IF ;\r
 \r
   IF vl_add_count = 0 THEN\r
     vl_add_ret := -1 ; -- Fail\r
   ELSE\r
     vl_add_ret := -1 ; -- Initial value - Fail\r
     vl_add_count := 1;\r
\r
    -- Cursor for All Location Address slabs within service dates  - START\r
    \r
    --EXIT_LOOP:\r
    \r
    --FOR Cur_locn_add_slabs AS\r
    OPEN Cur_locn_add_slabs_refcur FOR\r
      \r
\r
     SELECT ADR_START_DT,\r
         ADR_END_DT \r
     FROM TB_PROVIDER_ADDRESSES\r
     WHERE DELETE_SW = 'N'\r
      AND PARENT_KEY_ID = vl_provider_id\r
      AND ADR_TYPE_CD = '3357'\r
      AND ADR_START_DT <= vd_service_end_dt\r
      AND ( ADR_END_DT is NULL OR ADR_END_DT >= vd_service_start_dt  )\r
     ORDER BY ADR_START_DT ;  \r
    <<EXIT_LOOP>>\r
    --DO\r
      loop\r
 fetch Cur_locn_add_slabs_refcur into Cur_locn_add_slabs;\r
           exit when not found;\r
\r
      vd_adr_start_dt := Cur_locn_add_slabs.ADR_START_DT;\r
      vd_adr_end_dt := Cur_locn_add_slabs.ADR_END_DT;\r
    \r
     -- Service Start date is prior to Address slab start date as cursor is having sort by clause \r
     \r
     IF vl_add_count = 1 AND vd_service_start_dt < vd_adr_start_dt THEN\r
      -- Fail\r
      --LEAVE EXIT_LOOP;\r
      EXIT EXIT_LOOP WHEN (vl_add_count = 1 AND vd_service_start_dt < vd_adr_start_dt);\r
\r
     END IF;\r
     \r
     -- Start date is prior to Service Start date AND End date is later than Service Start date or Slab is Open \r
     IF vd_adr_start_dt <= vd_service_start_dt AND ( vd_adr_end_dt is NULL OR vd_adr_end_dt = DATE('1900-01-01') OR vd_adr_end_dt >= vd_service_end_dt ) THEN\r
      -- Pass\r
       vl_add_ret := 1; \r
      --LEAVE EXIT_LOOP;\r
      EXIT EXIT_LOOP WHEN (vd_adr_start_dt <= vd_service_start_dt AND ( vd_adr_end_dt is NULL OR vd_adr_end_dt = DATE('1900-01-01') OR vd_adr_end_dt >= vd_service_end_dt ));\r
\r
     END IF;\r
     \r
     -- Conditions for Second Slab onwards\r
     IF vd_adr_last_end_dt is NOT NULL AND vd_adr_last_end_dt <> DATE('1900-01-01')  THEN\r
      -- Check the gap between prior slabs End date and current slabs Start Date\r
      IF vd_adr_start_dt > vd_adr_last_end_dt THEN\r
       -- Fail\r
       --LEAVE EXIT_LOOP;\r
       EXIT EXIT_LOOP WHEN (vd_adr_start_dt > vd_adr_last_end_dt);\r
\r
      ELSE\r
       -- End date is later than Service Start date or Slab is Open \r
       IF vd_adr_end_dt is NULL OR vd_adr_end_dt = DATE('1900-01-01') OR vd_adr_end_dt >= vd_service_end_dt THEN\r
        -- Pass\r
         vl_add_ret := 1; \r
        --LEAVE EXIT_LOOP;\r
        EXIT EXIT_LOOP WHEN (vd_adr_end_dt is NULL OR vd_adr_end_dt = DATE('1900-01-01') OR vd_adr_end_dt >= vd_service_end_dt);\r
       END IF;\r
      END IF;\r
     END IF;\r
     \r
     -- Get current rows exit date to compare with next rows entry date for gap\r
     --SELECT DATE(vd_adr_end_dt) + 1 DAY\r
     SELECT DATE(vd_adr_end_dt) + 1 \r
      INTO vd_adr_last_end_dt;\r
        --FROM SYSIBM.SYSDUMMY1;\r
     \r
      vl_add_count := vl_add_count + 1;\r
\r
     -- Reset\r
      vd_adr_start_dt := NULL;\r
      vd_adr_end_dt := NULL;\r
    --END FOR; \r
    END LOOP;\r
    CLOSE Cur_locn_add_slabs_refcur;\r
    -- Cursor for All Location Address slabs within service dates  - END\r
   END IF;\r
\r
   IF vl_add_ret = -1 THEN\r
     as_auto_valid_success_sw := 'N';\r
    IF RTRIM(LTRIM(as_auto_valid_errors)) <> '' THEN\r
      as_auto_valid_errors := as_auto_valid_errors || ' ' || CHR(13) || 'Provider location address information is incomplete (not every service day is counted for) contact provider resource worker, placement cannot be validated.';\r
    ELSE \r
      as_auto_valid_errors := 'Provider location address information is incomplete (not every service day is counted for) contact provider resource worker, placement cannot be validated.';\r
    END IF; \r
   END IF;\r
  END IF; \r
 END IF;\r
 -- Location Address Check (Only if Service Start Date >= 2010-04-01 – County Specific Implementation date) - END\r
 \r
END IF;\r
