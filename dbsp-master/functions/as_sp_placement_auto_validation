\r
 -- Provider Contract Rate Check - START\r
 SELECT PROGRAM_RATE_ID\r
  INTO vl_prog_rate_id\r
 FROM TB_PROV_PROGRAM_RATES\r
 WHERE PROGRAM_ID = vl_contract_program_id \r
