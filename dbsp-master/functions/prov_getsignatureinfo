CREATE OR REPLACE FUNCTION prov_getsignatureinfo(v_objectid character varying)
 RETURNS TABLE(object_id character varying, signature json, signature_id character varying, create_ts character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                             
                                                                                                                                                                                           
 declare                                                                                                                                                                                   
                                                                                                                                                                                           
                                                                                                                                                        
                                                                                                                                                                                           
 begin                                                                                                                                                                                     
                                                                                                                                                                      
                                                                                                                                                                                           
         RETURN QUERY SELECT ptr.object_id, ptr.signature , ptr.signature_id,ptr.create_ts
         FROM prov_signature_capture ptr where ptr.object_id = v_objectid  and ptr.delete_sw='N'                                                                                                                
         order by ptr.create_ts desc;                                                                                                                                                     
 end;                                                                                                                                                        
                                                                                                                                                                                           
 $function$

