v_sign := objectls->>'signature';

---------------
if v_eventcode = 'CPAHOME'
then
   v_type = 'CPA Home';
else 
   v_type = '';
end if;
---------------
if v_appstatus = 'Incomplete'
then
   v_appstatustext = 'Saved as Draft';
else 
   if v_appstatus = 'Approved'
   then
      v_appstatustext = 'Approved';
   end if;
 
   if v_appstatus = 'Close'
   then
      v_appstatustext = 'Closed CPA Home';
   end if;
end if;


v_subject := v_type||' "'||v_objectname||'" '|| v_appstatustext||' by ' ||v_username ;

if(v_appstatus = 'Close') then 
   v_end_dt = objectls->>'closure_date';   
else 
   v_end_dt = null;   
end if;
if(v_appstatus = 'Approved') then 
   v_start_dt = objectls->>'closure_date'; 
else
   v_start_dt = null;
end if;

