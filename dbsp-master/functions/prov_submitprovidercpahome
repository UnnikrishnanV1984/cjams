CREATE OR REPLACE FUNCTION prov_submitprovidercpahome(objectls json)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 

declare
v_fromsecurityuserid character varying;
v_prgstatus character varying;
v_objectid character varying;
v_subject character VARYING;
v_remarks character VARYING;
v_success character VARYING;
v_tousersid json;
