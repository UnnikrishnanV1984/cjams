CREATE OR REPLACE FUNCTION prov_getvendorslist(v_sort json, v_search json, v_lipagenumber bigint, v_lipagesize bigint)
 RETURNS TABLE(totalcount bigint, refferraldate character varying, vendorid character varying, vendorapplicantid uuid, org_nm character varying, provider_first_nm character varying, provider_last_nm character varying, sortname character varying, referraldate character varying, status character varying, address character varying, approvaldate character varying, jurisdiction character varying, providerid character varying, countyname character varying, submittedfor character varying)
 LANGUAGE plpgsql
AS $function$
 
DECLARE
 v_pagenumber int;
    v_pageoffset int;
   v_sortcolumn character varying;
   v_direction character varying;
   v_searchid CHARACTER VARYING;
   v_provider_nm CHARACTER VARYING;
   v_ssn CHARACTER VARYING;
 v_fein CHARACTER VARYING;
 v_status CHARACTER VARYING;
 v_services character VARYING;
   searchstring character varying(1000);
  querytxt text;
 v_orderby character varying;
 v_county character varying;
 v_vendortype character varying;
v_categorycode int4;
BEGIN
     v_pagenumber := v_liPageNumber - 1;
     v_pageoffset := v_pagenumber * v_liPageSize;
    v_sortcolumn := v_sort ->> 'active';
      v_direction := v_sort ->> 'direction';
   v_searchid := v_search ->> 'providerid';
   v_provider_nm := v_search ->> 'provider_nm';
   v_county:=v_search->>'countycd';
   v_ssn := v_search ->> 'ssn';
   v_fein := v_search ->> 'fein';
   v_status := v_search ->> 'status';
   v_services := v_search ->> 'services';
  v_vendortype:=v_search->>'vendortype';
 
  raise notice '%v_county',v_county;
 if (v_vendortype='37812') then
  v_categorycode=1787;
 else
   v_categorycode=3304;
 end if;

return query 
select  a.* from (
select --distinct
count(1) over() as totalcount, 
(select psv.start_dt::character VARYING as referraldate from tb_provider_services psv where pr.provider_id = psv.provider_id order by psv.create_ts limit 1) as refferraldate,
pr.provider_id::character varying as vendorid,
ta.vendorapplicantid,
pr.provider_nm::character varying as org_nm,pr.provider_first_nm, pr.provider_last_nm,cast(concat(pr.provider_nm,pr.provider_first_nm,pr.provider_last_nm) as character varying) as sortname,
(select psv.start_dt::character VARYING as referraldate from tb_provider_services psv where pr.provider_id = psv.provider_id order by psv.create_ts limit 1),
pval.value_tx::character varying status,
(select * from prov_get_formatted_addresses(pr.provider_id)) as address, 
 pr.create_ts as approvaldate,
 pr.county_cd_tx::character varying as jurisdiction,
 pr.provider_id::character varying as providerid ,
--  (case when c.countyname is not null then c.countyname else (select ct.countyname from county ct where statecountycode=pr.county_cd) end) as countyname,
(SELECT ct.countyname FROM county ct WHERE statecountycode=pr.county_cd) AS countyname,
(SELECT up.displayname FROM providerassignment r 
INNER JOIN userprofile up ON up.securityusersid = r.toworkeridno AND up.activeflag = 1
WHERE r.activeflag =1 AND r.objectid = pr.provider_id LIMIT 1) as submittedfor
from tb_provider pr left join tb_provider_addresses pra on pr.provider_id = pra.parent_key_id and pra.adr_type_cd='3357' and pra.delete_sw='N'
and pra.adr_default_sw ='Y'
-- join tb_provider_services psv on pr.provider_id = psv.provider_id 
join tb_picklist_values pval on pr.provider_status_cd = pval.picklist_value_cd and picklist_type_id=159
left join tb_vendor_applicant ta on ta.providerid = pr.provider_id and ta.status='Active' and ta.vendorid is not null and ta.delete_sw='N' 
left join tb_provider_picklist tpp on pr.provider_id = tpp.provider_id
-- left join providerassignment pva on pva.objectid = pr.provider_id AND pva.activeflag = 1
-- left join team t on pva.toteamid = t.teamid
-- left join county c on c.countyid::character varying = t.countyid::character varying
where pr.delete_sw='N' and (pr.provider_category_cd = v_categorycode or (tpp.picklist_value_cd = v_categorycode and tpp.picklist_type_id = 155 and tpp.delete_sw='N'))
and  case when v_categorycode = '3304' then tpp.provider_id in (select case when (((count(provider_id) over(partition by provider_id)) = 1) AND (tpp1.picklist_value_cd='3304')) then provider_id end from tb_provider_picklist tpp1
where tpp1.picklist_type_id = 155 and tpp1.picklist_value_cd in ('1783','3304') and tpp1.delete_sw='N') and tpp.provider_id is not null
 else true end 
and (v_searchid is null or v_searchid = '' or pr.provider_id::character VARYING like '%'||v_searchid||'%')
and (v_ssn is null or v_ssn = '' or pr.tax_id_no::character VARYING like '%'||v_ssn||'%')
-- and (v_county is null or v_county = '' or (c.statecountycode::character VARYING like '%'||v_county||'%' or pr.county_cd::character VARYING like '%'||v_county||'%'))
and (v_county is null or v_county = '' or (pr.county_cd::character VARYING like '%'||v_county||'%'))
and (v_fein is null or v_fein = '' or pr.tax_id_no::character VARYING like '%'||v_fein||'%')
and (v_status is null or v_status = '' or pval.value_tx::character VARYING like '%'||v_status||'%')
and (v_provider_nm = '' or v_provider_nm is null or (
              lower(pr.provider_nm) like '%'||v_provider_nm||'%' 
                            or pr.provider_first_nm like '%'||v_provider_nm||'%' 
                            or pr.provider_middle_nm like '%'||v_provider_nm||'%' 
                            or pr.provider_last_nm like '%'||v_provider_nm||'%'
        ) )
) a 
order by (case v_direction when 'asc' then 
         case v_sortcolumn when 'providerid' then a.providerid 
             when 'org_nm' then a.sortname
             when 'approvaldate' then a.approvaldate
             when 'status' then a.status
             when 'referraldate' then a.refferraldate

         else a.approvaldate 
         end
    END) ASC NULLS LAST,
    (case v_direction when 'desc' then 
         case v_sortcolumn when 'providerid' then a.providerid 
             when 'org_nm' then a.sortname
             when 'approvaldate' then a.approvaldate
             when 'status' then a.status
             when 'referraldate' then a.refferraldate
         else a.approvaldate
         end
    END) DESC NULLS LAST
 LIMIT  v_liPageSize   OFFSET  v_pageoffset;




END;

$function$

