CREATE OR REPLACE FUNCTION qnetrpt_positionnotifications(p_loadnumber character varying, p_notificationtype character varying, p_subject character varying, p_fromdate timestamp without time zone, p_todate timestamp without time zone)
 RETURNS TABLE(danumber character varying, createddate timestamp without time zone, fromuser character varying, touser character varying, usernotificationtypekey character varying, subject character varying, body text)
 LANGUAGE plpgsql
AS $function$  
 -- SET NOCOUNT ON added to prevent extra result sets from  
 -- interfering with SELECT statements.  
--SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED

DECLARE v_UserSID varchar(100); 
 v_UserTeamID varchar(100);
BEGIN


CREATE TEMP TABLE FromNotifications  ( UserNotificationId uuid );
CREATE TEMP TABLE ToNotifications  ( UserNotificationId uuid );

-- find the user who is getting the notifications from the given loadnumber
SELECT TM.TeamMemberId,
       TMA.SecurityUsersId INTO v_UserTeamID, v_UserSID
  FROM TeamMember TM
  JOIN TeamMemberAssignment TMA ON TMA.TeamMemberId = TM.TeamMemberId and TMA.Activeflag=1
 WHERE TM.LoadNumber = p_LoadNumber;

-- get all notifications that this user sent 
INSERT INTO FromNotifications     
SELECT UN.UserNotificationId
  FROM UserNotification UN
 WHERE UN.SecurityUsersId = v_UserSID
  ORDER BY 1;

-- get all notifications that this user received
INSERT INTO ToNotifications     
SELECT UserNotificationId 
  FROM UserNotification UN
 WHERE UserNotificationId IN ( SELECT UserNotificationId
                                 FROM UserNotificationMap
                                WHERE ToSecurityUsersId = v_UserSID )
 ORDER BY UserNotificationId;

-- get all unique notification ids for this user/loadnumber
INSERT INTO FromNotifications
 SELECT UserNotificationId
   FROM ToNotifications
  WHERE UserNotificationId NOT IN ( SELECT DISTINCT(UserNotificationId) 
                                      FROM FromNotifications );
                                      
RETURN QUERY
 
SELECT --TM1.LoadNumber,
       COALESCE(ISR.ServiceRequestNumber,' ') AS DANumber,
       UN.insertedon AS CreatedDate,
       --UN.UserNotificationID,
       --UN.insertedby,
       --UN.SecurityUsersId AS 'FromUserID',
       UP1.DisplayName AS FromUser,
       --UNP.ToSecurityUsersId AS 'ToSecurityUsersId',
       UP2.DisplayName AS ToUser,
       UN.UserNotificationTypeKey,
       --UN.ObjectId,
       --UN.ActiveFlag,
       --UN.URL,
       UN.Subject,
       --UN.PriorityLevelTypeKey,
       UN.Body
       --UN.HasAttachments,
       --UN.updatedby,
       --UN.updatedon,
       --UN.EffectiveDate,
       --UN.ExpirationDate,
       --UN.timestamp,
       --UN.TeamMemberId
  FROM FromNotifications FN
   JOIN UserNotification UN ON UN.UserNotificationId = FN.UserNotificationId
  LEFT JOIN TeamMember TM1 ON TM1.TeamMemberId = UN.TeamMemberId
   JOIN UserProfile UP1 ON UP1.SecurityUsersId = UN.SecurityUsersId
  
  LEFT JOIN UserNotificationMap UNP ON UNP.UserNotificationId = UN.UserNotificationId
  LEFT JOIN UserProfile UP2 ON UP2.SecurityUsersId = UNP.ToSecurityUsersId
  LEFT JOIN IntakeServiceRequest ISR ON ISR.IntakeServiceId = UN.ObjectId
  WHERE UN.UserNotificationTypeKey = CASE WHEN p_NotificationType = 'ALL' THEN UN.UserNotificationTypeKey  ELSE p_NotificationType END
  AND UN.Subject IN ( CASE WHEN p_Subject = 'ANY' THEN UN.Subject ELSE p_Subject  END )
  AND UN.insertedon >= p_FromDate and UN.insertedon <= p_ToDate
ORDER BY UN.insertedon DESC; 

drop table FromNotifications;
drop table ToNotifications;
 

END;
$function$

