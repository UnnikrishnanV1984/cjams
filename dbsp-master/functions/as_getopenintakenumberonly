CREATE OR REPLACE FUNCTION as_getopenintakenumberonly(v_intakenumber character varying)
 RETURNS TABLE(intakenumber character varying)
 LANGUAGE plpgsql
AS $function$

  
BEGIN
  RETURN QUERY 
  
  select distinct IIE.intakenumber from intakeservicerequestevaluation IIE where  activeflag = 1 and  complaintstatustypekey='CAS';
      
end
$function$

