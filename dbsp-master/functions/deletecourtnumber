CREATE OR REPLACE FUNCTION deletecourtnumber(v_courtnumberid character varying, v_userid character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
 v_message character varying;
    
BEGIN

 UPDATE courtnumbers 
 SET activeflag = 0, updatedon = now(), updatedby = v_userid
 WHERE 
 courtnumberid::CHARACTER VARYING = v_courtnumberid AND activeflag = 1;

 v_message:= 'Success';

    return v_message;
END  
$function$

