CREATE OR REPLACE FUNCTION prov_listappeal(v_sanction_id uuid, v_license_type character varying, pagenumber integer, pagesize integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
v_appealdata json;
v_pageoffset int;                                                                                                                                                                                                                                                                                                                                                            
v_pagenumber int;      

BEGIN  
     v_pagenumber := pagenumber-1;                                                                                                                                                                                                                                                                                                                                                     
     v_pageoffset = v_pagenumber * pagesize;     

if (v_license_type = 'RCC')then
    
select  jsonb_agg(x) as sanctiondata into v_appealdata from
(select * from tb_provider_rcc_appeal where rcc_sanction_id =  v_sanction_id
LIMIT pagesize OFFSET v_pageoffset)x;

elseif (v_license_type = 'CPA') then
select  jsonb_agg(x) as sanctiondata into v_appealdata from
(select * from tb_provider_cpa_appeal where  cpa_sanction_id =  v_sanction_id
LIMIT pagesize OFFSET v_pageoffset)x;
end if ;
return v_appealdata;
END;
$function$

