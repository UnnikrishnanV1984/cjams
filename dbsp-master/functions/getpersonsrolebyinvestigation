                         p.lastname,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                         p.dob,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                         p.dateofdeath,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                         p.isapproxdod,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                         p.personid,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                         p.cjamspid,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
