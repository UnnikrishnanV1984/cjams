 IF COALESCE(v_roles,'') <> '' THEN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
         INSERT INTO actor_temp1(actortype,activeflag)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                 SELECT unnest(string_to_array(v_roles,',' )),0;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
         INSERT INTO actor_temp1(actortype,activeflag)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
         SELECT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                         intakeservicerequestpersontypekey,1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
                 FROM intakeservicerequestactor                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
         WHERE intakeservicerequestpersontypekey NOT IN (SELECT actortype FROM actor_temp1) AND intakeserviceid=v_intakeserviceid;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                 FOR actorloop IN SELECT actortype FROM actor_temp1 where activeflag=1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                 LOOP                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                         INSERT INTO actor_temp2(actortype,actorid,personid)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
                                 SELECT                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                                         ISR.intakeservicerequestpersontypekey,ISR.intakeservicerequestactorid,ISR.personid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
                                 FROM intakeservicerequestactor ISR                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
                                 WHERE ISR.intakeservicerequestpersontypekey = actorloop.actortype AND ISR.intakeserviceid = v_intakeserviceid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
