                         count(1) over() AS totalcount,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                         ACT2.ACTORID intsrvreqactorid,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
