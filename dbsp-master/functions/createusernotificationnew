CREATE OR REPLACE FUNCTION createusernotificationnew()
 RETURNS text
 LANGUAGE plpgsql
AS $function$

declare 
v_notification_rec RECORD;
v_objectid uuid;
v_notificationtypekey character varying;
v_datefieldname character varying;
v_notificationoffset integer;
v_frequencytype character varying;
v_offsetminutes integer;
v_notificationmessage character varying;
v_intakenumber character varying;
v_intakeserviceid character varying;

begin


CREATE TEMP TABLE _Temp_usernotification
(
 usernotificationid uuid NOT NULL DEFAULT gen_random_uuid(),
 securityusersid character varying(50),
    fromsercurityusersid character varying(50),
 tosecurityusersid    character varying(50),
 usernotificationtypekey character varying(15) NOT NULL,
 objectid character varying(50),
 
 
 subject character varying(255),
 priorityleveltypekey character varying(15),
 body text NOT NULL,
 
 updatedby character varying(50),
 updatedon timestamp without time zone,
 insertedby character varying(50),
 insertedon timestamp without time zone DEFAULT now() 
  
 );
 

 FOR v_notification_rec IN select  objectid,datefieldname, notificationtypekey, notificationoffset,frequencytype, offsetminutes, notificationmessage   from notificationconfig where teamtypekey ='CW' and notificationtypekey ='DA'

            LOOP
   
 v_objectid := v_notification_rec.objectid;
 v_notificationtypekey := v_notification_rec.notificationtypekey;
 v_datefieldname := v_notification_rec.datefieldname;
 v_notificationoffset := v_notification_rec.notificationoffset;
 v_frequencytype := v_notification_rec.frequencytype;
 v_offsetminutes := v_notification_rec.offsetminutes;
 v_notificationmessage  := v_notification_rec.notificationmessage;

if (v_notification_rec.notificationtypekey ='DA') then

 insert into _Temp_usernotification (securityusersid, fromsercurityusersid, tosecurityusersid, usernotificationtypekey,
                                        objectid, subject,priorityleveltypekey,
  body,updatedby,insertedby, insertedon, updatedon)
  
  
  select distinct isr.routedusersid ,'System', isr.routedusersid,'System',isr.intakeserviceid,Replace(v_notificationmessage, '[servreqno]',isr.servicerequestnumber), 
        'Normal',Replace (v_notificationmessage, '[servreqno]',isr.servicerequestnumber) 
        ,'System','System',now() ,now()  
        
        from  intakeservicerequest ISR 
  inner join servicerequesttypeconfig SRTC on SRTC.servicerequestsubtypeid = ISR.intakeservicerequestclassid
        and SRTC.intakeservreqtypeid = ISR.intakeservreqtypeid
        and SRTC.servicerequesttypeconfigid = v_objectid
        and SRTC.activeflag =1 
  where   coalesce(ISR.isaccepted,false ) =true 
  and   ((extract (day from now() - ISR.accepteddate)))  =   coalesce(v_notificationoffset,0);
  
 
  
end if;
end loop;
 
 insert into  usernotification (usernotificationid,securityusersid  , usernotificationtypekey,objectid, subject,priorityleveltypekey,
  body,updatedby,insertedby, insertedon, updatedon)
  select usernotificationid,securityusersid  , usernotificationtypekey,objectid, subject,priorityleveltypekey,
  body,updatedby,insertedby, insertedon, updatedon  from _Temp_usernotification;

   insert into  usernotificationmap (usernotificationid,fromsecurityusersid ,tosecurityusersid , 
             updatedby,insertedby, insertedon, updatedon)
  select usernotificationid,'System'  , tosecurityusersid ,updatedby,insertedby,
  insertedon, updatedon  from _Temp_usernotification;
        
Return 'Success'        ;
drop   TABLE _Temp_usernotification;
End;
$function$

