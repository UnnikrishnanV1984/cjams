CREATE OR REPLACE FUNCTION listprovideruir(userid character varying, p_status character varying, pagenumber integer, pagelimit integer, uirno character varying, sortcolumn character varying, sortorder character varying)
 RETURNS TABLE(totalcount bigint, provider_uir_id uuid, uir_no character varying, provider_id integer, insertedon timestamp without time zone, inserted_by character varying, formatted_provider_nm character varying, updated_on timestamp without time zone, displayname character varying, routingstatustypeid integer, statusdesc text)
 LANGUAGE plpgsql
AS $function$

DECLARE 
v_pageoffset int;
v_pagenumber int;
v_pagelimit int;
v_limit int;
totalcount integer;
v_status character varying;
 v_userid character varying;
 orderbycolumn character varying;

 BEGIN
 v_limit=10;
    v_pagenumber := pageNumber-1;
    v_pageoffset = v_pagenumber * v_limit;  
v_userid=null;
   
IF (p_status ='pending')  THEN
  v_status=null;   


ELSIF  (p_status='review')  then
    v_userid='review'; 
  v_status='49';
   
  

  
    end if;

 RETURN QUERY 


select count(1)  over(),  PU.provider_uir_id,  PU.uir_no,  
  PU.provider_id,

PU.inserted_on, PU.inserted_by,TB.formatted_provider_nm,PU.updated_on,UP.displayname,r.routingstatustypeid,
CASE     WHEN RTs.typedescription is null THEN  'Pending'  ELSE RTs.typedescription  end as statusdesc
FROM  provider_uir PU
left join tb_provider TB on TB.provider_id=PU.provider_id
left join userprofile UP on UP.securityusersid=PU.inserted_by
LEFT  JOIN  routing  r  ON  r.objectid  = PU.provider_uir_id::varchar   AND  (r.activeflag  =1 )--  and  r.eventcode in ('PRCM')
LEFT  JOIN  routingstatustype  RTs  ON  RTs.sequencenumber  =  r.routingstatustypeid  and  rts.activeflag  =1  
LEFT  JOIN  teammemberroletype  rt  on  rt.roletypekey  =  r.toroleid  AND  rt.activeflag  =1

where PU.active_flag=1 
and  CASE WHEN v_status is  NULL THEN (PU.uir_status is null or PU.uir_status='49'  ) ELSE (PU.uir_status = v_status) END

--and case
--WHEN v_userid is  null THEN (PU.inserted_by=userid)
--ELSE (r.tosecurityusersid = userid) end

AND case when uirno is not null then (COALESCE(lower(PU.uir_no) ,'') LIKE '%'||COALESCE(lower(uirno) ,'')||'%') END

group by PU.provider_uir_id,  PU.uir_no,  
PU.inserted_on,PU.inserted_by,
TB.formatted_provider_nm,PU.updated_on,UP.displayname,RTs.typedescription,r.routingstatustypeid
order by
 (
 case
  sortorder
  when 'asc' then
  case
   sortcolumn
   when 'uir_no' THEN PU.uir_no :: character varying 
   when 'provider_id' then PU.provider_id :: character varying
    when 'provider_name' then UP.displayname :: character varying 
    when 'program_name' then PU.uir_no :: character varying 
   when 'licensing_agency' then PU.uir_no :: character varying 
   when 'incident_date' then PU.inserted_on :: character varying 
   else PU.uir_no :: character varying
  end
 end) asc,
 (
 case
  sortorder
  when 'desc' then
  case
   sortcolumn
   when 'uir_no' THEN PU.uir_no :: character varying 
   when 'provider_id' then PU.provider_id :: character varying
    when 'provider_name' then UP.displayname :: character varying 
    when  'program_name' then PU.uir_no :: character varying 
    when 'licensing_agency' then PU.uir_no :: character varying 
    when 'incident_date' then PU.inserted_on :: character varying 
   else PU.uir_no :: character varying
  end
 end) desc

LIMIT v_limit OFFSET v_pageoffset ;  
          RAISE  NOTICE  'v_userid%',v_userid;              
end

$function$

