CREATE OR REPLACE FUNCTION as_savesaoresponse(v_intakenumber character varying, jsondata json, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE  

--v_date timestamp without time zone;
v_date timestamp without time zone;
i_saoresponsecount int;
v_intakejson json;
j_saoresponse json;
v_saoresponseid uuid;
v_saoresponseconditiontypeconfigid uuid;
j json;
k json;
j_intakeserviceid uuid;
j_saoresponseconditiontype json;
v_saoresponsestatustypekey character varying;
 
BEGIN

v_date:= now() ;

select count(1) into i_saoresponsecount from saoresponse where intakenumber = v_intakenumber and activeflag = 1;
select intakeserviceid into j_intakeserviceid from intakeservicerequest where intakenumber = v_intakenumber and activeflag = 1;
j_saoresponse := jsondata;

v_saoresponsestatustypekey := j_saoresponse ->> 'saoresponsestatustypekey';


 -- SAO Response
   IF (i_saoresponsecount = 0) THEN

        v_saoresponseid :=   gen_random_uuid();
                
  Insert Into saoresponse (saoresponseid, saoresponsedate, saoresponsestatustypekey, saoresponseconditiontypekey, intakenumber, activeflag, insertedby,updatedby)
  values (v_saoresponseid,cast(j_saoresponse ->> 'saoresponsedate' as timestamp without time zone),
  cast(j_saoresponse ->> 'saoresponsestatustypekey' as character varying),null, v_intakenumber, 1, v_securityuserid, v_securityuserid); -- cast(j_saoresponse ->> 'saoresponseconditiontypekey' as character varying)
  
  if v_saoresponsestatustypekey = 'RBSAOFID' then
  j_saoresponseconditiontype := j_saoresponse ->> 'saoresponseconditiontype';
  
  --For k in Select * from json_array_elements(j_intakeserviceid)
    --  LOOP
  For j in Select * from json_array_elements(j_saoresponseconditiontype)
      LOOP
   v_saoresponseconditiontypeconfigid:=   gen_random_uuid();
   Insert Into saoresponseconditiontypeconfig (saoresponseconditiontypeconfigid, saoresponseid, conditiontypekey, intakenumber, intakeserviceid, activeflag, insertedby, updatedby, insertedon, updatedon )
   values (v_saoresponseconditiontypeconfigid, v_saoresponseid, 
   cast(j ->> 'conditiontypekey' as character varying), 
   v_intakenumber,j_intakeserviceid , 1, v_securityuserid, 
   v_securityuserid, v_date, v_date ); -- cast(k ->> 'intakeserviceid' as uuid)
     
      END LOOP; 
    
  --END LOOP;
 
END IF; 
  END IF; 
 
     Return 'Success';
 
END;

$function$

