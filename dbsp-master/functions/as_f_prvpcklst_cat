CREATE OR REPLACE FUNCTION as_f_prvpcklst_cat(ai_prov_id bigint, as_category_type character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
BEGIN
    RETURN
         CASE
         WHEN as_category_type = 'PLACEMENT' THEN 
   (SELECT PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD IN ('1782','1783','1785','3049','3274','3302') 
       AND PROVIDER_ID        = ai_prov_id 
       AND DELETE_SW          = 'N')

   WHEN as_category_type = 'VENDOR' THEN
   (SELECT PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD = '3304' 
       AND PROVIDER_ID       = ai_prov_id 
       AND DELETE_SW         = 'N')

   WHEN as_category_type = 'COMMUNITY' THEN
   (SELECT PICKLIST_VALUE_CD 
      FROM TB_PROVIDER_PICKLIST
     WHERE PICKLIST_VALUE_CD = '3305' 
       AND PROVIDER_ID       = ai_prov_id 
       AND DELETE_SW         = 'N')
       END;
END;

$function$

