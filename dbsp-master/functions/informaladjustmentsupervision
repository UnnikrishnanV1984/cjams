CREATE OR REPLACE FUNCTION informaladjustmentsupervision(i_evalutionid uuid, victimid uuid)
 RETURNS TABLE(youthname character varying, youthid bigint, complaintid character varying, complaintdate character varying, victimname character varying, offensename character varying[], offensedate character varying)
 LANGUAGE plpgsql
AS $function$
   BEGIN
 RETURN QUERY

  (SELECT Cast(p.firstname ||' ' || p.lastname AS CHARACTER VARYING) AS youthname,
      p.cjamspid AS youthid,
      inve.complaintid AS complaint_id,
      CAST (To_char(complaintreceiveddate, 'MM/DD/YYYY') AS CHARACTER VARYING) AS complaintdate,
      (select CAST(p.firstname ||' '|| p.lastname as character varying) from Person p where p.personid=victimid and  p.activeflag=1) as victimname, 
     (SELECT array_agg(ag.NAME)
      FROM allegation AG
      JOIN intakeservicerequestevaluationconfig ITSEC ON itsec.allegationid=ag.allegationid
      AND ag.activeflag=1
      WHERE itsec.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid
      AND itsec.activeflag=1 )AS offensename,
      CAST (CASE
            WHEN inve.unknownrange=0 THEN To_char(inve.offensedate, 'MM/DD/YYYY')
            WHEN inve.unknownrange=1 THEN To_char(inve.offensedate, 'MM/DD/YYYY')
            WHEN inve.unknownrange=2 THEN To_char(inve.begindate, 'MM/DD/YYYY') || ' - ' || To_char(inve.enddate, 'MM/DD/YYYY')
            END AS CHARACTER VARYING) AS offensedate
   FROM intakeservicerequestevaluation inve
   JOIN intakeservicerequest ins ON ins.intakenumber = inve.intakenumber
   JOIN intakeservicerequestevaluationconfig itsec ON itsec.intakeservicerequestevaluationid=inve.intakeservicerequestevaluationid
   AND itsec.activeflag=1
   JOIN allegation ag ON itsec.allegationid=ag.allegationid
   AND ag.activeflag=1
   JOIN intakeservicerequestactor isa ON ins.intakeserviceid = isa.intakeserviceid
   AND isa.activeflag = 1
   JOIN actor a ON a.actorid = isa.actorid
   AND a.activeflag = 1
   JOIN person p ON p.personid = isa.personid
   AND p.activeflag = 1
   WHERE inve.intakeservicerequestevaluationid = i_evalutionid
     AND a.actortype = 'Youth' );


   end;
  $function$

