CREATE OR REPLACE FUNCTION as_reassigncase(appeventcode character varying, v_objectid uuid, fromuserid character varying, v_assignedsecurity character varying, v_responsibilitytypekey character varying, v_caseassignmentid uuid, v_enddate timestamp without time zone, v_remarks character varying, isanotherunit integer, v_toteamid uuid, v_children json, v_assignmenttype character varying DEFAULT NULL::character varying, v_startdate timestamp without time zone)
 RETURNS TABLE(statuscode integer, status_description character varying)
 LANGUAGE plpgsql
AS $function$ 
 
 
 DECLARE 
 
 statuscode integer;
 status_description character varying;
 
 caseworker_name text;
 
 v_teamid uuid;
 v_fromteamid uuid;
 v_toroletypekey  character varying;
 v_teamname character varying;
 v_team_member_id  uuid;
 v_torolesupervisor  bool;
 
 v_roletypecode character varying;
 v_fromroletypekey character varying;
 v_routingid uuid;
 v_status  int;
 v_notifystatus character varying;
 v_servicerequestno character varying;
 v_statustypekey character varying;
 l_fromldssid uuid;
 l_toldssid uuid;
 l_fromcountyid uuid;
 l_closeworker character varying;
 l_fromworkername character varying;
 l_ldsstransfer int;
 l_binsert int;
 l_objecttypekey character varying;
 l_caseassignmentid uuid;
 l_child json;
 
 
 BEGIN
  v_status:= 4; 
  l_ldsstransfer:= 0;
  
  /*Assigned service Case number*/
  
  l_objecttypekey := 'servicecase';
 
  SELECT  servicecasenumber,statustypekey
  INTO v_servicerequestno,v_statustypekey
  FROM servicecase  
  WHERE servicecaseid = v_objectid AND activeflag =1 LIMIT 1;
   
   
  SELECT isr.servicerequestnumber INTO v_servicerequestno
  FROM intakeservicerequest isr WHERE isr.intakeserviceid = v_objectid AND isr.activeflag = 1;

  IF (COALESCE(appeventcode,'') = 'ADPC') THEN
   l_objecttypekey := 'adoptioncase';
  
   SELECT  adoptioncasenumber,statustypekey
   INTO v_servicerequestno,v_statustypekey
   FROM adoptioncase  
   WHERE adoptioncaseid = v_objectid AND activeflag =1 LIMIT 1;
 
  ELSIF (COALESCE(appeventcode,'') <> 'SRVC') THEN
   
   l_objecttypekey := 'servicerequest';
  
   SELECT  servicerequestnumber,'ASSIGN'
   INTO v_servicerequestno,v_statustypekey
   FROM intakeservicerequest  
   WHERE intakeserviceid = v_objectid AND activeflag =1 LIMIT 1;
 
  END IF;

  /*Logged in user role details*/ 
  
  SELECT r.roletypekey, tm.teamid, t.countyid, t.countyid 
    INTO v_fromroletypekey, v_fromteamid, l_fromcountyid, l_fromldssid 
   FROM muser m
    INNER  JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
    INNER JOIN role r on rm.roleid = r.id and r.activeflag=1
    INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1
    INNER JOIN  teammember tm ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
    INNER JOIN  team t ON t.teamid = tm.teamid AND tm.activeflag =1
    INNER JOIN userprofile up ON up.securityusersid = tma.securityusersid  AND up.activeflag= 1
   WHERE m.SecurityUsersId = fromuserid 
   and m.activeflag = 1;
  
  /*SELECT u.roletypekey, u.teamid, u.countyid, u.countyid
  INTO v_fromroletypekey, v_fromteamid, l_fromcountyid, l_fromldssid
  FROM v_userprofile u where u.securityusersid= fromuserid;
  */ 

     v_teamid:= v_toteamid;


  /*Assigned user team details*/
  IF  (COALESCE(v_teamid::character varying,'') ='') THEN
   SELECT tm.teamid, r.roletypekey,  up.issupervisor, t.countyid 
    INTO v_teamid, v_toroletypekey, v_torolesupervisor, l_toldssid 
   FROM muser m
    INNER JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
    INNER JOIN role r on rm.roleid = r.id and r.activeflag=1
    INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = m.SecurityUsersId AND   tma.activeflag =1
    INNER JOIN  teammember tm ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
    INNER JOIN  team t ON t.teamid = tm.teamid AND tm.activeflag =1
    INNER JOIN userprofile up ON up.securityusersid = tma.securityusersid  AND up.activeflag= 1
   WHERE m.SecurityUsersId = v_assignedsecurity 
    and  t.countyid = l_fromcountyid
   and m.activeflag = 1;
  
 /*  SELECT teamid, roletypekey, teamname, teammemberid, isupervisor, countyid
   INTO v_teamid, v_toroletypekey, v_teamname, v_team_member_id, v_torolesupervisor, l_toldssid
   FROM v_userprofile u 
   WHERE u.securityusersid = v_assignedsecurity
   AND u.teamid = v_fromteamid;   */

   ELSE
/*    SELECT u.roletypekey, isupervisor, u.countyid
   INTO  v_toroletypekey, v_torolesupervisor, l_toldssid
   FROM v_userprofile u WHERE u.securityusersid = v_assignedsecurity and u.teamid = v_teamid ;  */
   
   SELECT  tm.roletypekey, tmrt.isupervisor, t.countyid 
    INTO  v_toroletypekey, v_torolesupervisor, l_toldssid
   FROM userprofile u
    INNER JOIN as_teammemberassignment tma ON tma.SecurityUsersId = u.SecurityUsersId AND   tma.activeflag =1
    INNER JOIN  teammember tm ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
    INNER JOIN  team t ON t.teamid = tm.teamid AND tm.activeflag =1
    LEFT JOIN teammemberroletype tmrt on tm.roletypekey = tmrt.roletypekey and tmrt.activeflag = 1
   WHERE u.SecurityUsersId = v_assignedsecurity 
    and  v_teamid IN (t.teamid, t.parentteamid)
   and u.activeflag = 1;

    END IF;       
  
  IF (v_assignmenttype = 'T') THEN 
    l_toldssid := v_teamid;
    l_fromldssid := l_fromcountyid;
    v_teamid:= null;
    v_fromteamid := null;
    l_ldsstransfer:=1;
    v_status:=9;
  END IF;
   
  IF (COALESCE(v_torolesupervisor,false)= true ) THEN
   v_status:=9;
  END IF;
   
  l_binsert:=1;
  
  
 
  IF (v_caseassignmentid IS NOT NULL) THEN
     SELECT toworkeridno into l_closeworker  FROM caseassignment WHERE caseassignmentid = v_caseassignmentid;
  
     IF (l_closeworker=v_assignedsecurity) THEN
       UPDATE caseassignment
       SET enddate = v_enddate, startdate = v_startdate, responsibilitytypekey = v_responsibilitytypekey,remarks = v_remarks
        , updatedby = fromuserid, updatedon = now()
      WHERE caseassignmentid = v_caseassignmentid;
    -- IF (v_enddate::DATE <= now()::DATE) THEN 
    --  UPDATE usernotification
      --  SET activeflag = 0 where objectid = v_objectid:: character varying and activeflag = 1;
    -- END IF;
    
      l_binsert:=0;
   ELSE
    UPDATE caseassignment SET enddate = now(),remarks = v_remarks, updatedby = fromuserid, updatedon = now() WHERE caseassignmentid = v_caseassignmentid;
    
    SELECT routingid into v_routingid
    FROM routing r 
    WHERE tosecurityusersid = l_closeworker 
      AND activeflag =1
      AND r.objectid  = v_objectid::character varying
    ORDER BY insertedon desc limit 1;
   
    UPDATE routing SET activeflag =0  ,updatedon= now() WHERE routingid = v_routingid;   
   END IF;
    
    UPDATE caseassignmentactor SET activeflag = 0, updatedby = fromuserid, updatedon = now() WHERE caseassignmentid = v_caseassignmentid;
    -- UPDATE usernotification
      --  SET activeflag = 0 where objectid = v_objectid:: character varying and activeflag = 1;
     
     

  END IF;

  /*WHEN PRIMARY RESPONSIBILITY TRANSFER ALL ASSIGNMENTS ENDED  */
     IF (l_ldsstransfer =1) THEN
      UPDATE routing SET activeflag =0  ,updatedon= now() WHERE objectid = v_objectid:: character varying AND routingstatustypeid =4 and activeflag =1; 
         UPDATE caseassignment SET enddate = now() ,updatedon= now(), updatedby = fromuserid WHERE objectid = v_objectid  AND enddate IS NULL; 
   UPDATE usernotification SET activeflag = 0 where objectid = v_objectid:: character varying and activeflag = 1;
     END IF;
      
  IF (v_assignedsecurity IS NOT NULL  AND l_binsert =1) THEN
  /*Routing to  user*/
  
   INSERT INTO routing(
        eventcode, fromsecurityusersid, tosecurityusersid, teamid, 
        fromroleid, toroleid,objectid , routingstatustypeid,
        insertedby,  updatedby , servicerequestnumber,objecttypekey,routeddescription) 
    VALUES(appeventcode,fromuserid,v_assignedsecurity,v_teamid,
       v_fromroletypekey,v_toroletypekey,v_objectid,v_status,
       fromuserid,fromuserid,v_servicerequestno,l_objecttypekey,'Case Assigned');
 
   /*Notification*/
 
   /*Get caseworker name for Notification*/
   SELECT cast( lastname ||',' || firstname as character varying) INTO caseworker_name 
   FROM userprofile 
   WHERE SecurityUsersId=v_assignedsecurity AND activeflag =1;
   
   v_servicerequestno:= COALESCE(v_servicerequestno,'');
   
   SELECT as_send_notification INTO v_notifystatus from as_send_notification(fromuserid, fromuserid,v_assignedsecurity,
   'System', 'Normal', 'Case #'||v_servicerequestno||  CASE l_ldsstransfer WHEN 1 THEN ' Transferred to ' ELSE ' Assigned to ' END || caseworker_name ,
   'Case #'||v_servicerequestno|| CASE l_ldsstransfer WHEN 1 THEN ' Transferred to ' ELSE ' Assigned to ' END|| caseworker_name ,
   cast(v_objectid as character varying));
 
    SELECT COALESCE(displayname,fullname) INTO l_fromworkername FROM userprofile WHERE securityusersid = fromuserid AND activeflag =1;
    
    SELECT as_send_notification INTO v_notifystatus from as_send_notification(v_assignedsecurity,fromuserid,v_assignedsecurity,   
   'System', 'Normal', ' Case #'||v_servicerequestno||  CASE l_ldsstransfer WHEN 1 THEN ' Transferred by ' ELSE ' Assigned by ' END || l_fromworkername ,
   'Case #'|| v_servicerequestno|| CASE l_ldsstransfer WHEN 1 THEN ' Transferred to ' ELSE ' Assigned to ' END || l_fromworkername ,
   cast(v_objectid as character varying));

   IF (v_responsibilitytypekey IS NOT NULL AND v_responsibilitytypekey NOT IN ('administrative')) THEN
    SELECT toworkeridno INTO l_closeworker 
    FROM caseassignment 
    WHERE enddate IS NULL AND responsibilitytypekey= v_responsibilitytypekey AND activeflag =1 AND Objectid = v_objectid  LIMIT 1;
    IF (v_children  is null ) THEN       
    -- UPDATE caseassignment SET enddate = now(), updatedby = fromuserid, updatedon = now() WHERE enddate IS NULL AND responsibilitytypekey= v_responsibilitytypekey AND activeflag =1 AND Objectid = v_objectid  ;
     RAISE NOTICE 'status: 1';
     IF (COALESCE(l_closeworker,'')!='') THEN 
     RAISE NOTICE 'status: 2';
      
      SELECT routingid into v_routingid
      FROM routing r 
      WHERE tosecurityusersid = l_closeworker 
       AND activeflag =1
       AND r.objectid  = v_objectid::character varying
      ORDER BY insertedon desc limit 1;
    
      UPDATE routing SET activeflag =0  ,updatedon= now() WHERE routingid = v_routingid; 
      RAISE NOTICE 'status: 3';
     END IF;
    END IF;
   END IF;

   IF v_responsibilitytypekey IS NULL THEN 
    SELECT (CASE WHEN r.roletypekey IN ('ASSP','ASFD','ASFS') THEN 'administrative' ELSE 'primary' END) INTO v_responsibilitytypekey 
    FROM muser m
    INNER  JOIN rolemapping rm on rm.principalid = m.id and rm.activeflag=1 and rm.teamtypekey = 'AS'
    INNER  JOIN role r on rm.roleid = r.id and r.activeflag=1
    WHERE  m.SecurityUsersId = v_assignedsecurityid AND m.activeflag=1 ORDER BY rm.insertedon DESC nulls LAST LIMIT 1;
   END IF;

   INSERT INTO caseassignment
   (fromworkeridno, toworkeridno, insertedby, updatedby, insertedon, updatedon, objecttypekey, objectid,responsibilitytypekey,startdate,fromteamid,toteamid,remarks,statustypekey,toldssid,fromldssid,assignmenttype,assigndate)
   VALUES(fromuserid,v_assignedsecurity,fromuserid,fromuserid,now(),now(),l_objecttypekey,v_objectid,v_responsibilitytypekey,v_startdate,v_fromteamid,v_teamid,v_remarks,v_statustypekey,l_toldssid,l_fromldssid,v_assignmenttype,now()::date)
   returning "caseassignmentid" into v_caseassignmentid;
   
   UPDATE intakeservicerequest 
   SET countyid = l_toldssid, isrouted = true, updatedby = fromuserid, updatedon = now()
   WHERE intakeserviceid = v_objectid;
  
  END IF ; 

  FOR l_child IN SELECT * FROM json_array_elements(v_children)                                                                                                                                                                                                                 
  LOOP                                                                                                                                                                                                                                                                  
  
  INSERT INTO caseassignmentactor (
  caseassignmentid,intakeservicerequestactorid,activeflag,insertedby, updatedby,insertedon, updatedon)
  Values(v_caseassignmentid,(l_child ->>'intakeservicerequestactorid')::uuid,1,fromuserid,fromuserid,now(),now());
  
  END LOOP;
  
  IF ((SELECT count(*)>0 FROM intakeservicerequest isr 
   INNER JOIN intakedastatus ids ON ids.intakenumber = isr.intakenumber AND ids.activeflag = 1
   WHERE intakeserviceid = v_objectid AND intakeserreqstatustypeid = 'eeb4dfc3-30d6-444f-bc05-11b51eefed0f') AND
   (SELECT count(*)>0 FROM caseassignment WHERE objectid = v_objectid)) THEN
   UPDATE intakeservicerequest 
   SET intakeserreqstatustypeid = '52ad4cc7-e8f8-4cbb-9e27-d86f2b817690', isrouted = true, routedon = now(),
   updatedby = fromuserid, updatedon = now()
   WHERE intakeserviceid = v_objectid;
   
   UPDATE intakeservicerequestdispositioncode 
   SET servicerequesttypeconfigiddispostionid = 'fdea9cd7-296a-447a-9d03-623c0b2d7d7d', updatedby = fromuserid, updatedon = now()
   WHERE intakeserviceid = v_objectid;
  END IF;                                                                                                                                                                                                                                                             
                 
  statuscode:= 200;
     status_description := 'Case Assigned Successfully';
         
 RETURN  QUERY 
 
  SELECT statuscode,status_description;
 
 END;
 
 $function$

