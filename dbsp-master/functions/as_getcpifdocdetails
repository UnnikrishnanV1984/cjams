CREATE OR REPLACE FUNCTION as_getcpifdocdetails(i_intakenumber character varying, i_intakeserviceid uuid, i_secid character varying)
 RETURNS TABLE(youthname character varying, youthnamewithsuffix character varying, youthid character varying, youthssn character varying, dateofbirth character varying, provider_name character varying, youthaddress character varying, youthcity character varying, youthstate character varying, zipcode character varying, phonenumber character varying, officeworkername character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                   

BEGIN         
  
         RETURN QUERY                                                                                                                                                                                                                                                                                                                                      
           (select   
             cast(p.firstname || ' ' || p.lastname as character varying)as youthname,
                cast((case when length(p.suffix)= 0 or p.suffix is null then p.lastname||', '||p.firstname else p.lastname||' '||p.suffix||', '||p.firstname end) as character varying)as youthnamewithsuffix,
                cast (p.cjamspid as character varying)as youthid, 
                cast(p.ssnno as character varying) as youthssn,
    cast(to_char(p.dob,'MM/DD/YYYY') as character varying) as dateofbirth,          
     cast(pr.providername as character varying) as provider_name,                                                                                                                                                                                                                                                                               
    cast(pa.address||' '||pa.address2 as character varying) as youthaddress,
    cast(pa.city as character varying) as city,
    cast(pa.state as character varying) as state,
    cast(pa.zipcode as character varying) as zipcode,
    cast(ph.phonenumber as character varying) as phonenumber,
    (select distinct cast(concat(lastname,',',' ',firstname) as character varying) from userprofile up where securityusersid = i_secid) as officeworkername
   from                                                                                                                                                                                                                                                                                                                                               
   intakedastaging idas 
   left join intakeservicerequest isr on isr.intakenumber = idas.intakenumber and isr.activeflag = 1 
   left join person p on idas.focuspersonid=p.personid and p.activeflag=1  
   left join personaddress pa on pa.personid = p.personid and pa.activeflag = 1
   left join personphonenumber ph on ph.personid = p.personid and ph.activeflag=1
   left join placement pl on (idas.intakenumber =pl.intakenumber or isr.intakeserviceid = pl.intakeserviceid) and pl.activeflag=1                                                                                                                                                                                                                                                                                                                                                                                                                                      
   left join provider pr ON pl.providerid = pr.providerid AND pr.activeflag=1                                                                                                                                                                                                                                                                
   where 
   ((case when i_intakenumber is not null then idas.intakenumber=i_intakenumber else true end) 
   or  
   (case when i_intakeserviceid is not null then isr.intakeserviceid=i_intakeserviceid else true end) )and idas.activeflag = 1
    limit 1) ;                                                                                                                                                                                                                                                                                                       
    end;                                                                                                                                                                                                                                                                                                                                                   
  $function$

