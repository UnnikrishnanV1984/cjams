CREATE OR REPLACE FUNCTION sp_cares_outbound_interface_gen_data_15(vl_client_id integer, vl_other_id character varying, vs_transaction_type_cd character varying, vl_transaction_sequence integer, vd_transaction_ts timestamp without time zone, OUT vs_message character varying, OUT vl_output_sqlcode character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
------------------------------------------------------------------------
-- SQL Stored Procedure
-- Author: Sudhin
-- Date Created :08/01/2005
-- generates Cares Interface Outbound Data

------------------------------------------------------------------------

    DECLARE VS_RECORD_TYPE VARCHAR(2);--
        VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';--
        VL_RECORD_SEQUENCE INTEGER DEFAULT 000;--
        VS_TRANSACTION_SEQUENCE VARCHAR(5);--
        VS_RECORD_SEQUENCE VARCHAR(3);--
  VS_ADDRESS_DIR VARCHAR(3) DEFAULT '   '; --
  VS_ADDRESS_STREET VARCHAR(5) DEFAULT '     '; --
  VS_HEALTH_HMO VARCHAR(10) DEFAULT '          '; --
           -- Client Variables
        VS_CIS_CLIENT_ID VARCHAR(10);      --  CARES_OUT_COL6
        CARES_OUT_MED_COL1 VARCHAR(20);--
        CARES_OUT_MED_COL2 VARCHAR(20);--
        CARES_OUT_MED_COL3 VARCHAR(5);--
        CARES_OUT_MED_COL4 INTEGER;--
        CARES_OUT_MED_COL5 INTEGER;--
        CARES_OUT_MED_COL6 CHAR(3);--
        CARES_OUT_MED_COL7 VARCHAR(9); -- INTEGER
        CARES_OUT_MED_COL8 VARCHAR(50);--
        CARES_OUT_MED_COL9 CHAR(5);--
        CARES_OUT_MED_COL10 CHAR(3);--
        CARES_OUT_MED_COL11 CHAR(5);--
        CARES_OUT_MED_COL12 VARCHAR(50);--
        CARES_OUT_MED_COL13 CHAR(2);--
        CARES_OUT_MED_COL14 INTEGER;--
        CARES_OUT_MED_COL15 VARCHAR(10);--
        CARES_OUT_MED_COL16 VARCHAR(20);--
        CARES_OUT_MED_COL17 CHAR(3);--
        CARES_OUT_MED_COL18 VARCHAR(9); -- INTEGER
        CARES_OUT_MED_COL19 VARCHAR(50);--
        CARES_OUT_MED_COL20 CHAR(5);--
        CARES_OUT_MED_COL21 CHAR(3);--
        CARES_OUT_MED_COL22 CHAR(5);--
        CARES_OUT_MED_COL23 VARCHAR(50);--
        CARES_OUT_MED_COL24 CHAR(2);--
        CARES_OUT_MED_COL25 INTEGER;--
        CARES_OUT_MED_COL26 VARCHAR(10);--
        CARES_OUT_MED_COL27 CHAR(1);--

    DECLARE CURSOR_MED CURSOR FOR
        SELECT personhealthinsurance.policyname,
               personhealthinsurance.groupnumber,
               personhealthinsurance.patientpolicyholderrelation,
      to_char(personhealthinsurance.effectivedate,'yyyymmdd')::integer,
      to_char(personhealthinsurance.expirationdate,'yyyymmdd')::integer, 
        VS_ADDRESS_DIR,
        SUBSTRING(personhealthinsurance.address1,'(^[0-9]+)'), -- personhealthinsurance.ADR_STREET_NO
        TRIM(SUBSTRING(personhealthinsurance.address1,'([[:alpha:]\\s]+)')),
        VS_ADDRESS_STREET,
        VS_ADDRESS_DIR,
        personhealthinsurance.address2,
        personhealthinsurance.city,
        personhealthinsurance.state,
        SUBSTRING(COALESCE(personhealthinsurance.zip :: VARCHAR,'00000'),1,5),
               personhealthinsurance.providerphone,
               VS_HEALTH_HMO,
        VS_ADDRESS_DIR,
        SUBSTRING(personhealthinsurance.address1,'(^[0-9]+)'), -- personhealthinsurance.PADR_STREET_NO
        TRIM(SUBSTRING(personhealthinsurance.address1,'([[:alpha:]\\s]+)')),
        VS_ADDRESS_STREET,
        VS_ADDRESS_DIR,
        personhealthinsurance.address2,
        personhealthinsurance.city,
               personhealthinsurance.state,
               SUBSTRING(COALESCE(personhealthinsurance.zip :: VARCHAR,'00000'),1,5),
               (personhealthinsurance.providerphone),
               CASE WHEN personhealthinsurance.personid = person.personid THEN 'Y'
                       ELSE 'N'
               END
        FROM    personhealthinsurance, person
        WHERE   personhealthinsurance.personid = person.personid
  AND     person.cjamspid = VL_CLIENT_ID
      --  AND     personhealthinsurance.caresauno IS NULL
        AND     personhealthinsurance.activeflag  = 1 
  AND person.activeflag = 1 ;

     
BEGIN
  
  VL_OUTPUT_SQLCODE:='00000';  
    -- SET transaction sequence
     VS_TRANSACTION_SEQUENCE = LTRIM(RTRIM(VL_TRANSACTION_SEQUENCE::VARCHAR)) ;--

    -- Get CIS_CLIENT_ID

   BEGIN
    SELECT  person.cisclientid
   INTO    VS_CIS_CLIENT_ID
    FROM    person   
    WHERE   person.cjamspid = VL_CLIENT_ID
    AND     person.activeflag  = 1;  
 
   EXCEPTION WHEN OTHERS THEN 
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
    VS_MESSAGE :=  'SELECT CIS_CLIENT_ID FAILED FOR TB_CLIENT'||SQLERRM  ;--
       RETURN;
    END ;--

    -- Generate records for record type 15
  
     VS_RECORD_TYPE := '15';--
  
     VL_RECORD_SEQUENCE := 000 ;--

     VS_RECORD_SEQUENCE := '';--

    IF  VS_RECORD_TYPE = '15' THEN

       OPEN CURSOR_MED;--
       <<CURS_MED>>
       WHILE VL_OUTPUT_SQLCODE = '00000'  LOOP
             FETCH CURSOR_MED INTO CARES_OUT_MED_COL1, CARES_OUT_MED_COL2, CARES_OUT_MED_COL3, CARES_OUT_MED_COL4,
                                CARES_OUT_MED_COL5, CARES_OUT_MED_COL6, CARES_OUT_MED_COL7, CARES_OUT_MED_COL8,
                                CARES_OUT_MED_COL9, CARES_OUT_MED_COL10, CARES_OUT_MED_COL11, CARES_OUT_MED_COL12,
                                CARES_OUT_MED_COL13, CARES_OUT_MED_COL14, CARES_OUT_MED_COL15, CARES_OUT_MED_COL16,
                                CARES_OUT_MED_COL17, CARES_OUT_MED_COL18, CARES_OUT_MED_COL19, CARES_OUT_MED_COL20,
                                CARES_OUT_MED_COL21, CARES_OUT_MED_COL22, CARES_OUT_MED_COL23, CARES_OUT_MED_COL24,
                                CARES_OUT_MED_COL25, CARES_OUT_MED_COL26, CARES_OUT_MED_COL27   ;--

           EXIT CURS_MED WHEN NOT FOUND;--
           

       VL_RECORD_SEQUENCE := VL_RECORD_SEQUENCE + 1 ;--
 
      VS_RECORD_SEQUENCE := LTRIM(RTRIM(VL_RECORD_SEQUENCE::VARCHAR));--
 
      -- Set Interface Data
      INSERT INTO TB_CARES_OUTBOUND_INTERFACE
         (CARES_RECORD_ID,
          STATUS_CD,
          BATCH_SEQ_NO,
          TRANSACTION_SEQ_NO,
   TRANSACTION_TYPE_CD,
       CIS_CLIENT_ID,
   RECORD_TYPE_CD,
   TRANSACTION_TS,
          RECORD_SEQ_NO,
   CARES_OUT_COL1,
   CARES_OUT_COL2,
   CARES_OUT_COL3,
   CARES_OUT_COL4,
   CARES_OUT_COL5,
   CARES_OUT_COL6,
   CARES_OUT_COL7,
   CARES_OUT_COL8,
   CARES_OUT_COL9,
   CARES_OUT_COL10,
   CARES_OUT_COL11,
   CARES_OUT_COL12,
   CARES_OUT_COL13,
   CARES_OUT_COL14,
   CARES_OUT_COL15,
   CARES_OUT_COL16,
   CARES_OUT_COL17,
   CARES_OUT_COL18,
   CARES_OUT_COL19,
   CARES_OUT_COL20,
   CARES_OUT_COL21,
   CARES_OUT_COL22,
   CARES_OUT_COL23,
   CARES_OUT_COL24,
   CARES_OUT_COL25,
   CARES_OUT_COL26,
   CARES_OUT_COL27
   )
      SELECT
  NEXTVAL('SQ_CARES_OUTBOUND_INTERFACE'),
  '000',
  '',
  CASE WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 1 THEN '0000'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 2 THEN '000'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 3 THEN '00'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 4 THEN '0'||VS_TRANSACTION_SEQUENCE
       WHEN LENGTH(VS_TRANSACTION_SEQUENCE) = 5 THEN VS_TRANSACTION_SEQUENCE
       END,
  VS_TRANSACTION_TYPE_CD,
  COALESCE(SUBSTRINGING('000000000',1,9 - LENGTH(LTRIM(RTRIM(VS_CIS_CLIENT_ID)))) || LTRIM(RTRIM(VS_CIS_CLIENT_ID)),'000000000'),
  '15',
  VD_TRANSACTION_TS,
  CASE WHEN LENGTH(VS_RECORD_SEQUENCE) = 1 THEN '00'||VS_RECORD_SEQUENCE
       WHEN LENGTH(VS_RECORD_SEQUENCE) = 2 THEN '0'||VS_RECORD_SEQUENCE
       WHEN LENGTH(VS_RECORD_SEQUENCE) = 3 THEN VS_RECORD_SEQUENCE
       END,
  COALESCE(SUBSTRINGING('00000000000000000000',1,20 - LENGTH(LTRIM(RTRIM(CARES_OUT_MED_COL1)))) || LTRIM(RTRIM(CARES_OUT_MED_COL1)),'00000000000000000000'),
  COALESCE(SUBSTRINGING('00000000000000000000',1,20 - LENGTH(LTRIM(RTRIM(CARES_OUT_MED_COL2)))) || LTRIM(RTRIM(CARES_OUT_MED_COL2)),'00000000000000000000'),
  CARES_OUT_MED_COL3,
  COALESCE(CARES_OUT_MED_COL4 :: VARCHAR,'00000000'),
  COALESCE(CARES_OUT_MED_COL5 :: VARCHAR,'00000000'),
  CARES_OUT_MED_COL6,
  CARES_OUT_MED_COL7,
  CARES_OUT_MED_COL8,
  CARES_OUT_MED_COL9,
  CARES_OUT_MED_COL10,
  CARES_OUT_MED_COL11,
  CARES_OUT_MED_COL12,
  CARES_OUT_MED_COL13,
                CASE WHEN CARES_OUT_MED_COL14 = 0 THEN '000000000'
                     WHEN CARES_OUT_MED_COL14 IS NULL THEN '000000000'
                     ELSE SUBSTRINGING('000000000',1,9 - LENGTH(LTRIM(RTRIM(CARES_OUT_MED_COL14 :: VARCHAR)))) || LTRIM(RTRIM(CARES_OUT_MED_COL14:: VARCHAR))
                END,   
  COALESCE(CARES_OUT_MED_COL15 :: VARCHAR,'0000000000'),
  CARES_OUT_MED_COL16,
  CARES_OUT_MED_COL17,
  CARES_OUT_MED_COL18,
  CARES_OUT_MED_COL19,
  CARES_OUT_MED_COL20,
  CARES_OUT_MED_COL21,
  CARES_OUT_MED_COL22,
  CARES_OUT_MED_COL23,
  CARES_OUT_MED_COL24,
                CASE WHEN CARES_OUT_MED_COL25 = 0 THEN '000000000'
                     WHEN CARES_OUT_MED_COL25 IS NULL THEN '000000000'
                     ELSE SUBSTRINGING('000000000',1,9 - LENGTH(LTRIM(RTRIM(CARES_OUT_MED_COL25 :: VARCHAR)))) || LTRIM(RTRIM(CARES_OUT_MED_COL25 :: VARCHAR))
                END,   
  COALESCE(CARES_OUT_MED_COL26 :: VARCHAR,'0000000000'),
  CARES_OUT_MED_COL27 ; -- 
 
 
 
        END LOOP;--
        CLOSE CURSOR_MED;--

 
    END IF;  --

    RETURN ;--
    EXCEPTION WHEN OTHERS THEN 
      VL_OUTPUT_SQLCODE  :=  SQLSTATE;--
    VS_MESSAGE :='INSERT INTO TB_CARES_OUTBOUND_INTERFACE FAILED' ||SQLERRM ;--
     RETURN;
 
END 
;
$function$

