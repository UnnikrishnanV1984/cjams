CREATE OR REPLACE FUNCTION prov_getsanctionslist(v_provider_id integer, pagenumber integer, pagesize integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
v_sanctiondata json;
v_pageoffset int;                                                                                                                                                                                                                                                                                                                                                            
v_pagenumber int;      

BEGIN  
     v_pagenumber := pagenumber-1;                                                                                                                                                                                                                                                                                                                                                     
     v_pageoffset = v_pagenumber * pagesize;     

select  jsonb_agg(x) as sanctiondata into v_sanctiondata from
(select * from tb_provider_sanctions where  provider_id =  v_provider_id
LIMIT pagesize OFFSET v_pageoffset)x;

return v_sanctiondata;
END;
$function$

