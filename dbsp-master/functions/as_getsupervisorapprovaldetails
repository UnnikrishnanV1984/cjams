CREATE OR REPLACE FUNCTION as_getsupervisorapprovaldetails(intakenumber character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
 

DECLARE
    
    v_intakenumber character varying;
    v_result json;
         
BEGIN
    
    v_intakenumber := intakenumber;
 


 SELECT json_agg(pe) into v_result FROM 
  (
     select 
           (select rs.typedescription from routingstatustype rs where rs.sequencenumber = r.routingstatustypeid ) as status,
           (select fullname from userprofile u where u.securityusersid = r.tosecurityusersid) as name,
           (case when r.toroleid = 'CWSP' then 'Supervisor' when r.toroleid = 'CWCW' then 'Case Worker' end) as role,
           r.objectid as intakenumber,
           (SELECT TO_CHAR(((r.insertedon) :: date),'MM-DD-YYYY')) as date
           from routing r 
           where r.fromroleid in ('CWIW','CWSP') and r.toroleid in ('CWSP','CWCW') and r.objectid =  v_intakenumber and r.activeflag = 1 order by r.insertedon

   
  ) pe; 
  
 
    return v_result;

END;

 
$function$

