CREATE OR REPLACE FUNCTION prov_getroutinginfo(v_objectid character varying, v_eventcode character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE  
v_data json;

BEGIN 


select array_to_json(array_agg(row_to_json(t)))
from (
select r.objectid, u.displayname as assignedto, u1.displayname as assignedfrom, r2.typedescription as routingstatus, r.remarks, r.insertedon create_dt, r.updatedon update_dt  from routing r join userprofile u on r.tosecurityusersid = u.securityusersid and r.activeflag =1 
join userprofile u1 on r.fromsecurityusersid = u1.securityusersid and r.activeflag =1 
join routingstatustype r2 on r2.sequencenumber = r.routingstatustypeid 
where r.objectid = v_objectid and r.eventcode = v_eventcode and r.activeflag =1
) t into v_data;

return v_data;
END;

$function$

