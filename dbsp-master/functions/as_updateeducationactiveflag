CREATE OR REPLACE FUNCTION as_updateeducationactiveflag(v_iepspecialeducationid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

BEGIN

   UPDATE iepeducationalservices SET activeflag = 0 WHERE iepspecialeducationid = v_iepspecialeducationid;
   UPDATE iepdisabilitycode SET activeflag = 0 WHERE iepspecialeducationid = v_iepspecialeducationid;
      RETURN 'Success';
  
END

$function$

