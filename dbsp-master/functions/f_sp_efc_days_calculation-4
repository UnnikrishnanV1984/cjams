CREATE OR REPLACE FUNCTION f_sp_efc_days_calculation(as_rate_flag character, al_placement_structure_id bigint, ad_placement_start_dt timestamp without time zone, ad_placement_end_dt timestamp without time zone, ad_payment_start_dt timestamp without time zone, ad_payment_end_dt timestamp without time zone, al_days_for_calc integer, OUT ad_efc_service_st_dt timestamp without time zone, OUT ad_efc_service_end_dt timestamp without time zone, OUT al_efc_unit_no integer, OUT as_efc_unit_type character varying, OUT ad_rfc_service_st_dt timestamp without time zone, OUT ad_rfc_service_end_dt timestamp without time zone, OUT al_rfc_unit_no integer, OUT as_rfc_unit_type character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$

DECLARE  
 DECLARE vd_previous_month_start_dt DATE;
 DECLARE vd_previous_month_end_dt DATE;
 DECLARE ad_service_start_dt DATE;
 DECLARE ad_service_end_dt DATE;
 DECLARE vl_no_of_nights INT;
 DECLARE al_unit_no INT;
 DECLARE vl_total_paid_period BIGINT;
 DECLARE vl_service_days BIGINT;
 DECLARE vl_calc_days BIGINT;
 DECLARE as_unit_type VARCHAR(5);
BEGIN

 vd_previous_month_start_dt := ad_payment_start_dt;
 vd_previous_month_end_dt := ad_payment_end_dt;

CASE as_rate_flag
    WHEN 'R' THEN  -- Room and Board
     -- New condition to calculate  # of days - CIS-19002 
        IF ad_payment_end_dt <= DATE('2009-08-31') AND
           (ad_placement_start_dt <= vd_previous_month_start_dt) AND
           ((ad_placement_end_dt >= vd_previous_month_end_dt) OR (ad_placement_end_dt IS NULL)) THEN
                 al_unit_no := 1;
                 as_unit_type := '5611'; -- need to check unit type month 5610 nightly
                 ad_service_start_dt := vd_previous_month_start_dt;
                 ad_service_end_dt := vd_previous_month_end_dt;
        ELSE    -- calculate numbers of night
            IF ad_placement_end_dt IS NULL OR ad_placement_end_dt >= vd_previous_month_end_dt THEN
                 ad_service_end_dt :=  vd_previous_month_end_dt;--
            ELSE
                 ad_service_end_dt := ad_placement_end_dt;--
            END IF;

             IF ad_placement_start_dt <= vd_previous_month_start_dt THEN  --child is staying in this placment before the previous month
                 ad_service_start_dt :=  vd_previous_month_start_dt;--
            ELSE
                 ad_service_start_dt := ad_placement_start_dt;
            END IF;

            -- calculating the numbers of night
            -- New condition to calculate  # of days - CIS-19002
            IF ad_payment_end_dt <= DATE('2009-08-31') AND
                 ad_service_start_dt = vd_previous_month_start_dt
                    AND ad_service_end_dt = vd_previous_month_end_dt THEN  -- CLIENT REMAINS IN THE PLACEMENT FOR WHOLE MONTH
                 al_unit_no := 1;
                 as_unit_type := '5611'; --MONTHLY
            ELSE
   
                 vl_no_of_nights := date_part('DAY',ad_service_end_dt) - date_part('DAY',ad_service_start_dt);--
                 al_unit_no := vl_no_of_nights;
                IF ad_service_start_dt = vd_previous_month_end_dt AND (ad_placement_end_dt IS NULL
                                                                OR ad_placement_end_dt > vd_previous_month_end_dt) THEN
                    al_unit_no := 1;
  -- 09/30/2008 # 18609
                ELSEIF ad_service_end_dt = vd_previous_month_end_dt and (ad_service_end_dt <> ad_placement_end_dt or ad_placement_end_dt is null) THEN
        al_unit_no := al_unit_no + 1;
  -- 09/30/2008 # 18609
                END IF;

                 as_unit_type := '5610'; --nightly
            END IF;
        END IF;

         vl_total_paid_period := 0;
         vl_service_days := 0;

        /*SELECT DAYS(ad_payment_start_dt) - DAYS(ad_placement_start_dt),
            DAYS(ad_service_end_dt) - DAYS(ad_service_start_dt)
      INTO vl_total_paid_period,
        vl_service_days;*/
      -- FROM SYSIBM.SYSDUMMY1 ; 
 /*SELECT (TO_DATE(ad_payment_start_dt, 'YYYY-MM-DD') - TO_DATE(ad_placement_start_dt, 'YYYY-MM-DD')),
            (TO_DATE(ad_service_end_dt, 'YYYY-MM-DD') - TO_DATE(ad_service_start_dt, 'YYYY-MM-DD'))
      INTO vl_total_paid_period,
        vl_service_days;*/
     SELECT (ad_payment_start_dt::DATE - ad_placement_start_dt::DATE),
            (ad_service_end_dt::DATE - ad_service_start_dt::DATE)
      INTO vl_total_paid_period,
        vl_service_days;
  
IF vl_total_paid_period > al_days_for_calc THEN
 -- NO EFC 
  ad_efc_service_st_dt := NULL;
  ad_efc_service_end_dt := NULL;
  al_efc_unit_no := NULL;
  as_efc_unit_type := NULL;

 -- Entire RFC
  ad_rfc_service_st_dt := ad_service_start_dt;
  ad_rfc_service_end_dt := ad_service_end_dt;
  al_rfc_unit_no := al_unit_no;
  as_rfc_unit_type := as_unit_type;
ELSE
 -- Part EFC
 IF vl_total_paid_period <= al_days_for_calc AND (al_days_for_calc - vl_total_paid_period) >= vl_service_days THEN
  -- Entire EFC
   ad_efc_service_st_dt := ad_service_start_dt;
   ad_efc_service_end_dt := ad_service_end_dt;
   al_efc_unit_no := al_unit_no;
   as_efc_unit_type := as_unit_type;
        ELSE
   as_efc_unit_type := '5610';
   al_efc_unit_no := al_days_for_calc - vl_total_paid_period;
   ad_efc_service_st_dt := ad_service_start_dt;
   ad_efc_service_end_dt := ad_service_start_dt +  (al_days_for_calc - vl_total_paid_period)::int days;

  -- Part RFC
  IF vl_service_days - (al_days_for_calc - vl_total_paid_period) > 0 THEN
    as_rfc_unit_type := '5610';--
    al_rfc_unit_no := vl_service_days - (al_days_for_calc - vl_total_paid_period) ;
    ad_rfc_service_st_dt := ad_service_start_dt +  ( al_days_for_calc - vl_total_paid_period )::int days;
    ad_rfc_service_end_dt := ad_service_end_dt;
   
   IF ad_rfc_service_end_dt = vd_previous_month_end_dt and (ad_rfc_service_end_dt <> ad_placement_end_dt or ad_placement_end_dt is null) THEN
       al_rfc_unit_no := al_rfc_unit_no  + 1;
                 END IF;
  ELSE
    as_rfc_unit_type := NULL;
    al_rfc_unit_no := NULL ;
    ad_rfc_service_st_dt := NULL ;
    ad_rfc_service_end_dt := NULL;     
       END IF;
 END IF;
END IF;

IF al_efc_unit_no is NULL or al_efc_unit_no = 0 THEN
    ad_efc_service_st_dt := NULL;
    ad_efc_service_end_dt := NULL;
    as_efc_unit_type := NULL;

   IF al_rfc_unit_no is NOT NULL AND al_rfc_unit_no > 1 THEN 
      IF ad_rfc_service_st_dt = ad_payment_start_dt AND ad_rfc_service_end_dt = ad_payment_end_dt THEN
         -- New condition to calculate  # of days - CIS-19002 
         IF ad_payment_end_dt <= DATE('2009-08-31') THEN
             al_rfc_unit_no = 1;
             as_rfc_unit_type = '5611';
         END IF;
      END IF;
   END IF;
END IF;

IF al_rfc_unit_no is NULL or al_rfc_unit_no = 0 THEN
    as_rfc_unit_type := NULL;
    ad_rfc_service_st_dt := NULL ;
    ad_rfc_service_end_dt := NULL;
 
   IF al_efc_unit_no is NOT NULL AND al_efc_unit_no > 1 THEN 
      IF ad_efc_service_st_dt = ad_payment_start_dt AND ad_efc_service_end_dt = ad_payment_end_dt THEN
         -- New condition to calculate  # of days - CIS-19002  
         IF ad_payment_end_dt <= DATE('2009-08-31') THEN
             al_efc_unit_no := 1;
             as_efc_unit_type := '5611';
         END IF;
      END IF;
   END IF;
END IF;

END CASE;
END;

$function$

