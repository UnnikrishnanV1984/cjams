CREATE OR REPLACE FUNCTION as_f_sname(ai_staff_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

BEGIN
 return
 (select
               coalesce(firstname ,'')||' '||
               coalesce(middlename,'')||' '||
               coalesce(lastname,'')||' '||
    --           coalesce(F_PDESC(userprofile.SUFFIX_CD, 214),'')  -- suffix_cd column missing
               from userprofile where securityuserid = ai_staff_id
);
END;

$function$

