CREATE OR REPLACE FUNCTION as_fn_department_upd()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN

 if old.countyid <> new.countyid  then 

 INSERT INTO  caresoutboundtrigger (  
                            old_id,
                           transactionon,
                           transactiontypekey,
                           statusflag,
             activeflag)
     select   
        servicecase.servicecasenumber,
                       CURRENT_TIMESTAMP,
                        '64',
                        'N',
          1
       from intakeservicerequest , servicecase
    where intakeservicerequest.servicecaseid = servicecase.servicecaseid;--
  end if;

END;

$function$

