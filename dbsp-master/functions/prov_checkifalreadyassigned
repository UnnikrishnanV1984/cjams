CREATE OR REPLACE FUNCTION prov_checkifalreadyassigned(trgorientation json)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
DECLARE
 v_exists  character varying;
begin
 v_exists=0;
select count(1) over() into v_exists
 from providerorientationtrainingattendance pota
    left join providerorientationtraining pot on pota.training_number= pot.training_number
    where (pota.delete_sw='N' or pota.delete_sw is null)
    and  pota.training_number=(trgorientation->>'training_number')
    and pot.training_type=(trgorientation->>'training_type')
    and pot.training_date=(trgorientation->>'training_date')
    and pota.personid=(trgorientation->>'personid')
    and pota.personrole=(trgorientation->>'personrole');
    if (v_exists is null) then
     v_exists:=0;
   end if;
    return v_exists;
END;

$function$

