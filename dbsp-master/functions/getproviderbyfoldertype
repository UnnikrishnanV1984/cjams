CREATE OR REPLACE FUNCTION getproviderbyfoldertype(i_foldertype character varying)
 RETURNS TABLE(providername character varying, providerid uuid, providercode character varying, admissionclassification character varying, admissiontype character varying, isprovidertyperesidential boolean, isoperatedbydjs boolean, provideraddress json, providerphoneemail json)
 LANGUAGE plpgsql
AS $function$


DECLARE
 i_evaluationconfigcount bigint;
 v_intakeservicerequestevaluationconfigid uuid;
 closecount bigint;
begin
 
 return query 
 select PO.providername,PO.providerid,PO.providercode,PAC.description as admissionclassification,PAT.description as admissiontype,FT.isprovidertyperesidential 
, PO.isoperatedbydjs
,(select json_agg(x) from (select PA.addressline1,PA.addressline2,PA.city,PA.state ,PA.buildingno
from provideraddress PA where PA.providerid=PO.providerid and PA.activeflag=1) as x ) as provideraddress,
(select json_agg(x) from (select PC.phonenumber,PC.phoneextension,PC.email from providercontactinfo PC 
where PC.providerid = PO.providerid and PC.activeflag=1 )as x ) as providerphoneemail 
from  foldertype FT
join foldertypeproviderconfig FPC on FT.foldertypekey=FPC.foldertypekey and FT.activeflag=1 
join  provider PO on FPC.providerid=PO.providerid and FPC.activeflag=1
left join placementadmissionclassification PAC on PAC.placementadmissionclassificationkey=PO.placementadmissionclassificationkey and PAC.activeflag=1
left join placementadmissiontype PAT on PAT.placementadmissiontypekey=PO.placementadmissiontypekey and PAT.activeflag=1
where FT.foldertypekey=I_foldertype;

END;

$function$

