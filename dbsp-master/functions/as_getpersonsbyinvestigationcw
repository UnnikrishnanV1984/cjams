CREATE OR REPLACE FUNCTION as_getpersonsbyinvestigationcw(_page integer, _limit integer, v_intakeserviceid uuid DEFAULT NULL::uuid, v_intakenumber character varying DEFAULT NULL::character varying, v_servicerequestnumber character varying DEFAULT NULL::character varying)
 RETURNS TABLE(totalcount bigint, rolename character varying, dcn character varying, personid uuid, fullname character varying, firstname character varying, lastname character varying, suffix character varying, gender character varying, dob timestamp without time zone, age character varying, incidentage character varying, timereceived timestamp with time zone, dateofdeath timestamp without time zone, isapproxdod integer, residencetype character varying, address character varying, address2 character varying, state character varying, city character varying, zipcode character varying, county character varying, nameoffacility character varying, durationday character varying, comments character varying, height character varying, weight character varying, haircolortypekey character varying, hairtexturetypekey character varying, eyecolortypekey character varying, physicalbuildtypekey character varying, skintonetypekey character varying, hairtextureotherdesc character varying, haircolorotherdesc character varying, isglasses boolean, employername character varying, clienttitle character varying, race json, phonenumber character varying, dangerous text, actorid uuid, intakeservicerequestactorid uuid, isalleged integer, priorscount bigint, reported boolean, refusessn boolean, refusedob boolean, userphoto text, primarylanguageid character varying, primarylanguage character varying, secondarylanguageid character varying, secondarylanguage character varying, otherprimarylanguagetypekey character varying, otherreligion character varying, email character varying, roles json, relationship character varying, relationshiparray json, relationshipdescription character varying, ishousehold integer, iscollateralcontact integer, schoolname json, ssn character varying, assistpid character varying, cjamspid bigint, cisclientid character varying, strengths character varying, needs character varying, hospitalization json, medicalinformation json, medicationinformation json, addendum json, medicalcondition json, allergies json, appointmentdates json, personmilitaryservices json, emergency json, guardianinfo json, guardianpropertyinfo json, guardianattornyinfo json, guardianworkerinfo json, guardiafuneralinfo json, guardiacodeinfo json, personpayeeinfo json, ethinicity character varying, religion character varying, maritalstatus character varying, racetypekey character varying, fetalalcoholspctrmdisordflag integer, drugexposednewbornflag integer, probationsearchconductedflag integer, sexoffenderregisteredflag integer, citizenalenageflag integer, isqualifiedalien integer, alienregistrationtext character varying, verificationremarks character varying, alienstatustypekey character varying, issafe integer, programarea json)
 LANGUAGE plpgsql
AS $function$

 declare 
_offset integer;
jsondatas json;
narativeval json;
obj json;
incidentdate timestamp without time zone;
incidentdateval character varying;
v_tempintake character varying;
v_refintakeserviceid uuid;

v_tempintakeserviceid uuid; -- added 12/13/2020 Saranyan for conversion fix
begin

 -- added  below sql 12/13/2020 Saranyan for conversion fix
select distinct intakeserviceid into v_tempintakeserviceid 
from intakeservicerequest where servicerequestnumber = v_servicerequestnumber;

select distinct intakenumber into v_tempintake from intakeservicerequest where intakeserviceid = v_intakeserviceid;

select fromintakeservicerequestid into v_refintakeserviceid from intakeservicerequestcrossreference 
 where withintakeservicerequestid  = v_intakeserviceid ;


/*Get adoption case person*/
IF EXISTS (SELECT * FROM adoptioncase WHERE adoptioncaseid=v_intakeserviceid) THEN
RETURN QUERY 
 SELECT * FROM as_getadoptionperson(_page,_limit,v_intakeserviceid);
END IF;

_offset := (_page - 1) * _limit;

For    jsondatas    in    SELECT   idas.jsondata::json    FROM    intakedastaging idas where 
 idas.intakenumber =coalesce(v_intakenumber, (select inss.intakenumber from intakeservicerequest inss where inss.intakeserviceid = v_intakeserviceid)) and idas.activeflag =1
LOOP 
    obj := jsondatas->>'narrative';
   
    For   narativeval    in    SELECT * from   json_array_elements(obj) 
LOOP 
raise notice 'teslsldst %' ,incidentdate;
incidentdateval := narativeval->>'incidentdate';
if(incidentdateval != '' )
then
raise notice 'qqqqqqqqqqqqqqqqqqqq %' ,incidentdate;
 incidentdate := incidentdateval ::timestamp without time zone; 
else 
incidentdate := null;
raise notice 'else %' ,incidentdate;
end if;
END  loop ;
END  loop ;

raise notice 'test %',incidentdate;

return QUERY 

