   inner join referencevalues at on 
   at.ref_key = isrpn.intakeservicerequestpersontypekey
    where
    isrpn.actorid = ac.actorid
    and (isrpn.intakeserviceid = v_intakeserviceid  OR isrpn.intakenumber =v_intakenumber  )
    and isrpn.activeflag = 1
        and at.referencetypeid in (175,176,358) -- newly added by venky
        and at.teamtypekey  = 'AS'  
    
   group by
    isrpn.intakeservicerequestpersontypekey,
    isrpn.intakeservicerequestactorid,
    --at.typedescription 
    at.value_text 
   ) as e ) ::json,
  (
