 where --ina.intakeserviceid =  irs.intakeserviceid -- 12/13/2020
  ina.intakeserviceid =v_intakeserviceid OR ina.intakeserviceid =v_tempintakeserviceid       
  )
 ) x
) :: json as relationshiparray,

  
  (
  select
   rt.description
  from
   relationshiptype rt
  inner join actorrelationship ar on
   rt.relationshiptypekey = ar.relationshiptypekey
   and ar.activeflag = 1
   and rt.activeflag = 1
  where
   ar.intakeservicerequestactorid = max( iar.INTAKESERVICEREQUESTACTORID:: character varying) :: uuid
  group by
   rt.description
  limit 1 ) as relationshipdescription,
  PR.ishouseholdmember as ishousehold,
  COALESCE (pr.iscollateralcontact,0) as iscollateralcontact,
  (
  select
