  p.skintonetypekey,
  p.hairtextureotherdesc,
      p.haircolorotherdesc,
      p.isglasses,
      p.employername,
      p.clienttitle,
    (select reporterincidentdate from intakeservicerequest 
  where (intakenumber= v_intakenumber or intakeserviceid=v_intakeserviceid
