    inner join actor act on
     act.actorid = isra.actorid
     and act.activeflag = 1
    inner join person per on
     per.personid = act.personid
     and per.activeflag = 1
    inner join personhospitalization as ph on
     ph.personid = per.personid
     and ph.activeflag = 1
    where
    (isra.intakeserviceid = v_intakeserviceid OR isra.intakenumber =v_intakenumber )
    and ac.actorid = act.actorid ) as e ) ::json,
  (
  select
