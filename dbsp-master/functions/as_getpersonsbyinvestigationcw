 (CASE WHEN EXTRACT(YEAR FROM age(coalesce(incidentdate,"Person".timerecieved,"Person".reporterincidentdate,null) , "Person".dob)) <= 0 THEN 
   CASE WHEN EXTRACT(MONTH FROM age(coalesce(incidentdate,"Person".timerecieved,"Person".reporterincidentdate,null), "Person".dob)) <= 0 THEN 
