CREATE OR REPLACE FUNCTION prov_provfirrouting(v_objectid character varying, v_securityuserid character varying, v_appeventcode character varying, v_status integer, commenttext text, v_notifymsg character varying DEFAULT ''::character varying, v_routeddescription character varying DEFAULT ''::character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare
v_agency character varying;
v_tosecurityusersid character varying;
v_servicerequestno character varying;
v_firno character varying;
v_site_id character varying;
v_fromroleid character varying;
v_toroleid character varying;  
v_msg character varying;
v_username character varying;
v_date timestamp without time zone;
v_alertstatus character varying;
prov_securityusersid character varying;
worker_securityusersid character varying;
v_provroleid character varying;
v_workerroleid character varying;

BEGIN
v_date = now();
raise notice 'test%','11111';
select r.roletypekey into  v_fromroleid from team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
where  mu.securityusersid = v_securityuserid;
raise notice 'test%','12222';

raise notice 'test%','1333';
select site_id into v_site_id from provider_fir where provider_fir_id = v_objectid::uuid;

select agency into v_agency  from tb_provider tp where provider_id in (select provider_id from provider_fir where provider_fir_id = v_objectid::uuid);

 



  
 /* if (v_agency = 'OLM')then
  select mu.securityusersid ,tm.roletypekey into v_tosecurityusersid, v_toroleid from team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
  join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
  join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
  where  r.roletypekey in ('OLMPM');
  
 elseif(v_agency = 'DJS')THEN
  select mu.securityusersid,tm.roletypekey into v_tosecurityusersid, v_toroleid from team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
  join teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1 
  join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
  where  r.roletypekey in ('PVRDJSR');
 end if; */
raise notice 'test%','1444';
  --  v_tosecurityusersid := v_securityuserid;
    
 if(v_status IN (102) )then
  select distinct toworkeridno into v_tosecurityusersid from providerassignment pa where pa.objectid = v_site_id and
 pa.activeflag = 1 and (pa.enddate is null or pa.enddate::date >= now()::date) order by insertedon desc limit 1 ;
 else 
  select fromsecurityusersid , tosecurityusersid, fromroleid,toroleid into v_tosecurityusersid , worker_securityusersid, v_provroleid , v_workerroleid
  from routing
  where eventcode = 'PRFIR' and objectid = v_objectid and  routingstatustypeid = 102;
 end if; 


  /*Mark previous data as inactive and mark as rereiview*/
 UPDATE routing SET  activeflag =0  , updatedby = v_securityuserid,updatedon= v_date  WHERE objectid = v_objectid; 
raise notice 'test%','155555';
 INSERT INTO routing(
                        eventcode, fromsecurityusersid, tosecurityusersid, 
                        fromroleid, toroleid,objectid , routingstatustypeid,
                        insertedby,  updatedby,insertedon,updatedon, isreviewrequest,
      remarks,routeddescription,servicerequestnumber)
          values (v_appeventcode, v_securityuserid,v_tosecurityusersid,
                    v_fromroleid,v_toroleid,v_objectid::uuid,v_status,
                    v_securityuserid,v_securityuserid,v_date,v_date,true,
                    commenttext,v_routeddescription,v_servicerequestno);
update provider_fir set fir_status=v_status, fir_statusdesc = v_routeddescription where provider_fir_id = v_objectid::uuid and active_flag=1;
raise notice 'test%','1666';
-- Dashboard Notification 
SELECT coalesce(lastname,'')||', '|| coalesce(firstname,'')into v_username
    FROM userprofile WHERE securityusersid = v_securityuserid;
select fir_no into v_firno from provider_fir pu where provider_fir_id = v_objectid::uuid;
raise notice 'test66v_firno6%',v_firno;
v_msg:=  v_notifymsg || ' by '|| v_username ||' and FIR No: ' || v_firno ; 


IF (v_status IN (102) ) THEN
 SELECT prov_send_notification into v_alertstatus FROM prov_send_notification(v_tosecurityusersid,v_securityuserid, v_tosecurityusersid,
   'System', 'High', v_msg,v_msg , v_firno);
ELSE
 SELECT prov_send_notification into v_alertstatus FROM prov_send_notification(v_provroleid,v_securityuserid, v_provroleid,
   'System', 'High', v_msg,v_msg , v_firno,'FIR');
END IF;
RETURN 'SUCCESS';

END;
$function$

