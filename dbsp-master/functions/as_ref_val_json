CREATE OR REPLACE FUNCTION as_ref_val_json(v_input1 character varying, v_input2 character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE    
    ref_key character varying;    
 value_text character varying;  
 v_result json;
BEGIN
    
 ref_key := v_input1;   
 value_text := v_input2; 

 Select json_agg(row) as Output from (select ref_key as Key, value_text as Value from referencevalues where referencetypeid = 189) row into v_result ;
 
 RETURN v_result;

END;  

$function$

