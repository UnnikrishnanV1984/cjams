CREATE OR REPLACE FUNCTION updateapplicantlicenseinfo(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
v_securityuserid character varying;
v_applicantid character varying;
v_accomid character varying;

begin
v_securityuserid:=insertobj->>'securityuserid';
v_applicantid:=insertobj->>'applicant_id';

if length(v_applicantid)>0
then

UPDATE tb_provider_applicant
SET requested_license_effective_date=(insertobj->>'requested_license_effective_date')::date,requested_license_end_date=(insertobj->>'requested_license_end_date')::date ,update_ts=now(), update_user_id=v_securityuserid,mailing_address=(insertobj->>'mailing_address'),license_no=(insertobj->>'license_no'),program_name=(insertobj->>'program_name'),contact_first_nm=(insertobj->>'contact_first_nm') WHERE applicant_id=v_applicantid;

select prov_applicant_accomodation_id into v_accomid from tb_prov_applicant_accomodation where provider_applicant_id = v_applicantid;

UPDATE tb_prov_applicant_accomodation
SET minimum_age_no=(insertobj->>'minimum_age_no')::int, maximum_age_no=(insertobj->>'maximum_age_no')::int, gender_cd=insertobj->>'gender_cd', children_no=(insertobj->>'children_no')::int, update_ts=now(), update_user_id=v_securityuserid, min_age_months_no=(insertobj->>'min_age_months_no')::int, max_age_months_no=(insertobj->>'max_age_months_no')::int, iq_range_from=insertobj->>'iq_range_from', iq_range_to=insertobj->>'iq_range_to'
WHERE prov_applicant_accomodation_id=(v_accomid)::uuid;

return 'success'; 
else
return 'failure';
end if;
end;
$function$

