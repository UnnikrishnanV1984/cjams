CREATE OR REPLACE FUNCTION as_getcaseaddress(v_intakeserviceid character varying)
 RETURNS TABLE(ascaseaddressid uuid, intakeserviceid uuid, startdate timestamp without time zone, enddate timestamp without time zone, personaddresstypekey character varying, address character varying, address2 character varying, zipcode character varying, city character varying, state character varying, country character varying, county character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN
 RETURN QUERY
   SELECT
      ac.ascaseaddressid,
   ac.entitytypeid as intakeserviceid, 
   ac.startdate, 
   ac.enddate, 
   ac.personaddresstypekey, 
   ac.address, 
   ac.address2, 
   ac.zipcode, 
   ac.city, 
   ac.state, 
   ac.country, 
   ac.county
  FROM 
   ascaseaddress ac
  WHERE ac.entitytypeid=v_intakeserviceid::uuid and ac.activeflag = 1;
 END;

$function$

