CREATE OR REPLACE FUNCTION as_pdfvictimimpact(i_evaluationid uuid, victimid uuid)
 RETURNS TABLE(complaintid character varying, complaintdate timestamp without time zone, youthname text, cjamspid bigint, victim json)
 LANGUAGE plpgsql
AS $function$

begin
 
 return query 

 select inre.complaintid,
 inre.complaintreceiveddate as complaintdate,
 p.lastname ||' '|| p.firstname as youthname,
 p.cjamspid as youthid,
 (select json_agg (x) from 
  (select P.personid,p.firstname ||' '|| p.lastname as victimname, 
   (select json_agg(x) from
    (select phonenumber, phoneextension, personphonetypekey from personphonenumber PP where PP.personid=P.personid) as x
   ) as phone,
   (select json_agg(x) from
    (select PA.address,PA.address2 ,PA.zipcode,PA.city,PA.state,PA.country from personaddress PA where PA.personid=P.personid) as x
   ) as address
   from person P  
  where p.personid=victimid and  p.activeflag=1
  ) as x
 ) as victim
 from intakeservicerequestevaluation inre
 join intakeservicerequest INTSR on INTSR.intakenumber=inre.intakenumber and INTSR.activeflag=1
 join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1
 join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype='Youth'
 join person p on ACC.personid=p.personid and p.activeflag=1
 where intakeservicerequestevaluationid=i_evaluationid ;

 end

$function$

