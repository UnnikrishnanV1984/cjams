CREATE OR REPLACE FUNCTION saverestitutionpaymentflatfilecontent(jsondata json, v_restitutionpaymentflatfileid uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$


DECLARE 

v_restitutionpaymentflatfilecontentid uuid;
j_restitutionpaymentflatfilecontent json;
v_paymentno bigint;
v_date timestamp without time zone;
 
BEGIN
        v_date:= now() ;
        j_restitutionpaymentflatfilecontent := jsondata;
        v_restitutionpaymentflatfilecontentid :=   gen_random_uuid();

        SELECT MAX(paymentno)+1 INTO v_paymentno FROM restitutionpaymentflatfilecontent WHERE activeflag = 1;
        
 IF v_paymentno IS NULL THEN
 v_paymentno := 5000000;
 END IF;
               
 Insert into restitutionpaymentflatfilecontent(restitutionpaymentflatfilecontentid,
 restitutionpaymentflatfileid,asofdate,lockboxno,vakaccountnumber,firstname,lastname,addressline1,addressline2,city,
 state,zip,customernumber,checkno,checkamt,insertedby,updatedby,insertedon,updatedon,ismatched,activeflag,paymentno)

 values (v_restitutionpaymentflatfilecontentid,v_restitutionpaymentflatfileid, cast(j_restitutionpaymentflatfilecontent ->> 'As of Date' as character varying),  
 cast(j_restitutionpaymentflatfilecontent ->> 'Lockbox No' as character varying),cast(j_restitutionpaymentflatfilecontent ->> 'VAK Account Number' as character varying),
 cast(j_restitutionpaymentflatfilecontent ->> 'First Name' as character varying), cast(j_restitutionpaymentflatfilecontent ->> 'Last Name' as character varying),
 cast(j_restitutionpaymentflatfilecontent ->> 'Address Line 1' as character varying), cast(j_restitutionpaymentflatfilecontent ->> 'Address Line 2' as character varying),
 cast(j_restitutionpaymentflatfilecontent ->> 'City' as character varying), cast(j_restitutionpaymentflatfilecontent ->> 'State' as character varying),
 cast(j_restitutionpaymentflatfilecontent ->> 'Zip' as character varying), cast(j_restitutionpaymentflatfilecontent ->> 'Customer Number' as character varying),
 cast(j_restitutionpaymentflatfilecontent ->> 'Check No' as character varying), cast(j_restitutionpaymentflatfilecontent ->> 'Check Amt' as numeric),
 'admin','admin',v_date, v_date,false, 1,v_paymentno);

Return 'Success';
 
END;


$function$

