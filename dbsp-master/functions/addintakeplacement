CREATE OR REPLACE FUNCTION addintakeplacement(vr_intakenumber character varying, vr_placement json, vr_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE
 
 l_status character varying;

BEGIN
 
 insert into placement (providerid, intakenumber,personid,remarks,placementadmissionclassificationkey,
 placementadmissiontypekey,parentorg,addate,adtime,releasedate,detainer,startdatetime,placementadmissionauthorizationtypekey,
 placementprimaryadmissionreasontypekey,placementprimaryapprovedalttypekey,county,jlocation,jcounty,fieldworker, insertedby,updatedby,insertedon,updatedon,
 certifiedad,resourceworker,istempplacement) values ((vr_placement ->> 'providerid')::UUID, vr_placement ->> 'intakenumber', (vr_placement ->> 'personid')::UUID, vr_placement ->> 'remarks',
 vr_placement ->> 'placementadmissionclassificationkey',vr_placement ->> 'PlacementAdmissionTypekey',vr_placement ->> 'parentorg',date(vr_placement ->> 'addate'),TO_TIMESTAMP(vr_placement ->> 'adtime', 'HH24:MI')::TIME,
 date(vr_placement ->> 'releasedate'),vr_placement ->> 'detainer', now(), vr_placement ->> 'PlacementAdmissionAuthorizationTypekey',vr_placement ->> 'PlacementPrimaryAdmissionReasonTypekey',
  vr_placement ->> 'PlacementPrimaryApprovedAltTypekey', (vr_placement ->> 'county')::UUID, vr_placement ->> 'jlocation', vr_placement ->> 'jcounty', vr_placement ->> 'fieldworker', vr_securityusersid, vr_securityusersid, now(), now(), 
  vr_placement ->> 'certifiedAd',vr_placement ->> 'resourceworker',(vr_placement ->> 'istempplacement')::boolean);
  
 select routingintake into l_status from routingintake (vr_intakenumber, vr_securityusersid, 'DWAN', 55, null);
        
RETURN 'Success';

END;

$function$

