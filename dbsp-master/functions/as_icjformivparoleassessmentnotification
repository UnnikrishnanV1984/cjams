CREATE OR REPLACE FUNCTION as_icjformivparoleassessmentnotification()
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE  

v_status character varying;

v_count int;
v_icjassessment20daysrecord  record;
v_msg character varying;
v_voluntrytype character varying;



BEGIN
     FOR  v_icjassessment20daysrecord  IN
 
select distinct ISR.intakeserviceid,
R.fromsecurityusersid 
,P.lastname,P.firstname ,P.cjamspid
 
           from intakeservicerequest as ISR
          JOIN intakeservicerequesttype ISRT on ISRT.intakeservreqtypeid=ISR.intakeservreqtypeid and ISRT.intakeservreqtypekey='IC'
    
    join servicerequestsubtype SRST on SRST.servicerequestsubtypeid=ISR.intakeservicerequestclassid and SRST.classkey in('ICJ Sending Probation','ICJ Sending Re-Entry/Parole') and SRST.activeflag=1
   
     JOIN routing as R 
           ON R.objectid = ISR.intakenumber  and R.fromroleid='JSUW' and R.routingstatustypeid=11 
     
     join (select objectid,min(updatedon) updatedon from assessment where assessmentstatustypekey='Submitted' and activeflag=1 group by objectid) AST 
     on AST.objectid=ISR.intakeserviceid
     join assessment AST1 on 
     AST1.updatedon=AST.updatedon and AST1.objectid=ISR.intakeserviceid and AST1.activeflag=1
     
     join assessmenttemplate ASMT on 
     
     ASMT.assessmenttemplateid=AST1.assessmenttemplateid and ASMT.activeflag=1
     
     and ASMT.name='formIvParoleOrProbationInvestigationRequest'
  
 JOIN intakeservicerequestactor as ISRA
           ON ISR.intakeserviceid  = ISRA.intakeserviceid  and ISRA.activeflag = 1 and lower(ISRA.intakeservicerequestpersontypekey) = 'youth'
      JOIN actor as A
           ON A.actorid  = ISRA.actorid  and A.activeflag = 1  
      JOIN Person as P
           ON P.personid  = A.personid  and P.activeflag = 1 
      Where AST1.updatedon::date = now()::date - '45 day' ::interval
       --Where AST1.updatedon::date = now()::date - '1 day' ::interval
      
 
      
 LOOP
   
 --v_msg:=   'ICJ Requisition Packet for the '|| v_icjassessment20daysrecord.lastname ||', '|| v_icjassessment20daysrecord.firstname ||'  ('|| v_icjassessment20daysrecord.cjamspid ||')is submitted';
     v_msg:=   'Parole or Probation Investigation Request 45 days.';
    
 SELECT send_notification INTO v_status FROM as_send_notification(v_icjassessment20daysrecord.fromsecurityusersid, 'System'::character varying, v_icjassessment20daysrecord.fromsecurityusersid,
 'System', 'High', v_msg, v_msg , v_icjassessment20daysrecord.intakeserviceid::character varying);
 
 
     
     
    END LOOP;
 
RETURN

'Success';

END;


$function$

