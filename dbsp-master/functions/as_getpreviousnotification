CREATE OR REPLACE FUNCTION as_getpreviousnotification(intakeserviceid character varying, securityuserid character varying)
 RETURNS TABLE(fromsecurityuserid character varying, tosecurityusersid character varying)
 LANGUAGE plpgsql
AS $function$

declare  v_intakeserviceid  character  varying  =  null;
declare  v_tosecurityuserid  character  varying  =  null;
BEGIN
 v_intakeserviceid:=  intakeserviceid;
 v_tosecurityuserid :=securityuserid;
 
 --  Return  Query
 --  select  count(1)  OVER()  totalcount,  at.actortype,  at.typedescription,  at.sequencenumber,  at.effictivedate,
 --  at.expirationdate,  at.tasktype,  at.activeflag  from  actortype  at  join  actortypeagency  ata  on  ata.actortypekey  =  at.actortype
 --  where  ata.teamtypekey  =  v_teamtypekey  and  at.activeflag  =  1  and  ata.activeflag  =  1  order  by  at.typedescription;
 
 Return  Query
 select u.fromsecurityusersid,u.tosecurityusersid from usernotificationmap u where usernotificationid in (select usernotificationid from usernotification 
 where objectid = v_intakeserviceid and securityusersid = v_tosecurityuserid and activeflag = '1' order by insertedon desc limit 1 
)  ;
    end;

$function$

