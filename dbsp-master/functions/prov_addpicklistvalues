CREATE OR REPLACE FUNCTION prov_addpicklistvalues(picklistinfo json)
 RETURNS TABLE(status text, home_info_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying;
v_response  character varying;
v_picklistid character varying;
v_approval character varying;
 begin                                                                                                                                                                                                                                                                                                                                                                                                 
v_picklistid:=null;

v_securityuserid := picklistinfo->>'securityuserid';
v_approval := picklistinfo->>'approvalstatus';
if (picklistinfo->>'provider_picklist_id' is not null) then
 v_picklistid := picklistinfo->>'provider_picklist_id';
 
end if;
--v_homeinfoid='38df4661-1bdb-4c14-8e6c-b5fb3819781c';
 raise notice '%s',v_picklistid;
raise notice '%s',v_securityuserid;


  if (v_picklistid) is null  then
   raise notice '%s',v_picklistid;

    if (v_approval = 'Approve') then
    
    INSERT INTO tb_provider_picklist (provider_id, program_id, picklist_type_id, picklist_value_cd, create_user_id, update_user_id, delete_sw, value_desc, 
    create_ts, update_ts)
     VALUES((picklistinfo->>'provider_id')::int4, (picklistinfo->>'program_id') ::int4,(picklistinfo->>'picklist_type_id')::int4,picklistinfo->>'picklist_value_cd', v_securityuserid,v_securityuserid,
     'N'::bpchar, '',now(), now());  


     UPDATE routing
      SET routingstatustypeid = 16,
      updatedon = now(),
      updatedby = v_securityuserid
     WHERE objectid = (picklistinfo->>'provider_id')::character varying AND eventcode = (picklistinfo->>'eventcode')::character varying and routingstatustypeid = 10;
   end if;
   if (v_approval = 'Reject') THEN
    UPDATE routing
      SET routingstatustypeid = 17,
      updatedon = now(),
      updatedby = v_securityuserid
     WHERE objectid = (picklistinfo->>'provider_id')::character varying AND eventcode = (picklistinfo->>'eventcode')::character varying and routingstatustypeid = 10;
   end if;

  else
   raise notice '%s',v_picklistid;
   --v_homeinfoid=(homeinfoobj->>'home_info_id');
   update tb_provider_picklist tpp set    
   provider_id=(picklistinfo->>'provider_id')::int4, 
   program_id=(picklistinfo->>'program_id')::int4,
   picklist_type_id=(picklistinfo->>'picklist_type_id')::int4,
   picklist_value_cd=(picklistinfo->>'picklist_value_cd'), 
   update_user_id=v_securityuserid,
   update_ts=now(),
   delete_sw=(picklistinfo->>'delete_sw')    
    where tpp.provider_picklist_id=v_picklistid::int4;


   update tb_provider_services set 
   end_dt = now()::date,
   update_ts = now(),
   update_user_id = v_securityuserid
   where provider_id = (picklistinfo->>'provider_id')::int4 and delete_sw = 'N';
  end if;
v_response:='Success';
   return query
select v_response::text,v_picklistid::CHARACTER VARYING;                                              
                                                                                                                                                                                                                                                                                                                                                                                           
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

