CREATE OR REPLACE FUNCTION getpersonpriorfindings(v_personid uuid)
 RETURNS TABLE(intakeserviceid uuid, casenumber character varying, intakenumber character varying, servicetype character varying, dasubtype character varying, datecreated timestamp without time zone, dateclosed timestamp without time zone)
 LANGUAGE plpgsql
AS $function$

DECLARE  

jsondata  json;
BEGIN

return  query

  SELECT  
   isr.intakeserviceid,
   isr.servicerequestnumber  AS  casenumber,
   isr.intakenumber,
   isrt.description  AS  servicetype,
   srs.description  AS  dasubtype,     
   isr.insertedon  AS  datecreated,
   isr.exitdate  AS  dateclosed
  FROM  investigationallegation  iga
  INNER  JOIN  Investigationallegationmaltreators  iam  ON  iam.investigationallegationid=iga.investigationallegationid  AND  iga.activeflag=1  
  INNER  JOIN  intakeservicerequestactor  isra  ON  iam.intakeservicerequestactorid=isra.intakeservicerequestactorid  AND  isra.activeflag=1  AND  isra.personid  =  v_personid
  LEFT  JOIN  investigationfinding  ivf  ON  ivf.investigationallegationid  =  iga.investigationallegationid  AND  ivf.activeflag=1  
  INNER  JOIN  intakeservicerequest  ISR  ON  isr.intakeserviceid  =  isra.intakeserviceid  AND  isr.activeflag=1
  INNER  JOIN  intakeservicerequesttype  isrt  ON  isrt.intakeservreqtypeid=isr.intakeservreqtypeid  AND  isrt.activeflag=1
  INNER  JOIN  servicerequestsubtype  srs  ON  srs.servicerequestsubtypeid=isr.intakeservicerequestclassid  AND  srs.activeflag=1
  WHERE  iam.activeflag  =1  
  UNION
  SELECT  
   isr.intakeserviceid,
   isr.servicerequestnumber  AS  casenumber,
   isr.intakenumber,
   isrt.description  AS  servicetype,
   srs.description  AS  dasubtype,     
   isr.insertedon  AS  datecreated,
   isr.exitdate  AS  dateclosed
  FROM  Investigationmaltreatmentactor  ima
  INNER  JOIN  intakeservicerequestactor  isra  ON  ima.intakeservicerequestactorid=isra.intakeservicerequestactorid  AND  isra.activeflag=1  AND  ISRA.personid  =  v_personid
  LEFT  JOIN  investigationfinding  ivf  ON  ivf.Investigationmaltreatmentactorid  =  ima.Investigationmaltreatmentactorid  AND  ivf.activeflag=1  
  INNER  JOIN  intakeservicerequest  ISR  ON  isr.intakeserviceid  =  isra.intakeserviceid  AND  isr.activeflag=1
  INNER  JOIN  intakeservicerequesttype  isrt  ON  isrt.intakeservreqtypeid=isr.intakeservreqtypeid  AND  isrt.activeflag=1
  INNER  JOIN  servicerequestsubtype  srs  ON  srs.servicerequestsubtypeid=isr.intakeservicerequestclassid  AND  srs.activeflag=1
  WHERE  ima.activeflag  =1  ;
   
END;

$function$

