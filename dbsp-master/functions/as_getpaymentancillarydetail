CREATE OR REPLACE FUNCTION as_getpaymentancillarydetail(v_providerid integer, v_paymentcode character varying, v_lipagesize bigint, v_lipagenumber bigint)
 RETURNS TABLE(totalcount bigint, authorization_id integer, provider_id integer, payment_type_cd character varying, payment_id integer, payment_amount numeric, payment_date date, client_id bigint, clientfirstname character varying, clientlastname character varying, final_service_nm character varying, final_service_id integer, final_service_start_dt date, final_service_end_dt date, payment_method_cd character varying, payment_method_nm character varying, change_reason_cd character varying, reason_changed character varying, report_1099_sw character, type_1099_cd character varying, type1099nm character varying, gross_amount_no numeric, county_cd character varying, countyname character varying, case_id bigint, payment_detail_id integer, final_fiscal_category_cd character, intakeserviceid uuid, payment_status_cd character varying, paymentstatus character varying, colletion_status character varying, receivable_type character varying, receivable_type_nm character varying, arstatus character varying, final_fiscal_category character varying, servicecaseid character varying)
 LANGUAGE plpgsql
AS $function$ 

DECLARE 
    v_pagenumber int;
 v_pageoffset int;
BEGIN  
IF COALESCE(v_liPageSize, 0) < 1 THEN                     
 v_liPageSize := 10;
END IF;
IF COALESCE(v_liPageNumber, 0) < 1 
THEN
 v_liPageNumber := 1; 
end if;

v_pagenumber := v_liPageNumber - 1;
v_pageoffset := v_pagenumber * v_liPageSize;

RAISE NOTICE '%', v_providerid;

return query

select count(1) over() as totalcount,payhead.authorization_id,payhead.provider_id,payhead.payment_type_cd,payhead.payment_id,payhead.gross_amount_no as payment_amount,payhead.payment_dt as payment_date,paydet.client_id,client.firstname,client.lastname
,(select service_nm from prov.tb_services where delete_sw='N' and service_id =paydet.final_service_id limit 1) as final_service_nm,paydet.final_service_id,paydet.final_service_start_dt,paydet.final_service_end_dt,
payhead.payment_method_cd,(select value_tx from tb_picklist_values where TRIM(PICKLIST_VALUE_CD)=payhead.payment_method_cd
AND PICKLIST_TYPE_ID='1') as payment_method_nm,paydet.change_reason_cd,(select value_tx from tb_picklist_values where PICKLIST_type_id=277 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(paydet.change_reason_cd)) as  reason_changed,
paydet.report_1099_sw,paydet.type_1099_cd,(select value_tx from tb_picklist_values where TRIM(PICKLIST_VALUE_CD)=paydet.type_1099_cd
AND PICKLIST_TYPE_ID='308') type1099cd,payhead.gross_amount_no,tb.county_cd,(select value_tx from tb_picklist_values where TRIM(PICKLIST_VALUE_CD)=tb.county_cd
AND PICKLIST_TYPE_ID='328')  as countyname,paydet.case_id,paydet.payment_detail_id,paydet.final_fiscal_category_cd, null::uuid,
tps.payment_status_cd,(select value_tx from tb_picklist_values where 
TRIM(PICKLIST_VALUE_CD)=tps.payment_status_cd
AND PICKLIST_TYPE_ID='133') as paymentstatus
,case when (select count(1)  from tb_placement tpl where tpl.exit_dt is null and tpl.delete_sw = 'N' and tpl.provider_id =tb.provider_id ) >0 then '779':: character varying else '780':: character varying end as colletion_status,
'5789':: character varying receivable_type ,
(select value_tx from tb_picklist_values where 
TRIM(PICKLIST_VALUE_CD)='5789'
AND PICKLIST_TYPE_ID='64') as receivable_type_nm,
'19' :: character varying arstatus,
(select tfc.fiscal_category_desc from tb_fiscal_category_master tfc where tfc.fiscal_category_cd = paydet.final_fiscal_category_cd
limit 1) as final_fiscal_category
,isr.servicerequestnumber
from tb_payment_header payhead
INNER JOIN tb_payment_detail as paydet ON payhead.payment_id = paydet.payment_id
inner JOIN person as client ON paydet.client_id = client.cjamspid
inner join prov.tb_provider tb on tb.provider_id = payhead.provider_id
left join intakeservicerequest isr on isr.servicerequestnumber = paydet.case_id::character varying
-- left join intakeservicerequest ins on ins.servicecaseid = isr.servicecaseid and ins.activeflag=1
left join tb_service_purchase_authorization tspa on tspa.authorization_id = payhead.authorization_id
inner join tb_payment_status tps on tps.payment_id = payhead.payment_id
where payhead.provider_id=v_providerid and payhead.payment_type_cd= v_paymentcode
order by payhead.payment_id desc
LIMIT v_liPageSize OFFSET v_pageoffset; 
 

END;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 $function$

