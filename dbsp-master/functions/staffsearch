CREATE OR REPLACE FUNCTION staffsearch(usersearch json)
 RETURNS TABLE(firstname character varying, lastname character varying, title character varying, teamname character varying, positioncode character varying, officephone character varying, city character varying, county character varying, zipcode character varying, region character varying, count integer, statecellphonenumber character varying, securityusersid character varying, teammemberid uuid)
 LANGUAGE plpgsql
AS $function$           
            
   

 DECLARE v_lvFirstName   VARCHAR(50);              
   v_lvLastName   VARCHAR(50);              
   v_lvPosition   VARCHAR(50);              
   v_lvTeamNo   VARCHAR(50);              
   v_lvCity    VARCHAR(50);                
   v_lvZipCode   VARCHAR(50);              
   v_lvCounty   VARCHAR(50);               
   v_liRegion   INT;              
   v_lvTeamType   VARCHAR(50) ;              
   v_liLoadNumber  VARCHAR(20);              
   v_liPageNumber  INT;              
   v_liPageSize   INT;              
   v_liCount    INT ;          
   v_lvUserCity   VARCHAR(50);                
   v_lvUserZipCode   VARCHAR(50);              
   v_lvUserCounty   VARCHAR(50);
   cnt integer;
BEGIN


       CREATE TEMP TABLE  SearchUser (              
         parmKeyword VARCHAR(50),              
         parmValue VARCHAR(1000)               
        );              
                 
               
 CREATE SEQUENCE FullResults_Sequence;

 --DECLARE 
 CREATE TEMP TABLE  Results  (              
  ordinal  INT default nextval ('FullResults_Sequence'),              
  FirstName  VARCHAR(50),              
  LastName  VARCHAR(50),              
  Title   VARCHAR(50),              
  TeamName  VARCHAR(50),              
  PositionCode  VARCHAR(50),              
  OfficePhone   VARCHAR(50),              
  City   VARCHAR(50),              
  County  VARCHAR(50),              
  ZipCode  VARCHAR(50),              
  Region  VARCHAR(50),              
  Count  INT ,            
  StateCellPhoneNumber VARCHAR(50),            
  SecurityUsersId  VARCHAR(100),
  TeamMemberId    uuid          
  );        

  
  v_lvFirstName := usersearch ->> 'FirstName' ;
  v_lvLastName := usersearch ->> 'LastName' ;
  v_lvPosition := usersearch ->> 'Position' ;
  v_lvTeamNo := usersearch ->> 'TeamNo' ;
  v_lvTeamType := usersearch ->> 'TeamType' ;
  v_lvCity := usersearch ->> 'City' ;  
  v_lvZipCode := usersearch ->> 'ZipCode' ; 
  v_lvCounty := usersearch ->> 'County' ; 
  v_lvUserCity := usersearch ->> 'UserCity' ; 
  v_lvUserZipCode := usersearch ->> 'UserZipCode' ; 
  v_lvUserCounty := usersearch ->> 'UserCounty' ;
  v_liRegion := usersearch ->> 'Region' ; 
  v_liLoadNumber := usersearch ->> 'LoadNumber' ; 
  v_liPageNumber := usersearch ->> 'PageNumber' ; 
  v_liPageSize := usersearch ->> 'PageSize' ; 

  INSERT INTO SearchUser(parmKeyword,parmValue) 
  values
  ('FirstName',usersearch ->> 'FirstName'),       
  ('LastName',usersearch ->> 'LastName'),
  ('Position',usersearch ->> 'Position'),
  ('TeamNo',usersearch ->> 'TeamNo'),
  ('TeamType',usersearch ->> 'TeamType'),
  ('City',usersearch ->> 'City'),
  ('ZipCode',usersearch ->> 'ZipCode'),
  ('County',usersearch ->> 'County'),
  ('UserCity',usersearch ->> 'UserCity'),
  ('UserZipCode',usersearch ->> 'UserZipCode'),
  ('UserCounty',usersearch ->> 'UserCounty'),
  ('Region',usersearch ->> 'Region'),
  ('LoadNumber',usersearch ->> 'LoadNumber'),
  ('PageNumber',usersearch ->> 'PageNumber'),
  ('PageSize',usersearch ->> 'PageSize');   
                   
                
 INSERT INTO Results  (
  FirstName,              
  LastName,              
  Title   ,              
  TeamName  ,              
  PositionCode  ,              
  OfficePhone  ,              
  City ,              
  County  ,              
  ZipCode,              
  Region,              
  Count  ,            
  StateCellPhoneNumber ,            
  SecurityUsersId,
  TeamMemberId 
 )            
 SELECT DISTINCT UP.FirstName,              
   UP.LastName ,               
   CAST (TMR.Description AS VARCHAR(256))  ,              
   TE.TeamNumber || '-' || TE.TeamTypeKey  AS TeamName ,              
   TM.LoadNumber   ,              
   phoneNumber As OfficePhone,              
   UPA.City ,              
   UPA.County As County,               
   UPA.ZipCode ,                
   '' AS  Region,              
   COUNT(1) As Count,             
   COALESCE(( SELECT phoneNumber              
    FROM UserProfilePhoneNumber UPPN1              
    WHERE UPPN1.SecurityUsersId  =  UP.SecurityUsersId AND UPPN1.UserProfileTypeKey = 'statecell'),'')  As StateCellPhoneNumber  ,            
   UP.SecurityUsersId As SecurityUsersId  , 
   TM.TeamMemberId As TeamMemberId       
   FROM TeamMember AS TM               
  JOIN Team AS TE ON TE.TeamId = TM.TeamId   
  JOIN TeamMemberRoleType TMR ON TMR.RoleTypeKey = TM.RoleTypeKey            
  LEFT JOIN CountyAreaTeamMember AS CATM ON CATM.TeamMemberId  = TM.TeamMemberId AND CATM.ActiveFlag = 1             
  LEFT JOIN County AS CO ON CO.CountyId = CATM.CountyId               
  LEFT JOIN TeamMemberAssignment AS TMA ON TMA.TeamMemberId = TM.TeamMemberId   AND TMA.ActiveFlag = 1             
  LEFT JOIN UserProfile AS UP ON UP.SecurityUsersId  = TMA.SecurityUsersId                
  LEFT JOIN UserProfileAddress UPA ON UPA.SecurityUsersId = UP.SecurityUsersId           
  LEFT JOIN UserProfilePhoneNumber AS UPPN ON UPPN.SecurityUsersId = UP.SecurityUsersId    AND  UPPN.UserProfileTypeKey = 'office' 
         
 WHERE  (v_lvFirstName  IS NULL OR UP.FirstName LIKE v_lvFirstName || '%' )              
   AND (v_lvLastName IS NULL OR UP.LastName LIKE  v_lvLastName || '%' )              
   AND (v_lvPosition IS NULL OR TM.RoleTypeKey  LIKE v_lvPosition)              
   AND (v_lvTeamNo  IS NULL OR TE.TeamNumber LIKE v_lvTeamNo)              
   AND (v_lvTeamType    IS NULL OR TE.TeamTypeKey = v_lvTeamType)              
   AND (v_lvCity  IS NULL OR CO.City LIKE v_lvCity)              
  --AND (v_lvZipCode  IS NULL OR CO.ZipCode LIKE v_lvZipCode)              
   AND (v_lvCounty  IS NULL OR CO.CountyName LIKE v_lvCounty)              
  -- AND (v_liRegion  IS NULL OR CO.APSRegion  LIKE v_liRegion)               
   AND (v_liLoadNumber  IS NULL OR TM.LoadNumber = v_liLoadNumber)               
   AND (v_lvUserCity IS NULL OR UPA.city LIKE v_lvUserCity)          
   AND (v_lvUserZipCode IS NULL OR UPA.zipcode LIKE v_lvUserZipCode)          
   AND (v_lvUserCounty  IS NULL OR UPA.County LIKE v_lvUserCounty)          
 GROUP BY UP.SecurityUsersId , UP.FirstName , UP.LastName , TM.TeamMemberId ,
 CAST (TMR.Description AS VARCHAR(256)), TeamNumber , TE.TeamTypeKey , LoadNumber , phoneNumber , UPA.City , UPA.County  , UPA.ZipCode;  



 select Count(*) into cnt  FROM Results;

 RAISE NOTICE 'CountLength%',cnt;        
                 
 IF COALESCE(v_liPageNumber, 0) < 1 THEN              
  v_liPageNumber := 1;
 END IF;              
              
 SELECT COUNT(1) INTO v_liCount FROM Results;              
               
 IF v_liCount IS NULL THEN              
   v_liCount := 0;
 END IF;              
                 
 IF COALESCE(v_liPageSize, 0) < 1 THEN              
  v_liPageSize := v_liCount;
 END IF;              

RETURN QUERY              
 SELECT r.FirstName,              
   r.LastName ,               
   r.Title ,              
   r.TeamName ,              
   r.PositionCode  ,              
   r.OfficePhone,              
   r.City ,              
   r.County,               
   r.ZipCode ,                
   r.Region ,              
   v_liCount  AS Count,             
   r.StateCellPhoneNumber,            
   r.SecurityUsersId As SecurityUsersId, 
   r.TeamMemberId AS TeamMemberId           
 FROM Results r             
 WHERE ordinal BETWEEN ((v_liPageNumber - 1) * v_liPageSize + 1) AND (v_liPageNumber * v_liPageSize)      
  AND   r.LastName IS NOT NULL            
 ORDER BY r.LastName;             


 DROP TABLE SearchUser;
 DROP TABLE Results;
 DROP SEQUENCE FullResults_Sequence;
  END;
$function$

