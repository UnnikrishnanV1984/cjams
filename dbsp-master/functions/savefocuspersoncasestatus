CREATE OR REPLACE FUNCTION savefocuspersoncasestatus(v_personid uuid, v_intakeserviceid uuid, v_intakenumber character varying, v_focuspersonstatustypekey character varying, v_status character varying, v_securityuserid character varying, v_opennotes text, v_closenotes text)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

j_focuspersoncasestatus json;
v_focuspersoncasestatusid uuid;
v_date timestamp without time zone;
v_startdate date;
v_enddate date;
searchfocuspersoncasestatus character varying(2000);
i_focuspersoncasestatuscount int;
 
BEGIN

 -- Focuspersoncasestatus
    v_date:= now();
    IF v_status = 'Open' THEN
 v_startdate:= now()::date;
 v_enddate:= null;

    ELSE 
 v_enddate = now()::date;
    END IF; 

        searchfocuspersoncasestatus:= coalesce(searchfocuspersoncasestatus,'');
        
        -- Focuspersonstatustypekey
        if (v_focuspersonstatustypekey!='' or v_focuspersonstatustypekey!=null) then
 searchfocuspersoncasestatus:= coalesce(searchfocuspersoncasestatus,'') || ' AND lower(cast( coalesce(focuspersonstatustypekey,'''') as  character varying)) = '''||lower(v_focuspersonstatustypekey)||''' ';
        end if;
        -- Personid
        if (v_personid is not null) then
 searchfocuspersoncasestatus:= coalesce(searchfocuspersoncasestatus,'')|| ' AND personid = '''|| v_personid ||''' ';
        end if;
        -- Intakeserviceid
        if (v_intakeserviceid is not null) then
 searchfocuspersoncasestatus:= coalesce(searchfocuspersoncasestatus,'')|| ' AND intakeserviceid = '''|| v_intakeserviceid ||''' ';
        end if;
         -- Intakenumber
        if (v_intakenumber is not null) then
 searchfocuspersoncasestatus:= coalesce(searchfocuspersoncasestatus,'')|| ' AND Intakenumber = '''|| v_intakenumber ||''' ' ;
        end if;

        execute 'select count(1)  from focuspersoncasestatus where status = ''Open'' '|| searchfocuspersoncasestatus ||' ' into i_focuspersoncasestatuscount; 

        IF (i_focuspersoncasestatuscount = 0) THEN
              IF (v_focuspersonstatustypekey is not null and v_status is not null and v_status ='Open') THEN

               v_focuspersoncasestatusid :=   gen_random_uuid();
       Insert Into focuspersoncasestatus (focuspersoncasestatusid, personid, intakeserviceid, intakenumber,focuspersonstatustypekey, status,startdate, 
       enddate, activeflag, effectivedate, insertedby, updatedby, insertedon, updatedon,opennotes)
       values (v_focuspersoncasestatusid, v_personid,v_intakeserviceid,v_intakenumber,v_focuspersonstatustypekey, v_status, v_startdate, v_enddate, 1,
       v_date, v_securityuserid,v_securityuserid, v_date, v_date,v_opennotes);
       
              END IF;
             
        ELSIF v_status = 'Closed' THEN

                       execute 'update focuspersoncasestatus set status=''Closed'',enddate = now()::date,closenotes = '''||coalesce(v_closenotes, '')||''' where status = ''Open'' '|| searchfocuspersoncasestatus ||' ' ;

        END IF;
 

     Return 'Success';
 
END;

$function$

