CREATE OR REPLACE FUNCTION prov_getaffiliatedproviders(v_affiliate_provider_id character varying)
 RETURNS TABLE(totalcount bigint, provider_id bigint, affiliate_provider_id bigint, provider_nm character varying, provider_first_name character varying, provider_last_name character varying, provider_category character varying, provider_status_cd character varying, licenses json)
 LANGUAGE plpgsql
AS $function$
 
BEGIN 

 return query
  
 select count(1) over() as totalcount,
 p.provider_id::bigint,
 p.affiliate_provider_id::bigint,
 p.provider_nm,p.provider_first_nm, p.provider_last_nm,pv.value_tx as provider_category,p.provider_status_cd::character varying,
 (select json_agg(l) from (
  SELECT tpl.license_no, tpl.license_level, tpl.license_type, tpl.license_application_id, tpl.license_status_cd, tpl.license_issue_dt, tpl.license_expiry_dt
  FROM tb_provider_licensing tpl 
  WHERE tpl.site_id = p.provider_id and tpl.active_sw='Y'
  AND tpl.delete_sw = 'N'
 ) l ) as licenses
   from tb_provider p
   left join tb_picklist_values pv on pv.picklist_value_cd = p.provider_category_cd and pv.picklist_type_id=155
   inner join tb_provider_licensing tpl on tpl.site_id = p.provider_id and tpl.active_sw='Y' and tpl.delete_sw = 'N'
  AND tpl.delete_sw = 'N' 
  AND p.provider_status_cd = '1791'
    where p.affiliate_provider_id=v_affiliate_provider_id
 and p.delete_sw='N';


 
END;

$function$

