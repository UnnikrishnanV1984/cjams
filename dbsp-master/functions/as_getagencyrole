CREATE OR REPLACE FUNCTION as_getagencyrole(v_teamtypekey character varying)
 RETURNS TABLE(id integer, name character varying, description character varying, roletypekey character varying, created timestamp without time zone, modified timestamp without time zone, openamrole character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN

RETURN  query

 SELECT r.id,  r.description "name",r.description,r.roletypekey,r.created,r.modified,r.openamrole 
 FROM role R
    INNER JOIN teammemberroletype TMRT ON TMRT.roletypekey = R.roletypekey
    WHERE CASE WHEN v_teamtypekey IS NOT NULL THEN TMRT.teamtypekey = v_teamtypekey ELSE true END;
 
END;

$function$

