CREATE OR REPLACE FUNCTION prov_addupdatecpaaddressinfo(insertobj json)
 RETURNS TABLE(status text, v_provider_cpa_address_id character varying, v_new_provider_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                       
 v_securityuserid character varying; 
v_provider_cpa_address_id CHARACTER VARYING;
existing_num  CHARACTER VARYING;
v_response  CHARACTER VARYING;
v_new_provider_id character varying;
genr_num character varying;
v_seq character varying;
 begin                                                                                                                                                                                                                                                                                                                                                                                                 

v_securityuserid := insertobj->>'securityuserid';
 v_new_provider_id := insertobj->>'cpa_provider_id';
 

  if (insertobj->>'provider_cpa_address_id') is null  then
    if(v_new_provider_id) is null then
    v_seq:='tb_provider_providerid_seq';
     --select * from getnextnumber('providerid') into genr_num; 

     --select (date_part('year',now()) || right('000'|| date_part('dow',now()),3) ||genr_num ):: varchar into v_new_provider_id;
     select * from getnextsequencenumber(v_seq) into v_new_provider_id;
     INSERT INTO tb_provider
     (provider_id,affiliate_provider_id,agency, tax_id_no, provider_category_cd, provider_status_cd, create_ts, create_user_id, update_ts, update_user_id, delete_sw)
     values(v_new_provider_id::int4,(insertobj->>'applicant_id')::int4,null,null,1782,1791,now(),v_securityuserid,now(),v_securityuserid,'N');

     INSERT INTO tb_provider_picklist (provider_id, program_id,picklist_type_id,picklist_value_cd, value_desc, create_ts,create_user_id,update_ts,update_user_id)
     VALUES(v_new_provider_id::int4, null, 155, 1782, 'CPA Home',                             
     now(), v_securityuserid,now(), v_securityuserid);  

    end if;


    INSERT INTO tb_prov_cpa_address 
    (provider_id,cpa_siteid,cpa_provider_id,adr_type,adr_line1,adr_line2,adr_state,adr_city,adr_county,adr_zip,adr_start_date,adr_end_date,
    create_ts,create_user_id,update_ts,update_user_id,active_flag)                                                                                                                                         
    values((insertobj->>'applicant_id')::int4,(insertobj->>'cpa_siteid')::bigint,v_new_provider_id::int4,
    (insertobj->>'adr_type')::character varying,(insertobj->>'adr_line1')::character varying,(insertobj->>'adr_line2')::character varying,
    (insertobj->>'adr_state')::character varying,(insertobj->>'adr_city')::character varying,(insertobj->>'adr_county')::character varying,
    (insertobj->>'adr_zip')::character varying,(insertobj->>'adr_start_date')::timestamp,(insertobj->>'adr_end_date')::timestamp,
    now(),v_securityuserid,now(),v_securityuserid,1) RETURNING "provider_cpa_address_id" INTO v_provider_cpa_address_id;
  
  else
   v_provider_cpa_address_id=(insertobj->>'provider_cpa_address_id');
   

   update  tb_prov_cpa_address set                                                                                                                                        
     provider_id= (insertobj->>'applicant_id')::int4,
     cpa_siteid= (insertobj->>'cpa_siteid')::bigint,
     adr_type= (insertobj->>'adr_type')::character varying,
     adr_line1= (insertobj->>'adr_line1')::character varying,
     adr_line2= (insertobj->>'adr_line2')::character varying,
     adr_state= (insertobj->>'adr_state')::character varying,
     adr_city= (insertobj->>'adr_city')::character varying,
     adr_county= (insertobj->>'adr_county')::character varying,
     adr_zip= (insertobj->>'adr_zip')::character varying,
     adr_start_date= (insertobj->>'adr_start_date')::timestamp,
     adr_end_date= (insertobj->>'adr_end_date')::timestamp,
     update_ts=now(),    
     update_user_id= v_securityuserid, 
     active_flag=(insertobj->>'active_flag')::int4
    where provider_cpa_address_id=v_provider_cpa_address_id::uuid;
  end if;

   return query
select v_response::text,v_provider_cpa_address_id::CHARACTER VARYING, v_new_provider_id::CHARACTER VARYING;                                              
                                                                                                                                                                                                                                                                                                                                                                                           
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

