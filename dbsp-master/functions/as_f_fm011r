CREATE OR REPLACE FUNCTION as_f_fm011r(start_date date, end_date date)
 RETURNS TABLE(client_name text, client_id bigint, jurisdiction character varying, original_payment_amt numeric, original_payment_id integer, original_payment_dt character varying, service_start_dt character varying, service_end_dt character varying, cat_code_pri_cur_mon character varying, elig_status_pcm character varying, re_stamping_reason text, last_restamp_date date, cmr_cost_care_reimb numeric, adjusted_category_code character varying, adjusted_iv_e_status character varying, adj_cost_of_care_reimb numeric, adjusted_state_amount numeric, adjusted_federal_amount numeric, increasing_title_iv_e_claims numeric, decreasing_title_iv_e_claims numeric, overpayment_amount numeric, under_payment numeric)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY (
SELECT DISTINCT * FROM 
(SELECT  
CL.LASTNAME ||','|| CL.FIRSTNAME AS CLIENT_NAME
 , PD.CLIENT_ID 
 , F_PLVALUE(PD.COUNTY_CD, 104) AS JURISDICTION
 , PD.FINAL_AMOUNT_NO AS ORIGINAL_PAYMENT_AMT
 , PD.PAYMENT_ID AS ORIGINAL_PAYMENT_ID
 , CAST(PH.PAYMENT_DT AS VARCHAR) AS ORIGINAL_PAYMENT_DT
 , CAST(PD.FINAL_SERVICE_START_DT AS VARCHAR) AS SERVICE_START_DT
 , CAST(PD.FINAL_SERVICE_END_DT AS VARCHAR) AS SERVICE_END_DT
 , FAD.FISCAL_CATEGORY_CD AS CAT_CODE_PRI_CUR_MON
 , F_PDESC(FAD.ELIGIBILITY_STATUS_CD, 262) AS ELIG_STATUS_PCM
 , 'N/A' AS RE_STAMPING_REASON --(TO BE REMOVED)
 --, F_RS_REASON(FAM.PAYMENT_DETAIL_ID,1,CAST('$(VSTARTDATE)' AS DATE),CAST('$(VENDDATE)'  AS DATE) /*DATE(PREV_MONTH_FIRST_DAY), DATE(PREV_MONTH_LAST_DAY)*/) "RE-STAMPING_REASON"
 , (CASE WHEN FAD.INITIAL_STAMPING_SW = 'Y' THEN NULL 
 ELSE FAD.FUND_ALLOCATION_DATE 
 END ) AS LAST_RESTAMP_DATE
 , ((FAM.COC_FUNDING_AMT + FAM.SSI_FUNDING_AMT + FAM.SSA_FUNDING_AMT)
     -(FAD.COC_FUNDING_AMT + FAD.SSI_FUNDING_AMT + FAD.SSA_FUNDING_AMT)) CMR_COST_CARE_REIMB
 , FAM.FISCAL_CATEGORY_CD ADJUSTED_CATEGORY_CODE
 , F_PDESC(FAM.ELIGIBILITY_STATUS_CD, 262) AS ADJUSTED_IV_E_STATUS
 , (FAM.COC_FUNDING_AMT + FAM.SSI_FUNDING_AMT + FAM.SSA_FUNDING_AMT)  ADJ_COST_OF_CARE_REIMB
 , FAM.STATE_FUNDING_AMT ADJUSTED_STATE_AMOUNT
 , FAM.IVE_FUNDING_AMT ADJUSTED_FEDERAL_AMOUNT

 , (CASE WHEN (FAM.IVE_FUNDING_AMT - FAD.IVE_FUNDING_AMT) > 0 THEN 
        (FAM.IVE_FUNDING_AMT - FAD.IVE_FUNDING_AMT)
    ELSE 
        0 
    END)  INCREASING_TITLE_IV_E_CLAIMS

 , (CASE WHEN (FAM.IVE_FUNDING_AMT - FAD.IVE_FUNDING_AMT) < 0 THEN 
       ABS(FAM.IVE_FUNDING_AMT - FAD.IVE_FUNDING_AMT)
    ELSE 
       0 
    END) DECREASING_TITLE_IV_E_CLAIMS

, (SELECT SUM(AMOUNT_NO)
        FROM TB_RECEIVABLE_DETAIL RD
    WHERE RD.DELETE_SW = 'N'
          AND DATE(RD.RECEIVABLE_TS) > (SELECT DATE(FAD1.FUND_ALLOCATION_DATE)
                                             FROM TB_FUND_ALLOCATION_DETAIL FAD1
                                        WHERE  FAD1.INITIAL_STAMPING_SW = 'Y'
                                               AND FAD1.DELETE_SW = 'N'
                                               AND FAD1.FUND_ALLOC_ID = FAM.FUND_ALLOC_ID
                                               AND FAD1.PAYMENT_DETAIL_ID = FAM.PAYMENT_DETAIL_ID)
          AND DATE(RD.RECEIVABLE_TS) <= CAST(END_DATE  AS DATE) --DATE(PREV_MONTH_LAST_DAY)
          AND RD.PAYMENT_DETAIL_ID = FAM.PAYMENT_DETAIL_ID )  AS OVERPAYMENT_AMOUNT

, ( SELECT SUM(PD1.FINAL_AMOUNT_NO)
       FROM TB_PAYMENT_DETAIL PD1,
            TB_PAYMENT_HEADER PH1
    WHERE PD1.PAYMENT_ID = PH1.PAYMENT_ID
      AND PD1.DELETE_SW = 'N' 
      AND PD1.FINAL_AMOUNT_NO > 0 
      AND PH1.DELETE_SW = 'N'
      AND PH1.PAYMENT_TYPE_CD = '3294'
      AND PH1.MANUAL_SW = 'N'
      AND PD1.PLACEMENT_ID = PD.PLACEMENT_ID
      AND PD1.PAYMENT_DETAIL_ID <> PD.PAYMENT_DETAIL_ID
      AND EXTRACT(MONTH FROM PH1.PAYMENT_START_DT) = EXTRACT(MONTH FROM PH.PAYMENT_START_DT) 
      AND EXTRACT(YEAR FROM PH1.PAYMENT_START_DT) = EXTRACT(YEAR FROM PH.PAYMENT_START_DT)
      AND DATE(PH1.PAYMENT_DT) > ( SELECT DATE(FAD1.FUND_ALLOCATION_DATE)
                                       FROM TB_FUND_ALLOCATION_DETAIL FAD1
                                   WHERE FAD1.INITIAL_STAMPING_SW = 'Y'
                                         AND FAD1.DELETE_SW = 'N'
                                         AND FAD1.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID
                                  ) 
      AND DATE(PH1.PAYMENT_DT) <= CAST(END_DATE  AS DATE)--DATE(PREV_MONTH_LAST_DAY)
      AND (SELECT COUNT(*)
              FROM TB_FUND_ALLOCATION_MASTER FAM1
           WHERE FAM1.DELETE_SW = 'N'
                 AND FAM1.PAYMENT_DETAIL_ID = PD1.PAYMENT_DETAIL_ID 
          ) = 0 
   ) AS UNDER_PAYMENT

FROM TB_FUND_ALLOCATION_MASTER FAM,
     TB_FUND_ALLOCATION_DETAIL FAD,
     TB_PAYMENT_DETAIL PD, 
     TB_PAYMENT_HEADER PH,
     PERSON CL
WHERE FAM.FUND_ALLOC_ID = FAD.FUND_ALLOC_ID
      AND FAM.INITIAL_STAMPING_SW = 'N'
      AND FAM.DELETE_SW = 'N'
      AND FAM.IVE_FUNDING_AMT <> FAD.IVE_FUNDING_AMT
      AND FAD.DELETE_SW = 'N'
      AND FAD.FUND_ALLOC_HISTORY_ID = ( SELECT FUND_ALLOC_HISTORY_ID
                                                FROM TB_FUND_ALLOCATION_DETAIL
                                          WHERE FAD.FUND_ALLOC_ID = TB_FUND_ALLOCATION_DETAIL.FUND_ALLOC_ID
                                                AND DELETE_SW = 'N'
                                                AND TB_FUND_ALLOCATION_DETAIL.FUND_ALLOCATION_DATE < CAST(END_DATE  AS DATE) --DATE(PREV_MONTH_LAST_DAY)
                                         ORDER BY FUND_ALLOC_HISTORY_ID DESC
                                         FETCH FIRST 1 ROWS ONLY)
      AND PD.PAYMENT_DETAIL_ID = FAM.PAYMENT_DETAIL_ID
      AND PH.PAYMENT_ID = PD.PAYMENT_ID
      AND PD.DELETE_SW = 'N'
      AND CAST(PD.CLIENT_ID AS CHARACTER VARYING) = CL.CJAMSPID :: CHARACTER VARYING
      AND CL.ACTIVEFLAG = 1
    AND FAM.FUND_ALLOCATION_DATE BETWEEN CAST(START_DATE AS DATE) AND CAST(END_DATE  AS DATE) --DATE(PREV_MONTH_FIRST_DAY) AND DATE(PREV_MONTH_LAST_DAY)
UNION ALL
    SELECT 
 CL.LASTNAME ||','|| CL.FIRSTNAME AS CLIENT_NAME
 , PD.CLIENT_ID 
 , F_PLVALUE(PD.COUNTY_CD, 104) JURISDICTION
 , PD.FINAL_AMOUNT_NO AS ORIGINAL_PAYMENT_AMT
 , PD.PAYMENT_ID AS ORIGINAL_PAYMENT_ID
 , CAST( PH.PAYMENT_DT AS VARCHAR) AS ORIGINAL_PAYMENT_DT
 , CAST(PD.FINAL_SERVICE_START_DT AS VARCHAR) AS SERVICE_START_DT
 , CAST(PD.FINAL_SERVICE_END_DT AS VARCHAR) AS SERVICE_END_DT
 , PD.FINAL_FISCAL_CATEGORY_CD AS CAT_CODE_PRI_CUR_MON
 , (CASE WHEN SUBSTR(PD.FINAL_FISCAL_CATEGORY_CD,1,2) = '21' OR PD.FINAL_FISCAL_CATEGORY_CD = '5117' THEN
 'ELIGIBLE REIMBURSABLE'
    ELSE
 'NOT ELIGIBLE REIMBURSABLE'
    END ) AS ELIG_STATUS_PCM
 , 'N/A' AS RE_STAMPING_REASON
 , /*NULL*/ FAM.FUND_ALLOCATION_DATE AS LAST_RESTAMP_DATE -- FAM.FUND_ALLOCATION_DATE TO BE REMOVED
 , 0.00 AS CMR_COST_CARE_REIMB
 , FAM.FISCAL_CATEGORY_CD ADJUSTED_CATEGORY_CODE
 , F_PDESC(FAM.ELIGIBILITY_STATUS_CD, 262) AS ADJUSTED_IV_E_STATUS
 , (FAM.COC_FUNDING_AMT + FAM.SSI_FUNDING_AMT + FAM.SSA_FUNDING_AMT) ADJ_COST_OF_CARE_REIMB
 , FAM.STATE_FUNDING_AMT ADJUSTED_STATE_AMOUNT
 , FAM.IVE_FUNDING_AMT ADJUSTED_FEDERAL_AMOUNT

 , (CASE WHEN ( ( SUBSTR(PD.FINAL_FISCAL_CATEGORY_CD,1,2) = '71' AND FAM.ELIGIBILITY_STATUS_CD = '2913' )
                OR
                (( PD.FINAL_FISCAL_CATEGORY_CD = '5118' OR PD.FINAL_FISCAL_CATEGORY_CD = '5119' ) AND FAM.ELIGIBILITY_STATUS_CD = '2913' )  
               ) THEN
 FAM.IVE_FUNDING_AMT
    ELSE
 0.00
    END ) AS INCREASING_TITLE_IV_E_CLAIMS 

 , (CASE WHEN ( ( SUBSTR(PD.FINAL_FISCAL_CATEGORY_CD,1,2) = '21' AND FAM.ELIGIBILITY_STATUS_CD <> '2913' )
                OR
                ( PD.FINAL_FISCAL_CATEGORY_CD = '5117' AND FAM.ELIGIBILITY_STATUS_CD <> '2913' )
               )  THEN
        CAST((FAM.STATE_FUNDING_AMT / 2) AS DECIMAL(10,2))
    ELSE
 0.00
    END ) AS DECREASING_TITLE_IV_E_CLAIMS

, (SELECT SUM(AMOUNT_NO)
        FROM TB_RECEIVABLE_DETAIL RD
    WHERE RD.DELETE_SW = 'N'
          AND DATE(RD.RECEIVABLE_TS) > FAM.FUND_ALLOCATION_DATE
          AND DATE(RD.RECEIVABLE_TS) <= CAST(END_DATE  AS DATE) --DATE(PREV_MONTH_LAST_DAY)
          AND RD.PAYMENT_DETAIL_ID = FAM.PAYMENT_DETAIL_ID )  AS OVERPAYMENT_AMOUNT

, ( SELECT SUM(PD1.FINAL_AMOUNT_NO)
       FROM TB_PAYMENT_DETAIL PD1,
            TB_PAYMENT_HEADER PH1
    WHERE PD1.PAYMENT_ID = PH1.PAYMENT_ID
      AND PD1.DELETE_SW = 'N' 
      AND PD1.FINAL_AMOUNT_NO > 0 
      AND PH1.DELETE_SW = 'N'
      AND PH1.PAYMENT_TYPE_CD = '3294'
      AND PH1.MANUAL_SW = 'N'
      AND PD1.PLACEMENT_ID = PD.PLACEMENT_ID
      AND PD1.PAYMENT_DETAIL_ID <> PD.PAYMENT_DETAIL_ID
      AND EXTRACT(MONTH FROM PH1.PAYMENT_START_DT) = EXTRACT(MONTH FROM PH.PAYMENT_START_DT) 
      AND EXTRACT(YEAR FROM PH1.PAYMENT_START_DT) = EXTRACT(YEAR FROM PH.PAYMENT_START_DT)
      AND DATE(PH1.PAYMENT_DT) > FAM.FUND_ALLOCATION_DATE
      AND DATE(PH1.PAYMENT_DT) <= CAST(END_DATE  AS DATE) --DATE(PREV_MONTH_LAST_DAY)
      AND (SELECT COUNT(*)
              FROM TB_FUND_ALLOCATION_MASTER FAM1
           WHERE FAM1.DELETE_SW = 'N'
                 AND FAM1.PAYMENT_DETAIL_ID = PD1.PAYMENT_DETAIL_ID 
          ) = 0 
   ) AS UNDER_PAYMENT
FROM TB_FUND_ALLOCATION_MASTER FAM,
     TB_PAYMENT_DETAIL PD, 
     TB_PAYMENT_HEADER PH
   ,  PERSON CL
WHERE FAM.INITIAL_STAMPING_SW = 'Y'
      AND FAM.DELETE_SW = 'N'
      AND (
            SUBSTR(PD.FINAL_FISCAL_CATEGORY_CD,1,2) = '21' AND FAM.ELIGIBILITY_STATUS_CD <> '2913'
            OR
            SUBSTR(PD.FINAL_FISCAL_CATEGORY_CD,1,2) = '71' AND FAM.ELIGIBILITY_STATUS_CD = '2913'
            OR
            PD.FINAL_FISCAL_CATEGORY_CD = '5117' AND FAM.ELIGIBILITY_STATUS_CD <> '2913'
            OR
            ( PD.FINAL_FISCAL_CATEGORY_CD = '5118' OR PD.FINAL_FISCAL_CATEGORY_CD = '5119' ) AND FAM.ELIGIBILITY_STATUS_CD = '2913'  
         )
      AND PD.PAYMENT_DETAIL_ID = FAM.PAYMENT_DETAIL_ID
      AND PH.PAYMENT_ID = PD.PAYMENT_ID
   AND PD.DELETE_SW = 'N'
   AND PH.DELETE_SW = 'N'
      AND CAST(PD.CLIENT_ID AS CHARACTER VARYING) = CL.CJAMSPID :: CHARACTER VARYING
     AND CL.ACTIVEFLAG = 1
      AND FAM.ELIGIBILITY_STATUS_CD IS NOT NULL
      AND FAM.FUND_ALLOCATION_DATE BETWEEN CAST(START_DATE AS DATE) AND CAST(END_DATE  AS DATE)   --DATE(PREV_MONTH_FIRST_DAY) AND DATE(PREV_MONTH_LAST_DAY) 
) AS BB);
END;
$function$

