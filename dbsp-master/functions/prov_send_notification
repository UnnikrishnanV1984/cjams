CREATE OR REPLACE FUNCTION prov_send_notification(notificationuserid character varying, from_userid character varying, to_userid character varying, usernotificationtypekey character varying, priorityleveltypekey character varying, subject character varying, body text, intakeserviceid character varying, isexternalentity boolean DEFAULT false, v_hasattachments boolean DEFAULT false, v_objecttype character varying DEFAULT NULL::character varying, v_entityid character varying DEFAULT NULL::character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                          
 DECLARE                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                          
 v_usernotificationid uuid;                                                                                                                                                                                                                                                                                                                               
 v_date timestamp without time zone;                                                                                                                                                                                                                                                                                                                      
 v_isexternalentity boolean;  
 v_provider_id character varying;                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                          
 BEGIN                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                          
 v_date:= now();                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                          
 select provider_id into v_provider_id from tb_provider where provider_id::character varying = to_userid and delete_sw = 'N' ;

 IF(v_provider_id  = to_userid) then 
        
        INSERT INTO prov_usernotification (securityusersid,usernotificationtypekey,                                                                                                                                                                                                                                                                                   
        objectid,objecttype, provider_id, activeflag,subject,priorityleveltypekey,body,isexternalentity,updatedby,                                                                                                                                                                                                                                                                        
        updatedon,insertedby,insertedon,effectivedate,ismailsent,hasattachments, old_id)                                                                                                                                                                                                                                                                                                
        VALUES (null, usernotificationtypekey, intakeserviceid,v_objecttype, v_provider_id, 1, subject,                                                                                                                                                                                                                                                                        
                priorityleveltypekey, body,isexternalentity, from_userid,                                                                                                                                                                                                                                                                                        
                v_date, from_userid,v_date,v_date,false,v_hasattachments, v_entityid)  RETURNING "usernotificationid" INTO  v_usernotificationid;                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                                                                                                
        INSERT INTO prov_usernotificationmap(usernotificationid,fromsecurityusersid,tosecurityusersid,isread,                                                                                                                                                                                                                                                         
        effectivedate,activeflag,updatedby,                                                                                                                                                                                                                                                                                                                      
        updatedon,insertedby,insertedon)                                                                                                                                                                                                                                                                                                                         
        VALUES (v_usernotificationid, from_userid,null, false,                                                                                                                                                                                                                                                                                              
                v_date, 1, from_userid,                                                                                                                                                                                                                                                                                                                          
                v_date, from_userid,v_date);

 ELSE
        
 
        INSERT INTO prov_usernotification (securityusersid,usernotificationtypekey,                                                                                                                                                                                                                                                                                   
        objectid,objecttype,activeflag,subject,priorityleveltypekey,body,isexternalentity,updatedby,                                                                                                                                                                                                                                                                        
        updatedon,insertedby,insertedon,effectivedate,ismailsent,hasattachments)                                                                                                                                                                                                                                                                                                
        VALUES (notificationuserid, usernotificationtypekey, intakeserviceid,v_objecttype, 1, subject,                                                                                                                                                                                                                                                                        
                priorityleveltypekey, body,isexternalentity, from_userid,                                                                                                                                                                                                                                                                                        
                v_date, from_userid,v_date,v_date,false,v_hasattachments)  RETURNING "usernotificationid" INTO  v_usernotificationid;                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                                                                                                
        INSERT INTO prov_usernotificationmap(usernotificationid,fromsecurityusersid,tosecurityusersid,isread,                                                                                                                                                                                                                                                         
        effectivedate,activeflag,updatedby,                                                                                                                                                                                                                                                                                                                      
        updatedon,insertedby,insertedon)                                                                                                                                                                                                                                                                                                                         
        VALUES (v_usernotificationid, from_userid,to_userid, false,                                                                                                                                                                                                                                                                                              
                v_date, 1, from_userid,                                                                                                                                                                                                                                                                                                                          
                v_date, from_userid,v_date);                                                                                                                                                                                                                                                                                                                     

 END IF;

 RETURN 'success' ;                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                          
 END;                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                          
 $function$

