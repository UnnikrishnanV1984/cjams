CREATE OR REPLACE FUNCTION prov_get_formatted_addresses_djs_part2(v_providerid integer)
 RETURNS TABLE(provider_adr character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 

 v_adrformat character varying;

BEGIN 
 

return query

select 
concat(
provadd.adr_city_nm, ',',
provadd.adr_country_tx,
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_county_cd) and pv.picklist_type_id = 104 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), ' ',
(case when provadd.adr_county_cd is not null then ', ' end),
(select value_tx from tb_picklist_values pv where trim(pv.picklist_value_cd) = trim(provadd.adr_state_cd) and pv.picklist_type_id = 211 and pv.delete_sw = 'N' and pv.active_sw <> 'N'), '- ',
provadd.adr_zip5_no, ' ',
provadd.adr_postal_code_tx, ' ',
provadd.adr_county_cd_tx, ' '
)::character VARYING

from prov.tb_provider_addresses provadd 
where 
provadd.parent_key_id = v_providerid 
and provadd.delete_sw='N' 
and provadd.adr_default_sw ='Y' 
and provadd.adr_type_cd =3357 
limit 1 ;

end;

$function$

