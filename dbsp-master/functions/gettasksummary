CREATE OR REPLACE FUNCTION gettasksummary(investigationid uuid, v_securityusersid character varying)
 RETURNS TABLE(openedcount bigint, closedcount bigint, totalcount bigint)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                
                                                                                                                                                              
                                                                                                                                                              
 BEGIN                                                                                                                                                        
                                                                                                                                                              
                                                                                                                                                              
 RETURN QUERY                                                                                                                                                 
  select cast( sum(opencount) as bigint) as openedcount,                                                                                                      
  cast( sum(closecount) as bigint) as closedcount,                                                                                                            
  cast( sum(closecount)+sum(opencount) as bigint) as totalcount from(                                                                                         
  select case lower(atst.typedescription)  when 'open' then sum(coalesce(taskcount,0)) else 0 end as opencount,                                               
      case lower(atst.typedescription ) when 'closed' then sum(coalesce(taskcount,0)) else 0 end as closecount   from activitytaskstatustype atst   left join(
  select at.activitytaskstatustypekey, count(1) as taskcount from activitytask at                                                                             
          inner join activity a  on a.activityid = at.activityid and a.activeflag =1                                                                          
                                                                                                                                                              
  and a.objectid =investigationid  and at.activeflag =1                                                                                                       
  --and at.assignedto =  case coalesce(v_securityusersid,'') when '' then at.assignedto else v_securityusersid end                                               
  group by  at.activitytaskstatustypekey                                                                                                                      
  ) as at on at.activitytaskstatustypekey = atst.activitytaskstatustypekey                                                                                    
  where lower(atst.activitytypekey) in('investigation','allegation') and atst.activeflag =1                                                                   
  group by atst.typedescription) a;                                                                                                                           
 END;                                                                                                                                                         
                                                                                                                                                              
 $function$

