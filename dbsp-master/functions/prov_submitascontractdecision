if v_appstatustext = 'Returned to worker' then
   response := (objectls->>'tosecurityusersid')::json;
end if;




   INSERT INTO tb_provider_decision
      (decisionid, eventcode, fromsecurityusersid, fromroleid, objectid, activeflag, insertedby, insertedon, updatedby, updatedon, isreviewrequest, remarks, status, decisiondate,
      toroleid,tosecurityusersid, signature)
      VALUES(gen_random_uuid(),objectls->>'eventcode', v_fromsecurityuserid, v_role_name, v_objectid, 1, v_fromsecurityuserid, now(), v_fromsecurityuserid,
      now(), false, objectls->>'remarks', v_appstatus,  now(),null,v_tosecurityuserid,  v_sign);


 
      SELECT prov_send_notification into v_success
      FROM  prov_send_notification(v_tosecurityuserid, v_fromsecurityuserid, v_tosecurityuserid, 'System', 'High', v_subject, v_subject, v_objectid,  false, false);
   
RETURN json_build_object('response',v_success);
