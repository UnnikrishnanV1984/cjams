v_sign json;
v_appstatus character varying;
response json;
v_type character varying;
v_username CHARACTER VARYING;
v_appstatustext CHARACTER VARYING;
v_objectname CHARACTER VARYING;
v_role_name CHARACTER VARYING;
v_list_user_roles record;

begin
v_fromsecurityuserid := objectls->>'fromsecurityusersid';

v_appstatus := objectls->>'status';
v_username := objectls->>'username';
v_objectname := objectls->>'objectname';
v_objectid := objectls->>'objectid';
v_remarks := objectls->>'remarks';
v_eventcode := objectls->>'eventcode';
v_phase := objectls->>'phase';
v_sign := objectls->>'signature';
v_role_name := objectls->>'fromroleid';
v_tosecurityuserid := objectls->>'tosecurityusersid';

---------------
if v_eventcode = 'ASCON'
then
   v_type = 'AS Contract';
end if;
---------------
if v_appstatus = 'Submit'
then
   v_appstatustext = 'Submitted for approval';
else 
   if v_appstatus = 'Approved'
   then
      v_appstatustext = 'Approved';
   else 
      v_appstatustext = 'Returned to worker';
   end if;
end if;


v_subject := v_type||' "'||v_objectname||'" '|| v_appstatustext||' by ' ||v_username ;
   
