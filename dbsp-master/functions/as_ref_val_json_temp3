CREATE OR REPLACE FUNCTION as_ref_val_json_temp3(v_input character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$ 

 declare 
 v_result json;
 testing1 character varying;
 
 begin
     
    if v_input is not null then
    begin
    execute 'SELECT array_agg('||v_input||'::TEXT) --into testing1
       FROM test_table' into testing1;
   
   raise notice 'Test: %', testing1;
     select
    json_agg(row) as output
     from
   (
    select distinct ref_key,  
    value_text
   from
    referencevalues             
   where
   ref_key in (
   select
    regexp_split_to_table(translate(testing1, '!@#$%^`{}"-&*()',''), ',')    
   from
    TEST_TABLE)) row into
   v_result;
  
 EXCEPTION
            WHEN NO_DATA_FOUND THEN
                RETURN 0;
 end;
 end if;
 return v_result;

 end;

 $function$

