CREATE OR REPLACE FUNCTION complaintsummary(i_personid uuid, pagenumber bigint, pagesize bigint, i_searchtext character varying)
 RETURNS TABLE(totalcount bigint, offensedate text, allegationname character varying[], adjudicateddecision json, complaintid character varying, intakeservicerequestevaluationid uuid, petitionid character varying, intakeservicerequestpetitionid uuid, petitiontype character varying, hearingtype character varying, hearingdatetime timestamp without time zone)
 LANGUAGE plpgsql
AS $function$


declare querytxt text;
declare youthstatussearch character varying;

begin
 
 if(i_searchtext != '' and i_searchtext is not null)
 then 
youthstatussearch := ' AND fp.focuspersonstatustypekey = ''' || i_searchtext || '''';    
 else
 youthstatussearch='';
 end if;
 querytxt='
select  count(1) over() as totalcount,
case when INTSRE.unknownrange=0 then to_char(INTSRE.offensedate,''MM/DD/YYYY'') 
 when INTSRE.unknownrange=1 then '''' :: character varying 
  when INTSRE.unknownrange=2 then to_char(INTSRE.begindate,''MM/DD/YYYY'')|| ''- '' || to_char(INTSRE.enddate,''MM/DD/YYYY'')
end as offensedate,
(select array_agg(AG.name)  from  allegation AG
      join intakeservicerequestevaluationconfig ITSEC  on ITSEC.allegationid=AG.allegationid and AG.activeflag=1
      where  ITSEC.intakeservicerequestevaluationid=INTSRE.intakeservicerequestevaluationid and ITSEC.activeflag=1 )as allegationname,
  (select json_agg(x) from (select AG."name" as allegationname,ADT.description as adjudicateddecisiontype
,  (select string_agg(CAT.description,'','') as courtActions from intakeservicerequestcourtactiontype INTSRCAT
join courtactiontype CAT on CAT.courtactiontypekey=INTSRCAT.courtactiontypekey and INTSRCAT.activeflag=1
where  INTSRCAT.courtactionallegationconfigid=CAC.courtactionallegationconfigid and INTSRCAT.activeflag=1) as courtActions,
    
    (select string_agg(COTY.description,'','') as courtOrder from intakeservicerequestcourtordertypeconfig INTSRCOTC
join courtordertype COTY on COTY.courtordertypekey=INTSRCOTC.courtordertypekey and INTSRCOTC.activeflag=1
 where  INTSRCOTC.courtactionallegationconfigid=CAC.courtactionallegationconfigid  and INTSRCOTC.activeflag=1
) as courtOrder,
    
    (select string_agg(COTY.description,'','') as courtCondition from  intakeservicerequestcourtconditiontypeconfig INTSRCOTC
join conditiontype COTY on COTY.conditiontypekey=INTSRCOTC.conditiontypekey and INTSRCOTC.activeflag=1
 where  INTSRCOTC.courtactionallegationconfigid=CAC.courtactionallegationconfigid and INTSRCOTC.activeflag=1) as courtCondition
from courtactionallegationconfig CAC
      join intakeservicerequestcourtaction INA on INA.intakeservicerequestcourtactionid=CAC.intakeservicerequestcourtactionid and INA.activeflag=1
      join allegation AG on AG.allegationid=CAC.allegationid and AG.activeflag=1
      join adjudicateddecisiontype ADT on ADT.adjudicateddecisiontypekey=CAC.adjudicateddecisiontypekey and ADT.activeflag=1
      where CAC.intakeservicerequestcourtactionid=INTSRCA.intakeservicerequestcourtactionid and CAC.activeflag=1) as x ) as adjudicateddecision
            ,INTSRE.complaintid ,INTSRE.intakeservicerequestevaluationid,INTSRP.petitionid,INTSRP.intakeservicerequestpetitionid, PT.description as petitiontype,HT.description as hearingtype,INTSRPH.hearingdatetime
      from intakeservicerequestevaluation INTSRE  
   left join Intakeservreqevalpetitionconfig INTSREPC on INTSRE.intakeservicerequestevaluationid =INTSREPC.intakeservicerequestevaluationid and INTSREPC.activeflag=1 
   left join intakeservicerequestpetition INTSRP on INTSRP.intakeservicerequestpetitionid =INTSREPC.intakeservicerequestpetitionid and INTSRP.activeflag=1
   left join petitiontype PT on PT.petitiontypekey=INTSRP.petitiontypekey and PT.activeflag=1
   left join Intakeservreqpetitionhearingconfig INTSRPHC on INTSRPHC.intakeservicerequestpetitionid =INTSRP.intakeservicerequestpetitionid and INTSRPHC.activeflag=1
   left join Intakeservicerequestcourthearing INTSRPH on INTSRPH.intakeservicerequestcourthearingid = INTSRPHC.intakeservicerequestcourthearingid and INTSRPH.activeflag=1
   join  hearingtype HT on INTSRPH.hearingtypekey=HT.hearingtypekey and HT.activeflag=1 and HT.description =''Adjudication''   
   join intakeservicerequestcourtaction INTSRCA on INTSRCA.intakeservicerequestcourthearingid=INTSRPH.intakeservicerequestcourthearingid and INTSRCA.activeflag=1
   where INTSRE.intakenumber--=''I201800647859''
   in (
select INTSR.intakenumber from intakeservicerequest INTSR 
   join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1
   join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype=''Youth''
   join person p on Acc.personid=p.personid and p.activeflag=1
   join focuspersoncasestatus fp on fp.personid=p.personid and fp.activeflag=1 
   where ACC.personid ='''||i_personid||''''||youthstatussearch||') limit  '||pagesize||'  offset '||pagenumber;
   --where ACC.personid =i_personid) limit pagesize offset pagenumber;
   return query execute querytxt;
    
 end


$function$

