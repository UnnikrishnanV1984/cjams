CREATE OR REPLACE FUNCTION as_getdatypeconfiglist(page integer, size integer, orderby text)
 RETURNS json
 LANGUAGE plpgsql
AS $function$

DECLARE
DECLARE result json;
DECLARE totalcount integer;
DECLARE order_by character varying;
DECLARE sort_by character varying ;
BEGIN
RAISE NOTICE 'orderby % ', orderby;
      totalcount := 0;
      order_by := orderby;
RAISE NOTICE 'order_by % ', order_by;
sort_by:='asc';
      IF page = 1 THEN
             SELECT COUNT(*) into totalcount FROM servicerequesttypeconfig A;
       END IF;
     
       SELECT array_to_json(array_agg(e)) FROM
      (SELECT array_to_json(array_agg(row_to_json(d))) as "data",totalcount as "count" from (
SELECT A.servicerequesttypeconfigid,
       --split_part(G.entityroletypekey, '|', 1) AS datype,
       B.intakeservreqtypekey AS datype,
       --split_part(G.entityroletypekey, '|', 2) AS subtype,
       C.classkey AS subtype,
       -- as da_type_subtype,
       A.intakeservicerequestplantypekey as plantype,
       COALESCE(A.workLoad,0) AS workload_basis,
       A.internalfile,
       A.duedateoffset,
       A.limitedrouting,
       A.focusroletype,
       A.effectivedate,
       A.expirationdate,
       A.category,
       A.insertedon,
       A.activeFlag,
       B.intakeservreqtypekey ,
        A.displaydatype,
        A.displaydasubtype
FROM servicerequesttypeconfig A 
INNER JOIN intakeservicerequesttype B on B.intakeservreqtypeid = A.IntakeServReqTypeId
Inner Join servicerequestsubtype C on C.servicerequestsubtypeid = A.servicerequestsubtypeid
left outer JOIN servicerequesttypeconfigrole G on G.servicerequesttypeconfigid = A.servicerequesttypeconfigid
where A.ActiveFlag=1 
--and G.EntityRoleType = 'DisplayValue'
group by A.servicerequesttypeconfigid,
         --G.entityroletypekey,
          B.intakeservreqtypekey,
 C.classkey,
         A.intakeservicerequestplantypekey,
         A.workLoad,
         A.internalfile,
         A.duedateoffset,
         A.limitedrouting,
         A.focusroletype,
         A.effectivedate,
         A.expirationdate,
         A.category,
         A.activeFlag,
            B.intakeservreqtypekey,
             A.displaydatype,
        A.displaydasubtype
        ORDER BY   B.intakeservreqtypekey asc
       
          
          LIMIT size OFFSET page - 1)d)e INTO result;
         
RETURN COALESCE(result,'[]');

END; 
$function$

