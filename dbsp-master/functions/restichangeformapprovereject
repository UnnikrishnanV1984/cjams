CREATE OR REPLACE FUNCTION restichangeformapprovereject(restitution json, securityuserid character varying)
 RETURNS uuid
 LANGUAGE plpgsql
AS $function$

DECLARE

 v_restitutionno int;
 v_securityuserid character varying;
 v_intakeserreqrestitutionid uuid;
 v_approvestatus character varying;
 l_status character varying;
 l_routingstatusid int;
 
 v_paidamount numeric(10,2);
 v_allocatedamount numeric(10,2);
 
BEGIN
 
 v_intakeserreqrestitutionid := restitution->>'intakeserreqrestitutionid';
 v_restitutionno := restitution->>'restitutionno';
 v_approvestatus := restitution->>'approvestatus';
 v_securityuserid := securityuserid;
 
 SELECT paidamount, allocatedamount INTO v_paidamount, v_allocatedamount FROM intakeserreqrestitution WHERE restitutionno = v_restitutionno AND activeflag = 1 AND approvestatus = 'RSTAPR';
 
 IF v_approvestatus = 'RSTAPR' THEN
  l_routingstatusid:= 47;
  UPDATE intakeserreqrestitution SET activeflag = 0 WHERE restitutionno = v_restitutionno AND activeflag = 1 and intakeserreqrestitutionid != v_intakeserreqrestitutionid;
 ELSE
  l_routingstatusid:= 48;
 END IF;
 
 UPDATE intakeserreqrestitution SET approvestatus = v_approvestatus, paidamount = v_paidamount, allocatedamount = v_allocatedamount WHERE intakeserreqrestitutionid = v_intakeserreqrestitutionid;
 
 select routingintake into l_status from routingintake (v_intakeserreqrestitutionid::character varying,v_securityuserid, 'RTCF', l_routingstatusid, null);
 
RETURN
   v_intakeserreqrestitutionid;
END;

$function$

