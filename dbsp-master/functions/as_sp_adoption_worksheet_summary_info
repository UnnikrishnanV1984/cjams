CREATE OR REPLACE FUNCTION as_sp_adoption_worksheet_summary_info(al_client_id bigint, al_removal_id bigint DEFAULT NULL::bigint)
 RETURNS TABLE(client_id bigint, servicecaseid uuid, casenumber character varying, childagency character varying, childjurisdiction character varying, removaldate timestamp without time zone, removalage integer, adpfatherclientid bigint, adpmotherclientid bigint, adpfathername character varying, removalid bigint, removaltype character varying, removalcourtorderdate timestamp without time zone, adpmothername character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm      VARCHAR(100) DEFAULT 'sp_adoption_worksheet_summary_info';
  vn_srv_req_id      UUID;
  vs_srv_req_no      VARCHAR(50);
  vs_chd_agcy       VARCHAR(50);
  vs_jrsdctn       VARCHAR(50);
  vd_child_rmvl_dt     TIMESTAMP;
  vn_child_age_rmvl     INTEGER;
  v_adp_fther_id                      BIGINT;
  v_adp_mthr_id                       BIGINT;
  v_adp_fthr_nm                       VARCHAR(50);
  v_adp_mthr_nm                       VARCHAR(50);
  vd_removal_id                       BIGINT;
  vd_removal_type                     VARCHAR;
  vd_child_rmvl_crt_ord_dt            TIMESTAMP;
  

 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_summary_info ( 
  client_id          BIGINT,
  servicecaseid        UUID,
  casenumber         VARCHAR(50),
  childagency         VARCHAR(50),
  childjurisdiction       VARCHAR(50),
  removaldate         TIMESTAMP,
  removalage         INTEGER, 
  adpfatherclientid                           BIGINT,
  adpmotherclientid                           BIGINT,
  adpfathername                               VARCHAR(50),
  removalid         BIGINT,
  removaltype         VARCHAR,
  removalcourtorderdate      TIMESTAMP,
  adpmothername                               VARCHAR(50)
 ); 
                  
-- Service Case ID  
SELECT ap.servicecaseid 
  INTO vn_srv_req_id
FROM adoptionplanning ap, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per
WHERE ap.servicecaseid = pp.servicecaseid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY ap.updatedon DESC LIMIT 1;

-- Case Number  
SELECT sc.servicecasenumber
  INTO vs_srv_req_no
FROM adoptionplanning ap, permanencyplan pp, servicecase sc, tb_placement tp, intakeservicerequestactor isra, person per
WHERE ap.servicecaseid = pp.servicecaseid AND pp.activeflag = 1
 AND pp.servicecaseid = sc.servicecaseid AND sc.activeflag = 1
 AND tp.case_id = sc.servicecasenumber::BIGINT AND tp.delete_sw = 'N' 
 AND isra.intakeservicerequestactorid = tp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY ap.updatedon DESC LIMIT 1;

-- Child Agency
SELECT (CASE WHEN teamtypekey = 'CW' THEN
    'DHS'::VARCHAR 
   WHEN teamtypekey = 'DJS' THEN
    'DJS'::VARCHAR
   ELSE NULL END)
 INTO vs_chd_agcy  
 FROM intakeservicerequest isr, permanencyplan pp, intakeservicerequestactor isra, person per 
WHERE pp.servicecaseid = isr.servicecaseid AND pp.activeflag = 1
 AND isra.intakeservicerequestactorid = pp.intakeservicerequestactorid AND isra.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Child Jurisdiction  
SELECT peradr.county
  INTO vs_jrsdctn
   FROM person per, personaddress peradr
WHERE per.personid = peradr.personid AND peradr.activeflag = 1
 AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Child Removal Date
SELECT isrcr.removaldate , (case when isrcr.removaltypekey = 'JD' then 'court'  when isrcr.removaltypekey in ('CDVP', 'EHA', 'TLV') then 'VPA' else null end )
 INTO vd_child_rmvl_dt , vd_removal_type
   FROM intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra     
WHERE isra.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid AND isra.activeflag = 1 and isrcr.removalid::BIGINT = al_removal_id
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY isrcr.updatedon DESC LIMIT 1;

-- Removal Court Order Date
SELECT ( CASE WHEN (isrcr.removaltypekey = 'JD') 
    THEN (select MIN(isrco.courtorderdate)::timestamp from intakeservreqcourtorder isrco
    WHERE isrco.servicecaseid =  isrcr.servicecaseid AND isrco.activeflag = 1) ELSE NULL END )
 INTO vd_child_rmvl_crt_ord_dt
   FROM intakeservreqchildremoval isrcr, placement pl, intakeservicerequestactor isra, person per 
WHERE pl.intakeservreqchildremovalid = isrcr.intakeservreqchildremovalid AND pl.activeflag = 1 AND pl.placementtypekey = 'PRPL' and isrcr.removalid::BIGINT = al_removal_id
 AND isra.servicecaseid = pl.servicecaseid AND isra.activeflag = 1 AND isra.intakeservicerequestpersontypekey = 'CHILD' AND isra.intakeservicerequestactorid = pl.intakeservicerequestactorid 
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1;

-- Child Age At Removal
SELECT extract('years' FROM isrcr.removaldate)::int -  extract('years' FROM per.dob)::int
 INTO vn_child_age_rmvl
   FROM intakeservreqchildremoval isrcr, intakeservicerequestactor isra, person per 
WHERE isrcr.intakeservicerequestactorid = isra.intakeservicerequestactorid AND isrcr.activeflag = 1
 AND isra.intakeservicerequestactorid = isrcr.intakeservicerequestactorid AND isra.activeflag = 1 and isrcr.removalid::bigint = al_removal_id
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 ORDER BY isrcr.updatedon DESC LIMIT 1;

-- Adoptive parents info

select tba.adoptive_father_id , tba.adoptive_mother_id , concat(per1.firstname , ' ' , per1.lastname), concat(per2.firstname , ' ' , per2.lastname) 
 into v_adp_fther_id , v_adp_mthr_id , v_adp_fthr_nm , v_adp_mthr_nm
 from tb_adoption tba , person per1 , person per2
where tba.client_id::BIGINT = al_client_id and per1.cjamspid = tba.adoptive_father_id and per2.cjamspid = tba.adoptive_mother_id;



INSERT INTO Temp_worksheet_summary_info
SELECT 
  al_client_id,
  vn_srv_req_id,
  vs_srv_req_no,
  vs_chd_agcy,
  vs_jrsdctn,
  vd_child_rmvl_dt,
  vn_child_age_rmvl,
  v_adp_fther_id,
  v_adp_mthr_id,
  v_adp_fthr_nm,
  vd_removal_id,
  vd_removal_type,
  vd_child_rmvl_crt_ord_dt,
  v_adp_mthr_nm;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_summary_info;
              
DROP TABLE Temp_worksheet_summary_info;

   END
    $function$

