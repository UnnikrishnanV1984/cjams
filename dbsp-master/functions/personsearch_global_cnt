CREATE OR REPLACE FUNCTION personsearch_global_cnt(searchobj json)
 RETURNS SETOF bigint
 LANGUAGE plpgsql
AS $function$

DECLARE 
v_lFirstNameSoundEx VARCHAR(50);
v_lLastNameSoundEx VARCHAR(50);
v_ldNow    TIMESTAMP(3);
v_liPageNumber  INT;
v_liPageSize   INT;
v_lvFirstName  VARCHAR(50);
v_lvLastName   VARCHAR(50);
v_liAge    INT;
v_lvRace    VARCHAR(15);
v_lvGender   VARCHAR(15);
v_lvPidVal   VARCHAR(50);
v_lvPidType   VARCHAR(15);
v_lvCity    VARCHAR(32);
v_lvAddress   VARCHAR(100);
v_lvZip    VARCHAR(32);
v_lvState   VARCHAR(32);
v_lvCounty   VARCHAR(32);
v_lvPhone   VARCHAR(32);
v_ldDOB    TIMESTAMP(3);
v_liActiveFlag  INT;
v_lvRoleType   VARCHAR(10);
v_lvRoleSubType  TEXT;
v_liCount   INT;
v_lvSortCol   VARCHAR(50);
v_lvSortDir   VARCHAR(10);
v_lvInterfaceType VARCHAR(20);
v_liCommaPos   INT;
v_liPersonFlag    CHAR(1);
v_liDangerous     INT;
v_liRegion   INT;
v_ldDOBFrom   TIMESTAMP(3);
v_ldDOBTo   TIMESTAMP(3);
v_lSSNType VARCHAR(50);
v_lSSNValue VARCHAR(50);
v_lDCNType VARCHAR(50);
v_lDCNValue VARCHAR(50);

BEGIN
CREATE TEMP TABLE sp_tempCount_searchParams(paramKeyword VARCHAR(50),paramValue VARCHAR(1000));
CREATE TEMP TABLE sp_tempCount_RoleSubTypes (RoleSubType VARCHAR(100) );
CREATE TEMP TABLE sp_tempCount_PersonIdentityTypes (paramValue VARCHAR(50));
CREATE TEMP TABLE sp_tempCount_PersonIdentityValues (paramtype VARCHAR(50),paramValue VARCHAR(50));

v_liPageNumber := searchObj ->> 'pagenumber' ;
v_liPageSize := searchObj ->> 'pagesize' ;
v_lvFirstName := searchObj ->> 'firstname';
v_lvLastName := searchObj ->> 'lastname'; 
v_liAge := searchObj ->> 'age'; 
v_lvRace := searchObj ->> 'race'; 
v_lvGender := searchObj ->> 'gender'; 

v_lvCity := searchObj ->> 'city'; 
v_lvAddress := searchObj ->> 'address'; 
v_lvZip := searchObj ->> 'zip'; 
v_lvState := searchObj ->> 'state'; 
v_lvCounty := searchObj ->> 'county'; 
v_lvPhone := searchObj ->> 'phone'; 
v_ldDOB := searchObj ->> 'dob' ;
v_liActiveFlag := searchObj ->> 'activeflag';
v_lvRoleType := searchObj ->> 'roletype'; 
v_lvRoleSubType := searchObj ->> 'rolesubtype'; 
v_lvSortCol := searchObj ->> 'sortcol'; 
v_lvSortDir := searchObj ->> 'sortdir';
v_lvInterfaceType := searchObj ->> 'interfacetype'; 
v_liPersonFlag := searchObj ->> 'personflag';
v_liDangerous := searchObj ->> 'dangerous';
v_liRegion := searchObj ->> 'region'; 
v_ldDOBFrom := searchObj ->> 'dobfrom'; 
v_ldDOBTo := searchObj ->> 'dobto';

RAISE NOTICE 'v_liPageNumber %', v_liPageNumber ;
RAISE NOTICE 'v_liPageSize %', v_liPageSize ;
RAISE NOTICE 'v_lvFirstName %', v_lvFirstName ;
RAISE NOTICE 'v_lvLastName %', v_lvLastName ;
RAISE NOTICE 'v_liAge %', v_liAge ;
RAISE NOTICE 'v_lvRace %', v_lvRace ;
RAISE NOTICE 'v_lvGender %', v_lvGender ;

RAISE NOTICE 'v_lvCity %', v_lvCity ;
RAISE NOTICE 'v_lvAddress %', v_lvAddress ;
RAISE NOTICE 'v_lvZip %', v_lvZip ;
RAISE NOTICE 'v_lvState %', v_lvState ;
RAISE NOTICE 'v_lvCounty %', v_lvCounty ;
RAISE NOTICE 'v_lvPhone %', v_lvPhone ;
RAISE NOTICE 'v_ldDOB %', v_ldDOB ;
RAISE NOTICE 'v_liActiveFlag %', v_liActiveFlag ;
RAISE NOTICE 'v_lvRoleType %', v_lvRoleType ;
RAISE NOTICE 'v_lvRoleSubType %', v_lvRoleSubType ;
RAISE NOTICE 'v_lvSortDir %', v_lvSortDir ;
RAISE NOTICE 'v_lvSortCol %', v_lvSortCol ;
RAISE NOTICE 'v_lvInterfaceType %', v_lvInterfaceType ;
RAISE NOTICE 'v_liPersonFlag %', v_liPersonFlag ;
RAISE NOTICE 'v_liDangerous %', v_liDangerous ;
RAISE NOTICE 'v_liRegion %', v_liRegion ;
RAISE NOTICE 'v_ldDOBFrom %', v_ldDOBFrom ;
RAISE NOTICE 'v_ldDOBTo %', v_ldDOBTo;

INSERT INTO sp_tempCount_searchParams( paramKeyword, paramValue) 
  values 
  ('pagenumber',searchObj ->> 'pagenumber'),
  ('pagesize',searchObj ->> 'pagesize '),
  ('firstname',searchObj ->> 'firstname'),
  ('lastname',searchObj ->> 'lastname'),
  ('age',searchObj ->> 'age'),
  ('race',searchObj ->> 'race'),
  ('gender',searchObj ->> 'gender'),
  ('city',searchObj ->> 'city'),
  ('address',searchObj ->> 'address'),
  ('zip',searchObj ->> 'zip'),
  ('state',searchObj ->> 'state'),
  ('county',searchObj ->> 'county'),
  ('phone',searchObj ->> 'phone'),
  ('dob',searchObj ->> 'dob'),
  ('activeflag',searchObj ->> 'activeflag'),
  ('roletype',searchObj ->> 'roletype'),
  ('rolesubtype',searchObj ->> 'rolesubtype'),
  ('count',searchObj ->> 'count'),
  ('sortcol',searchObj ->> 'sortcol'),
  ('sortdir',searchObj ->> 'sortdir'),
  ('interfacetype',searchObj ->> 'interfacetype'),
  ('commapos',searchObj ->> 'commapos'),
  ('personflag',searchObj ->> 'personflag'),
  ('dangerous',searchObj ->> 'dangerous'),
  ('region',searchObj ->> 'region'),
  ('dobfrom',searchObj ->> 'dobfrom'),
  ('dobto',searchObj ->> 'dobto'),
  ('DCN',searchObj ->> 'dcn'),
  ('SSN',searchObj ->> 'ssn');

  
IF (LENGTH(v_lvState) > 2)
    THEN
        SELECT   ST.StateAbbr INTO v_lvState
        FROM State  ST
        WHERE ST.StateName =  v_lvState;
    END IF;

IF v_lvFirstName IS NULL THEN
     v_lvFirstName := '';
    END IF;
 
IF v_lvLastName IS NULL THEN
     v_lvLastName := '';
    END IF;
 
IF (v_liActiveFlag = -1 OR v_liActiveFlag is null) THEN
 v_liActiveFlag := NULL;
    END IF;

/*v_lFirstNameSoundEx  := COALESCE(MoSoundEx(v_lvFirstName ),'');
v_lLastNameSoundEx  :=  COALESCE(MoSoundEx(v_lvLastName),'');*/

v_lFirstNameSoundEx  := '';
v_lLastNameSoundEx   := '';

IF COALESCE(v_lvSortCol, 'x') NOT IN ('LastName', 'FirstName', 'DOB', 'DangerLevel') THEN
     v_lvSortCol := 'LastName';
    END IF;
 
IF COALESCE(v_lvSortDir, 'x') NOT IN ('Asc', 'Desc') THEN
 v_lvSortDir := 'Asc';
END IF;

IF v_lvRoleSubType IS NOT NULL
 THEN
     v_liCommaPos := POSITION(',' IN  v_lvRoleSubType);
     WHILE v_liCommaPos IS NOT NULL AND v_liCommaPos <> 0
     LOOP
      INSERT INTO sp_tempCount_RoleSubTypes (RoleSubType) VALUES (LTRIM(SUBSTRING(v_lvRoleSubType, 0, v_liCommaPos)));
      v_lvRoleSubType := SUBSTRING(v_lvRoleSubType, v_liCommaPos + 1, len(v_lvRoleSubType));
      v_liCommaPos := POSITION(',' IN  v_lvRoleSubType);
     END LOOP;
     INSERT INTO sp_tempCount_RoleSubTypes (RoleSubtype) VALUES (LTRIM(v_lvRoleSubType));
    END IF;

IF v_lvInterfaceType IS NULL THEN
     v_lvInterfaceType := 'Normal';
END IF;

INSERT INTO sp_tempCount_PersonIdentityTypes 
SELECT paramKeyword
    FROM sp_tempCount_searchParams
    WHERE paramKeyword = 'DCN' and paramValue is not null;

INSERT INTO sp_tempCount_PersonIdentityTypes 
SELECT paramKeyword
FROM sp_tempCount_searchParams
WHERE paramKeyword = 'SSN' and paramValue is not null;
INSERT INTO sp_tempCount_PersonIdentityValues
SELECT paramKeyword,paramValue
    FROM sp_tempCount_searchParams
    WHERE paramKeyword = 'SSN';
INSERT INTO sp_tempCount_PersonIdentityValues
SELECT paramKeyword,paramValue
FROM sp_tempCount_searchParams
WHERE paramKeyword = 'DCN';

SELECT PIT.paramValue INTO v_lSSNType
    FROM sp_tempCount_PersonIdentityTypes  PIT
    WHERE PIT.paramValue = 'SSN';

SELECT PIT.paramValue INTO v_lDCNType
    FROM sp_tempCount_PersonIdentityTypes  PIT
    WHERE PIT.paramValue = 'DCN';

 SELECT PIV.paramValue INTO v_lDCNValue
    FROM sp_tempCount_PersonIdentityValues PIV where PIV.paramtype = 'DCN';
    --WHERE PIV.parmValue = 'SSN'

SELECT PIV.paramValue INTO v_lSSNValue
FROM sp_tempCount_PersonIdentityValues PIV where PIV.paramtype = 'SSN';

CREATE TEMP TABLE KeyResults_Count(PersonId uuid , PersonAddressId uuid);
INSERT INTO KeyResults_Count (PersonId)
    SELECT DISTINCT p.PersonId
    /*,(SELECT PRA.PersonAddressId
  FROM PersonAddress PRA
  WHERE PRA.PersonId = p.PersonId
  AND PRA.PersonAddressTypeKey = 'C' AND PRA.ActiveFlag = 1
  ORDER BY PRA.insertedon DESC limit 1)*/
    FROM  Person AS p
    LEFT JOIN PersonIdentifier AS i ON i.PersonId = p.PersonId
    LEFT JOIN PersonAddress  AS a ON a.PersonId = p.PersonId   AND a.PersonAddressTypeKey = 'C' and a.ActiveFlag = 1
    LEFT JOIN PersonPhoneNumber AS pn ON pn.PersonId = p.PersonId
    LEFT JOIN   County    AS c ON  a.county = c.CountyName
    WHERE ( p.LastName ILIKE  v_lvLastName || '%')
    AND  (p.FirstName ILIKE  v_lvFirstName || '%')
    /*( p.LastName LIKE  v_lvLastName || '%' OR COALESCE(p.LastNameSoundex,'') = v_lLastNameSoundEx)
    AND  (p.FirstName LIKE  v_lvFirstName || '%' OR COALESCE(p.FirstNameSoundex,'') = v_lFirstNameSoundEx)
    AND  (v_liAge  IS NULL OR DATEDIFF(YEAR, p.DOB, v_ldNow) = v_liAge)*/
    AND  (v_lvRace IS NULL OR p.RaceTypeKey = v_lvRace)
    AND  (v_lvGender IS NULL OR p.GenderTypeKey = v_lvGender)
    AND  (v_ldDOB  IS NULL OR p.DOB = v_ldDOB)
    AND (v_ldDOBFrom  IS NULL OR (p.DOB BETWEEN v_ldDOBFrom AND v_ldDOBTo))
    AND  p.ActiveFlag = COALESCE(v_liActiveFlag, p.ActiveFlag)
    AND  (v_lvCity IS NULL OR a.city = v_lvCity)
    AND  (v_lvAddress IS NULL OR a.address = v_lvAddress)
    AND  (v_lvZip  IS NULL OR a.zipcode = v_lvZip)
    AND  (v_lvState IS NULL OR a.state = v_lvState)
    AND  (v_lvCounty IS NULL OR a.county = v_lvCounty)
    AND  (v_lvPhone IS NULL OR pn.phoneNumber = v_lvPhone)
    AND  (v_lDCNValue IS NULL OR i.PersonIdentifierValue = v_lDCNValue)
    AND  (v_lDCNType IS NULL OR i.PersonIdentifierTypeKey  = v_lDCNType )
    AND  (v_lSSNValue IS NULL OR i.PersonIdentifierValue = v_lSSNValue)
    AND  (v_lSSNType IS NULL OR i.PersonIdentifierTypeKey = v_lSSNType)
    AND  (v_liDangerous IS NULL OR p.DangerLevel = v_liDangerous)
    AND  (v_liRegion IS NULL OR c.APSRegion = v_liRegion);

 RAISE NOTICE 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-->%',now();
 UPDATE KeyResults_Count as KR SET PersonAddressId  = (SELECT  PRA.PersonAddressId   
                                        FROM PersonAddress PRA   
                                        WHERE PRA.PersonId = KR.PersonId   
                                        AND PRA.PersonAddressTypeKey = 'C' AND PRA.ActiveFlag = 1  
                                        ORDER BY PRA.insertedon DESC  LIMIT 1
                                        );
  RAISE NOTICE 'ffffffffffffffffffffffffffffffffffffffffffff-->%',now();
    CREATE TEMP TABLE FullResults_Count(
     PersonId   uuid,
     PersonRoleId  uuid,
     PersonRoleType  VARCHAR(10),
     PersonRoleSubType text,
     FirstName   VARCHAR(50),
     MiddleName   VARCHAR(32),
     LastName   VARCHAR(50),
     DOB     TIMESTAMP(3) NULL,
     DangerLevel   INT  NULL,
     GenderTypeKey  VARCHAR(15) NULL  ,
     PersonAddressId uuid
    );
    RAISE NOTICE 'gggggggggggggggggggggggggggggggggggggggggg-->%',now();
    IF v_liPersonFlag = 'T'
    THEN
    INSERT INTO FullResults_Count (
      PersonId,
      PersonRoleId,
      PersonRoleType,
      PersonRoleSubType,
      FirstName,
      MiddleName,
      LastName,
      DOB,
      DangerLevel,
      GenderTypeKey,
      PersonAddressId )
    SELECT k.PersonId,
      CAST('00000000-0000-0000-0000-000000000000' as uuid ) AS PersonRoleId,
      CAST ('None' as character varying)  AS PersonRoleType,
      CAST ('' as character varying)   AS PersonRoleSubtype,
      p.FirstName,
      p.MiddleName,
      p.LastName,
      p.DOB,
      p.DangerLevel  AS DangerLevel,
      p.GenderTypeKey ,
      k.PersonAddressId
    FROM KeyResults_Count AS k
    JOIN Person  AS p ON p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'None') = 'None'
    AND v_lvRoleSubType IS NULL;
    ELSE
    INSERT INTO FullResults_Count (
      PersonId,
      PersonRoleId,
      PersonRoleType,
      PersonRoleSubType,
      FirstName,
      MiddleName,
      LastName,
      DOB,
      DangerLevel,
      GenderTypeKey,
      PersonAddressId)
    SELECT k.PersonId,
      CAST('00000000-0000-0000-0000-000000000000' as uuid) AS PersonRoleId,
      CAST ('None' as character varying)  AS PersonRoleType,
      CAST ('' as character varying)   AS PersonRoleSubtype,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel  AS DangerLevel,
      p.GenderTypeKey,
      k.PersonAddressId
    FROM KeyResults_Count AS k
    JOIN Person  AS p ON p.PersonId = k.PersonId
    WHERE NOT EXISTS (
     SELECT 1 FROM Actor AS a WHERE a.PersonId = k.PersonId )
    AND NOT EXISTS (
     SELECT 1 FROM CareGiver AS cg WHERE cg.PersonId = k.PersonId )
    AND NOT EXISTS (
     SELECT 1 FROM ProviderEmployee AS e WHERE e.PersonId = k.PersonId )
    AND COALESCE(v_lvRoleType, 'None') = 'None'
    AND v_lvRoleSubType IS NULL
     UNION ALL
    SELECT k.PersonId,
      a.ActorId,
      'A',
      a.ActorType,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel,
      p.GenderTypeKey,
      k.PersonAddressId
    FROM KeyResults_Count AS k
    JOIN Actor  AS a ON a.PersonId = k.PersonId
    JOIN Person  AS p ON p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'A') = 'A'
    AND  (v_lvRoleSubType IS NULL OR EXISTS (SELECT * FROM sp_tempCount_RoleSubTypes as rst WHERE rst.RoleSubType = a.ActorType limit 1))
    AND  a.ActiveFlag = COALESCE(v_liActiveFlag, a.ActiveFlag)
    AND  ((v_lvInterfaceType = 'Normal'
    AND a.Actortype NOT IN ('EDLC','SOR','DMH','EDLI'))
    OR     (v_lvInterfaceType = 'Interface'
    AND a.ActorType IN ('EDLC','SOR','DMH','EDLI')))
     UNION ALL
    SELECT k.PersonId,
      cg.CareGiverId,
      'CG',
      cg.CareGiverTypeKey,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel ,
      p.GenderTypeKey ,
      k.PersonAddressId
    FROM KeyResults_Count AS k
    JOIN CareGiver AS cg ON cg.PersonId = k.PersonId
    JOIN Person  AS p On p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'CG') = 'CG'
    AND  (v_lvRoleSubType IS NULL OR EXISTS (SELECT * FROM sp_tempCount_RoleSubTypes as rst WHERE rst.RoleSubType = cg.CareGiverTypeKey limit 1))
    AND  cg.ActiveFlag = COALESCE(v_liActiveFlag, cg.ActiveFlag)
    AND  COALESCE(v_lvInterfaceType, '') != 'Interface'
     UNION ALL
    SELECT k.PersonId,
      e.ProviderEmployeeId,
      'PE',
      e.ProviderEmployeeTypeKey,
      p.FirstName,
      COALESCE(p.MiddleName,''),
      p.LastName,
      p.DOB,
      p.DangerLevel ,
      p.GenderTypeKey,
      k.PersonAddressId
    FROM KeyResults_Count AS k
    JOIN ProviderEmployee AS e ON e.PersonId = k.PersonId
    JOIN Person    AS p ON p.PersonId = k.PersonId
    WHERE COALESCE(v_lvRoleType, 'PE') = 'PE'
    AND  (v_lvRoleSubType IS NULL OR EXISTS (SELECT * FROM sp_tempCount_RoleSubTypes as rst WHERE rst.RoleSubType = e.ProviderEmployeeTypeKey limit 1))
    AND  e.ActiveFlag = COALESCE(v_liActiveFlag, e.ActiveFlag)
    AND  COALESCE(v_lvInterfaceType, '') != 'Interface';
    END IF;
      RAISE NOTICE 'hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh-->%',now();
    IF ((v_lvLastName <> '') OR (v_lvFirstName <> ''))
      THEN
     INSERT INTO FullResults_Count (
      PersonId,
      PersonRoleId,
      PersonRoleType,
      PersonRoleSubType,
      FirstName,
      MiddleName,
      LastName,
      DOB,
      DangerLevel,
      GenderTypeKey)
     SELECT
      CAST('00000000-0000-0000-0000-000000000000' as uuid) AS PersonId,
      CAST('00000000-0000-0000-0000-000000000000' as uuid)AS PersonRoleId,
      'DSDSEMP',
      NULL,
      up.FirstName,
      NULL,
      up.LastName,
      NULL,
      NULL,
      NULL
    FROM UserProfile  up
    WHERE
     ( up.LastName ILIKE  v_lvLastName || '%')
    AND
    ( up.FirstName  ILIKE  v_lvFirstName || '%' );
   END IF;

   SELECT COUNT(1) INTO v_liCount
    FROM FullResults_Count;
    IF v_liCount IS NULL THEN
     v_liCount := 0;
    END IF;
    IF COALESCE(v_liPageNumber, 0) < 1 THEN
     v_liPageNumber := 1;
    END IF;
    IF COALESCE(v_liPageSize, 0) < 1 THEN
     v_liPageSize := v_liCount;
    END IF;

    CREATE SEQUENCE SortedResults_seq_Count1;
    CREATE TEMP TABLE SortedResults_Count (
     ordinal    int default nextval ('SortedResults_seq_Count1'),
     PersonId   uuid,
     PersonRoleId  uuid,
     PersonRoleType  VARCHAR(10),
     PersonRoleSubType VARCHAR(50) NULL,
     FirstName   VARCHAR(50),
     MiddleName   VARCHAR(32),
     LastName   VARCHAR(50),
     DOB     TIMESTAMP(3) NULL,
     DangerLevel   INT  NULL,
     GenderTypeKey  VARCHAR(15) NULL,
     PersonAddressId uuid );

     INSERT INTO SortedResults_Count (
   PersonId,
     PersonRoleId,
     PersonRoleType,
     PersonRoleSubType,
     FirstName,
     MiddleName,
     LastName,
     DOB,
     DangerLevel,
     GenderTypeKey,
     PersonAddressId  )
    SELECT FR.PersonId,
      FR.PersonRoleId,
      FR.PersonRoleType,
      FR.PersonRoleSubType,
      FR.FirstName,
      FR.MiddleName,
      FR.LastName,
      FR.DOB,
      FR.DangerLevel,
      FR.GenderTypeKey ,
      FR.PersonAddressId
    FROM FullResults_Count FR
    ORDER BY
     CASE -- Default
      WHEN v_lvSortDir is null AND v_lvSortCol is null THEN FR.LastName
     END ASC,
     CASE -- Numeric ascending
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'dangerlevel' THEN FR.DangerLevel
     END ASC,
     CASE -- Character ascending     
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'lastname' THEN FR.LastName
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'firstname' THEN FR.FirstName
     END ASC,
     CASE -- Date ascending
      WHEN v_lvSortDir = 'asc' AND v_lvSortCol = 'dob' THEN FR.DOB
     END ASC,
     CASE -- Numeric descending
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'dangerlevel' THEN FR.DangerLevel
     END DESC,
     CASE -- Character descending
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'lastname' THEN FR.LastName
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'firstname' THEN FR.FirstName
     END DESC,
     CASE -- Date descending
      WHEN v_lvSortDir = 'desc' AND v_lvSortCol = 'dob' THEN FR.DOB
     END DESC;
     
     


     -- Return the final result subset. 
     RETURN QUERY EXECUTE   
    'SELECT count(*) as cnt
FROM SortedResults_Count AS sr
--WHERE ordinal BETWEEN ((v_liPageNumber - 1) * v_liPageSize + 1) AND (v_liPageNumber * v_liPageSize)
/*GROUP BY sr.PersonId,
sr.PersonRoleId,
sr.PersonRoleType,
sr.personrolesubtype,
sr.firstname,
 sr.MiddleName,
 sr.LastName,
 sr.DOB,
 sr.DangerLevel,
 sr.personaddressid,
 sr.gendertypekey,
 sr.ordinal*/';
--ORDER BY ordinal;

DROP TABLE sp_tempCount_searchParams;
DROP TABLE sp_tempCount_RoleSubTypes;
DROP TABLE sp_tempCount_PersonIdentityTypes;
DROP TABLE sp_tempCount_PersonIdentityValues;
DROP TABLE KeyResults_Count;
DROP TABLE FullResults_Count;
DROP TABLE SortedResults_Count;
DROP SEQUENCE SortedResults_seq_Count1;
END;

$function$

