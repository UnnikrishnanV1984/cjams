CREATE OR REPLACE FUNCTION as_fc_eligibilty_worksheet(client_id integer)
 RETURNS TABLE(clientid bigint, firstname character varying, middlename character varying, lastname character varying, dateofbirth timestamp without time zone, issafehavenbaby character varying, qualifiedalienstaus character varying, uscitizen character varying, alienregistrationnumber character varying, qualifiedalien character varying, dateofparentdeath timestamp without time zone, county character varying, childfostercareentrydate timestamp without time zone, dateof2ndparentsignatureonvpa timestamp without time zone, clientidwhosignedvpa integer, clientidofpersonfromwhomchildwasphysicallyremoved integer, relationshipidofpersonfromwhomchildwasphysicallyremoved character varying, dateof1stparentsignatureonvpa timestamp without time zone, dateofldsssignatureonvpa timestamp without time zone, typeofvpa character varying, reasonforexit character varying, dateofchildsignatureonvpa timestamp without time zone, dateofguardiansignatureonvpa timestamp without time zone, mandatorynoteonmissing2ndparentsignatureonvpa character varying, dateofyouthsignatureonvpa timestamp without time zone, childbeeninfostercare12monthormore character varying, typeofremoval character varying, previousfostercareepisodeexist character varying, exitcaredatefrompreviousfostercareepisode timestamp without time zone, dateofcourthearing timestamp without time zone, dateofnexthearing timestamp without time zone, typeofcourthearing character varying, magistrateorjudgename character varying, reasonableeffortsmade character varying, issignedbyjudge character varying, childphysicalremovaldate timestamp without time zone, removalid integer, ctwdecision character varying, nameofsubjectctwfinding character varying, relationshipofsubjectctwfinding character varying, clientidofsubjectctwfinding character varying, reasonableeffortsnotnecessaryduetoemergentcircumstances character varying, dateoffindingctwdecision timestamp without time zone, dateofreasonableeffortscourthearing timestamp without time zone, dateofbestinterestfinding timestamp without time zone, courtordered character varying, v_petitionfileddate timestamp without time zone, v_placement_id bigint, v_provider_id integer, dateofchildplacement timestamp without time zone, v_exit_dt timestamp without time zone, isplacementeligible character varying, childdisabilityevaluationdocumentiondate timestamp without time zone, childdisabilitystartdate timestamp without time zone, childdisabilitytype character varying, deprivationfactor character varying, childdeprivedofparentalsupport character varying, unemploymentorunderemployment character varying, incarcerationdate timestamp without time zone, dateoflivingarrangement timestamp without time zone, dateofvalidsilaagreement timestamp without time zone, istherevalidsilaagreement character varying, childphysicaladdressafterremoval character varying, assetsmarketvalue character varying, assetallowance integer, nameofemployer character varying, startdateofemployment timestamp without time zone, nameofpromotetoemploymentprogram character varying, startdateofpromotetoemploymentprogram timestamp without time zone, hourspermonthemployed integer, startdateofsecondaryeducationorequivalentprogram timestamp without time zone, nameofsecondaryeducationorequivalentprogram character varying, nameofpostsecondaryorvocationaleducation character varying, startdateofpostsecondaryorvocationaleducation timestamp without time zone, isdjsordsschild character varying, dateagencylostlegalresponsibility timestamp without time zone, fostercarepermanencyplan character varying, typeofbenefit character varying, isincomedeemed character varying, noofmembersinau integer, noofmembersnotinau integer, isreasonableeffortsfindingtimely character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
 isreasonableeffortsfindingtimely character varying(50);

 --person
 v_client_id int;
 clientId int;
 firstname character varying(20);
 middlename character varying(20);
 lastname character varying(20);
 dateofbirth timestamp;
 issafehavenbaby character varying(50);
 qualifiedalienstaus character varying(50);
 uscitizen character varying(50);
 alienregistrationnumber character varying(50);
 qualifiedalien character varying(50);
 dateofparentdeath timestamp; 

 --personaddress
 county character varying(20);
 
 --intakeservreqchildremoval 
 childfostercareentrydate timestamp;
 dateof2ndparentsignatureonvpa date;
 clientidwhosignedvpa int;
 clientidofpersonfromwhomchildwasphysicallyremoved int;
 relationshipidofpersonfromwhomchildwasphysicallyremoved character varying(50);
 dateof1stparentsignatureonvpa date;
 dateofldsssignatureonvpa date;
 typeofvpa character varying(50);
 reasonforexit character varying(100);
 dateofchildsignatureonvpa date;
 dateofguardiansignatureonvpa date;
 mandatorynoteonmissing2ndparentsignatureonvpa character varying(500);
 dateofyouthsignatureonvpa date;
 childbeeninfostercare12monthormore character varying(50);
 typeofremoval character varying(100);
 previousfostercareepisodeexist character varying(50);
 exitcaredatefrompreviousfostercareepisode timestamp;
 
 --intakeservicerequestcourthearing
 dateofcourthearing timestamp;
 dateofnexthearing timestamp;
 typeOfcourthearing character varying(50);
 magistrateorjudgename character varying(200);

 --intakeservicerequestcourtaction
 reasonableeffortsmade character varying(50);
 issignedbyjudge character varying(50);
 childphysicalremovaldate timestamp;
 removalid int;
 ctwdecision character varying(50);
 nameofsubjectctwfinding character varying(50);
 relationshipofsubjectctwfinding character varying(50);
 clientidofsubjectctwfinding character varying(50);
 reasonableEffortsnotnecessaryduetoemergentcircumstances character varying(50);
 dateoffindingctwdecision timestamp;
 dateofreasonableeffortscourthearing timestamp;
 dateofbestinterestfinding timestamp;
 courtordered character varying(50);

 --intakeservicerequestpetition
 v_petitionfileddate timestamp;

 --tb_placement
 v_placement_id int;
 v_provider_id int;
 dateofchildplacement date;
 v_exit_dt date;
 isplacementeligible character varying(50);

 -- persondisability
 childdisabilityevaluationdocumentiondate timestamp;
 childdisabilitystartdate timestamp;
 childdisabilitytype character varying(20);

 -- persondeprivation
 deprivationfactor character varying(100);
 childdeprivedofparentalsupport character varying(50);
 unemploymentorunderemployment character varying(50);
 incarcerationdate timestamp;

 -- livingarrangement
 dateoflivingarrangement timestamp;
 dateofvalidsilaagreement timestamp;
 istherevalidsilaagreement character varying(50);
 childphysicaladdressafterremoval character varying(500);

 -- personasset
 assetsmarketvalue character varying(50);
 assetallowance int;

 -- personemployment
 nameofemployer character varying(100);
 startdateofemployment timestamp;
 nameofpromotetoemploymentprogram character varying(100);
 startdateofpromotetoemploymentprogram timestamp;
 hourspermonthemployed int;

 -- personeducation
 startdateofsecondaryeducationorequivalentprogram timestamp;
 nameofsecondaryeducationorequivalentprogram character varying(50);
 nameofpostsecondaryorvocationaleducation character varying(50);
 startdateofpostsecondaryorvocationaleducation timestamp;

 -- legalcustody
 isdjsordsschild character varying(50);
 dateagencylostlegalresponsibility timestamp;

 -- permanencyplan
 fostercarepermanencyplan character varying(50);

 --tb_account_transaction 
 typeofbenefit character varying(50);

 -- tb_deemed_income_stepparent
 isincomedeemed character varying(50);
 noofmembersinau int4;
 noofmembersnotinau int4;
-- grossincome185pctforau numeric;

BEGIN
 v_client_id := client_id;

RETURN QUERY

select A.*,
 CASE WHEN ( (A.typeofremoval = 'Court_Order' AND extract(day from age(A.dateofreasonableeffortscourthearing, A.childfostercareentrydate)) <= 60)
   OR (A.typeofremoval = 'Voluntary_Placement_Agreement' AND extract(day from age(A.dateofreasonableeffortscourthearing, A.childfostercareentrydate)) <= 180) )
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS isreasonableeffortsfindingtimely
FROM (

SELECT
--PERFORM
 -- person
 per.cjamspid     AS  clientId,
 per.firstname                  AS   firstname,              
 per.middlename                 AS   middlename,             
 per.lastname                   AS   lastname,
 per.dob      AS   dateofbirth,
 
 CASE WHEN (per.safehevensbabyflag = 1)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS issafehavenbaby,
 
 (select value_tx from tb_picklist_values where PICKLIST_type_id = 49 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(per.citizenalenagetypekey)) AS qualifiedalienstaus,
 
 CASE WHEN (TRIM(per.primarycitizenshiptypekey) = '3474')
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS uscitizen,
 
 per.alienregistrationtext  AS   alienregistrationnumber,
 
 CASE WHEN (per.citizenalenageflag = 1)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS qualifiedalien,
 
 (select MAX(parper.dateofdeath) FROM person parper, actorrelationship ar  WHERE ar.client1id = parper.personid AND ar.relationshiptypekey IN ( 'BGMTHR', 'BGFTHR', 'LGLMTHR', 'LGLFTHR' ) AND ar.client2id = per.personid) AS dateofparentdeath,
 
 -- personaddress
 peradr.county      AS   county,
 
 -- intakeservreqchildremoval
 isrcr.removaldate    AS  childfostercareentrydate,
 isrcr.parent2signeddate  AS  dateof2ndparentsignatureonvpa,
 
 CASE WHEN (rtrim(isrcr.removaltypekey) = '2702' OR rtrim(isrcr.removaltypekey) = '12761' OR rtrim(isrcr.removaltypekey) = '2703') 
 THEN (select isrcr.primarycaregiverid) ELSE NULL END AS clientidwhosignedvpa,
 
 isrcr.primarycaregiverid  AS   clientidofpersonfromwhomchildwasphysicallyremoved,
 
 (select ar.old_id FROM actorrelationship ar, person crgvr WHERE ar.client1id = crgvr.personid AND ar.client2id = per.personid AND isrcr.primarycaregiverid::int = crgvr.cjamspid LIMIT 1) AS relationshipidofpersonfromwhomchildwasphysicallyremoved,
  
 isrcr.vpaparentssigneddate  AS   dateof1stparentsignatureonvpa,
 isrcr.vpadsssigneddate   AS   dateofldsssignatureonvpa,
 
 (select value_tx FROM tb_picklist_values where PICKLIST_type_id = 240 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(isrcr.removaltypekey)) AS typeofvpa,
 
 (select value_tx FROM tb_picklist_values where PICKLIST_type_id = 165 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(isrcr.removalreasontypekey)) AS reasonforexit,
 
 isrcr.vpachildsigneddate   AS   dateofchildsignatureonvpa,
 isrcr.vpaguardiansigneddate AS   dateofguardiansignatureonvpa,
 isrcr.parent2comments   AS   mandatorynoteonmissing2ndparentsignatureonvpa,
 isrcr.vpayouthsigneddate  AS   dateofyouthsignatureonvpa,
 
 CASE WHEN (((extract('years' FROM coalesce(isrcr.returndate, current_date))::int -  extract('years' FROM isrcr.removaldate)::int) * 12) > 12)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS childbeeninfostercare12monthormore, 
 
 CASE WHEN (rtrim(isrcr.removaltypekey) = '2702' OR rtrim(isrcr.removaltypekey) = '12761' OR rtrim(isrcr.removaltypekey) = '2703') 
 THEN 'Voluntary_Placement_Agreement'::character varying 
   WHEN (isrcr.removaltypekey = '2700') 
 THEN 'Court_Order'::character varying ELSE 'None'::character varying END AS typeofremoval,
 
 CASE WHEN (isrcr.returndate IS NOT NULL)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS previousfostercareepisodeexist, 
 
 isrcr.returndate    AS  exitcaredatefrompreviousfostercareepisode,
 
 -- intakeservicerequestcourthearing
 isrch.hearingdatetime   AS  dateofcourthearing,
 isrch.nexthearingdate   AS  dateofnexthearing,
 
 (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 95 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(isrch.hearingtypekey)) AS typeOfcourthearing,
 
 isrch.judgename    AS  magistrateorjudgename,

 -- intakeservicerequestcourtaction
 CASE WHEN (isrca.reasonableeffortsflag = 1)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS reasonableeffortsmade,
 
 CASE WHEN (isrca.judgesignedflag = 1)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS issignedbyjudge,
 
 (SELECT courtorderdatetime FROM intakeservicerequestcourtaction where physicalremovalflag = 1 AND activeflag = 1 order by 1 LIMIT 1) AS childphysicalremovaldate,
 
 isrca.removalid     AS  removalid,
 
 CASE WHEN (isrca.continuecontraryflag = 1)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS ctwdecision,
 
 CASE WHEN (isrca.continuecontraryflag = 1)
 THEN (SELECT (COALESCE(subctw.firstname)||' '|| COALESCE(subctw.lastname)):: character varying FROM person subctw, intakeservreqchildremoval isrcr WHERE isrcr.activeflag = 1 AND isrcr.primarycaregiverid = subctw.cjamspid ) ELSE NULL END AS nameofsubjectctwfinding,
  
 CASE WHEN (isrca.continuecontraryflag = 1)
 THEN (SELECT rt.description::character varying from relationshiptype rt, actorrelationship ar, person crgvr WHERE rt.activeflag = 1 AND TRIM(rt.relationshiptypekey) = TRIM(ar.relationshiptypekey) AND ar.client1id = crgvr.personid AND ar.client2id = per.personid AND isrcr.primarycaregiverid::int = crgvr.cjamspid ) ELSE NULL END AS relationshipofsubjectctwfinding,

 CASE WHEN (isrca.continuecontraryflag = 1)
 THEN (SELECT subctw.cjamspid:: character varying FROM person subctw, intakeservreqchildremoval isrcr WHERE isrcr.activeflag = 1 AND isrcr.primarycaregiverid = subctw.cjamspid ) ELSE NULL END AS clientidofsubjectctwfinding,
-- THEN (SELECT(subctw.cjamspid FROM person subctw, intakeservreqchildremoval isrcr WHERE isrcr.activeflag = 1 AND isrcr.primarycaregiverid = subctw.cjamspid) ELSE NULL END AS clientidofsubjectctwfinding,
-- THEN isrca.fk_id ELSE NULL END AS clientidofsubjectctwfinding,
  
 CASE WHEN (isrca.emergentnatureflag = 1)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS reasonableEffortsnotnecessaryduetoemergentcircumstances,
  
 (SELECT MIN(ISRCA.courtorderdatetime) from intakeservicerequestcourthearing ISRCH, intakeservicerequestcourtaction ISRCA WHERE ISRCA.intakeservicerequestcourthearingid = ISRCH.intakeservicerequestcourthearingid AND ISRCA.fk_id::int4 = per.cjamspid AND ISRCA.activeflag = 1 AND ISRCH.activeflag = 1 AND ISRCA.courtorderdatetime >= isrcr.removaldate AND ISRCA.continuecontraryflag = 1) AS dateoffindingctwdecision,
 
 (SELECT MIN(ISRCA.courtorderdatetime) from intakeservicerequestcourthearing ISRCH, intakeservicerequestcourtaction ISRCA WHERE ISRCA.intakeservicerequestcourthearingid = ISRCH.intakeservicerequestcourthearingid AND ISRCA.fk_id::int4 = per.cjamspid AND ISRCA.activeflag = 1 AND ISRCH.activeflag = 1 AND ISRCA.courtorderdatetime >= isrcr.removaldate AND ISRCA.reasonableeffortsflag = 1) AS dateofreasonableeffortscourthearing,
 
 (SELECT MIN(ISRCA.courtorderdatetime) from intakeservicerequestcourthearing ISRCH, intakeservicerequestcourtaction ISRCA WHERE ISRCA.intakeservicerequestcourthearingid = ISRCH.intakeservicerequestcourthearingid AND ISRCA.fk_id::int4 = per.cjamspid AND ISRCA.activeflag = 1 AND ISRCH.activeflag = 1 AND ISRCA.courtorderdatetime >= isrcr.removaldate AND ISRCA.volbestinterestflag = 1) AS dateofbestinterestfinding,

 (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 94 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(isrca.courtordertypekey)) AS courtordered,
 
 -- intakeservicerequestpetition
 isrpt.petitionfileddate   AS  v_petitionfileddate,
 
 -- tb_placement
 tp.placement_id                AS    v_placement_id,
 tp.provider_id                 AS    v_provider_id,
 tp.entry_dt     AS  dateofchildplacement,
 tp.exit_dt                     AS    v_exit_dt,
 
 CASE WHEN LEFT(tp.fiscal_category_cd, 2) = '21' 
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS isplacementeligible, 
  
 -- persondisability
 pdis.evaluationdate       AS   childdisabilityevaluationdocumentiondate,
 pdis.startdate     AS  childdisabilitystartdate,
 
 CASE WHEN (pdis.disabilityflag = 1)
 THEN 'Permanent'::character varying ELSE 'Temporary'::character varying END AS childdisabilitytype,
 
 -- persondeprivation
 (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 66 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(pdep.deprivationtypekey)) AS deprivationfactor,
 
 CASE WHEN (pdep.deprivationtypekey = '929')
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS childdeprivedofparentalsupport,
 
 CASE WHEN (pdep.deprivationtypekey = '933')
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS unemploymentorunderemployment,
 
 pdep.dateofincarceration  AS   incarcerationdate,
 
 -- livingarrangement
 la.livingstartdate       AS   dateoflivingarrangement,
 la.silaagreementsigneddate  AS   dateofvalidsilaagreement,
 
 CASE WHEN (la.silaagreementsigneddate IS NOT NULL)
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS istherevalidsilaagreement, 
 
 (SELECT CAST
 (
 TRIM(COALESCE(la.addresstypekey,''))||' '|| TRIM(COALESCE(la.boxno::CHARACTER VARYING,'')) ||' '||TRIM(COALESCE(la.cityname,'')) ||' '||
 TRIM(COALESCE(la.country,'')) ||' '||TRIM(COALESCE(la.countytypekey,'')) ||' '||TRIM(COALESCE(la.direction,'')) ||' '||
 TRIM(COALESCE(la.foreignstate,'')) ||' '||TRIM(COALESCE(la.foreigntext,'')) ||' '||TRIM(COALESCE(la.addressformattypekey,'')) ||' '||
 TRIM(COALESCE(la.addresspostdirtypekey,'')) ||' '||TRIM(COALESCE(la.postalcode,'')) ||' '||TRIM(COALESCE(la.addresspredirtypekey,'')) ||' '||
 TRIM(COALESCE(la.statetypekey,'')) ||' '||TRIM(COALESCE(la.streetname,'')) ||' '||TRIM(COALESCE(la.streetnumber::CHARACTER VARYING,'')) ||' '||
 TRIM(COALESCE(la.streetsuffixtypekey,'')) ||' '||TRIM(COALESCE(la.streettext,'')) ||' '||TRIM(COALESCE(la.addressunit,'')) ||' '||
 TRIM(COALESCE(la.addressunittypekey,'')) ||' '||TRIM(COALESCE(la.zip5no::CHARACTER VARYING,''))
 AS CHARACTER VARYING ) FROM livingarrangement la WHERE la.personid = per.personid) AS childphysicaladdressafterremoval,

 -- personasset
 pass.marketvaluetypekey     AS   assetsmarketvalue,
 pass.valueno        AS   assetallowance,
 
 -- personemployment
 pemp.employername       AS   nameofemployer,
 pemp.startdate        AS   startdateofemployment,
 pemp.promotedemploymentprogramname   AS  nameofpromotetoemploymentprogram,
 pemp.promotedemploymentprogramstartdate AS  startdateofpromotetoemploymentprogram,
 pemp.employedhourspermonth     AS  hourspermonthemployed,
 
 -- personeducation
 CASE WHEN (rtrim(pedu.currentgradetypekey) = '3370' OR rtrim(pedu.currentgradetypekey) = '3371' OR rtrim(pedu.currentgradetypekey) = '3372'
   OR rtrim(pedu.currentgradetypekey) = '3373' OR rtrim(pedu.currentgradetypekey) = '3374' OR rtrim(pedu.currentgradetypekey) = '7807'
   OR rtrim(pedu.currentgradetypekey) = '7808' OR rtrim(pedu.currentgradetypekey) = '12860' OR rtrim(pedu.currentgradetypekey) = '12861'
   OR rtrim(pedu.currentgradetypekey) = '12862' OR rtrim(pedu.currentgradetypekey) = '12863' OR rtrim(pedu.currentgradetypekey) = '12864') 
 then (select pedu.startdate) END AS startdateofsecondaryeducationorequivalentprogram,
 
 CASE WHEN (rtrim(pedu.currentgradetypekey) = '3370' OR rtrim(pedu.currentgradetypekey) = '3371' OR rtrim(pedu.currentgradetypekey) = '3372'
   OR rtrim(pedu.currentgradetypekey) = '3373' OR rtrim(pedu.currentgradetypekey) = '3374' OR rtrim(pedu.currentgradetypekey) = '7807'
   OR rtrim(pedu.currentgradetypekey) = '7808' OR rtrim(pedu.currentgradetypekey) = '12860' OR rtrim(pedu.currentgradetypekey) = '12861'
   OR rtrim(pedu.currentgradetypekey) = '12862' OR rtrim(pedu.currentgradetypekey) = '12863' OR rtrim(pedu.currentgradetypekey) = '12864') 
 then (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 74 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(pedu.educationtypekey)) END AS nameofsecondaryeducationorequivalentprogram,
 
 CASE WHEN (rtrim(pedu.currentgradetypekey) = '13053') 
 then (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 74 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(pedu.educationtypekey)) END AS nameofpostsecondaryorvocationaleducation,
 
 CASE WHEN (rtrim(pedu.currentgradetypekey) = '13053') 
 then (select pedu.startdate) END AS startdateofpostsecondaryorvocationaleducation,
 
 -- legalcustody
 (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 107 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(lc.legalcustodytypekey)) AS isdjsordsschild,
 lc.todate         AS  dateagencylostlegalresponsibility,
 
 -- permanencyplan
 (select value_tx FROM tb_picklist_values WHERE PICKLIST_type_id = 136 AND delete_sw='N' AND active_sw='Y' AND TRIM(PICKLIST_VALUE_CD)=TRIM(pp.primarypermanencytype)) AS fostercarepermanencyplan,
  
 -- tb_account_transaction
 CASE tat.transaction_source_cd WHEN '586'
 THEN 'SSA'::character varying WHEN '587' THEN 'SSI'::character varying END AS typeofbenefit,

 -- tb_deemed_income_stepparent
 CASE WHEN tdis.deemed_income_stepparent_id IS NOT NULL
 THEN 'Yes'::character varying ELSE 'No'::character varying END AS isincomedeemed,
 
 tdis.assistance_unit_no as noofmembersinau,
 tdis.notin_assistance_unit_no as noofmembersnotinau
-- tdis.schedule_h_col_iii_no as grossincome185pctforau
 
FROM person AS per
LEFT JOIN personaddress AS peradr ON per.personid = peradr.personid
LEFT JOIN intakeservicerequestcourtaction AS isrca ON per.cjamspid = isrca.fk_id::int4 AND isrca.activeflag = 1
LEFT JOIN intakeservicerequestcourthearing AS isrch ON isrca.intakeservicerequestid = isrch.intakeserviceid AND isrch.activeflag = 1
LEFT JOIN intakeservreqchildremoval AS isrcr ON isrca.intakeservicerequestid = isrcr.intakeserviceid
LEFT JOIN intakeservicerequestpetition AS isrpt ON isrca.intakeservicerequestpetitionid = isrpt.intakeservicerequestpetitionid AND isrpt.activeflag = 1
LEFT JOIN tb_placement AS tp ON per.cjamspid = tp.client_id
LEFT JOIN persondisability AS pdis ON per.personid =  pdis.personid
LEFT JOIN persondeprivation AS pdep ON pdep.fk_id::int4 = per.cjamspid AND pdep.activeflag = 1
LEFT JOIN livingarrangement AS la ON per.personid =  la.personid AND la.activeflag = 1
LEFT JOIN personasset AS pass ON per.cjamspid = pass.fk_id::int4
LEFT JOIN personemployment AS pemp ON per.personid = pemp.personid
LEFT JOIN personeducation AS pedu ON per.personid = pedu.personid
LEFT JOIN legalcustody AS lc ON isrcr.intakeserviceid = lc.intakeserviceid AND lc.activeflag = 1
LEFT JOIN permanencyplan AS pp ON isrcr.intakeserviceid = pp.intakeserviceid
LEFT JOIN tb_client_account AS tca ON per.cjamspid = tca.client_id
LEFT JOIN tb_account_transaction AS tat ON tca.client_account_id = tat.client_account_id AND transaction_source_cd in ('586', '587') AND benefit_end_dt IS NULL
LEFT JOIN tb_deemed_income_clients AS tdic ON per.cjamspid = tdic.client_id AND tdic.delete_sw='N'
LEFT JOIN tb_deemed_income_stepparent AS tdis ON tdic.deemed_income_stepparent_id = tdis.deemed_income_stepparent_id AND tdis.TOTAL_DEEMED_INCOME_NO > 0
LEFT JOIN actorrelationship AS ar ON per.personid = ar.client2id
WHERE per.cjamspid = v_client_id
) A;
--return clientId;
 END;
$function$

