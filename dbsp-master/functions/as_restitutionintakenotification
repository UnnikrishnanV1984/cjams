CREATE OR REPLACE FUNCTION as_restitutionintakenotification()
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE  

v_intakeserviceid uuid;
v_intakeservreqtypeid uuid;
v_intakeservicerequestclassid uuid;
v_investigationid uuid;
v_securityusersid character varying;
v_status character varying;
v_status1 character varying;
v_restitutionpaymentrecord  record;
v_msg character varying;

BEGIN

 --intake 30 days
 -- No Payments was made for the Restitution A/C # xxxxxxxxx from the beginning of restitution for the last 30 days for intake. Please send a reminder letter to Parent/Guardian.

FOR  v_restitutionpaymentrecord  IN

select tma.securityusersid as fromsecurityusersid,isrr.restitutionno,isrr.intakeserviceid from as_teammemberassignment tma 
join teammember tm on tm.teammemberid = tma.teammemberid and  tm.activeflag = 1 
join team t on t.teamid = tm.teamid and t.activeflag = 1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag = 1
join intakeserreqrestitution as isrr on isrr.countyid = t.countyid::uuid and isrr.activeflag = 1 --and isrr.status='Active'
WHERE r.roletypekey ilike'%JSRTC%' and tma.activeflag = 1 and isrr.insertedon::date = now()::date - '30 day'::interval and 
 isrr.restitutionno in (select restitutionno from intakeserreqrestitutionpayment )  and  lower(isrr.restitutiontype) != 'court'


LOOP

-- No Payments was made for the Restitution A/C # xxxxxxxxx from the beginning of restitution for the last 30 days. Please send a reminder letter to Parent/Guardian.

v_msg:=   'No Payments was made for the Restitution A/C ('|| v_restitutionpaymentrecord.restitutionno ||') from the beginning of restitution for the last 30 days for intake. Please send a reminder letter to Parent/Guardian.';

SELECT send_notification INTO v_status1 FROM as_send_notification(v_restitutionpaymentrecord.fromsecurityusersid, 'System'::character varying, v_restitutionpaymentrecord.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_restitutionpaymentrecord.intakeserviceid::character varying);

END LOOP;

--intkae
 -- No Payments was made for the Restitution A/C # xxxxxxxxx in last 30 days from last payment. 

FOR  v_restitutionpaymentrecord  IN

select tma.securityusersid as fromsecurityusersid,isrr.restitutionno,isrr.intakeserviceid from as_teammemberassignment tma 
join teammember tm on tm.teammemberid = tma.teammemberid and  tm.activeflag = 1 
join team t on t.teamid = tm.teamid and t.activeflag = 1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag = 1
join intakeserreqrestitution as isrr on isrr.countyid = t.countyid::uuid and isrr.activeflag = 1 --and isrr.status='Active'
WHERE r.roletypekey like'%JSRTC%' and tma.activeflag = 1 and 
 isrr.restitutionno in (select last_inserted__date.restitutionno from
(select restitutionno as restitutionno,max(insertedon) as insertedon from intakeserreqrestitutionpayment where activeflag = 1 group by restitutionno) as last_inserted__date
where last_inserted__date.insertedon::date = now()::date - '30 day'::interval) and  lower(isrr.restitutiontype) != 'court'


LOOP

-- No Payments was made for the Restitution A/C # xxxxxxxxx in last 30 days for intake. 

v_msg:=   'No Payments was made for the Restitution A/C ('|| v_restitutionpaymentrecord.restitutionno ||') in last 30 days from last payment for intake. Please send a reminder letter to Parent/Guardian';

SELECT send_notification INTO v_status1 FROM as_send_notification(v_restitutionpaymentrecord.fromsecurityusersid, 'System'::character varying, v_restitutionpaymentrecord.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_restitutionpaymentrecord.intakeserviceid::character varying);

update intakeserreqrestitution set isccusent = true where restitutionno = v_restitutionpaymentrecord.restitutionno and activeflag=1;

END LOOP;




--court
 -- No Payments was made for the Restitution A/C # xxxxxxxxx from the beginning of restitution for the last 30 days for court. Please send a reminder letter to Parent/Guardian.

FOR  v_restitutionpaymentrecord  IN

select tma.securityusersid as fromsecurityusersid,isrr.restitutionno,isrr.intakeserviceid from as_teammemberassignment tma 
join teammember tm on tm.teammemberid = tma.teammemberid and  tm.activeflag = 1 
join team t on t.teamid = tm.teamid and t.activeflag = 1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag = 1
join intakeserreqrestitution as isrr on isrr.countyid = t.countyid::uuid and isrr.activeflag = 1 --and isrr.status='Active'
WHERE r.roletypekey ilike'%JSRTC%' and tma.activeflag = 1 and isrr.insertedon::date = now()::date - '30 day'::interval and 
 isrr.restitutionno in (select restitutionno from intakeserreqrestitutionpayment ) 
and  lower(isrr.restitutiontype) = 'court'


LOOP

-- No Payments was made for the Restitution A/C # xxxxxxxxx from the beginning of restitution for the last 30 days for court .  Please send the Restitution Account to CCU.

v_msg:=   'No Payments was made for the Restitution A/C ('|| v_restitutionpaymentrecord.restitutionno ||') from the beginning of restitution for the last 30 days. Please send a reminder letter to Parent/Guardian.';

SELECT send_notification INTO v_status1 FROM as_send_notification(v_restitutionpaymentrecord.fromsecurityusersid, 'System'::character varying, v_restitutionpaymentrecord.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_restitutionpaymentrecord.intakeserviceid::character varying);

END LOOP;

--court
 -- No Payments was made for the Restitution A/C # xxxxxxxxx in last 30 days. 

FOR  v_restitutionpaymentrecord  IN

select tma.securityusersid as fromsecurityusersid,isrr.restitutionno,isrr.intakeserviceid from as_teammemberassignment tma 
join teammember tm on tm.teammemberid = tma.teammemberid and  tm.activeflag = 1 
join team t on t.teamid = tm.teamid and t.activeflag = 1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag = 1
join intakeserreqrestitution as isrr on isrr.countyid = t.countyid::uuid and isrr.activeflag = 1 --and isrr.status='Active'
WHERE r.roletypekey like'%JSRTC%' and tma.activeflag = 1 and 
 isrr.restitutionno in (select last_inserted__date.restitutionno from
(select restitutionno as restitutionno,max(insertedon) as insertedon from intakeserreqrestitutionpayment where activeflag = 1 group by restitutionno) as last_inserted__date
where last_inserted__date.insertedon::date = now()::date - '30 day'::interval) and lower(isrr.restitutiontype) = 'court'

LOOP

-- No Payments was made for the Restitution A/C # xxxxxxxxx in last 30 days for court. 

v_msg:=   'No Payments was made for the Restitution A/C ('|| v_restitutionpaymentrecord.restitutionno ||') in last 30 days from last payment for court.  Please send the Restitution Account to CCU';

SELECT send_notification INTO v_status1 FROM as_send_notification(v_restitutionpaymentrecord.fromsecurityusersid, 'System'::character varying, v_restitutionpaymentrecord.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_restitutionpaymentrecord.intakeserviceid::character varying);

update intakeserreqrestitution set isccusent = true where restitutionno = v_restitutionpaymentrecord.restitutionno and activeflag=1;

END LOOP;






 -- No Payments was made for the Restitution A/C # xxxxxxxxx from the beginning of restitution for the last 120 days for court. Please send the Restitution Account to CCU.

FOR  v_restitutionpaymentrecord  IN

select tma.securityusersid as fromsecurityusersid,isrr.restitutionno,isrr.intakeserviceid from as_teammemberassignment tma 
join teammember tm on tm.teammemberid = tma.teammemberid and  tm.activeflag = 1 
join team t on t.teamid = tm.teamid and t.activeflag = 1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag = 1
join intakeserreqrestitution as isrr on isrr.countyid = t.countyid::uuid and isrr.activeflag = 1 --and isrr.status='Active'
WHERE r.roletypekey ilike'%JSRTC%' and tma.activeflag = 1 and isrr.insertedon::date = now()::date - '120 day'::interval and 
 isrr.restitutionno in (select restitutionno from intakeserreqrestitutionpayment ) 
and lower(isrr.restitutiontype) = 'court'



LOOP

-- No Payments was made for the Restitution A/C # xxxxxxxxx from the beginning of restitution for the last 120 days .  Please send the Restitution Account to CCU.

v_msg:=   'No Payments was made for the Restitution A/C ('|| v_restitutionpaymentrecord.restitutionno ||') from the beginning of restitution for the last 120 days. Please send the Restitution Account to CCU.';

SELECT send_notification INTO v_status1 FROM as_send_notification(v_restitutionpaymentrecord.fromsecurityusersid, 'System'::character varying, v_restitutionpaymentrecord.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_restitutionpaymentrecord.intakeserviceid::character varying);

END LOOP;


-- No Payments was made for the Restitution A/C # xxxxxxxxx in last 120 days. Please send the Restitution Account to CCU.

FOR  v_restitutionpaymentrecord  IN

select tma.securityusersid as fromsecurityusersid,isrr.restitutionno,isrr.intakeserviceid from as_teammemberassignment tma 
join teammember tm on tm.teammemberid = tma.teammemberid and  tm.activeflag = 1 
join team t on t.teamid = tm.teamid and t.activeflag = 1
join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag = 1
join intakeserreqrestitution as isrr on isrr.countyid = t.countyid::uuid and isrr.activeflag = 1 --and isrr.status='Active'
WHERE r.roletypekey like'%JSRTC%' and tma.activeflag = 1 and 
 isrr.restitutionno in (select last_inserted__date.restitutionno from
(select restitutionno as restitutionno,max(insertedon) as insertedon from intakeserreqrestitutionpayment where activeflag = 1 group by restitutionno) as last_inserted__date
where last_inserted__date.insertedon::date = now()::date - '120 day'::interval) and lower(isrr.restitutiontype) = 'court'


LOOP

-- No Payments was made for the Restitution A/C # xxxxxxxxx in last 120 days. Please send the Restitution Account to CCU.

v_msg:=   'No Payments was made for the Restitution A/C ('|| v_restitutionpaymentrecord.restitutionno ||') in last 120 days. Please send the Restitution Account to CCU.';

SELECT send_notification INTO v_status1 FROM as_send_notification(v_restitutionpaymentrecord.fromsecurityusersid, 'System'::character varying, v_restitutionpaymentrecord.fromsecurityusersid,
'System', 'High', v_msg, v_msg , v_restitutionpaymentrecord.intakeserviceid::character varying);

update intakeserreqrestitution set isccusent = true where restitutionno = v_restitutionpaymentrecord.restitutionno and activeflag=1;

END LOOP;


 



RETURN

'Success';

   end;
 $function$

