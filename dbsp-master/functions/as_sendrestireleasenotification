CREATE OR REPLACE FUNCTION as_sendrestireleasenotification(v_placementid uuid, v_releasedate timestamp without time zone)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

---------sending notification when a residential placement is closed---------------

declare 

v_personid uuid;
v_countyid uuid;
v_activity record;
v_intakeserviceid uuid;
v_subject character varying;
v_providername character varying;
v_body text;
v_send_notification character varying;
v_placementadmissionclassificationkey character varying;

begin

select distinct pl.intakeserviceid,p.personid,irs.countyid,pr.providername,pl.placementadmissionclassificationkey into v_intakeserviceid,v_personid,v_countyid,v_providername,v_placementadmissionclassificationkey from placement pl
   join intakeservicerequest INTSR on INTSR.intakeserviceid = pl.intakeserviceid
 join intakeservicerequestactor INSRA on INSRA.intakeserviceid=INTSR.intakeserviceid and INSRA.activeflag=1
   join actor ACC on ACC.actorid=INSRA.actorid and ACC.activeflag=1 and ACC.actortype='Youth'
   join person p on Acc.personid=p.personid and p.activeflag=1
   join intakeserreqrestitution irs on irs.youthpersonid = p.personid
   join provider pr on  pr.providerid = pl.providerid
where pl.placementid=v_placementid and pl.placementadmissionclassificationkey='RES';

 RAISE NOTICE 'v_personid  %', v_personid ;

if v_placementadmissionclassificationkey = 'RES' THEN
FOR  v_activity  in

  select  mu.securityusersid,restitutionno,CONCAT(p.firstname,' ',p.lastname) as name,irt.intakenumber from intakeserreqrestitution irt,person p,team t join teammember tm on tm.teamid=t.teamid and tm.activeflag=1 
    join as_teammemberassignment tma on tma.teammemberid=tm.teammemberid and tma.activeflag=1 
    join muser mu on mu.securityusersid = tma.securityusersid and mu.activeflag=1
    join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 join role r on r.id = rm.roleid :: int 
    where t.countyid::uuid=v_countyid::uuid and r.roletypekey='JSRTC'
    and irt.youthpersonid=v_personid and p.personid=v_personid
 
 loop 
RAISE NOTICE 'v_activity.securityusersid %', v_activity.securityusersid ;
  v_subject = v_activity.name || ' has been released from residential facility';
  v_body = 'Restitution Account#'||v_activity.restitutionno ||' has been activated for '||v_activity.name||' due to release from Residential facility '
 ||v_providername||' (Case#'||v_activity.intakenumber||') on '||v_releasedate;
 
 select send_notification into v_send_notification from as_send_notification(v_activity.securityusersid,'System'::character varying,v_activity.securityusersid::character varying,'System'::character varying,'High'::character varying,v_subject::character varying,v_body::character varying,v_intakeserviceid::character varying,false);
   
 update intakeserreqrestitution set status='Active'where restitutionno=v_activity.restitutionno and youthpersonid=v_personid and status != 'Closed' and (courtdeferredduedate is null or courtdeferredduedate <= now());
 update intakeserreqrestitution set inactivereasontype='Court' where restitutionno=v_activity.restitutionno and youthpersonid=v_personid and status != 'Closed' and (courtdeferredduedate is not null and courtdeferredduedate >= now());

 END  LOOP;

end if;
return 'Success';

 
end;
 

$function$

