   GROUP BY pd.agency_object_cd, pd.county_cd, ro.payment_id 
   ) as offset_rec, 
   tb_payment_header tph, 
   tb_provider TP
  WHERE offset_rec.payment_id = tph.payment_id 
   and tph.delete_sw = 'N'
   and TP.provider_id = tph.provider_id
