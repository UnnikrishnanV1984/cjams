   ,tp.mail_code_tx
   ,tp.eft_sw
   ,LPAD(LTRIM(RTRIM(((offset_rec.amt_no)::INTEGER)::VARCHAR)),13,'0')
   ,NULL
   ,(SELECT B.VS_AGENCY_OBJECT_CD 
    FROM TTB_FMIS_MAIN B 
     WHERE B.VN_TEMP_PAYMENT_ID = offset_rec.payment_id 
    AND VS_OFFSET_FLAG = 'Y'
   )
   ,(SELECT B.VN_TAX_ID 
    FROM TTB_FMIS_MAIN b 
