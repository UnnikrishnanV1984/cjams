CREATE OR REPLACE FUNCTION fn_temp_fmis_prvdradd_insert()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$\r
------------------------------------------------------------------------\r
-- SQL Function\r
-- Author: Vineet Tirodkar\r
-- Date Created :07/15/2020\r
-- Function to insert provider address record in tb_temp_fmis_vendor_interface table\r
-- Revision(s)\r
------------------------------------------------------------------------\r
BEGIN\r
\r
 Delete from tb_temp_fmis_vendor_interface \r
  where address_id = new.address_id;\r
  \r
    Insert into tb_temp_fmis_vendor_interface \r
  ( temp_fmis_vendor_record_id,\r
   provider_id,\r
   address_id,\r
   create_user_id,\r
   create_ts,\r
   update_user_id,\r
   update_ts,\r
   delete_sw\r
  )\r
     values \r
  ( nextval('sq_temp_fmis_vendor_interface'),\r
   new.parent_key_id::bigint,\r
   new.address_id,\r
   'Interface',\r
   current_timestamp,\r
   'Interface',\r
   current_timestamp,\r
   'N'\r
  );\r
\r
 return new;  \r
\r
END;\r
$function$

