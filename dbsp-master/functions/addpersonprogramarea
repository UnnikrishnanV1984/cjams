CREATE OR REPLACE FUNCTION addpersonprogramarea(v_servicecaseid uuid, v_personid uuid, v_securityusersid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 
l_legalguardianid uuid;
 
BEGIN

SELECT
 IAR.personid INTO l_legalguardianid 
FROM Intakeservicerequestactor IAR
WHERE IAR.activeflag=1 AND IAR.servicecaseid = v_servicecaseid AND IAR.intakeservicerequestpersontypekey='LG' LIMIT 1;

INSERT INTO personprogramarea 
   (personid, programkey,subprogramkey,objecttypekey,objectid,startdate,insertedby,updatedby, datatransferflag, sourcetype)  
SELECT 
 v_personid,ppa.programkey,ppa.subprogramkey,'servicecase',v_servicecaseid,now(),v_securityusersid,v_securityusersid, 'A', 'CW'
FROM personprogramarea ppa
WHERE ppa.personid=l_legalguardianid AND ppa.activeflag=1 AND ppa.sourcetype = 'CW' --AND ppa.enddate IS NULL 
ORDER BY ppa.startdate DESC LIMIT 1;

RETURN 'success';

END;

$function$

