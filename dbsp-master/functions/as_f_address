CREATE OR REPLACE FUNCTION as_f_address(as_tabname character varying, ai_key_id integer, as_adr_type_cd character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare payaffcd varchar(5);
 declare affid integer;
 declare n_ADR_TYPE_CD VARCHAR(5);
                            
BEGIN 

  n_ADR_TYPE_CD = as_ADR_TYPE_CD ;
  affid = ai_key_id;
                            
if upper(AS_TABNAME)='TB_PROVIDER_ADDRESSES'  then

return (select as_f_provider_add('TB_PROVIDER_ADDRESSES',AFFID,n_ADR_TYPE_CD));
         
         elsif upper(AS_TABNAME)='LDSSLOCATIONS' 
         then
 
 return as_f_ldssloc_ad('LDSSLOCATIONS',0,AS_ADR_TYPE_CD);
                         
end if;                            
         
END;

$function$

