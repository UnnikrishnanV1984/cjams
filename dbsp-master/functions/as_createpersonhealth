-- RETURNING "personmedicalconditionid" into v_personmedicalconditionid;
 select
 personmedicalconditionid into
  v_personmedicalconditionid
 from
  personmedicalcondition
 where
  activeflag = 1
  and personid = p_Personid
 order by
  v_personmedicalconditionid desc
 limit 1;

