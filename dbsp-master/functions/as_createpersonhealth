 *
from
 json_array_elements(s_medicalconditiontypekey) loop medicaltypekey := j->>'medicalconditiontypekey';

insert
 into
  personmedicalconditioninfo ( personmedicalconditionid,
  medicalconditiontypekey,
  activeflag,
  insertedby,
  updatedby,
  insertedon,
  updatedon) select
   v_personmedicalconditionid::uuid,
   j->>'medicalconditiontypekey',
   1,
   v_securityuserid,
   v_securityuserid,
   v_date,
   v_date ;

raise notice 'medicaltypekey-->%',
medicaltypekey;

raise notice 'v_personmedicalconditionid-->%',
v_personmedicalconditionid;
end loop;
end loop;

