CREATE OR REPLACE FUNCTION getsystemauditlog(servicereqid character varying, pageno integer, pagesize integer)
 RETURNS TABLE(count bigint, insertedon timestamp without time zone, description text, displayname character varying, servicerequestnumber character varying)
 LANGUAGE plpgsql
AS $function$
Declare    
v_pagenumber      INT;                                                          
 v_liPageSize       INT;    
     v_pageoffset INT;
BEGIN
 
 v_liPageSize := PageSize;
 
 v_pagenumber := PageNo-1;
 v_pageoffset = v_pagenumber * PageSize;                                                       
     

RETURN QUERY select count(1) over(), PN.InsertedOn, PN.Description, UP.Displayname, ISR.ServiceRequestNumber from ProgressNote PN
Join ProgressNoteType PNT On PN.ProgressNoteTypeId = PNT.ProgressNoteTypeId
 Join IntakeServiceRequest ISR On ISR.Intakeserviceid = CAST(PN.entitytypeid As uuid)
Join UserProfile UP On UP.securityusersid = PN.Insertedby And PNT.ProgressNoteClassificationTypeKey = 'system'
Where PN.entitytypeid = servicereqid And PNT.ActiveFlag=1 And PN.ActiveFlag=1
order by insertedon desc
LIMIT v_liPageSize OFFSET v_pageoffset ;



END;
$function$

