CREATE OR REPLACE FUNCTION prov_publicproviderdecision(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 

declare

v_objectid text;
v_securityuserid text;
v_status character varying;
v_toroleid CHARACTER VARYING;
v_fromroleid CHARACTER VARYING;
v_comments character varying;
v_tosecurityUserId CHARACTER VARYING;
v_eventcode CHARACTER VARYING;

BEGIN

v_objectid := insertedtlsobj->>'objectid';
v_securityUserId := insertedtlsobj->>'userid';
v_tosecurityUserId := insertedtlsobj->>'tosecurityusersid';
v_toroleid := insertedtlsobj->>'toroleid';
v_fromroleid := insertedtlsobj->>'fromroleid';
v_status := insertedtlsobj->>'status';
v_comments := insertedtlsobj->>'comments';
v_eventcode := insertedtlsobj->>'eventcode';

INSERT INTO tb_provider_decision 
(decisionid, eventcode, fromsecurityusersid, fromroleid, objectid, activeflag, insertedby, insertedon, updatedby, updatedon, isreviewrequest, remarks, status, decisiondate,
toroleid,tosecurityusersid)
VALUES(gen_random_uuid(), v_eventcode, v_securityUserId , v_fromroleid, v_objectid, 1, v_securityUserId, now(), v_securityUserId,
now(), false, v_comments, v_status, now() ,v_toroleid,v_tosecurityUserId);



RETURN 'success';
                                                      
END;

$function$

