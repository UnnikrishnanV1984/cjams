CREATE OR REPLACE FUNCTION as_getcalendarevents(userid character varying)
 RETURNS TABLE(targetdate text, comments text, servicerequestnumber character varying, intakeservicereqid uuid)
 LANGUAGE plpgsql
AS $function$
BEGIN
RETURN QUERY
select date(targetcompletedate)::text, 'DA '|| ISR.servicerequestnumber||'-'||'is due '::text as comments, ISR.servicerequestnumber,ISR.intakeserviceid 
from intakeservicerequest as ISR where
targetcompletedate IS NOT NULL AND ISR.intakeserviceid in (
select intakeserviceid from areateammemberservicerequest where teammemberid in (
SELECT teammemberid  FROM as_teammemberassignment 
WHERE  SecurityUsersId=userid))
union
select date(effectivedate)::text as date, 'DA '|| ISR.servicerequestnumber||' - '||'is assigned'::text as comments, ISR.servicerequestnumber,ISR.intakeserviceid 
from intakeservicerequest as ISR where 
effectivedate IS NOT NULL AND intakeserviceid in (
select intakeserviceid from areateammemberservicerequest where teammemberid in (
SELECT teammemberid  FROM as_teammemberassignment 
WHERE  SecurityUsersId=userid)) order by date desc;
END;

$function$

