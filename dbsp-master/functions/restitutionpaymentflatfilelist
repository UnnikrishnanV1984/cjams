CREATE OR REPLACE FUNCTION restitutionpaymentflatfilelist(searchkey character varying, startdate character varying, enddate character varying, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(totalcount bigint, restitutionpaymentflatfileid uuid, filename character varying, createddate timestamp without time zone, modifieddate timestamp without time zone, insertedon timestamp without time zone, filstatus character varying, restitutionpaymentflatfiledetails json)
 LANGUAGE plpgsql
AS $function$

declare 
v_searchkey character varying = null;
v_pageoffset int;
v_pagenumber int;
declare searchstring character varying(1000);

BEGIN
        v_pagenumber := pagenumber-1;
        v_pageoffset = v_pagenumber * pagesize;
 v_searchkey:= searchkey;
  
 -- 
 searchstring:= coalesce(searchstring,'');
 if (searchkey!='' or searchkey!=null) then
 searchstring:=  '  AND  lower(RPFF.filename)  like    '''  ||  LOWER(searchkey)  ||  '%''';  
        end if; 
      /*  if ((startdate!='' or startdate!=null) and (enddate!='' or enddate!=null)) then
 searchstring:=  '  AND  lower(RPFF.filename)  like    '''  ||  LOWER(searchkey)  ||  '%''';  
        end if; */
        
 Return Query
 execute  
 'select count(1) OVER(), RPFF.restitutionpaymentflatfileid, RPFF.filename, RPFF.createddate, RPFF.modifieddate, RPFF.insertedon ,  (SELECT ''Success''::character varying) as filestatus,
 (select json_agg(x) from (select REPFFC.restitutionpaymentflatfilecontentid, REPFFC.restitutionpaymentflatfileid , REPFFC.asofdate, REPFFC.lockboxno, 
 REPFFC.vakaccountnumber, REPFFC.firstname, REPFFC.lastname, REPFFC.addressline1, REPFFC.addressline2 , REPFFC.city, REPFFC.state, REPFFC.zip, 
 REPFFC.customernumber, REPFFC.checkno, REPFFC.checkamt, REPFFC.insertedon, REPFFC.ismatched ,REPFFC.paymentno
 from restitutionpaymentflatfilecontent REPFFC 
 where REPFFC.activeflag=1 and REPFFC.asofdate!='''' and REPFFC.restitutionpaymentflatfileid = RPFF.restitutionpaymentflatfileid ) as X ) as restitutionpaymentflatfiledetails
 from restitutionpaymentflatfile as RPFF 
        where  RPFF.activeflag = 1 '|| searchstring ||'
 order by RPFF.filename asc LIMIT '|| pagesize ||' OFFSET '|| v_pageoffset ||'';
 
  end;

$function$

