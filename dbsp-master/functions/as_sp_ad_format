CREATE OR REPLACE FUNCTION as_sp_ad_format(t_address_id integer, t_adr_format_cd character varying, t_emp_school_nm character varying, t_adr_street_no character varying, t_adr_box_no character varying, t_adr_pre_dir_cd character varying, t_adr_street_nm character varying, t_adr_street_sx_cd character varying, t_adr_post_dir_cd character varying, t_adr_unit_type_cd character varying, t_adr_unit_no_tx character varying, t_adr_city_nm character varying, t_adr_county_cd character varying, t_adr_state_cd character varying, t_adr_zip5_no character varying, t_adr_zip4_no character varying, t_adr_direction_tx character varying, t_adr_foreign_tx character varying, t_adr_foreign_sttx character varying, t_adr_country_tx character varying, t_adr_postal_cd_tx character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
 
DECLARE
 
 declare f_final     character varying default '';--
 declare f_adr_street_NM   character varying     default '';--
 declare f_ADR_STREET_NO   character varying     default '';--
 declare f_ADR_BOX_NO    character varying     default '';--
 declare f_ADR_PRE_DIR_CD   character varying    default '';--
 declare f_ADR_POST_DIR_CD   character varying    default '';--
 declare f_ADR_STREET_SUFFIX_CD  character varying   default '';--
 declare f_ADR_FORMAT_CD     character varying   default '';--
 declare f_ADR_UNIT_TYPE_CD   character varying    default '';--
 declare f_ADR_UNIT_NO_TX      character varying     default '';--
 declare f_ADR_CITY_NM         character varying    default '';--
 declare f_ADR_COUNTY_CD       character varying    default '';--
 declare f_ADR_STATE_CD         character varying  default '';--
 declare f_ADR_ZIP5_NO         character varying    default '';--
 declare f_ADR_ZIP4_NO          character varying    default '';--
 declare f_ADR_ZIP5_NO_t       character varying   default '';--
 declare f_ADR_ZIP4_NO_t       character varying    default '';--
 declare f_ADR_DIRECTION_TX    character varying default '';--
 declare f_ADR_FOREIGN_TX      character varying  default '';--
 declare f_ADR_FOREIGN_STATE_TX  character varying  default '';--
 declare f_ADR_COUNTRY_TX       character varying   default '';--
 declare f_ADR_POSTAL_CODE_TX    character varying   default '';--
 
 
 BEGIN
 -- ADDRESS FORMAT ----
 if T_ADR_FORMAT_CD = NULL OR length(LTRIM(RTRIM(t_ADR_FORMAT_CD)))=0 then
   T_ADR_FORMAT_CD='S';--
 end if;--
 
 if length(rtrim(ltrim(t_adr_zip5_no))) > 0 and t_adr_zip5_no is not null and t_adr_zip5_no<>'' then
 --set f_adr_zip5_no_t=(select substr(char(digits(int(rtrim(ltrim(t_adr_zip5_no))))),6,5) from sysibm.sysdummy1);--
     f_adr_zip5_no_t = substr(cast(trunc(cast(rtrim(ltrim(t_adr_zip5_no)) as integer)) as character varying),6,5);
     t_adr_zip5_no = f_adr_zip5_no_t; --
 end if;--
 
 if length(rtrim(ltrim(t_adr_zip4_no))) > 0  and t_adr_zip4_no is not null and t_adr_zip4_no<>'' then
     --f_adr_zip4_no_t=(select substr(char(digits(int(rtrim(ltrim(t_adr_zip4_no))))),7,4) from sysibm.sysdummy1);--
  f_adr_zip4_no_t =  substr(cast(trunc(cast(rtrim(ltrim(t_adr_zip4_no)) as integer)) as character varying),7,4);     
     t_adr_zip4_no = f_adr_zip4_no_t; --
 end if;--
 
 --POST BOX
 IF (RTRIM(UPPER(t_ADR_FORMAT_CD)) = 'P' ) THEN
  -- Address type
  IF t_ADR_FORMAT_CD is not null AND length(ltrim(rtrim(t_ADR_FORMAT_CD)))>0 THEN
    f_ADR_FORMAT_CD  = 'PO Box'  ;--
  END IF;--
  -- Street Number
  -- Box No
  IF (t_ADR_BOX_NO is not null ) AND length(ltrim(rtrim(t_ADR_BOX_NO)))>0 THEN
    f_ADR_STREET_NO = ltrim(RTRIM(t_ADR_BOX_NO));--
  END IF;--
  --- City
  IF ( t_ADR_CITY_NM is not null ) AND length(ltrim(rtrim(t_ADR_CITY_NM)))>0 THEN
    f_ADR_CITY_NM = ltrim(RTRIM(t_ADR_CITY_NM)) || ','; --
  END IF ;-- 
  -- State
  IF ( t_ADR_STATE_CD is not null ) AND length(ltrim(rtrim(t_ADR_STATE_CD)))>0 THEN
      f_ADR_STATE_CD = ltrim(RTRIM(t_ADR_STATE_CD)) ; --
  END IF ;--
  --- Zip  CONCATENATE ZIP5 AND ZIP4 WITH A DASH
  IF ( t_ADR_ZIP4_NO is not null ) AND length(ltrim(rtrim(t_ADR_ZIP4_NO)))>0 THEN
      f_ADR_ZIP4_NO = ltrim(RTRIM (t_ADR_ZIP4_NO))  ;--
  END IF ;--
  IF ( t_ADR_ZIP5_NO <> '') THEN
     f_ADR_ZIP5_NO = ltrim(RTRIM(t_ADR_ZIP5_NO));--
  END IF ;--
 
 --RURAL
 ELSEIF (RTRIM(UPPER(t_ADR_FORMAT_CD))  = 'R' ) THEN
  -- Address type
  IF ( t_ADR_FORMAT_CD is not null ) AND length(ltrim(rtrim(t_ADR_FORMAT_CD)))>0 THEN
      f_ADR_FORMAT_CD = 'Rural Rte'  ;--
  END IF; --
  -- Street Number
  IF (t_ADR_STREET_NO is not null) AND length(ltrim(rtrim(t_ADR_STREET_NO)))>0 THEN
      f_ADR_STREET_NO = ltrim(RTRIM(t_ADR_STREET_NO)) ;--
  END IF;--
  -- Box No
  IF (t_ADR_BOX_NO is not null) AND length(ltrim(rtrim(t_ADR_BOX_NO)))>0 THEN
      f_ADR_BOX_NO = ltrim(RTRIM(t_ADR_BOX_NO));--
  END IF;--
  --- Street Name
  IF (t_ADR_STREET_NM is not null ) AND length(ltrim(rtrim(t_ADR_STREET_NM)))>0 THEN
    f_adr_street_nm = ltrim(RTRIM(t_ADR_STREET_NM));--
  END IF;--
  --- City
  IF ( t_ADR_CITY_NM is not null ) AND length(ltrim(rtrim(t_ADR_CITY_NM)))>0 THEN
    f_ADR_CITY_NM = ltrim(RTRIM(t_ADR_CITY_NM)) || ','; --
  END IF ;-- 
  -- State
  IF ( t_ADR_STATE_CD is not null ) AND length(ltrim(rtrim(t_ADR_STATE_CD)))>0 THEN
      f_ADR_STATE_CD = ltrim(RTRIM(t_ADR_STATE_CD)) ; --
  END IF ;--
  --- Zip  CONCATENATE ZIP5 AND ZIP4 WITH A DASH
  IF ( t_ADR_ZIP4_NO is not null ) AND length(ltrim(rtrim(t_ADR_ZIP4_NO)))>0 THEN
      f_ADR_ZIP4_NO = ltrim(RTRIM (t_ADR_ZIP4_NO))  ;--
  END IF ;--
  IF ( t_ADR_ZIP5_NO <> '') THEN
     f_ADR_ZIP5_NO = ltrim(RTRIM(t_ADR_ZIP5_NO));--
  END IF ;-- 
 
 --FOREIGN
 ELSEIF (RTRIM(UPPER(t_ADR_FORMAT_CD))  = 'F' ) THEN
  -- Foreign addr
  IF (t_ADR_FOREIGN_TX is not null) AND length(ltrim(rtrim(t_ADR_FOREIGN_TX)))>0 THEN
      f_ADR_FOREIGN_tx = ltrim(RTRIM(t_ADR_FOREIGN_TX));--
  END IF;--
  --- City
  IF ( t_ADR_CITY_NM is not null ) AND length(ltrim(rtrim(t_ADR_CITY_NM)))>0 THEN
    f_ADR_STATE_CD = ltrim(RTRIM(t_ADR_CITY_NM)) || ', '; --
  END IF ;-- 
  --State
  IF (t_ADR_FOREIGN_STTX is not null) AND length(ltrim(rtrim(t_ADR_FOREIGN_STTX)))>0 THEN
    f_ADR_STATE_CD = f_ADR_STATE_CD || ltrim(RTRIM(t_ADR_FOREIGN_STTX)) || ', ' ; --
  END IF;--
  -- Country
  IF (t_ADR_COUNTRY_TX is not null) AND length(ltrim(rtrim(t_ADR_COUNTRY_TX)))>0 THEN 
    f_ADR_STATE_CD = f_ADR_STATE_CD || rtrim(t_ADR_COUNTRY_TX)||' ';--
  END IF;
  -- Postal code
  IF (t_ADR_POSTAL_CD_TX is not null) AND length(ltrim(rtrim(t_ADR_POSTAL_CD_TX)))>0 THEN
    f_ADR_STATE_CD = f_ADR_STATE_CD || ltrim(RTRIM(t_ADR_POSTAL_CD_TX));--
  END IF;--
  
 --NOTHING BUT STREET NO
 ELSEIF (RTRIM(UPPER(t_ADR_FORMAT_CD))  = 'S' ) THEN
  -- Street Number
  IF ( t_ADR_STREET_NO is not null) AND length(ltrim(rtrim(t_ADR_STREET_NO)))>0 THEN
    f_ADR_STREET_NO = RTRIM(ltrim(t_ADR_STREET_NO)) ;--
  END IF ;--
  -- Description for Prefix Direction
  IF ( t_ADR_PRE_DIR_CD is not null) AND length(ltrim(rtrim(t_ADR_PRE_DIR_CD)))>0 THEN
    f_ADR_PRE_DIR_CD = RTRIM(ltrim(t_ADR_PRE_DIR_CD));--
  END IF ;--
  -- Street Name
  IF (t_ADR_STREET_NM is not null ) AND length(ltrim(rtrim(t_ADR_STREET_NM)))>0 THEN
    f_adr_street_nm = ltrim(RTRIM(t_ADR_STREET_NM)) ;--
  END IF;--
  --- Street Type
  IF ( t_ADR_STREET_SX_CD is not null ) AND length(ltrim(rtrim(t_ADR_STREET_SX_CD)))>0 THEN
    f_ADR_STREET_SUFFIX_CD = ltrim(RTRIM(t_ADR_STREET_SX_CD)) ;--
  END IF;--
  IF ( t_ADR_POST_DIR_CD is not null) AND length(ltrim(rtrim(t_ADR_POST_DIR_CD)))>0 THEN
    f_ADR_POST_DIR_CD = RTRIM(ltrim(t_ADR_POST_DIR_CD));--
  END IF; --
  --- Unit Designator Bldg Room etc
  IF ( t_ADR_UNIT_TYPE_CD is not null) AND length(ltrim(rtrim(t_ADR_UNIT_TYPE_CD)))>0 THEN
    f_ADR_UNIT_TYPE_CD = ltrim(RTRIM(t_ADR_UNIT_TYPE_CD))  ; --
  END IF ;--
  --- Unit Name No
  IF ( t_ADR_UNIT_NO_TX  is not null ) AND length(ltrim(rtrim(t_ADR_UNIT_NO_TX)))>0 THEN
    f_ADR_UNIT_NO_TX = ltrim(RTRIM(t_ADR_UNIT_NO_TX));--
  END IF ;--
  --- City
  IF ( t_ADR_CITY_NM is not null ) AND length(ltrim(rtrim(t_ADR_CITY_NM)))>0 THEN
    f_ADR_CITY_NM = ltrim(RTRIM(t_ADR_CITY_NM)) || ','; --
  END IF ;-- 
  -- State
  IF ( t_ADR_STATE_CD is not null ) AND length(ltrim(rtrim(t_ADR_STATE_CD)))>0 THEN
      f_ADR_STATE_CD = ltrim(RTRIM(t_ADR_STATE_CD)) ; --
  END IF ;--
  --- Zip  CONCATENATE ZIP5 AND ZIP4 WITH A DASH
  IF ( t_ADR_ZIP4_NO is not null ) AND length(ltrim(rtrim(t_ADR_ZIP4_NO)))>0 THEN
      f_ADR_ZIP4_NO = ltrim(RTRIM (t_ADR_ZIP4_NO))  ;--
  END IF ;--
  IF ( t_ADR_ZIP5_NO <> '') THEN
     f_ADR_ZIP5_NO = ltrim(RTRIM(t_ADR_ZIP5_NO));--
  END IF ;-- 
 END IF;
  
 -- FINAL ----------------
 -- Foreign
 IF (RTRIM(UPPER(t_ADR_FORMAT_CD))  = 'F' ) THEN
  if length(ltrim(rtrim(f_ADR_FOREIGN_TX)))>0 and f_ADR_FOREIGN_TX is not null then
      f_final = ltrim(f_ADR_FOREIGN_TX) ;--
  end if ;--
  if length(ltrim(rtrim(f_ADR_STATE_CD)))>0 and f_ADR_STATE_CD is not null then
      f_final = f_final  || chr(13) || ltrim(f_ADR_STATE_CD) ;--
  end if ;-- 
  
 -- Post Box, NOTHING BUT STREET NO, Rural
 else
    if length(ltrim(rtrim(f_ADR_FORMAT_CD)))>0 and f_ADR_FORMAT_CD is not null then
      f_final = ltrim(f_ADR_FORMAT_CD) || ' ' ;--
    end if ; --
    if length(ltrim(rtrim(f_ADR_STREET_NO)))>0 and f_ADR_STREET_NO is not null then
      f_final = f_final || ltrim(f_ADR_STREET_NO) ||' ' ;--
    end if ; --
    if length(ltrim(rtrim(f_adr_box_no)))>0 and f_adr_box_no is not null then
      f_final = f_final || ltrim(f_adr_box_no) ||' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_PRE_DIR_CD)))>0 and f_ADR_PRE_DIR_CD is not null then
      f_final = f_final || ltrim(f_ADR_PRE_DIR_CD) || ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_STREET_NM)))>0 and f_ADR_STREET_NM is not null then
      f_final = f_final || ltrim(f_ADR_STREET_NM) || ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_STREET_SUFFIX_CD)))>0 and f_ADR_STREET_SUFFIX_CD is not null then
      f_final = f_final  || ltrim(f_ADR_STREET_SUFFIX_CD) || ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_POST_DIR_CD)))>0 and f_ADR_POST_DIR_CD is not null then
      f_final = f_final  || ltrim(f_ADR_POST_DIR_CD) || ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_UNIT_TYPE_CD)))>0 and f_ADR_UNIT_TYPE_CD is not null then
      f_final = f_final  || ltrim(f_ADR_UNIT_TYPE_CD)|| ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_UNIT_NO_TX)))>0 and f_ADR_UNIT_NO_TX is not null then
      f_final = f_final  || ltrim(rtrim(f_ADR_UNIT_NO_TX)) || ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_CITY_NM)))>0 and f_ADR_CITY_NM is not null then
      f_final = f_final  ||chr(13)|| ltrim(f_ADR_CITY_NM) || ' '; --
    end if ; --
    if length(ltrim(rtrim(f_ADR_STATE_CD)))>0 and f_ADR_STATE_CD is not null then
      f_final = f_final  || ltrim(f_ADR_STATE_CD) || ' ';--
    end if ; --
    if length(ltrim(rtrim(f_ADR_ZIP4_NO)))>0 then
     f_ADR_ZIP5_NO = f_ADR_ZIP5_NO || ' - ';--
    end if;--
    if length(ltrim(rtrim(f_ADR_ZIP5_NO)))>0 and f_ADR_ZIP5_NO is not null then
      f_final = f_final  || ltrim(f_ADR_ZIP5_NO);--
    end if ; --
    if length(ltrim(rtrim(f_ADR_ZIP4_NO)))>0 and f_ADR_ZIP4_NO is not null then
      f_final = f_final  || ltrim(f_ADR_ZIP4_NO);--
    end if ; --
 end if;--
 
 return rtrim(f_final) ;--
        
END;

$function$

