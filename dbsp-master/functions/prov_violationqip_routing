RAISE NOTICE 'v_objectid before2222222222:%', v_objectid;  

UPDATE prov_violation set cap_status = qipobj ->> 'status',
"comments"=v_comments,
cap_status_description = qipobj ->> 'cap_status_description'
WHERE qip_number = v_objectid and delete_sw ='N';

