             AND r.objectid  = v_objectid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
             and r.eventcode = qipobj ->> 'appevent'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
