    insert into prov_violation(
        reference_id, referencetype, reference_value_id, deficiency_number,  applicant_id, record_id, child_id, site_id, record_question_id, comments, objectid, objecttype, 
        create_ts, create_user_id, update_ts, update_user_id, delete_sw, provider_id, isdraft,  cap_findings,  qip_number, notification_type
    ) select 
        reference_id, referencetype, reference_value_id, deficiency_number,  applicant_id, record_id, child_id, site_id, record_question_id, comments, objectid, objecttype, 
        create_ts, create_user_id, now(), v_securityuserid, delete_sw, provider_id, isdraft,  cap_findings,  v_objectid, 'QIP'
    from prov_violation where deficiency_number = v_deficiencynumber and delete_sw = 'N';
else 
 update prov_violation set qip_number=v_objectid where deficiency_number=v_deficiencynumber and notification_type ='QIP';
end if;



