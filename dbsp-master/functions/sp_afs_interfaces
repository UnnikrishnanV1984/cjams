-- Sandhya - 02/20/2009 - #19508 - Payment_detail_id added to cursor and also in the INSERT\r
-- Raghu T   12/10/2010 - #Prj-01179 1) Replacing payment_detail_id with payment_id\r
--                                   2) Replacing zero provider_id with client_id for CHAC types.\r
-- 07/25/2012 Samir Patil PRJ-02667 - MD CHESSIE Batch Process Redesign - To change Return 0 on success\r
-- 01/21/2019 Vineet Tirodkar - B-28317 - AFS interface Modernization\r
--     Modification to populate newly added columns in TB_AFS_INTERFACES for New AFS system Interface\r
-- 03/09/2019 Raghuveer Reddy Dachani CJAMS implementation converted from DB2 - POSTGRESQL\r
-- 10/11/2019 H. S.     CJAMS - For Child Account change the Location ID to match the Vendor ACCOUNT\r
--                            - Change Approve by from 100 to 200\r
-- 05/21/2020 Tanmay M - CJAMS - Handling Foreign Address Zip Code\r
-- 07/30/2020 Vineet Tirodkar - CJAMS - To fix error of Provider address Street number greater than 5 characters\r
-- 11/03/2020 Vineet Tirodkar - CDM-4627 - To update JOURNAL_DESC as unique timestamp values\r
-- 12/16/2020 Vineet Tirodkar - Changes to first look for provider_nm column else provider_first_nm and provider_last_nm (CDM-3556)\r
---------------------------------------------------------------------------------------------------------------------------\r
-- VARIABLE DECLARATION\r
\r
DECLARE VS_OUTPUT_STATE VARCHAR(5) DEFAULT '00000';\r
DECLARE vts_previous_run_ts timestamp;\r
DECLARE vts_current_run_ts timestamp ;\r
DECLARE VL_ROWCOUNT INTEGER DEFAULT 0;\r
DECLARE VS_USER_ID  VARCHAR(10)  DEFAULT 'interface';\r
DECLARE VL_INTERFACE_ROWCOUNT INTEGER DEFAULT 0;\r
DECLARE li_provider_id INTEGER DEFAULT 0;\r
DECLARE ls_county Varchar(4) DEFAULT '0000';\r
DECLARE ls_county_cd Varchar(2) DEFAULT '99';\r
DECLARE ls_provider_nm Varchar(500);\r
DECLARE ls_INDICATOR_1099_SW Varchar(3);\r
DECLARE ls_Provider_last_nm  Varchar(100);\r
DECLARE ls_Provider_first_nm Varchar(100);\r
DECLARE ls_Provider_middle_nm Varchar(100);\r
DECLARE ls_person_nm Varchar(100);\r
DECLARE ls_org_nm Varchar(100);\r
DECLARE ls_vendor_nm Varchar(100);\r
DECLARE li_vendor_ln_1 INTEGER;\r
DECLARE li_vendor_ln_2 INTEGER;\r
DECLARE ls_payment_method_cd  CHAR(1);\r
DECLARE LS_LINK_PAYMENT_STATUS  VARCHAR(4); -- new\r
DECLARE li_linked_pymnt_id  INTEGER; -- new\r
DECLARE li_payment_id  INTEGER;\r
DECLARE ls_payment_id  VARCHAR(20);\r
DECLARE li_afs_interface_record_id  INTEGER;\r
DECLARE ld_Payment_dt  DATE  ;\r
DECLARE ld_final_service_dt DATE  ;\r
DECLARE li_client_id    INTEGER;\r
DECLARE ls_client_first_nm  VARCHAR(100);\r
DECLARE ls_client_last_nm   VARCHAR(100);\r
DECLARE ls_client_nm   VARCHAR(100);\r
DECLARE li_client_nm   INTEGER;\r
DECLARE li_final_amount_no  DECIMAL(13,2) DEFAULT 0.0;\r
DECLARE ls_prov_tax_type_cd  VARCHAR(4);\r
DECLARE ls_TYPE_1099_CD  VARCHAR(5);\r
DECLARE ls_FINAL_FISCAL_CATEGORY_CD  VARCHAR(5);\r
DECLARE li_TAX_ID_NO  INTEGER;\r
DECLARE ls_TAX_ID_NO  Varchar(100);\r
DECLARE li_STORE_RECEIPT_ID INTEGER;\r
DECLARE ls_STORE_RECEIPT_ID  VARCHAR(100);\r
DECLARE ls_ADR_WORK_PHONE_TX VARCHAR(20);\r
DECLARE ls_ADR_HOME_PHONE_TX  VARCHAR(20);\r
DECLARE ls_ADR_CELL_PHONE_TX  VARCHAR(20);\r
DECLARE ls_PHONE_TX  VARCHAR(20);\r
DECLARE ls_adr_type_cd  VARCHAR(5);\r
DECLARE ls_Adr_format_cd VARChar(5);\r
DECLARE li_Adr_street_no  Integer Default 0;\r
DECLARE li_Adr_Box_no     Integer Default 0;\r
DECLARE ls_Adr_pre_dir_cd VARChar(5);\r
DECLARE ls_Adr_street_nm   VARChar(50) ;\r
DECLARE ls_Adr_street_suffix_cd VARChar(5);\r
DECLARE ls_Adr_post_dir_cd VARChar(5);\r
DECLARE ls_Adr_unit_type_cd VARChar(5);\r
DECLARE ls_Adr_unit_no_tx   VARChar(5);\r
DECLARE ls_Adr_city_nm      VARChar(50);\r
DECLARE ls_adr_state_cd  VARChar(5);\r
DECLARE ls_Adr_foreign_tx VArChar(500);\r
DECLARE ls_Adr_foreign_state_tx VARChar(50);\r
DECLARE ls_Adr_country_tx VARChar(50);\r
DECLARE li_Adr_zip5_no Integer ;\r
DECLARE li_Adr_zip4_no Integer;\r
DECLARE ls_address_1  VARChar(100);\r
DECLARE ls_Adr_zip5_no   VarChar(5);\r
DECLARE ls_Adr_zip4_no   Varchar(4);\r
DECLARE ls_Adr_street_no  Varchar(10) ; -- Changed from Varchar(5) 07/30/2020\r
DECLARE ls_Adr_street_no1  Varchar(50) ;\r
DECLARE ls_Adr_Box_no     Varchar(15) ;\r
DECLARE ls_address_2  VARChar(100);\r
DECLARE ls_zip_code  Varchar(50);\r
DECLARE li_payment_count  Integer;\r
DECLARE li_client_count  Integer;\r
DECLARE ls_pay_to_affiliate_cd  Varchar(5);\r
DECLARE li_check Integer default 0;\r
DECLARE li_address_1  Integer;\r
DECLARE li_address_2  Integer;\r
DECLARE li_city  Integer;\r
DECLARE ls_payee_nbr Varchar(10);\r
DECLARE li_payee_nbr Integer;\r
DECLARE ls_REPORT_1099_SW  Varchar(1);\r
DECLARE ls_payment_type_cd  Varchar(5);\r
DECLARE ls_manual_sw Char(1);\r
DECLARE li_length  INTEGER default 0;\r
DECLARE ls_alternate_adr_type_cd  VARCHAR(5);\r
DECLARE li_temp_provider_id  INTEGER Default 0;\r
DECLARE li_affiliate_provider_id INTEGER Default 0;\r
DECLARE VS_PAYEE_SHORT_NM   VARCHAR(100);\r
DECLARE VS_PAYMENT_TYPE_CD  VARCHAR(5) DEFAULT '0000';\r
DECLARE VL_PAYMENT_COUNT    INTEGER DEFAULT 0;\r
DECLARE VL_ERROR_COUNT    INTEGER DEFAULT 0;\r
DECLARE VL_INTERFACES_ERROR_LOG_ID    INTEGER DEFAULT 0;\r
DECLARE VL_ERROR_LOGGED    INTEGER DEFAULT 0;\r
DECLARE VS_EXCEP_MESSAGE VARCHAR(2000)  default '' ;\r
Declare VS_EXC_ADR_TYPE varchar(100) DEFAULT '';\r
DECLARE LS_COUNTY_NAME VARCHAR(25) DEFAULT  '' ;\r
DECLARE LS_ERROR_PROVNAME VARCHAR(2)DEFAULT  '' ;\r
DECLARE LS_ERROR_CHILDNAME VARCHAR(2)DEFAULT  '' ;\r
DECLARE VS_EXCEP_MESSAGE1 VARCHAR(500)DEFAULT  '' ;\r
DECLARE VS_CHILD_DISBURSEMENT varchar (1) default 'N';\r
DECLARE li_payment_detail_id  INTEGER;\r
-- B-28317\r
DECLARE ld_amount_1099 DECIMAL(10,2);\r
DECLARE ls_code_1099 VARCHAR(10);\r
DECLARE ls_account_type VARCHAR(10);\r
DECLARE ll_address_id BIGINT;\r
DECLARE ls_address_id_tx VARCHAR(20);\r
DECLARE ls_approved VARCHAR(5);\r
DECLARE ls_approved_by VARCHAR(5);\r
DECLARE ls_currency VARCHAR(5);\r
DECLARE ls_invoice VARCHAR(20);\r
DECLARE ls_invoice_desc VARCHAR(100);\r
DECLARE ls_journal_desc VARCHAR(50);\r
DECLARE ls_payor_company VARCHAR(5);\r
DECLARE ls_offset_account VARCHAR(30);\r
DECLARE ls_offset_account_type VARCHAR(10);\r
DECLARE ls_posting_profile VARCHAR(10);\r
DECLARE ls_terms_of_payment VARCHAR(5);\r
DECLARE ls_vendoraccount VARCHAR(15);\r
DECLARE ls_childacc_id VARCHAR; --04072019\r
\r
DECLARE PAYMENT_CUR CURSOR  FOR\r
 SELECT  HDR.PAYMENT_id,\r
  DTL.LINKED_PYMNT_HDR_ID,\r
  HDR.provider_id,\r
  HDR.PAYMENT_METHOD_CD,\r
  DTL.client_id,\r
  DTL.TYPE_1099_CD,\r
  DTL.FINAL_FISCAL_CATEGORY_CD,\r
  HDR.STORE_RECEIPT_ID,\r
  DTL.FINAL_AMOUNT_NO,\r
  HDR.PAYMENT_DT,\r
  DTL.FINAL_SERVICE_END_DT,\r
  DTL.REPORT_1099_SW,\r
  HDR.PAYMENT_TYPE_CD,\r
  HDR.MANUAL_SW      ,\r
  DTL.PAYMENT_DETAIL_ID\r
 FROM TB_PAYMENT_HEADER as HDR,\r
  TB_PAYMENT_DETAIL as DTL,\r
  TB_PAYMENT_STATUS\r
 WHERE HDR.Payment_id = Dtl.Payment_id\r
  AND HDR.Delete_sw = 'N'\r
  AND (TB_PAYMENT_STATUS.PAYMENT_STATUS_CD = '1634' )\r
  AND HDR.Delete_sw = 'N'\r
  AND DTL.Delete_sw = 'N'\r
  AND TB_PAYMENT_STATUS.Delete_sw = 'N'\r
  AND HDR.Payment_id = TB_PAYMENT_STATUS.Payment_id\r
  AND HDR.PAYMENT_TYPE_CD  NOT IN ('6','5689','7')   -- 12/07/06 #11127\r
  -- VINEET 04/21/2020 - To exclude payments created in MD CHESSIE\r
  AND HDR.PAYMENT_id >= 2896828 -- First CJAMS Payment ID\r
  --AND btrim(DTL.county_cd) IN ( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE )\r
  /*\r
  and  dtl.create_ts::date >= (select min(golivedate)\r
         from county\r
         where activeflag = 1\r
         and golivedate is not null\r
         and statecountycode is not null\r
         )\r
  */       \r
 ORDER BY  HDR.PAYMENT_ID;\r
\r
BEGIN\r
 vts_previous_run_ts := CURRENT_TIMESTAMP;\r
 vts_current_run_ts := CURRENT_TIMESTAMP;\r
 ld_Payment_dt := '1900-01-01'::DATE;\r
 ld_final_service_dt := '1900-01-01'::DATE;\r
 VL_OUTPUT_SQLCODE := '00000';\r
\r
 --  if first run, i.e., no rows in log, then leave as initialized\r
 IF EXISTS (SELECT 1 FROM INTERFACESRUNTIMESLOG) THEN\r
 BEGIN\r
  SELECT MAX(CURRENTRUNTIMESTAMP) INTO vts_previous_run_ts FROM INTERFACESRUNTIMESLOG ;\r
  EXCEPTION WHEN OTHERS THEN\r
   VS_MESSAGE := 'SELECT MAX(CURRENTRUNTIMESTAMP) FAILED '||SQLERRM  ;\r
   VL_OUTPUT_SQLCODE := SQLSTATE;\r
   INSERT INTO interfaceserrorlog(INTERFACEID, CURRENTRUNTIMESTAMP, BATCHNUMBER, ERRORLINENO, ERRORCODE,\r
    ERRORSQLCODE, ERRORDESCRIPTION, payment_id, provider_id, county_cd, client_id, payment_amount)\r
   VALUES ('AFS_INTERFACES', current_timestamp, '000', li_payment_id, '0',\r
     VL_OUTPUT_SQLCODE, VS_MESSAGE, li_payment_id, li_provider_id, ls_county, li_client_id ,\r
     li_final_amount_no);\r
   RETURN;\r
  END;\r
 END IF;\r
\r
-- DELETE Of the Output table AFS_INTERFACES -- takes place on the script which call the procedure\r
\r
-- Check for rows to interface, if none then quit.\r
BEGIN\r
 IF EXISTS ( SELECT 1\r
    FROM TB_PAYMENT_DETAIL as DTL,\r
     TB_PAYMENT_HEADER as HDR,\r
     TB_PAYMENT_STATUS, TB_PROVIDER\r
    WHERE ( HDR.PAYMENT_ID = DTL.PAYMENT_ID ) and\r
     ( HDR.PAYMENT_ID = TB_PAYMENT_STATUS.PAYMENT_ID ) and\r
     ( TB_PAYMENT_STATUS.PAYMENT_STATUS_CD = '1634' ) and\r
     ( TB_PROVIDER.PROVIDER_ID = HDR.PROVIDER_ID ) AND\r
     HDR.Delete_sw = 'N'\r
     AND DTL.Delete_sw = 'N'\r
     AND TB_PAYMENT_STATUS.Delete_sw = 'N'\r
     AND TB_PROVIDER.DELETE_SW  = 'N'\r
     -- TANMAY 05/21/2020 - To exclude payments created in MD CHESSIE\r
     AND HDR.PAYMENT_TYPE_CD  NOT IN ('6','5689','7')\r
     AND HDR.PAYMENT_id >= 2896828 -- First CJAMS Payment ID\r
     --AND DTL.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE )\r
     /*and  dtl.create_ts::date >= (select min(golivedate)\r
             from county\r
             where activeflag = 1\r
             and golivedate is not null\r
             and statecountycode is not null\r
             )\r
     */\r
    ) THEN\r
  --\r
 ELSE\r
  VS_MESSAGE := 'THERE ARE NO ROWS TO INTERFACE; PAYMENT_STATUS_CD <> 1634'  ;\r
 END IF;\r
\r
 EXCEPTION WHEN OTHERS THEN\r
  VS_MESSAGE := 'SELECT OF ROWS TO INTERFACE COUNT(*) FAILED '||SQLERRM  ;\r
  VL_OUTPUT_SQLCODE := SQLSTATE;\r
  INSERT INTO interfaceserrorlog(INTERFACEID,CURRENTRUNTIMESTAMP, BATCHNUMBER, ERRORLINENO, ERRORCODE,\r
   ERRORSQLCODE, ERRORDESCRIPTION, payment_id, provider_id, county_cd, client_id,  payment_amount)\r
  VALUES ( 'AFS_INTERFACES', current_timestamp, '000', li_payment_id, '0',\r
   VL_OUTPUT_SQLCODE, VS_MESSAGE, li_payment_id, li_provider_id, ls_county, li_client_id , li_final_amount_no);\r
  RETURN;\r
END;\r
\r
\r
-- Delete the existing records in the interface table\r
-- Insert records into the TB_AFS_INTERFACES table from\r
-- the TB_PAYMENT DETAIL, TB_PAYMENT_HEADER, and TB_PROVIDER\r
-- when the status code is 1634.\r
-- Update the records with "interfaced" status.\r
-- Insert new record in interface log with the date/time of the run.\r
SELECT COUNT(*) INTO VL_PAYMENT_COUNT\r
 FROM TB_PAYMENT_HEADER as HDR,\r
  TB_PAYMENT_DETAIL as DTL,\r
  TB_PAYMENT_STATUS\r
WHERE HDR.Payment_id = Dtl.Payment_id\r
 AND HDR.Delete_sw = 'N'\r
 AND ( TB_PAYMENT_STATUS.PAYMENT_STATUS_CD = '1634' )\r
 AND HDR.Delete_sw = 'N'\r
 AND DTL.Delete_sw = 'N'\r
 AND TB_PAYMENT_STATUS.Delete_sw = 'N'\r
 AND HDR.Payment_id = TB_PAYMENT_STATUS.Payment_id\r
 AND HDR.PAYMENT_TYPE_CD NOT IN  ('6','5689','7') --12/07/06 #11127\r
 -- TANMAY 05/21/2020 - To exclude payments created in MD CHESSIE\r
 AND HDR.PAYMENT_id >= 2896828 -- First CJAMS Payment ID\r
 --AND DTL.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE )\r
 /*and  dtl.create_ts::date >= (select min(golivedate)\r
         from county\r
         where activeflag = 1\r
         and golivedate is not null\r
         and statecountycode is not null\r
        );\r
 */\r
 ;\r
\r
OPEN PAYMENT_CUR;\r
 <<PAYMENT>>\r
WHILE VL_PAYMENT_COUNT > 0  LOOP\r
 -- #10001\r
 li_payment_id := 0;\r
 li_provider_id := 0;\r
 ls_payment_method_cd := '';\r
 li_client_id := 0;\r
 ls_TYPE_1099_CD := '';\r
 LS_FINAL_FISCAL_CATEGORY_CD := '';\r
 ls_STORE_RECEIPT_ID := '';\r
 li_final_amount_no := 0 ;\r
 ld_Payment_dt := NULL ;\r
 ld_final_service_dt := NULL;\r
 ls_REPORT_1099_SW := '';\r
 ls_payment_type_cd := '';\r
 ls_manual_sw := '';\r
 li_linked_pymnt_id := 0;          --new\r
 LS_LINK_PAYMENT_STATUS := '';     --new\r
 li_payment_detail_id := 0;\r
\r
 FETCH PAYMENT_CUR INTO  li_payment_id,\r
       li_linked_pymnt_id,\r
       li_provider_id,\r
       ls_payment_method_cd,\r
       li_client_id ,\r
       ls_TYPE_1099_CD,\r
       ls_FINAL_FISCAL_CATEGORY_CD,\r
       ls_STORE_RECEIPT_ID,\r
       li_final_amount_no,\r
       ld_Payment_dt,\r
       ld_final_service_dt,\r
       ls_REPORT_1099_SW,\r
       ls_payment_type_cd,\r
       ls_manual_sw,\r
       li_payment_detail_id;\r
\r
 EXIT PAYMENT WHEN NOT FOUND;\r
\r
 LI_CLIENT_COUNT := 0; -- #10001\r
\r
 li_provider_id := COALESCE(li_provider_id,0);\r
 -- added 09/08/06\r
\r
 ls_provider_nm := '' ;\r
 ls_Provider_last_nm := '';\r
 ls_Provider_first_nm := '';\r
 ls_Provider_middle_nm := '';\r
 ls_INDICATOR_1099_SW := '';\r
 ls_ADR_WORK_PHONE_TX := '';\r
 ls_ADR_HOME_PHONE_TX := '';\r
 ls_ADR_CELL_PHONE_TX := '';\r
 ls_prov_tax_type_cd := '';\r
 li_TAX_ID_NO := 0;\r
 ls_pay_to_affiliate_cd := '';\r
\r
 IF li_provider_id > 0 THEN   -- Provider Information\r
  VS_CHILD_DISBURSEMENT := 'N';\r
\r
  BEGIN\r
   SELECT  TB_PROVIDER.PROVIDER_NM,\r
    TB_PROVIDER.Provider_last_nm,\r
    TB_PROVIDER.Provider_First_nm,\r
    TB_PROVIDER.Provider_middle_nm\r
   INTO ls_provider_nm,\r
    ls_Provider_last_nm,\r
    ls_Provider_first_nm,\r
    ls_Provider_middle_nm\r
   FROM TB_PROVIDER\r
   WHERE TB_PROVIDER.provider_id  = li_provider_id\r
    AND TB_PROVIDER.Delete_sw  = 'N' ;\r
\r
\r
   SELECT DISTINCT TB_PROVIDER.INDICATOR_1099_SW,\r
    TB_PROVIDER.ADR_WORK_PHONE_TX,\r
    TB_PROVIDER.ADR_HOME_PHONE_TX,\r
    TB_PROVIDER.ADR_CELL_PHONE_TX,\r
    coalesce (TB_PROVIDER.prov_tax_type_cd,\r
       (select TB_PROVIDER.prov_tax_type_cd\r
        from tb_provider\r
       where provider_id = (select affiliate_provider_id from tb_provider\r
        where provider_id = li_provider_id))) as prov_tax_type_cd,\r
    coalesce (TB_PROVIDER.TAX_ID_NO,\r
       (select TAX_ID_NO\r
        from tb_provider\r
       where provider_id = (select affiliate_provider_id from tb_provider\r
        where provider_id = li_provider_id)))as TAX_ID_NO,\r
    pay_to_affiliate_cd\r
   INTO ls_INDICATOR_1099_SW,\r
    ls_ADR_WORK_PHONE_TX,\r
    ls_ADR_HOME_PHONE_TX,\r
    ls_ADR_CELL_PHONE_TX,\r
    ls_prov_tax_type_cd,\r
    li_TAX_ID_NO,\r
    ls_pay_to_affiliate_cd\r
   FROM TB_PROVIDER\r
   WHERE TB_PROVIDER.provider_id  = li_provider_id\r
    AND TB_PROVIDER.Delete_sw  = 'N';\r
\r
   EXCEPTION WHEN OTHERS THEN\r
    VS_MESSAGE := 'Error in fetching Provider Information '||SQLERRM  ;\r
    VL_OUTPUT_SQLCODE := SQLSTATE;\r
    INSERT INTO interfaceserrorlog(INTERFACEID,CURRENTRUNTIMESTAMP, BATCHNUMBER, ERRORLINENO, ERRORCODE, ERRORSQLCODE, ERRORDESCRIPTION, payment_id, provider_id, county_cd, client_id,  payment_amount)\r
    VALUES ( 'AFS_INTERFACES', current_timestamp, '000', li_payment_id, '0', VL_OUTPUT_SQLCODE, VS_MESSAGE, li_payment_id, li_provider_id, ls_county, li_client_id , li_final_amount_no);\r
    RETURN;\r
  END;\r
\r
  IF VL_PAYMENT_COUNT > 0 THEN\r
   li_check := 1;\r
  END IF;\r
\r
  IF ls_prov_tax_type_cd = '2517' THEN\r
   ls_prov_tax_type_cd := '1';\r
  ELSIF ls_prov_tax_type_cd = '2518' THEN\r
   ls_prov_tax_type_cd := '2';\r
  ELSE\r
   ls_prov_tax_type_cd := LPAD('',1);\r
  END IF;\r
\r
  IF ls_TYPE_1099_CD = '3155' THEN\r
   ls_TYPE_1099_CD := '1';\r
  ELSIF ls_TYPE_1099_CD = '3156' THEN\r
   ls_TYPE_1099_CD := '6';\r
  ELSIF ls_TYPE_1099_CD = '3157' THEN\r
   ls_TYPE_1099_CD := '7';\r
  ELSE\r
   ls_TYPE_1099_CD := NULL;\r
  END IF;\r
\r
  ls_tax_id_no := Substring(RTRIM(LTRIM(li_TAX_ID_NO::VARCHAR)),1,9);\r
  li_length := LENGTH(RTRIM(ls_tax_id_no));\r
  IF li_length < 9 THEN\r
   li_length := 9 - li_length ;\r
   WHILE li_length > 0 LOOP\r
    ls_tax_id_no := '0' || ls_tax_id_no;\r
    li_length := li_length - 1;\r
   END LOOP;\r
  END IF;\r
\r
  ls_STORE_RECEIPT_ID := RTRIM(LTRIM((ls_STORE_RECEIPT_ID)));\r
\r
  CASE WHEN LENGTH(ls_ADR_WORK_PHONE_TX) = 0 THEN\r
   ls_phone_tx := COALESCE( ls_ADR_CELL_PHONE_TX, ls_ADR_HOME_PHONE_TX );\r
  ELSE\r
   ls_phone_tx := ls_ADR_WORK_PHONE_TX;\r
  END CASE;\r
\r
  ls_provider_last_nm := RTRIM(LTRIM(ls_provider_last_nm));\r
  ls_provider_first_nm := RTRIM(LTRIM(ls_provider_first_nm));\r
  ls_provider_middle_nm := RTRIM(LTRIM(ls_provider_middle_nm));\r
\r
  CASE WHEN LENGTH(ls_provider_last_nm) = 0 THEN\r
   ls_provider_last_nm := '';\r
  ELSE\r
   ls_provider_last_nm := COALESCE(ls_provider_last_nm,'');\r
  END CASE;\r
\r
  IF ls_provider_last_nm <> '' THEN\r
   ls_provider_last_nm := ls_provider_last_nm;\r
  END IF;\r
