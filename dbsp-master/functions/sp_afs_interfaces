CREATE OR REPLACE FUNCTION sp_afs_interfaces(OUT vs_message character varying, OUT vl_output_sqlcode character varying, OUT a timestamp without time zone, OUT b timestamp without time zone)
 RETURNS record
 LANGUAGE plpgsql
AS $function$\r
--------------------------------------------------------------------------------------------------------------------------\r
-- SQL Stored Procedure\r
-- Author: Mohan\r
-- Date Created :04/26/2005\r
-- generates AFS Interface payment records\r
-- Revision\r
-- Mohan    10/24/05  - AFS - Previous payments are re-sent if no data in current day(Incident 4687)\r
-- Mohan    12/29/05  - #5267\r
-- Mohan    13/01/06  - #6025\r
-- MOhan    01/18/06    #6095\r
-- Mohan    01/18/06    #6138\r
-- Mohan    01/25/06    #6211\r
-- sandhya  05/23/06    #7581 (rectified)\r
-- sandhya  05/23/06    #7621  (populate error table)\r
