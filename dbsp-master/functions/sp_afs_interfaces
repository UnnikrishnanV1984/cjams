-- System Adjustments\r
BEGIN\r
 UPDATE TB_AFS_INTERFACES\r
  SET JOURNAL_DESC = 'MD CJAMS ' || CURRENT_TIMESTAMP + interval '5000 microseconds'\r
 WHERE AFS_INTERFACE_RECORD_ID \r
  IN ( SELECT AFS.AFS_INTERFACE_RECORD_ID\r
    FROM TB_AFS_INTERFACES AFS,\r
     TB_PAYMENT_HEADER PH\r
    WHERE RTRIM(AFS.PAYMENT_ID)::INTEGER= PH.PAYMENT_ID\r
    --AND (PH.PAYMENT_TYPE_CD = '3294' AND (PH.MANUAL_SW IS NULL OR PH.MANUAL_SW = 'Y' OR PH.MANUAL_SW = 'N'))\r
    AND (PH.PAYMENT_TYPE_CD = '3294' AND (PH.MANUAL_SW IS NULL OR PH.MANUAL_SW <> 'Y'))\r
   );\r
 EXCEPTION WHEN OTHERS THEN\r
  VS_MESSAGE := 'Error in updating TB_AFS_INTERFACES --> JOURNAL_DESC (System Adjustments)  '||SQLERRM  ;\r
  VL_OUTPUT_SQLCODE := SQLSTATE;\r
  INSERT INTO interfaceserrorlog(INTERFACEID,CURRENTRUNTIMESTAMP, BATCHNUMBER, ERRORLINENO, ERRORCODE, ERRORSQLCODE, ERRORDESCRIPTION, payment_id, provider_id, county_cd, client_id,  payment_amount)\r
  VALUES ( 'AFS_INTERFACES', current_timestamp, '000', li_payment_id, '0', VL_OUTPUT_SQLCODE, VS_MESSAGE, li_payment_id, li_provider_id, ls_county, li_client_id , li_final_amount_no);\r
\r
END;\r
