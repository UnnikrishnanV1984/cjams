CREATE OR REPLACE FUNCTION as_getadjdispdetails(i_intakenumber character varying, pagesize bigint, pagenumber bigint)
 RETURNS TABLE(totalcount bigint, adjudicateddecision json, petitionid character varying, intakeservicerequestpetitionid uuid, petitiontype character varying, hearingtype character varying, hearingdate timestamp without time zone, orderdate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$

  
BEGIN
  RETURN QUERY 
select count(1) over(), 
  (select json_agg(x) from (select AG."name" as allegationname,ADT.description as adjudicateddecisiontype
, (select string_agg(CAT.description,',') as courtActions from intakeservicerequestcourtactiontype INTSRCAT
join courtactiontype CAT on CAT.courtactiontypekey=INTSRCAT.courtactiontypekey and INTSRCAT.activeflag=1
where  INTSRCAT.courtactionallegationconfigid=CAC.courtactionallegationconfigid and INTSRCAT.activeflag=1) as courtActions,
    
    (select string_agg(COTY.description,',') as courtOrder from intakeservicerequestcourtordertypeconfig INTSRCOTC
join courtordertype COTY on COTY.courtordertypekey=INTSRCOTC.courtordertypekey and INTSRCOTC.activeflag=1
 where  INTSRCOTC.courtactionallegationconfigid=CAC.courtactionallegationconfigid  and INTSRCOTC.activeflag=1
) as courtOrder,
    
    (select string_agg(COTY.description,',') as courtCondition from  intakeservicerequestcourtconditiontypeconfig INTSRCOTC
join conditiontype COTY on COTY.conditiontypekey=INTSRCOTC.conditiontypekey and INTSRCOTC.activeflag=1
 where  INTSRCOTC.courtactionallegationconfigid=CAC.courtactionallegationconfigid and INTSRCOTC.activeflag=1) as courtCondition
from courtactionallegationconfig CAC
      join intakeservicerequestcourtaction INA on INA.intakeservicerequestcourtactionid=CAC.intakeservicerequestcourtactionid and INA.activeflag=1
      join allegation AG on AG.allegationid=CAC.allegationid and AG.activeflag=1
      join adjudicateddecisiontype ADT on ADT.adjudicateddecisiontypekey=CAC.adjudicateddecisiontypekey and ADT.activeflag=1
      where CAC.intakeservicerequestcourtactionid=INTSRCA.intakeservicerequestcourtactionid and CAC.activeflag=1) as x ) as adjudicateddecision
            ,INTSRP.petitionid,INTSRP.intakeservicerequestpetitionid, PT.description as petitiontype,HT.description as hearingtype,INTSRPH.hearingdatetime,INTSRCA.courtorderdatetime
      from intakeservicerequestevaluation INTSRE  
   left join Intakeservreqevalpetitionconfig INTSREPC on INTSRE.intakeservicerequestevaluationid =INTSREPC.intakeservicerequestevaluationid and INTSREPC.activeflag=1 
   left join intakeservicerequestpetition INTSRP on INTSRP.intakeservicerequestpetitionid =INTSREPC.intakeservicerequestpetitionid and INTSRP.activeflag=1
   left join petitiontype PT on PT.petitiontypekey=INTSRP.petitiontypekey and PT.activeflag=1
   left join Intakeservreqpetitionhearingconfig INTSRPHC on INTSRPHC.intakeservicerequestpetitionid =INTSRP.intakeservicerequestpetitionid and INTSRPHC.activeflag=1
   left join Intakeservicerequestcourthearing INTSRPH on INTSRPH.intakeservicerequestcourthearingid = INTSRPHC.intakeservicerequestcourthearingid and INTSRPH.courthearingstatustypekey='Completed' and INTSRPH.activeflag=1
   join  hearingtype HT on INTSRPH.hearingtypekey=HT.hearingtypekey and HT.activeflag=1 and (HT.hearingtypekey ='Disp' or HT.hearingtypekey ='Adjudi')   
   join intakeservicerequestcourtaction INTSRCA on INTSRCA.intakeservicerequestcourthearingid=INTSRPH.intakeservicerequestcourthearingid and INTSRCA.activeflag=1
   where INTSRE.intakenumber= I_intakenumber limit pagenumber offset pagesize; --'I201800248261'
   
   --select * from Intakeservicerequestcourthearing order by insertedon ::date desc 
    
    end;


$function$

