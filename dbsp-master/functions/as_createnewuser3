CREATE OR REPLACE FUNCTION as_createnewuser3(v_email character varying, v_firstname character varying, v_lastname character varying, v_middlename character varying, v_fullname character varying, v_agencycode character varying, v_roletypekey character varying, v_countycode character varying, v_teamcode character varying, v_teamname character varying, v_ldss character varying, v_add1 character varying, v_city character varying, v_zipcode character varying, v_phonenumber character varying, v_staffid character varying, v_positioncode character varying, v_positiontitle character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
 declare v_teamid uuid ;
 v_teammemberid uuid ;
 v_securityusersid uuid ;
 v_message character varying(100);
  
  
 BEGIN
 v_message:= 'Success';

 Select teamid into v_teamid from team where lower(teamnumber ) = lower(v_teamcode);
 

 IF NOT EXISTS (SELECT * FROM role WHERE  lower(roletypekey)=lower(v_roletypekey) ) THEN 
  v_message:= 'Role does not exist';
 ELSE 
   /*Team Insert*/
   IF (coalesce(v_teamid::character varying,'')='') THEN 
    INSERT INTO team
    (teamid, activeflag, teamname, teamnumber, teamtypekey, description, officetimingfrom, officetimingto, parentteamid, insertedby, insertedon, updatedby, updatedon, effectivedate, expirationdate, "timestamp", region, regionid, old_id, countyid)
    VALUES(gen_random_uuid(), 1, v_teamname, v_teamcode, v_agencycode, NULL, '01:00:00', '04:00:00', NULL, 'admin', now(), 'admin', now(), now(), NULL, NULL, 0, NULL, NULL, (SELECT countyid FROM county WHERE countycode =v_countycode AND activeflag =1 LIMIT 1)) returning teamid into v_teamid ;
   END IF;
   
   Select securityusersid into v_securityusersid from userprofile where lower(email ) = lower(v_email);
   /*User Inser*/
   IF (coalesce(v_securityusersid::character varying,'')=''AND EXISTS (SELECT * FROM role WHERE  lower(roletypekey)=lower(v_roletypekey) ) ) THEN 
     
    INSERT INTO teammember (teammemberid, activeflag, teamid, loadnumber, roletypekey, positioncode, description, isoncall,
    insertedby, insertedon, updatedby, updatedon, effectivedate, expirationdate, "timestamp", linenumber, voidedby, voidedon, voidreasonid, rtfdate, coadate, old_id, isdefaultroute)
    VALUES (gen_random_uuid(), 1, v_teamid, v_staffid , v_roletypekey,
    v_positioncode ,v_positiontitle, true, '', now(), 'admin',  now(),  now(), null, NULL,
    NULL , NULL, NULL, NULL,  now(), now(), NULL, 1)  returning teammemberid into v_teammemberid; 

    INSERT INTO userprofile(
     securityusersid, firstname, lastname, displayname, fullname, middlename,
     activeflag,   email,    insertedby, insertedon, updatedby, updatedon,
       teamtypekey,usertypekey,autonotification,old_id,title)
    values(gen_random_uuid(),v_firstname,v_lastname,v_firstname || v_lastname,v_fullname,v_middlename,
     1,v_email ,'admin' ,now(),'admin',now(),v_agencycode,'DSDS',false,'',null) returning securityusersid into v_securityusersid ;

    INSERT INTO securityusers(
     securityusersid, username , activeflag, insertedby, updatedby, insertedon, updatedon,old_id)
     select securityusersid, displayname,  1,'admin','admin',now(),now(),'man' from userprofile where email= v_email;
    INSERT INTO muser(
       username, password, email,  id, securityusersid,
     insertedby, updatedby, insertedon, updatedon, activeflag ,old_id)
     SELECT  displayname,'$2a$10$fwlp0MMCDZHj9wk7mNdQ6uf1hQkZXcDYiqlLZZVWK0Ic4PCcm0lyW',email,nextval('muser_id_seq'),securityusersid, 'admin' ,'admin',now(),now(),1,title from userprofile where email= v_email;
    IF COALESCE(v_add1,'')<>'' THEN
     INSERT INTO userprofileaddress (securityusersid,userprofileaddresstypekey,address,zipcode,city,state,county,countyid,activeflag,insertedby,updatedby)
     VALUES (v_securityusersid,'P',v_add1,v_zipcode,v_city,'-',v_ldss,(SELECT countyid FROM county WHERE countycode =v_countycode AND activeflag =1 LIMIT 1),1,'admin','admin');
       END IF;
    IF COALESCE(v_phonenumber,'')<>'' THEN
     INSERT INTO userprofilephonenumber (userprofilephonenumberid, securityusersid, activeflag, userprofiletypekey, phonenumber, updatedby, insertedby, updatedon, insertedon ) 
     VALUES(gen_random_uuid(), v_securityusersid, 1,'cell',v_phonenumber, 'admin','admin',now(),now());
    END IF;
     INSERT INTO as_teammemberassignment
    (teammemberassignmentid, activeflag, teammemberid, securityusersid, insertedby, insertedon, updatedby, updatedon, effectivedate)
    VALUES (gen_random_uuid(), 1, v_teammemberid,v_securityusersid, 'admin', now(), 'admin', now(), now());
     
      
      INSERT INTO rolemapping
      (id, principaltype, principalid, roleid, activeflag, insertedby, updatedby, insertedon, updatedon)
      select nextval('rolemapping_id_seq'),'USER',id::character varying,
       (select id from role where lower(roletypekey)=lower(v_roletypekey) and activeflag =1 limit 1)   ,1, 'admin', 'admin', now(), now()
      from muser where securityusersid in (select securityusersid from userprofile where email= v_email);
    
  ELSE
   v_message:= 'User already exists';
  END IF;
 END IF; 
  return v_message;
  END  
   $function$

