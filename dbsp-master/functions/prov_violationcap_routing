CREATE OR REPLACE FUNCTION prov_violationcap_routing(capobj json)
 RETURNS TABLE(routingmailid json, v_status character varying)
 LANGUAGE plpgsql
AS $function$
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
 DECLARE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
 v_teamid uuid;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
 v_fromroleid character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
 v_fromloadnumber character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 v_toroleid character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
 v_securityuserid character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 v_objectid character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
 v_status  character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
 v_routingid uuid;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
 v_tosecurityusersid  character varying;                                                                                                                                                                                                                                                                           
 v_notifystatus character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
 v_date timestamp without time zone;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
 v_msg character varying;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
 v_username character varying;  
 v_servicerequestno character varying;
 v_assignsecurityuserid json;
 i  text;
 touserid character varying[]; 
 v_files json;
 c_status character varying;
v_deficiencynumber character varying;
v_comments character varying;
BEGIN            
 v_deficiencynumber:=(capobj->>'deficiencynumber');
v_comments:=(capobj->>'commenttext');
--v_cap_id:=(capobj->>'cap_id:')
 v_files := ( capobj ->> 'uploadedfile');
 v_assignsecurityuserid:=  capobj ->> 'assignsecurityuserid';
 v_securityuserid:=  capobj ->> 'securityusersid';                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
 v_objectid:= capobj ->> 'objectid';
 c_status:= capobj ->> 'status';                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
 v_date:= now() at time zone 'utc';    
touserid=v_tosecurityusersid;
RAISE NOTICE 'before ii:%', capobj;     

--if (v_deficiencynumber!=null) then
 update prov_violation set cap_number=v_objectid where deficiency_number=v_deficiencynumber;

 --update tb_provider_complaint_deficiency set cap_number=v_objectid
 --where tb_provider_complaint_deficiencyid=(select reference_id from prov_violation where deficiency_number= v_deficiencynumber);
--end if;
RAISE NOTICE 'v_objectid before2222222222:%', v_objectid;  

UPDATE prov_violation set cap_status = capobj ->> 'status',
"comments"=v_comments,
cap_status_description = capobj ->> 'cap_status_description'
WHERE cap_number = v_objectid and delete_sw ='N';

if(c_status = '101') then
RAISE NOTICE 'c_status333333333333:%', c_status; 
  UPDATE prov_violation SET
  cap_status = capobj ->> 'status',
  planofcorrection = capobj ->> 'planofcorrection',
  comments = capobj ->> 'commenttext',
  disputecomarcitation = capobj ->> 'disputecomarcitation',
  targetdate = (capobj ->> 'targetdate')::date,
  isdispute = (capobj ->> 'isdisbute')::bool,
  cap_status_description = capobj ->> 'cap_status_description'
  --,uploadedfile = v_files
  WHERE cap_number = v_objectid and delete_sw ='N';
end if;

if( capobj ->> 'prv_signimage' is not null)then 
           update prov_violation  set prv_signimage = capobj ->> 'prv_signimage',prv_signdate = (capobj ->> 'prv_signdate')::date
           where cap_number=v_objectid and delete_sw ='N';  
elseif( capobj ->> 'qa_signimage' is not null)then 
           update prov_violation  set qa_signimage = capobj ->> 'qa_signimage',qa_signdate = (capobj ->> 'qa_signdate')::date
           where cap_number=v_objectid and delete_sw ='N';  
elseif(capobj ->> 'pm_signimage' is not null)then           
           update prov_violation  set pm_signimage = capobj ->> 'pm_signimage', pm_signdate = (capobj ->> 'pm_signdate')::date
           where cap_number=v_objectid and delete_sw ='N';  
elseif(capobj ->> 'ed_signimage' is not null)then           
           update prov_violation  set ed_signimage =capobj ->>  'ed_signimage',ed_signdate = (capobj ->> 'ed_signdate')::date
           where cap_number=v_objectid and delete_sw ='N';
end if; 

------CAP Routing 
if (v_assignsecurityuserid is null)then 
select array_to_json(
array_agg(tp.provider_id)) into v_assignsecurityuserid ::json 
  from tb_provider tp 
inner join tb_provider_complaint tpc on  tp.provider_id = tpc.provider_id
inner join tb_provider_complaint_deficiency tpcd on tpc.provider_complaintid = tpcd.provider_complaintid
where tpcd.cap_number =  capobj ->> 'objectid' limit 1;
end if;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
   SELECT  tm.teamid ,tm.loadnumber ,tm.roletypekey INTO                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                 v_teamid,v_fromloadnumber,v_fromroleid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
         FROM    teammemberassignment tma                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
         INNER JOIN  teammember tm                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                 ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
         WHERE  tma.SecurityUsersId = v_securityuserid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
         AND   tma.activeflag =1;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
   SELECT routingid   INTO v_routingid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
             FROM routing r WHERE tosecurityusersid = v_securityuserid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
             AND r.activeflag =1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
             AND r.objectid  = v_objectid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
             and r.eventcode = capobj ->> 'appevent'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
             ORDER BY insertedon DESC LIMIT 1;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
/*Mark previous data as inactive and mark as rereiview*/                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
UPDATE routing SET  activeflag =0  , updatedby = v_securityuserid,updatedon= v_date  WHERE routingid = v_routingid;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     
for i IN SELECT * FROM json_array_elements_text(v_assignsecurityuserid)
loop
RAISE NOTICE 'before ii:%', v_securityuserid;       
                 INSERT INTO routing(                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                             eventcode, fromsecurityusersid, tosecurityusersid, teamid,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                             fromroleid, toroleid,objectid , routingstatustypeid,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                             insertedby,  updatedby,insertedon,updatedon, isreviewrequest,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                             remarks,routeddescription,servicerequestnumber)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
               SELECT coalesce(capobj ->> 'appevent',''), coalesce(v_securityuserid,''), tma.SecurityUsersId, tm.teamid,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
                         v_fromroleid, tm.roletypekey  , coalesce(v_objectid,''),(capobj->>'status')::bigint,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
                         v_securityuserid,v_securityuserid, v_date,v_date,true,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
                         coalesce(capobj ->> 'commenttext',''), coalesce(capobj ->> 'routingdescription',''),coalesce(v_servicerequestno,'')                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                  FROM teammemberassignment tma                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
                  INNER join teammember tm                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                     ON tm.teammemberid = tma.teammemberid  AND tm.activeflag= 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                  left join teammemberroletype  tmrt                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
                     ON tmrt.roletypekey = tm.roletypekey  AND tmrt.activeflag= 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                 INNER join userprofile up                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                     ON up.securityusersid = tma.securityusersid AND up.activeflag= 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                 left join routingcONfig rc                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
                     ON rc.targetrolekey = tm.roletypekey   AND rc.activeflag= 1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                     and rc.sourcerolekey =v_fromroleid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                 WHERE /* tm.teamid =v_teamid  AND */ 
                 tma.SecurityUsersId = i :: character varying
                 AND tma.activeflag =1  limit 1
                RETURNING tosecurityusersid INTO v_tosecurityusersid; 
    select  (array_append(touserid, v_tosecurityusersid)) into touserid;
    RAISE NOTICE 'vtousersid----%', touserid;
end loop;
---------Bell Notification                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
                
SELECT coalesce(lastname,'')||', '|| coalesce(firstname,'')into v_username                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     FROM userprofile WHERE securityusersid = v_securityuserid; 

 v_msg:= coalesce( capobj ->> 'notification' ,'')|| ' by ' || coalesce(v_username,'');

FOR i IN SELECT * FROM json_array_elements_text(array_to_json(touserid))
LOOP                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
 SELECT prov_send_notification INTO v_notifystatus FROM prov_send_notification(i,v_securityuserid, i,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
                         'System', 'High', v_msg,  v_msg , v_objectid);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   

END LOOP;

v_status:='SUCCESS';  
RAISE NOTICE 'array_to_json(touserid)---:%',array_to_json(touserid);

RETURN query 
select  v_assignsecurityuserid,v_status;


 END;
$function$

