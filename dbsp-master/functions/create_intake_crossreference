CREATE OR REPLACE FUNCTION create_intake_crossreference(j_intakecrossrefs json, v_intakenumber character varying, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

i json;
v_with_intakenumber character varying;
v_from_intakenumber character varying;
 
BEGIN

v_with_intakenumber:= v_intakenumber;

  FOR i IN SELECT * FROM json_array_elements(j_intakecrossrefs)
 LOOP
  v_from_intakenumber:= i ->> 'intakenumber';
  
  Insert Into intakecrossreference (fromintakenumber, withintakenumber, insertedby) values (v_from_intakenumber, v_with_intakenumber, v_securityuserid);
  
 End LOOP;
 
 Return 'Success';
 
END;

$function$

