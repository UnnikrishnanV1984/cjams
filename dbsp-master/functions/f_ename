CREATE OR REPLACE FUNCTION f_ename(as_user_id character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
 
BEGIN
return
      (SELECT COALESCE (first_nm || ' ','') || 
    COALESCE (middle_nm || ' ','') || 
    COALESCE (last_nm || ' ','') || 
    COALESCE (chessie.F_PDESC(suffix_cd,214),'') 
   from chessie.tb_staff
   where user_id = f_ename.as_user_id and delete_sw = 'N');

END;
 

$function$

