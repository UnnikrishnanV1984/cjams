CREATE OR REPLACE FUNCTION updateprogaddress(insertobj json)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$ 
declare

v_addressid uuid;


begin
v_addressid:=insertobj->>'address_id';

update tb_provider_applicant_addresses set adr_street_no=COALESCE((insertobj->>'adr_street_no')::int,adr_street_no),
             adr_street_nm=COALESCE((insertobj->>'adr_street_nm'),adr_street_nm),
             adr_city_nm=COALESCE((insertobj->>'adr_city_nm'),adr_city_nm),
               adr_zip5_no=COALESCE((insertobj->>'adr_zip5_no')::int,adr_zip5_no),
                 adr_county_cd=COALESCE((insertobj->>'adr_county_cd'),adr_county_cd)
                 where address_id=v_addressid;
update tb_provider_address_mapping set  address_type=COALESCE((insertobj->>'address_type'),address_type)
 where address_id=v_addressid;
               
 
return 'success';

end

$function$

