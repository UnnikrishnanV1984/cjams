CREATE OR REPLACE FUNCTION getreporternamefull(objecttypekey character varying, objectid character varying, roletype character varying)
 RETURNS TABLE(youthname character varying, youthfn character varying, youthln character varying, youthsuffix character varying)
 LANGUAGE plpgsql
AS $function$ declare l_personname character varying;                                                                                                                                                           
                                                                                                                                                                                                                 
 l_firstname character varying;                                                                                                                                                                                  
                                                                                                                                                                                                                 
 l_lastname character varying;                                                                                                                                                                                   
                                                                                                                                                                                                                 
 l_suffix character varying;   
 v_objectid character varying;
 begin      
         v_objectid := objectid;
         return query                                                                                                                                                                                            
 select                                                                                                                                                                                                          
         cast(initcap(trim(coalesce(PN.lastname, ''))|| case when PN.suffix is not null then ' ' else '' end || trim(coalesce(PN.suffix, '')) || ', ' || trim(coalesce(PN.firstname, ''))) as character varying),
         PN.firstname,                                                                                                                                                                                           
         PN.lastname,                                                                                                                                                                                            
         PN.suffix                                                                                                                                                                                               
         from                                                                                                                                                                                                    
                 intakeservicerequestactor ISRA                                                                                                                                                                  
         inner join person as PN on                                                                                                                                                                              
                 PN.personid = ISRA.personid                                                                                                                                                                     
                 and PN.activeflag = 1                                                                                                                                                                           
         where                                                                                                                                                                                                   
                 intakeservicerequestpersontypekey in ('CLI',                                                                                                                                                    
                 'CHILD',                                                                                                                                                                                        
                 'BIOCHILD',                                                                                                                                                                                     
                 'OTHERCHILD',                                                                                                                                                                                   
                 'RC',                                                                                                                                                                                           
                 'RA',                                                                                                                                                                                           
                 'Youth',                                                                                                                                                                                        
                 '2085',                                                                                                                                                                                         
                 'PA')                                                                                                                                                                                           
                 and ISRA.activeflag = 1                                                                                                                                                                         
                 and ISRA.intakeserviceid:: character varying = v_objectid                                                                                                                                         
         limit 1;                                                                                                                                                                                                
                                                                                                                                                                                                                 
                                                                                                                                                                                                                 
 end;                                                                                                                                                                                                            
                                                                                                                                                                                                                 
 $function$

