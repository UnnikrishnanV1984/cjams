CREATE OR REPLACE FUNCTION as_f_fm300r_child(start_date date, end_date date)
 RETURNS TABLE(reporting_period_first_day date, reporting_period_lasy_day date, return_rundate timestamp with time zone, county character varying, county_cd character varying, account_type character, account_no_tx character varying, opent_dt date, account_status character varying, client_id bigint, client_name text, in_receipt_of_ssi text, total_balance_bom numeric, available_balance_coc_bom numeric, available_balance_anc_bom numeric, obligated_bom numeric, receipts_for_coc_month numeric, receipts_for_anc_month numeric, actual_coc_month numeric, coc_reimbursement_month numeric, excess_available_for_anc numeric, obligated_month numeric, obligations_liquidation_month numeric, ancillary_payments_month numeric, total_balance_eom numeric, available_for_anc_eom numeric, available_balance_no_coc_eom numeric, obligated_eom numeric, final_disbursement_amt numeric, date_closed date, status_cd_not_a_rpt_column character varying, client_account_id bigint)
 LANGUAGE plpgsql
AS $function$
 BEGIN
 RETURN QUERY 
( 

Select   START_DATE  as reporting_period_first_day
    ,END_DATE  as reporting_period_last_day
    ,now() as return_rundate
    ,TB_main2.county
    ,TB_main2.county_cd
    ,TB_main2.account_type
    ,TB_main2.account_no_tx
    ,TB_main2.open_dt
    ,TB_main2.account_status
    ,TB_main2.client_id
    ,TB_main2.client_name
    --,TB_main2.case_status
    ,TB_main2.In_receipt_of_ssi
    ,TB_main2.total_balance_bom
    ,TB_main2.available_balance_coc_bom
    ,TB_main2.available_balance_anc_bom

    , ( CASE WHEN coalesce(TB_main2.obligated_bom,0) > 0 THEN
       TB_main2.obligated_bom
      ELSE  
        0
      END ) AS obligated_bom

    ,TB_main2.RECEIPTS_FOR_COC_month
    ,TB_main2.RECEIPTS_FOR_ANC_month
    ,TB_main2.actual_coc_month
    ,TB_main2.COC_REIMBURSEMENT_month
    ,TB_main2.Excess_available_for_anc
    ,TB_main2.obligated_month
    ,TB_main2.OBLIGATIONS_LIQUIDATION_month
    ,TB_main2.Ancillary_payments_month
    ,TB_main2.total_balance_eom
    ,TB_main2.available_for_anc_eom
    ,TB_main2.AVAILABLE_BALANCE_NO_COC_EOM
    ,TB_main2.obligated_eom
    ,TB_main2.final_disbursement_amt
    ,TB_main2.date_closed
    ,TB_main2.status_cd as status_cd_not_a_rpt_column
    ,TB_main2.client_account_id
FROM
(
Select
  
    TB_main.county
    ,TB_main.account_type
    ,TB_main.account_no_tx
    ,TB_main.open_dt
    ,TB_main.account_status
    ,TB_main.client_id
    ,TB_main.client_name
    --,TB_main.case_status
    ,TB_main.In_receipt_of_ssi

    ,(  coalesce(TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM,0) 
        + coalesce(TB_MAIN.available_anc_eom,0) 
        + coalesce(TB_MAIN.obligated_eom,0)
        + coalesce(TB_MAIN.COC_REIMBURSEMENT_month,0)
        + coalesce(TB_MAIN.Ancillary_payments_month,0)
        + coalesce(TB_MAIN.final_disbursement_amt,0)
        - coalesce(TB_MAIN.RECEIPTS_FOR_ANC_month,0)
        - coalesce(TB_MAIN.RECEIPTS_FOR_COC_month,0)
     ) as total_balance_bom

    ,( coalesce(TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM,0) 
        + coalesce(TB_MAIN.COC_REIMBURSEMENT_month,0) 
        + coalesce(TB_MAIN.Excess_available_for_anc,0)
        - coalesce(TB_MAIN.RECEIPTS_FOR_COC_month,0)
     ) as available_balance_coc_bom

    ,( coalesce(TB_MAIN.available_anc_eom,0) 
      + coalesce(TB_MAIN.Ancillary_payments_month,0) 
      + coalesce(TB_MAIN.final_disbursement_amt,0)
      - coalesce(TB_MAIN.RECEIPTS_FOR_ANC_month,0)
      - coalesce(TB_MAIN.Excess_available_for_anc,0) 
      - ( coalesce(TB_MAIN.OBLIGATIONS_LIQUIDATION_month,0)
        - coalesce(TB_MAIN.obligated_month,0)
        )
     ) as available_balance_anc_bom

    ,( 
      coalesce(TB_MAIN.obligated_eom,0)
      + coalesce(TB_MAIN.OBLIGATIONS_LIQUIDATION_month,0)
      - coalesce(TB_MAIN.obligated_month,0) 
    ) as obligated_bom

    ,coalesce(TB_MAIN.RECEIPTS_FOR_COC_month,0) as RECEIPTS_FOR_COC_month

    ,coalesce(TB_MAIN.RECEIPTS_FOR_ANC_month,0) as RECEIPTS_FOR_ANC_month

    ,coalesce(TB_MAIN.actual_coc,0) as actual_coc_month

    ,coalesce(TB_MAIN.COC_REIMBURSEMENT_month,0) as COC_REIMBURSEMENT_month

    ,coalesce(TB_MAIN.Excess_available_for_anc,0) as Excess_available_for_anc

    ,coalesce(TB_MAIN.obligated_month,0) as obligated_month

    ,coalesce(TB_MAIN.OBLIGATIONS_LIQUIDATION_month,0) as OBLIGATIONS_LIQUIDATION_month

    ,coalesce(TB_MAIN.Ancillary_payments_month,0) as Ancillary_payments_month

    ,CASE WHEN coalesce(TB_MAIN.final_disbursement_amt,0) > 0 THEN 
      0 
     ELSE 
      (coalesce(TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM,0)
        + coalesce(TB_MAIN.available_anc_eom,0) 

        + coalesce(TB_MAIN.obligated_eom,0)
      
    ) END as total_balance_eom
    
    ,CASE WHEN coalesce(TB_MAIN.final_disbursement_amt,0) > 0 THEN 
      0 
     ELSE 
      coalesce(TB_MAIN.available_anc_eom,0) 
     END as available_for_anc_eom
    
    ,CASE WHEN coalesce(TB_MAIN.final_disbursement_amt,0) > 0 THEN 
      0 
     ELSE 
      coalesce(TB_MAIN.AVAILABLE_BALANCE_NO_COC_EOM,0) 
     END as AVAILABLE_BALANCE_NO_COC_EOM
    
    ,( CASE WHEN coalesce(TB_MAIN.final_disbursement_amt,0) > 0 THEN 
        0 
       ELSE 
        coalesce(TB_MAIN.obligated_eom,0)
       END 
    ) as obligated_eom
    
    ,TB_main.final_disbursement_amt
    ,TB_main.county_cd
    ,TB_main.date_closed
    ,TB_main.status_cd
    ,TB_main.client_account_id
FROM
(

  SELECT
  
  F_plvalue(ca.county_cd,104) as county
  ,cast(F_plvalue(ca.account_type_cd,40) as char(15))as account_type
  ,ca.account_no_tx
  ,ca.open_Dt
  ,F_Plvalue(ca.status_cd,41) as account_status
  ,ca.client_id
  ,ca.county_cd
  ,(select distinct last_nm||','||first_nm from TB_client where delete_Sw = 'N' and TB_client.client_id = ca.client_id) as client_name
                           
                            
  /*,(select F_plvalue(caseactiontypekey,1544) 
    from caseclient cc 
       join casehistory ch on cc.caseid = ch.caseid
        and cc.activeflag = 0 
        and ch.activeflag = 0 
    where ((SELECT pr.personidentifiervalue FROM personidentifier pr join caseclient ca on pr.personid = ca.personid),cc.caseid) 
    IN (select old_id,caseid 
                      from personprogramarea
                      where old_id IN
                          ( select old_id 
                            from personprogramarea
                            where activeflag = 0
                              -- and agencyprogramareaid = 2 --uuid
                              and old_id = ca.old_id
                            order by coalesce(enddate,current_date),startdate
                            fetch first 1 row only
                           )
                     )
      and (SELECT pr.personidentifiervalue FROM personidentifier pr join caseclient ca on pr.personid = ca.personid) = ca.fk_id
      and ch.old_id IN (select max(old_id) 
                  from casehistory
                  where activeflag = 0
                  group by caseid
                  ) 
   ) as case_Status*/

  
  ,SUM(
      (CASE WHEN TR.TRANSACTION_TYPE_CD = '5530'
            AND TR.CREDIT_DEBIT_SW = 'D' 
            AND TR.TRANSACTION_SOURCE_CD = '5474'
            AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
            AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')  
          THEN  
        COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
      ELSE
        0
      END )
        ) as obligated_month
  
   ,SUM(
      ( CASE WHEN TR.TRANSACTION_TYPE_CD = '5530'
            AND TR.CREDIT_DEBIT_SW = 'C' 
            AND TR.TRANSACTION_SOURCE_CD = '5475'
            AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
            AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')  
          THEN  
            COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
       ELSE
        0
       END 
      )
        ) AS OBLIGATIONS_LIQUIDATION_month
  
  ,SUM(
      ( CASE WHEN TR.TRANSACTION_TYPE_CD = '5531'
            AND TR.CREDIT_DEBIT_SW = 'D' 
            AND TR.TRANSACTION_SOURCE_CD = '5476'
            AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
            AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month') 
          THEN 
            COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
       ELSE
        0
       END 
      )
        ) AS Ancillary_payments_month
  
  ,(
    COALESCE((SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
          FROM TB_PAYMENT_DETAIL PD,
             TB_PAYMENT_HEADER PH,
               TB_PAYMENT_STATUS PS,
             TB_PLACEMENT PL
          WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
            AND PH.PAYMENT_ID = PS.PAYMENT_ID
            AND PL.PLACEMENT_ID = PD.PLACEMENT_ID
            AND DATE_PART('MONTH',PD.FINAL_SERVICE_START_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
            AND DATE_PART('YEAR',PD.FINAL_SERVICE_START_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
            AND ( PH.PAYMENT_TYPE_CD = '6' OR (PH.PAYMENT_TYPE_CD = '3294' AND PH.MANUAL_SW  = 'N' ))
            AND PH.DELETE_SW = 'N'
            AND PD.DELETE_SW = 'N'
            AND PS.DELETE_SW = 'N'
            AND PL.DELETE_SW = 'N'
            AND PD.FINAL_SERVICE_ID IS NOT NULL
            AND PS.PAYMENT_STATUS_CD NOT IN ('1635','1639')
            AND PD.PLACEMENT_ID IS NOT NULL
            AND ( PL.VOID_SW = 'N' OR PL.VOID_SW is null OR RTRIM(LTRIM(PL.VOID_SW)) = '')
            AND PD.CLIENT_ID = CA.CLIENT_ID ),0)
    -
    COALESCE((SELECT SUM(COALESCE(RD.AMOUNT_NO,0)  )
          FROM TB_RECEIVABLE_DETAIL RD
          WHERE RD.DELETE_SW = 'N'
            AND RD.PAYMENT_DETAIL_ID in 
                (
                  SELECT distinct PD.PAYMENT_DETAIL_ID
                    FROM TB_PAYMENT_DETAIL PD,
                       TB_PAYMENT_HEADER PH,
                       TB_PAYMENT_STATUS PS,
                       TB_PLACEMENT PL
                  WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
                    AND PH.PAYMENT_ID = PS.PAYMENT_ID
                    AND PL.PLACEMENT_ID = PD.PLACEMENT_ID
                    AND DATE_PART('MONTH',PD.FINAL_SERVICE_START_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
                    AND DATE_PART('YEAR',PD.FINAL_SERVICE_START_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
                    AND ( PH.PAYMENT_TYPE_CD = '6' OR (PH.PAYMENT_TYPE_CD = '3294' AND PH.MANUAL_SW  = 'N' ))
                    AND PH.DELETE_SW = 'N'
                    AND PD.DELETE_SW = 'N'
                    AND PS.DELETE_SW = 'N'
                    AND PL.DELETE_SW = 'N'
                    AND PD.FINAL_SERVICE_ID IS NOT NULL
                    AND PS.PAYMENT_STATUS_CD NOT IN ('1635','1639')
                    AND PD.PLACEMENT_ID IS NOT NULL
                    AND ( PL.VOID_SW = 'N' OR PL.VOID_SW is null OR RTRIM(LTRIM(PL.VOID_SW)) = '')
                    AND PD.CLIENT_ID = CA.CLIENT_ID
                )
         ),0)
    +
    COALESCE(
    (
    select SUM(( CASE WHEN (fd.coc_funding_amt + fd.ssi_funding_amt + fd.ssa_funding_amt) = 0 THEN 
            fd.payment_amount
          ELSE
            ( fd.payment_amount - ( fd.coc_funding_amt + fd.ssi_funding_amt + fd.ssa_funding_amt) )
          END
          ))
    from TB_fund_allocation_detail fd
    where fd.fund_alloc_history_id IN
               ( select max(fd1.fund_alloc_history_id)
            from TB_fund_allocation_detail fd1
           where fd1.payment_detail_id IN
              ( select distinct payment_detail_id
                from TB_payment_detail
                where delete_sw = 'N'
                and final_service_id is not null
                and TB_payment_detail.client_id = ca.client_id
              )
            and fund_alloc_id IN 
              ( select distinct fund_alloc_id
                from TB_fund_allocation_master
                where initial_Stamping_sw = 'N'
                and ( coalesce(ssi_funding_amt,0)
                  + coalesce(ssa_funding_amt,0)
                  + coalesce(coc_funding_amt,0)
                   ) > 0
                and fund_allocation_date BETWEEN START_DATE  and END_DATE  
              )
            and fd1.fund_allocation_date < START_DATE 
            group by fd1.fund_alloc_id
          )
    )
    ,0)
    ) AS ACTUAL_COC
  
  ,SUM(
      (
        CASE WHEN TR.TRANSACTION_TYPE_CD = '3444'
          AND TR.CREDIT_DEBIT_SW = 'D'
          AND TR.TRANSACTION_SOURCE_CD = '5477'
          AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(now()))
          AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(now()))
          THEN 
          COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
        ELSE
          0
        END 
      )
        ) AS COC_REIMBURSEMENT_month
  
  ,COALESCE((select sum(tat.transaction_amount_no)
          from TB_account_transaction tat
        where tat.client_account_id = ca.client_account_id
          and tat.delete_sw = 'N'
          and tat.transaction_type_cd = '589'
          and tat.transaction_source_cd in ('587','585','586')
          and (
              ( tat.benefit_start_dt < START_DATE 
              and tat.transaction_dt between START_DATE  and END_DATE 
               )
              or 
              ( tat.benefit_start_dt between START_DATE  and END_DATE  
              and tat.transaction_dt between START_DATE  and END_DATE 
              )
            )
        group by tat.client_account_id)
      ,0)
  +


  COALESCE((select sum(tat.transaction_amount_no)
          from TB_account_transaction tat
          where tat.client_account_id = ca.client_account_id
          and tat.delete_sw = 'N'
          and tat.transaction_type_cd = '588'
          AND Tat.CREDIT_DEBIT_SW = 'C'
          AND Tat.TRANSACTION_SOURCE_CD = '5473'
          aND Tat.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
          AND ((SELECT distinct TR2.TRANSACTION_SOURCE_CD
                FROM TB_ACCOUNT_TRANSACTION TR2
              WHERE TR2.TRANSACTION_ID = tat.REFERENCE_TRANSACTION_ID
                AND TR2.DELETE_SW = 'N'
              ) in ( '587', '586', '585' )
            )
          and (
              ( tat.benefit_start_dt < START_DATE 
               and tat.transaction_dt between START_DATE  and END_DATE )
              or 
              ( tat.benefit_start_dt between START_DATE  and END_DATE  
                and tat.transaction_dt  between START_DATE  and END_DATE )
            )
        group by tat.client_account_id)
      ,0)

  -

    SUM(
    ( CASE WHEN TR.TRANSACTION_TYPE_CD = '3444'
          AND TR.CREDIT_DEBIT_SW = 'D' 
          AND TR.TRANSACTION_SOURCE_CD = '5477'
          AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(now()))
          AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(now()))
        THEN 
          COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
      ELSE
        0
      END 
    )
     )
     
    -
  
  COALESCE((select sum(tat.transaction_amount_no)
          from TB_account_transaction tat
          where tat.client_account_id = ca.client_account_id
          and tat.delete_sw = 'N'
          and tat.transaction_type_cd = '588'
          AND Tat.CREDIT_DEBIT_SW = 'D'
          AND Tat.TRANSACTION_SOURCE_CD = '5473'
          aND Tat.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
          AND ((SELECT distinct TR2.TRANSACTION_SOURCE_CD
                FROM TB_ACCOUNT_TRANSACTION TR2
              WHERE TR2.TRANSACTION_ID = tat.REFERENCE_TRANSACTION_ID
                AND TR2.DELETE_SW = 'N' 
              ) in ( '587', '586', '585' )
            )
          and (
              ( tat.benefit_start_dt < START_DATE  
                and tat.transaction_dt between START_DATE  and END_DATE 
              )
              or 
              ( tat.benefit_start_dt between START_DATE  and END_DATE  
                and tat.transaction_dt  between START_DATE  and END_DATE 
              )
            )
          group by tat.client_account_id)
        ,0) 
  AS Excess_available_for_anc
  
  ,(
       SUM(
      ( CASE WHEN TR.TRANSACTION_TYPE_CD = '589' 
            AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
            AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
            AND TR.CREDIT_DEBIT_SW = 'C'
            AND (TR.TRANSACTION_SOURCE_CD in ( '5471', '582', '583', '584','5478' ) ) THEN 
          COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
        ELSE
          0
        END 
      )
          )
    
  +
  
    COALESCE(( SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))
          FROM TB_ACCOUNT_TRANSACTION TR1,
             TB_CLIENT_ACCOUNT AC1
         WHERE TR1.CLIENT_ACCOUNT_ID = AC1.CLIENT_ACCOUNT_ID
          AND AC1.CLIENT_ACCOUNT_ID = ca.client_account_id
          AND TR1.DELETE_SW = 'N'
          AND AC1.DELETE_SW = 'N'
          
          AND DATE_PART('MONTH',TR1.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
          AND DATE_PART('YEAR',TR1.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
          
          AND TR1.TRANSACTION_TYPE_CD = '588' 
          AND TR1.CREDIT_DEBIT_SW = 'C'
          AND TR1.TRANSACTION_SOURCE_CD = '5473' 
          AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
          AND (( SELECT distinct TR2.TRANSACTION_SOURCE_CD
                FROM TB_ACCOUNT_TRANSACTION TR2
               WHERE TR2.TRANSACTION_ID = TR1.REFERENCE_TRANSACTION_ID
                AND TR2.DELETE_SW = 'N' ) in ( '5471', '582', '583', '584','5478' )
            ) 
         GROUP BY ac1.client_account_id,
            benefit_Start_dt,
            benefit_end_dt
       )
      ,0)
   
    -

    COALESCE(( SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))
          FROM TB_ACCOUNT_TRANSACTION TR1,
             TB_CLIENT_ACCOUNT AC1
         WHERE TR1.CLIENT_ACCOUNT_ID = AC1.CLIENT_ACCOUNT_ID
          AND AC1.CLIENT_ACCOUNT_ID = ca.client_account_id
          AND TR1.DELETE_SW = 'N'
          AND AC1.DELETE_SW = 'N'

          AND DATE_PART('MONTH',TR1.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
          AND DATE_PART('YEAR',TR1.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
        
          AND TR1.TRANSACTION_TYPE_CD = '588'
          AND TR1.CREDIT_DEBIT_SW = 'D'
          AND TR1.TRANSACTION_SOURCE_CD = '5473'
          AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
          AND (( SELECT distinct TR2.TRANSACTION_SOURCE_CD
                FROM TB_ACCOUNT_TRANSACTION TR2
               WHERE TR2.TRANSACTION_ID = TR1.REFERENCE_TRANSACTION_ID
                AND TR2.DELETE_SW = 'N' 
              ) in ( '5471', '582', '583', '584','5478' )
             )

       )
      ,0)
  

  - SUM(
      ( CASE WHEN TR.TRANSACTION_TYPE_CD = '588' 

            AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
            AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
          
            AND TR.CREDIT_DEBIT_SW = 'D'  
            AND ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
            AND (TR.TRANSACTION_SOURCE_CD in ('5472') )  -- Bank Charges
        THEN 
          COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
        ELSE
          0
        END 
      )
         )
    ) AS RECEIPTS_FOR_ANC_month
  
  ,(
    SUM((CASE WHEN TR.TRANSACTION_TYPE_CD = '589'
          AND TR.CREDIT_DEBIT_SW = 'C' 
          AND TR.TRANSACTION_SOURCE_CD in ( '587', '586', '585' )
          
          AND DATE_PART('MONTH',TR.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month') 
          AND DATE_PART('YEAR',TR.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month') THEN 
          
        COALESCE(TR.TRANSACTION_AMOUNT_NO,0)
       ELSE
        0
       END 
      )
           )
       
  +
  
  COALESCE(( SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))
          FROM TB_ACCOUNT_TRANSACTION TR1,
             TB_CLIENT_ACCOUNT AC1
        WHERE TR1.CLIENT_ACCOUNT_ID = AC1.CLIENT_ACCOUNT_ID
          AND AC1.CLIENT_ACCOUNT_ID = ca.client_account_id
          AND TR1.DELETE_SW = 'N'
          AND AC1.DELETE_SW = 'N'
          AND TR1.TRANSACTION_TYPE_CD = '588'
          AND TR1.CREDIT_DEBIT_SW = 'C'
          AND TR1.TRANSACTION_SOURCE_CD = '5473'
          AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
          
          AND DATE_PART('MONTH',TR1.TRANSACTION_DT) = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
          AND DATE_PART('YEAR',TR1.TRANSACTION_DT) = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
          
          AND (( SELECT distinct TR2.TRANSACTION_SOURCE_CD
                FROM TB_ACCOUNT_TRANSACTION TR2
              WHERE TR2.TRANSACTION_ID = TR1.REFERENCE_TRANSACTION_ID
                  AND TR2.DELETE_SW = 'N' 
                  
                  AND DATE_PART('MONTH',TR2.TRANSACTION_DT)  = DATE_PART('MONTH',DATE(START_DATE ) - interval '1 month')
                  AND DATE_PART('YEAR',TR2.TRANSACTION_DT)  = DATE_PART('YEAR',DATE(START_DATE ) - interval '1 month')
                  
              ) in ( '587', '586', '585' )
            )
        GROUP BY ac1.client_account_id
        )
      ,0)
      
   -
   
     COALESCE(( SELECT SUM(COALESCE(TR1.TRANSACTION_AMOUNT_NO,0))
     FROM TB_ACCOUNT_TRANSACTION TR1,
        TB_CLIENT_ACCOUNT AC1
    WHERE TR1.CLIENT_ACCOUNT_ID = AC1.CLIENT_ACCOUNT_ID
         AND AC1.CLIENT_ACCOUNT_ID = ca.client_account_id
         AND TR1.DELETE_SW = 'N'
         AND AC1.DELETE_SW = 'N'
         AND TR1.TRANSACTION_TYPE_CD = '588'
         AND TR1.CREDIT_DEBIT_SW = 'D'
         AND TR1.TRANSACTION_SOURCE_CD = '5473'
         AND TR1.ADJUSTMENT_APPROVAL_STATUS_CD = '3047'
     
