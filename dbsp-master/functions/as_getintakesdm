CREATE OR REPLACE FUNCTION as_getintakesdm(intakeservicerequestsdmid uuid)
 RETURNS TABLE(sdmmaltreatmentid uuid, maltreatmenttype character varying, maltreatorsname character varying, activeflag integer, updatedby character varying, updatedon character varying, insertedby character varying, insertedon timestamp without time zone, effectivedate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$

   
BEGIN

    RETURN QUERY
    
    select in12.sdmmaltreatmentid,in12.maltreatmenttype,in12.maltreatorsname,in12.maltreatorsname,in12.activeflag,in12.updatedby,in12.updatedon,in12.insertedby,in12.insertedon,in12.effectivedate from intakeservrequestsdmmaltreatment in12 inner join intakeservicerequestsdm in13 on in12.intakeservicerequestsdmid=in13.intakeservicerequestsdmid;
  End;
$function$

