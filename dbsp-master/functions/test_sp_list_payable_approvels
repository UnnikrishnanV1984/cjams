--and coalesce(ads_approval_status_cd,'''') = '''||v_ads_approval_status_cd||'''
-- and coalesce(payment_approval_status_cd,'''') ='''||v_payment_approval_status_cd|| '''
 order by tspa.authorization_id desc 
 limit '||pagesize||' offset '|| v_pageoffset;


 RAISE NOTICE 'query_other %', query_other ;
if(v_approveltype = 'funding')
then 
  return query execute query_funding;
 else if(v_approveltype = 'payment')
then 
