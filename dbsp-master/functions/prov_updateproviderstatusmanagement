CREATE OR REPLACE FUNCTION prov_updateproviderstatusmanagement(insertobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$ 
declare
v_securityuserid character varying;
v_provider_status_management_id character varying;
v_approval_status character varying;
v_program_type_id character varying;
v_dirty_status boolean;
v_providerid character varying;

begin
v_securityuserid:=insertobj->>'securityuserid';
v_provider_status_management_id:=insertobj->>'provider_status_management_id';
v_approval_status:=insertobj->>'approval_status';
v_dirty_status:=insertobj->>'dirty_status';
v_providerid=insertobj->>'object_id';

update publicproviderstatusmanagement set 
    approval_status = v_approval_status, 
    decision_dt = now(),
    update_ts = now(),
    update_user_id =v_securityuserid ,
    dirty_status = v_dirty_status
    where provider_status_management_id = v_provider_status_management_id::uuid and object_id=v_providerid;

return 'success'; 

end;
$function$

