CREATE OR REPLACE FUNCTION as_workernotification(to_userid text)
 RETURNS text
 LANGUAGE plpgsql
AS $function$        


DECLARE
v_touser text[];          
v_record json;
BEGIN

v_touser :=to_userid;


FOR v_record in 

 SELECT * FROM json_array_elements(v_touser) 
loop
RAISE NOTICE 'v_touser.to_userid %', v_touser.to_userid ;
END loop;
RETURN 'success' ;
  
END;
$function$

