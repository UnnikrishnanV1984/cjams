CREATE OR REPLACE FUNCTION as_f_sp_ename3(as_type_cd character varying, ai_key_id integer, as_report character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE 
 declare vi_start_screening_id integer;
BEGIN 

       select ((rtrim(app_pref_value_tx))::INTEGER) INTO vi_start_screening_id from tb_application_preference where app_pref_id = 52;
    
   IF AI_KEY_ID IS NOT NULL THEN
      IF as_type_cd = '2952' then
            return  (select ISRT.intakeservreqtypekey from intakeservicerequest ISR 
INNER JOIN intakeservicerequesttype ISRT ON ISR.intakeservreqtypeid=ISRT.intakeservreqtypeid
where servicerequestnumber=ai_key_id and activeflag=1);
   --SELECT case_nm  FROM  tb_case WHERE case_id = ai_key_id AND delete_sw = 'N');
      END IF;

      IF as_type_cd = '2953' then
    return   (select CASE WHEN LENGTH(RTRIM(provider_nm)) > 0 THEN provider_nm
                  ELSE
                    coalesce(f_pdesc(provider_PREFIX_cd,150),'') || ' '|| 
                    coalesce(provider_first_nm || ' ','')  ||
                    coalesce(provider_middle_nm || ' ','') ||
                    coalesce(provider_last_nm || ' ','') ||
                    coalesce(f_pdesc(provider_suffix_cd,214),'')
                   END
                 from  tb_provider where provider_id = ai_key_id and delete_sw = 'N');
      END IF;

      if as_type_cd = '2954' then
        if AI_KEY_ID >= vi_start_screening_id then
               return (select screening_nm from  tb_screening where screening_id = ai_key_id and delete_sw = 'N');
       else
               return (select referral_nm from  tb_referral where referral_id = ai_key_id and delete_sw = 'N');
              end if; 
      end if;

      if as_type_cd = '2957' then
              return (select referral_nm from  tb_referral where referral_id = ai_key_id and delete_sw = 'N');
      end if;

      if as_type_cd = '2955' and as_report = 'S' then
              return (select  coalesce(f_pdesc(PREFIX_cd,150),'') || ' '||
    coalesce(first_nm || ' ','') ||
    coalesce(middle_nm || ' ','') ||
    coalesce(last_nm || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from  tb_ssclient
   where client_id = ai_key_id and delete_sw = 'N');
      end if;

      if as_type_cd = '2955' and as_report != 'S' then
              return (select  coalesce(f_pdesc(PREFIX_cd,150),'') || ' '||
    coalesce(firstname || ' ','') ||
    coalesce(middlename || ' ','') ||
    coalesce(lastname || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from  person
   where cjamspid = ai_key_id and delete_sw = 'N');
           end if;

      if as_type_cd = '2956' then
            return (select coalesce(f_pdesc(PREFIX_cd,150),'') || ' '|| 
    coalesce(first_nm || ' ','') ||
    coalesce(middle_nm || ' ','') ||
    coalesce(last_nm || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from  tb_staff
   where staff_id = ai_key_id and delete_sw = 'N') ;
      end if;--

      if as_type_cd = '5589' then
              return (select  coalesce(first_nm || ' ','') ||
    coalesce(middle_nm || ' ','') ||
    coalesce(last_nm || ' ','') ||
    coalesce(f_pdesc(suffix_cd,214),'')
   from  tb_person
   where person_id = ai_key_id and delete_sw = 'N');
      end if;

      if as_type_cd = '5189' then
  return ( select  coalesce(provider_referral_nm,
     coalesce(f_pdesc(provider_referral_PREFIX_cd,150),'') || ' '||  
     coalesce(provider_referral_first_nm || ' ','')  ||
       coalesce(provider_referral_middle_nm || ' ','') ||
     coalesce(provider_referral_last_nm || ' ','')   ||
   coalesce(f_pdesc(provider_referral_suffix_cd,214),''),'')
   from  tb_provider_referral
   where provider_referral_id = ai_key_id and delete_sw = 'N' );
      end if;
  else    
     return space(1);
  end if;
  
end;

$function$

