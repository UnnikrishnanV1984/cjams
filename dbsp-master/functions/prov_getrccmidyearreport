CREATE OR REPLACE FUNCTION prov_getrccmidyearreport(v_monitoring_id character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
declare
v_provider_info json;
v_entrance_conf json;
v_exit_conf json;
v_provider_id integer;
v_staff_questions json;
v_pplant_questions json;
v_monitoring_details  json;
v_site_details json;
v_licenserecomm_info json;
v_child_record json;
v_child_questions json;
v_parent_questions json;
v_staff_record json;
v_parent_record json;
v_complaint_info json;
v_child_interview json;
v_staff_interview json;
v_parent_interview json;
v_monitor_info json;
v_site_list json;
v_officers_info json;
v_activity_info json;
v_board_interview json;
v_pplant_record json;
v_noncomplience_list_staff json;
v_noncomplience_list_parent json;
v_noncomplience_list_current json;
v_noncomplience_list_pplant json;
v_noncomplience_list json;
v_personsign json;
v_monitoring json;
v_pminfo_info json;
v_sofficers_info json;
v_license_info json;
v_corp_info json;
v_incident_info json;
v_monitoring_st_dt date;
v_monitoring_end_dt date;
v_startdate date;
v_enddate date;
v_prgram character varying;
v_records_type character varying;
v_reporting_start_date timestamp without time zone;
v_reporting_end_date timestamp without time zone;
v_previous_visit_start timestamp without time zone; 
v_previous_visit_end timestamp without time zone; 
begin
 raise notice 'monitoring: %', v_monitoring_id;
select provider_id,to_char(date_trunc('quarter', end_dt)  - interval '4 months' ),
to_char( end_dt),prgram,periodic into v_provider_id,v_startdate,v_enddate,
v_prgram,v_records_type from prov_monitoring where monitoring_id = v_monitoring_id limit 1;

select monitoring_period_start_date, monitoring_period_end_date into v_reporting_start_date,v_reporting_end_date from prov_monitoring pm where pm.monitoring_id = v_monitoring_id limit 1;
 
select provider_id, monitoring_dt,end_dt into v_provider_id,v_monitoring_st_dt,v_monitoring_end_dt from prov_monitoring where monitoring_id = v_monitoring_id limit 1;
 select json_agg(monitorinfo) into v_monitor_info from 
 (select * from prov_monitoring where monitoring_id in 
 (select monitoring_id from  prov_monitoring where  (monitoring_dt between
  v_startdate::date and v_enddate::date or end_dt is null) and provider_id=v_provider_id and prgram=v_prgram and
((periodic=v_records_type) and  (monitoring_id =v_monitoring_id))))monitorinfo;

    select json_agg(providerinfo) into v_provider_info from (select pi.agency,pi.provider_first_nm,pi.provider_nm,pi.provider_middle_nm,(cast((trim(tbpad.adr_street_tx) 
    ||' ' ||trim(tbpad.adr_street_nm) || ' '||trim(tbpad.adr_street_suffix_cd) ||'<br>' ||trim(INITCAP(tbpad.adr_city_nm)) ||', ' ||trim(tbpad.adr_state_cd) ||' ' || trim(tbpad.adr_zip5_no::character VARYING)) AS character VARYING)) AS address
    from tb_provider pi left join tb_provider_addresses tbpad on tbpad.parent_key_id = pi.provider_id :: character varying and tbpad.delete_sw ='N' where pi.provider_id=v_provider_id)providerinfo;

   select json_agg(licenseinfo) into v_license_info from 
  (select tpl.license_no, tpl.license_level, tpl.license_type, tpl.license_issue_dt ,tpl.license_expiry_dt ,
  tpdesc.provider_description,tacc.children_no,ta.license_agency,tacc.minimum_age_no,tacc.maximum_age_no,
  (select value_tx from tb_picklist_values where picklist_value_cd = tacc.gender_cd) as gender,
  (select value_tx from tb_picklist_values where picklist_type_id=286 and trim(picklist_value_cd)=trim(tpl.license_status_cd)) as license_status_cd,
  tpl.site_id, tp.provider_nm, tp.provider_category_cd, tp.adr_work_phone_tx,p.inspectedwith,
  (select * from prov_get_formatted_addresses(pms.site_id)) as address,
  (select  ' (' || SUBSTRING(phonenumber::text, 1, 3) || ') ' || SUBSTRING(phonenumber::text, 4,3) || '-' || SUBSTRING(phonenumber::text,7,4)  
 from userprofilephonenumber u where  u.securityusersid in (select toworkeridno from providerassignment where objectid = pms.site_id and activeflag = '1'  order by startdate desc limit 1)) as staffcell,
  (select u.username from muser u where  u.securityusersid in (select toworkeridno from providerassignment where
  objectid = pms.site_id and activeflag = '1'  order by startdate desc limit 1)) as staffname,
  (select r.name from muser u join rolemapping r2 on r2.principalid = u.id and r2.activeflag = '1'
join role r on r.id = r2.roleid where  u.securityusersid in (select toworkeridno from providerassignment where
  objectid = pms.site_id and activeflag = '1'  order by startdate desc limit 1) limit 1) as staffrole,
  
  
  (select json_agg(b)  from (
   select count( puid.precipitating_event),
   (select value_text from referencevalues  where ref_key=puid.precipitating_event limit 1) 
   from provider_uir pu 
   join provider_uir_incident_detail puid on pu.uir_no = puid.uir_no  
   join referencetype r2 on r2.typedescription = puid.incident_type 
   where pu.site_id =pms.site_id and pu.uir_statusdesc = 'UIR Approved'
   and (case when v_reporting_start_date is null then pu.effective_date between '1900-1-1'::date and '2023-05-13'::date
                        else pu.effective_date::date between v_reporting_start_date::date and v_reporting_end_date::date 
                    end) 
      group by puid.precipitating_event) b) as uirdetails,
  (select SUM(a.count)  from (select count(1) from provider_uir pu 
   join provider_uir_incident_detail puid on pu.uir_no = puid.uir_no 
   where pu.site_id =pms.site_id and pu.uir_statusdesc = 'UIR Approved'
   and (case when v_reporting_start_date is null then pu.effective_date between '1900-1-1'::date and '2023-05-13'::date
                        else pu.effective_date::date between v_reporting_start_date::date and v_reporting_end_date::date 
                    end) 
     
  ) a) as uircount,
  (select json_agg(a)  from (
   select (CASE WHEN tb_provider_complaint_deficiencyid is not null THEN  'Yes'  ELSE 'No'  end) as status, 
   complaint_number,complaint_date,complaint_source,narrative 
          from tb_provider_complaint TPC  
          left join tb_provider_complaint_deficiency tpcd on tpcd.provider_complaintid=tpc.provider_complaintid
          where tpc.site_id = pms.site_id
  ) a) as complaint_info,
  (select json_agg(a)  from(select distinct recordreviewdate from prov_monitoring_record_site prms where prms.site_id = pms.site_id and prms.recordreviewdate is not null)a) as reviewdate
  from 
  prov_monitoring_site pms 
  join prov_monitoring p on pms.monitoring_id = p.monitoring_id 
  join tb_provider_licensing tpl on tpl.site_id = pms.site_id and active_sw ='Y'
  join tb_provider tp on tpl.site_id = tp.provider_id
  left join tb_provider_corp_info tpdesc on tpl.site_id = tpdesc.provider_id
  left join tb_provider_applicant ta on tpl.site_id = ta.site_id and ta.application_status ='Approved'
  left join tb_prov_applicant_accomodation tacc on ta.applicant_id = tacc.provider_applicant_id
  where pms.monitoring_id = v_monitoring_id 
 ) licenseinfo;


    select json_agg(entrance_conf) into v_entrance_conf from (select * from prov_listentranceconf(v_monitoring_id)) entrance_conf;
 select json_agg(exit_conf) into v_exit_conf from (select * from prov_listexitconf(v_monitoring_id)) exit_conf;
 SELECT signature INTO v_personsign FROM tb_provider_decision tpd WHERE tpd.objectid = v_monitoring_id AND tpd.activeflag = 1 AND 
  tpd.eventcode = 'MON' AND tpd.signature IS NOT NULL ORDER BY tpd.insertedon LIMIT 1;

 
 select * from prov_getmonitordetails(v_monitoring_id, 'Child','Record') into v_child_record;
 select * from prov_getchildaggmonitordetails(v_monitoring_id, 'Child','Record') into v_child_questions;
 select * from prov_midyrgetnoncompliance(v_monitoring_id, 'Child', 'Record') into v_noncomplience_list;

 select * from prov_getmonitordetails(v_monitoring_id, 'Staff','Record') into v_staff_record;
 select * from prov_getchildaggmonitordetails(v_monitoring_id, 'Staff','Record') into v_staff_questions;
 select * from prov_midyrgetnoncompliance(v_monitoring_id, 'Staff', 'Record') into v_noncomplience_list_staff;

 select * from prov_getmonitordetails(v_monitoring_id, 'Parent','Record') into v_parent_record;
 select * from prov_getchildaggmonitordetails(v_monitoring_id, 'Parent','Record') into v_parent_questions;
 select * from prov_midyrgetnoncompliance(v_monitoring_id, 'Parent', 'Record') into v_noncomplience_list_parent;

 select * from prov_midyrgetnoncompliancecurrent(v_monitoring_id) into v_noncomplience_list_current;

 select * from prov_getmonitordetails(v_monitoring_id, 'Physical Plant','Record') into v_pplant_record;
 select * from prov_midyrgetnoncompliance(v_monitoring_id, 'Physical Plant', 'Record') into v_noncomplience_list_pplant;
 select * from prov_getchildaggmonitordetails(v_monitoring_id, 'Physical Plant', 'Record') into v_pplant_questions;

 select json_agg(officers) into v_sofficers_info from (select tmrt.roletypekey,tmrt.description,up.fullname from  teammemberassignment tma 
 INNER JOIN  teammember tm ON tm.teammemberid = tma.teammemberid AND tm.activeflag =1
 INNER JOIN  teammemberroletype  tmrt   ON tmrt.roletypekey = tm.roletypekey  AND tmrt.activeflag= 1
 inner join userprofile up on up.securityusersid=tma.securityusersid
 where tmrt.roletypekey in ('PVRDJSSD','PVRDJSPD'))officers;

 select json_agg(pminfo) into v_pminfo_info from (select * from providerstaff where object_id=v_provider_id::character varying and employee_type='Program Administrator' and delete_sw = 'N' limit 1)pminfo;

 select * from prov_getmonitordetails(v_monitoring_id, 'Board member','Interview') into v_board_interview;
 select * from prov_getmonitorinterviews_djs(v_monitoring_id, 'Site Details','Details') into v_site_details;
 select * from prov_getmonitorinterviews_djs(v_monitoring_id, v_records_type,'Details') into v_monitoring_details;
 
 
 
return (json_build_object('activity_info',v_activity_info,
'officers_info',v_officers_info,
'site_list',v_site_list,
'monitor_info',v_monitor_info,
'license_info', v_license_info,
'provider_info', v_provider_info,
'exit_conf',v_exit_conf,
'site_details', v_site_details,
'monitoring_details',v_monitoring_details,
'entrance_conf',v_entrance_conf,
'child_record',v_child_record,
'staff_record',v_staff_record,
'parent_record',v_parent_record,
'pplant_record',v_pplant_record,
'child_interview',v_child_interview,
'staff_interview',v_staff_interview,
'parent_interview',v_parent_interview,
'board_interview',v_board_interview,
'noncomplience_list',v_noncomplience_list,
'noncomplience_list_staff',v_noncomplience_list_staff,
'noncomplience_list_parent',v_noncomplience_list_parent,
'noncomplience_list_current',v_noncomplience_list_current,
'noncomplience_list_pplant', v_noncomplience_list_pplant,
'pminfo_info',v_pminfo_info,
'sofficers_info',v_sofficers_info,
'corp_info',v_corp_info,
'incident_info',v_incident_info,
'complaint_info',v_complaint_info,
'child_questions',v_child_questions,
'staff_questions',v_staff_questions,
'pplant_questions',v_pplant_questions,
'parent_questions',v_parent_questions,
'license_recomm',v_licenserecomm_info,
'person_signature',v_personsign));

END;
$function$

