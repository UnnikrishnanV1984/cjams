CREATE OR REPLACE FUNCTION as_addplacement(v_intakenumber character varying, v_securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE 

v_rec record;
v_intakeservicerequestactorid uuid;
BEGIN  
   
 FOR  v_rec  IN 
 
  SELECT intakeserviceid FROM intakeservicerequest WHERE activeflag =1 
  AND intakenumber =v_intakenumber
 LOOP
 
  SELECT ISRA.intakeservicerequestactorid INTO v_intakeservicerequestactorid 
  FROM intakeservicerequest as ISR
        JOIN intakeservicerequestactor as ISRA on ISR.intakeserviceid = ISRA.intakeserviceid and ISRA.activeflag=1 and lower(ISRA.intakeservicerequestpersontypekey) = 'youth'
        where ISR.intakeserviceid = v_rec.intakeserviceid limit 1;
  
 INSERT INTO placement (providerid, intakeserviceid, intakeservicerequestactorid, remarks, 
      placementadmissionclassificationkey, placementadmissiontypekey,parentorg, addate,
      adtime, releasedate, detainer, startdatetime, 
      placementadmissionauthorizationtypekey, placementprimaryadmissionreasontypekey,
      placementprimaryapprovedalttypekey, county, jlocation, jcounty, fieldworker,
      insertedby, updatedby,insertedon, updatedon, certifiedad, resourceworker, istempplacement)

 SELECT providerid, v_rec.intakeserviceid, v_intakeservicerequestactorid, remarks, 
     placementadmissionclassificationkey,placementadmissiontypekey,parentorg, addate,
     adtime,releasedate,detainer, now(),
     PlacementAdmissionAuthorizationTypekey,PlacementPrimaryAdmissionReasonTypekey,
     PlacementPrimaryApprovedAltTypekey, county, jlocation,jcounty,fieldworker,
     v_securityuserid, v_securityuserid, now(),now(), certifiedad, resourceworker,
     istempplacement
 FROM placement 
 WHERE intakenumber = v_intakenumber
 AND activeflag =1;
 
 END LOOP;
 
 UPDATE placement SET activeflag=0 
 WHERE intakenumber = v_intakenumber 
 AND activeflag =1;
 
RETURN 'Successfull';
end;

$function$

