CREATE OR REPLACE FUNCTION sendprovidernotifications()
 RETURNS json
 LANGUAGE plpgsql
AS $function$

declare
vmsg character varying;
verrcode int8; 
v_midlicense45 json;
v_midlicense60 json;
v_midlicense70 json;
v_relicense120 json;
v_relicense45 json;
v_relicense150 json;
v_csarates30 json;
v_csaenddt30 json;
v_json json;
BEGIN



select * from prov_sendbellnotificationsjob('Midlicense',60) into v_midlicense45;
select * from prov_sendbellnotificationsjob('Midlicense',70) into v_midlicense60;
select * from prov_sendbellnotificationsjob('Midlicense',45) into v_midlicense70;

select * from prov_sendbellnotificationsjob('Relicense',120) into v_relicense120;
select * from prov_sendbellnotificationsjob('Relicense',45) into v_relicense45;
select * from prov_sendbellnotificationsjob('Relicense',150) into v_relicense150;
select * from prov_sendbellnotificationsjob('ContractCSARates',30) into v_csarates30;
select * from prov_sendbellnotificationsjob('CSAServiceenddate',30) into v_csaenddt30;




return (json_build_object('Midlicense45',v_midlicense45,'Midlicense60',v_midlicense60,
       'v_midlicense70',v_midlicense70,'v_relicense120',v_relicense120,
       'v_relicense45',v_relicense45,'v_relicense150',v_relicense150,
       'v_csarates30',v_csarates30,'v_csaenddt30',v_csaenddt30));

END;

$function$

