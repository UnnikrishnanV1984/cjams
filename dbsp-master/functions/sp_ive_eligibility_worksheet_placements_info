CREATE OR REPLACE FUNCTION sp_ive_eligibility_worksheet_placements_info(reqobj json)
 RETURNS void
 LANGUAGE plpgsql
AS $function$ 

DECLARE
 v_islapsesinplacement  varchar(10);
   v_typeoflapses varchar(50);
 v_placementid uuid;
 v_placement json;
BEGIN

  FOR v_placement IN SELECT * FROM json_array_elements(reqobj)
  loop
   v_islapsesinplacement := v_placement ->> 'islapsesinplacement'; 
   v_typeoflapses := v_placement ->> 'typeoflapses'; 
   v_placementid := v_placement ->> 'placementid'; 
  update placement 
  set islapsesinplacement = v_islapsesinplacement , typeoflapses = v_typeoflapses  
  where placementid = v_placementid;

  END loop;

END;
 
$function$

