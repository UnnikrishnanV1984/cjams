     IF ( VN_IS_SSA ) = 0 THEN\r
      vs_transaction_source_cd := '586';\r
     \r
      -- Set re-stamping amount = Total Payment amt - previously used Child Acc funds - SSI funds used in this run\r
      Vn_restamp_amt := VN_PAYMENT_AMOUNT_NO - ( TOTAL_ALL_AMT + VN_bl_SSI);\r
\r
      IF Vn_restamp_amt > 0 THEN\r
