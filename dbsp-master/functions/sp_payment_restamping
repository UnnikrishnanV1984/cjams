    \r
     -- Set remaining payment amount after Child account 'Cost of Care Reimbursement' \r
     vn_Required_balance := Vn_restamp_amt;\r
    \r
     -- SSI Transaction insert - START\r
     IF VN_rs_ssi <> 0 AND vn_iS_ssi = 0 THEN\r
      -- 587 - SSI\r
