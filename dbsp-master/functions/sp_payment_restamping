       vn_Required_balance := ( VN_PAYMENT_AMOUNT_NO - (TOTAL_ALL_AMT + VN_bl_SSI + VN_bl_SSA + cos_amount ))  ;\r
       Vn_restamp_amt := vn_Required_balance ;\r
      ELSE\r
       Cos_amount := vdc_child_other_amount ;\r
       vn_Required_balance :=  VN_PAYMENT_AMOUNT_NO - (TOTAL_ALL_AMT + VN_bl_SSI + VN_bl_SSA + Cos_amount) ;\r
