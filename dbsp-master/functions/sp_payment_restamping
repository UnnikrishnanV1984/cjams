     and (END_DT >= VDT_START_DT OR END_DT IS NULL)\r
    ORDER BY ELIGIBILITY_ID DESC\r
    FETCH FIRST ROW ONLY;\r
  \r
    IF al_sqlcode < 0 THEN\r
     as_error := as_error  ;\r
     as_error := 'Error in getting ELIGIBILITY_STATUS_CD from TB_CLIENT_ELIGIBILITY.'  ;\r
