     Vn_restamp_amt  := VN_PAYMENT_AMOUNT_NO - ( TOTAL_ALL_AMT + VN_bl_SSI + VN_bl_SSA );\r
    \r
     IF Vn_restamp_amt > 0 THEN\r
      SELECT  a.al_other_amt,a.al_adj_credit,a.al_adj_debit,a.al_stamped_amt,a.al_sqlcode,a.as_error \r
       from SP_RS_ACC_TRANS_CALC (vs_transaction_source_cd\r
