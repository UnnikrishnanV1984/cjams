       END IF;\r
       --SIGNAL p_sp_error  ;         \r
      END IF;    \r
     END IF;                    \r
     -- SSA Transaction insert - END\r
    \r
     -- Other (Cost Of Care) Transaction insert - START\r
     IF VN_RS_coc <> 0 and VN_rs_coc <> VN_IS_coc THEN\r
      -- 585 - Other (Cost Of Care)\r
      vs_transaction_source_cd := '585' ;\r
     \r
      SELECT  a.al_sqlcode,a.as_error \r
       from  SP_ACC_TRANS_RS_INSERT( vs_transaction_source_cd, VN_rs_coc, VN_PAYMENT_DETAIL_ID,\r
            VN_CLIENT_ACCOUNT_ID, VDT_START_DT, VDT_END_DT, ad_run_dt) a \r
       into\r
