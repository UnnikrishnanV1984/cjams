 -- Temporary table to get the Late_entry_cur records\r
 DROP TABLE IF EXISTS TEMP_LATE_ENTRY_CUR;\r
\r
 CREATE TEMP TABLE TEMP_LATE_ENTRY_CUR\r
  (  PAYMENT_DETAIL_ID BIGINT,\r
   CLIENT_ID BIGINT,\r
   PAYMENT_START_DT DATE,\r
   PAYMENT_END_DT DATE,\r
   CASE_ID BIGINT,\r
   PAY_AMT DECIMAL(10,2)\r
    );\r
