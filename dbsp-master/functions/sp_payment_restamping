 \r
 -- Late validation (system adjustments) - (Insert 2nd SQL of original cursor)\r
 -- FOR cur_late_validations AS\r
 OPEN cur_late_validations FOR\r
  SELECT PD.PAYMENT_DETAIL_ID\r
     , PD.CLIENT_ID\r
     , PH.PAYMENT_START_DT\r
     , PH.PAYMENT_END_DT\r
     , PD.CASE_ID\r
     , PD.FINAL_AMOUNT_NO  -\r
    COALESCE((  SELECT SUM(COALESCE(RD.AMOUNT_NO,0))\r
        FROM TB_RECEIVABLE_DETAIL RD\r
       WHERE RD.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
          AND RD.DELETE_SW = 'N' ),0) AS  PAY_AMT\r
   , PD.PLACEMENT_ID      \r
  FROM TB_PAYMENT_STATUS PS \r
    INNER JOIN (TB_PAYMENT_DETAIL PD \r
         INNER JOIN TB_PAYMENT_HEADER PH ON PD.PAYMENT_ID = PH.PAYMENT_ID )\r
       ON PS.PAYMENT_ID =  PD.PAYMENT_ID\r
  WHERE PD.DELETE_SW = 'N' \r
   AND PH.DELETE_SW = 'N'\r
   AND PH.PAYMENT_TYPE_CD IN ('3294')\r
   AND PD.FINAL_AMOUNT_NO IS NOT NULL\r
   AND PD.PAYMENT_DETAIL_ID NOT IN ( SELECT PAYMENT_DETAIL_ID FROM TB_FUND_ALLOCATION_MASTER WHERE DELETE_SW = 'N' )\r
   \r
   AND PH.PAYMENT_START_DT >= '2009-01-01'::date\r
   --AND PH.PAYMENT_START_DT <= CHESSIE.F_DAYMONTH(AD_RUN_DT - 1 MONTH ,'L','')\r
   and ph.payment_start_dt <= f_daymonth((ad_run_dt - INTERVAL '1 month')::date ,'L','')\r
   AND PD.PLACEMENT_ID IS NOT NULL\r
   AND PS.PAYMENT_STATUS_CD IN ( '1634','1636')\r
   AND PS.DELETE_SW = 'N'\r
   AND ( PH.MANUAL_SW = 'N' OR PH.MANUAL_SW IS NULL )\r
   AND PD.FINAL_AMOUNT_NO  -\r
   COALESCE(( SELECT SUM(COALESCE(RD.AMOUNT_NO,0))\r
         FROM TB_RECEIVABLE_DETAIL RD\r
      WHERE RD.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
         AND RD.DELETE_SW = 'N' ),0) > 0\r
   AND PD.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) ;\r
 --DO\r
 LOOP\r
 fetch cur_late_validations into cur_late_validation_rec;\r
  exit when not found;\r
          \r
  vn_payment_detail_id := cur_late_validation_rec.PAYMENT_DETAIL_ID;\r
  vn_client_id := cur_late_validation_rec.CLIENT_ID;\r
  VDT_START_DT := cur_late_validation_rec.PAYMENT_START_DT;\r
  VDT_END_DT := cur_late_validation_rec.PAYMENT_END_DT;\r
  vl_case_id := cur_late_validation_rec.CASE_ID;\r
  VN_PAYMENT_AMOUNT_NO := cur_late_validation_rec.PAY_AMT;\r
  vl_placement_id := cur_late_validation_rec.PLACEMENT_ID;\r
  vl_fund_alloc_cnt := 0;\r
\r
  Raise notice '>>>>>>>>>>fetch cur_late_validations %', vn_payment_detail_id;\r
 \r
  -- Verify if the payment stamping was done for original payment\r
  /*SELECT COUNT(1)\r
    INTO vl_fund_alloc_cnt\r
   FROM TB_FUND_ALLOCATION_MASTER\r
   WHERE DELETE_SW = 'N'\r
   AND PAYMENT_DETAIL_ID IN \r
    ( SELECT PD1.PAYMENT_DETAIL_ID  \r
      FROM TB_PAYMENT_STATUS PS1 \r
      INNER JOIN (TB_PAYMENT_DETAIL PD1 INNER JOIN TB_PAYMENT_HEADER PH1\r
          ON PD1.PAYMENT_ID = PH1.PAYMENT_ID )\r
      ON PS1.PAYMENT_ID =  PD1.PAYMENT_ID\r
     WHERE PD1.PLACEMENT_ID = vl_placement_id\r
      --AND YEAR(PH1.PAYMENT_START_DT) = YEAR(VDT_START_DT)\r
      --AND MONTH(PAYMENT_START_DT) = MONTH(VDT_START_DT)\r
      and date_part('year',ph1.payment_start_dt::date) = date_part('year',VDT_START_DT::date)\r
      and date_part('month',ph1.payment_start_dt::date) = date_part('month',VDT_START_DT::date)\r
      AND PD1.DELETE_SW = 'N' \r
      AND PH1.DELETE_SW = 'N'\r
      AND PS1.PAYMENT_STATUS_CD IN ( '1634','1636')\r
      AND PS1.DELETE_SW = 'N'\r
      AND PH1.PAYMENT_TYPE_CD IN ( '6','3294' )\r
  ) ;*/\r
   \r
  SELECT COUNT(FAM.FUND_ALLOC_ID)  \r
   INTO vl_fund_alloc_cnt\r
  FROM TB_PAYMENT_STATUS PS1, \r
   TB_PAYMENT_HEADER PH1,\r
   TB_PAYMENT_DETAIL PD1\r
   LEFT OUTER JOIN TB_FUND_ALLOCATION_MASTER FAM\r
    ON FAM.PAYMENT_DETAIL_ID = PD1.PAYMENT_DETAIL_ID\r
     AND FAM.DELETE_SW = 'N'\r
  WHERE PS1.PAYMENT_ID = PH1.PAYMENT_ID\r
   AND PS1.PAYMENT_ID = PD1.PAYMENT_ID\r
   AND PS1.DELETE_SW = 'N'\r
   AND PD1.DELETE_SW = 'N' \r
   AND PH1.DELETE_SW = 'N'\r
   AND PS1.PAYMENT_STATUS_CD IN ( '1634','1636')\r
   AND PD1.PLACEMENT_ID = vl_placement_id\r
   and date_part('year',ph1.payment_start_dt::date) = date_part('year',VDT_START_DT::date)\r
   and date_part('month',ph1.payment_start_dt::date) = date_part('month',VDT_START_DT::date)\r
   AND PH1.PAYMENT_TYPE_CD IN ( '6','3294' );\r
   -- AND PD1.county_cd  IN( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) ;\r
    \r
  IF vl_fund_alloc_cnt = 0 THEN\r
   Raise notice '>>>>>>>>>>fund allocation = 0 %', vn_payment_detail_id;\r
   INSERT INTO TEMP_LATE_ENTRY_CUR   \r
      ( PAYMENT_DETAIL_ID,\r
     CLIENT_ID,\r
     PAYMENT_START_DT,\r
     PAYMENT_END_DT,\r
     CASE_ID,\r
     PAY_AMT\r
    ) \r
   VALUES\r
    (\r
     vn_payment_detail_id,\r
     vn_client_id,\r
     VDT_START_DT,\r
     VDT_END_DT,\r
     vl_case_id,\r
     VN_PAYMENT_AMOUNT_NO\r
    );\r
 \r
