      END IF;\r
     END IF;\r
     -- SSI Transaction insert - END\r
    \r
     -- SSA Transaction insert - START\r
     IF VN_RS_SSA <> 0 AND VN_IS_SSA  = 0 then\r
      -- 586 - SSA\r
      vs_transaction_source_cd := '586' ;\r
     \r
      SELECT  a.al_sqlcode,a.as_error \r
       from  SP_ACC_TRANS_RS_INSERT( vs_transaction_source_cd, VN_rs_ssa, VN_PAYMENT_DETAIL_ID,\r
           VN_CLIENT_ACCOUNT_ID, VDT_START_DT, VDT_END_DT, ad_run_dt) a \r
       into\r
