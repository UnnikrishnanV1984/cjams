\r
 VL_RUNTIME_ID :=  NEXTVAL('sq_batch_runtime_log');\r
 \r
 INSERT INTO TB_BATCH_RUNTIME_LOG \r
 ( RUNTIME_LOG_ID, PROGRAM_NM, RUNTIME_START_TS, CREATE_TS, \r
  CREATE_USER_ID, UPDATE_TS, UPDATE_USER_ID)\r
 VALUES \r
 ( VL_RUNTIME_ID, 'SP_PAYMENT_RESTAMPING', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, \r
  'RESTAMP', CURRENT_TIMESTAMP, 'RESTAMP');\r
\r
 Raise notice '>>>>>>>>>>sq_batch_runtime_log ->>after %', VL_RUNTIME_ID;\r
\r
 Raise notice '>>>>>>>>>>starting TEMP_LATE_ENTRY_CUR 1st insert %', now();\r
 -- Vineet - START\r
 -- Late entry (Insert 1st SQL of original cursor)\r
 INSERT INTO TEMP_LATE_ENTRY_CUR   \r
    ( PAYMENT_DETAIL_ID,\r
   CLIENT_ID,\r
   PAYMENT_START_DT,\r
   PAYMENT_END_DT,\r
   CASE_ID,\r
   PAY_AMT\r
  )\r
 SELECT DISTINCT PD.PAYMENT_DETAIL_ID\r
    , CA.CLIENT_ID\r
    , ATR.BENEFIT_START_DT\r
    , ATR.BENEFIT_END_DT\r
    , PD.CASE_ID\r
    , ( SELECT PAYMENT_AMOUNT \r
     FROM TB_FUND_ALLOCATION_MASTER \r
     WHERE PAYMENT_DETAIL_ID =  PD.PAYMENT_DETAIL_ID  \r
     AND DELETE_SW ='N') AS PAY_AMT\r
 FROM TB_PAYMENT_DETAIL PD \r
  INNER JOIN (TB_ACCOUNT_TRANSACTION ATR\r
       INNER JOIN TB_CLIENT_ACCOUNT CA ON ATR.CLIENT_ACCOUNT_ID = CA.CLIENT_ACCOUNT_ID  )\r
     ON PD.CLIENT_ID = CA.CLIENT_ID\r
 WHERE LATE_ENTRY_SW = 'Y'\r
   AND FINAL_SERVICE_START_DT BETWEEN ATR.BENEFIT_START_DT AND ATR.BENEFIT_END_DT\r
   AND ATR.DELETE_SW = 'N' \r
   AND CA.DELETE_SW = 'N'\r
   AND PD.county_cd IN\r
   ( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) ;  \r
\r
 Raise notice '>>>>>>>>>>after Late entry (Insert 1st SQL of original cursor) %', al_sqlcode;\r
 Raise notice '>>>>>>>>>>starting TEMP_LATE_ENTRY_CUR 2nd insert %', now();\r
\r
 -- IV-E status changes (Insert 3rd SQL of original cursor)\r
 INSERT INTO TEMP_LATE_ENTRY_CUR   \r
    ( PAYMENT_DETAIL_ID,\r
   CLIENT_ID,\r
   PAYMENT_START_DT,\r
   PAYMENT_END_DT,\r
   CASE_ID,\r
   PAY_AMT\r
  ) \r
 SELECT DISTINCT PD.PAYMENT_DETAIL_ID \r
  , IVE.CLIENT_ID\r
  , IVE.BENEFIT_START_DT\r
  , IVE.BENEFIT_END_DT\r
  , PD.CASE_ID\r
  , FAM.PAYMENT_AMOUNT AS PAY_AMT\r
 FROM TB_FUND_ALLOCATION_MASTER FAM,\r
  TB_PAYMENT_DETAIL PD,\r
  TB_RS_IVE_STATUS IVE  \r
 WHERE FAM.PAYMENT_DETAIL_ID = PD.PAYMENT_DETAIL_ID\r
  AND IVE.CLIENT_ID = PD.CLIENT_ID\r
  AND FAM.DELETE_SW = 'N' \r
  AND PD.DELETE_SW = 'N' \r
  AND IVE.DELETE_SW = 'N'\r
  AND date_part('year',IVE.BENEFIT_START_DT::date) = date_part('year',PD.FINAL_SERVICE_START_DT::date)\r
  AND date_part('month',IVE.BENEFIT_START_DT::date) = date_part('month',PD.FINAL_SERVICE_START_DT::date)\r
  AND PD.county_cd IN\r
   ( select statecountycode from county where activeflag = 1 and golivedate <= CURRENT_DATE ) ;\r
\r
\r
 Raise notice '>>>>>>>>>>after IV-E status changes (Insert 3rd SQL of original cursor) %', al_sqlcode;\r
\r
