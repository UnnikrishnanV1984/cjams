               - coalesce(vdc_othcoc_stamped_amt,0)  ;\r
       END IF;\r
      END IF;\r
     \r
      IF vdc_child_other_amount > VN_PAYMENT_AMOUNT_NO - (TOTAL_ALL_AMT + VN_bl_SSI + VN_bl_SSA) THEN\r
