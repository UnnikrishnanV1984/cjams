       END IF;\r
       --SIGNAL p_sp_error  ;       \r
      END IF;          \r
     END IF; \r
     -- Other (Cost Of Care) Transaction insert - END\r
     -- PRJ-02515 - New condition for 'Closed' or 'Inactive' child account - START\r
    ELSE\r
     IF TOTAL_ALL_AMT > 0 THEN -- Previously used Child Accounts funds for 'Cost of Care Reimbursement' \r
      vn_Required_balance := vn_Required_balance - TOTAL_ALL_AMT;\r
     END IF; \r
     -- PRJ-02515 - New condition for 'Closed' or 'Inactive' child account - END \r
    END IF ; \r
    -- If Active 'Conserved' child account exists - END\r
\r
    -- IVE CALCULATION - START\r
    IF  vn_Required_balance > 0 THEN\r
     -- PRJ-02312 Get client's Eligibility Status to update in TB_FUND_ALLOCATION_MASTER\r
     -- New Logic - START\r
     IF vs_updt_elig_status_cd = '2913' THEN -- Eligible Reimbursable\r
      vdc_Ive_require_amt := vn_Required_balance / 2;\r
      vdc_state_amt := vn_Required_balance / 2;\r
     ELSE\r
      vdc_Ive_require_amt := 0;\r
      vdc_state_amt := vn_Required_balance ;\r
     END IF; \r
     -- New Logic - END\r
    \r
     -- PRJ-02312 Commented on 03/08/2012\r
     -- Old Logic - START\r
     --   SELECT COUNT(*) \r
     --       INTO VN_STATUS_CHANGE\r
     --       FROM TB_RS_IVE_STATUS \r
     --   WHERE CLIENT_ID = VN_CLIENT_ID\r
     --    AND  benefit_start_dt = VDT_START_DT \r
     --    and benefit_end_dt = VDT_END_DT\r
     --    AND DELETE_SW = 'N';\r
\r
     --       IF VN_STATUS_CHANGE > 0 THEN\r
     --       IF  VS_PRE_ELIGI_STATUS = 'Y' AND  vl_RS_eligiblity_status  = 0 then\r
     --     set vdc_Ive_require_amt = 0;\r
     --     set vdc_state_amt = vn_Required_balance ;\r
     --         elseIF  VS_PRE_ELIGI_STATUS = 'N' AND  vl_RS_eligiblity_status  > 0 then\r
     --     Set vdc_Ive_require_amt = vn_Required_balance / 2;\r
     --     set vdc_state_amt = vn_Required_balance / 2;\r
     --             elseIF  VS_PRE_ELIGI_STATUS = 'N' AND  vl_RS_eligiblity_status  = 0 then\r
     --              set vdc_Ive_require_amt = 0;\r
     --           set vdc_state_amt = vn_Required_balance ;\r
     --             elseif VS_PRE_ELIGI_STATUS = 'Y' AND  vl_RS_eligiblity_status  > 0 then   \r
     --     Set vdc_Ive_require_amt = vn_Required_balance / 2;\r
     --     set vdc_state_amt = vn_Required_balance / 2;\r
     --             END IF; \r
\r
     --   ELSE\r
     --    SELECT COUNT(*)\r
     --     INTO vl_eligiblity_status\r
     --     FROM TB_CLIENT_ELIGIBILITY\r
     --    WHERE CLIENT_ID = vn_client_id \r
     --     AND case_id = vl_case_id \r
     --     AND ELIGIBILITY_STATUS_CD = '2913'  -- Eligibility Reimb\r
     --     AND ELIGIBILITY_TYPE_CD = '2931' \r
     --     AND DELETE_SW = 'N' \r
     --     AND start_dt <= VDT_END_DT \r
     --     and (end_dt >=  VDT_START_DT  or end_dt is null);\r
\r
     --    IF vl_eligiblity_status > 0 then\r
     --     set vdc_Ive_require_amt = vn_Required_balance / 2;\r
     --     set vdc_state_amt = vn_Required_balance / 2;\r
     --          ELSE\r
     --         set vdc_state_amt = vn_Required_balance;\r
     --     set vdc_Ive_require_amt  = 0;\r
     --          end if;\r
     --   END IF;\r
        -- Old Logic - END\r
    ELSE\r
     vn_Required_balance := 0;\r
     vdc_Ive_require_amt  := 0;\r
    END IF ;\r
    --IVE CALCULATION - END\r
   \r
    -- Get Fiscal Category code - START\r
    IF vl_rs_eligiblity_status > 0 OR vl_eligiblity_status > 0 THEN\r
     VS_ELIG_SW := 'Y' ;\r
    ELSE\r
     VS_ELIG_SW := 'N';\r
    END IF;\r
\r
    SELECT a.as_fiscalcat,a.al_sqlcode,a.as_error \r
     from SP_RS_FISCAL_CAT_CD ( VN_CLIENT_ID,\r
            vn_payment_detail_id,\r
            VS_ELIG_SW,\r
            VDT_start_dt,\r
            VDT_END_dt) a \r
     into\r
      Vs_fiscal_cat,\r
      al_sqlcode,\r
      As_error;\r
\r
    IF al_sqlcode <> 0 THEN\r
     as_error := as_error  ;\r
     IF as_error is NULL OR as_error = '' THEN\r
      as_error := 'SP_RS_FISCAL_CAT_CD failed'  ;\r
     END IF;\r
     --SIGNAL p_sp_error  ;\r
    END IF;\r
    -- Get Fiscal Category code - END\r
   \r
    -- Fund Allocation Transactions insert - START\r
    IF vn_client_account_id > 0  THEN -- If Active 'Conserved' child account exists\r
     IF vn_stamp_count > 0 THEN -- Re-stamping\r
      IF VN_RS_ssi <> VN_IS_ssi or VN_RS_SsA <> vN_IS_SSA or VN_RS_coc <> coalesce(VN_IS_coc ,0)\r
       or ((VS_PRE_ELIGI_STATUS = 'Y' AND  vl_RS_eligiblity_status  = 0 and vl_eligiblity_status = 0 )\r
       or (VS_PRE_ELIGI_STATUS = 'N' AND ( vl_RS_eligiblity_status  > 0 or vl_eligiblity_status > 0 ) )\r
        ) THEN\r
\r
       INSERT INTO TB_FUND_ALLOCATION_DETAIL \r
        ( FUND_ALLOC_HISTORY_ID\r
         ,FUND_ALLOC_ID\r
         ,FUND_ALLOCATION_DATE\r
         ,PAYMENT_DETAIL_ID\r
         ,PAYMENT_AMOUNT\r
         ,FISCAL_CATEGORY_CD\r
         ,SSI_FUNDING_AMT\r
         ,SSA_FUNDING_AMT\r
         ,COC_FUNDING_AMT\r
         ,STATE_FUNDING_AMT\r
         ,IVE_FUNDING_AMT\r
         ,IVD_FUNDING_AMT\r
         ,LOCAL_FUNDING_AMT\r
         ,INITIAL_STAMPING_SW\r
         ,DELETE_SW\r
         ,CREATE_TS\r
         ,CREATE_USER_ID\r
         ,UPDATE_TS\r
         ,UPDATE_USER_ID\r
         ,ELIGIBILITY_STATUS_CD)\r
       ( SELECT NEXTVAL('sq_fund_allocation_detail')\r
            ,fund_alloc_id\r
            ,FUND_ALLOCATION_DATE\r
            ,PAYMENT_DETAIL_ID\r
            ,PAYMENT_AMOUNT\r
            ,FISCAL_CATEGORY_CD\r
            ,SSI_FUNDING_AMT\r
            ,SSA_FUNDING_AMT\r
            ,COC_FUNDING_AMT\r
            ,STATE_FUNDING_AMT\r
            ,IVE_FUNDING_AMT\r
            ,IVD_FUNDING_AMT\r
            ,LOCAL_FUNDING_AMT\r
            ,INITIAL_STAMPING_SW\r
            ,DELETE_SW\r
            ,current_timestamp -- CREATE_TS\r
            ,'finance' -- CREATE_USER_ID\r
            ,current_timestamp -- UPDATE_TS\r
            ,'finance' -- UPDATE_USER_ID\r
            ,ELIGIBILITY_STATUS_CD\r
        FROM TB_FUND_ALLOCATION_MASTER\r
        WHERE PAYMENT_DETAIL_ID = vn_payment_detail_id\r
         AND DELETE_SW = 'N'\r
       );\r
\r
       al_sqlcode := SQLCODE;\r
       IF al_sqlcode <> 0  THEN\r
        as_error := 'Error in inserting funding allocation history record';\r
       END IF ;\r
\r
      \r
       UPDATE TB_FUND_ALLOCATION_MASTER\r
        SET SSI_FUNDING_AMT = coalesce( VN_RS_ssi,0),\r
         SSA_FUNDING_AMT = COALESCE( VN_RS_ssa,0),\r
         COC_FUNDING_AMT =  COALESCE( VN_RS_COC,0) + COALESCE(Vn_Is_coc,0),\r
         FISCAL_CATEGORY_CD = vs_fiscal_cat,\r
         FUND_ALLOCATION_DATE = ad_run_dt,\r
         STATE_FUNDING_AMT = vdc_state_amt ,\r
         IVE_FUNDING_AMT = vdc_Ive_require_amt,\r
         INITIAL_STAMPING_SW = 'N',\r
         UPDATE_USER_ID = 'finance',\r
         UPDATE_TS = current_timestamp,\r
         ELIGIBILITY_STATUS_CD = vs_updt_elig_status_cd\r
       WHERE PAYMENT_DETAIL_ID = vn_payment_detail_id\r
          AND DELETE_SW = 'N';\r
\r
       al_sqlcode := SQLCODE;\r
       IF al_sqlcode <> 0  THEN\r
        as_error := 'Error in updating funding allocation master record';\r
       END IF ;\r
      END IF;\r
     ELSE -- Initial stamping\r
      -- 06/03 to add COALESCE for VN_RS_ssi, VN_RS_SSA & VN_RS_coc\r
      INSERT INTO TB_FUND_ALLOCATION_MASTER\r
       ( FUND_ALLOC_ID,   FUNDING_AMOUNT_NO,\r
         PAYMENT_DETAIL_ID,  FUND_ALLOCATION_DATE,\r
         PAYMENT_AMOUNT,   FISCAL_CATEGORY_CD,\r
         SSI_FUNDING_AMT,   SSA_FUNDING_AMT,\r
         COC_FUNDING_AMT,   STATE_FUNDING_AMT,\r
         IVE_FUNDING_AMT,   IVD_FUNDING_AMT,\r
         LOCAL_FUNDING_AMT,  INITIAL_STAMPING_SW,\r
         DELETE_SW,\r
         CREATE_TS,       CREATE_USER_ID,\r
         UPDATE_TS,       UPDATE_USER_ID,\r
         ELIGIBILITY_STATUS_CD  )\r
      VALUES ( NEXTVAL('sq_FUND_ALLOCATION_MASTER'),  0,\r
         vn_payment_detail_id,  ad_run_dt,\r
         VN_PAYMENT_AMOUNT_NO,  vs_fiscal_cat,\r
         COALESCE(VN_RS_ssi,0),    COALESCE(VN_RS_SSA,0),\r
         COALESCE(VN_RS_coc,0), vdc_state_amt,\r
         vdc_Ive_require_amt,  0,\r
         0,      'Y',\r
         'N',\r
         CURRENT_TIMESTAMP,  'finance',\r
         CURRENT_TIMESTAMP,  'finance',\r
         vs_updt_elig_status_cd )  ;\r
\r
      al_sqlcode := SQLCODE;\r
      IF al_sqlcode <> 0  THEN\r
       as_error := 'Error in inserting funding allocation master record';\r
      END IF ; \r
     END IF;\r
    ELSE -- If NO Active 'Conserved' child account exists\r
     VN_RS_ssi := 0;\r
     VN_RS_SSA := 0;\r
     VN_RS_COC := 0 ;\r
    \r
     IF vn_stamp_count > 0 THEN -- Re-stamping\r
      IF ((VS_PRE_ELIGI_STATUS = 'Y' AND  vl_RS_eligiblity_status  = 0  and vl_eligiblity_status = 0 )\r
       or (VS_PRE_ELIGI_STATUS = 'N' AND ( vl_RS_eligiblity_status  > 0 or vl_eligiblity_status > 0 ) )) THEN\r
\r
       INSERT INTO TB_FUND_ALLOCATION_DETAIL \r
        ( FUND_ALLOC_HISTORY_ID\r
         ,FUND_ALLOC_ID\r
         ,FUND_ALLOCATION_DATE\r
         ,PAYMENT_DETAIL_ID\r
         ,PAYMENT_AMOUNT\r
         ,FISCAL_CATEGORY_CD\r
         ,SSI_FUNDING_AMT\r
         ,SSA_FUNDING_AMT\r
         ,COC_FUNDING_AMT\r
         ,STATE_FUNDING_AMT\r
         ,IVE_FUNDING_AMT\r
         ,IVD_FUNDING_AMT\r
         ,LOCAL_FUNDING_AMT\r
         ,INITIAL_STAMPING_SW\r
         ,DELETE_SW\r
         ,CREATE_TS\r
         ,CREATE_USER_ID\r
         ,UPDATE_TS\r
         ,UPDATE_USER_ID\r
         ,ELIGIBILITY_STATUS_CD)\r
       (SELECT NEXTVAL('sq_fund_allocation_detail')\r
        ,fund_alloc_id\r
        ,FUND_ALLOCATION_DATE\r
        ,PAYMENT_DETAIL_ID\r
        ,PAYMENT_AMOUNT\r
        ,FISCAL_CATEGORY_CD\r
        ,SSI_FUNDING_AMT\r
        ,SSA_FUNDING_AMT\r
        ,COC_FUNDING_AMT\r
        ,STATE_FUNDING_AMT\r
        ,IVE_FUNDING_AMT\r
        ,IVD_FUNDING_AMT\r
        ,LOCAL_FUNDING_AMT\r
        ,INITIAL_STAMPING_SW\r
        ,DELETE_SW\r
        ,current_timestamp -- CREATE_TS\r
        ,'finance' -- CREATE_USER_ID\r
        ,current_timestamp -- UPDATE_TS\r
        ,'finance' -- UPDATE_USER_ID\r
        ,ELIGIBILITY_STATUS_CD\r
       FROM TB_FUND_ALLOCATION_MASTER\r
       WHERE PAYMENT_DETAIL_ID = vn_payment_detail_id\r
        AND DELETE_SW = 'N'\r
\r
       );\r
\r
       al_sqlcode := SQLCODE;\r
       IF al_sqlcode <> 0  THEN\r
        as_error := 'Error in inserting funding allocation history record';\r
       END IF ;\r
      \r
       -- PRJ-02515 - New condition for 'Closed' or 'Inactive' child account - START\r
       -- Set Previously used Child Accounts funds for 'Cost of Care Reimbursement' \r
       SELECT COALESCE(SSI_FUNDING_AMT,0),\r
        COALESCE(SSA_FUNDING_AMT,0),\r
        COALESCE(COC_FUNDING_AMT,0)\r
       INTO VN_RS_ssi,\r
        VN_RS_SSA,\r
        VN_RS_COC\r
       FROM TB_FUND_ALLOCATION_MASTER\r
       WHERE PAYMENT_DETAIL_ID  = vn_payment_detail_id\r
        AND DELETE_SW = 'N';\r
\r
   \r
       IF al_sqlcode < 0 THEN\r
        as_error := as_error  ;\r
        as_error := 'Error in getting Previously used Child Accounts funds.'  ;\r
       -- SIGNAL p_sp_error;       \r
       END IF; \r
       -- PRJ-02515 - New condition for 'Closed' or 'Inactive' child account - END\r
      \r
       UPDATE TB_FUND_ALLOCATION_MASTER\r
        SET SSI_FUNDING_AMT = COALESCE( VN_RS_ssi,0),\r
         SSA_FUNDING_AMT = COALESCE( VN_RS_ssa,0),\r
         COC_FUNDING_AMT =  COALESCE( VN_RS_COC,0) ,\r
         FISCAL_CATEGORY_CD =  vs_fiscal_cat,\r
         FUND_ALLOCATION_DATE = ad_run_dt,\r
         STATE_FUNDING_AMT =  vdc_state_amt ,\r
         IVE_FUNDING_AMT =vdc_Ive_require_amt,\r
         INITIAL_STAMPING_SW = 'N',\r
         UPDATE_USER_ID = 'finance',\r
         UPDATE_TS = current_timestamp,\r
         ELIGIBILITY_STATUS_CD = vs_updt_elig_status_cd\r
       WHERE PAYMENT_DETAIL_ID =  vn_payment_detail_id\r
         AND DELETE_SW = 'N'; \r
\r
       al_sqlcode := SQLCODE;\r
       IF al_sqlcode <> 0  THEN\r
        as_error := 'Error in updating funding allocation master record';\r
       END IF ;\r
      END IF;\r
     ELSE -- Initial stamping\r
      -- 06/03 to add COALESCE for VN_RS_ssi, VN_RS_SSA & VN_RS_coc\r
      INSERT INTO TB_FUND_ALLOCATION_MASTER\r
       ( FUND_ALLOC_ID,   FUNDING_AMOUNT_NO,\r
        PAYMENT_DETAIL_ID,      FUND_ALLOCATION_DATE,\r
        PAYMENT_AMOUNT,   FISCAL_CATEGORY_CD,\r
        SSI_FUNDING_AMT,   SSA_FUNDING_AMT,\r
        COC_FUNDING_AMT,   STATE_FUNDING_AMT,\r
        IVE_FUNDING_AMT,   IVD_FUNDING_AMT,\r
        LOCAL_FUNDING_AMT,      INITIAL_STAMPING_SW,\r
        DELETE_SW,\r
        CREATE_TS,              CREATE_USER_ID,\r
        UPDATE_TS,           UPDATE_USER_ID,\r
        ELIGIBILITY_STATUS_CD )\r
      VALUES ( NEXTVAL('sq_FUND_ALLOCATION_MASTER') ,  0,\r
        vn_payment_detail_id,  ad_run_dt,\r
        VN_PAYMENT_AMOUNT_NO,  vs_fiscal_cat,\r
        COALESCE(VN_RS_ssi,0),  COALESCE(VN_RS_SSA,0),\r
        COALESCE(VN_RS_coc,0),  vdc_state_amt,\r
        vdc_Ive_require_amt,  0,\r
        0,       'Y',\r
        'N',\r
        CURRENT_TIMESTAMP,   'finance',\r
        CURRENT_TIMESTAMP,   'finance',\r
        vs_updt_elig_status_cd )  ;\r
\r
      al_sqlcode := SQLCODE;\r
      IF al_sqlcode <> 0  THEN\r
       as_error := 'Error in inserting funding allocation master record';\r
      END IF ; \r
     END IF ;\r
    END IF ; --vn_client_account_id > 0\r
    -- Fund Allocation Transactions insert - END\r
   END IF ; --TOTAL_ALL_AMT <>  coalesce(VN_PAYMENT_AMOUNT_NO,0)\r
\r
   -- 5583 AFS\r
   IF VN_IS_COC = 0 AND VN_IS_SSI = 0 AND VN_IS_SSA = 0 THEN\r
    UPDATE TB_PAYMENT_HEADER\r
       SET INTERFACE_TO_CD = '5583'\r
    WHERE DELETE_SW = 'N'\r
     AND PAYMENT_TYPE_CD = '3294'\r
     AND MANUAL_SW= 'N'\r
     AND PAYMENT_START_DT =VDT_START_DT\r
     AND PAYMENT_END_DT = VDT_END_DT\r
     AND PAYMENT_ID IN (SELECT PAYMENT_ID\r
           FROM TB_PAYMENT_DETAIL\r
          WHERE DELETE_SW = 'N'\r
             AND PAYMENT_DETAIL_ID = vn_payment_detail_id \r
             AND county_cd IN\r
             ( select statecountycode \r
            from county where activeflag = 1 and golivedate <= CURRENT_DATE )    \r
          ) ;\r
\r
    al_sqlcode := SQLCODE;\r
    IF al_sqlcode < 0 THEN\r
     as_error := 'Error in Updating Payment Header with code interface to AFS'  ;\r
     vs_identity_column := 'Payment ID';\r
     vs_identity_val := 'Multiple';\r
     --SIGNAL p_sp_error  ;\r
    END IF ;\r
   END IF ;\r
  \r
\r
   -- COMMIT;--\r
   VN_PAYMENT_AMOUNT_NO      := 0;\r
   vl_rs_eligiblity_status   := 0;\r
   VN_RS_COC          := 0;\r
   VN_RS_SSI          := 0;\r
   VN_RS_SSA          := 0;\r
   VN_IS_COC          := 0;\r
   VN_IS_SSI          := 0;\r
   VN_IS_SSA          := 0;\r
   VN_BL_COC          := 0;\r
   VN_BL_SSI          := 0;\r
   VN_BL_SSA          := 0;\r
   Cos_amount         := 0;\r
   vdc_child_other_amount    := 0;\r
   vn_Required_balance       := 0;\r
   vdc_state_amt             := 0;\r
   vdc_Ive_require_amt       := 0;\r
   Vn_restamp_amt            := 0;\r
   vn_payment_detail_id      := 0;\r
   vn_client_account_id      := 0;\r
   VDT_START_DT         := null;\r
   VDT_END_DT           := null;\r
   vn_client_id              := 0;\r
   vdc_child_other_amount    := 0;\r
   vdc_ssa_amt_adj_credit    := 0;\r
   vdc_SSa_amt_adj_debit     := 0;\r
   vdc_ssa_stamped_amt       := 0;\r
   vdc_ssa_amt_adj_credit    := 0;\r
   vdc_SSa_amt_adj_debit     := 0;\r
   vdc_ssi_amt_adj_credit    := 0;\r
   vdc_SSi_amt_adj_debit     := 0;\r
   vdc_ssi_stamped_amt       := 0;\r
   vdc_othcoc_amt_adj_credit := 0;\r
   vdc_othcoc_amt_adj_debit  := 0;\r
   vdc_ssa_stamped_amt       := 0;\r
   vdc_othcoc_stamped_amt    := 0;\r
   total_all_amt             := 0;\r
   vn_stamp_count            := 0;\r
   vl_eligiblity_status      := 0;\r
   --   VN_STATUS_CHANGE          := 0;\r
   VS_PRE_ELIGI_STATUS       := NULL;\r
   VDC_IVE_FUNDING_AMT       := 0;\r
   VS_ELIG_SW                := NULL;\r
   vs_fiscal_cat             := NULL;\r
   vs_updt_elig_status_cd := NULL;\r
  END IF;\r
  --END WHILE ;\r
 END LOOP;\r
\r
 Raise notice '>>>>>>>>>>start SP_PAYMENT_STAMPING %',now();\r
\r
 CLOSE Late_entry_cur;\r
\r
 Perform SP_PAYMENT_STAMPING ( ad_run_dt ) ;\r
 al_sqlcode := SQLCODE;\r
 IF al_sqlcode <> 0  THEN\r
  as_error := 'Error in PAYMENT_STAMPING';\r
 End if;\r
\r
 Raise notice '>>>>>>>>>>end SP_PAYMENT_STAMPING %',now();\r
 UPDATE TB_BATCH_RUNTIME_LOG\r
  SET RUNTIME_END_TS = CURRENT_TIMESTAMP, \r
   UPDATE_TS = CURRENT_TIMESTAMP, \r
   UPDATE_USER_ID = 'RESTAMP',\r
