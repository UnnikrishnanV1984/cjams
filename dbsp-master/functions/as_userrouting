 IF status IN (16,17) THEN 
  IF appeventcode = 'INVR' THEN
   UPDATE routing 
   SET activeflag = 0, updatedon = v_date, updatedby = v_securityuserid  
   WHERE routing.objectid IN (
    SELECT isrdc1.intakeservicerequestdispositioncodeid::CHARACTER VARYING FROM intakeservicerequestdispositioncode isrdc1
    INNER JOIN intakeservicerequestdispositioncode isrdc2 ON isrdc2.intakeserviceid = isrdc1.intakeserviceid AND isrdc1.activeflag = 1
    WHERE isrdc2.intakeservicerequestdispositioncodeid = v_objectid_uuid
   ) AND eventcode = appeventcode AND routingstatustypeid = 15 AND activeflag = 1;
  ELSE   
   UPDATE routing 
   SET activeflag = 0, updatedon = v_date, updatedby = v_securityuserid 
   WHERE routing.objectid = v_objectid AND eventcode = appeventcode AND routingstatustypeid = 15 AND activeflag = 1;
  END IF;
 END IF;

 v_status:='SUCCESS';

RETURN v_status;

END;

