CREATE OR REPLACE FUNCTION prov_addupdatefirrepodetails(firrepoobj json)
 RETURNS TABLE(status text, provider_fir_repo_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                         
declare                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
 v_securityuserid character varying;
v_response  character varying;
v_providerfirrepoid character varying;
 begin                                                                                                                                                                                                                                                                                                                                                                                                 
v_providerfirrepoid:=null;
v_securityuserid := firrepoobj->>'securityuserid';
if (firrepoobj->>'provider_fir_repodetailsid' is not null) then
 v_providerfirrepoid := firrepoobj->>'provider_fir_repodetailsid';
end if;
--v_providerfirrepoid='38df4661-1bdb-4c14-8e6c-b5fb3819781c';
 raise notice '%s',v_providerfirrepoid;
raise notice '%s',v_securityuserid;

  if (v_providerfirrepoid) is null  then
   raise notice '%s',v_providerfirrepoid;
  INSERT INTO provider_fir_repodetails (provider_fir_repodetailsid, provider_fir_id, fir_no, is_bankrupcyfiled, 
  is_taxliens, is_auditopinion, is_liabilityoffset, is_cancellationnotice, is_statefederaltaxes, is_leaseorrentpayment, is_financialissues, 
  signatures, pm_signimage, pm_signdate, ed_signimage, ed_signdate, start_dt, end_dt,
  is_allsiteincompliance, financial_issues,is_bankrupcyfiled_comments,is_taxliens_comments,is_auditopinion_comments,is_liabilityoffset_comments,is_cancellationnotice_comments,is_statefederaltaxes_comments,
  is_leaseorrentpayment_comments,is_financialissues_comments,
   inserted_on, updated_on, updated_by, inserted_by, delete_sw, active_flag) 
  VALUES(gen_random_uuid(),  
      (firrepoobj->>'provider_fir_id'),  
      (firrepoobj->>'fir_no'),
      (firrepoobj->>'is_bankrupcyfiled')::boolean , 
      (firrepoobj->>'is_taxliens')::boolean, 
      (firrepoobj->>'is_auditopinion')::boolean, 
      (firrepoobj->>'is_liabilityoffset')::boolean, 
      (firrepoobj->>'is_cancellationnotice')::boolean, 
      (firrepoobj->>'is_statefederaltaxes')::boolean, 
      (firrepoobj->>'is_leaseorrentpayment')::boolean, 
      (firrepoobj->>'is_financialissues')::boolean, 
      (firrepoobj->>'signatures')::json, 
      (firrepoobj->>'pm_signimage')::text, 
      (firrepoobj->>'pm_signdate')::date, 
      (firrepoobj->>'ed_signimage')::text, 
      (firrepoobj->>'ed_signdate')::date, 
      (firrepoobj->>'start_dt')::date, 
      (firrepoobj->>'end_dt')::date,  
      (firrepoobj->>'is_allsiteincompliance')::boolean,
      (firrepoobj->>'financial_issues')::character varying,  
      (firrepoobj->>'is_bankrupcyfiled_comments')::character varying,  
      (firrepoobj->>'is_taxliens_comments')::character varying,  
      (firrepoobj->>'is_auditopinion_comments')::character varying,  
      (firrepoobj->>'is_liabilityoffset_comments')::character varying,  
      (firrepoobj->>'is_cancellationnotice_comments')::character varying,  
      (firrepoobj->>'is_statefederaltaxes_comments')::character varying,  
      (firrepoobj->>'is_leaseorrentpayment_comments')::character varying,  
      (firrepoobj->>'is_financialissues_comments')::character varying,     
      now(),now(), v_securityuserid,  v_securityuserid, 'N'::bpchar, 1) ;    
  else
   raise notice '%s',v_providerfirrepoid;
   --v_providerfirrepoid=(firrepoobj->>'home_info_id');
   update  provider_fir_repodetails pfirrepo set    
      provider_fir_id=(firrepoobj->>'provider_fir_id'),  
      fir_no=(firrepoobj->>'fir_no'),
      is_bankrupcyfiled=(firrepoobj->>'is_bankrupcyfiled')::boolean , 
      is_taxliens=(firrepoobj->>'is_taxliens')::boolean, 
      is_auditopinion=(firrepoobj->>'is_auditopinion')::boolean, 
      is_liabilityoffset=(firrepoobj->>'is_liabilityoffset')::boolean, 
      is_cancellationnotice=(firrepoobj->>'is_cancellationnotice')::boolean, 
      is_statefederaltaxes=(firrepoobj->>'is_statefederaltaxes')::boolean, 
      is_leaseorrentpayment=(firrepoobj->>'is_leaseorrentpayment')::boolean, 
      is_financialissues=(firrepoobj->>'is_financialissues')::boolean, 
      signatures=(firrepoobj->>'signatures')::json, 
      pm_signimage=(firrepoobj->>'pm_signimage')::text, 
      pm_signdate=(firrepoobj->>'pm_signdate')::date, 
      ed_signimage=(firrepoobj->>'ed_signimage')::text, 
      ed_signdate=(firrepoobj->>'ed_signdate')::date,          
      start_dt=(firrepoobj->>'start_dt')::date,          
      end_dt=(firrepoobj->>'end_dt')::date,          
      is_allsiteincompliance=(firrepoobj->>'is_allsiteincompliance')::boolean, 
      financial_issues=(firrepoobj->>'financial_issues')::character varying,  
      is_bankrupcyfiled_comments=(firrepoobj->>'is_bankrupcyfiled_comments')::character varying,  
      is_taxliens_comments=(firrepoobj->>'is_taxliens_comments')::character varying,  
      is_auditopinion_comments=(firrepoobj->>'is_auditopinion_comments')::character varying,  
      is_liabilityoffset_comments=(firrepoobj->>'is_liabilityoffset_comments')::character varying,  
      is_cancellationnotice_comments=(firrepoobj->>'is_cancellationnotice_comments')::character varying,  
      is_statefederaltaxes_comments=(firrepoobj->>'is_statefederaltaxes_comments')::character varying,  
      is_leaseorrentpayment_comments=(firrepoobj->>'is_leaseorrentpayment_comments')::character varying,  
      is_financialissues_comments=(firrepoobj->>'is_financialissues_comments')::character varying,  
      updated_on= now(), updated_by=v_securityuserid,
      delete_sw=(firrepoobj->>'delete_sw')::bpchar,
      active_flag= (firrepoobj->>'active_flag')::int4
    where pfirrepo.provider_fir_repodetailsid=v_providerfirrepoid::uuid;
  end if;
v_response:='Success';
   return query
select v_response::text,v_providerfirrepoid::CHARACTER VARYING;                                                                                                                                                                                                                                                                                                                                                                                                                                         
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

