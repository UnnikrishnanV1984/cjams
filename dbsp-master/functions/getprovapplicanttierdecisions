CREATE OR REPLACE FUNCTION getprovapplicanttierdecisions(eventcd character varying, objid character varying)
 RETURNS TABLE(fromuser character varying, touser character varying, fromroleid character varying, toroleid character varying, objectid character varying, isreviewrequest boolean, remarks text, status text, fromsecurityusersid character varying, tosecurityusersid character varying, countyname character varying, decisiondate timestamp without time zone)
 LANGUAGE plpgsql
AS $function$ 

declare 

v_eventcode character varying;
v_objectid character varying;

begin
 v_eventcode:= eventcd;
 v_objectid:= objid;

 RETURN QUERY 
 SELECT cast(upf.firstname || ' ' || upf.lastname as character varying), cast(upt.firstname || ' ' || upt.lastname as character varying), ptr.fromroleid::varchar, ptr.toroleid::varchar, ptr.objectid::varchar, ptr.isreviewrequest::bool, ptr.remarks::text, ptr.status::text ,
 ptr.fromsecurityusersid,ptr.tosecurityusersid, c.countyname, ptr.decisiondate 
 FROM tb_provider_decision ptr 
 LEFT JOIN userprofile upf on upf.securityusersid = ptr.fromsecurityusersid
 LEFT JOIN userprofile upt on upt.securityusersid = ptr.tosecurityusersid
 LEFT JOIN teammemberassignment t1 on t1.securityusersid = upf.securityusersid and t1.activeflag = 1
 LEFT JOIN teammember t2 ON t1.teammemberid = t2.teammemberid and t2.activeflag = 1
 LEFT JOIN team t3 ON  t3.teamid  =  t2.teamid and t3.activeflag = 1
 LEFT JOIN county c ON c.countyid::CHARACTER VARYING = t3.countyid and c.activeflag = 1
 where ptr.objectid=v_objectid --and ptr.eventcode != 'PRWS'                                                                                                                    
 order by ptr.insertedon desc;
end;

$function$

