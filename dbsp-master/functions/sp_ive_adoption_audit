  minorparentiveeligibilityforfostercarestartdate, dateoflatestpaymentofminorparentiveeligibilityforfostercare, minorparentphysicaladdress);
--     RAISE NOTICE 'output from space %', v_counter ->> 'unearnedincometype';
  END LOOP; 

