CREATE OR REPLACE FUNCTION as_getjsondata(v_intakenumber character varying, v_securityuserid character varying)
 RETURNS TABLE(v_workername character varying, v_youthbasic jsonb, v_youthaddress jsonb, v_youthmail jsonb, v_youthphone jsonb, v_youthhaircolor character varying, v_youtheyecolor character varying, v_pgbasic jsonb, v_pgaddress jsonb, v_pgmail jsonb, v_pgphone jsonb, v_pghaircolor character varying, v_pgeyecolor character varying, v_victimbasic jsonb, v_victimaddress jsonb, v_victimmail jsonb, v_victimphone jsonb, v_victimhaircolor character varying, v_victimeyecolor character varying, v_reldetails jsonb, v_offense jsonb, v_progressnotes jsonb)
 LANGUAGE plpgsql
AS $function$

DECLARE

v_youthpid uuid;
v_pgpid uuid;
v_victimpid uuid;
v_youthbasic jsonb;
v_youthaddress jsonb;
v_youthmail jsonb;
v_youthphone jsonb;
v_youthhaircolor character varying;
v_youtheyecolor character varying;
v_pgbasic jsonb;
v_pgaddress jsonb;
v_pgmail jsonb;
v_pgphone jsonb;
v_pghaircolor character varying;
v_pgeyecolor character varying;
v_victimbasic jsonb;
v_victimaddress jsonb;
v_victimmail jsonb;
v_victimphone jsonb;
v_victimhaircolor character varying;
v_victimeyecolor character varying;
v_reldetails jsonb;
v_offense jsonb;
v_progressnotes jsonb;
j_prgnotes jsonb;
v_jsondata jsonb;

begin

 select 
  jsondata into v_jsondata 
 from intakedastaging where intakenumber = v_intakenumber and activeflag = 1;
 
 select 
  cast(INITCAP(TRIM(coalesce(up.lastname,''))|| ', ' ||TRIM(coalesce(up.firstname,''))) as  character varying) into v_workername 
 from userprofile up 
 where up.securityusersid = v_securityuserid and up.activeflag = 1;

 select (jsonb_array_elements(ids.jsondata->'communicationFields')) into j_prgnotes
 from (select v_jsondata as jsondata) ids ;
   
 select  cast(obj->>'Pid'as uuid) ,
   (select jsonb_agg(youthbasic) from (select distinct count(*) over() as reccount,
    cast(coalesce(obj->>'Role','') as character varying) as youth_Role,
    cast(coalesce(obj->>'fullName','') as character varying) as youth_fullname,
    cast(coalesce(obj->>'Firstname','') as character varying) as youth_firstname,
    cast(coalesce(obj->>'Lastname','') as character varying) as youth_lastname,
    cast(obj->>'middlename'as character varying) as youth_middlename,
    cast(coalesce(obj->>'suffix','') as character varying) as youth_suffix,
    cast(obj->>'aliasname'as character varying) as youth_aliasname,
    cast(coalesce(obj->>'cjamspid','') as character varying) as youth_cjamspid,
    cast(obj->>'Dob' as character varying) as youth_DOB,
    (select distinct typedescription from gendertype where gendertypekey=obj->>'Gender') as youth_gender,
    --cast(obj->>'Gender' as character varying) as youth_gender,
    cast(obj->>'Pid'as character varying) as youth_pid,
    cast(obj->>'ssn'as character varying) as youth_ssn,
    (select distinct typedescription from racetype where racetypekey=cast(obj->>'Race'as character varying)) as youth_Race,
    cast((select typedescription from ethnicgrouptype where activeflag=1 and ethnicgrouptypekey=obj->>'Ethnicity') as character varying) as youthethnicity,  
    --cast(obj->>'Ethnicity' as character varying) as youth_ethnicity,
    cast(obj->>'tribalassociation'as character varying) as youth_tribalassociation,
    cast(obj->>'height'as character varying) as youth_height,
    cast(obj->>'weight'as character varying) as youth_weight,
    cast(obj->>'tattoo'as character varying) as youth_tattoo,
    cast(obj->>'physicalMark'as character varying) as youth_physicalMark,
    cast((select typedescription from maritalstatustype where activeflag=1 and maritalstatustypekey=obj->>'maritalstatus') as character varying) as youth_maritalstatus,
    --cast( as character varying) as youth_maritalstatus,
    cast(obj->>'county' as character varying) as youth_youthcounty,
    cast(obj->>'stateid'as character varying) as youth_stateid ,
    cast(obj->>'ssn'as character varying) as youth_ssn,
    cast(obj->>'primarylanguage'as character varying) as youth_primarylanguage,
    cast(obj->>'secondarylanguage'as character varying) as youth_secondarylanguage)youthbasic) into v_youthpid,v_youthbasic
 from (select v_jsondata as jsondata)ida ,jsonb_array_elements(ida.jsondata->'persons') obj 
 where obj->>'Role' ='Youth' ;

 select jsonb_agg(youthaddress) from ( 
  select distinct count(*) over() as reccount,
   cast(coalesce(personaddressjson->>'address1','') as character varying) as youth_address1,
   cast(coalesce(personaddressjson->>'Address2','') as character varying) as youth_address2,
   cast(coalesce(personaddressjson->>'city','') as character varying) as youth_city,
   cast(coalesce(personaddressjson->>'state','') as character varying) as youth_state,
   cast(coalesce(personaddressjson->>'county','') as character varying) as youth_county,
   cast(coalesce(personaddressjson->>'zipcode','') as character varying) as youth_zipcode,
   cast(coalesce(personaddressjson->>'personaddresstypekey','') as character varying) as youth_addresstypekey,
   cast(coalesce(personaddressjson->>'typedescription','') as character varying) as youth_addresstypename,
   cast(personjson->>'fullAddress'as character varying) as youth_fullAddress
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'address') personaddressjson,
    jsonb_array_elements(idj.jsondata->'persons') personjson 
   from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='Youth' )youthaddress  into v_youthaddress;

 select jsonb_agg(youthmail) from ( 
  select distinct count(*) over() as reccount,
   cast(coalesce(personmailjson->>'mailid','') as character varying) as youth_mailid,
   cast(coalesce(personmailjson->>'isactive','') as character varying) as youth_mailisactive,
   cast(coalesce(personmailjson->>'mailtype','') as character varying) as youth_mailtype,
   cast(coalesce(personmailjson->>'mailtypeid','') as character varying) as youth_mailtypeid
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'contactsmail') personmailjson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='Youth')youthmail into v_youthmail;

 select jsonb_agg(youthphone) from ( 
  select distinct count(*) over() as reccount,
   cast(coalesce(personphonejson->>'contactnumber','') as character varying) as youth_contactnumber,
   cast(coalesce(personphonejson->>'isactive','') as character varying) as youth_phoneisactive,
   cast(coalesce(personphonejson->>'contacttype','') as character varying) as youth_contacttype,
   cast(coalesce(personphonejson->>'contacttypeid','') as character varying) as youth_contacttypeid
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'phoneNumber') personphonejson,
    jsonb_array_elements(idj.jsondata->'persons') personjson 
   from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='Youth' )youthphone into v_youthphone;

 select 
  cast(pp.attributevalue as character varying) into v_youthhaircolor 
 from personphysicalattribute pp 
 where pp.personid=v_youthpid
 and pp.physicalattributetypekey='Haircolor' 
 and pp.activeflag=1; 

 select 
  cast(pp.attributevalue as character varying) into v_youtheyecolor   
 from personphysicalattribute pp 
 where pp.personid=v_youthpid
 and pp.physicalattributetypekey='Eyecolor' 
 and pp.activeflag=1; 
 --------------- parent detail ------------------------

 select  cast(obj->>'Pid'as uuid) ,
   (select jsonb_agg(pgbasic) from (select distinct count(*) over() as reccount,
    cast(coalesce(obj->>'Role','') as character varying) as pg_Role,
    cast(coalesce(obj->>'fullName','') as character varying) as pg_fullname,
    cast(coalesce(obj->>'Firstname','') as character varying) as pg_firstname,
    cast(coalesce(obj->>'Lastname','') as character varying) as pg_lastname,
    cast(obj->>'middlename'as character varying) as pg_middlename,
    cast(coalesce(obj->>'suffix','') as character varying) as pg_suffix,
    cast(obj->>'aliasname'as character varying) as pg_aliasname,
    cast(coalesce(obj->>'cjamspid','') as character varying) as pg_cjamspid,
    cast(obj->>'Dob' as character varying) as pg_DOB,
    --cast(obj->>'Gender' as character varying) as pg_gender,
    (select distinct typedescription from gendertype where gendertypekey=obj->>'Gender') as pg_gender,
    cast(obj->>'Pid'as character varying) as pg_pid,
    cast(obj->>'ssn'as character varying) as pg_ssn,
    (select distinct typedescription from racetype where racetypekey=cast(obj->>'Race'as character varying)) as pg_Race,
    cast((select typedescription from ethnicgrouptype where activeflag=1 and ethnicgrouptypekey=obj->>'Ethnicity') as character varying) as pg_ethnicity,  
    --cast(obj->>'Ethnicity' as character varying) as pg_ethnicity,
    cast(obj->>'tribalassociation'as character varying) as pg_tribalassociation,
    cast(obj->>'height'as character varying) as pg_height,
    cast(obj->>'weight'as character varying) as pg_weight,
    cast(obj->>'tattoo'as character varying) as pg_tattoo,
    cast(obj->>'physicalMark'as character varying) as pg_physicalMark,
    --cast(obj->>'maritalstatus'as character varying) as pg_maritalstatus,
    cast((select typedescription from maritalstatustype where activeflag=1 and maritalstatustypekey=obj->>'maritalstatus') as character varying) as pg_maritalstatus,
    cast(obj->>'county' as character varying) as pg_youthcounty,
    cast(obj->>'stateid'as character varying) as pg_stateid ,
    cast(obj->>'ssn'as character varying) as pg_ssn,
    cast(obj->>'primarylanguage'as character varying) as pg_primarylanguage,
    cast(obj->>'secondarylanguage'as character varying) as pg_secondarylanguage)pgbasic) into v_pgpid,v_pgbasic
 from (select v_jsondata as jsondata) ida ,jsonb_array_elements(ida.jsondata->'persons') obj 
 where obj->>'Role' ='parent-or-guard';

 select jsonb_agg(pgaddress) from ( 
  select distinct count(*) over() as reccount,
   cast(coalesce(personaddressjson->>'address1','') as character varying) as pg_address1,
   cast(coalesce(personaddressjson->>'Address2','') as character varying) as pg_address2,
   cast(coalesce(personaddressjson->>'city','') as character varying) as pg_city,
   cast(coalesce(personaddressjson->>'state','') as character varying) as pg_state,
   cast(coalesce(personaddressjson->>'county','') as character varying) as pg_county,
   cast(coalesce(personaddressjson->>'zipcode','') as character varying) as pg_zipcode,
   cast(coalesce(personaddressjson->>'personaddresstypekey','') as character varying) as pg_addresstypekey,
   cast(coalesce(personaddressjson->>'typedescription','') as character varying) as pg_addresstypename,
   cast(personjson->>'fullAddress'as character varying) as pg_fullAddress
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'address') personaddressjson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='parent-or-guard' )pgaddress into v_pgaddress;

 select jsonb_agg(pgmail) from ( 
  select distinct count(*) over() as reccount,
   cast(coalesce(personmailjson->>'mailid','') as character varying) as pg_mailid,
   cast(coalesce(personmailjson->>'isactive','') as character varying) as pg_mailisactive,
   cast(coalesce(personmailjson->>'mailtype','') as character varying) as pg_mailtype,
   cast(coalesce(personmailjson->>'mailtypeid','') as character varying) as pg_mailtypeid
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'contactsmail') personmailjson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='parent-or-guard')pgmail into v_pgmail;

 select jsonb_agg(pgphone) from ( 
  select distinct count(*) over() as reccount,
   cast(coalesce(personphonejson->>'contactnumber','') as character varying) as pg_contactnumber,
   cast(coalesce(personphonejson->>'isactive','') as character varying) as pg_phoneisactive,
   cast(coalesce(personphonejson->>'contacttype','') as character varying) as pg_contacttype,
   cast(coalesce(personphonejson->>'contacttypeid','') as character varying) as pg_contacttypeid
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'phoneNumber') personphonejson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='parent-or-guard' )pgphone into v_pgphone;

 select 
  cast(pp.attributevalue as character varying) into v_pghaircolor 
 from personphysicalattribute pp 
 where pp.personid=v_pgpid
 and pp.physicalattributetypekey='Haircolor' 
 and pp.activeflag=1; 

 select 
  cast(pp.attributevalue as character varying) into v_pgeyecolor   
 from personphysicalattribute pp 
 where pp.personid=v_pgpid
 and pp.physicalattributetypekey='Eyecolor' 
 and pp.activeflag=1; 
 ----------------------- victim details --------------------
 select  cast(obj->>'Pid'as uuid) ,
   (select jsonb_agg(victimbasic) from (select distinct count(*) over() as reccount,
    cast(coalesce(obj->>'Role','') as character varying) as victim_Role,
    cast(coalesce(obj->>'fullName','') as character varying) as victim_fullname,
    cast(coalesce(obj->>'Firstname','') as character varying) as victim_firstname,
    cast(coalesce(obj->>'Lastname','') as character varying) as victim_lastname,
    cast(obj->>'middlename'as character varying) as victim_middlename,
    cast(coalesce(obj->>'suffix','') as character varying) as victim_suffix,
    cast(obj->>'aliasname'as character varying) as victim_aliasname,
    cast(coalesce(obj->>'cjamspid','') as character varying) as victim_cjamspid,
    cast(obj->>'Dob' as character varying) as victim_DOB,
    --cast(obj->>'Gender' as character varying) as victim_gender,
    (select distinct typedescription from gendertype where gendertypekey=obj->>'Gender') as victim_gender,
    cast(obj->>'Pid'as character varying) as victim_pid,
    cast(obj->>'ssn'as character varying) as victim_ssn,
    (select distinct typedescription from racetype where racetypekey=cast(obj->>'Race'as character varying)) as victim_Race,
    --cast(obj->>'Ethnicity' as character varying) as victim_ethnicity,
    cast((select typedescription from ethnicgrouptype where activeflag=1 and ethnicgrouptypekey=obj->>'Ethnicity') as character varying) as victim_ethnicity,  
    cast(obj->>'tribalassociation'as character varying) as victim_tribalassociation,
    cast(obj->>'height'as character varying) as victim_height,
    cast(obj->>'weight'as character varying) as victim_weight,
    cast(obj->>'tattoo'as character varying) as victim_tattoo,
    cast(obj->>'physicalMark'as character varying) as victim_physicalMark,
    --cast(obj->>'maritalstatus'as character varying) as victim_maritalstatus,
    cast((select typedescription from maritalstatustype where activeflag=1 and maritalstatustypekey=obj->>'maritalstatus') as character varying) as victim_maritalstatus,
    cast(obj->>'county' as character varying) as victim_youthcounty,
    cast(obj->>'stateid'as character varying) as victim_stateid ,
    cast(obj->>'ssn'as character varying) as victim_ssn,
    cast(obj->>'primarylanguage'as character varying) as victim_primarylanguage,
    cast(obj->>'secondarylanguage'as character varying) as victim_secondarylanguage)victimbasic) into v_victimpid,v_victimbasic
 from (select v_jsondata as jsondata) ida ,jsonb_array_elements(ida.jsondata->'persons') obj 
 where obj->>'Role' ='Victim' ;

 select jsonb_agg(victimaddress) from (
  select distinct count(*) over() as reccount,
   cast(coalesce(personaddressjson->>'address1','') as character varying) as victim_address1,
   cast(coalesce(personaddressjson->>'Address2','') as character varying) as victim_address2,
   cast(coalesce(personaddressjson->>'city','') as character varying) as victim_city,
   cast(coalesce(personaddressjson->>'state','') as character varying) as victim_state,
   cast(coalesce(personaddressjson->>'county','') as character varying) as victim_county,
   cast(coalesce(personaddressjson->>'zipcode','') as character varying) as victim_zipcode,
   cast(coalesce(personaddressjson->>'personaddresstypekey','') as character varying) as victim_addresstypekey,
   cast(coalesce(personaddressjson->>'typedescription','') as character varying) as victim_addresstypename,
   cast(personjson->>'fullAddress'as character varying) as victim_fullAddress
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'address') personaddressjson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='Victim')victimaddress into v_victimaddress;

 select jsonb_agg(victimmail) from (
  select distinct count(*) over() as reccount,
   cast(coalesce(personmailjson->>'mailid','') as character varying) as victim_mailid,
   cast(coalesce(personmailjson->>'isactive','') as character varying) as victim_mailisactive,
   cast(coalesce(personmailjson->>'mailtype','') as character varying) as victim_mailtype,
   cast(coalesce(personmailjson->>'mailtypeid','') as character varying) as victim_mailtypeid
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'contactsmail') personmailjson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='Victim')victimmail into v_victimmail;

 select jsonb_agg(victimphone) from (
  select distinct count(*) over() as reccount,
   cast(coalesce(personphonejson->>'contactnumber','') as character varying) as victim_contactnumber,
   cast(coalesce(personphonejson->>'isactive','') as character varying) as victim_phoneisactive,
   cast(coalesce(personphonejson->>'contacttype','') as character varying) as victim_contacttype,
   cast(coalesce(personphonejson->>'contacttypeid','') as character varying) as victim_contacttypeid
 from (select jsonb_array_elements(jsonb_array_elements(idj.jsondata->'persons')->'phoneNumber') personphonejson,
 jsonb_array_elements(idj.jsondata->'persons') personjson from (select v_jsondata as jsondata)idj )ida         
 where personjson->>'Role' ='Victim')victimphone into v_victimphone;

 select 
  cast(pp.attributevalue as character varying) into v_victimhaircolor 
 from personphysicalattribute pp 
 where pp.personid=v_victimpid
 and pp.physicalattributetypekey='Haircolor' 
 and pp.activeflag=1; 

 select 
  cast(pp.attributevalue as character varying) into v_victimeyecolor
 from personphysicalattribute pp 
 where pp.personid=v_victimpid
 and pp.physicalattributetypekey='Eyecolor' 
 and pp.activeflag=1; 

 select jsonb_agg(reldetails) from (
  select distinct count(*) over() as reccount,
   pr.livingwith as livingwithflag,
   cast(INITCAP(TRIM(coalesce(relperson.lastname,''))|| CASE WHEN (relperson.suffix is not null and p.suffix!='' ) THEN ' ' ELSE '' END  || TRIM(coalesce(relperson.suffix,'')) || ', ' ||TRIM(coalesce(relperson.firstname,''))) as  character varying) as rel_name,
   cast(pr.actorrelationshipkey as character varying) as living_relationship,
   cast(reladdr.address as character varying) as rel_addr1,
   cast(reladdr.address2 as character varying) as rel_addr2,
   cast(reladdr.county as character varying) as rel_county,
   cast(reladdr.city as character varying) as rel_city,
   cast(reladdr.state as character varying) as rel_state,
   cast(reladdr.zipcode as character varying) as rel_zipcode,
   cast(coalesce(relphone.phoneextension,'000')||relphone.phonenumber as character varying) as rel_phonenumber,
   cast(rel_email.email as character varying) as rel_email, 
   cast((select coalesce(ph.phoneextension,'000')||ph.phonenumber from personphonenumber ph where ph.personid = relperson.personid and ph.activeflag =1 and ph.personphonetypekey = 'P' limit 1) as character varying) as rel_primary_phone,
   cast((select coalesce(ph.phoneextension,'000')||ph.phonenumber from personphonenumber ph where ph.personid = relperson.personid and ph.activeflag =1 and ph.personphonetypekey = 'S' limit 1) as character varying) as rel_sec_phone
 from person p 
 left join personrelation pr on pr.personid = p.personid and pr.activeflag = 1
 left join person relperson on pr.personrelativeid = p.personid and relperson.activeflag = 1
 left join (select ad.* from personaddress ad left join personaddresstype pat on ad.personaddresstypekey = pat.personaddresstypekey and pat.activeflag = 1 and ad.activeflag = 1 order by pat.sequencenumber limit 1) reladdr on reladdr.personid = p.personid 
 left join (select ph.phoneextension,ph.phonenumber,ph.personid from personphonenumber ph left join personphonetype pp on ph.personphonetypekey = pp.personphonetypekey and ph.activeflag =1 and pp.activeflag =1 order by pp.sequencenumber limit 1) relphone on relphone.personid = relperson.personid 
 left join (select e.* from personemail e left join personemailtype pet on e.personemailtypekey = pet.personemailtypekey and e.activeflag =1 and pet.activeflag =1 order by pet.sequencenumber limit 1) rel_email on rel_email.personid = relperson.personid 
 where p.personid = v_youthpid and p.activeflag = 1
 )reldetails into v_reldetails;

 select jsonb_agg(offense) from (
  select distinct count(*) over() as reccount,b.* ,
  alg.offensecategory,
  alg.name as offensename from (
   select distinct 
    evaljson->>'complaintid' as complaintid,
    evaljson->>'sourceTitle' as sourceTitle,
    evaljson->>'sourcefirstname' as sourcefirstname,
    evaljson->>'sourcelastname' as sourcelastname,
    evaljson->>'sourceKey' as sourceKey,
    evaljson->>'sourceBadgeNo' as sourceBadgeNo,
    evaljson->>'sourceStreet1' as sourceStreet1,
    evaljson->>'sourceStreet2' as sourceStreet2,
    evaljson->>'allegedoffensedate' as allegedoffensedate,
    evaljson->>'evaluationsourceagencyname' as evaluationsourceagencyname,
    jsonb_array_elements(jsonb_array_elements(ids.jsondata->'evaluationFields')->'allegedoffense')->>'allegationid' as allegationid
   from (select v_jsondata as jsondata) ids
   ,jsonb_array_elements(ids.jsondata->'evaluationFields') as evaljson )b 
  join allegation alg on alg.allegationid = cast(b.allegationid as uuid) and alg.activeflag = 1
 )offense into v_offense;

 select jsonb_agg(progressnotes) from 
  (
   select distinct count(*) over() as reccount, 
    prgnotes->>'contactdate' as contactdate,
    prgnotes->>'description' as description,
    (select progressnotetypekey from progressnotetype where progressnotetypeid = cast(prgnotes->>'progressnotetypeid' as uuid) and activeflag = 1) as contacttype
    from (select v_jsondata as jsondata) ids
   ,jsonb_array_elements(ids.jsondata->'communicationFields') as prgnotes 
  )progressnotes into v_progressnotes;

 return query
 select v_workername,coalesce(v_youthbasic,'[]'::jsonb),coalesce(v_youthaddress,'[]'::jsonb),coalesce(v_youthmail,'[]'::jsonb) ,coalesce(v_youthphone,'[]'::jsonb),v_youthhaircolor,v_youtheyecolor,
 coalesce(v_pgbasic,'[]'::jsonb),coalesce(v_pgaddress,'[]'::jsonb),coalesce(v_pgmail,'[]'::jsonb),coalesce(v_pgphone,'[]'::jsonb),v_pghaircolor,v_pgeyecolor,
 coalesce(v_victimbasic,'[]'::jsonb),coalesce(v_victimaddress,'[]'::jsonb),coalesce(v_victimmail,'[]'::jsonb),coalesce(v_victimphone,'[]'::jsonb),v_victimhaircolor,v_victimeyecolor,coalesce(v_reldetails,'[]'::jsonb),coalesce(v_offense,'[]'::jsonb),coalesce(v_progressnotes,'[]'::jsonb);

end;
$function$

