CREATE OR REPLACE FUNCTION as_getihasfiscalreportdetails(v_personid integer)
 RETURNS TABLE(ihasfiscaltotal bigint)
 LANGUAGE plpgsql
AS $function$
declare
v_date date;
v_startdate character varying;
v_enddate character varying;
v_year character varying;
v_month character varying;
nextyear character varying;
beforeyear character varying;
begin
 v_date := now() :: date;
    v_year := to_char(v_date,'YYYY');
 v_month := to_char(v_date,'MM');
 nextyear := (v_year :: integer) + 1;
 beforeyear := (v_year :: integer) - 1;
 if (v_month :: integer) > 6 then
  v_startdate := CONCAT('07-01-', v_year);
  v_enddate :=  CONCAT('06-30-', nextyear);
 end if;
 if (v_month :: integer) < 6 then
  v_startdate := CONCAT('07-01-', beforeyear);
  v_enddate :=  CONCAT('06-30-', v_year);
 end if;
 RAISE NOTICE 'else(%)', v_startdate;
 RAISE NOTICE 'else(%)', v_enddate;
 RAISE NOTICE 'else(%)', to_char(v_date,'YYYY');
 RETURN QUERY 

 select

 SUM(COALESCE(as_convertvarchartoint(IPMRDC.day01),0) + COALESCE(as_convertvarchartoint(IPMRDC.day02),0) + COALESCE(as_convertvarchartoint(IPMRDC.day03),0) + COALESCE(as_convertvarchartoint(IPMRDC.day04),0) + COALESCE(as_convertvarchartoint(IPMRDC.day05),0) + COALESCE(as_convertvarchartoint(IPMRDC.day06),0) + COALESCE(as_convertvarchartoint(IPMRDC.day07),0) + COALESCE(as_convertvarchartoint(IPMRDC.day08),0)+
  COALESCE(as_convertvarchartoint(IPMRDC.day09),0) + COALESCE(as_convertvarchartoint(IPMRDC.day10),0) + COALESCE(as_convertvarchartoint(IPMRDC.day11),0) + COALESCE(as_convertvarchartoint(IPMRDC.day12),0) + COALESCE(as_convertvarchartoint(IPMRDC.day13),0) + COALESCE(as_convertvarchartoint(IPMRDC.day14),0) + COALESCE(as_convertvarchartoint(IPMRDC.day15),0) +
    COALESCE(as_convertvarchartoint(IPMRDC.day16),0)+COALESCE(as_convertvarchartoint(IPMRDC.day17),0)+COALESCE(as_convertvarchartoint(IPMRDC.day18),0)+COALESCE(as_convertvarchartoint(IPMRDC.day19),0)+COALESCE(as_convertvarchartoint(IPMRDC.day20),0) + COALESCE(as_convertvarchartoint(IPMRDC.day21),0) + COALESCE(as_convertvarchartoint(IPMRDC.day22),0) + COALESCE(as_convertvarchartoint(IPMRDC.day23),0)+COALESCE(as_convertvarchartoint(IPMRDC.day24),0)+COALESCE(as_convertvarchartoint(IPMRDC.day25),0)+COALESCE(as_convertvarchartoint(IPMRDC.day26),0)+
    COALESCE(as_convertvarchartoint(IPMRDC.day27),0)+COALESCE(as_convertvarchartoint(IPMRDC.day28),0)+COALESCE(as_convertvarchartoint(IPMRDC.day29),0) + COALESCE(as_convertvarchartoint(IPMRDC.day30),0) + COALESCE(as_convertvarchartoint(IPMRDC.day31),0) )


from 
 --person p
--inner join intakeservicerequestactor ISRA on ISRA.personid=P.personid and ISRA.activeflag=1 and ISRA.intakeservicerequestpersontypekey='RA'
--inner join ihasprovidermonthlyreport IPMR1  on ISRA.intakeserviceid=IPMR1.intakeserviceid and IPMR1.activeflag=1
ihasprovidermonthlyreport IPMR1  
inner join ihasprovidedmonthlyreportdaysconfig IPMRDC 
on IPMRDC.ihasprovidermonthlyreportid=IPMR1.ihasprovidermonthlyreportid and IPMRDC.activeflag=1
where  --ISRA.personid = v_personid 
        --IPMR1.serviceplanvendorid = v_personid -- provider id
  IPMR1.provider_id::integer = v_personid -- provider id
  and IPMR1.activeflag=1
  and IPMR1.status in ('Approved','Review') 
  and IPMRDC.ihasprovidermonthlyreportid=IPMR1.ihasprovidermonthlyreportid 
  and IPMR1.activeflag=1
  and (cast(IPMRDC.insertedon AS date) BETWEEN cast(v_startdate AS date) AND cast(v_enddate AS date)) 
;

                
end;

