CREATE OR REPLACE FUNCTION f_prim_assignment(ai_entity_id integer, as_entity_type_cd character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
begin

return
(SELECT STAFF_ID FROM (
   SELECT   ROW_NUMBER() OVER() AS NUM, TB_STAFF.STAFF_ID
    FROM       TB_ASSIGNMENT,
            TB_STAFF
    WHERE     ( TB_ASSIGNMENT.ENTITY_TYPE_CD = as_entity_type_cd) and
            ( TB_ASSIGNMENT.ENTITY_KEY_ID = ai_entity_id) and
            ( TB_ASSIGNMENT.RESPONSIBILITY_CD = 'P') and
            ( TB_ASSIGNMENT.END_DT IS NULL) and
            ( TB_STAFF.STAFF_ID = TB_ASSIGNMENT.ASSIGN_TO_STAFF_ID)  and
            ( TB_ASSIGNMENT.DELETE_SW = 'N') and
            ( TB_STAFF.DELETE_SW = 'N') ORDER BY ASSIGNMENT_ID DESC) TAB WHERE NUM=1 );
   
end;

$function$

