CREATE OR REPLACE FUNCTION prov_getprovidercompliantsrouting(v_complaintno character varying)
 RETURNS TABLE(status character varying, statusdesc text, remarks text, fromsecurityusersid character varying, fromusename text, tosecurityusersid character varying, tousername text, insertedon timestamp without time zone)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                
                                                                                                                                                                                                              
DECLARE                                                                                                                                                                                                      
                                                                                                                                                                                                        
BEGIN                                                                                                                                                                                                        
                                                                                                                                                                                                        
RETURN  query                                                                                                                                                                                                
    SELECT                                                                                                                                                                                                       
        rs.routingstatustypekey  AS  status,
        rs.typedescription AS statusdesc,
        r.remarks,                                                                                                                                                                 
        r.fromsecurityusersid,                                                                                                                                                                               
        uf.firstname  ||'  '||  uf.lastname  fromusename,                                                                                                                                                    
        r.tosecurityusersid,                                                                                                                                                                                 
        up.firstname  ||'  '||  up.lastname  tousername,                                                                                                                                                     
        r.insertedon                                                                                                                                                                                         
    FROM  routing  r                                                                                                                                                                                             
        LEFT  JOIN  userprofile  up  ON  up.securityusersid  =  r.tosecurityusersid  AND  up.activeflag  =1                                                                                                         
        INNER  JOIN  userprofile  uf  ON  uf.securityusersid  =  r.fromsecurityusersid  AND  uf.activeflag  =1                                                                                                       
        INNER  JOIN  routingstatustype  rs  ON  r.routingstatustypeid  =  rs.sequencenumber  AND  rs.activeflag  =1                                                                                                  
        WHERE  r.objectid  =  v_complaintno
    ORDER BY r.insertedon DESC;                                                                                                                                                                  
    --AND  r.eventcode  =  v_eventcode;
END;                                                                                                                                                                                                             
$function$

