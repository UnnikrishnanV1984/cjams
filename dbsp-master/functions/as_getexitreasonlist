CREATE OR REPLACE FUNCTION as_getexitreasonlist(v_picklist_value_cd character varying)
 RETURNS TABLE(totalcount bigint, picklist_value_cd character varying, picklist_type_id integer, value_tx character varying, description_tx character varying, active_sw character varying, sort_order_no integer, create_ts character varying, create_user_id character varying, update_ts character varying, update_user_id character varying, delete_sw character, category_tx character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN
IF (v_picklist_value_cd = '32843') THEN

RETURN QUERY 
select count(1) over(),TBPLV.picklist_value_cd, TBPLV.picklist_type_id, TBPLV.value_tx, TBPLV.description_tx, TBPLV.active_sw, TBPLV.sort_order_no, TBPLV.create_ts,
TBPLV.create_user_id, TBPLV.update_ts, TBPLV.update_user_id, TBPLV.delete_sw, TBPLV.category_tx from tb_picklist_values as TBPLV where TBPLV.picklist_type_id = '165'
and TBPLV.PICKLIST_VALUE_CD in ('1825','4530','4531','4532','4533','4534','4535','4536','4537','4538','10480','4539','1826','1830','1831','4540','4541','4542','4543',
'4544','4545','4546','4547','4548','4549','4550','4551','4552','4553','1834','1835')
and TBPLV.active_sw = 'Y' and TBPLV.delete_sw = 'N'
order by value_tx ASC ;

/*ELSIF (v_picklist_value_cd = '4591') THEN

RETURN QUERY 
select count(1) over(),TBPLV.picklist_value_cd, TBPLV.picklist_type_id, TBPLV.value_tx, TBPLV.description_tx, TBPLV.active_sw, TBPLV.sort_order_no, TBPLV.create_ts,
TBPLV.create_user_id, TBPLV.update_ts, TBPLV.update_user_id, TBPLV.delete_sw, TBPLV.category_tx from tb_picklist_values as TBPLV where TBPLV.picklist_type_id = '165'
and TBPLV.active_sw = 'Y' and TBPLV.delete_sw = 'N'
order by value_tx ASC ; */

ELSIF (v_picklist_value_cd = '4592') THEN

RETURN QUERY 
select count(1) over(),TBPLV.picklist_value_cd, TBPLV.picklist_type_id, TBPLV.value_tx, TBPLV.description_tx, TBPLV.active_sw, TBPLV.sort_order_no, TBPLV.create_ts,
TBPLV.create_user_id, TBPLV.update_ts, TBPLV.update_user_id, TBPLV.delete_sw, TBPLV.category_tx from tb_picklist_values as TBPLV where TBPLV.picklist_type_id = '165'
and TBPLV.PICKLIST_VALUE_CD in ('1825','4529','1826','4554','8188','1827','1829','1828','4555','4556','1830','1831','1832','1833','1834','1835')
and TBPLV.active_sw = 'Y' and TBPLV.delete_sw = 'N'
order by value_tx ASC ;

END IF;
   
END;
 

$function$

