CREATE OR REPLACE FUNCTION prov_addupdateaslicenseinfo(pplicenseinfoobj json)
 RETURNS TABLE(status text, home_info_id character varying)
 LANGUAGE plpgsql
AS $function$                                                                                                                                                                                                                                                                                                                                                                                        
declare                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                       
v_securityuserid character varying;
v_response  character varying;
v_licenseappid character varying;
begin                                                                                                                                                                                                                                                                                                                                                                                                
v_licenseappid:=null;
v_securityuserid := pplicenseinfoobj->>'securityuserid';
if (pplicenseinfoobj->>'license_app_id' is not null) then
 v_licenseappid := pplicenseinfoobj->>'license_app_id';
end if;
--v_licenseappid='38df4661-1bdb-4c14-8e6c-b5fb3819781c';
 raise notice '%s',v_licenseappid;
raise notice '%s',v_securityuserid;


if (v_licenseappid) is null  then
raise notice '%s',v_licenseappid;
update as_tb_provider_license set delete_sw='Y' where object_id=(pplicenseinfoobj->>'object_id');
INSERT INTO as_tb_provider_license (object_id, program_id, license_type_cd, license_status_cd, license_issue_dt,
license_expiry_dt, license_no, licensing_agency_cd, revoke_dt, license_effective_date,  
comments_tx, create_ts, create_user_id, update_ts, update_user_id)
VALUES(
(pplicenseinfoobj->>'object_id'),  
(pplicenseinfoobj->>'program_id')::int4,
(pplicenseinfoobj->>'license_type_cd') ,
(pplicenseinfoobj->>'license_status_cd') ,
(pplicenseinfoobj->>'license_issue_dt')::date,
(pplicenseinfoobj->>'license_expiry_dt')::date,
(pplicenseinfoobj->>'license_no'),
(pplicenseinfoobj->>'licensing_agency_cd'),
(pplicenseinfoobj->>'revoke_dt')::date,
(pplicenseinfoobj->>'license_effective_date')::date,
(pplicenseinfoobj->>'comments_tx'),  
now(), v_securityuserid, now(), v_securityuserid
) ;
else
raise notice '%s',v_licenseappid;
--v_homeinfoid=(pplicenseinfoobj->>'home_info_id');
update  as_tb_provider_license aslic set                                                                                                                                
object_id=(pplicenseinfoobj->>'object_id'),  
program_id=(pplicenseinfoobj->>'program_id')::int4,
license_type_cd=(pplicenseinfoobj->>'license_type_cd') ,
license_status_cd=(pplicenseinfoobj->>'license_status_cd') ,
license_issue_dt=(pplicenseinfoobj->>'license_issue_dt')::date,
license_expiry_dt=(pplicenseinfoobj->>'license_expiry_dt')::date,
license_no=(pplicenseinfoobj->>'license_no'),
licensing_agency_cd=(pplicenseinfoobj->>'licensing_agency_cd'),
revoke_dt=(pplicenseinfoobj->>'revoke_dt')::date,
license_effective_date=(pplicenseinfoobj->>'license_effective_date')::date,
delete_sw=(pplicenseinfoobj->>'delete_sw'),
active_sw= (pplicenseinfoobj->>'active_sw'),
comments_tx=(pplicenseinfoobj->>'comments_tx') ,
update_ts= now(),
update_user_id=v_securityuserid
where aslic.license_app_id=v_licenseappid;
end if;
v_response:='Success';
   return query
select v_response::text,v_licenseappid::CHARACTER VARYING;                                              
                                                                                                                                                                                                                                                                                                                                                                                           
end;                                                                                                                                                                                                                                                                                                                                                                                                  
$function$

