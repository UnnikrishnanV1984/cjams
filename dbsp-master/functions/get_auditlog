CREATE OR REPLACE FUNCTION get_auditlog(v_column character varying, v_tablename character varying, objectid character varying, pagenumber bigint, pagesize bigint)
 RETURNS json
 LANGUAGE plpgsql
AS $function$  
 
 DECLARE    
 v_pageoffset  int;       
 v_pagenumber  int;       
 l_data json;     
 
 BEGIN      
 v_pagenumber  :=  pagenumber-1;     
 v_pageoffset  =  v_pagenumber  *  pagesize;
 l_data := '[]';


 EXECUTE 'SELECT COALESCE(json_agg(e), ''[]'')
   FROM (
    SELECT to_char(i.updatedon, ''mm/dd/yyyy hh:mi AM'' ) as updatedon
    , u.fullname 
    , u.email
    , i.modifieddata 
    FROM ' || quote_ident($2) || ' i
    INNER JOIN userprofile u on u.securityusersid = i.updatedby 
    WHERE i.rowtype = ''HISTORY'' and  i.' || quote_ident($1) || '::character varying = ''' || $3 || '''::character varying
    OFFSET ' || v_pageoffset || ' LIMIT ' || pagesize || '
   ) e ' INTO l_data;

 RETURN l_data;

END;

$function$

