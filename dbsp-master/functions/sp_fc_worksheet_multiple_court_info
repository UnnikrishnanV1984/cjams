CREATE OR REPLACE FUNCTION sp_fc_worksheet_multiple_court_info(al_client_id bigint, al_removal_id bigint, periodtype character varying, period_start_dt date, period_end_dt date)
 RETURNS TABLE(client_id bigint, removal_id integer, ctwjson json, reasonableeffortsjson json, jdrefppjson json, vpabestinterestjson json, dateagencylostlegalresponsibility timestamp without time zone, clientidofsubjectctwfinding bigint, nameofsubjectctwfinding character varying, relationshipofsubjectctwfinding integer, isiveagencyresponsibleforplacementandcare character varying, ctwcourtorderid character varying, reasonablecourtorderid character varying, redetcourtorderid character varying, dateofcourthearing timestamp without time zone, magistrateorjudgename character varying, issignedbyjudge character varying, ctwdecision character varying, dateoffindingctwdecision character varying, dateofnexthearing timestamp without time zone, courtorderdelayremoval character varying, courtorderdelaytimedays character varying, typeofcourthearing character varying, reasonableeffortsmade character varying, dateofreasonableeffortscourthearing character varying, reasonableeffortsnotnecessaryduetoemergentcircumstances character varying, dateofjudicialfindingofrefpp character varying, dateofsubsequentjudicialfindingofrefpp character varying, dateofpreviousjudicialfindingofrefpp character varying, fostercarepermanencyplandesc character varying, dateofcurrentjudicialfindingofbestinterest character varying, dateofsubsequentfindingofbestinterest character varying, dateofpreviousbestinterestfinding character varying, fostercarepermanencyplan character varying)
 LANGUAGE plpgsql
AS $function$

DECLARE 
  vs_Procedure_nm         VARCHAR(100) DEFAULT 'sp_fc_worksheet_court_info';
  vn_rmvl_id          INTEGER;
  vd_removal_dt                                   TIMESTAMP;
  vd_removal_60         TIMESTAMP;
  vd_removal_type                                 VARCHAR(50);
  v_ctwjson           JSON;
  v_reasonableeffortsjson       JSON;
  v_jdrefppjson                                   JSON;
  v_vpabestinterestjson       JSON;
  v_date_agency_lost_legal_responsibility   timestamp;
  v_clientidofsubjectctwfinding      int8;
     v_nameofsubjectctwfinding       VARCHAR;
     v_relationshipofsubjectctwfinding     int4;
     v_isiveagencyresponsibleforplacementandcare  VARCHAR;
  v_ctwcourtorderid         VARCHAR;
     v_reasonablecourtorderid       VARCHAR;
     v_redetcourtorderid         VARCHAR;
  v_dateofcourthearing        timestamp;
  v_magistrateorjudgename       varchar;
  v_issignedbyjudge         varchar;
  v_ctwdecision          varchar;
  v_dateoffindingctwdecision       VARCHAR;
  v_dateofnexthearing        timestamp;
  v_courtorderdelayremoval       VARCHAR;
  v_courtorderdelaytimedays       VARCHAR;
  v_typeofcourthearing        VARCHAR;
  v_reasonableeffortsmade       VARCHAR;
  v_dateofreasonableeffortscourthearing    VARCHAR;
  v_reasonableeffortsnotnecessaryduetoemergentcircumstances varchar;
  v_dateofjudicialfindingofrefpp      varchar;
  v_dateofsubsequentjudicialfindingofrefpp   varchar;
  v_dateofpreviousjudicialfindingofrefpp    VARCHAR;
  v_fostercarepermanencyplandesc      VARCHAR;
  v_dateofcurrentjudicialfindingofbestinterest  VARCHAR;
  v_dateofsubsequentfindingofbestinterest   VARCHAR;
  v_dateofpreviousbestinterestfinding    VARCHAR;
  v_fostercarepermanencyplan                      VARCHAR;
  vd_periodenddate_60                             TIMESTAMP;
  vd_previousbestinterestdt                       TIMESTAMP DEFAULT NULL;
  vd_previousfindingdate                          TIMESTAMP;
  vd_sqnm_sw           VARCHAR;
    
 
 BEGIN 
CREATE TEMP TABLE IF NOT EXISTS
Temp_worksheet_court_info ( 
  client_id              BIGINT,
  removal_id             INTEGER,
  ctwjson              JSON,
  reasonableeffortsjson                                       JSON,
  jdrefppjson                                                 JSON,
  vpabestinterestjson                                         JSON,
  dateagencylostlegalresponsibility         timestamp,
  clientidofsubjectctwfinding         int8,
     nameofsubjectctwfinding          VARCHAR,
     relationshipofsubjectctwfinding        int4,
     isiveagencyresponsibleforplacementandcare         VARCHAR,
  ctwcourtorderid                                             VARCHAR,
  reasonablecourtorderid          VARCHAR,
  redetcourtorderid           VARCHAR,
  dateofcourthearing            timestamp,
  magistrateorjudgename          varchar,
  issignedbyjudge            varchar,
  ctwdecision             varchar,
  dateoffindingctwdecision          VARCHAR,
  dateofnexthearing            timestamp,
  courtorderdelayremoval           VARCHAR,
  courtorderdelaytimedays          VARCHAR,
  typeofcourthearing            VARCHAR,
  reasonableeffortsmade           VARCHAR,
  dateofreasonableeffortscourthearing       VARCHAR,
  reasonableeffortsnotnecessaryduetoemergentcircumstances  varchar,
  dateofjudicialfindingofrefpp         varchar,
  dateofsubsequentjudicialfindingofrefpp       varchar,
  dateofpreviousjudicialfindingofrefpp       VARCHAR,
  fostercarepermanencyplandesc         VARCHAR,
  dateofcurrentjudicialfindingofbestinterest      VARCHAR,
  dateofsubsequentfindingofbestinterest       VARCHAR,
  dateofpreviousbestinterestfinding        VARCHAR,
  fostercarepermanencyplan         VARCHAR
 );
 
 vn_rmvl_id := al_removal_id::int;


SELECT isrcr.removaldate , isrcr.removaltypekey
INTO   vd_removal_dt , vd_removal_type
FROM   intakeservreqchildremoval isrcr, person per, intakeservicerequestactor isra 
WHERE  isrcr.removalid::bigint = al_removal_id AND isra.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
 AND per.personid = isra.personid AND per.cjamspid::BIGINT = al_client_id AND per.activeflag = 1 limit 1;
 
SELECT tfcj.date_agency_lost_legal_responsibility, tfcj.clientidofsubjectctwfinding, tfcj.nameofsubjectctwfinding, tfcj.relationshipofsubjectctwfinding, tfcj.isiveagencyresponsibleforplacementandcare, tfcj.ctwcourtorderid,
tfcj.reasonablecourtorderid, tfcj.redetcourtorderid, tfcj.dateofcourthearing, tfcj.magistrateorjudgename, tfcj.issignedbyjudge, tfcj.ctwdecision, tfcj.dateoffindingctwdecision, tfcj.dateofnexthearing, tfcj.courtorderdelayremoval,
 tfcj.courtorderdelaytimedays, tfcj.typeofcourthearing, tfcj.reasonableeffortsmade, tfcj.dateofreasonableeffortscourthearing, tfcj.reasonableeffortsnotnecessaryduetoemergentcircumstances, tfcj.dateofjudicialfindingofrefpp, 
 tfcj.dateofsubsequentjudicialfindingofrefpp, tfcj.dateofpreviousjudicialfindingofrefpp, tfcj.fostercarepermanencyplandesc, tfcj.dateofcurrentjudicialfindingofbestinterest, tfcj.dateofsubsequentfindingofbestinterest, tfcj.dateofpreviousbestinterestfinding, tfcj.fostercarepermanencyplan
into v_date_agency_lost_legal_responsibility,v_clientidofsubjectctwfinding, v_nameofsubjectctwfinding,v_relationshipofsubjectctwfinding,v_isiveagencyresponsibleforplacementandcare,v_ctwcourtorderid,
    v_reasonablecourtorderid,v_redetcourtorderid,  v_dateofcourthearing, v_magistrateorjudgename , v_issignedbyjudge, v_ctwdecision, v_dateoffindingctwdecision, v_dateofnexthearing, v_courtorderdelayremoval,
 v_courtorderdelaytimedays, v_typeofcourthearing, v_reasonableeffortsmade, v_dateofreasonableeffortscourthearing, v_reasonableeffortsnotnecessaryduetoemergentcircumstances, v_dateofjudicialfindingofrefpp, 
 v_dateofsubsequentjudicialfindingofrefpp,v_dateofpreviousjudicialfindingofrefpp, v_fostercarepermanencyplandesc, v_dateofcurrentjudicialfindingofbestinterest, v_dateofsubsequentfindingofbestinterest, v_dateofpreviousbestinterestfinding, v_fostercarepermanencyplan
FROM tb_foster_care_judicial tfcj where tfcj.client_id::BIGINT = al_client_id and tfcj.removal_id::BIGINT = al_removal_id and tfcj.period_type = periodtype;


IF(periodtype not in ('I' , 'R1' , '18BDAY'))
THEN
   IF length(periodtype) = 3 
  then 
  vd_sqnm_sw = 'R1' || (right(periodtype, 1)::int -1);
  else 
  vd_sqnm_sw = 'R' || (right(periodtype, 1)::int -1);
 end if;
 select (case when tcj.dateofjudicialfindingofrefpp is not null then tcj.dateofjudicialfindingofrefpp else tcj.dateofpreviousjudicialfindingofrefpp end)  into vd_previousbestinterestdt  from tb_foster_care_judicial tcj where tcj.client_id = al_client_id and tcj.removal_id = al_removal_id and tcj.period_type = vd_sqnm_sw;
 If(vd_sqnm_sw = 'R1' and vd_previousbestinterestdt is null) then
   select tcj.dateofreasonableeffortscourthearing into vd_previousbestinterestdt  from tb_foster_care_judicial tcj where tcj.client_id = al_client_id and tcj.removal_id = al_removal_id and tcj.period_type = vd_sqnm_sw;
 END IF;
END IF;


IF (rtrim(vd_removal_type) = 'TLV' and periodtype = 'R1')
THEN
vd_removal_60 = vd_removal_dt + interval '180 days';
ELSE
vd_removal_60 = vd_removal_dt + interval '60 days';
END IF;

if (periodtype = 'I' OR (rtrim(vd_removal_type) = 'TLV' and periodtype in ('R1'))) 
then

select json_agg(x)  into v_ctwjson from 
 (
 select isrco.intakeservreqcourtorderid, isrco.courtorderdate as dateoffindingctwdecision
 FROM  intakeservreqcourtorder isrco join intakeservreqchildremoval isrcr on isrco.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1 
 join intakeservicerequestcourthearing isrch on isrch.intakeservicerequestcourthearingid = isrco.intakeservicerequesthearingid and isrch.activeflag = 1
 join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid
 join person per on per.personid = isra.personid AND per.activeflag = 1
 join intakeservreqcourtorderdetails iscod on iscod.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid
 WHERE  isrco.activeflag = 1 AND isrco.courtorderdate::date between vd_removal_dt::date and vd_removal_60::date
  and isrcr.removalid::BIGINT = al_removal_id AND per.cjamspid::BIGINT = al_client_id
  AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid IN ('838f07f5-0c94-4f13-b5c0-658c4b9ad5bc') and iscod.isselected = 1 and iscod.activeflag = 1) -- Contrary to Welfare
  order by isrco.courtorderdate asc
 )as x; 

select json_agg(x)  into v_reasonableeffortsjson from 
 (
 SELECT isrco.intakeservreqcourtorderid,
 isrco.courtorderdate AS dateofreasonableeffortscourthearing
 FROM  intakeservreqcourtorder isrco join intakeservreqchildremoval isrcr on isrco.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1 
 join intakeservicerequestcourthearing isrch on isrch.intakeservicerequestcourthearingid = isrco.intakeservicerequesthearingid and isrch.activeflag = 1
 join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid
 join person per on per.personid = isra.personid AND per.activeflag = 1 
 join intakeservreqcourtorderdetails iscod on iscod.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid
 WHERE  isrco.activeflag = 1 AND isrco.courtorderdate::date between vd_removal_dt::date and vd_removal_60::date
  and isrcr.removalid::BIGINT = al_removal_id AND per.cjamspid::BIGINT = al_client_id
  AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid IN ('f4365b4c-e0ad-422c-b76e-e6a05ec3320f', 'e4c3f3a6-6756-4123-82a4-f676399e80ce') AND iscod.isselected = 1 and iscod.activeflag = 1) -- Reasonable efforts were made
  order by isrco.courtorderdate asc
)as x;

else

 if(rtrim(vd_removal_type) = 'JD' OR (rtrim(vd_removal_type) = 'TLV' and periodtype not in ('I', 'R1')))
 then 
 if (periodtype = 'R1') then 
 vd_periodenddate_60 = (date_trunc('MONTH', period_end_dt::date) + INTERVAL '3 MONTH - 1 day')::DATE;
  
 select json_agg(x)  into v_jdrefppjson from 
  (
  select isrco.intakeservreqcourtorderid ,isrco.courtorderdate as dateofjudicialfindingofrefpp
  FROM  intakeservreqcourtorder isrco join intakeservreqchildremoval isrcr on isrco.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
  join intakeservicerequestcourthearing isrch on isrch.intakeservicerequestcourthearingid = isrco.intakeservicerequesthearingid and isrch.activeflag = 1 
  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid and isra.activeflag = 1
  join person per on per.personid = isra.personid AND per.activeflag = 1 
  join intakeservreqcourtorderdetails iscod on iscod.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid 
  WHERE  isrco.activeflag = 1 AND isrco.courtorderdate::date between period_start_dt::date and vd_periodenddate_60::date
   AND isrcr.removalid::BIGINT = al_removal_id AND per.cjamspid::BIGINT = al_client_id 
   AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid IN ('34993888-d849-4774-a5c0-6aa25a2b9a42') and iscod.isselected = 1 and iscod.activeflag = 1) -- REFPP
   order by isrco.courtorderdate desc
 )as x;
 ELSEIF vd_previousbestinterestdt is NOT NULL then 
    
 vd_previousfindingdate  = ((vd_previousbestinterestdt::date) + INTERVAL '1 day')::DATE;
 
 select json_agg(x)  into v_jdrefppjson from 
  (
  select isrco.intakeservreqcourtorderid ,isrco.courtorderdate as dateofjudicialfindingofrefpp
  FROM  intakeservreqcourtorder isrco join intakeservreqchildremoval isrcr on isrco.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
  join intakeservicerequestcourthearing isrch on isrch.intakeservicerequestcourthearingid = isrco.intakeservicerequesthearingid and isrch.activeflag = 1 
  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid
  join person per on per.personid = isra.personid AND per.activeflag = 1 
  join intakeservreqcourtorderdetails iscod on iscod.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid 
  WHERE  isrco.activeflag = 1 AND isrco.courtorderdate::date between vd_previousfindingdate::date and period_end_dt::date
   AND isrcr.removalid::BIGINT = al_removal_id AND per.cjamspid::BIGINT = al_client_id 
   AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid IN ('34993888-d849-4774-a5c0-6aa25a2b9a42') and iscod.isselected = 1 and iscod.activeflag = 1) -- REFPP
   order by isrco.courtorderdate desc
 )as x;
 else 
 select json_agg(x)  into v_jdrefppjson from 
  (
  select isrco.intakeservreqcourtorderid ,isrco.courtorderdate as dateofjudicialfindingofrefpp
  FROM  intakeservreqcourtorder isrco join intakeservreqchildremoval isrcr on isrco.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
  join intakeservicerequestcourthearing isrch on isrch.intakeservicerequestcourthearingid = isrco.intakeservicerequesthearingid and isrch.activeflag = 1 
  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid
  join person per on per.personid = isra.personid AND per.activeflag = 1 
  join intakeservreqcourtorderdetails iscod on iscod.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid 
  WHERE  isrco.activeflag = 1 AND isrco.courtorderdate::date between period_start_dt::date and period_end_dt::date
   AND isrcr.removalid::BIGINT = al_removal_id AND per.cjamspid::BIGINT = al_client_id 
   AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid IN ('34993888-d849-4774-a5c0-6aa25a2b9a42') and iscod.isselected = 1 and iscod.activeflag = 1) -- REFPP
   order by isrco.courtorderdate desc
 )as x;
 end if;
 
end if;

 if (rtrim(vd_removal_type) = 'CDVP' OR rtrim(vd_removal_type) = 'EHA')
 then
 select json_agg(x) into v_vpabestinterestjson from 
  ( 
  select isrco.intakeservreqcourtorderid, isrco.courtorderdate as dateofcurrentjudicialfindingofbestinterest
  FROM  intakeservreqcourtorder isrco join intakeservreqchildremoval isrcr on isrco.servicecaseid = isrcr.servicecaseid AND isrcr.activeflag = 1
  join intakeservicerequestcourthearing isrch on isrch.intakeservicerequestcourthearingid = isrco.intakeservicerequesthearingid and isrch.activeflag = 1 
  join intakeservicerequestactor isra on isra.intakeservicerequestactorid = isrco.intakeservicerequestactorid
  join person per on per.personid = isra.personid AND per.activeflag = 1 
  join intakeservreqcourtorderdetails iscod on iscod.intakeservreqcourtorderid = isrco.intakeservreqcourtorderid 
  WHERE  isrco.activeflag = 1 AND isrco.courtorderdate::date between period_start_dt::date and period_end_dt::date
    and isrcr.removalid::BIGINT = al_removal_id AND per.cjamspid::BIGINT = al_client_id 
    AND (iscod.checklisttypekey = 'COLANG' AND iscod.checklistid IN ('54a42db9-aa34-4b79-bd59-33866e519bf1') and iscod.isselected = 1 and iscod.activeflag = 1) -- Best interest
    order by isrco.courtorderdate desc
 )as x;  
  
 end if; 
end if;


INSERT INTO Temp_worksheet_court_info
SELECT 
  al_client_id,
  vn_rmvl_id,
  v_ctwjson,
  v_reasonableeffortsjson,
  v_jdrefppjson,
  v_vpabestinterestjson,
  v_date_agency_lost_legal_responsibility,
  v_clientidofsubjectctwfinding,
     v_nameofsubjectctwfinding,
     v_relationshipofsubjectctwfinding,
     v_isiveagencyresponsibleforplacementandcare,
  v_ctwcourtorderid,
  v_reasonablecourtorderid,
  v_redetcourtorderid,
  v_dateofcourthearing,
  v_magistrateorjudgename,
  v_issignedbyjudge,
  v_ctwdecision,
  v_dateoffindingctwdecision,
  v_dateofnexthearing,
  v_courtorderdelayremoval,
  v_courtorderdelaytimedays,
  v_typeofcourthearing,
  v_reasonableeffortsmade,
  v_dateofreasonableeffortscourthearing,
  v_reasonableeffortsnotnecessaryduetoemergentcircumstances,
  v_dateofjudicialfindingofrefpp,
  v_dateofsubsequentjudicialfindingofrefpp,
  v_dateofpreviousjudicialfindingofrefpp,
  v_fostercarepermanencyplandesc,
  v_dateofcurrentjudicialfindingofbestinterest,
  v_dateofsubsequentfindingofbestinterest,
  v_dateofpreviousbestinterestfinding,
  v_fostercarepermanencyplan;
    
RETURN QUERY SELECT *
               FROM Temp_worksheet_court_info;
              
DROP TABLE Temp_worksheet_court_info;

   END
$function$

