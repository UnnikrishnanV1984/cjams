CREATE OR REPLACE FUNCTION listracetypes(teamtypekey character varying, pagenumber integer, pagesize integer, nolimit boolean DEFAULT false)
 RETURNS TABLE(totalcount bigint, sequencenumber integer, racetypekey character varying, datavalue integer, typedescription character varying)
 LANGUAGE plpgsql
AS $function$

  DECLARE    
        v_teamtypekey character varying;
        v_pageoffset int;
        v_pagenumber int;
  
  
BEGIN
 v_teamtypekey:= teamtypekey;
    v_pagenumber := pagenumber-1;
    v_pageoffset = v_pagenumber * pagesize;
 
 

  IF nolimit = FALSE THEN
  RETURN QUERY
  select count(1) over(), rt.sequencenumber, rt.racetypekey, rt.datavalue, rt.typedescription
   from racetype rt 
  join typesagencymapping tt on tt.objecttypekey = rt.racetypekey
  where rt.activeflag = 1 and tt.activeflag = 1 and tt.teamtypekey = v_teamtypekey and tt.objecttype = 'racetype'
  LIMIT pagesize OFFSET v_pageoffset;
  ELSE
   RETURN QUERY
  select count(1) over(), rt.sequencenumber, rt.racetypekey, rt.datavalue, rt.typedescription
    from racetype rt 
   join typesagencymapping tt on tt.objecttypekey = rt.racetypekey
   where rt.activeflag = 1 and tt.activeflag = 1 and tt.teamtypekey = v_teamtypekey and tt.objecttype = 'racetype';
  END IF;

                          
END;

$function$

