CREATE OR REPLACE FUNCTION getrestitutionwithsearch(teamcounty uuid, i_intakeserviceid uuid, searchjson json, pagenumber bigint, pagesize bigint)
 RETURNS TABLE(totalcount bigint, intakeserreqrestitutionid uuid, restitutionno integer, intakeserviceid uuid, intakenumber character varying, youthpersonid uuid, yothpersonname text, victimpersonid uuid, victimpersonname text, restitutiontype character varying, payment numeric, complaintid character varying, petitionid character varying, restitutionpayments jsonb, liablepersonid uuid, liablepersonname text, relationship character varying, relationshipdescription text, duedate date, courtdeferredduedate date, status character varying, frequency character varying, detailview jsonb, installmentamount numeric, initialpaymentdate date, inactivereasontype character varying, isccu boolean, isccusent boolean, updatedon timestamp without time zone)
 LANGUAGE plpgsql
AS $function$ declare querytxt text;

declare d_teamcounty character varying;

declare d_intakeserviceid character varying;

declare searchyouthlastname character varying;

declare searchyouthfirstname character varying;

declare searchyouthid character varying;

declare searchyouthrelation character varying;

declare searchvictimlastname character varying;

declare searchvictimfirstname character varying;

declare searchvictimid character varying;

declare searchrestitutionid character varying;

declare searchpetitionid character varying;

declare searchcomplaintid character varying;

declare searchpayerfirstname character varying;

declare searchpayerlastname character varying;

declare searchpayeraddress character varying;

declare searchpayercity character varying;

declare searchpayerstatekey character varying;

declare searchpayerzipcode character varying;

declare searchdepositnumber character varying;

declare searchaccountarea character varying;

declare searchpaymentamount character varying;

declare searchpaymentnumber character varying;

declare searchmemofirstname character varying;

declare searchmemolastname character varying;

declare searchstatus character varying;

declare valyouthfirstname character varying;

declare valyouthlastname character varying;

declare valyouthid character varying;

declare valyouthrelation character varying;

declare valvictimfirstname character varying;

declare valvictimlastname character varying;

declare valvictimid character varying;

declare valrestitutionid character varying;

declare valpetitionid character varying;

declare valcomplaintid character varying;

declare valpayerfirstname character varying;

declare valpayerlastname character varying;

declare valpayeraddress character varying;

declare valpayercity character varying;

declare valpayerstatekey character varying;

declare valpayerzipcode character varying;

declare valdepositnumber character varying;

declare valaccountarea character varying;

declare valpaymentamount numeric;

declare valpaymentnumber character varying;

declare valmemofirstname character varying;

declare valmemolastname character varying;

declare valstatus character varying;
begin
valyouthfirstname := searchjson ->> 'youthfirstname';

valyouthlastname := searchjson ->> 'youthlastname';

valyouthid := searchjson ->> 'youthid';

valyouthrelation := searchjson ->> 'youthrelation';

valvictimfirstname := searchjson ->> 'victimfirstname';

valvictimlastname := searchjson ->> 'victimlastname';

valvictimid := searchjson ->> 'victimid';

valrestitutionid := searchjson ->> 'restitutionno';

valcomplaintid := searchjson ->> 'complaintid';

valpetitionid := searchjson ->> 'petitionid';

valpayerfirstname := searchjson ->> 'payerfirstname';

valpayerlastname := searchjson ->> 'payerlastname';

valpayeraddress := searchjson ->> 'payeraddress';

valpayercity := searchjson ->> 'payercity';

valpayerstatekey := searchjson ->> 'payerstatekey';

valpayerzipcode := searchjson ->> 'payerzipcode';

valdepositnumber := searchjson ->> 'depositnumber';

valaccountarea := searchjson ->> 'accountarea';

valpaymentamount := searchjson ->> 'paymentamount';

valpaymentnumber := searchjson ->> 'paymentnumber';

valmemofirstname := searchjson ->> 'memofirstname';

valmemolastname := searchjson ->> 'memolastname';

valstatus := searchjson ->> 'status';
--search by status like active inactive and closed
 if(valstatus :: character varying != ''
and valstatus is not null) then searchstatus := ' AND inr.status =  ''' || valstatus || '''';
else searchstatus := '';
end if;

raise notice 'pay ment  %',
searchstatus ;
--search by payment starts
 if(teamcounty :: character varying != ''
and teamcounty is not null) then d_teamcounty := ' AND inr.countyid =  ''' || teamcounty || '''';
else d_teamcounty := '';
end if;

if(I_intakeserviceid :: character varying != ''
and I_intakeserviceid is not null) then d_intakeserviceid := ' AND inr.intakeserviceid =  ''' || I_intakeserviceid || '''';
else d_intakeserviceid := '';
end if;

if((searchjson ->> 'payerfirstname') != ''
and (searchjson ->> 'payerfirstname') is not null) then searchpayerfirstname := ' AND inrp.payerfirstname ilike  ''' || valpayerfirstname || '%''';
else searchpayerfirstname := '';
end if;

if((searchjson ->> 'payerlastname') != ''
and (searchjson ->> 'payerlastname') is not null) then searchpayerlastname := ' AND inrp.payerlastname ilike  ''' || valpayerlastname || '%''';
else searchpayerlastname := '';
end if;

if((searchjson ->> 'payeraddress') != ''
and (searchjson ->> 'payeraddress') is not null) then searchpayeraddress := ' AND inrp.payeraddress  ilike  ''' || valpayeraddress || '%''';
else searchpayeraddress := '';
end if;

if((searchjson ->> 'payercity') != ''
and (searchjson ->> 'payercity') is not null) then searchpayercity := ' AND inrp.payercity ilike  ''' || valpayercity || '%''';
else searchpayercity := '';
end if;

if((searchjson ->> 'payerstatekey') != ''
and (searchjson ->> 'payerstatekey') is not null) then searchpayerstatekey := ' AND inrp.payerstatekey ilike  ''' || valpayerstatekey || '%''';
else searchpayerstatekey := '';
end if;

if((searchjson ->> 'payerzipcode') != ''
and (searchjson ->> 'payerzipcode') is not null) then searchpayerzipcode := ' AND inrp.payerzipcode ilike  ''' || valpayerzipcode || '%''';
else searchpayerzipcode := '';
end if;

if((searchjson ->> 'depositnumber') != ''
and (searchjson ->> 'depositnumber') is not null) then searchdepositnumber := ' AND inrp.depositnumber ilike  ''' || valdepositnumber || '%''';
else searchdepositnumber := '';
end if;

if((searchjson ->> 'accountarea') != ''
and (searchjson ->> 'accountarea') is not null) then searchaccountarea := ' AND inrp.accountarea ilike  ''' || valaccountarea || '%''';
else searchaccountarea := '';
end if;

if(valpaymentamount is not null) then searchpaymentamount := ' AND inr.payment =  ' || valpaymentamount || '';
else searchpaymentamount := '';
end if;

if((searchjson ->> 'paymentnumber') != ''
and (searchjson ->> 'paymentnumber') is not null) then searchpaymentnumber := ' AND inrp.paymentnumber ilike  ''' || valpaymentnumber || '%''';
else searchpaymentnumber := '';
end if;

if((searchjson ->> 'memofirstname') != ''
and (searchjson ->> 'memofirstname') is not null) then searchmemofirstname := ' AND inrp.memofirstname ilike  ''' || valmemolastname || '%''';
else searchmemofirstname := '';
end if;

if((searchjson ->> 'memolastname') != ''
and (searchjson ->> 'memolastname') is not null) then searchmemolastname := ' AND inrp.memolastname ilike  ''' || valmemolastname || '%''';
else searchmemolastname := '';
end if;
--payment ends
--search by youth
 if((searchjson ->> 'youthfirstname') != ''
and (searchjson ->> 'youthfirstname') is not null) then searchyouthfirstname := ' AND yp.firstname ilike  ''' || valyouthfirstname || '%''';
else searchyouthfirstname := '';
end if;

if((searchjson ->> 'youthlastname') != ''
and (searchjson ->> 'youthlastname') is not null) then searchyouthlastname := ' AND yp.lastname ilike  ''' || valyouthlastname || '%''';
else searchyouthlastname := '';
end if;

if((searchjson ->> 'youthid') != ''
and (searchjson ->> 'youthid') is not null) then searchyouthid := ' AND yp.cjamspid :: character varying ilike  ''' || valyouthid || '%''';
else searchyouthid := '';
end if;

if((searchjson ->> 'youthrelation') != ''
and (searchjson ->> 'youthrelation') is not null) then searchyouthrelation := ' AND inr.liablepersonrelationtypekey =  ''' || valyouthrelation || '''';
else searchyouthrelation := '';
end if;
--ends youth
--search by victim 
 if((searchjson ->> 'victimfirstname') != ''
and (searchjson ->> 'victimfirstname') is not null) then searchvictimfirstname := ' AND vp.firstname ilike  ''' || valvictimfirstname || '%''';
else searchvictimfirstname := '';
end if;

if((searchjson ->> 'victimlastname') != ''
and (searchjson ->> 'victimlastname') is not null) then searchvictimlastname := ' AND vp.lastname ilike  ''' || valvictimlastname || '%''';
else searchvictimlastname := '';
end if;

if((searchjson ->> 'victimid') != ''
and (searchjson ->> 'victimid') is not null) then searchvictimid := ' AND vp.cjamspid :: character varying ilike  ''' || valvictimid || '%''';
else searchvictimid := '';
end if;
--ends victim
--search by restitutionno
 if((searchjson ->> 'restitutionno') != ''
and (searchjson ->> 'restitutionno') is not null) then searchrestitutionid := ' AND inr.restitutionno :: character varying ilike  ''' || valrestitutionid || '%''';
else searchrestitutionid := '';
end if;
--search by complaint 
 if((searchjson ->> 'complaintid') != ''
and (searchjson ->> 'complaintid') is not null) then searchcomplaintid := ' AND ine.complaintid :: character varying ilike  ''' || valcomplaintid || '%''';
else searchcomplaintid := '';
end if;
--search by petition
 if((searchjson ->> 'petitionid') != ''
and (searchjson ->> 'petitionid') is not null) then searchpetitionid := ' AND inp.petitionid :: character varying ilike  ''' || valpetitionid || '%''';
else searchpetitionid := '';
end if;
--return restitution based on above all filters
 querytxt = '

 select count(1) over() totalcount, * from (
select distinct inr.intakeserreqrestitutionid, inr.restitutionno ,
 inr.intakeserviceid , inr.intakenumber , inr.youthpersonid ,yp.lastname || '', '' || yp.firstname as  yothpersonname  
,inr.victimpersonid ,vp.lastname || '', '' || vp.firstname as  victimpersonname ,
inr.restitutiontype ,
inr.payment, 
--((coalesce(inr.payment, 0)) - coalesce(inr.paidamount, 0)) + (coalesce(inr.additionalamount, 0)) - (coalesce(inr.waivedamount, 0)) as payment, -- commnent 13/03/2019
ine.complaintid,inp.petitionid,

/*inrp.accountarea,inrp.depositnumber,inrp.memofirstname,inrp.memolastname
,inrp.payeraddress,inrp.paymentamount,inrp.paymentnumber,inrp.payercity,inrp.payerfirstname,inrp.payerlastname,inrp.payerstatekey,
inrp.payerzipcode,inrp.intakeserreqrestitutionpaymentid*/

( select json_agg(v) from (
select inrpin.accountarea,inrpin.depositnumber,inrpin.memofirstname
,inrpin.memolastname,inrpin.payeraddress,inrpin.paymentamount,inrpin.paymentnumber,inrpin.payercity
,inrpin.payerfirstname,inrpin.payerlastname,inrpin.payerstatekey,
inrpin.payerzipcode,inrpin.intakeserreqrestitutionpaymentid from intakeserreqrestitutionpayment inrpin
where inrpin.intakeserreqrestitutionid = inrp.intakeserreqrestitutionid
' || replace(searchpayerfirstname, 'inrp.', 'inrpin.')|| '
' || replace(searchpayerlastname, 'inrp.', 'inrpin.')|| '
' || replace(searchpayeraddress, 'inrp.', 'inrpin.')|| '
' || replace(searchpayercity, 'inrp.', 'inrpin.')|| '
' || replace(searchpayerstatekey, 'inrp.', 'inrpin.')|| '
' || replace(searchpayerzipcode, 'inrp.', 'inrpin.')|| '
' || replace(searchdepositnumber, 'inrp.', 'inrpin.')|| '
' || replace(searchaccountarea, 'inrp.', 'inrpin.')|| '
' || replace(searchpaymentnumber, 'inrp.', 'inrpin.')|| '
' || replace(searchmemofirstname, 'inrp.', 'inrpin.')|| '
' || replace(searchmemolastname, 'inrp.', 'inrpin.')|| '
) as v)::jsonb  AS  restitutionpayments

,inr.liablepersonid ,lp.lastname || '' '' || lp.firstname as  liablepersonname 
,inr.liablepersonrelationtypekey as relationship,rst.description as relationshipdescription 
,inr.duedate,inr.courtdeferredduedate,inr.status,inr.frequency,

case
when inr.restitutiontype=''court'' then (select row_to_json(x) from (select (select string_agg(CAT.description,'','') as courtActions from intakeservicerequestcourtactiontype INTSRCAT
join courtactiontype CAT on CAT.courtactiontypekey=INTSRCAT.courtactiontypekey and INTSRCAT.activeflag=1
where INTSRCAT.intakeservicerequestcourtactionid=inca.intakeservicerequestcourtactionid  and INTSRCAT.activeflag=1) as courtaction,
(select string_agg(ine.complaintid,'','') from intakeservicerequestevaluation ine where ine.intakenumber= inr.intakenumber) as complaintid,
(select string_agg(es.description,'','') from intakeservicerequestevaluation ine join evaluationsourceagency es on es.evaluationsourceagencyid =ine.evaluationsourceagencyid where ine.intakenumber= inr.intakenumber limit 1) as jurisdiction,
(select string_agg(inp.petitionid,'','') from intakeservicerequestpetition inp where inp.intakenumber= inrr.intakenumber) as petitionid
,up.fullname as createdby,inrr.insertedon as createdon,inca.courtorderdatetime
from intakeservicerequestcourtaction inca
   left join intakeservicerequestcourthearing inch on inch.intakeservicerequestcourthearingid=inca.intakeservicerequestcourthearingid and inch.activeflag=1 
    
 left join intakeserreqrestitution inrr on inrr.intakenumber=inca.intakenumber
 left join userprofile up on up.securityusersid=inrr.insertedby
 where inrr.intakeserreqrestitutionid=inr.intakeserreqrestitutionid and inch.hearingtypekey=''Resti'' limit 1)as x)::jsonb -- end as intakedetailview
 
 else  (select row_to_json(x) from (select inr.duedate,up.fullname as createdby,inrr.insertedon as createdon,
(select string_agg(ine.complaintid,'','') from intakeservicerequestevaluation ine where ine.intakenumber= inr.intakenumber) as complaintid,
(select string_agg(es.description,'','') from intakeservicerequestevaluation ine join evaluationsourceagency es on es.evaluationsourceagencyid =ine.evaluationsourceagencyid where ine.intakenumber= inr.intakenumber limit 1) as jurisdiction
from intakeserreqrestitution inrr 
join userprofile up on up.securityusersid=inrr.insertedby where inrr.intakeserreqrestitutionid=inr.intakeserreqrestitutionid limit 1) as x)::jsonb  end as intakedetailview
,inr.installmentamount ,inr.paymentstartdate as initialpaymentdate,inr.inactivereasontype,inr.isccu, inr.isccusent, inr.updatedon
from
(select restitutionno, max(insertedon) insertedon from intakeserreqrestitution where activeflag = 1 and approvestatus = ''RSTAPR'' group by restitutionno) res
JOin intakeserreqrestitution as inr 
     on inr.restitutionno = res.restitutionno and inr.insertedon = res.insertedon
--from intakeserreqrestitution inr 
left join intakeserreqrestitutionpayment inrp on inrp.intakeserreqrestitutionid=inr.intakeserreqrestitutionid and inrp.activeflag=1
 join person yp on yp.personid=inr.youthpersonid 
 join person vp on vp.personid=inr.victimpersonid
left join person lp on lp.personid=inr.liablepersonid
 join intakeservicerequestevaluation ine on ine.intakenumber=inr.intakenumber and ine.activeflag=1
left join intakeservreqevalpetitionconfig inep on inep.intakeservicerequestevaluationid=ine.intakeservicerequestevaluationid and inep.activeflag=1
left join intakeservicerequestpetition inp on inp.intakeservicerequestpetitionid=inep.intakeservicerequestpetitionid 
left join relationshiptype rst on rst.relationshiptypekey =inr.liablepersonrelationtypekey
 where 1=1 ' || d_teamcounty || '' || d_intakeserviceid || '' || searchyouthfirstname || '' || searchyouthlastname || '' || searchyouthid || '
' || searchvictimfirstname || '' || searchvictimlastname || '' || searchvictimid || '' || searchrestitutionid || '' || searchcomplaintid || '' || searchpetitionid || '
' || searchmemolastname || '' || searchmemofirstname || '' || searchyouthrelation || '
' || searchpaymentnumber || '' || searchaccountarea || '' || searchdepositnumber || '
' || searchpayerzipcode || '' || searchpayerstatekey || '' || searchpayercity || '' || searchpayeraddress || '' || searchpayerlastname || '' || searchpayerfirstname || '' || searchpaymentamount || '' || searchstatus || ' 
) a order by a.updatedon desc -- inr.insertedon 
limit  ' || pagesize || '  offset ' || pagenumber;

raise notice 'Parsing %',
querytxt ;

return query execute querytxt;
end;

