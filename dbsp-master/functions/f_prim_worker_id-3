CREATE OR REPLACE FUNCTION f_prim_worker_id(ai_entity_id character varying, ai_entity_cd character varying)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$

DECLARE 

ai_entity1_id VARCHAR;
ai_entity2_id VARCHAR;
ai_entity3_id VARCHAR;
ai_case_id uuid;
BEGIN 

ai_entity1_id:= (select servicecasenumber from servicecase where servicecasenumber = ai_entity_id::VARCHAR); --
ai_entity2_id:= (select adoptioncasenumber from adoptioncase where adoptioncasenumber = ai_entity_id::VARCHAR); --
ai_entity2_id:= (select servicerequestnumber from intakeservicerequest where servicerequestnumber = ai_entity_id::VARCHAR); --

IF (ai_entity_id::VARCHAR =ai_entity1_id ) THEN
ai_case_id:= (SELECT servicecaseid from servicecase where servicecasenumber = ai_entity_id::VARCHAR); --
ELSIF (ai_entity_id ::VARCHAR = ai_entity2_id) THEN 
     ai_case_id:= (SELECT adoptioncaseid from adoptioncase where adoptioncasenumber = ai_entity_id::VARCHAR); --
ELSIF (ai_entity_id ::VARCHAR = ai_entity3_id) THEN  
 ai_case_id:= (SELECT intakeserviceid from intakeservicerequest where servicerequestnumber = ai_entity_id::VARCHAR); --  
 END IF; --
 
 If ai_entity_cd ='NULL' then

ai_entity_cd := (select objecttypekey from caseassignment where objectid = ai_case_id);
 
 end if ;
/* if ai_entity_cd='NULL' then
                              
 ai_case_cd = (select casetypekey from case where old_id=ai_entity_id);

 if ai_case_cd='3333' then
     ai_entity1_cd='5590';
 else
     ai_entity1_cd='2952'; 
 end if;        
else
  ai_entity1_cd= ai_entity_cd; 
end if; */

return
(select distinct staff_id from (
select row_number() over() as num, staff_id, assignment_id from
   (SELECT  muser.id as staff_id, caseassignment.old_id as assignment_id
    FROM  caseassignment, muser  
     WHERE   
  ( caseassignment.objectid = ai_case_id) and
  ( caseassignment.objecttypekey = lower(ai_entity_cd)) and
 --    ( caseassignment.responsibilitytypekey = 'child') and 
  ( muser.securityusersid = caseassignment.toworkeridno) and 
  ( caseassignment.activeflag = 1) and
  ( muser.activeflag = 1) 
   order by caseassignment.updatedon desc) te ) ryt where num=1);

END;

$function$

