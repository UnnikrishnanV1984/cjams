CREATE OR REPLACE FUNCTION f_prim_county(ai_entity_id integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare ai_entity_cd varchar(5);
    declare ai_case_cd varchar(5);
BEGIN

    select case_type_cd 
      into ai_case_cd   
      from tb_case 
     where case_id = ai_entity_id;

    if ai_case_cd='3333' then
        ai_entity_cd='5590';
    else
        ai_entity_cd='2952';
    end if;

    return (select from_county_cd 
              from (select row_number() over() as num
                         , from_county_cd
                         , assignment_id 
                      from (SELECT from_county_cd
                                 , assignment_id
                              FROM TB_ASSIGNMENT
                             WHERE ENTITY_TYPE_CD    = Ai_ENTITY_CD
                               AND ENTITY_KEY_ID     = AI_ENTITY_ID 
                               AND RESPONSIBILITY_CD = 'P'
                               AND DELETE_SW         = 'N' 
                             ORDER BY assignment_id desc
                           ) as te 
                   ) as rty where num=1
           );
END;

$function$

