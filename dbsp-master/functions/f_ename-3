CREATE OR REPLACE FUNCTION f_ename(vartabname character varying, varkey_id bigint)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$

DECLARE
 declare outtx varchar(200);
BEGIN 

IF length(ltrim(rtrim(vartabname))) > 0 AND vartabname IS NOT NULL THEN

 SELECT sp_ename(vartabname,varkey_id) INTO outtx;
 RETURN outtx;
ELSE
 return (1);
END IF;
END;
 

$function$

