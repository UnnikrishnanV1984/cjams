CREATE OR REPLACE FUNCTION update_payment_check(v_securityuserid character varying, v_objectid integer, v_notes character varying, v_key character varying)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$\r
------------------------------------------------------------------------\r
-- Revision(s)\r
-- 01/29/2021 Vineet Tirodkar \r
-- Modification to update all tables/audit columns (CDM-9278)\r
------------------------------------------------------------------------ \r
                               \r
Begin\r
\r
update tb_payment_header \r
 set check_status_cd = v_key,\r
  check_status_dt = now()::date,\r
  notes_tx = v_notes,\r
  update_ts = now(),\r
  update_user_id = v_securityuserid\r
where payment_id = v_objectid;\r
\r
if(v_key in ('4849','581','4850'))\r
then\r
 update tb_provider \r
  set withhold_payment_sw = 'Y',\r
   update_ts = now(),\r
   update_user_id = v_securityuserid\r
 where provider_id = (select provider_id from tb_payment_header where payment_id = v_objectid) ;\r
end if;\r
\r
update tb_payment_history \r
 set delete_sw = 'Y',\r
  update_ts = now(),\r
  update_user_id = v_securityuserid\r
where payment_id = v_objectid \r
 and delete_sw = 'N';\r
\r
 \r
INSERT INTO tb_payment_history\r
( payment_id, object_id, object_key, create_ts, create_user_id, update_ts, update_user_id, delete_sw )\r
VALUES\r
( v_objectid, v_key, 'check', now(), v_securityuserid, now(), v_securityuserid,  'N' );\r
\r
RETURN  'Success';\r
\r
END;\r
 \r
$function$

