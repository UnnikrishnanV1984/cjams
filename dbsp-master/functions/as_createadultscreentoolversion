CREATE OR REPLACE FUNCTION as_createadultscreentoolversion(j_adultscreentoolobj json, intakeserviceid uuid, securityuserid character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$

DECLARE

   
   v_intakeserviceid uuid; 
      v_securityuserid character varying(50);
   v_adultscreentooljsondata json;
   v_adultscreentoolholdObj json;
      v_intakeservreqadultscreentoolid character varying(50);
   i json; 
   s_adultscreenholdOBJ json;
      result character varying(50);
     v_isdraft int ;
     v_isupdate bool;
     v_responseserviceid uuid;
   v_allegedmaltreatmentflag boolean default true;
   v_unknownpersonid uuid;
   v_actorid uuid;
   v_selfneglect character varying(10);
   v_unknownmal boolean default false;
  

begin
 
      
   v_unknownpersonid := '00000000-0000-0000-0000-000000000000';  
   v_selfneglect := j_adultscreentoolObj->> 'selfneglectclient';
      v_intakeserviceid=intakeserviceid;
      v_securityuserid=securityuserid;
   v_adultscreentooljsondata := j_adultscreentoolObj;
  
  
  v_isdraft := j_adultscreentoolObj->>'isdraft';
  v_isupdate := j_adultscreentoolObj->>'isUpdate';

    v_intakeservreqadultscreentoolid := j_adultscreentoolObj->>'intakeservreqadultscreentoolid';
 IF (trim(j_adultscreentoolObj->> 'unknow')='') THEN v_unknownmal := FALSE;
 ELSIF (trim(j_adultscreentoolObj->> 'unknow')::bool IS TRUE) THEN v_unknownmal := TRUE;
 END IF;
IF v_isupdate is true THEN   
 update intakeservreqadultscreentool
 set allegations  = CAST(j_adultscreentoolObj->>'allegations' as jsonb)
 where intakeservreqadultscreentoolid in (select isract.intakeservreqadultscreentoolid from intakeservreqadultscreentool isract
 where isract.intakeserviceid = v_intakeserviceid order by insertedon desc limit 1)
  RETURNING "intakeservreqadultscreentoolid" into v_intakeservreqadultscreentoolid;
 
 Return v_intakeservreqadultscreentoolid;
ELSE 
 if ( v_intakeservreqadultscreentoolid is not null ) then
 
 update intakeservreqadultscreentool set activeflag=0 where intakeservreqadultscreentoolid=v_intakeservreqadultscreentoolid::uuid;
 
 end if;
 
  
  
 if(v_adultscreentooljsondata is not null) then
 
  
  INSERT INTO intakeservreqadultscreentool
(
  intakeserviceid,astdate,intakeworker,countyid, referralname, referralphone, referraladdress1,
  referraladdress2, referralremainanonymous, referralrelationship, clientinfoname, 
  clientinfodob,clientinfoage, gendertypekey, racetypekey, 
  ethnicitytypekey, clientinfoaddress1, clientinfoaddress2,
  clientinfophone, maritalstatuskey, monthlyincome, monthlyincomesource, totalassets, 
  totalassetssource, additionalinfo, riskaggrpets, riskhomehazards, riskfireharms, riskpsychiatric,
  riskcdsabuse, riskmedical, riskdomviolence, riskother, riskcomments, detailsofreferralcomments,phyabuse,
 financialexploitation,neglectedbyothers,selfneglect,sexualabuse,
  healthcarekey, transportationkey, cluttertypekey, foodtypekey, housingtypekey,
  supervisiontypekey, individualvulnerable, eatingfeedingkey, takingmedicationkey,
  walkingkey, bathingkey, dressingkey, toiletkey, physicalrisksnotes, dementiakey, thoughtdisorderskey, 
  substanceabusekey, mooddisorderskey, behavioralissueskey, mentalchallengesnotes, supportnetworkkey,
  supportnetworknotes, riskscore, risklevel, intakerecommendation, 
  updatedby,insertedby,isdraft
)

values
(
    v_intakeserviceid::uuid,
    (v_adultscreentooljsondata->> 'astdate')::date,
    v_adultscreentooljsondata->> 'intakeworker',
    (v_adultscreentooljsondata->> 'countyid')::uuid,
    v_adultscreentooljsondata->> 'referralname',
    v_adultscreentooljsondata->> 'referralphone',
    v_adultscreentooljsondata->> 'referraladdress1',
    v_adultscreentooljsondata->> 'referraladdress2',
    v_adultscreentooljsondata->> 'referralremainanonymous',
    v_adultscreentooljsondata->> 'referralrelationship',
    v_adultscreentooljsondata->> 'clientinfoname',
    (v_adultscreentooljsondata->> 'clientinfodob')::date,
    v_adultscreentooljsondata->> 'clientinfoage',
    v_adultscreentooljsondata->> 'gendertypekey',
    v_adultscreentooljsondata->> 'racetypekey',
    v_adultscreentooljsondata->> 'ethnicitytypekey',
    v_adultscreentooljsondata->> 'clientinfoaddress1',
    v_adultscreentooljsondata->> 'clientinfoaddress2',
    v_adultscreentooljsondata->> 'clientinfophone',
    v_adultscreentooljsondata->> 'maritalstatuskey',
    v_adultscreentooljsondata->> 'monthlyincome',
    v_adultscreentooljsondata->> 'monthlyincomesource',
    v_adultscreentooljsondata->> 'totalassets',
    v_adultscreentooljsondata->> 'totalassetssource',
    v_adultscreentooljsondata->> 'additionalinfo',
    v_adultscreentooljsondata->> 'riskaggrpets',
    v_adultscreentooljsondata->> 'riskhomehazards',
    v_adultscreentooljsondata->> 'riskfireharms',
    v_adultscreentooljsondata->> 'riskpsychiatric',
    v_adultscreentooljsondata->> 'riskcdsabuse',
    v_adultscreentooljsondata->> 'riskmedical',
    v_adultscreentooljsondata->> 'riskdomviolence',
    v_adultscreentooljsondata->> 'riskother',
    v_adultscreentooljsondata->> 'riskcomments',
    v_adultscreentooljsondata->> 'detailsofreferralcomments',
    v_adultscreentooljsondata->> 'phyAbuseSelect',
    v_adultscreentooljsondata->> 'financialexploitationSelect',
    v_adultscreentooljsondata->> 'neglectedByOthersSelect',
    v_adultscreentooljsondata->> 'selfNeglectSelect',
    v_adultscreentooljsondata->> 'sexualAbuseExploitationSelect',
    v_adultscreentooljsondata->> 'healthcarekey',
    v_adultscreentooljsondata->> 'transportationkey',
    v_adultscreentooljsondata->> 'cluttertypekey',
    v_adultscreentooljsondata->> 'foodtypekey',
    v_adultscreentooljsondata->> 'housingtypekey',
    v_adultscreentooljsondata->> 'supervisiontypekey',
    v_adultscreentooljsondata->> 'individualvulnerable',
    v_adultscreentooljsondata->> 'eatingfeedingkey',
    v_adultscreentooljsondata->> 'takingmedicationkey',
    v_adultscreentooljsondata->> 'walkingkey',
    v_adultscreentooljsondata->> 'bathingkey',
    v_adultscreentooljsondata->> 'dressingkey',
    v_adultscreentooljsondata->> 'toiletkey',
    v_adultscreentooljsondata->> 'physicalrisksnotes',
    v_adultscreentooljsondata->> 'dementiakey',
    v_adultscreentooljsondata->> 'thoughtdisorderskey',
    v_adultscreentooljsondata->> 'substanceabusekey',
    v_adultscreentooljsondata->> 'mooddisorderskey',
    v_adultscreentooljsondata->> 'behavioralissueskey',
    v_adultscreentooljsondata->> 'mentalchallengesnotes',
    v_adultscreentooljsondata->> 'supportnetworkkey',
    v_adultscreentooljsondata->> 'supportnetworknotes',
    v_adultscreentooljsondata->> 'riskscore',
    v_adultscreentooljsondata->> 'risklevel',
    v_adultscreentooljsondata->> 'intakerecommendation',
    v_securityuserid,v_securityuserid,
    (v_adultscreentooljsondata->> 'isdraft')::int
 )
 
       RETURNING "intakeservreqadultscreentoolid" into v_intakeservreqadultscreentoolid;
      
         if (v_adultscreentooljsondata->> 'responseserviceid' != '') then            
       v_responseserviceid := (v_adultscreentooljsondata->> 'responseserviceid')::uuid; 
   else 
    v_responseserviceid := null;
   end if;
     
  
   INSERT INTO adultscreentoolconfig
   (intakeservreqadultscreentoolid, responseserviceid, locationofmaltreatment, selfneglectclient,
   responsecomments, insertedby)
   VALUES(
   v_intakeservreqadultscreentoolid::uuid,
   v_responseserviceid,
   v_adultscreentooljsondata->> 'locationofmaltreatment',
   v_adultscreentooljsondata->> 'selfneglectclient',
   v_adultscreentooljsondata->> 'responsecomments',   
   v_securityuserid
   
  );

  
 FOR i IN SELECT * FROM json_array_elements
 
 ((j_adultscreentoolObj->'adultScreenTool'->>'adultscreentoolhouseholdconfig')::json)
 
   loop 
  
    INSERT INTO intakeservreqadultscreentoolhouseholdconfig
    ( intakeservreqadultscreentoolid, "name", relationship, phoneno,updatedby,insertedby)
    
    SELECT v_intakeservreqadultscreentoolid::uuid, i->>'name',
    
    i->>'relationship',i->>'phone' , v_securityuserid,v_securityuserid;

   End LOOP;
  
   
 FOR i IN SELECT * FROM json_array_elements
 
 ((j_adultscreentoolObj->'adultScreenTool'->>'adultscreentoolvictimconfig')::json)
 
   loop 
  
    INSERT INTO adultscreentoolvictimconfig
   ( intakeservreqadultscreentoolid, allegedvictimid, allegedmaltreaterid,unknowns,insertedby )
    
    SELECT v_intakeservreqadultscreentoolid::uuid, (i->>'allegedvictimid')::uuid,
    
    (i->>'allegedmaltreaterid')::uuid,(i->>'unknowns')::bool , v_securityuserid;

   IF (i->>'allegedmaltreaterid' IS NOT NULL) then
     v_allegedmaltreatmentflag = false;
   END IF;

   End LOOP;
  
   FOR i IN SELECT * FROM json_array_elements
 
 ((j_adultscreentoolObj->'adultScreenTool'->>'adultscreentoolallegationconfig')::json)
 
   loop 
  
    INSERT INTO adultscreentoolallegationconfig
   ( intakeservreqadultscreentoolid, allegationid, allegationtypekey,  insertedby)
    
    SELECT v_intakeservreqadultscreentoolid::uuid, (i->>'allegationid')::uuid,
    
    i->>'allegationtypekey',v_securityuserid;

   End LOOP;
 
 IF (v_unknownmal and v_selfneglect = 'N') then
  IF (SELECT count(*) = 0 FROM actor act1 WHERE act1.personid = v_unknownpersonid AND act1.intakeserviceid = v_intakeserviceid AND act1.activeflag  = 1) THEN 
   v_actorid := gen_random_uuid();
   INSERT INTO actor
   (actorid, activeflag, personid, actortype,insertedby, insertedon, updatedby, updatedon, "timestamp", medicaideligibility, blockgranteligibility, recipientstatus, manualupdateflag, intakeserviceid, ishouseholdmember, objectid, objecttype)
   values (
   v_actorid, 1, v_unknownpersonid, 'AM', v_securityuserid, now(), v_securityuserid, now(),null, true, true, true,
   'N'::bpchar, v_intakeserviceid, 1, v_intakeserviceid::character varying(50), 'as_intakeserviceid');

   INSERT INTO intakeservicerequestactor
   (intakeservicerequestactorid, actorid, intakeservicerequestpersontypekey, rapersontypekey, insertedby, insertedon, updatedby, updatedon, expirationdate, "timestamp", intakeserviceid, activeflag, reported, isprimary, personid, objectid, objecttype)
   VALUES(gen_random_uuid(), v_actorid, 'AM', NULL, v_securityuserid, now(), v_securityuserid, now(), NULL, NULL, v_intakeserviceid, 1, false, true, v_unknownpersonid, v_intakeserviceid::character varying(50), 'as_intakeserviceid');
   END IF;
 End IF;
 
 result =v_intakeservreqadultscreentoolid;
 Return v_intakeservreqadultscreentoolid;
 
 end if;
 
 return 'fail';
END IF;
END;

$function$

