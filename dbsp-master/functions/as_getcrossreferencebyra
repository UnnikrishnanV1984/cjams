CREATE OR REPLACE FUNCTION as_getcrossreferencebyra(p_intakeserviceid uuid, p_role character varying, pagesize bigint, pagenumber bigint)
 RETURNS TABLE(totalcount bigint, intakeserviceid uuid, servicerequestnumber character varying, description character varying, insertedby character varying, datereceived timestamp without time zone, srtype character varying, srsubtype character varying, srstatus character varying, raname text, dueddate timestamp without time zone, pastdue text)
 LANGUAGE plpgsql
AS $function$                            
   
DECLARE 
v_personid uuid;


 BEGIN
 
  select P.personid into v_personid from intakeservicerequest ISR
 join intakeservicerequestactor ISRA on ISRA.intakeserviceid=ISR.intakeserviceid and ISRA.activeflag=1
 join actor AC on AC.actorid=ISRA.actorid and AC.actortype=p_role and AC.activeflag=1
 join Person P on p.personid=AC.personid and P.activeflag=1
 
 where ISR.intakeserviceid=p_intakeserviceid;


  RETURN QUERY   
  SELECT COUNT(1) OVER() totalCOUNT,ISR.IntakeServiceId as intakeserviceid,  
         ISR.ServiceRequestNumber as servicerequestnumber,  
         ISR.Description  as description,  
         ISR.insertedby as insertedby ,  
         ISR.insertedon as datereceived,  
         ISRT.IntakeServReqTypeKey  AS srtype,  
         SUB.ClassKey AS srsubtype,  
         ISST.intakeserreqstatustypekey as srstatus,
         (SELECT TRIM(PR.FirstName) || ' ' || TRIM(PR.LastName)   
            FROM IntakeServiceRequestActor INSRA1   
                JOIN Actor AC ON AC.ActorId  = INSRA1.ActorId AND TRIM(AC.ActorType) = p_role  
                JOIN Person PR ON PR.PersonId = AC.PersonId   
            WHERE  INSRA1.IntakeServiceId = ISR.IntakeServiceId Limit 1) AS raname,  
         --(SELECT PRA.county   
           -- FROM IntakeServiceRequestActor INSRA1   
             --   JOIN Actor AC ON AC.ActorId  = INSRA1.ActorId AND TRIM(AC.ActorType) = p_role  
               -- JOIN PersonAddress  PRA ON PRA.PersonAddressId = CAST(INSRA1.GuardianName as uuid)    
            --WHERE  INSRA1.IntakeServiceId = ISR.IntakeServiceId limit 1 
         --) AS county,  
         ISR.TargetCompleteDate  AS dueDdate,  
         CASE WHEN ISR.TargetCompleteDate <= NOW()  THEN 'false' ELSE 'true' END AS pastdue            
  FROM IntakeServiceRequest ISR  
      JOIN  IntakeSerReqStatusType ISST ON ISR.IntakeSerReqStatusTypeId   = ISST.IntakeSerReqStatusTypeId  
      JOIN IntakeServiceRequestInputType ISRIT ON ISRIT.IntakeServReqInputTypeId = ISR.IntakeServReqInputTypeId   
      JOIN IntakeServiceRequestType ISRT ON ISRT.IntakeServReqTypeId = ISR.IntakeServReqTypeId          
      JOIN ServiceRequestSubType SUB ON SUB.ServiceRequestSubTypeId = ISR.IntakeServiceRequestClassId   
      JOIN  IntakeServiceRequestActor ISRA ON ISRA.IntakeServiceId = ISR.IntakeServiceId   
    join actor ac on ac.actorid=ISRA.actorid and ac.activeflag=1 and AC.actortype=p_role
     join Person P  on p.personid=ac.personid and P.activeflag=1
  WHERE P.personid=v_personid 
  AND ISR.IntakeServiceId <> p_intakeserviceid
 limit pagenumber offset pagesize;
        
END;
$function$

