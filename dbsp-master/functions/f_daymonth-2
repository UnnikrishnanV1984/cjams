CREATE OR REPLACE FUNCTION f_daymonth(var_dt timestamp without time zone, as_day_sw character varying)
 RETURNS timestamp without time zone
 LANGUAGE plpgsql
AS $function$

DECLARE
    declare var_year integer;
 declare var_month integer;
BEGIN 
SELECT date_part('YEAR', var_dt) INTO var_year;
SELECT date_part('MONTH', var_dt) INTO var_month;
 IF UPPER(AS_DAY_SW) = 'L' THEN
  IF var_month IN (1,2,3) THEN
   return date( var_year || '-01'  || '-01') - INTERVAL '1 DAY' ;
  ELSEIF var_month IN (4,5,6) THEN
   return date( var_year || '-04'  || '-01') - INTERVAL '1 DAY'  ;
  ELSEIF var_month IN (7,8,9) THEN
   return date( var_year || '-07'  || '-01') - INTERVAL '1 DAY'  ;
  ELSEIF var_month IN (10,11,12) THEN
   return date( var_year || '-10'  || '-01') - INTERVAL '1 DAY' ;
  ELSE
   RETURN CAST(NULL AS DATE);
  END IF; 
  
 ELSE IF UPPER(AS_DAY_SW) <> 'L' THEN
  IF var_month IN (1,2,3) THEN
   return date( var_year-1 || '-10'  || '-01')   ;
  ELSEIF var_month IN (4,5,6) THEN
   return date( var_year|| '-01'  || '-01')   ;
  ELSEIF var_month IN (7,8,9) THEN
   return date( var_year || '-04'  || '-01')   ;
  ELSEIF var_month IN (10,11,12) THEN
   return date( var_year || '-07'  || '-01')   ;
  ELSE
   RETURN CAST(NULL AS DATE);
 END IF; 
  
 ELSE
 RETURN CAST(NULL AS DATE);   
 END IF;  
END IF;
END;

$function$

