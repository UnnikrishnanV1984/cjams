CREATE OR REPLACE FUNCTION as_jurisdictiontransferapdxl(p_intakenumber character varying, restitution_no integer, p_usersecurityid_from_res_co character varying, OUT restitution_co_ordinator_from character varying, OUT restitution_co_ordinator_from_region character varying, OUT restitution_co_ordinator_to character varying, OUT restitution_co_ordinator_to_region character varying, OUT youthname character varying, OUT victimname character varying, OUT victim_address character varying, OUT restitution_coordinator_to_address character varying, OUT restitution_coordinator_to_phone character varying, OUT restitution integer, OUT from_county character varying, OUT to_county character varying, OUT petition_id character varying, OUT new_petitionid character varying, OUT court_ordered_date_time timestamp without time zone)
 RETURNS record
 LANGUAGE plpgsql
AS $function$
begin
restitution := restitution_no ;

select
 fullname into
  restitution_co_ordinator_from
 from
  userprofile
 where
  securityusersid = p_usersecurityid_from_res_co;

select
 persons ->> 'fullName' ,
 persons ->> 'fullAddress' into
  victimname,
  victim_address
 from
  intakedastatus,
  jsonb_array_elements( intakedastatus.jsondata -> 'persons') persons ,
  jsonb_array_elements(persons -> 'personRole') persl
 where
  intakenumber = p_intakenumber
  and persl ->>'rolekey' = 'Victim' ;

select
 persons ->> 'fullName' into
  youthname
 from
  intakedastatus,
  jsonb_array_elements( intakedastatus.jsondata -> 'persons') persons ,
  jsonb_array_elements(persons -> 'personRole') persl
 where
  intakenumber = p_intakenumber
  and persl ->>'rolekey' = 'Youth';

select
 up.fullname ,
 rgt.regionname ,
 cast(upa.address || ' ' || upa.city || ' ' || upa.state || ' ' || upa.zipcode as character varying ) ,
 uph.phonenumber ,
 tc.countyname into
  restitution_co_ordinator_to,
  restitution_co_ordinator_to_region,
  restitution_coordinator_to_address,
  restitution_coordinator_to_phone,
  to_county
 from
  intakedastatus its
 left join county tc on
  tc.countyid = its.saocountyid :: uuid
 left join region rgt on
  rgt.regionid = tc.regionid /* 21 Mar  - to accomodate non transferred intakes */
 left join team tm on
  tm.countyid :: uuid = tc.countyid
 left join teammember tmm on
  tmm.teamid = tm.teamid
 left join as_teammemberassignment tmma on
  tmma.teammemberid = tmm.teammemberid
 left join userprofile up on
  up.securityusersid = tmma.securityusersid
 left join userprofileaddress upa on
  upa.securityusersid = up.securityusersid
 left join userprofile vp on
  vp.fullname = victimname
 left join userprofileaddress vpa on
  vpa.securityusersid = vp.securityusersid
 left join userprofilephonenumber uph on
  uph.securityusersid = up.securityusersid
 where
  tmm.roletypekey = 'JSRTC'
  and its.intakenumber = p_intakenumber;

select
 rgf.regionname ,
 fc.countyname ,
 isrp.petitionid ,
 isrp.transferpetitionid ,
 isrco.courtorderdatetime into
  restitution_co_ordinator_from_region,
  from_county,
  petition_id,
  new_petitionid,
  court_ordered_date_time
 from
  intakedastatus its
 full join intakeservicerequestevaluation isre on
  isre.intakenumber = its.intakenumber
 full join intakeservicerequestpetition isrp on
  isrp.intakenumber = its.intakenumber
 full join intakeservicerequestcourtaction isrco on
  isrco.intakenumber = its.intakenumber
 full join intakeserreqrestitution isr on
  isr.intakenumber = its.intakenumber
 full join county fc on
  fc.countyid = isre.countyid
 full join region rgf on
  rgf.regionid = fc.regionid
 full join Intakeservreqevalpetitionconfig ispc on
  ispc.intakenumber = its.intakenumber
  and ispc.forwardcomplaintstatustypekey = 'PEFW' /* 21 Mar  - to accomodate non transferred intakes */
 where
  isr.activeflag = 1
  and isr.approvestatus = 'RSTAPR'
  and isrco.conditiontypedescription notnull
  and isr.restitutionno = restitution_no
  and its.intakenumber = p_intakenumber
 order by
  isrco.intakenumber
 limit 1 ;
end;

$function$

