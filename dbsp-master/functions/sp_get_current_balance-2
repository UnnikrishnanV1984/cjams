CREATE OR REPLACE FUNCTION sp_get_current_balance(al_placement_id bigint, ad_start_dt timestamp without time zone, ad_end_dt timestamp without time zone, as_rate_type_cd character varying, ad_placement_validation_start timestamp without time zone, al_rate_structure_id bigint, OUT al_linked_pymnt_hdr_id bigint, OUT al_reference_payment_detail_id bigint, OUT adc_current_balance numeric, OUT al_sqlcode integer, OUT as_error character varying)
 RETURNS record
 LANGUAGE plpgsql
AS $function$

            
------------------------------------------------------------------------
-- SQL Stored Procedure
-- 07/24/2007 Vineet Tirodkar
-- Arguments INPUT Placement ID, Start DT, Rate Type
--      OUTPUT Current Balance, SQL code and Error Text 
-- Input Rate Type is "Foster Care Rate Type" -- Picklist Type ID 82
-- IF returns +ve value then "Payable" and if -ve value the "Receivable"
-- 08/21/2007 Vineet Tirodkar - Consider FINAL_SERVICE_START_DT instead of PAYMENT_START_DT to get the balance
-- 05/30/2008 Vineet Tirodkar - New arguments to get LINKED_PYMNT_HDR_ID and REFERENCE_PAYMENT_DETAIL_ID
--            IN Validation Start DT, OUT Original Payment ID, OUT Max Original Pay Detl ID
-- 06/11/2008 Vineet Tirodkar - New condition to exclude payments with status as 1639 Released  
-- 09/23/2008 Vineet Tirodkar - New Argument RATE STRUCTURE ID for 'Emergency Foster Home Care'
--            with more than 60 days of placement calculation. CIS-17815 
-- 04/22/2009 Vineet Tirodkar - Changes in logic to get Total Receipts, 
--            instead of  RECEIVABLE_BALANCE_NO column take amount from AMOUNT_NO.
-- 08/17/2009 Vineet Tirodkar - Changes to condition for new rate type 5670-Room & Board/Clothing -- CIS-19002
-- 09/15/2015 Vineet Tirodkar - PRJ-05327 - MD CHESSIE Fiscal Phases 2
--     Modifications to get Adoption Subsidy & GAP Payments (BDSD Req # 77)
--     New input parameter ad_end_dt input used in Adoption Subsidy & GAP Payments calculation only
-- 02/22/2016 Vineet Tirodkar - PRJ-05945 GAP Calculation - Warranty Project
-- To add FINAL_SERVICE_ID in the where clause of while calculating previously paid amount to avoid inaccuracy due to same GAP & Adoption IDs
------------------------------------------------------------------------

DECLARE vdc_total_amt_paid DECIMAL(10,2);--
DECLARE vdc_total_amt_received DECIMAL(10,2);--
DECLARE vs_rate_type_tx VARCHAR(150);--
DECLARE vl_placement_structure_id BIGINT DEFAULT 0;--
DECLARE vl_subsidy_id BIGINT;--

DECLARE vl_sqlcode int default 0;--

DECLARE SQLCODE INT DEFAULT 0;--
DECLARE SQLSTATE CHAR(5) DEFAULT '00000';--
DECLARE vs_message_text VARCHAR(3000) DEFAULT '';--
DECLARE vs_Procedure_nm VARCHAR(100) DEFAULT 'SP_GET_CURRENT_BALANCE';--

--DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
BEGIN
    --GET DIAGNOSTICS EXCEPTION 1 vs_message_text = MESSAGE_TEXT;--
    /* vl_sqlcode := -1 ;--
     as_error := COALESCE(as_error ,'') || TO_CHAR(CURRENT_TIMESTAMP) ||'::' || vs_Procedure_nm || '.' ;--
     as_error := COALESCE(as_error ,'') || '::RO ' || 'Placement id' || ' :: ' || COALESCE(to_char(al_placement_id),'');--
     as_error := as_error || COALESCE(vs_message_text ,'');--*/
     as_error := '';--
--Reset Variables
 vdc_total_amt_paid := 0;--
 vdc_total_amt_received := 0;--
 adc_current_balance  := 0;--
 vs_rate_type_tx := '';--

-- Get value for RATE_TYPE_CD   
SELECT VALUE_TX
  INTO vs_rate_type_tx 
FROM tb_PICKLIST_VALUES
WHERE PICKLIST_TYPE_ID = 82 
 AND PICKLIST_VALUE_CD = as_rate_type_cd ;--
   
 al_sqlcode := SQLCODE;--
IF al_sqlcode < 0  THEN
  as_error := 'Error in getting Rate Type Value Tx';--
END IF ; --

-- PRJ-05327
-- 501 Adoptive Home
-- 503 Guardianship Assistance Program
IF al_rate_structure_id = 501 OR al_rate_structure_id = 503 THEN
  vl_subsidy_id :=  al_placement_id;--
ELSE
 -- Get Placement Structure ID from tb_PLACEMENT
 SELECT PLACEMENT_STRUCTURE_ID
  INTO vl_placement_structure_id
 FROM tb_PLACEMENT
 WHERE PLACEMENT_ID = al_placement_id;--

  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Placement Structure ID from tb_PLACEMENT';--
 END IF ; --
END IF;--

-- Get Total Payments    
-- 501 Adoptive Home
IF al_rate_structure_id = 501 THEN
 -- 5689 Adoption Subsidy
 SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
  INTO vdc_total_amt_paid
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD,
  tb_PAYMENT_STATUS PS
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.PAYMENT_ID = PS.PAYMENT_ID 
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PS.DELETE_SW = 'N'
  AND PS.PAYMENT_STATUS_CD <> '1639'
  AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
  AND PD.FINAL_SERVICE_ID = '501'
  AND PH.PAYMENT_TYPE_CD in ('5689','3294')
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
  AND PD.FINAL_SERVICE_END_DT >= ad_start_dt ;--

  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Adoption Subsidy Payments of type ' || vs_rate_type_tx ;--
 END IF ;--
 
-- 503 Guardianship Assistance Program 
ELSEIF al_rate_structure_id = 503 THEN
 -- 7 Guardianship Assistance Program
 SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
  INTO vdc_total_amt_paid
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD,
  tb_PAYMENT_STATUS PS
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.PAYMENT_ID = PS.PAYMENT_ID 
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PS.DELETE_SW = 'N'
  AND PS.PAYMENT_STATUS_CD <> '1639'
  AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
  AND PD.FINAL_SERVICE_ID = '503'
  AND PH.PAYMENT_TYPE_CD in ('7','3294')
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
  AND PD.FINAL_SERVICE_END_DT >= ad_start_dt ;--

  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting GAP Payments of type ' || vs_rate_type_tx ;--
 END IF ;--
 
ELSEIF vl_placement_structure_id = 13 AND ( as_rate_type_cd = '1232' OR as_rate_type_cd = '5670' ) THEN -- Emergency Foster Home Care and Room & Board
 SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
  INTO vdc_total_amt_paid
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD,
  tb_PAYMENT_STATUS PS
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.PAYMENT_ID = PS.PAYMENT_ID 
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PS.DELETE_SW = 'N'
  AND PS.PAYMENT_STATUS_CD <> '1639'
  AND PD.PLACEMENT_ID = al_placement_id
  AND PH.PAYMENT_TYPE_CD in ('6','3294')
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND date_part('MONTH',PD.FINAL_SERVICE_START_DT) = date_part('MONTH',ad_start_dt)
  AND date_part('YEAR',PD.FINAL_SERVICE_START_DT) = date_part('YEAR',ad_start_dt)
  AND PD.FINAL_SERVICE_ID = al_rate_structure_id ;--
  
  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Payments of type ' || vs_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
 END IF ;  --
 
ELSE
 SELECT SUM(COALESCE(PD.FINAL_AMOUNT_NO,0))
  INTO vdc_total_amt_paid
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD,
  tb_PAYMENT_STATUS PS
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.PAYMENT_ID = PS.PAYMENT_ID 
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PS.DELETE_SW = 'N'
  AND PS.PAYMENT_STATUS_CD <> '1639'
  AND PD.PLACEMENT_ID = al_placement_id
  AND PH.PAYMENT_TYPE_CD in ('6','3294')
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND date_part('MONTH',PD.FINAL_SERVICE_START_DT) = date_part('MONTH',ad_start_dt)
  AND date_part('YEAR',PD.FINAL_SERVICE_START_DT) = date_part('YEAR',ad_start_dt) ;--
 
  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Payments of type ' || vs_rate_type_tx ;--
 END IF ;--
END IF;--

IF vdc_total_amt_paid is NULL THEN
  vdc_total_amt_paid := 0;--
END IF;--

-- Get Total Receipts
-- 501 Adoptive Home
IF al_rate_structure_id = 501 THEN
 SELECT SUM(COALESCE(AMOUNT_NO,0))
  INTO vdc_total_amt_received
 FROM tb_RECEIVABLE_DETAIL
 WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
         FROM tb_PAYMENT_HEADER PH,
          tb_PAYMENT_DETAIL PD,
          tb_PAYMENT_STATUS PS
         WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
          AND PH.PAYMENT_ID = PS.PAYMENT_ID 
          AND PH.DELETE_SW = 'N'
          AND PD.DELETE_SW = 'N'
          AND PH.MANUAL_SW = 'N'
          AND PS.DELETE_SW = 'N'
          AND PS.PAYMENT_STATUS_CD <> '1639'
          AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
          AND PD.FINAL_SERVICE_ID = '501'
          AND PH.PAYMENT_TYPE_CD in ('5689','3294')
          AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
          AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
          AND PD.FINAL_SERVICE_END_DT >= ad_start_dt
        )
  AND DELETE_SW = 'N' ;--
     
  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Adoption Subsidy Receipts of Type '|| vs_rate_type_tx ;--
 END IF ;--
-- 503 Guardianship Assistance Program 
ELSEIF al_rate_structure_id = 503 THEN
 SELECT SUM(COALESCE(AMOUNT_NO,0))
  INTO vdc_total_amt_received
 FROM tb_RECEIVABLE_DETAIL
 WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
         FROM tb_PAYMENT_HEADER PH,
          tb_PAYMENT_DETAIL PD,
          tb_PAYMENT_STATUS PS
         WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
          AND PH.PAYMENT_ID = PS.PAYMENT_ID 
          AND PH.DELETE_SW = 'N'
          AND PD.DELETE_SW = 'N'
          AND PH.MANUAL_SW = 'N'
          AND PS.DELETE_SW = 'N'
          AND PS.PAYMENT_STATUS_CD <> '1639'
          AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
          AND PD.FINAL_SERVICE_ID = '503'
          AND PH.PAYMENT_TYPE_CD in ('7','3294')
          AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
          AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
          AND PD.FINAL_SERVICE_END_DT >= ad_start_dt
        )
  AND DELETE_SW = 'N' ;--
     
  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting GAP Receipts of Type '|| vs_rate_type_tx ;--
 END IF ;--
ELSEIF vl_placement_structure_id = 13 AND ( as_rate_type_cd = '1232' OR as_rate_type_cd = '5670' ) THEN -- Emergency Foster Home Care and Room & Board
 -- SELECT SUM(COALESCE(RECEIVABLE_BALANCE_NO,0)) -- 04/22/2009

 SELECT SUM(COALESCE(AMOUNT_NO,0))
  INTO vdc_total_amt_received
 FROM tb_RECEIVABLE_DETAIL
 WHERE PAYMENT_DETAIL_ID IN (  SELECT PD.PAYMENT_DETAIL_ID
         FROM tb_PAYMENT_HEADER PH,
          tb_PAYMENT_DETAIL PD,
          tb_PAYMENT_STATUS PS
         WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
          AND PH.PAYMENT_ID = PS.PAYMENT_ID 
          AND PH.DELETE_SW = 'N'
          AND PD.DELETE_SW = 'N'
          AND PH.MANUAL_SW = 'N'
          AND PS.DELETE_SW = 'N'
          AND PS.PAYMENT_STATUS_CD <> '1639'
          AND PD.PLACEMENT_ID = al_placement_id
          AND PH.PAYMENT_TYPE_CD in ('6','3294')
          AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
          AND date_part('MONTH',PD.FINAL_SERVICE_START_DT) = date_part('MONTH',ad_start_dt)
          AND date_part('YEAR',PD.FINAL_SERVICE_START_DT) = date_part('YEAR',ad_start_dt)
          AND PD.FINAL_SERVICE_ID = al_rate_structure_id 
        )
  AND DELETE_SW = 'N' ;--
  
  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Receipts of Type '|| vs_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
 END IF ;--

ELSE
 -- SELECT SUM(COALESCE(RECEIVABLE_BALANCE_NO,0)) -- 04/22/2009

 SELECT SUM(COALESCE(AMOUNT_NO,0))
  INTO vdc_total_amt_received
 FROM tb_RECEIVABLE_DETAIL
 WHERE PAYMENT_DETAIL_ID IN ( SELECT PD.PAYMENT_DETAIL_ID
         FROM tb_PAYMENT_HEADER PH,
          tb_PAYMENT_DETAIL PD,
          tb_PAYMENT_STATUS PS
         WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
          AND PH.PAYMENT_ID = PS.PAYMENT_ID 
          AND PH.DELETE_SW = 'N'
          AND PD.DELETE_SW = 'N'
          AND PH.MANUAL_SW = 'N'
          AND PS.DELETE_SW = 'N'
          AND PS.PAYMENT_STATUS_CD <> '1639'
          AND PD.PLACEMENT_ID = al_placement_id
          AND PH.PAYMENT_TYPE_CD in ('6','3294')
          AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
          AND date_part('MONTH',PD.FINAL_SERVICE_START_DT) = date_part('MONTH',ad_start_dt)
          AND date_part('YEAR',PD.FINAL_SERVICE_START_DT) = date_part('YEAR',ad_start_dt) 
        )
  AND DELETE_SW = 'N' ;--
     
  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Receipts of Type '|| vs_rate_type_tx ;--
 END IF ;--
END IF;--

IF vdc_total_amt_received is NULL THEN
  vdc_total_amt_received := 0;--
END IF;--

-- Set Current Balance
 adc_current_balance  := vdc_total_amt_paid - vdc_total_amt_received;--

-- Get Original Payment ID - START
 al_linked_pymnt_hdr_id := 0; -- INITIAL VALE

-- 501 Adoptive Home
IF al_rate_structure_id = 501 THEN
 -- First look for payment type '5689' Adoption Subsidy if not found '3294' Adjustments
 SELECT MAX(PH.PAYMENT_ID)
  INTO al_linked_pymnt_hdr_id
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
  AND PD.FINAL_SERVICE_ID = '501'
  AND PH.PAYMENT_TYPE_CD = '5689'
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
  AND PD.FINAL_SERVICE_END_DT >= ad_start_dt ;--

  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Original Adoption Subsidy Payment ID '|| vs_rate_type_tx ;--
 END IF ;--

-- 503 Guardianship Assistance Program 
ELSEIF al_rate_structure_id = 503 THEN
 -- First look for payment type '7' Guardianship Assistance Program if not found '3294' Adjustments
 SELECT MAX(PH.PAYMENT_ID)
  INTO al_linked_pymnt_hdr_id
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
  AND PD.FINAL_SERVICE_ID = '503'
  AND PH.PAYMENT_TYPE_CD = '7'
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
  AND PD.FINAL_SERVICE_END_DT >= ad_start_dt
 ;--

  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Original GAP Payment ID '|| vs_rate_type_tx ;--
 END IF ;--

ELSE
 -- First look for payment type '6' Maintenance if not found '3294' Adjustments
 SELECT MAX(PH.PAYMENT_ID)
  INTO al_linked_pymnt_hdr_id
 FROM tb_PAYMENT_HEADER PH,
  tb_PAYMENT_DETAIL PD
 WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
  AND PH.DELETE_SW = 'N'
  AND PD.DELETE_SW = 'N'
  AND PH.MANUAL_SW = 'N'
  AND PD.PLACEMENT_ID = al_placement_id
  AND PH.PAYMENT_TYPE_CD = '6'
  AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
  AND date_part('MONTH',PD.FINAL_SERVICE_START_DT) = date_part('MONTH',ad_placement_validation_start)
  AND date_part('YEAR',PD.FINAL_SERVICE_START_DT) = date_part('YEAR',ad_placement_validation_start) ;--

  al_sqlcode := SQLCODE;--
 IF al_sqlcode < 0  THEN
   as_error := 'Error in getting Original Maintenance Payment ID '|| vs_rate_type_tx ;--
 END IF ;--
END IF;--

IF al_linked_pymnt_hdr_id is NULL THEN
  al_linked_pymnt_hdr_id := 0;--
END IF;--

IF al_linked_pymnt_hdr_id = 0 THEN
 -- 501 Adoptive Home
 IF al_rate_structure_id = 501 THEN
  SELECT MAX(PH.PAYMENT_ID)
   INTO al_linked_pymnt_hdr_id
  FROM tb_PAYMENT_HEADER PH,
   tb_PAYMENT_DETAIL PD
  WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
   AND PH.DELETE_SW = 'N'
   AND PD.DELETE_SW = 'N'
   AND PH.MANUAL_SW = 'N'
   AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
   AND PD.FINAL_SERVICE_ID = '501'
   AND PH.PAYMENT_TYPE_CD = '3294'
   AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
   AND PD.FINAL_SERVICE_END_DT >= ad_start_dt ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original Adoption Subsidy Adjustment Payment ID '|| vs_rate_type_tx ;--
  END IF ; --
  
 -- 503 Guardianship Assistance Program 
 ELSEIF  al_rate_structure_id = 503  THEN
  SELECT MAX(PH.PAYMENT_ID)
   INTO al_linked_pymnt_hdr_id
  FROM tb_PAYMENT_HEADER PH,
   tb_PAYMENT_DETAIL PD
  WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
   AND PH.DELETE_SW = 'N'
   AND PD.DELETE_SW = 'N'
   AND PH.MANUAL_SW = 'N'
   AND PD.SUBSIDY_AGREEMENT_ID = vl_subsidy_id
   AND PD.FINAL_SERVICE_ID = '503'
   AND PH.PAYMENT_TYPE_CD = '3294'
   AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND PD.FINAL_SERVICE_START_DT <= ad_end_dt
   AND PD.FINAL_SERVICE_END_DT >= ad_start_dt ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original GAP Adjustment Payment ID '|| vs_rate_type_tx ;--
  END IF ;  --
 ELSE
  SELECT MAX(PH.PAYMENT_ID)
   INTO al_linked_pymnt_hdr_id
  FROM tb_PAYMENT_HEADER PH,
   tb_PAYMENT_DETAIL PD
  WHERE PH.PAYMENT_ID = PD.PAYMENT_ID
   AND PH.DELETE_SW = 'N'
   AND PD.DELETE_SW = 'N'
   AND PH.MANUAL_SW = 'N'
   AND PD.PLACEMENT_ID = al_placement_id
   AND PH.PAYMENT_TYPE_CD = '3294'
   AND PD.FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND date_part('MONTH',PD.FINAL_SERVICE_START_DT) = date_part('MONTH',ad_placement_validation_start)
   AND date_part('YEAR',PD.FINAL_SERVICE_START_DT) = date_part('YEAR',ad_placement_validation_start) ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original Adjustment Payment ID '|| vs_rate_type_tx ;--
  END IF ;--
 END IF; --
END IF;--

IF al_linked_pymnt_hdr_id is NULL THEN
  al_linked_pymnt_hdr_id := 0;--
END IF;--
--Get Original Payment ID - END

--Get Max Payment Detail ID of Original Payment - START
 al_reference_payment_detail_id := 0; -- INITIAL VALE

IF al_linked_pymnt_hdr_id > 0 THEN
 -- 501 Adoptive Home
 IF al_rate_structure_id = 501 THEN
  SELECT MAX(PAYMENT_DETAIL_ID)
   INTO al_reference_payment_detail_id
  FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
   AND SUBSIDY_AGREEMENT_ID = vl_subsidy_id
   AND FINAL_SERVICE_ID = '501'
   AND FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND FINAL_SERVICE_ID IS NOT NULL
   AND DELETE_SW = 'N'
   AND FINAL_SERVICE_START_DT <= ad_end_dt
   AND FINAL_SERVICE_END_DT >= ad_start_dt ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original Adoption Subsidy Payment Detl ID '|| vs_rate_type_tx ;--
  END IF ;--
 
 -- 503 Guardianship Assistance Program 
 ELSEIF al_rate_structure_id = 503 THEN
  SELECT MAX(PAYMENT_DETAIL_ID)
   INTO al_reference_payment_detail_id
  FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
   AND SUBSIDY_AGREEMENT_ID = vl_subsidy_id
   AND FINAL_SERVICE_ID = '503'
   AND FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND FINAL_SERVICE_ID IS NOT NULL
   AND DELETE_SW = 'N'
   AND FINAL_SERVICE_START_DT <= ad_end_dt
   AND FINAL_SERVICE_END_DT >= ad_start_dt ;--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original GAP Payment Detl ID '|| vs_rate_type_tx ;--
  END IF ;--
 
 ELSEIF vl_placement_structure_id = 13 AND ( as_rate_type_cd = '1232' OR as_rate_type_cd = '5670' ) THEN -- Emergency Foster Home Care and Room & Board
  SELECT MAX(PAYMENT_DETAIL_ID)
   INTO al_reference_payment_detail_id
  FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
   AND PLACEMENT_ID = al_placement_id
   AND FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND FINAL_SERVICE_ID = al_rate_structure_id
   AND DELETE_SW = 'N';--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original Payment Detl ID '|| vs_rate_type_tx || ' and Rate Structure ID ' || TO_CHAR(al_rate_structure_id );--
  END IF ;--

  IF al_reference_payment_detail_id is NULL OR al_reference_payment_detail_id = 0 THEN
   SELECT MAX(PAYMENT_DETAIL_ID)
    INTO al_reference_payment_detail_id
   FROM tb_PAYMENT_DETAIL
   WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
    AND PLACEMENT_ID = al_placement_id
    AND FINAL_RATE_TYPE_CD = as_rate_type_cd
    AND FINAL_SERVICE_ID IS NOT NULL
    AND DELETE_SW = 'N';--

    al_sqlcode := SQLCODE;--
   IF al_sqlcode < 0  THEN
     as_error := 'Error in getting Original Payment Detl ID '|| vs_rate_type_tx ;--
   END IF ;--
  END IF;--
 ELSE
  SELECT MAX(PAYMENT_DETAIL_ID)
   INTO al_reference_payment_detail_id
  FROM tb_PAYMENT_DETAIL
  WHERE PAYMENT_ID = al_linked_pymnt_hdr_id
   AND PLACEMENT_ID = al_placement_id
   AND FINAL_RATE_TYPE_CD = as_rate_type_cd
   AND FINAL_SERVICE_ID IS NOT NULL
   AND DELETE_SW = 'N';--

   al_sqlcode := SQLCODE;--
  IF al_sqlcode < 0  THEN
    as_error := 'Error in getting Original Payment Detl ID '|| vs_rate_type_tx ;--
  END IF ;--
 END IF; --
END IF;--
--Get Max Payment Detail ID of Original Payment - END

 al_sqlcode := vl_sqlcode;--

END;

