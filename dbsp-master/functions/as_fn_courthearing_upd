CREATE OR REPLACE FUNCTION as_fn_courthearing_upd()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN


 IF NEW.hearingdatetime::VARCHAR IS NOT NULL  THEN
 
 INSERT INTO  csesoutboundtrigger (   old_id,
                           transactionon,
                           transactiontypekey,
                           statusflag,
             activeflag)
             
     select  distinct  isr.courtcasenumber,
                        CURRENT_TIMESTAMP,
                         '43',
                         'N',
           1
         from   intakeservicerequestcourthearing isra  , intakeservicerequestcourtaction isr 
     where   isr.intakeservicerequestpetitionid = new.intakeservicerequestpetitionid
        and isra.intakeservicerequestpetitionid = isr.intakeservicerequestpetitionid
        and isra.hearingtypekey in ('Adjudi', 'Disp', 'DI', 'CINA', 'MH', 'CC');
   
  end if;
 
 return new;

END;

$function$

