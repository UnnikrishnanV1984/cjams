CREATE OR REPLACE FUNCTION as_getmilitarydetails(personid uuid)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
 

DECLARE
    
    v_personid uuid;
    
 v_result json;
     
BEGIN
    
    v_personid := personid :: uuid;
   
   SELECT json_agg(pms) into v_result FROM    
 (
 SELECT 
  ms.personmilitaryserviceid, ms.branchkey,rvm.value_text as branchdesc, ms.serviceid, ms.dutystation, ms.servicestatuskey,rv.value_text as servicestatusdesc, ms.startdate, ms.enddate,
  ms.contactprefixkey, ms.contactfirstname, ms.contactmiddlename, ms.contactlastname, ms.contactsuffixkey, ms.contactphonetypekey,
  ms.contactphone, ms.contactphoneextension, ms.superiorprefixkey, ms.superiorfirstname, ms.superiormiddlename, ms.superiorlastname, 
  ms.superiorsuffixkey, ms.superiorphonetypekey, ms.workphone, ms.workxtn, ms.adr1, ms.adr2, ms.city, ms.state, ms.county, ms.zip5no, ms.comments,
  (select json_agg(x) from (select pms.personsuperiortypekey,pms.personphonetypekey,pms.phonenumber
from personmilitaryphone pms where pms.personmilitaryserviceid=ms.personmilitaryserviceid and pms.activeflag=1 and pms.personsuperiortypekey='phone') as x)::json as phonelist,
(select json_agg(x) from (select pms.personsuperiortypekey,pms.personphonetypekey,pms.phonenumber
from personmilitaryphone pms where pms.personmilitaryserviceid=ms.personmilitaryserviceid and pms.activeflag=1 and pms.personsuperiortypekey='superior') as x)::json as superiorlist
 FROM personmilitaryservices ms 
 left join referencevalues rv on rv.ref_key = ms.servicestatuskey and rv.referencetypeid='189' and rv.activeflag=1
 left join referencevalues rvm on rvm.ref_key = ms.branchkey and rvm.referencetypeid='188' and rvm.activeflag=1
 WHERE ms.personid = v_personid AND ms.activeflag = 1   
 ) pms;
   
 
 RETURN v_result;

END;   

 
$function$

