CREATE OR REPLACE FUNCTION as_sendtitle4bnotification(v_securityusersid character varying, v_objectvalue character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$




declare 

v_record record;
v_subject character varying;
v_body text;
v_send_notification character varying;

begin

 
FOR  v_record  in

select  mu.securityusersid
from muser mu 
join rolemapping rm on rm.principalid::int=mu.id and rm.activeflag=1 
join role r on r.id = rm.roleid :: int and r.activeflag =1
where 
    r.roletypekey ilike 'IVE%' and mu.activeflag =1
  
    
 loop 
RAISE NOTICE 'v_record.securityusersid %', v_record.securityusersid ;
  v_subject =  'Title IV-B Review has been completed for '|| v_objectvalue ;
  v_body = 'Title IV-B Review has been completed for '||   v_objectvalue ;
 
 select send_notification into v_send_notification from as_send_notification(v_record.securityusersid,v_securityusersid,v_record.securityusersid::character varying,'System'::character varying,'High'::character varying,v_subject::character varying,v_body::character varying,null::character varying,false);
   

 END  LOOP;

return 'Success';

 
end;
 


$function$

