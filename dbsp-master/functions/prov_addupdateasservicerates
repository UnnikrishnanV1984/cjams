CREATE OR REPLACE FUNCTION prov_addupdateasservicerates(insertedtlsobj json)
 RETURNS text
 LANGUAGE plpgsql
AS $function$                                                                                                                                           
                                                                                                                                                         
 DECLARE                                                                                                                                                 
 returnStatus text;                                                                                                                                      
 contractId numeric;                                                                                                                                     
 monthlyRate numeric;                                                                                                                                    
 annualRate numeric;                                                                                                                                     
 dimRate numeric;      
 hourRate numeric;                                                                                                                                  
 stdate date;                                                                                                                                            
 enddate date;                                                                                                                                           
 serviceId numeric;                                                                                                                                           
 asRatedId uuid;                                                                                                                                  
                                                                                                                                                         
                                                                                                                                                         
 BEGIN                                                                                                                                                   
                                                                                                                                                         
 contractId=insertedtlsobj->>'contract_id';                                                                                                              
 monthlyRate =insertedtlsobj->>'monthly_rate';                                                                                                           
 annualRate= insertedtlsobj->>'annual_rate';                                                                                                             
 dimRate =insertedtlsobj->>'perdiem_rate';                                                                                                              
 hourRate =insertedtlsobj->>'hourly_rate';                                                                                                              
 stdate=insertedtlsobj->>'start_date';                                                                                                                     
 enddate= insertedtlsobj->>'end_date';                                                                                                                     
 serviceId= insertedtlsobj->>'service_id';                                                                                                                     
 asRatedId= insertedtlsobj->>'as_tb_service_rates_id';                                                                                                      
                                                                                                                                                         
                                                                                                                                                         
 IF asRatedId is not null                                                                                                                                      
 then                                                                                                                                                    
 update as_tb_service_rates set rate_status='Expired' where contract_id=contractId and as_tb_service_rates_id=asRatedId;
                                                                                                                                                         
 END IF;                                                                                                                                                 
                                                                                                                                                         
 insert into as_tb_service_rates (contract_id, service_id, annual_rate, monthly_rate, perdiem_rate, hourly_rate, start_date, end_date,                                    
                         create_ts, create_user_id, update_ts, update_user_id, active_flag, rate_status)                        
                 values(contractId, serviceId, annualRate,                                                                                                          
                 monthlyRate, dimRate, hourRate, stdate ,enddate,                                                                                                   
                 now(), insertedtlsobj->>'create_user_id', now(), insertedtlsobj->>'update_user_id',       
                 1,'Active');                                                                                                                  
                                                                                                                                                         
                                                                                                                                                         
 returnStatus:= 'Success';                                                                                                                               
                                                                                                                                                         
 RETURN returnStatus;                                                                                                                                    
                                                                                                                                                         
 END;                                                                                                                                                    
                                                                                                                                                         
 $function$

