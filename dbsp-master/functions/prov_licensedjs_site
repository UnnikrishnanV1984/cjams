CREATE OR REPLACE FUNCTION prov_licensedjs_site(v_site_id character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
declare

v_details json;
v_address json;
v_address_1 json;
v_accomodation json;
v_staff json;
v_license_signature json;
begin 


select json_agg(a) into v_details from (Select pc.provider_id,tp.adr_fax_tx as contact_fax,pc.license_application_id,pc.active_sw,
TO_CHAR(pc.license_issue_dt, 'MONTH') AS "licenseIssueMnth",
pc.license_expiry_dt,TO_CHAR(pc.license_expiry_dt, 'MONTH') AS "licenseExpiryMnth",prvdec.decisiondate,TO_CHAR(decisiondate, 'MONTH') AS "decisionMonth",
   pc.program_id, pc.license_no, pc.license_issue_dt, pc.license_expiry_dt,pra.male_capacity ,pra.female_capacity ,pra.is_max_capacity ,pra.max_male_capacity ,pra.max_female_capacity  , pc.license_level, tp.adm_contact_first_nm as contact_first_nm,tp.adm_contact_last_nm as contact_last_nm,
   pc.license_type, (select provider_nm from tb_provider where provider_id = pc.site_id) as program_name,tp.provider_nm , prvdec.decisiondate, tpv1.value_tx as license_agency, tp.adr_home_phone_tx as adr_work_phone_tx, 
   pra.minimum_age_no, pra.maximum_age_no, pra.gender_cd, COALESCE (pra.children_no, pc.licensed_beds_no, -1) AS children_no,
   (select typedescription from gendertype gt where gt.gendertypekey = pra.gender_cd) AS gender_name,
   tpa.*, tpa2.execsignature,
   (select displayname from userprofile up where up.securityusersid = pc.create_user_id) AS execname,
   (select * from prov_get_formatted_addresses(pc.site_id)) as formatted_address,
   (case when pc.license_status_cd = '3261' then 'License Suspended' when pc.license_status_cd = '3262' then 'License Revoked'
   when pc.license_status_cd = '3267' then 'License Suspended' 
   when pc.license_status_cd = '3263' then 'License Issued'
   when pc.license_status_cd = '3265' then 'License Revoked' end) as license_status,
   tpv.value_tx as application_type
   from tb_provider_licensing pc join tb_provider tp on tp.provider_id = pc.provider_id and pc.active_sw='Y'
   left join tb_prov_accomodation pra on pra.license_application_id = pc.license_application_id and pra.delete_sw='N'
   left join tb_provider_addresses tpa on tpa.parent_key_id = pc.site_id and tpa.adr_type_cd = '3357' and tpa.adr_default_sw='Y' and tpa.delete_sw='N' 
   left join tb_provider_applicant tpa2 on tpa2.site_id = pc.site_id and tpa2.execsignature is not null and tpa2.application_status = 'Approved' 
   left join tb_provider_decision prvdec on prvdec.objectid = pc.provider_id and prvdec.status in ('Rejected','Approved','Denied')
   join tb_picklist_values tpv on pc.application_type_cd = tpv.picklist_value_cd
   join tb_picklist_values tpv1 on trim(pc.licensing_agency_cd) = trim(tpv1.picklist_value_cd) and tpv1.picklist_type_id = 111
   where pc.site_id::character varying = v_site_id  order by prvdec.updatedon desc LIMIT 1)a;


select json_agg(a) into v_accomodation from (Select pc.provider_id,tp.adr_fax_tx as contact_fax,pc.license_application_id,pc.active_sw,
   pc.program_id, pc.license_no, pc.license_issue_dt , pc.license_expiry_dt , pc.license_level, tp.adm_contact_first_nm as contact_first_nm,tp.adm_contact_last_nm as contact_last_nm,
   pc.license_type, (select provider_nm from tb_provider where provider_id = pc.site_id) as program_name,tp.provider_nm , prvdec.decisiondate, tpv1.value_tx as license_agency, tp.adr_home_phone_tx as adr_work_phone_tx, 
   pra.minimum_age_no, pra.maximum_age_no, pra.gender_cd, COALESCE (pra.children_no, pc.licensed_beds_no, -1) AS children_no,
   TO_CHAR(pc.license_issue_dt, 'MONTH') AS "licenseIssueMnth",pra.male_capacity ,pra.female_capacity ,pra.is_max_capacity ,pra.max_male_capacity ,pra.max_female_capacity ,
pc.license_expiry_dt,TO_CHAR(pc.license_expiry_dt, 'MONTH') AS "licenseExpiryMnth",prvdec.decisiondate,TO_CHAR(decisiondate, 'MONTH') AS "decisionMonth",
   (select typedescription from gendertype gt where gt.gendertypekey = pra.gender_cd) AS gender_name,
   tpa.*, tpa2.execsignature,
   (select displayname from userprofile up where up.securityusersid = pc.create_user_id) AS execname,
   (select * from prov_get_formatted_addresses(pc.site_id)) as formatted_address,
   (case when pc.license_status_cd = '3261' then 'License Suspended' when pc.license_status_cd = '3262' then 'License Revoked'
   when pc.license_status_cd = '3267' then 'License Suspended' 
   when pc.license_status_cd = '3263' then 'License Issued'
   when pc.license_status_cd = '3265' then 'License Revoked' end) as license_status,
   tpv.value_tx as application_type
   from tb_provider_licensing pc join tb_provider tp on tp.provider_id = pc.provider_id and pc.active_sw='Y'
   left join tb_prov_accomodation pra on pra.license_application_id = pc.license_application_id and pra.delete_sw='N'
   left join tb_provider_addresses tpa on tpa.parent_key_id = pc.site_id and tpa.adr_type_cd = '3357' and tpa.adr_default_sw='Y' and tpa.delete_sw='N' 
   left join tb_provider_applicant tpa2 on tpa2.site_id = pc.site_id and tpa2.execsignature is not null and tpa2.application_status = 'Approved' 
   left join tb_provider_decision prvdec on prvdec.objectid = pc.provider_id and prvdec.status in ('Rejected','Approved','Denied')
   join tb_picklist_values tpv on pc.application_type_cd = tpv.picklist_value_cd
   join tb_picklist_values tpv1 on trim(pc.licensing_agency_cd) = trim(tpv1.picklist_value_cd) and tpv1.picklist_type_id = 111
   where pc.site_id::character varying = v_site_id LIMIT 1)a;

select json_agg(a) into v_address from (
select * from prov_get_formatted_addresses_exit_conf_djs(CAST (v_site_id AS INTEGER)))a;
select json_agg(a) into v_address_1 from (
select * from prov_get_formatted_addresses_exit_conf_djs_1(CAST (v_site_id AS INTEGER)))a;

select jsonb_agg(a) into v_staff from ( 
select m.username,m.email,(select ' (' || SUBSTRING(phonenumber::text, 1, 3) || ') ' || SUBSTRING(phonenumber::text, 4,3) || '-' || SUBSTRING(phonenumber::text,7,4) from userprofilephonenumber u where  u.securityusersid in (select toworkeridno from providerassignment where objectid = v_site_id and activeflag = '1'  order by startdate desc limit 1)) as phonenumber,r.name from muser m left join userprofilephonenumber u 
on u.securityusersid =m.securityusersid join rolemapping r2 on r2.principalid = m.id and r2.activeflag = '1' and r2.teamtypekey not in ('CW','ASPROV','AS')
  join role r on r.id = r2.roleid
 where   m.securityusersid in (select toworkeridno from providerassignment where objectid = v_site_id and activeflag = '1'  order by startdate desc limit 1)
)a;

select jsonb_agg(a) into v_license_signature from (
select * from tb_provider_decision ta where ta.objectid = v_site_id and ta.activeflag = 1
)a; 

return (json_build_object('details',v_details,'address',v_address,'address_1',v_address_1,'accomodation',v_accomodation,'staff',v_staff,'license_signature',v_license_signature));
END;
$function$

