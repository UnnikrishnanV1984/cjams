CREATE OR REPLACE FUNCTION prov_getplacementforapprovalcode(v_structure_service_cd character varying, v_approvaltypecode character varying)
 RETURNS TABLE(service_id integer, service_nm character varying)
 LANGUAGE plpgsql
AS $function$

BEGIN 
 return query
 select svc.service_id,svc.service_nm from providerapprovalserviceconfig pasc
 left join tb_services svc on svc.service_id=pasc.serviceid and svc.structure_service_cd=v_structure_service_cd
 where approvaltypecd=v_approvaltypecode and svc.delete_sw='N' and pasc.activeflag = 1 order by svc.service_nm asc; 

END;

$function$

