CREATE OR REPLACE FUNCTION updatequickperson(v_personid uuid, v_quickpersonid uuid, v_updatedby character varying)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE
v_date timestamp without time zone;

BEGIN
v_date:= now() ;
 
  
  UPDATE quickperson SET personid = v_personid, activeflag = 0, updatedon = v_date, updatedby = 'QP System Update' WHERE quickpersonid = v_quickpersonid;
 
RETURN 'Success';
  
END
$function$

